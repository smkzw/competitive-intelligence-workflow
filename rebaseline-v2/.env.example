# 复制为 .env 后填写；.env 不入库
CIW_DATA_DIR=./ciw-data
CIW_LLM_BASE_URL=https://api.deepseek.com/v1
CIW_LLM_API_KEY=
CIW_LLM_MODEL=deepseek-chat
# 可选：关键字段二次核对模型（留空 = 只做确定性原文核验）
CIW_LLM_CHECK_MODEL=
# 全网搜索：tavily | bing | serpapi | none
CIW_WEBSEARCH_PROVIDER=none
CIW_WEBSEARCH_API_KEY=
# 微信公众号搜索命令：<cmd> "<query>" → stdout JSON 数组
CIW_WECHAT_SEARCH_CMD=
CIW_NCBI_API_KEY=
# 对外部署时设置访问令牌（首次访问 ?token=xxx）
CIW_ACCESS_TOKEN=
