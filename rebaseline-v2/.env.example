# 复制为 .env 后填写；.env 不入库
CIW_DATA_DIR=./ciw-data
CIW_LLM_BASE_URL=http://127.0.0.1:20128/v1
CIW_LLM_API_KEY=
CIW_LLM_MODEL=glm-5.3-flash
# 备用顺序由用户明确配置；地址与密钥只经环境注入，不写进路由 JSON
CIW_LLM_FALLBACKS='[{"model":"deepseek","base_url_env":"CIW_DGX_BASE_URL","api_key_env":"CIW_DGX_API_KEY"},{"model":"qwen","base_url_env":"CIW_DGX_BASE_URL","api_key_env":"CIW_DGX_API_KEY"}]'
CIW_DGX_BASE_URL=
CIW_DGX_API_KEY=
# 可选：关键字段二次核对模型（留空 = 只做确定性原文核验）
CIW_LLM_CHECK_MODEL=
# 全网搜索：tavily | bing | serpapi | none
CIW_WEBSEARCH_PROVIDER=none
CIW_WEBSEARCH_API_KEY=
# 可选：已授权专用Ego空间的ID，复用p1；工具不创建/接管空间
CIW_CHINA_EGO_SPACE_ID=
CIW_CHINA_BROWSER_TIMEOUT_S=240
# 微信公众号搜索命令：<cmd> "<query>" → stdout JSON 数组
CIW_WECHAT_SEARCH_CMD=
CIW_NCBI_API_KEY=
# 对外部署时设置访问令牌（首次访问 ?token=xxx）
CIW_ACCESS_TOKEN=
