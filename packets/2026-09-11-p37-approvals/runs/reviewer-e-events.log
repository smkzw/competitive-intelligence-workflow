{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba /Users/smkzw/Documents/AI\\\\ Products/competitive-intelligence-workflow/tests/application/test_semantic_review_task.py\"","aggregated_output":"     1\t\"\"\"P3.7 生产者合同：语义复核工作项的发射与提交验证。\n     2\t\n     3\t宿主链路：build_semantic_review_task 从门户观察产生待裁决对（仅跨试验\n     4\t且确定性守卫不决的对）；宿主生产模型提案并由**不同身份/会话**的独立\n     5\t上下文复核后提交；validate_semantic_review_submission 整体重验——\n     6\t陈旧摘要、任务外对、自审、伪造外层一律拒绝。\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport pytest\n    11\t\n    12\tfrom ci_workflow.application.semantic_review_task import (\n    13\t    build_semantic_review_task,\n    14\t    validate_semantic_review_submission,\n    15\t)\n    16\tfrom tests.reports.b.test_semantic_grouping_proposals import _approved, _rows\n    17\t\n    18\t\n    19\tdef _pool_rows(*rows: dict) -> list[tuple[dict, object]]:\n    20\t    return [(dict(row, _domain=\"efficacy\"), None) for row in rows]\n    21\t\n    22\t\n    23\tdef _third() -> dict:\n    24\t    _, second = _rows()\n    25\t    return dict(second, row_id=\"third\", trial_id=\"trial-c\", actual_timepoint=52,\n    26\t                semantic_definition=\"第三种措辞\", original_definition=\"第三种措辞\")\n    27\t\n    28\t\n    29\tdef test_task_lists_only_ambiguous_cross_trial_pairs() -> None:\n    30\t    first, second = _rows()\n    31\t    # 真实流程由 _records_with_semantics 从原始定义补全语义定义；此处对齐。\n    32\t    first = dict(first, semantic_definition=\"EASI-75应答者比例\")\n    33\t    third = _third()\n    34\t    task = build_semantic_review_task(\n    35\t        \"project-x\", _pool_rows(first, second, third),\n    36\t    )\n    37\t    # (first,third)=48↔52周超窗属硬冲突（模型不可覆盖）→ 不进入工作项；\n    38\t    # 其余两对仅措辞差异且同窗 → 待裁决。\n    39\t    pairs = {frozenset(item.row_ids) for item in task.pairs}\n    40\t    assert pairs == {frozenset((\"first\", \"second\")),\n    41\t                     frozenset((\"second\", \"third\"))}\n    42\t    for item in task.pairs:\n    43\t        assert len(item.row_digests) == 2\n    44\t        assert all(len(digest) == 64 for digest in item.row_digests)\n    45\t        assert item.guard_verdict in {\"undecided\", \"compatible\", \"incompatible\"}\n    46\t    assert task.state == \"awaiting_host_review\"\n    47\t    assert task.policy_version\n    48\t\n    49\t\n    50\tdef test_task_excludes_deterministic_same_trial_pairs() -> None:\n    51\t    first, _ = _rows()\n    52\t    same_trial = dict(first, row_id=\"st\", value=61)\n    53\t    task = build_semantic_review_task(\n    54\t        \"project-x\", _pool_rows(first, same_trial),\n    55\t    )\n    56\t    assert task.pairs == (), \"同试验对无需模型裁决，不得进入工作项\"\n    57\t\n    58\t\n    59\tdef test_valid_submission_round_trips() -> None:\n    60\t    first, second = _rows()\n    61\t    task = build_semantic_review_task(\"project-x\", _pool_rows(first, second))\n    62\t    approved = _approved(first, second)\n    63\t    validated = validate_semantic_review_submission(\n    64\t        [approved.model_dump(mode=\"json\")], task,\n    65\t        records=_pool_rows(first, second),\n    66\t    )\n    67\t    assert len(validated) == 1\n    68\t    assert validated[0].proposal.row_ids == approved.proposal.row_ids\n    69\t\n    70\t\n    71\tdef test_stale_digest_submission_is_rejected() -> None:\n    72\t    first, second = _rows()\n    73\t    task = build_semantic_review_task(\"project-x\", _pool_rows(first, second))\n    74\t    stale = _approved(first, dict(second, value=99))\n    75\t    with pytest.raises(ValueError, match=\"摘要\"):\n    76\t        validate_semantic_review_submission(\n    77\t            [stale.model_dump(mode=\"json\")], task,\n    78\t            records=_pool_rows(first, second),\n    79\t        )\n    80\t\n    81\t\n    82\tdef test_pair_outside_task_is_rejected() -> None:\n    83\t    first, second = _rows()\n    84\t    third = _third()\n    85\t    task = build_semantic_review_task(\"project-x\", _pool_rows(first, second))\n    86\t    outsider = _approved(first, third)\n    87\t    with pytest.raises(ValueError, match=\"任务之外\"):\n    88\t        validate_semantic_review_submission(\n    89\t            [outsider.model_dump(mode=\"json\")], task,\n    90\t            records=_pool_rows(first, second),\n    91\t        )\n    92\t\n    93\t\n    94\tdef test_self_review_submission_is_rejected() -> None:\n    95\t    first, second = _rows()\n    96\t    task = build_semantic_review_task(\"project-x\", _pool_rows(first, second))\n    97\t    approved = _approved(first, second)\n    98\t    payload = approved.model_dump(mode=\"json\")\n    99\t    payload[\"receipt\"][\"independent_review_id\"] = payload[\"receipt\"][\"model_id\"]\n   100\t    with pytest.raises(ValueError):\n   101\t        validate_semantic_review_submission(\n   102\t            [payload], task, records=_pool_rows(first, second),\n   103\t        )\n   104\t\n   105\t\n   106\tdef test_forged_outer_binding_is_revalidated() -> None:\n   107\t    first, second = _rows()\n   108\t    task = build_semantic_review_task(\"project-x\", _pool_rows(first, second))\n   109\t    approved = _approved(first, second)\n   110\t    payload = approved.model_dump(mode=\"json\")\n   111\t    payload[\"receipt\"][\"decision\"] = \"incompatible\"\n   112\t    with pytest.raises(ValueError, match=\"一致\"):\n   113\t        validate_semantic_review_submission(\n   114\t            [payload], task, records=_pool_rows(first, second),\n   115\t        )\n","exit_code":0,"status":"completed"}}
