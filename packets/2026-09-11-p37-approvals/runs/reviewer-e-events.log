{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba /Users/smkzw/Documents/AI\\\\ Products/competitive-intelligence-workflow/tests/reports/b/test_semantic_grouping_proposals.py | sed -n '1,320p'\"","aggregated_output":"     1\t\"\"\"Bound model proposals must reach the actual B chart grouping, without losing rows.\"\"\"\n     2\t\n     3\tfrom itertools import permutations\n     4\t\n     5\timport pytest\n     6\t\n     7\tfrom ci_workflow.renderers.portal.report_b import _groups_for_page\n     8\tfrom tests.reports.b.test_r13_semantic_grouping import _project_efficacy\n     9\t\n    10\t\n    11\tdef _rows():\n    12\t    first = _project_efficacy(\"first\", \"EASI-75\", timepoint=48)\n    13\t    first.update(\n    14\t        semantic_direction=\"higher_is_better\", semantic_estimand=\"treatment_policy\",\n    15\t        semantic_denominator=\"full_analysis_set\", semantic_instrument_or_scale=\"EASI v1.0\",\n    16\t    )\n    17\t    second = dict(\n    18\t        first, row_id=\"second\", trial_id=\"trial-b\", actual_timepoint=50,\n    19\t        semantic_definition=\"达到基线EASI改善不少于75%的比例\",\n    20\t        original_definition=\"达到基线EASI改善不少于75%的比例\",\n    21\t    )\n    22\t    return first, second\n    23\t\n    24\t\n    25\tdef _proposal(first, second):\n    26\t    from ci_workflow.reports.b.semantic_grouping import (\n    27\t        SemanticGroupingProposal,\n    28\t        semantic_row_digest,\n    29\t    )\n    30\t\n    31\t    return SemanticGroupingProposal(\n    32\t        proposal_id=\"synthetic-proposal\", row_ids=(first[\"row_id\"], second[\"row_id\"]),\n    33\t        row_digests=(semantic_row_digest(first), semantic_row_digest(second)),\n    34\t        compatible=True, rationale_zh=\"同一临床构念，实际时间分别为48与50周。\",\n    35\t        producer_id=\"synthetic-model\", time_window_compatible=True,\n    36\t    )\n    37\t\n    38\t\n    39\tdef _receipt(first, second):\n    40\t    from ci_workflow.reports.b.semantic_contract import SemanticAdjudicationReceipt\n    41\t\n    42\t    return SemanticAdjudicationReceipt(\n    43\t        adjudication_id=\"adj-review-1\",\n    44\t        observation_ids=(first[\"row_id\"], second[\"row_id\"]),\n    45\t        decision=\"compatible\",\n    46\t        model_id=\"model-a\",\n    47\t        independent_review_id=\"reviewer-x\",\n    48\t        independent_context=\"clean-context-1\",\n    49\t        rationale_zh=\"两种措辞指向同一临床构念，已经独立上下文复核。\",\n    50\t    )\n    51\t\n    52\t\n    53\tdef _approved(first, second):\n    54\t    from ci_workflow.reports.b.semantic_grouping import ApprovedSemanticMerge\n    55\t\n    56\t    return ApprovedSemanticMerge(\n    57\t        merge_id=\"merge-review-1\",\n    58\t        proposal=_proposal(first, second),\n    59\t        receipt=_receipt(first, second),\n    60\t    )\n    61\t\n    62\t\n    63\tdef test_bound_wording_proposal_reaches_chart_groups() -> None:\n    64\t    first, second = _rows()\n    65\t    groups = _groups_for_page(\n    66\t        \"efficacy\", [(first, None), (second, None)],\n    67\t        semantic_proposals=(_proposal(first, second),),\n    68\t        semantic_adjudications=(_approved(first, second),),\n    69\t    )\n    70\t    assert len(groups) == 1\n    71\t    assert groups[0][\"cross_trial\"] is True\n    72\t    assert {row[\"row_id\"] for row in groups[0][\"rows\"]} == {\"first\", \"second\"}\n    73\t    assert \"48\" in groups[0][\"title_zh\"] and \"50\" in groups[0][\"title_zh\"]\n    74\t\n    75\t\n    76\t@pytest.mark.parametrize(\"change\", [\"semantic_analysis_set\", \"value\", \"source_version_id\"])\n    77\tdef test_proposal_rejects_changed_observation(change: str) -> None:\n    78\t    first, second = _rows()\n    79\t    proposal = _proposal(first, second)\n    80\t    second[change] = 99 if change == \"value\" else \"changed\"\n    81\t    with pytest.raises(ValueError, match=\"摘要\"):\n    82\t        _groups_for_page(\n    83\t            \"efficacy\", [(first, None), (second, None)], semantic_proposals=(proposal,),\n    84\t        )\n    85\t\n    86\t\n    87\tdef test_model_cannot_override_known_hard_conflict() -> None:\n    88\t    first, second = _rows()\n    89\t    second[\"semantic_analysis_set\"] = \"per_protocol\"\n    90\t    groups = _groups_for_page(\n    91\t        \"efficacy\", [(first, None), (second, None)],\n    92\t        semantic_proposals=(_proposal(first, second),),\n    93\t    )\n    94\t    assert len(groups) == 2\n    95\t    assert all(not group[\"cross_trial\"] for group in groups)\n    96\t\n    97\t\n    98\tdef test_model_cannot_supply_missing_definition_by_copying_other_observation() -> None:\n    99\t    first, second = _rows()\n   100\t    first[\"semantic_definition\"] = \"not_reported\"\n   101\t    groups = _groups_for_page(\n   102\t        \"efficacy\", [(first, None), (second, None)],\n   103\t        semantic_proposals=(_proposal(first, second),),\n   104\t    )\n   105\t    assert len(groups) == 2\n   106\t\n   107\t\n   108\tdef test_pairwise_compatibility_is_not_transitive() -> None:\n   109\t    first, second = _rows()\n   110\t    third = dict(second, row_id=\"third\", trial_id=\"trial-c\", actual_timepoint=52,\n   111\t                 semantic_definition=\"第三种定义措辞\")\n   112\t    groups = _groups_for_page(\n   113\t        \"efficacy\", [(first, None), (second, None), (third, None)],\n   114\t        semantic_proposals=(_proposal(first, second), _proposal(second, third)),\n   115\t        semantic_adjudications=(_approved(first, second), _approved(second, third)),\n   116\t    )\n   117\t    assert len(groups) == 2\n   118\t    assert sum(len(group[\"rows\"]) for group in groups) == 3\n   119\t\n   120\t\n   121\tdef test_model_copy_cannot_forge_proposal_acceptance_state() -> None:\n   122\t    first, second = _rows()\n   123\t    forged = _proposal(first, second).model_copy(update={\"status\": \"accepted\"})\n   124\t    with pytest.raises(ValueError):\n   125\t        _groups_for_page(\"efficacy\", [(first, None), (second, None)], semantic_proposals=(forged,))\n   126\t\n   127\t\n   128\t@pytest.mark.parametrize(\"page\", [\"efficacy\", \"longitudinal-results\"])\n   129\tdef test_no_proposal_still_applies_cross_trial_time_guard(page: str) -> None:\n   130\t    first, _ = _rows()\n   131\t    second = dict(first, row_id=\"second\", trial_id=\"trial-b\", actual_timepoint=56)\n   132\t    groups = _groups_for_page(page, [(first, None), (second, None)])\n   133\t    assert len(groups) == 2\n   134\t    assert all(not group[\"cross_trial\"] for group in groups)\n   135\t\n   136\t\n   137\tdef test_complete_link_partition_is_input_order_independent() -> None:\n   138\t    first, second = _rows()\n   139\t    third = dict(second, row_id=\"third\", trial_id=\"trial-c\", actual_timepoint=52,\n   140\t                 semantic_definition=\"第三种定义措辞\")\n   141\t    proposals = (_proposal(first, second), _proposal(second, third))\n   142\t    partitions = {\n   143\t        frozenset(frozenset(row[\"row_id\"] for row in group[\"rows\"]) for group in\n   144\t                  _groups_for_page(\"efficacy\", [(row, None) for row in order],\n   145\t                                   semantic_proposals=proposals))\n   146\t        for order in permutations((first, second, third))\n   147\t    }\n   148\t    assert len(partitions) == 1\n   149\t\n   150\t\n   151\tdef test_source_locator_change_invalidates_bound_proposal() -> None:\n   152\t    from ci_workflow.renderers.portal.report_b import (\n   153\t        _display_trial_name,\n   154\t        _efficacy_records,\n   155\t    )\n   156\t    from tests.browser.test_b_semantic_proposals import proposal_data\n   157\t\n   158\t    data = proposal_data()\n   159\t    names = {product.id: product.name for product in data.products}\n   160\t    trials = {trial.id: _display_trial_name(trial, names[trial.product_id])\n   161\t              for trial in data.trials}\n   162\t    before = _efficacy_records(data, names, trials)\n   163\t    proposal = _proposal(before[0][0], before[1][0])\n   164\t    data.efficacy_views[\"facts\"][0][\"source_locator\"] = {\n   165\t        \"document_role\": \"publication\", \"page\": 99, \"table\": \"Table 1\",\n   166\t    }\n   167\t    after = _efficacy_records(data, names, trials)\n   168\t    with pytest.raises(ValueError, match=\"摘要\"):\n   169\t        _groups_for_page(\"efficacy\", after, semantic_proposals=(proposal,))\n   170\t\n   171\t\n   172\tdef test_detail_projects_full_scientific_partition_without_regrouping() -> None:\n   173\t    from ci_workflow.renderers.portal.report_b import _project_scientific_groups\n   174\t\n   175\t    first, second = _rows()\n   176\t    third = dict(second, row_id=\"third\", trial_id=\"trial-c\", actual_timepoint=52,\n   177\t                 semantic_definition=\"第三种定义措辞\")\n   178\t    proposals = (_proposal(first, second), _proposal(second, third))\n   179\t    approved = (_approved(first, second), _approved(second, third))\n   180\t    full = _groups_for_page(\"efficacy\", [(row, None) for row in (first, second, third)],\n   181\t                            semantic_proposals=proposals,\n   182\t                            semantic_adjudications=approved)\n   183\t    detail = _project_scientific_groups(full, [(second, None), (third, None)])\n   184\t    assert {frozenset(row[\"row_id\"] for row in group[\"rows\"]) for group in detail} == {\n   185\t        frozenset((\"second\",)), frozenset((\"third\",)),\n   186\t    }\n   187\t    assert {group[\"scientific_group_id\"] for group in detail} == {\n   188\t        group[\"scientific_group_id\"] for group in full\n   189\t    }\n   190\t\n   191\t\n   192\t@pytest.mark.parametrize(\"page\", [\"baseline-overview\", \"disposition-overview\",\n   193\t                                   \"efficacy-safety-matrix\"])\n   194\tdef test_descriptive_domains_honor_veto_and_reject_positive_adjudication(page: str) -> None:\n   195\t    from tests.reports.b.test_r13_semantic_grouping import _project_baseline\n   196\t\n   197\t    first = _project_baseline(\"a\", product_id=\"product-a\", trial_id=\"trial-a\", population=\"FAS\")\n   198\t    second = _project_baseline(\"b\", product_id=\"product-b\", trial_id=\"trial-b\", population=\"FAS\")\n   199\t    # 页面按真实数据流为无域记录打标；已标异域记录会被入口拒绝（见护栏测试）。\n   200\t    def _untagged(row: dict) -> dict:\n   201\t        return {key: value for key, value in row.items() if key != \"_domain\"}\n   202\t\n   203\t    rows = [(_untagged(first), None), (_untagged(second), None)]\n   204\t    proposal = _proposal(first, second)\n   205\t    groups = _groups_for_page(\n   206\t        page, rows,\n   207\t        semantic_proposals=(proposal.model_copy(update={\"compatible\": False}),),\n   208\t    )\n   209\t    assert len(groups) == 2\n   210\t    with pytest.raises(ValueError, match=\"描述性\"):\n   211\t        _groups_for_page(page, rows, semantic_proposals=(proposal,))\n   212\t\n   213\t\n   214\tdef test_projection_rejects_changed_fact_instead_of_returning_previous_value() -> None:\n   215\t    from ci_workflow.renderers.portal.report_b import _project_scientific_groups\n   216\t\n   217\t    first, second = _rows()\n   218\t    groups = _groups_for_page(\"efficacy\", [(first, None), (second, None)],\n   219\t                             semantic_proposals=(_proposal(first, second),))\n   220\t    with pytest.raises(ValueError, match=\"摘要\"):\n   221\t        _project_scientific_groups(groups, [(dict(second, value=99), None)])\n   222\t\n   223\t\n   224\tdef test_duplicate_identity_rejects_conflicting_fact_or_domain() -> None:\n   225\t    from ci_workflow.renderers.portal.report_b import _dedupe_records\n   226\t\n   227\t    first, _ = _rows()\n   228\t    assert len(_dedupe_records([(first, None), (dict(first), None)])) == 1\n   229\t    for changed in (dict(first, value=99), dict(first, _domain=\"safety\")):\n   230\t        with pytest.raises(ValueError, match=\"冲突\"):\n   231\t            _dedupe_records([(first, None), (changed, None)])\n   232\t\n   233\t\n   234\tdef test_full_view_rejects_cross_domain_proposal_before_dispatch() -> None:\n   235\t    from tests.reports.b.test_r13_semantic_grouping import _project_baseline\n   236\t\n   237\t    first, _ = _rows()\n   238\t    second = _project_baseline(\"baseline-b\", product_id=\"b\", trial_id=\"b\", population=\"FAS\")\n   239\t    with pytest.raises(ValueError, match=\"跨域\"):\n   240\t        _groups_for_page(\"product-trial-profiles\", [\n   241\t            (dict(first, _domain=\"efficacy\"), None),\n   242\t            (dict(second, _domain=\"baseline\"), None),\n   243\t        ], semantic_proposals=(_proposal(first, second),))\n   244\t\n   245\t\n   246\tdef test_conflicting_identity_fails_before_touching_existing_site(tmp_path) -> None:\n   247\t    from ci_workflow.renderers.portal.report_b import ReportBPortalData, render_report_b_site\n   248\t    from tests.browser.test_b_semantic_proposals import proposal_data\n   249\t\n   250\t    payload = proposal_data().model_dump(mode=\"json\")\n   251\t    payload[\"semantic_proposals\"] = []\n   252\t    payload[\"safety_views\"] = {\"facts\": [dict(\n   253\t        payload[\"efficacy_views\"][\"facts\"][0], value=2, original_endpoint=\"TEAE\",\n   254\t        original_definition=\"治疗期间不良事件\", source_version_id=\"synthetic-safety-source\",\n   255\t    )]}\n   256\t    site = tmp_path / \"html\"\n   257\t    site.mkdir()\n   258\t    sentinel = site / \"keep.txt\"\n   259\t    sentinel.write_text(\"existing user artifact\", encoding=\"utf-8\")\n   260\t    with pytest.raises(ValueError, match=\"冲突\"):\n   261\t        render_report_b_site(ReportBPortalData.model_validate(payload), site)\n   262\t    assert sentinel.read_text(encoding=\"utf-8\") == \"existing user artifact\"\n   263\t    assert list(site.iterdir()) == [sentinel]\n","exit_code":0,"status":"completed"}}
