{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba /Users/smkzw/Documents/AI\\\\ Products/competitive-intelligence-workflow/src/ci_workflow/application/semantic_review_task.py\"","aggregated_output":"     1\t\"\"\"P3.7 生产者：语义归并复核工作项的发射与提交验证。\n     2\t\n     3\t宿主链路：``build_semantic_review_task`` 从门户观察池选出真正需要模型\n     4\t裁决的跨试验观察对（确定性守卫不决的对）；宿主生产模型提案并经不同\n     5\t身份/会话的独立上下文复核后提交；``validate_semantic_review_submission``\n     6\t整体重验——外层伪造、陈旧摘要、任务外观察对、自审一律拒绝。渲染端\n     7\t合同见 :mod:`ci_workflow.reports.b.semantic_grouping`（候选不授权合并）。\n     8\t\"\"\"\n     9\tfrom __future__ import annotations\n    10\t\n    11\tfrom collections.abc import Mapping, Sequence\n    12\tfrom typing import Any, Literal\n    13\t\n    14\tfrom pydantic import BaseModel, ConfigDict, field_validator, model_validator\n    15\t\n    16\tfrom ci_workflow.reports.b.semantic_contract import (\n    17\t    compare_clinical_constructs,\n    18\t    semantic_value_is_unknown,\n    19\t)\n    20\tfrom ci_workflow.reports.b.semantic_grouping import (\n    21\t    SEMANTIC_POLICY_VERSION,\n    22\t    ApprovedSemanticMerge,\n    23\t    _observation,\n    24\t    semantic_row_digest,\n    25\t)\n    26\t\n    27\tRecord = tuple[dict[str, Any], Any]\n    28\t\n    29\t\n    30\tclass SemanticReviewPair(BaseModel):\n    31\t    \"\"\"一对需要独立复核的跨试验观察；摘要绑定当前观察字节。\"\"\"\n    32\t\n    33\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    34\t\n    35\t    row_ids: tuple[str, str]\n    36\t    row_digests: tuple[str, str]\n    37\t    trial_ids: tuple[str, str]\n    38\t    definitions_zh: tuple[str, str]\n    39\t    guard_verdict: Literal[\"undecided\", \"compatible\", \"incompatible\"]\n    40\t\n    41\t    @model_validator(mode=\"after\")\n    42\t    def _pair_shape(self) -> SemanticReviewPair:\n    43\t        if len(set(self.row_ids)) != 2:\n    44\t            raise ValueError(\"语义复核对必须绑定两个不同观察\")\n    45\t        return self\n    46\t\n    47\t\n    48\tclass SemanticReviewTask(BaseModel):\n    49\t    \"\"\"宿主语义复核工作项；不是接受回执。\"\"\"\n    50\t\n    51\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    52\t\n    53\t    schema_version: Literal[\"1.0\"] = \"1.0\"\n    54\t    task_id: str\n    55\t    project_id: str\n    56\t    policy_version: str\n    57\t    pairs: tuple[SemanticReviewPair, ...]\n    58\t    state: Literal[\"awaiting_host_review\"] = \"awaiting_host_review\"\n    59\t    next_action_zh: str = (\n    60\t        \"生产模型对每对观察给出兼容与否的提案与理由；由不同身份、不同会话的\"\n    61\t        \"独立上下文复核后，按 ApprovedSemanticMerge 结构提交。摘要必须与工作项\"\n    62\t        \"一致；模型与复核者不得为同一身份。\"\n    63\t    )\n    64\t\n    65\t    @field_validator(\"task_id\", \"project_id\", \"policy_version\")\n    66\t    @classmethod\n    67\t    def _required_text(cls, value: str) -> str:\n    68\t        normalized = value.strip()\n    69\t        if not normalized:\n    70\t            raise ValueError(\"语义复核工作项标识不能为空\")\n    71\t        return normalized\n    72\t\n    73\t\n    74\tdef _same_trial_product(left: Mapping[str, Any], right: Mapping[str, Any]) -> bool:\n    75\t    return bool(\n    76\t        left.get(\"trial_id\")\n    77\t        and left.get(\"trial_id\") == right.get(\"trial_id\")\n    78\t        and left.get(\"product_id\") == right.get(\"product_id\")\n    79\t    )\n    80\t\n    81\t\n    82\tdef _guard_verdict(\n    83\t    left_row: Mapping[str, Any], right_row: Mapping[str, Any]\n    84\t) -> Literal[\"undecided\", \"compatible\", \"incompatible\"] | None:\n    85\t    \"\"\"确定性守卫三分：可比 / 仅措辞差异待裁决 / 硬冲突。None=语义不完整。\"\"\"\n    86\t    try:\n    87\t        left = _observation(left_row)\n    88\t        right = _observation(right_row)\n    89\t    except ValueError:\n    90\t        return None\n    91\t    if any(semantic_value_is_unknown(value) for value in (\n    92\t        left.clinical_construct, left.definition,\n    93\t        right.clinical_construct, right.definition,\n    94\t    )):\n    95\t        return None\n    96\t    if compare_clinical_constructs(left, right).compatible:\n    97\t        return \"compatible\"\n    98\t    # 措辞统一后仍可通过 = 仅措辞差异，可经提案+独立复核归并。\n    99\t    unified = right.model_copy(update={\n   100\t        \"clinical_construct\": left.clinical_construct,\n   101\t        \"definition\": left.definition,\n   102\t    })\n   103\t    if compare_clinical_constructs(left, unified).compatible:\n   104\t        return \"undecided\"\n   105\t    return \"incompatible\"\n   106\t\n   107\t\n   108\tdef build_semantic_review_task(\n   109\t    project_id: str,\n   110\t    records: Sequence[Record],\n   111\t) -> SemanticReviewTask:\n   112\t    \"\"\"从完整观察池构建宿主语义复核工作项。\n   113\t\n   114\t    同试验同产品对与确定性可比对不进入工作项；硬冲突对被确定性否决，\n   115\t    模型不可覆盖，也不进入。仅\"措辞统一后可比\"的对需要模型+独立复核。\n   116\t    \"\"\"\n   117\t    rows = {str(row[\"row_id\"]): (row, value) for row, value in records}\n   118\t    if len(rows) != len(records):\n   119\t        raise ValueError(\"语义复核输入包含重复观察标识\")\n   120\t    pairs: list[SemanticReviewPair] = []\n   121\t    ids = sorted(rows)\n   122\t    for index, left_id in enumerate(ids):\n   123\t        for right_id in ids[index + 1:]:\n   124\t            left, _ = rows[left_id]\n   125\t            right, _ = rows[right_id]\n   126\t            if _same_trial_product(left, right):\n   127\t                continue\n   128\t            verdict = _guard_verdict(left, right)\n   129\t            if verdict != \"undecided\":\n   130\t                continue\n   131\t            pairs.append(SemanticReviewPair(\n   132\t                row_ids=(left_id, right_id),\n   133\t                row_digests=(\n   134\t                    semantic_row_digest(left), semantic_row_digest(right),\n   135\t                ),\n   136\t                trial_ids=(\n   137\t                    str(left.get(\"trial_id\") or \"\"), str(right.get(\"trial_id\") or \"\"),\n   138\t                ),\n   139\t                definitions_zh=(\n   140\t                    str(left.get(\"semantic_definition\") or left.get(\"original_definition\") or \"\"),\n   141\t                    str(right.get(\"semantic_definition\") or right.get(\"original_definition\") or \"\"),\n   142\t                ),\n   143\t                guard_verdict=verdict,\n   144\t            ))\n   145\t    task_id = f\"semantic-review-{len(pairs)}-{sorted(frozenset(rows))[0][:12]}\"\n   146\t    return SemanticReviewTask(\n   147\t        task_id=task_id,\n   148\t        project_id=project_id,\n   149\t        policy_version=SEMANTIC_POLICY_VERSION,\n   150\t        pairs=tuple(pairs),\n   151\t    )\n   152\t\n   153\t\n   154\tdef validate_semantic_review_submission(\n   155\t    payloads: Sequence[Mapping[str, Any] | ApprovedSemanticMerge],\n   156\t    task: SemanticReviewTask,\n   157\t    *,\n   158\t    records: Sequence[Record],\n   159\t) -> tuple[ApprovedSemanticMerge, ...]:\n   160\t    \"\"\"重验宿主提交的已批准归并；任何不一致失败关闭。\"\"\"\n   161\t    rows = {str(row[\"row_id\"]): row for row, _value in records}\n   162\t    expected = {frozenset(pair.row_ids): pair for pair in task.pairs}\n   163\t    validated: list[ApprovedSemanticMerge] = []\n   164\t    seen: set[frozenset[str]] = set()\n   165\t    for payload in payloads:\n   166\t        merge = (\n   167\t            payload\n   168\t            if isinstance(payload, ApprovedSemanticMerge)\n   169\t            else ApprovedSemanticMerge.model_validate(payload)\n   170\t        )\n   171\t        # 边界整体重验，阻止 model_copy(update=...) 伪造绑定。\n   172\t        merge = ApprovedSemanticMerge.model_validate(merge.model_dump(mode=\"json\"))\n   173\t        key = frozenset(merge.proposal.row_ids)\n   174\t        if key not in expected:\n   175\t            raise ValueError(f\"提交了任务之外的观察对归并：{sorted(merge.proposal.row_ids)}\")\n   176\t        if key in seen:\n   177\t            raise ValueError(\"同一观察对存在重复的已批准归并提交\")\n   178\t        seen.add(key)\n   179\t        for row_id, digest in zip(\n   180\t            merge.proposal.row_ids, merge.proposal.row_digests, strict=True\n   181\t        ):\n   182\t            if row_id not in rows:\n   183\t                raise ValueError(f\"提交引用当前观察池之外的观察：{row_id}\")\n   184\t            if semantic_row_digest(rows[row_id]) != digest:\n   185\t                raise ValueError(\"已批准归并的观察摘要与当前观察不一致，必须重新研究和复核\")\n   186\t        validated.append(merge)\n   187\t    return tuple(validated)\n","exit_code":0,"status":"completed"}}
