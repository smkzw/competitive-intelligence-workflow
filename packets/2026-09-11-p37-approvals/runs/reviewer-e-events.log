oint_policy_id=current_endpoint_policy.policy_id,\n   992\t        endpoint_policy_version=current_endpoint_policy.version,\n   993\t        timepoint_policy_id=current_timepoint_policy.policy_id,\n   994\t        timepoint_policy_version=current_timepoint_policy.version,\n   995\t    )\n   996\t\n   997\t\n   998\tload_endpoint_compatibility = load_endpoint_compatibility_policy\n   999\tload_timepoint_compatibility = load_timepoint_compatibility_policy\n  1000\tmatch_endpoint_timepoint = match_endpoint_compatibility\n  1001\tresolve_endpoint_compatibility = match_endpoint_compatibility\n  1002\t\n  1003\t\n  1004\t__all__ = [\n  1005\t    \"BTrialRoleOutput\",\n  1006\t    \"EndpointAnalysisForm\",\n  1007\t    \"EndpointCompatibilityError\",\n  1008\t    \"EndpointCompatibilityPolicy\",\n  1009\t    \"EndpointCompatibilityResult\",\n  1010\t    \"EndpointCompatibilityRule\",\n  1011\t    \"EndpointDirection\",\n  1012\t    \"EndpointObservation\",\n  1013\t    \"PublicationRoleValue\",\n  1014\t    \"TimeUnit\",\n  1015\t    \"TimepointCompatibilityPolicy\",\n  1016\t    \"TimepointCompatibilityRule\",\n  1017\t    \"TrialRoleOutput\",\n  1018\t    \"TrialRoleRecord\",\n  1019\t    \"build_b_trial_role\",\n  1020\t    \"build_trial_role_output\",\n  1021\t    \"load_endpoint_compatibility\",\n  1022\t    \"load_endpoint_compatibility_policy\",\n  1023\t    \"load_timepoint_compatibility\",\n  1024\t    \"load_timepoint_compatibility_policy\",\n  1025\t    \"match_endpoint_compatibility\",\n  1026\t    \"match_endpoint_timepoint\",\n  1027\t    \"resolve_endpoint_compatibility\",\n  1028\t]\n--- policies ---\n     1\tschema_version: \"1.0\"\n     2\tpolicy_id: timepoint-compatibility-v1\n     3\tversion: \"1.0\"\n     4\trules:\n     5\t  - rule_id: timepoint-day-28-v1\n     6\t    time_unit: day\n     7\t    minimum: 26\n     8\t    maximum: 30\n     9\t    canonical_value: 28\n    10\t    label_zh: 第 28 天附近\n    11\t    difference_label_zh: 实际时间点不在第 28 天兼容窗内\n   