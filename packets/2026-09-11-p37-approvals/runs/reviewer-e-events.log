   and shared_form\n   547\t            ):\n   548\t                raise ValueError(f\"终点兼容规则存在重叠歧义：{left.rule_id}、{right.rule_id}\")\n   549\t        return self\n   550\t\n   551\t    @classmethod\n   552\t    def from_yaml(cls, path: Path | str) -> Self:\n   553\t        try:\n   554\t            payload = yaml.safe_load(Path(path).read_text(encoding=\"utf-8\"))\n   555\t            if not isinstance(payload, dict):\n   556\t                raise EndpointCompatibilityError(\"终点兼容策略顶层必须是对象\")\n   557\t            return cls.model_validate(cast(dict[str, Any], payload))\n   558\t        except EndpointCompatibilityError:\n   559\t            raise\n   560\t        except (OSError, yaml.YAMLError, ValidationError, TypeError) as error:\n   561\t            raise EndpointCompatibilityError(f\"终点兼容策略加载失败：{error}\") from error\n   562\t\n   563\t\n   564\tclass TimepointCompatibilityRule(BaseModel):\n   565\t    \"\"\"一个规范时间单位和闭区间上下界组成的时间窗规则。\"\"\"\n   566\t\n   567\t    model_config = ConfigDict(extra=\"forbid\", frozen=True, populate_by_name=True)\n   568\t\n   569\t    rule_id: str = Field(validation_alias=AliasChoices(\"rule_id\", \"id\"))\n   570\t    time_unit: TimeUnit = Field(validation_alias=AliasChoices(\"time_unit\", \"unit\"))\n   571\t    minimum: float = Field(validation_alias=AliasChoices(\"minimum\", \"min_value\", \"minimum_value\"))\n   572\t    maximum: float = Field(validation_alias=AliasChoices(\"maximum\", \"max_value\", \"maximum_value\"))\n   573\t    canonical_value: float | None = Field(\n   574\t        default=None,\n   575\t        validation_alias=AliasChoices(\"canonical_value\", \"target_value\", \"nominal_value\"),\n   576\t    )\n   577\t    label_zh: str = Field(validation_alias=AliasChoices(\"label_zh\", \"window_label_zh\"))\n   578\t    difference_label_zh: str = Field(\n   579\t        validation_alias=AliasChoices(\"difference_label_zh\", \"difference_labels_zh\")\n   580\t    )\n   581\t\n   582\t    @field_validator(\"rule_id\", \"label_zh\", \"difference_label_zh\")\n   583\t    @classmethod\n   584\t    def _time_rule_text(cls, value: str) -> str:\n   585\t        return _compat_text(value, field_name=\"时间窗兼容规则字段\")\n   586\t\n   587\t    @field_validator(\"time_unit\", mode=\"before\")\n   588\t    @classmethod\n   589\t    def _time_unit_alias(cls, value: Any) -> Any:\n   590\t        return _normalize_time_unit(value)\n   591\t\n   592\t    @model_validator(mode=\"after\")\n   593\t    def _window_is_valid(self) -> Self:\n   594\t        if not math.isfinite(self.minimum) or not math.isfinite(self.maximum):\n   595\t            raise ValueError(\"时间窗上下界必须是有限数值\")\n   596\t        if self.minimum > self.maximum:\n   597\t            raise ValueError(\"时间窗最小值不得大于最大值\")\n   598\t        if self.canonical_value is not None and not (\n   599\t            self.minimum <= self.canonical_value <= self.maximum\n   600\t        ):\n   601\t            raise ValueError(\"时间窗规范值必须落在最小值和最大值之间\")\n   602\t        if not _CJK.search(self.difference_label_zh):\n   603\t            raise ValueError(\"时间窗兼容规则必须提供中文差异说明\")\n   604\t        return self\n   605\t\n   606\t    @property\n   607\t    def min_value(self) -> float:\n   608\t        return self.minimum\n   609\t\n   610\t    @property\n   611\t    def max_value(self) -> float:\n   612\t        return self.maximum\n   613\t\n   614\t    @property\n   615\t    def difference_labels_zh(self) -> tuple[str, ...]:\n   616\t        return (self.difference_label_zh,)\n   617\t\n   618\t\n   619\tclass TimepointCompatibilityPolicy(BaseModel):\n   620\t    \"\"\"版本化时间窗兼容规则集合。\"\"\"\n   621\t\n   622\t    model_config = ConfigDict(extra=\"forbid\", frozen=True, populate_by_name=True)\n   623\t\n   624\t    schema_version: Literal[\"1.0\"]\n   625\t    policy_id: str\n   626\t    version: str = Field(validation_alias=AliasChoices(\"version\", \"policy_version\"))\n   627\t    rules: tuple[TimepointCompatibilityRule, ...] = Field(\n   628\t        min_length=1,\n   629\t        validation_alias=AliasChoices(\"rules\", \"timepoint_rules\", \"compatibility_rules\"),\n   630\t    )\n   631\t\n   632\t    @field_validator(\"policy_id\", \"version\")\n   633\t    @classmethod\n   634\t    def _time_policy_id_text(cls, value: str) -> str:\n   635\t        return _compat_text(value, field_name=\"时间窗兼容策略标识\")\n   636\t\n   637\t    @model_validator(mode=\"after\")\n   638\t    def _time_rules_are_unique(self) -> Self:\n   639\t        rule_ids = tuple(rule.rule_id for rule in self.rules)\n   640\t        if len(set(rule_ids)) != len(rule_ids):\n   641\t            raise ValueError(\"时间窗兼容规则标识不得重复\")\n   642\t        bodies = tuple(\n   643\t            json.dumps(\n   644\t                rule.model_dump(mode=\"json\", exclude={\"rule_id\"}),\n   645\t                ensure_ascii=False,\n   646\t                sort_keys=True,\n   647\t                separators=(\",\", \":\"),\n   648\t            )\n   649\t            for rule in self.rules\n   650\t        )\n   651\t        if len(set(bodies)) != len(bodies):\n   652\t            raise ValueError(\"时间窗兼容规则条目不得重复\")\n   653\t        for left, right in combinations(self.rules, 2):\n   654\t            if left.time_unit is right.time_unit and max(left.minimum, right.minimum) <= min(\n   655\t                left.maximum, right.maximum\n   656\t            ):\n   657\t                raise ValueError(f\"时间窗兼容规则存在重叠歧义：{left.rule_id}、{right.rule_id}\")\n   658\t        return self\n   659\t\n   660\t    @classmethod\n   661\t    def from_yaml(cls, path: Path | str) -> Self:\n   662\t        try:\n   663\t            payload = yaml.safe_load(Path(path).read_text(encoding=\"utf-8\"))\n   664\t            if not isinstance(payload, dict):\n   665\t                raise EndpointCompatibilityError(\"时间窗兼容策略顶层必须是对象\")\n   666\t            return cls.model_validate(cast(dict[str, Any], payload))\n   667\t        except EndpointCompatibilityError:\n   668\t            raise\n   669\t        except (OSError, yaml.YAMLError, ValidationError, TypeError) as error:\n   670\t            raise EndpointCompatibilityError(f\"时间窗兼容策略加载失败：{error}\") from error\n   671\t\n   672\t\n   849\tdef _normalized(value: str) -> str:\n   850\t    return \" \".join(value.split()).casefold()\n   851\t\n   852\t\n   853\tdef _endpoint_match(\n   854\t    observation: EndpointObservation,\n   855\t    policy: EndpointCompatibilityPolicy,\n   856\t) -> tuple[EndpointCompatibilityRule | None, tuple[str, ...]]:\n   857\t    endpoint_id = _normalized(observation.endpoint_id)\n   858\t    explicit_construct = (\n   859\t        None\n   860\t        if observation.clinical_construct is None\n   861\t        else _normalized(observation.clinical_construct)\n   862\t    )\n   863\t    by_endpoint_id = tuple(\n   864\t        rule\n   865\t        for rule in policy.rules\n   866\t        if endpoint_id in {_normalized(item) for item in rule.endpoint_ids}\n   867\t    )\n   868\t    candidates = by_endpoint_id\n   869\t    if not candidates:\n   870\t        return None, (\"未命中终点兼容规则\",)\n   871\t    if explicit_construct is not None:\n   872\t        candidates = tuple(\n   873\t            rule for rule in candidates if _normalized(rule.construct_id) == explicit_construct\n   874\t        )\n   875\t        if not candidates:\n   876\t            return None, (\"临床构念不兼容\",)\n   877\t\n   878\t    labels: list[str] = []\n   879\t    if not any(rule.direction is observation.direction for rule in candidates):\n   880\t        labels.append(\"方向不兼容\")\n   881\t    if not any(\n   882\t        _normalized(observation.unit) in {_normalized(item) for item in rule.allowed_units}\n   883\t        for rule in candidates\n   884\t    ):\n   885\t        labels.append(\"单位不可直接换算\")\n   886\t    form = _normalize_analysis_form(observation.analysis_form)\n   887\t    if not any(form in rule.analysis_forms for rule in candidates):\n   888\t        labels.append(\"分析形式不兼容\")\n   889\t    if labels:\n   890\t        return None, tuple(labels)\n   891\t    matches = tuple(\n   892\t        rule\n   893\t        for rule in candidates\n   894\t        if rule.direction is observation.direction\n   895\t        and _normalized(observation.unit) in {_normalized(item) for item in rule.allowed_units}\n   896\t        and form in rule.analysis_forms\n   897\t    )\n   898\t    if len(matches) > 1:\n   899\t        raise EndpointCompatibilityError(\"终点兼容规则匹配不唯一，拒绝依赖规则顺序\")\n   900\t    return (matches[0], ()) if matches else (None, (\"未命中终点兼容规则\",))\n   901\t\n   902\t\n   903\tdef _parsed_timepoint(observation: EndpointObservation) -> tuple[float, TimeUnit]:\n   904\t    raw_unit = _normalize_time_unit(observation.time_unit)\n   905\t    try:\n   906\t        unit = TimeUnit(raw_unit)\n   907\t    except ValueError as error:\n   908\t        raise EndpointCompatibilityError(f\"实际时间点单位未知：{observation.time_unit}\") from error\n   909\t\n   910\t    raw_timepoint = observation.timepoint\n   911\t    inferred_unit: TimeUnit | None = None\n   912\t    if isinstance(raw_timepoint, str):\n   913\t        text = _compat_text(raw_timepoint, field_name=\"实际时间点\")\n   914\t        match = _TIMEPOINT_TEXT.fullmatch(text)\n   915\t        if match is None:\n   916\t            try:\n   917\t                value = float(text)\n   918\t            except ValueError as error:\n   919\t                raise EndpointCompatibilityError(\"实际时间点无法确定\") from error\n   920\t        else:\n   921\t            value = float(match.group(1))\n   922\t            if match.group(2) is not None:\n   923\t                inferred_unit = TimeUnit(_TIME_UNIT_ALIASES[match.group(2).casefold()])\n   924\t    else:\n   925\t        value = float(raw_timepoint)\n   926\t    if not math.isfinite(value):\n   927\t        raise EndpointCompatibilityError(\"实际时间点必须是有限数值\")\n   928\t    if inferred_unit is not None and inferred_unit is not unit:\n   929\t        raise EndpointCompatibilityError(\"实