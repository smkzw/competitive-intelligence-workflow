3675\t    elif page_id in _DISPOSITION_PAGE_IDS:\n  3676\t        lead = \"暂无公开试验完成情况记录，完整字段与披露状态见表。\"\n  3677\t    elif not has_drawable_data:\n  3678\t        lead = \"当前没有可绘制的真实数值，完整数据表保留原始披露状态。\"\n  3679\t    else:\n  3680\t        lead = page.responsibility_zh\n  3681\t    section_titles = {\n  3682\t        \"overview\": \"关键结果\",\n  3683\t        \"efficacy\": \"疗效结果\",\n  3684\t        \"longitudinal-results\": \"疗效随访变化\",\n  3685\t        \"safety\": \"安全性结果\",\n  3686\t        \"efficacy-safety-matrix\": \"疗效与安全性观察位置\",\n  3687\t        \"baseline-overview\": \"基线特征\",\n  3688\t        \"baseline-demographics\": \"人口学特征\",\n  3689\t        \"baseline-disease-context\": \"疾病特征\",\n  3690\t        \"baseline-severity\": \"基线疾病严重程度\",\n  3691\t        \"disposition-overview\": \"试验完成情况\",\n  3692\t        \"participant-flow\": \"受试者流转\",\n  3693\t        \"adherence\": \"依从性\",\n  3694\t        \"loss-exit\": \"失访与退出\",\n  3695\t        \"screen-failure\": \"筛败与原因\",\n  3696\t        \"rescue-treatment\": \"补救治疗\",\n  3697\t        \"prohibited-medication\": \"禁用药使用\",\n  3698\t        \"plan-deviation\": \"方案偏离\",\n  3699\t        \"trial-exposure-context\": \"试验与暴露情况\",\n  3700\t        \"subgroups-supporting-evidence\": \"亚组与支持证据\",\n  3701\t    }\n  3702\t    return {\n  3703\t        \"report\": data,\n  3704\t        \"report_version\": data.report_version,\n  3705\t        \"report_title\": f\"{data.indication}临床试验结果比较\",\n  3706\t        \"page_title\": title,\n  3707\t        \"page_id\": page.id,\n  3708\t        \"page\": page,\n  3709\t        \"catalog\": catalog,\n  3710\t        \"site_prefix\": prefix,\n  3711\t        \"empty_state_title\": empty_state_title,\n  3712\t        \"has_domain_empty_state\": has_domain_empty_state,\n  3713\t        \"has_drawable_data\": has_drawable_data,\n  3714\t        \"filter_note\": filter_note,\n  3715\t        \"nav_groups\": _nav_groups(catalog, prefix=prefix, current=current or page.id),\n  3716\t      