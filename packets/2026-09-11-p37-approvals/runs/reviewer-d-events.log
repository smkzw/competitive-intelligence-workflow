{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc 'nl -ba tests/reports/b/test_approved_merge_contract.py'","aggregated_output":"     1\t\"\"\"P3.7 核心合同：正向语义归并必须持有已获独立复核签发的裁决。\n     2\t\n     3\t候选 SemanticGroupingProposal 只贡献否决与守卫输入；它自身不再授权\n     4\t跨试验合并（\"提案身份和来源声明摘要只是候选完整性机制，不是实际\n     5\t独立复核者签发 accepted 的替代\"）。确定性路径（同桶+守卫通过）不\n     6\t受影响；否决方向永远生效。\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport pytest\n    11\t\n    12\tfrom ci_workflow.reports.b.semantic_contract import SemanticAdjudicationReceipt\n    13\tfrom ci_workflow.reports.b.semantic_grouping import (\n    14\t    ApprovedSemanticMerge,\n    15\t    _observation,\n    16\t    proposed_semantic_buckets,\n    17\t    semantic_row_digest,\n    18\t)\n    19\tfrom ci_workflow.renderers.portal.report_b import _groups_for_page\n    20\tfrom tests.reports.b.test_semantic_grouping_proposals import _proposal, _rows\n    21\t\n    22\t\n    23\tdef _receipt(first: dict, second: dict) -> SemanticAdjudicationReceipt:\n    24\t    return SemanticAdjudicationReceipt(\n    25\t        adjudication_id=\"adj-1\",\n    26\t        observation_ids=(str(first[\"row_id\"]), str(second[\"row_id\"])),\n    27\t        decision=\"compatible\",\n    28\t        model_id=\"model-a\",\n    29\t        independent_review_id=\"reviewer-x\",\n    30\t        independent_context=\"clean-context-1\",\n    31\t        rationale_zh=\"两种措辞指向同一临床构念，已经独立上下文复核。\",\n    32\t    )\n    33\t\n    34\t\n    35\tdef _approved(first: dict, second: dict) -> ApprovedSemanticMerge:\n    36\t    return ApprovedSemanticMerge(\n    37\t        merge_id=\"merge-1\",\n    38\t        proposal=_proposal(first, second),\n    39\t        receipt=_receipt(first, second),\n    40\t    )\n    41\t\n    42\t\n    43\tdef _pool(*rows: dict) -> tuple[tuple[tuple[dict, None], ...], ...]:\n    44\t    return (tuple((dict(row, _domain=\"efficacy\"), None) for row in rows),)\n    45\t\n    46\t\n    47\tdef test_candidate_positive_proposal_alone_cannot_merge() -> None:\n    48\t    first, second = _rows()\n    49\t    groups = proposed_semantic_buckets(\n    50\t        _pool(first, second), (_proposal(first, second),),\n    51\t    )\n    52\t    assert len(groups) == 2, \"候选提案未经独立复核签发，不得授权合并\"\n    53\t\n    54\t\n    55\tdef test_approved_merge_licenses_wording_equivalence() -> None:\n    56\t    first, second = _rows()\n    57\t    groups = proposed_semantic_buckets(\n    58\t        _pool(first, second),\n    59\t        (_proposal(first, second),),\n    60\t        approved_merges=(_approved(first, second),),\n    61\t    )\n    62\t    assert len(groups) == 1\n    63\t    assert {row[\"row_id\"] for row, _ in groups[0]} == {\"first\", \"second\"}\n    64\t\n    65\t\n    66\tdef test_candidate_veto_applies_without_approval() -> None:\n    67\t    first, second = _rows()\n    68\t    veto = _proposal(first, second).model_copy(update={\"compatible\": False})\n    69\t    groups = proposed_semantic_buckets(_pool(first, second), (veto,))\n    70\t    assert len(groups) == 2\n    71\t\n    72\t\n    73\tdef test_approved_merge_with_stale_digest_is_rejected() -> None:\n    74\t    first, second = _rows()\n    75\t    approved = _approved(first, second)\n    76\t    mutated = dict(second, value=99)\n    77\t    with pytest.raises(ValueError, match=\"摘要\"):\n    78\t        proposed_semantic_buckets(\n    79\t            _pool(first, mutated),\n    80\t            (_proposal(first, mutated),),\n    81\t            approved_merges=(approved,),\n    82\t        )\n    83\t\n    84\t\n    85\tdef test_merge_model_binds_receipt_to_proposal() -> None:\n    86\t    first, second = _rows()\n    87\t    incompatible_receipt = _receipt(first, second).model_copy(\n    88\t        update={\"decision\": \"incompatible\"}\n    89\t    )\n    90\t    with pytest.raises(ValueError, match=\"一致\"):\n    91\t        ApprovedSemanticMerge(\n    92\t            merge_id=\"m\",\n    93\t            proposal=_proposal(first, second),\n    94\t            receipt=incompatible_receipt,\n    95\t        )\n    96\t    foreign_ids = _receipt(first, dict(second, row_id=\"other\"))\n    97\t    with pytest.raises(ValueError, match=\"观察\"):\n    98\t        ApprovedSemanticMerge(\n    99\t            merge_id=\"m\",\n   100\t            proposal=_proposal(first, second),\n   101\t            receipt=foreign_ids,\n   102\t        )\n   103\t\n   104\t\n   105\tdef test_renderer_page_consumes_approved_merges_only() -> None:\n   106\t    first, second = _rows()\n   107\t    rows = [(dict(row, _domain=\"efficacy\"), None) for row in (first, second)]\n   108\t    candidate_only = _groups_for_page(\n   109\t        \"efficacy\", rows, semantic_proposals=(_proposal(first, second),),\n   110\t    )\n   111\t    assert len(candidate_only) == 2\n   112\t    approved = _groups_for_page(\n   113\t        \"efficacy\", rows,\n   114\t        semantic_proposals=(_proposal(first, second),),\n   115\t        semantic_adjudications=(_approved(first, second),),\n   116\t    )\n   117\t    assert len(approved) == 1\n","exit_code":0,"status":"completed"}}
