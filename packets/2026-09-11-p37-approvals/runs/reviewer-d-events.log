{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ci_workflow/reports/b/portal_science.py | sed -n '1,255p'\"","aggregated_output":"     1\t\"\"\"门户疗效行→科学视图层的策略驱动分区适配。\n     2\t\n     3\t渲染器消费本模块的分区作为跨试验可比性的唯一初始裁决来源：\n     4\t命中版本化终点/时间窗政策的观察按 ``build_efficacy_views`` 的科学\n     5\t分组进入兼容桶；缺少必要语义或未命中政策的观察保留给调用方的\n     6\t描述性路径，不丢弃、不伪装可比。本模块不做任何呈现决策。\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\tfrom collections.abc import Mapping, Sequence\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Any\n    13\t\n    14\tfrom ci_workflow.domain.evidence import EvidenceLocator\n    15\tfrom ci_workflow.reports.b.contracts import (\n    16\t    EndpointCompatibilityResult,\n    17\t    EndpointDirection,\n    18\t    EndpointObservation,\n    19\t    match_endpoint_compatibility,\n    20\t)\n    21\tfrom ci_workflow.reports.b.efficacy import (\n    22\t    EfficacyArmRole,\n    23\t    EfficacyFactRow,\n    24\t    build_efficacy_views,\n    25\t)\n    26\t\n    27\tRecord = tuple[dict[str, Any], Any]\n    28\t\n    29\t\n    30\tdef _text(row: Mapping[str, object], *names: str) -> str:\n    31\t    for name in names:\n    32\t        value = row.get(name)\n    33\t        if isinstance(value, str) and value.strip():\n    34\t            return value.strip()\n    35\t    return \"\"\n    36\t\n    37\t\n    38\t@dataclass(frozen=True)\n    39\tclass SciencePartition:\n    40\t    \"\"\"策略命中的科学分桶与未裁决观察。\"\"\"\n    41\t\n    42\t    buckets: tuple[tuple[Record, ...], ...]\n    43\t    bucket_keys: tuple[tuple[str, ...], ...]\n    44\t    unmatched: tuple[Record, ...]\n    45\t    difference_labels: Mapping[str, tuple[str, ...]]\n    46\t\n    47\t    @property\n    48\t    def matched_row_ids(self) -> frozenset[str]:\n    49\t        return frozenset(\n    50\t            str(row[\"row_id\"]) for bucket in self.buckets for row, _ in bucket\n    51\t        )\n    52\t\n    53\t\n    54\tdef _observation(row: Mapping[str, object]) -> EndpointObservation | None:\n    55\t    direction_text = _text(row, \"semantic_direction\", \"direction\").lower()\n    56\t    try:\n    57\t        direction = EndpointDirection(direction_text)\n    58\t    except ValueError:\n    59\t        return None\n    60\t    endpoint_id = _text(row, \"original_endpoint\", \"endpoint_id\", \"clinical_concept\")\n    61\t    definition = _text(row, \"semantic_definition\", \"original_definition\")\n    62\t    if not endpoint_id or not definition:\n    63\t        return None\n    64\t    timepoint = row.get(\"actual_timepoint\")\n    65\t    time_unit = _text(row, \"actual_timepoint_unit\")\n    66\t    if timepoint is None or isinstance(timepoint, bool) or not time_unit:\n    67\t        return None\n    68\t    return EndpointObservation.model_validate(\n    69\t        {\n    70\t            \"observation_id\": str(row[\"row_id\"]),\n    71\t            \"trial_id\": _text(row, \"trial_id\") or \"trial-unspecified\",\n    72\t            \"endpoint_id\": endpoint_id,\n    73\t            \"endpoint_definition\": definition,\n    74\t            \"endpoint_role\": _text(row, \"endpoint_role\", \"role\") or \"not_classified\",\n    75\t            \"unit\": _text(row, \"unit\") or \"unit-unspecified\",\n    76\t            \"direction\": direction.value,\n    77\t            \"analysis_form\": _text(row, \"analysis_form\", \"statistical_form_family\")\n    78\t            or \"form-unspecified\",\n    79\t            \"timepoint\": timepoint,\n    80\t            \"time_unit\": time_unit,\n    81\t        }\n    82\t    )\n    83\t\n    84\t\n    85\tdef _fact_row(\n    86\t    row: Mapping[str, object],\n    87\t    value: object,\n    88\t    match: EndpointCompatibilityResult,\n    89\t) -> tuple[EfficacyFactRow | None, tuple[str, ...]]:\n    90\t    arm_role_text = _text(row, \"arm_role\").lower()\n    91\t    try:\n    92\t        arm_role = EfficacyArmRole(arm_role_text)\n    93\t    except ValueError:\n    94\t        return None, (\"组别角色不支持疗效比较视图\",)\n    95\t    locator_raw = None\n    96\t    if isinstance(value, Mapping):\n    97\t        locator_raw = value.get(\"source_locator\", value.get(\"locator\"))\n    98\t    if isinstance(locator_raw, EvidenceLocator):\n    99\t        locator = locator_raw\n   100\t    elif isinstance(locator_raw, Mapping):\n   101\t        try:\n   102\t            locator = EvidenceLocator.model_validate(locator_raw)\n   103\t        except (TypeError, ValueError):\n   104\t            locator = EvidenceLocator(document_role=\"registry\", heading=\"登记结果\")\n   105\t    else:\n   106\t        locator = EvidenceLocator(document_role=\"registry\", heading=\"登记结果\")\n   107\t    assert match.compatibility_key is not None\n   108\t    try:\n   109\t        return EfficacyFactRow.model_validate(\n   110\t            {\n   111\t                \"row_id\": str(row[\"row_id\"]),\n   112\t                \"source_row_id\": str(row[\"row_id\"]),\n   113\t                \"observation_id\": str(row[\"row_id\"]),\n   114\t                \"product_id\": _text(row, \"product_id\") or \"product-unspecified\",\n   115\t                \"trial_id\": _text(row, \"trial_id\") or \"trial-unspecified\",\n   116\t                \"endpoint_family_id\": match.endpoint_rule_id,\n   117\t                \"endpoint_family_label_zh\": None,\n   118\t                \"compatibility_key\": match.compatibility_key,\n   119\t                \"original_endpoint\": _text(\n   120\t                    row, \"original_endpoint\", \"endpoint_id\", \"clinical_concept\"\n   121\t                ),\n   122\t                \"original_definition\": _text(\n   123\t                    row, \"semantic_definition\", \"original_definition\"\n   124\t                ),\n   125\t                \"endpoint_role\": _text(row, \"endpoint_role\", \"role\") or \"not_classified\",\n   126\t                \"direction\": match.observation.direction.value,\n   127\t                \"unit\": match.observation.unit,\n   128\t                \"analysis_form\": match.observation.analysis_form,\n   129\t                \"actual_timepoint\": match.observation.timepoint,\n   130\t                \"actual_timepoint_unit\": match.observation.time_unit,\n   131\t                \"analysis_population\": _text(\n   132\t                    row, \"analysis_population\", \"population_context\", \"population\"\n   133\t                )\n   134\t                or None,\n   135\t                \"arm_role\": arm_role.value,\n   136\t                \"arm_id\": _text(row, \"group_id\", \"arm_id\", \"arm\") or str(row[\"row_id\"]),\n   137\t                \"arm_label\": _text(row, \"arm_label\", \"group\", \"arm\") or \"组别未列示\",\n   138\t                \"value\": row.get(\"numeric_value\"),\n   139\t                \"numerator\": row.get(\"numerator\"),\n   140\t                \"denominator\": row.get(\"denominator\"),\n   141\t                \"compatibility_difference_labels_zh\": match.difference_labels_zh,\n   142\t                \"source_version_id\": _text(row, \"source_version_id\")\n   143\t                or \"portal-unspecified\",\n   144\t                \"source_locator\": {\n   145\t                    \"document_role\": locator.document_role,\n   146\t                    \"field_path\": locator.field_path,\n   147\t                    \"heading\": locator.heading,\n   148\t                    \"page\": locator.page,\n   149\t                    \"table\": locator.table,\n   150\t                    \"row\": locator.row,\n   151\t                    \"column\": locator.column,\n   152\t                    \"paragraph\": locator.paragraph,\n   153\t                    \"url\": locator.url,\n   154\t                },\n   155\t            }\n   156\t        ), (\"科学事实行校验失败\",)\n   157\t    except (TypeError, ValueError):\n   158\t        return None, (\"科学事实行校验失败\",)\n   159\t\n   160\t\n   161\tdef efficacy_science_partition(\n   162\t    records: Sequence[Record],\n   163\t) -> SciencePartition:\n   164\t    \"\"\"把门户疗效记录分为政策命中的科学桶与未裁决的描述性观察。\"\"\"\n   165\t\n   166\t    fact_rows: list[EfficacyFactRow] = []\n   167\t    by_row_id: dict[str, Record] = {}\n   168\t    unmatched: list[Record] = []\n   169\t    labels: dict[str, tuple[str, ...]] = {}\n   170\t    for record in records:\n   171\t        row, value = record\n   172\t        row_id = str(row[\"row_id\"])\n   173\t        if row_id in by_row_id:\n   174\t            raise ValueError(f\"科学分区收到重复观察标识：{row_id}\")\n   175\t        by_row_id[row_id] = record\n   176\t        observation = _observation(row)\n   177\t        match = (\n   178\t            None if observation is None else match_endpoint_compatibility(observation)\n   179\t        )\n   180\t        if match is None or match.compatibility_key is None:\n   181\t            unmatched.append(record)\n   182\t            labels[row_id] = (\n   183\t                (\"语义信息不完整\",)\n   184\t                if observation is None\n   185\t                else match.difference_labels_zh  # type: ignore[union-attr]\n   186\t            )\n   187\t            continue\n   188\t        fact, fact_label = _fact_row(row, value, match)\n   189\t        if fact is None:\n   190\t            unmatched.append(record)\n   191\t            labels[row_id] = fact_label\n   192\t            continue\n   193\t        fact_rows.append(fact)\n   194\t    if not fact_rows:\n   195\t        return SciencePartition((), (), tuple(unmatched), labels)\n   196\t\n   197\t    view_set = build_efficacy_views(fact_rows)\n   198\t    buckets: list[tuple[Record, ...]] = []\n   199\t    bucket_keys: list[tuple[str, ...]] = []\n   200\t    seen: set[str] = set()\n   201\t    for view in view_set.single_timepoint_views:\n   202\t        members = tuple(\n   203\t            by_row_id[row.row_id] for row in view.rows if row.row_id in by_row_id\n   204\t        )\n   205\t        if not members:\n   206\t            continue\n   207\t        buckets.append(members)\n   208\t        key = view.compatibility_key or view.compatibility_keys[0]\n   209\t        bucket_keys.append(\n   210\t            (\n   211\t                str(view.endpoint_family_id),\n   212\t                \"/\".join(str(item) for item in key),\n   213\t                str(view.actual_timepoint),\n   214\t                str(view.actual_timepoint_unit),\n   215\t            )\n   216\t        )\n   217\t        seen.update(row.row_id for row in view.rows)\n   218\t    # ponytail: view 集合未覆盖的命中行按科学分组键的兜底桶；正常路径为空。\n   219\t    leftover = tuple(\n   220\t        by_row_id[row.row_id] for row in view_set.fact_rows if row.row_id not in seen\n   221\t    )\n   222\t    for record in leftover:\n   223\t        buckets.append((record,))\n   224\t        bucket_keys.append((\"uncovered\", str(record[0][\"row_id\"])))\n   225\t    return SciencePartition(tuple(buckets), tuple(bucket_keys), tuple(unmatched), labels)\n","exit_code":0,"status":"completed"}}
