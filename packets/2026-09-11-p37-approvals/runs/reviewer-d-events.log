{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc 'nl -ba tests/reports/b/test_full_pool_adjudication_guards.py'","aggregated_output":"     1\t\"\"\"P3.0 护栏：完整观察池一次裁决，页面只投影，子集不得重新裁决。\n     2\t\n     3\t来源：2026-09-11 Reviewer-A 终审四项 P2（packets/2026-09-11-takeover-review/）。\n     4\t第一轮反例 test_product_page_is_projection_of_global_groups 的不变量由\n     5\ttests/browser/test_b_semantic_proposals.py::test_dossier_uses_global_scientific_partition\n     6\t在真实渲染路径上验证；本文件固化裁决入口护栏本身。\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport pytest\n    11\t\n    12\tfrom ci_workflow.renderers.portal.report_b import (\n    13\t    _adjudicate_full_pool,\n    14\t    _assert_page_fallback_only_uncovered,\n    15\t    _groups_for_page,\n    16\t)\n    17\tfrom tests.reports.b.test_semantic_grouping_proposals import _proposal, _rows\n    18\t\n    19\t\n    20\tdef _pool_rows(*rows: dict) -> list[tuple[dict, None]]:\n    21\t    return [(dict(row, _domain=\"efficacy\"), None) for row in rows]\n    22\t\n    23\t\n    24\tdef test_page_groups_reject_real_domain_subset() -> None:\n    25\t    \"\"\"产品/试验档案分组不得接受真实域子集：那是全池裁决入口的职责。\"\"\"\n    26\t    a, b = _rows()\n    27\t    a = dict(a, product_id=\"product-a\")\n    28\t    b = dict(b, product_id=\"product-b\")\n    29\t    c = dict(\n    30\t        b, row_id=\"third\", trial_id=\"trial-c\", actual_timepoint=52,\n    31\t        semantic_definition=\"第三种措辞\", original_definition=\"第三种措辞\",\n    32\t    )\n    33\t    rows = _pool_rows(a, b, c)\n    34\t    selected = [item for item in rows if item[0][\"product_id\"] == \"product-b\"]\n    35\t    with pytest.raises(ValueError, match=\"完整观察池\"):\n    36\t        _groups_for_page(\n    37\t            \"product-trial-profiles\", selected,\n    38\t            semantic_proposals=(_proposal(a, b), _proposal(b, c)),\n    39\t        )\n    40\t\n    41\t\n    42\tdef test_full_pool_rejects_orphan_proposal() -> None:\n    43\t    \"\"\"全池裁决中引用不存在观察的提案必须拒绝，不得静默忽略。\"\"\"\n    44\t    a, b = _rows()\n    45\t    orphan = _proposal(a, dict(b, row_id=\"missing-row\"))\n    46\t    with pytest.raises(ValueError, match=\"完整观察池之外的观察\"):\n    47\t        _adjudicate_full_pool(_pool_rows(a, b), semantic_proposals=(orphan,))\n    48\t\n    49\t\n    50\tdef test_full_pool_rejects_unknown_domain() -> None:\n    51\t    \"\"\"完整观察池只接受已知域；未知域记录必须失败关闭。\"\"\"\n    52\t    a, _ = _rows()\n    53\t    with pytest.raises(ValueError, match=\"未支持域\"):\n    54\t        _adjudicate_full_pool(\n    55\t            [(dict(a, _domain=\"mystery\"), None)], semantic_proposals=(),\n    56\t        )\n    57\t\n    58\t\n    59\tdef test_full_pool_adjudicates_and_merges_via_approved_merge() -> None:\n    60\t    from tests.reports.b.test_semantic_grouping_proposals import _approved\n    61\t\n    62\t    a, b = _rows()\n    63\t    merged = _adjudicate_full_pool(\n    64\t        _pool_rows(a, b), semantic_proposals=(_proposal(a, b),),\n    65\t        semantic_adjudications=(_approved(a, b),),\n    66\t    )\n    67\t    assert [tuple(row[\"row_id\"] for row in group[\"rows\"]) for group in merged] == [\n    68\t        (\"first\", \"second\"),\n    69\t    ]\n    70\t    # 候选提案单独存在时不再授权合并（P3.7 合同）。\n    71\t    separated = _adjudicate_full_pool(\n    72\t        _pool_rows(a, b), semantic_proposals=(_proposal(a, b),),\n    73\t    )\n    74\t    assert len(separated) == 2\n    75\t\n    76\t\n    77\tdef test_page_cannot_retag_existing_domain() -> None:\n    78\t    \"\"\"页面不得静默改写已有域标签；域冲突必须失败关闭。\"\"\"\n    79\t    a, _ = _rows()\n    80\t    with pytest.raises(ValueError, match=\"域\"):\n    81\t        _groups_for_page(\"efficacy\", [(dict(a, _domain=\"safety\"), None)])\n    82\t\n    83\t\n    84\tdef test_uncovered_real_domain_record_rejected() -> None:\n    85\t    \"\"\"未经全池裁决的真实域观察不得走页面回退分组；显式合成/空态记录可以。\"\"\"\n    86\t    a, _ = _rows()\n    87\t    real = (dict(a, _domain=\"efficacy\"), None)\n    88\t    with pytest.raises(ValueError, match=\"未经完整观察池裁决\"):\n    89\t        _assert_page_fallback_only_uncovered((real,))\n    90\t    synthetic = (dict(a, _domain=\"matrix\", _synthetic=True), None)\n    91\t    empty_state = (dict(a, _domain=\"baseline\", _empty_state=True), None)\n    92\t    _assert_page_fallback_only_uncovered((synthetic, empty_state))\n    93\t\n    94\t\n    95\tdef test_profile_page_synthetic_fallback_preserved() -> None:\n    96\t    \"\"\"钉住既有行为：generic 合成记录不产生分组；profile 记录保持状态矩阵。\"\"\"\n    97\t    generic = ({\"row_id\": \"g1\", \"_domain\": \"generic\"}, None)\n    98\t    assert _groups_for_page(\"product-trial-profiles\", (generic,)) == ()\n    99\t    profile = ({\"row_id\": \"p1\", \"_domain\": \"profile\"}, None)\n   100\t    groups = _groups_for_page(\"product-trial-profiles\", (profile,))\n   101\t    assert len(groups) == 1\n   102\t    assert groups[0][\"rows\"][0][\"_chart_type\"] == \"status_matrix\"\n","exit_code":0,"status":"completed"}}
