{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/ci_workflow/reports/b/semantic_grouping.py'","aggregated_output":"     1\t\"\"\"Bound model proposals for candidate B views; not an independent acceptance receipt.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport hashlib\n     6\timport json\n     7\tfrom collections.abc import Mapping, Sequence\n     8\tfrom typing import Any, Literal\n     9\t\n    10\tfrom pydantic import BaseModel, ConfigDict, TypeAdapter, field_validator, model_validator\n    11\t\n    12\tfrom ci_workflow.reports.b.semantic_contract import (\n    13\t    ClinicalConstructObservation,\n    14\t    SemanticAdjudicationReceipt,\n    15\t    compare_clinical_constructs,\n    16\t    semantic_value_is_unknown,\n    17\t)\n    18\t\n    19\tSEMANTIC_POLICY_VERSION = \"b-candidate-hard-axes-v2\"\n    20\t_SOURCE_JSON = TypeAdapter(Any)\n    21\t\n    22\t\n    23\tdef semantic_source_digest(value: Any) -> str:\n    24\t    \"\"\"Bind the complete supplied fact, including locator and derivation metadata.\n    25\t\n    26\t    This binds declared provenance; it does not attest that external bytes were\n    27\t    retrieved or independently verified. Those remain acquisition/review gates.\n    28\t    \"\"\"\n    29\t    return hashlib.sha256(json.dumps(\n    30\t        _SOURCE_JSON.dump_python(value, mode=\"json\"), ensure_ascii=False,\n    31\t        sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n    32\t    ).encode()).hexdigest()\n    33\t\n    34\t\n    35\tclass SemanticGroupingProposal(BaseModel):\n    36\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    37\t\n    38\t    schema_version: Literal[\"1\"] = \"1\"\n    39\t    status: Literal[\"proposal\"] = \"proposal\"\n    40\t    proposal_id: str\n    41\t    row_ids: tuple[str, str]\n    42\t    row_digests: tuple[str, str]\n    43\t    compatible: bool\n    44\t    time_window_compatible: bool = False\n    45\t    producer_id: str\n    46\t    rationale_zh: str\n    47\t\n    48\t    @field_validator(\"proposal_id\", \"producer_id\", \"rationale_zh\")\n    49\t    @classmethod\n    50\t    def nonempty(cls, value: str) -> str:\n    51\t        if not value.strip():\n    52\t            raise ValueError(\"语义提案标识与理由不能为空\")\n    53\t        return value.strip()\n    54\t\n    55\t    @model_validator(mode=\"after\")\n    56\t    def binding(self) -> SemanticGroupingProposal:\n    57\t        if len(set(self.row_ids)) != 2 or any(not value.strip() for value in self.row_ids):\n    58\t            raise ValueError(\"语义提案必须绑定两个不同观察\")\n    59\t        if any(len(value) != 64 or any(c not in \"0123456789abcdef\" for c in value)\n    60\t               for value in self.row_digests):\n    61\t            raise ValueError(\"语义提案必须绑定完整观察摘要\")\n    62\t        return self\n    63\t\n    64\t\n    65\tclass ApprovedSemanticMerge(BaseModel):\n    66\t    \"\"\"已获独立复核签发的正向语义归并。\n    67\t\n    68\t    候选 :class:`SemanticGroupingProposal` 自身不再授权合并；正向归并\n    69\t    必须同时携带绑定同一观察对、裁决为 compatible 的独立复核回执。\n    70\t    否决方向不需要签发（保守方向不受模型自信影响）。\n    71\t    \"\"\"\n    72\t\n    73\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    74\t\n    75\t    schema_version: Literal[\"1\"] = \"1\"\n    76\t    merge_id: str\n    77\t    proposal: SemanticGroupingProposal\n    78\t    receipt: SemanticAdjudicationReceipt\n    79\t\n    80\t    @field_validator(\"merge_id\")\n    81\t    @classmethod\n    82\t    def _merge_id_not_blank(cls, value: str) -> str:\n    83\t        if not value.strip():\n    84\t            raise ValueError(\"归并标识不能为空\")\n    85\t        return value.strip()\n    86\t\n    87\t    @model_validator(mode=\"after\")\n    88\t    def _receipt_binds_proposal(self) -> ApprovedSemanticMerge:\n    89\t        # 重新走完整校验，阻止 model_copy(update=...) 绕过构造期约束。\n    90\t        proposal = SemanticGroupingProposal.model_validate(\n    91\t            self.proposal.model_dump(mode=\"json\")\n    92\t        )\n    93\t        receipt = SemanticAdjudicationReceipt.model_validate(\n    94\t            self.receipt.model_dump(mode=\"json\")\n    95\t        )\n    96\t        if not proposal.compatible:\n    97\t            raise ValueError(\"否决提案无需签发合并；正向归并提案必须为兼容裁决\")\n    98\t        if receipt.decision != \"compatible\":\n    99\t            raise ValueError(\"独立复核裁决与正向归并不一致\")\n   100\t        if tuple(sorted(receipt.observation_ids)) != tuple(sorted(proposal.row_ids)):\n   101\t            raise ValueError(\"回执观察对与提案观察对不一致\")\n   102\t        return self\n   103\t\n   104\t\n   105\tdef semantic_row_digest(row: Mapping[str, Any]) -> str:\n   106\t    \"\"\"Bind policy, complete supplied fact digest, and projected clinical values.\"\"\"\n   107\t    payload = {key: value for key, value in row.items() if not key.startswith(\"_\")}\n   108\t    payload[\"_source_binding\"] = row.get(\"_source_binding\")\n   109\t    payload[\"_semantic_policy\"] = SEMANTIC_POLICY_VERSION\n   110\t    return hashlib.sha256(json.dumps(\n   111\t        payload, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n   112\t    ).encode()).hexdigest()\n   113\t\n   114\t\n   115\tdef _observation(row: Mapping[str, Any]) -> ClinicalConstructObservation:\n   116\t    return ClinicalConstructObservation.model_validate({\n   117\t        \"observation_id\": row[\"row_id\"],\n   118\t        \"clinical_construct\": row.get(\"clinical_concept\", \"not_reported\"),\n   119\t        \"definition\": row.get(\"semantic_definition\", \"not_reported\"),\n   120\t        \"direction\": row.get(\"semantic_direction\", \"not_reported\"),\n   121\t        \"unit\": row.get(\"unit\", \"not_reported\"),\n   122\t        \"estimand\": row.get(\"semantic_estimand\", \"not_reported\"),\n   123\t        \"denominator\": row.get(\"semantic_denominator\", \"not_reported\"),\n   124\t        \"analysis_set\": row.get(\"semantic_analysis_set\", \"not_reported\"),\n   125\t        \"analysis_form\": row.get(\"semantic_analysis_form\", \"not_reported\"),\n   126\t        \"instrument_or_scale\": row.get(\"semantic_instrument_or_scale\", \"not_reported\"),\n   127\t        \"actual_timepoint\": row.get(\"actual_timepoint\"),\n   128\t        \"actual_timepoint_unit\": row.get(\"actual_timepoint_unit\"),\n   129\t    })\n   130\t\n   131\t\n   132\tdef proposed_semantic_buckets(\n   133\t    buckets: Sequence[Sequence[tuple[dict[str, Any], Any]]],\n   134\t    proposals: Sequence[SemanticGroupingProposal],\n   135\t    *, descriptive_only: bool = False,\n   136\t    approved_merges: Sequence[ApprovedSemanticMerge] = (),\n   137\t) -> tuple[tuple[tuple[dict[str, Any], Any], ...], ...]:\n   138\t    \"\"\"Complete-link grouping: no transitive compatibility and no dropped observations.\n   139\t\n   140\t    Same-trial descriptive groups remain available. Every cross-trial pair passes\n   141\t    the deterministic guard, including pairs for which no proposal was supplied.\n   142\t    Positive (model-asserted) merges additionally require an independently\n   143\t    reviewed :class:`ApprovedSemanticMerge`; candidate proposals alone\n   144\t    contribute vetoes and guard inputs, never merges.\n   145\t    \"\"\"\n   146\t    rows: dict[str, tuple[dict[str, Any], Any]] = {}\n   147\t    origin: dict[str, int] = {}\n   148\t    for index, bucket in enumerate(buckets):\n   149\t        for item in bucket:\n   150\t            row_id = str(item[0][\"row_id\"])\n   151\t            if row_id in rows:\n   152\t                raise ValueError(\"语义视图观察标识重复\")\n   153\t            rows[row_id] = item\n   154\t            origin[row_id] = index\n   155\t    pairs: dict[frozenset[str], SemanticGroupingProposal] = {}\n   156\t    for proposal in proposals:\n   157\t        proposal = SemanticGroupingProposal.model_validate(proposal.model_dump(mode=\"json\"))\n   158\t        for row_id, digest in zip(proposal.row_ids, proposal.row_digests, strict=True):\n   159\t            if row_id in rows and semantic_row_digest(rows[row_id][0]) != digest:\n   160\t                raise ValueError(\"语义提案观察摘要不一致，必须重新研究和复核\")\n   161\t        if not set(proposal.row_ids).issubset(rows):\n   162\t            continue  # Another physical page may own the other observation.\n   163\t        if descriptive_only and proposal.compatible:\n   164\t            raise ValueError(\"该域目前仅支持描述性展示，不能接受正向语义裁决提案\")\n   165\t        key = frozenset(proposal.row_ids)\n   166\t        if key in pairs:\n   167\t            raise ValueError(\"同一观察对存在重复语义提案\")\n   168\t        pairs[key] = proposal\n   169\t    approved_pairs: dict[frozenset[str], ApprovedSemanticMerge] = {}\n   170\t    for merge in approved_merges:\n   171\t        merge = ApprovedSemanticMerge.model_validate(merge.model_dump(mode=\"json\"))\n   172\t        if not set(merge.proposal.row_ids).issubset(rows):\n   173\t            continue  # Page-local projection; the full pool owns the other row.\n   174\t        for row_id, digest in zip(\n   175\t            merge.proposal.row_ids, merge.proposal.row_digests, strict=True\n   176\t        ):\n   177\t            if row_id in rows and semantic_row_digest(rows[row_id][0]) != digest:\n   178\t                raise ValueError(\"已批准归并的观察摘要不一致，必须重新研究和复核\")\n   179\t        if descriptive_only:\n   180\t            raise ValueError(\"描述性域不接受正向语义归并\")\n   181\t        key = frozenset(merge.proposal.row_ids)\n   182\t        if key in approved_pairs:\n   183\t            raise ValueError(\"同一观察对存在重复的已批准归并\")\n   184\t        approved_pairs[key] = merge\n   185\t\n   186\t    def compatible(left_id: str, right_id: str) -> bool:\n   187\t        proposal = pairs.get(frozenset((left_id, right_id)))\n   188\t        if (proposal is not None and proposal.compatible\n   189\t                and frozenset((left_id, right_id)) not in approved_pairs):\n   190\t            # 候选正向提案未经独立复核签发：不作为合并依据，\n   191\t            # 回退到确定性路径（同桶 + 守卫）或维持分离。\n   192\t            proposal = None\n   193\t        if proposal is None:\n   194\t            if origin[left_id] != origin[right_id]:\n   195\t                return False\n   196\t            if descriptive_only:\n   197\t                return True\n   198\t            left_row, right_row = rows[left_id][0], rows[right_id][0]\n   199\t            if (left_row.get(\"trial_id\") and\n   200\t                    left_row.get(\"trial_id\") == right_row.get(\"trial_id\") and\n   201\t                    left_row.get(\"product_id\") == right_row.get(\"product_id\")):\n   202\t                return True  # Within-trial longitudinal description, not cross-trial equivalence.\n   203\t        elif not proposal.compatible:\n   204\t            return False\n   205\t        try:\n   206\t            left, right = _observation(rows[left_id][0]), _observation(rows[right_id][0])\n   207\t        except ValueError:\n   208\t            return False\n   209\t        if any(semantic_value_is_unknown(value) for value in (\n   210\t            left.clinical_construct, left.definition, right.clinical_construct, right.definition,\n   211\t        )):\n   212\t            return False\n   213\t        if proposal is None:\n   214\t            return compare_clinical_constructs(left, right).compatible\n   215\t        if left.timepoint_weeks != right.timepoint_weeks and not proposal.time_window_compatible:\n   216\t            return False\n   217\t        # Only wording is proposed equivalent. Original rows remain unchanged.\n   218\t        right_for_guard = right.model_copy(update={\n   219\t            \"clinical_construct\": left.clinical_construct, \"definition\": left.definition,\n   220\t        })\n   221\t        return compare_clinical_constructs(left, right_for_guard).compatible\n   222\t\n   223\t    groups: list[list[str]] = []\n   224\t    for row_id in sorted(rows):\n   225\t        for group in groups:\n   226\t            if all(compatible(row_id, existing) for existing in group):\n   227\t                group.append(row_id)\n   228\t                break\n   229\t        else:\n   230\t            groups.append([row_id])\n   231\t    return tuple(tuple(rows[row_id] for row_id in group) for group in groups)\n","exit_code":0,"status":"completed"}}
