  semantic_row_digest,\n    41\t    semantic_source_digest,\n    42\t)\n    43\tfrom ci_workflow.reports.common.evidence_view import (\n    44\t    EvidenceField,\n    45\t    EvidenceFieldState,\n    46\t    EvidenceObservationKind,\n    47\t    EvidenceView,\n    48\t    OriginalTextStatus,\n    49\t)\n    50\tfrom ci_workflow.reports.common.page_registry import PageRegistry, ReportCatalog, StaticPage\n    51\tfrom ci_workflow.reports.common.view_state import ReportRow\n    52\tfrom ci_workflow.storage.manifest_store import (\n    53\t    ArtifactFileBinding,\n    54\t    ArtifactManifest,\n    55\t    DesignContractBinding,\n    56\t    DeterministicCheck,\n    57\t    RendererBinding,\n    58\t    RenderVerdict,\n    59\t)\n    60\tfrom ci_workflow.storage.render_transaction import (\n    61\t    RenderTransactionError,\n    62\t    UnpublishedRenderTransaction,\n    63\t)\n    64\tfrom ci_workflow.storage.snapshot_store import (\n    65\t    LockedSnapshot,\n    66\t    ReportSnapshotManifest,\n    67\t    SnapshotIntegrityError,\n    68\t    SnapshotStore,\n    69\t    compute_locked_snapshot,\n    70\t)\n    71\t\n    72\tfrom .builder import resolve_echarts_bundle, resolve_logo_src, resolve_portal_asset\n    73\tfrom .evidence_drawer import render_evidence_drawer_embed, render_evidence_drawer_host\n    74\tfrom .report_a import EfficacyRow, ReportAPortalData, SafetyRow, TrialRow, _git_commit\n    75\t\n    76\t_TEMPLATE_DIR = Path(__file__).resolve().parent / \"templates\" / \"b\"\n    77\t_ASSET_DIR = Path(__file__).resolve().parent / \"assets\"\n    78\t\n    79\t# B's static route authority is the frozen catalog.  The tuple below is only a\n    80\t# dispatch map for page data; it intentionally contains no route strings.\n    81\t_BASELINE_PAGE_IDS = frozenset(\n    82\t    {\n    83\t        \"baseline-overview\",\n    84\t        \"baseline-demographics\",\n    85\t        \"baseline-disease-context\",\n    86\t        \"baseline-severity\",\n    87\t    }\n    88\t)\n    89\t_BASELINE_PAGE_CONCEPTS: dict[str, frozenset[str]] = {\n    90\t    \"baseline-demographics\": frozenset({\"age\", \"sex\"}),\n    91\t    \"baseline-disease-context\": frozenset({\"disease_duration\"}),\n    92\t    \"baseline-severity\": frozenset({\"baseline_easi\", \"baseline_hemoglobin\", \"baseline_ldh\"}),\n    93\t}\n    94\t_DISPOSITION_PAGE_IDS = frozenset(\n    95\t    {\n    96\t        \"disposition-overview\",\n    97\t        \"participant-flow\",\n    98\t        \"adherence\",\n    99\t        \"loss-exit\",\n   100\t        \"screen-failure\",\n   101\t        \"rescue-treatment\",\n   102\t        \"prohibited-medication\",\n   103\t        \"plan-deviation\",\n   104\t    }\n   105\t)\n","exit_code":0,"status":"completed"}}
