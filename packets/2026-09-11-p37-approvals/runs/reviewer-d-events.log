{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc 'nl -ba tests/browser/test_b_semantic_proposals.py'","aggregated_output":"     1\t\"\"\"Synthetic bound proposals exercised through real B HTML and browser charts.\"\"\"\n     2\t\n     3\timport json\n     4\tfrom pathlib import Path\n     5\t\n     6\timport pytest\n     7\tfrom playwright.sync_api import sync_playwright\n     8\t\n     9\tfrom ci_workflow.renderers.portal.report_b import (\n    10\t    ReportBPortalData,\n    11\t    _display_trial_name,\n    12\t    _efficacy_records,\n    13\t    render_report_b_site,\n    14\t)\n    15\tfrom tests.reports.b.test_semantic_grouping_proposals import _proposal\n    16\t\n    17\t\n    18\tdef proposal_data() -> ReportBPortalData:\n    19\t    root = Path(__file__).resolve().parents[2]\n    20\t    payload = json.loads(\n    21\t        (root / \"fixtures/synthetic/a-complete/inputs/report-data.json\").read_bytes(),\n    22\t    )\n    23\t    facts = []\n    24\t    for index, trial in enumerate(payload[\"trials\"][:2]):\n    25\t        facts.append({\n    26\t            \"row_id\": f\"proposal-observation-{index}\", \"product_id\": trial[\"product_id\"],\n    27\t            \"trial_id\": trial[\"id\"], \"original_endpoint\": \"EASI-75\",\n    28\t            \"original_definition\": \"EASI改善至少75%的比例\" if index else \"EASI-75应答者比例\",\n    29\t            \"actual_timepoint\": 48 + index * 2, \"actual_timepoint_unit\": \"week\",\n    30\t            \"analysis_form\": \"response_rate\", \"analysis_population\": \"FAS\",\n    31\t            \"arm_label\": \"active\", \"unit\": \"%\", \"value\": 60 + index,\n    32\t            \"direction\": \"higher_is_better\", \"estimand\": \"treatment_policy\",\n    33\t            \"denominator_semantics\": \"full_analysis_set\", \"instrument_or_scale\": \"EASI v1.0\",\n    34\t            \"source_version_id\": f\"synthetic-source-{index}\",\n    35\t        })\n    36\t    payload[\"efficacy_views\"] = {\"facts\": facts}\n    37\t    data = ReportBPortalData.model_validate(payload)\n    38\t    names = {product.id: product.name for product in data.products}\n    39\t    trials = {\n    40\t        trial.id: _display_trial_name(trial, names[trial.product_id]) for trial in data.trials\n    41\t    }\n    42\t    records = _efficacy_records(data, names, trials)\n    43\t    from tests.reports.b.test_semantic_grouping_proposals import _approved\n    44\t\n    45\t    payload[\"semantic_proposals\"] = [\n    46\t        _proposal(records[0][0], records[1][0]).model_dump(mode=\"json\")\n    47\t    ]\n    48\t    payload[\"semantic_adjudications\"] = [\n    49\t        _approved(records[0][0], records[1][0]).model_dump(mode=\"json\")\n    50\t    ]\n    51\t    return ReportBPortalData.model_validate(payload)\n    52\t\n    53\t\n    54\t@pytest.mark.parametrize(\"engine\", [\"chromium\", \"webkit\"])\n    55\tdef test_dossier_uses_global_scientific_partition(tmp_path: Path, engine: str) -> None:\n    56\t    payload = proposal_data().model_dump(mode=\"json\")\n    57\t    second = payload[\"efficacy_views\"][\"facts\"][1]\n    58\t    third_trial = dict(payload[\"trials\"][1], id=\"synthetic-third-trial\")\n    59\t    payload[\"trials\"].append(third_trial)\n    60\t    payload[\"efficacy_views\"][\"facts\"].append(dict(\n    61\t        second, row_id=\"proposal-observation-2\", trial_id=third_trial[\"id\"],\n    62\t        actual_timepoint=52, original_definition=\"第三种结果定义措辞\",\n    63\t    ))\n    64\t    payload[\"semantic_proposals\"] = []\n    65\t    data = ReportBPortalData.model_validate(payload)\n    66\t    names = {product.id: product.name for product in data.products}\n    67\t    trials = {trial.id: _display_trial_name(trial, names[trial.product_id])\n    68\t              for trial in data.trials}\n    69\t    rows = _efficacy_records(data, names, trials)\n    70\t    from tests.reports.b.test_semantic_grouping_proposals import _approved\n    71\t\n    72\t    payload[\"semantic_proposals\"] = [\n    73\t        _proposal(rows[0][0], rows[1][0]).model_dump(mode=\"json\"),\n    74\t        _proposal(rows[1][0], rows[2][0]).model_dump(mode=\"json\"),\n    75\t    ]\n    76\t    payload[\"semantic_adjudications\"] = [\n    77\t        _approved(rows[0][0], rows[1][0]).model_dump(mode=\"json\"),\n    78\t        _approved(rows[1][0], rows[2][0]).model_dump(mode=\"json\"),\n    79\t    ]\n    80\t    site = tmp_path / \"html\"\n    81\t    render_report_b_site(ReportBPortalData.model_validate(payload), site)\n    82\t    with sync_playwright() as playwright:\n    83\t        browser = getattr(playwright, engine).launch()\n    84\t        page = browser.new_page()\n    85\t        page.goto((site / \"efficacy.html\").as_uri())\n    86\t        full = page.evaluate(\"window.__CHART_GROUPS__\")\n    87\t        expected = {row[\"row_id\"]: group[\"scientific_group_id\"]\n    88\t                    for group in full for row in group[\"rows\"]}\n    89\t        page.goto((site / \"products\" / f'{second[\"product_id\"]}.html').as_uri())\n    90\t        detail = page.evaluate(\"window.__CHART_GROUPS__\")\n    91\t        selected = {row[\"row_id\"]: group[\"scientific_group_id\"]\n    92\t                    for group in detail for row in group[\"rows\"] if row[\"row_id\"] in expected}\n    93\t        assert selected == {key: expected[key] for key in\n    94\t                            (\"proposal-observation-1\", \"proposal-observation-2\")}\n    95\t        assert len(set(selected.values())) == 2\n    96\t        browser.close()\n    97\t\n    98\t\n    99\t@pytest.fixture(scope=\"module\")\n   100\tdef proposal_site(tmp_path_factory: pytest.TempPathFactory) -> Path:\n   101\t    site = tmp_path_factory.mktemp(\"b-semantic-proposal\") / \"html\"\n   102\t    render_report_b_site(proposal_data(), site)\n   103\t    return site\n   104\t\n   105\t\n   106\t@pytest.mark.parametrize(\"engine\", [\"chromium\", \"webkit\"])\n   107\tdef test_full_longitudinal_page_preserves_within_trial_time_series(\n   108\t    tmp_path: Path, engine: str,\n   109\t) -> None:\n   110\t    payload = proposal_data().model_dump(mode=\"json\")\n   111\t    payload[\"semantic_proposals\"] = []\n   112\t    payload[\"semantic_adjudications\"] = []\n   113\t    first = dict(payload[\"efficacy_views\"][\"facts\"][0], actual_timepoint=12,\n   114\t                 group_id=\"active-arm\")\n   115\t    payload[\"efficacy_views\"][\"facts\"] = [\n   116\t        first, dict(first, row_id=\"longitudinal-24\", actual_timepoint=24, value=75),\n   117\t    ]\n   118\t    site = tmp_path / \"html\"\n   119\t    render_report_b_site(ReportBPortalData.model_validate(payload), site)\n   120\t    with sync_playwright() as playwright:\n   121\t        browser = getattr(playwright, engine).launch()\n   122\t        page = browser.new_page()\n   123\t        page.goto((site / \"longitudinal-results.html\").as_uri())\n   124\t        groups = page.evaluate(\"window.__CHART_GROUPS__\")\n   125\t        assert len(groups) == 1\n   126\t        assert {row[\"actual_timepoint\"] for row in groups[0][\"rows\"]} == {12, 24}\n   127\t        assert {row[\"_chart_type\"] for row in groups[0][\"rows\"]} == {\"line\"}\n   128\t        assert groups[0][\"cross_trial\"] is False\n   129\t        browser.close()\n   130\t\n   131\t\n   132\t@pytest.mark.parametrize(\"engine\", [\"chromium\", \"webkit\"])\n   133\t@pytest.mark.parametrize(\"width\", [1440, 768, 390, 320])\n   134\tdef test_html_consumes_bound_groups_and_keeps_raw_observations(\n   135\t    proposal_site: Path, tmp_path: Path, engine: str, width: int,\n   136\t) -> None:\n   137\t    with sync_playwright() as playwright:\n   138\t        browser = getattr(playwright, engine).launch()\n   139\t        page = browser.new_page(viewport={\"width\": width, \"height\": 900})\n   140\t        page.goto((proposal_site / \"efficacy.html\").as_uri())\n   141\t        page.wait_for_function(\"window.__CHART_GROUPS__ && window.echarts\")\n   142\t        groups = page.evaluate(\"window.__CHART_GROUPS__\")\n   143\t        assert len(groups) == 1\n   144\t        assert groups[0][\"cross_trial\"] is True\n   145\t        assert {row[\"value\"] for row in groups[0][\"rows\"]} == {60, 61}\n   146\t        assert {row[\"actual_timepoint\"] for row in groups[0][\"rows\"]} == {48, 50}\n   147\t        chart_text = page.locator(\"#kz-chart-module\").inner_text()\n   148\t        assert \"实际观察时间：\" in chart_text and \"48 周\" in chart_text and \"50 周\" in chart_text\n   149\t        assert \"安澜双抗\" in chart_text and \"泰瑞奇单抗\" in chart_text\n   150\t        table_rows = page.locator('#kz-chart-module tr[data-row-id]')\n   151\t        assert table_rows.count() == 2\n   152\t        assert not table_rows.first.is_visible()\n   153\t        page.get_by_text(\"展开完整数据表\", exact=True).click()\n   154\t        assert table_rows.first.is_visible()\n   155\t        assert {row[\"row_id\"] for row in groups[0][\"rows\"]} == set(\n   156\t            table_rows.evaluate_all(\"rows => rows.map(row => row.dataset.rowId)\"),\n   157\t        )\n   158\t        assert page.evaluate(\"document.documentElement.scrollWidth <= innerWidth\")\n   159\t        assert \"synthetic-model\" not in page.locator(\"body\").inner_text()\n   160\t        page.locator(\"#kz-chart-module\").screenshot(\n   161\t            path=str(tmp_path / f\"group-{engine}-{width}.png\"),\n   162\t        )\n   163\t        browser.close()\n   164\t\n   165\t\n   166\t@pytest.fixture(scope=\"module\")\n   167\tdef dense_site(tmp_path_factory: pytest.TempPathFactory) -> Path:\n   168\t    payload = proposal_data().model_dump(mode=\"json\")\n   169\t    payload.pop(\"semantic_proposals\")\n   170\t    payload.pop(\"semantic_adjudications\")\n   171\t    template_trial = payload[\"trials\"][0]\n   172\t    template_fact = payload[\"efficacy_views\"][\"facts\"][0]\n   173\t    trials, facts = [], []\n   174\t    for index in range(8):\n   175\t        trial_id = f\"dense-trial-{index}\"\n   176\t        trials.append(dict(template_trial, id=trial_id, name=f\"合成研究{index + 1:02}\",\n   177\t                           display_id=f\"合成研究{index + 1:02}\"))\n   178\t        facts.append(dict(template_fact, row_id=f\"dense-fact-{index}\", trial_id=trial_id))\n   179\t    payload[\"trials\"] = [*payload[\"trials\"], *trials]\n   180\t    payload[\"efficacy_views\"] = {\"facts\": facts}\n   181\t    site = tmp_path_factory.mktemp(\"b-dense-categories\") / \"html\"\n   182\t    render_report_b_site(ReportBPortalData.model_validate(payload), site)\n   183\t    return site\n   184\t\n   185\t\n   186\t@pytest.mark.parametrize(\"engine\", [\"chromium\", \"webkit\"])\n   187\tdef test_all_categories_remain_keyboard_scrollable_after_resize(\n   188\t    dense_site: Path, engine: str,\n   189\t) -> None:\n   190\t    with sync_playwright() as playwright:\n   191\t        browser = getattr(playwright, engine).launch()\n   192\t        page = browser.new_page(viewport={\"width\": 1440, \"height\": 900})\n   193\t        page.goto((dense_site / \"efficacy.html\").as_uri())\n   194\t        page.set_viewport_size({\"width\": 320, \"height\": 900})\n   195\t        viewport = page.locator('[aria-label=\"完整图形，较宽时可左右滚动\"]').first\n   196\t        viewport.scroll_into_view_if_needed()\n   197\t        page.wait_for_function(\n   198\t            \"document.querySelector('[data-chart-type=bar]').parentElement.tabIndex === 0\",\n   199\t        )\n   200\t        assert page.evaluate(\"document.documentElement.scrollWidth <= innerWidth\")\n   201\t        assert viewport.evaluate(\"node => node.scrollWidth > node.clientWidth\")\n   202\t        categories = page.evaluate(\"\"\"() => {\n   203\t          const node = document.querySelector('[data-chart-type=bar]');\n   204\t          return window.echarts.getInstanceByDom(node).getOption().xAxis[0].data;\n   205\t        }\"\"\")\n   206\t        assert len(categories) == 8\n   207\t        viewport.focus()\n   208\t        page.keyboard.press(\"ArrowRight\")\n   209\t        page.wait_for_function(\n   210\t            \"document.querySelector('[data-chart-type=bar]').parentElement.scrollLeft > 0\",\n   211\t        )\n   212\t        browser.close()\n","exit_code":0,"status":"completed"}}
