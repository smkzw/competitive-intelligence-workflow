name, ()) or ())\n  2093\t\n  2094\t\n  2095\tdef _efficacy_records(\n  2096\t    data: ReportBPortalData,\n  2097\t    names: Mapping[str, str],\n  2098\t    trial_names: Mapping[str, str],\n  2099\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2100\t    values = _legacy_or_view_rows(\n  2101\t        data,\n  2102\t        view_name=\"efficacy_views\",\n  2103\t        legacy_name=\"efficacy\",\n  2104\t        view_fields=(\"fact_rows\", \"facts\", \"rows\"),\n  2105\t    )\n  2106\t    records: list[tuple[dict[str, Any], Any]] = []\n  2107\t    for index, value in enumerate(values):\n  2108\t        row = _project_record(\n  2109\t            value,\n  2110\t            domain=\"efficacy\",\n  2111\t            names=names,\n  2112\t            trial_names=trial_names,\n  2113\t            fallback=f\"efficacy-{index + 1}\",\n  2114\t        )\n  2115\t        records.append((row, value))\n  2116\t    return _dedupe_records(records)\n  2117\t\n  2118\t\n  2119\tdef _safety_records(\n  2120\t    data: ReportBPortalData,\n  2121\t    names: Mapping[str, str],\n  2122\t    trial_names: Mapping[str, str],\n  2123\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2124\t    values = _legacy_or_view_rows(\n  2125\t        data,\n  2126\t        view_name=\"safety_views\",\n  2127\t        legacy_name=\"safety\",\n  2128\t        view_fields=(\"fact_rows\", \"facts\", \"rows\"),\n  2129\t    )\n  2130\t    records = [\n  2131\t        (\n  2132\t            _project_record(\n  2133\t                value,\n  2134\t                domain=\"safety\",\n  2135\t                names=names,\n  2136\t                trial_names=trial_names,\n  2137\t                fallback=f\"safety-{index + 1}\",\n  2138\t            ),\n  2139\t            value,\n  2140\t        )\n  2141\t        for index, value in enumerate(values)\n  2142\t    ]\n  2143\t    row_ids = {row[\"row_id\"] for row, _source in records}\n  2144\t    for legacy in data.safety:\n  2145\t        if legacy.row_id in row_ids or legacy.disclosure_state == \"已公开\":\n  2146\t            continue\n  2147\t        records.append(\n  2148\t            (\n  2149\t                _project_record(\n  2150\t                    legacy,\n  2151\t                    domain=\"safety\",\n  2152\t                    names=names,\n  2153\t                    trial_names=trial_names,\n  2154\t                    fallback=legacy.row_id,\n  2155\t                ),\n  2156\t                legacy,\n  2157\t            )\n  2158\t        )\n  2159\t    return _dedupe_records(records)\n  2160\t\n  2161\t\n  2162\tdef _state_rows_from_view(\n  2163\t    data: ReportBPortalData,\n  2164\t    *,\n  2165\t    view_name: str,\n  2166\t    page_id: str,\n  2167\t    names: Mapping[str, str],\n  2168\t    trial_names: Mapping[str, str],\n  2169\t    domain: str,\n  2170\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2171\t    source = _view_source(data, view_name)\n  2172\t    if source is None:\n  2173\t        return ()\n  2174\t    if isinstance(source, Mapping):\n  2175\t        page_source = _get(source, page_id, _MISSING)\n  2176\t        if page_source is not _MISSING and page_source is not None:\n  2177\t            source = page_source\n  2178\t    values = _flatten_view_rows(\n  2179\t        _collection(\n  2180\t            source,\n  2181\t            \"complete_table\",\n  2182\t            \"selected_facts\",\n  2183\t            \"facts\",\n  2184\t            \"table_rows\",\n  2185\t            \"rows\",\n  2186\t        )\n  2187\t    )\n  2188\t    records_list: list[tuple[dict[str, Any], Any]] = []\n  2189\t    for index, value in enumerate(values):\n  2190\t        row = _project_record(\n  2191\t            value,\n  2192\t            domain=domain,\n  2193\t            names=names,\n  2194\t            trial_names=trial_names,\n  2195\t            fallback=f\"{domain}-{index + 1}\",\n  2196\t        )\n  2197\t        row[\"_domain\"] = domain\n  2198\t        records_list.ap