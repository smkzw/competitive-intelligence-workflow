statistic_form\"), \"报告未注明统计口径\"),\n  2657\t    )\n  2658\t    time_band = _text(row.get(\"time_window_band_label_zh\"))\n  2659\t    population = _text(row.get(\"population_context_label_zh\"))\n  2660\t    parts = [concept]\n  2661\t    if include_statistic:\n  2662\t        parts.append(statistic)\n  2663\t    if include_time and time_band and time_band != \"时间点未列示\":\n  2664\t        parts.append(time_band)\n  2665\t    if include_population and population and population != \"分析人群未列示\":\n  2666\t        parts.append(population)\n  2667\t    if domain == \"safety\":\n  2668\t        parts.insert(0, \"安全性\")\n  2669\t    elif domain == \"baseline\":\n  2670\t        parts.insert(0, \"基线\")\n  2671\t    elif domain == \"disposition\":\n  2672\t        parts.insert(0, \"完成情况\")\n  2673\t    return \" · \".join(dict.fromkeys(part for part in parts if part))\n  2674\t\n  2675\t\n  2676\tdef _group(\n  2677\t    title: str,\n  2678\t    records: Sequence[tuple[dict[str, Any], Any]],\n  2679\t    *,\n  2680\t    chart_type: str,\n  2681\t    cross_trial: bool = False,\n  2682\t    identity_series: bool = False,\n  2683\t    x_axis_label_zh: str | None = None,\n  2684\t    y_axis_label_zh: str | None = None,\n  2685\t    size_label_zh: str | None = None,\n","exit_code":0,"status":"completed"}}
