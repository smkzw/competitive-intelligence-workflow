form in rule.analysis_forms\n   908\t    )\n   909\t    if len(matches) > 1:\n   910\t        raise EndpointCompatibilityError(\"终点兼容规则匹配不唯一，拒绝依赖规则顺序\")\n   911\t    return (matches[0], ()) if matches else (None, (\"未命中终点兼容规则\",))\n   912\t\n   913\t\n   914\tdef _parsed_timepoint(observation: EndpointObservation) -> tuple[float, TimeUnit]:\n   915\t    raw_unit = _normalize_time_unit(observation.time_unit)\n   916\t    try:\n   917\t        unit = TimeUnit(raw_unit)\n   918\t    except ValueError as error:\n   919\t        raise EndpointCompatibilityError(f\"实际时间点单位未知：{observation.time_unit}\") from error\n   920\t\n   921\t    raw_timepoint = observation.timepoint\n   922\t    inferred_unit: TimeUnit | None = None\n   923\t    if isinstance(raw_timepoint, str):\n   924\t        text = _compat_text(raw_timepoint, field_name=\"实际时间点\")\n   925\t        match = _TIMEPOINT_TEXT.fullmatch(text)\n   926\t        if match is None:\n   927\t            try:\n   928\t                value = float(text)\n   929\t            except ValueError as error:\n   930\t                raise EndpointCompatibilityError(\"实际时间点无法确定\") from error\n   931\t        else:\n   932\t            value = float(match.group(1))\n   933\t            if match.group(2) is not None:\n   934\t                inferred_unit = TimeUnit(_TIME_UNIT_ALIASES[match.group(2).casefold()])\n   935\t    else:\n   936\t        value = float(raw_timepoint)\n   937\t    if not math.isfinite(value):\n   938\t        raise EndpointCompatibilityError(\"实际时间点必须是有限数值\")\n   939\t    if inferred_unit is not None and inferred_unit is not unit:\n   940\t        raise EndpointCompatibilityError(\"实际时间点的单位与时间单位字段不一致\")\n   941\t    return value, unit\n   942\t\n   943\t\n   944\tdef _timepoint_match(\n   945\t    observation: EndpointObservation,\n   946\t    policy: TimepointCompatibilityPolicy,\n   947\t) -> tuple[TimepointCompatibilityRule | None, tuple[str, ...]]:\n   948\t    try:\n   949\t        value, unit = _parsed_timepoint(observation)\n   950\t    except EndpointCompatibilityError as error:\n   951\t        label = \"时间单位不兼容\" if \"单位\" in str(error) else \"实际时间点无法确定\"\n   952\t        return None, (label,)\n   953\t    same_unit = tuple(rule for rule in policy.rules if rule.time_unit is unit)\n   954\t    if not same_unit:\n   955\t        return None, (\"时间单位不兼容\",)\n   956\t    matches = tuple(rule for rule in same_unit if rule.minimum <= value <= rule.maximum)\n   957\t    if len(matches) > 1:\n   958\t        raise EndpointCompatibilityError(\"时间窗兼容规则匹配不唯一，拒绝依赖规则顺序\")\n   959\t    if not matches:\n   960\t        return None, (\"实际时间点未命中同单位兼容窗\",)\n   961\t    matched = matches[0]\n   962\t    if matched.canonical_value is None or value == matched.canonical_value:\n   963\t        return matched, ()\n   964\t    unit_zh = {\n   965\t        TimeUnit.DAY: \"天\",\n   966\t        TimeUnit.WEEK: \"周\",\n   967\t        TimeUnit.MONTH: \"个月\",\n   968\t        TimeUnit.YEAR: \"年\",\n   969\t    }[unit]\n   970\t    return matched, (f\"实际时间点为第 {value:g} {unit_zh}，归入{matched.label_zh}\",)\n   971\t\n   972\t\n   973\tdef match_endpoint_compatibility(\n   974\t    observation: EndpointObservation | Mapping[str, Any],\n   975\t    endpoint_policy: EndpointCompatibilityPolicy | Path | str | None = None,\n   976\t    timepoint_policy: TimepointCompatibilityPolicy | Path | str | None = None,\n   977\t) -> EndpointCompatibilityResult:\n   978\t    \"\"\"按当前两份策略确定性匹配；只有两条规则都命中才形成兼容键。\"\"\"\n   979\t\n   980\t    current_observation = _validated_observation(observation)\n   981\t    current_endpoint_policy = _validated_endpoint_policy(endpoint_policy)\n   982\t    current_timepoint_policy = _validated_timepoint_policy(timepoint_policy)\n   983\t    endpoint_rule, endpoint_labels = _endpoint_match(current_observation, current_endpoint_policy)\n   984\t    timepoint_rule, timepoint_labels = _timepoint_match(\n   985\t        current_observation, current_timepoint_policy\n   986\t    )\n   987\t    labels = tuple(dict.fromkeys((*endpoint_labels, *timepoint_labels)))\n   988\t    endpoint_rule_id = None if endpoint_rule is None else endpoint_rule.rule_id\n   989\t    timepoint_rule_id = None if timepoint_rule is None else timepoint_rule.rule_id\n   990\t    key = (\n   991\t        None\n   992\t        if endpoint_rule_id is None or timepoint_rule_id is None\n   993\t        else (endpoint_rule_id, timepoint_rule_id)\n   994\t    )\n   995\t    return EndpointCompatibilityResult(\n   996\t        observation=current_observation,\n   997\t        compatible=key is not None,\n   998\t        compatibility_key=key,\n   999\t        endpoint_rule_id=endpoint_rule_id,\n  1000\t        timepoint_rule_id=timepoint_rule_id,\n  1001\t        difference_labels_zh=labels,\n  1002\t        endpoint_policy_id=current_endpoint_policy.policy_id,\n  1003\t        endpoint_policy_version=current_endpoint_policy.version,\n  1004\t        timepoint_policy_id=current_timepoint_policy.policy_id,\n  1005\t        timepoint_policy_version=current_timepoint_policy.version,\n  1006\t    )\n  1007\t\n  1008\t\n  1009\tload_endpoint_compatibility = load_endpoint_compatibility_policy\n  1010\tload_timepoint_compatibility = load_timepoint_compatibility_policy\n  1011\tmatch_endpoint_timepoint = match_endpoint_compatibility\n  1012\tresolve_endpoint_compatibility = match_endpoint_compatibility\n  1013\t\n  1014\t\n  1015\t__all__ = [\n  1016\t    \"BTrialRoleOutput\",\n  1017\t    \"EndpointAnalysisForm\",\n  1018\t    \"EndpointCompatibilityError\",\n  1019\t    \"EndpointCompatibilityPolicy\",\n  1020\t    \"EndpointCompatibilityResult\",\n  1021\t    \"EndpointCompatibilityRule\",\n  1022\t    \"EndpointDirection\",\n  1023\t    \"EndpointObservation\",\n  1024\t    \"PublicationRoleValue\",\n  1025\t    \"TimeUnit\",\n  1026\t    \"TimepointCompatibilityPolicy\",\n  1027\t    \"TimepointCompatibilityRule\",\n  1028\t    \"TrialRoleOutput\",\n  1029\t    \"TrialRoleRecord\",\n  1030\t    \"build_b_trial_role\",\n  1031\t    \"build_trial_role_output\",\n  1032\t    \"load_endpoint_compatibility\",\n  1033\t    \"load_endpoint_compatibility_policy\",\n  1034\t    \"load_timepoint_compatibility\",\n  1035\t    \"load_timepoint_compatibility_policy\",\n   880\t        raw = (\n   881\t            value.model_dump(mode=\"python\", warnings=False)\n   882\t            if isinstance(value, EndpointBasisSet)\n   883\t            else dict(value)\n   884\t        )\n   885\t        return EndpointBasisSet.model_validate(raw)\n   886\t    except (ValidationError, TypeError, ValueError) as error:\n   887\t        raise EndpointBasisError(f\"终点依据集合重新校验失败：{error}\") from error\n   888\t\n   889\t\n   890\t# Internal model aliases used by alternate report adapters.\n   891\tEndpointBasisRecord = EndpointBasis\n   892\tEndpointConsensus = EndpointBasis\n   893\t\n   894\t\n   895\tdef _validated_endpoint_policy(\n   896\t    policy: EndpointCompatibilityPolicy | Path | str | None,\n   897\t) -> EndpointCompatibilityPolicy:\n   898\t    try:\n   899\t        if policy is None or isinstance(policy, (Path, str)):\n   900\t            return load_endpoint_compatibility_policy(policy)\n   901\t        return EndpointCompatibilityPolicy.model_validate(\n   902\t            policy.model_dump(mode=\"python\", warnings=False)\n   903\t        )\n   904\t    except (ValidationError, TypeError, ValueError, EndpointCompatibilityError) as error:\n   905\t        raise EndpointBasisError(f\"终点兼容策略重新校验失败：{error}\") from error\n   906\t\n   907\t\n   908\tdef _validated_timepoint_policy(\n   909\t    policy: TimepointCompatibilityPolicy | Path | str | None,\n   910\t) -> TimepointCompatibilityPolicy:\n   911\t    try:\n   912\t        if policy is None or isinstance(policy, (Path, str)):\n   913\t            return load_timepoint_compatibility_policy(policy)\n   914\t        return TimepointCompatibilityPolicy.model_validate(\n   915\t            policy.model_dump(mode=\"python\", warnings=False)\n   916\t        )\n   917\t    except (ValidationError, TypeError, ValueError, EndpointCompatibilityError) as error:\n   918\t        raise EndpointBasisError(f\"时间窗兼容策略重新校验失败：{error}\") from error\n   919\t\n   920\t\n   921\tdef _validated_observation(value: EndpointObservation | Mapping[str, Any]) -> EndpointObservation:\n   922\t    try:\n   923\t        if isinstance(value, EndpointObservation):\n   924\t            raw = value.model_dump(mode=\"python\", warnings=False)\n   925\t        else:\n   926\t            raw = dict(value)\n   927\t        return EndpointObservation.model_validate(raw)\n   928\t    except (ValidationError, TypeError, ValueError) as error:\n   929\t        raise EndpointBasisError(f\"终点观察重新校验失败：{error}\") from error\n   930\t\n   931\t\n   932\tdef _validated_compatibility(\n   933\t    value: EndpointCompatibilityResult,\n   934\t) -> EndpointCompatibilityResult:\n   935\t    try:\n   936\t        return EndpointCompatibilityResult.model_validate(\n   937\t            value.model_dump(mode=\"python\", warnings=False)\n   938\t        )\n   939\t    except (ValidationError, TypeError, ValueError) as error:\n   940\t        raise EndpointBasisError(f\"终点兼容结果重新校验失败：{error}\") from error\n   941\t\n   942\t\n   943\tdef _metadata_text(payload: dict[str, Any], *keys: str) -> str | None:\n   944\t    for key in keys:\n   945\t        if key in payload:\n   946\t            value = payload.pop(key)\n   947\t            if value is None:\n   948\t                return None\n   949\t            if not isinstance(value, str):\n   950\t                raise EndpointBasisError(f\"终点依据字段 {key} 必须是文本\")\n   951\t            return _optional_text(value, field_name=\"终点依据字段\")\n   952\t    return None\n   953\t\n   954\t\n   955\tdef _coerce_endpoint_basis_observation(\n   956\t    value: EndpointBasisObservation\n   957\t    | EndpointObservation\n   958\t    | EndpointCompatibilityResult\n   959\t    | Mapping[str, Any],\n   960\t    *,\n   961\t    endpoint_policy: EndpointCompatibilityPolicy,\n   962\t    timepoint_policy: TimepointCompatibilityPolicy,\n   963\t) -> EndpointBasisObservation:\n   964\t    supplied_compatibility: EndpointCompatibilityResult | None = None\n   965\t    if isinstance(value, EndpointBasisObservation):\n   966\t        try:\n   967\t            envelope = EndpointBasisObservation.model_validate(\n   968\t                value.model_dump(mode=\"python\", warnings=False)\n   969\t            )\n   970\t        except (ValidationError, TypeError, ValueError) as error:\n   971\t            raise EndpointBasisError(f\"终点依据记录重新校验失败：{error}\") from error\n   972\t        observation = _validated_observation(envelope.observation)\n   973\t        supplied_compatibility = (\n   974\t            None\n   975\t            if envelope.compatibility is None\n   976\t            else _validated_compatibility(envelope.compatibility)\n   977\t        )\n   978\t        metadata = envelope\n   979\t    elif isinstance(value, EndpointCompatibilityResult):\n   980\t        supplied_compatibility = _validated_compatibility(value)\n   981\t        observation = _validated_observation(supplied_compatibility.observation)\n   982\t        metadata = EndpointBasisObservation(observation=observation)\n   983\t    elif isinstance(value, EndpointObservation):\n   984\t        observation = _validated_observation(value)\n   985\t        metadata = EndpointBasisObservation(observation=observation)\n   986\t    else:\n   987\t        payload = dict(value)\n   988\t        nested = payload.pop(\"observation\", None)\n   989\t        supplied_raw = payload.pop(\"compatibility\", None)\n   990\t        if supplied_raw is not None:\n   991\t            try:\n   992\t                supplied_compatibility = _validated_compatibility(\n   993\t                    supplied_raw\n   994\t                    if isinstance(supplied_raw, EndpointCompatibilityResult)\n   995\t                    else EndpointCompatibilityResult.model_validate(supplied_raw)\n   996\t                )\n   997\t            except (ValidationError, TypeError, ValueError) as error:\n   998\t                raise EndpointBasisError(f\"终点兼容结果重新校验失败：{error}\") from error\n   999\t        if nested is not None:\n  1000\t            observation = _validated_observation(nested)\n  1001\t        else:\n  1002\t            # 只从显式信封字段移除元数据；剩余内容必须完全通过 Task 6.1 模型。\n  1003\t            for key in (\n  1004\t                \"product_id\",\n  1005\t                \"product\",\n  1006\t                \"study_role\",\n  1007\t                \"trial_role\",\n  1008\t                \"source_version_id\",\n  1009\t                \"source_version\",\n  1010\t                \"source_locator\",\n  1011\t                \"locator\",\n  1012\t            ):\n  1013\t                payload.pop(key, None)\n  1014\t            observation = _validated_observation(payload)\n  1015\t        raw_product = dict(value)\n  1016\t        product_id = _metadata_text(raw_product, \"product_id\", \"product\")\n  1017\t        study_role = _metadata_text(raw_product, \"study_role\", \"trial_role\")\n  1018\t        source_version_id = _metadata_text(raw_product, \"source_version_id\", \"source_version\")\n  1019\t        raw_locator = raw_product.pop(\"source_locator\", raw_product.pop(\"locator\", None))\n  1020\t        source_locator = None\n  1021\t        if raw_locator is not None:\n  1022\t            try:\n  1023\t                source_locator = (\n  1024\t                    raw_locator\n  1025\t                    if isinstance(raw_locator, EvidenceLocator)\n  1026\t                    else EvidenceLocator.model_validate(raw_locator)\n  1027\t                )\n  1028\t            except (ValidationError, TypeError, ValueError) as error:\n  1029\t                raise EndpointBasisError(f\"终点来源定位重新校验失败：{error}\") from error\n  1030\t        metadata = EndpointBasisObservation(\n  1031\t            observation=observation,\n  1032\t            product_id=product_id,\n  1033\t            study_role=study_role,\n  1034\t            source_version_id=source_version_id,\n  1035\t            source_locator=source_locator,\n  1036\t        )\n  1037\t    computed = match_endpoint_compatibility(\n  1038\t        observation,\n  1039\t        endpoint_policy=endpoint_policy,\n  1040\t        timepoint_policy=timepoint_policy,\n  1041\t    )\n  1042\t    if supplied_compatibility is not None and supplied_compatibility != computed:\n  1043\t        raise EndpointBasisError(\"终点兼容结果必须由当前观察和当前规则重新计算\")\n  1044\t    try:\n  1045\t        return EndpointBasisObservation(\n  1046\t            observation=observation,\n  1047\t            compatibility=computed,\n  1048\t            product_id=metadata.product_id,\n  1049\t            study_role=metadata.study_role,\n  1050\t            source_version_id=metadata.source_version_id,\n  1051\t            source_locator=metadata.source_locator,\n  1052\t        )\n  1053\t    except (ValidationError, TypeError, ValueError) as error:\n  1054\t        raise EndpointBasisError(f\"终点依据记录构建失败：{error}\") from error\n  1055\t\n  1056\t\n  1057\tdef _core_trial_ids(\n  1058\t    core_trial_ids: Sequence[str] | None,\n  1059\t    core_trials: Sequence[Any] | None,\n  1060\t) -> tuple[str, ...]:\n  1061\t    values: Sequence[Any]\n  1062\t    if core_trial_ids is not None and core_trials is not None:\n  1063\t        raise EndpointBasisError(\"锁定核心试验不得同时通过两个参数提供\")\n  1064\t    if core_trials is not None:\n  1065\t        values = core_trials\n  1066\t    elif core_trial_ids is not None:\n  1067\t        values = core_trial_ids\n  1068\t    else:\n  1069\t        raise EndpointBasisError(\"必须提供锁定适格核心试验集合\")\n  1070\t    parsed: list[str] = []\n  1250\t    except (ValidationError, TypeError, ValueError) as error:\n  1251\t        raise EndpointBasisError(f\"终点依据构建失败：{error}\") from error\n  1252\t\n  1253\t\n  1254\tdef build_endpoint_basis(\n  1255\t    observations: Sequence[\n  1256\t        EndpointBasisObservation\n  1257\t        | EndpointObservation\n  1258\t        | EndpointCompatibilityResult\n  1259\t        | Mapping[str, Any]\n  1260\t    ]\n  1261\t    | None = None,\n  1262\t    *,\n  1263\t    endpoint_observations: Sequence[\n  1264\t        EndpointBasisObservation\n  1265\t        | EndpointObservation\n  1266\t        | EndpointCompatibilityResult\n  1267\t        | Mapping[str, Any]\n  1268\t    ]\n  1269\t    | None = None,\n  1270\t    core_trial_ids: Sequence[str] | None = None,\n  1271\t    core_trials: Sequence[Any] | None = None,\n  1272\t    guidelines: Sequence[GuidanceEvidence | GuidelineBasis | Mapping[str, Any]] = (),\n  1273\t    guidance_evidence: Sequence[GuidanceEvidence | GuidelineBasis | Mapping[str, Any]]\n  1274\t    | None = None,\n  1275\t    guidance_by_endpoint: Mapping[\n  1276\t        str, Sequence[GuidanceEvidence | GuidelineBasis | Mapping[str, Any]]\n  1277\t    ]\n  1278\t    | None = None,\n  1279\t    endpoint_policy: EndpointCompatibilityPolicy | Path | str | None = None,\n  1280\t    timepoint_policy: TimepointCompatibilityPolicy | Path | str | None = None,\n  1281\t) -> tuple[EndpointBasis, ...]:\n  1282\t    \"\"\"从锁定核心试验和原始终点观察构建全部终点族依据。\n  1283\t\n  1284\t    - 分母严格等于 ``core_trial_ids``/``core_trials``，不从观察记录推导。\n  1285\t    - 只有原始角色为主要终点的核心试验计入命中；同一试验在同一族内去重。\n  1286\t    - 严格多数优先；若全体族均无严格多数，只将最高命中且至少两项试验\n  1287\t      的族标记为“最常采用”。\n  1288\t    - CDE/FDA 及历史/草案版本均保留；只有当前最终版本进入\n  1289\t      ``current_guidance_evidence``。\n  1290\t    \"\"\"\n  1291\t\n  1292\t    if observations is not None and endpoint_observations is not None:\n  1293\t        raise EndpointBasisError(\"终点观察不得同时通过两个参数提供\")\n  1294\t    source_observations = (\n  1295\t        endpoint_observations if endpoint_observations is not None else observations\n  1296\t    )\n  1297\t    if source_observations is None:\n  1298\t        raise EndpointBasisError(\"必须提供终点观察\")\n  1299\t    denominator = _core_trial_ids(core_trial_ids, core_trials)\n  1300\t    endpoint_rules = _validated_endpoint_policy(endpoint_policy)\n  1301\t    timepoint_rules = _validated_timepoint_policy(timepoint_policy)\n  1302\t    if guidance_evidence is not None and guidelines:\n  1303\t        raise EndpointBasisError(\"指南依据不得同时通过两个参数提供\")\n  1304\t    supplied_guidance = guidelines if guidance_evidence is None else guidance_evidence\n  1305\t    all_guidance = _validated_guidance_tuple(supplied_guidance)\n  1306\t    if guidance_by_endpoint is not None:\n  1307\t        # 先验证所有分支；不允许一个坏分支被未命中终点掩盖。\n  1308\t        for branch in guidance_by_endpoint.values():\n  1309\t            _validated_guidance_tuple(branch)\n  1310\t\n  1311\t    canonical_trials = {item.casefold() for item in denominator}\n  1312\t    normalized_records: list[EndpointBasisObservation] = []\n  1313\t    seen_observation_ids: set[str] = set()\n  1314\t    for item in source_observations:\n  1315\t        record = _coerce_endpoint_basis_observation(\n  1316\t            item,\n  1317\t            endpoint_policy=endpoint_rules,\n  1318\t            timepoint_policy=timepoint_rules,\n  1319\t        )\n  1320\t        if record.trial_id.casefold() not in canonical_trials:\n  1321\t            # 支持研究/非锁定试验不得扩大分母或命中计数。\n  1322\t            continue\n  1323\t        if not _is_eligible_study_role(record.study_role):\n  1324\t            continue\n  1325\t        compatibility = record.compatibility\n  1326\t        if compatibility is None or not compatibility.compatible:\n  1327\t            # 无兼容规则的事实仍可由其他视图保留，但不得进入合并终点族。\n  1328\t            continue\n  1329\t        if compatibility.endpoint_rule_id is None:\n  1330\t            continue\n  1331\t        observation_key = record.observation_id.casefold()\n  1332\t        if observation_key in seen_observation_ids:\n  1333\t            raise EndpointBasisError(\"终点依据原始观察标识不得重复\")\n  1334\t        seen_observation_ids.add(observation_key)\n  1335\t        normalized_records.append(record)\n  1336\t\n  1337\t    by_family: dict[str, list[EndpointBasisObservation]] = {}\n  1338\t    for record in normalized_records:\n  1339\t        compatibility = record.compatibility\n  1340\t        assert compatibility is not None  # compatibility=True 的模型不允许此处为空\n  1341\t        family_id = compatibility.endpoint_rule_id\n  1342\t        assert family_id is not None  # compatibility=True 的模型不允许此处为空\n  1343\t        by_family.setdefault(family_id, []).append(record)\n  1344\t\n  1345\t    explicit_guidance_families = {\n  1346\t        endpoint\n  1347\t        for item in all_guidance\n  1348\t        if isinstance(item, GuidanceEvidence)\n  1349\t        for endpoint in item.endpoint_family_ids\n  1350\t    }\n  1351\t    if guidance_by_endpoint is not None:\n  1352\t        explicit_guidance_families.update(guidance_by_endpoint)\n  1353\t    rule_by_id = {rule.rule_id.casefold(): rule for rule in endpoint_rules.rules}\n  1354\t    family_ids = set(by_family)\n  1355\t    for family_id in explicit_guidance_families:\n  1356\t        rule = rule_by_id.get(family_id.casefold())\n  1357\t        if rule is None:\n  1358\t            raise EndpointBasisError(f\"指南依据引用了当前策略不存在的终点族：{family_id}\")\n  1359\t        family_ids.add(rule.rule_id)\n  1360\t\n  1361\t    bases: list[EndpointBasis] = []\n  1362\t    for family_id in sorted(family_ids):\n  1363\t        records = tuple(\n  1364\t            sorted(\n  1365\t                by_family.get(family_id, ()),\n  1366\t                key=lambda item: (\n  1367\t                    item.observation_id,\n  1368\t                    item.trial_id.casefold(),\n  1369\t                    item.endpoint_role.casefold(),\n  1370\t                ),\n  1371\t            )\n  1372\t        )\n  1373\t        rule = next((item for item in endpoint_rules.rules if item.rule_id == family_id), None)\n  1374\t        if rule is None:\n  1375\t            raise EndpointBasisError(\"兼容结果引用了当前策略不存在的终点规则\")\n  1376\t        guidance = _guidance_for_family(\n  1377\t            family_id,\n  1378\t            all_guidance=all_guidance,\n  1379\t            guidance_by_endpoint=guidance_by_endpoint,\n  1380\t        )\n  1381\t        bases.append(\n  1382\t            _build_basis(\n  1383\t                family_id=family_id,\n  1384\t                label_zh=rule.label_zh,\n  1385\t                records=records,\n  1386\t                denominator_trial_ids=denominator,\n  1387\t                guidance=guidance,\n  1388\t            )\n  1389\t        )\n  1390\t\n  1391\t    majority_candidates = [\n  1392\t        item\n  1393\t        for item in bases\n  1394\t        if item.denominator_count >= 2 and item.hit_count >= item.strict_majority_required\n  1395\t    ]\n  1396\t    if majority_candidates:\n  1397\t        majority_ids = {item.endpoint_family_id for item in majority_candidates}\n  1398\t        statuses = {\n  1399\t            item.endpoint_family_id: EndpointAdoptionStatus.STRICT_MAJORITY\n  1400\t            if item.endpoint_family_id in majority_ids\n  1401\t            else EndpointAdoptionStatus.NOT_SELECTED\n  1402\t            for item in bases\n  1403\t        }\n  1404\t    else:\n  1405\t        eligible = [item for item in bases if item.hit_count >= 2]\n  1406\t        max_hits = max((item.hit_count for item in eligible), default=0)\n  1407\t        most_common_ids = {\n  1408\t            item.endpoint_family_id for item in eligible if item.hit_count == max_hits\n  1409\t        }\n  1410\t        statuses = {\n  1411\t            item.endpoint_family_id: EndpointAdoptionStatus.MOST_COMMON\n  1412\t            if item.endpoint_family_id in most_common_ids\n  1413\t            else EndpointAdoptionStatus.NOT_SELECTED\n  1414\t            for item in bases\n  1415\t        }\n  1416\t\n  1417\t    final_bases: list[EndpointBasis] = []\n  1418\t    for basis in bases:\n  1419\t        status = statuses[basis.endpoint_family_id]\n  1420\t        if status is basis.adoption_status:\n  1421\t            final_bases.append(basis)\n  1422\t            continue\n  1423\t        payload = basis.model_dump(mode=\"python\", warnings=False)\n  1424\t        payload[\"adoption_status\"] = status\n  1425\t        payload[\"adoption_label_zh\"] = {\n  1426\t            EndpointAdoptionStatus.NOT_SELECTED: None,\n  1427\t            EndpointAdoptionStatus.STRICT_MAJORITY: \"多数竞品采用\",\n  1428\t            EndpointAdoptionStatus.MOST_COMMON: \"最常采用\",\n  1429\t        }[status]\n  1430\t        try:\n  1431\t            final_bases.append(EndpointBasis.model_validate(payload))\n  1432\t        except (ValidationError, TypeError, ValueError) as error:\n  1433\t            raise EndpointBasisError(f\"终点采用状态构建失败：{error}\") from error\n  1434\t    return tuple(final_bases)\n  1435\t\n  1436\t\n  1437\t# Plural/verb aliases keep one consensus implementation.\n  1438\tbuild_endpoint_bases = build_endpoint_basis\n  1439\tderive_endpoint_basis = build_endpoint_basis\n  1440\tresolve_endpoint_basis = build_endpoint_basis\n  1441\t\n  1442\t\n  1443\tdef build_endpoint_basis_set(\n  1444\t    observations: Sequence[\n  1445\t        EndpointBasisObservation\n  1446\t        | EndpointObservation\n  1447\t        | EndpointCompatibilityResult\n  1448\t        | Mapping[str, Any]\n  1449\t    ],\n  1450\t    *,\n  1451\t    core_trial_ids: Sequence[str],\n  1452\t    guidelines: Sequence[GuidanceEvidence | GuidelineBasis | Mapping[str, Any]] = (),\n  1453\t    guidance_by_endpoint: Mapping[\n  1454\t        str, Sequence[GuidanceEvidence | GuidelineBasis | Mapping[str, Any]]\n  1455\t    ]\n  1456\t    | None = None,\n  1457\t    endpoint_policy: EndpointCompatibilityPolicy | Path | str | None = None,\n  1458\t    timepoint_policy: TimepointCompatibilityPolicy | Path | str | None = None,\n  1459\t) -> EndpointBasisSet:\n  1460\t    \"\"\"返回带统一分母模型的终点依据集合。\"\"\"\n  1461\t\n  1462\t    denominator = _core_trial_ids(core_trial_ids, None)\n  1463\t    bases = build_endpoint_basis(\n  1464\t        observations,\n  1465\t        core_trial_ids=denominator,\n  1466\t        guidelines=guidelines,\n  1467\t        guidance_by_endpoint=guidance_by_endpoint,\n  1468\t        endpoint_policy=endpoint_policy,\n  1469\t        timepoint_policy=timepoint_policy,\n  1470\t    )\n  1471\t    return EndpointBasisSet(bases=bases, denominator_trial_ids=denominator)\n  1472\t\n  1473\t\n  1474\tclass EfficacyViewError(ValueError):\n  1475\t    \"\"\"疗效事实或视图无法满足来源闭合合同。\"\"\"\n  1476\t\n  1477\t\n  1478\tclass EfficacyArmRole(StrEnum):\n  1479\t    \"\"\"疗效比较中的治疗与对照两类组别。\"\"\"\n  1480\t\n  1481\t    TREATMENT = \"treatment\"\n  1482\t    CONTROL = \"control\"\n  1483\t\n  1484\t    # 输入别名只归一到两个正式组别，不创建第三种比较角色。\n  1485\t    ACTIVE = \"treatment\"\n","exit_code":0,"status":"completed"}}
