y_id=current_timepoint_policy.policy_id,\nsrc/ci_workflow/reports/b/contracts.py:1005:        timepoint_policy_version=current_timepoint_policy.version,\nsrc/ci_workflow/reports/b/contracts.py:1026:    \"TimepointCompatibilityPolicy\",\nsrc/ci_workflow/reports/b/contracts.py:1027:    \"TimepointCompatibilityRule\",\ntests/reports/b/test_endpoint_compatibility.py:44:        timepoint_policy=load_timepoint_compatibility_policy(TIMEPOINT_POLICY_PATH),\ntests/reports/b/test_endpoint_compatibility.py:71:        timepoint_policy=load_timepoint_compatibility_policy(TIMEPOINT_POLICY_PATH),\ntests/reports/b/test_endpoint_compatibility.py:89:        timepoint_policy=load_timepoint_compatibility_policy(TIMEPOINT_POLICY_PATH),\nsrc/ci_workflow/reports/b/semantic_contract.py:14:    TimepointCompatibilityPolicy,\nsrc/ci_workflow/reports/b/semantic_contract.py:15:    TimepointCompatibilityRule,\nsrc/ci_workflow/reports/b/semantic_contract.py:104:    def timepoint_weeks(self) -> float:\nsrc/ci_workflow/reports/b/semantic_contract.py:191:def _default_timepoint_policy() -> TimepointCompatibilityPolicy:\nsrc/ci_workflow/reports/b/semantic_contract.py:196:def _resolve_timepoint_rule(\nsrc/ci_workflow/reports/b/semantic_contract.py:198:    policy: TimepointCompatibilityPolicy,\nsrc/ci_workflow/reports/b/semantic_contract.py:199:) -> TimepointCompatibilityRule | None:\nsrc/ci_workflow/reports/b/semantic_contract.py:219:    timepoint_policy: TimepointCompatibilityPolicy | None = None,\nsrc/ci_workflow/reports/b/semantic_contract.py:280:        _default_timepoint_policy() if timepoint_policy is None else timepoint_policy\nsrc/ci_workflow/reports/b/semantic_contract.py:282:    left_rule = _resolve_timepoint_rule(first, policy)\nsrc/ci_workflow/reports/b/semantic_contract.py:283:    right_rule = _resolve_timepoint_rule(second, policy)\nsrc/ci_workflow/reports/b/semantic_contract.py:294:        delta = abs(first.timepoint_weeks - second.timepoint_weeks)\nsrc/ci_workflow/reports/b/semantic_con