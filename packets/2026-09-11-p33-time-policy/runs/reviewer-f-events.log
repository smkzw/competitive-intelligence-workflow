     \"population_context_label_zh\": population_label,\n  1138\t        \"arm_role\": arm_role,\n  1139\t        \"arm_role_label_zh\": arm_label,\n  1140\t    }\n  1141\t\n  1142\t\n  1143\tclass ReportBPortalError(ValueError):\n  1144\t    \"\"\"B 类门户输入、视图适配或物理站点构建失败。\"\"\"\n  1145\t\n  1146\t\n  1147\tclass ReportBSafetyRow(SafetyRow):\n  1148\t    \"\"\"B 类安全性行允许显式保存非数值披露状态及其医学原因。\"\"\"\n  1149\t\n  1150\t    disclosure_state: Literal[\"已公开\", \"未公开\", \"不适用\"] = \"已公开\"\n  1151\t    reason_zh: str | None = None\n  1152\t\n  1153\t\n  1154\tclass ReportBPortalData(ReportAPortalData):\n  1155\t    \"\"\"B 类门户输入合同。\n  1156\t\n  1157\t    The legacy report-data rows remain the minimum fixture contract.  Optional\n  1158\t    immutable view sets are accepted under their Task 6.1--6.8 names so a real\n  1159\t    B snapshot can be rendered without moving scientific projection into this\n  1160\t    module's templates or JavaScript.\n  1161\t    \"\"\"\n  1162\t\n  1163\t    model_config = ConfigDict(extra=\"forbid\", frozen=True, arbitrary_types_allowed=True)\n  1164\t\n  1165\t    safety: tuple[ReportBSafetyRow, ...] = Field(min_length=1)\n  1166\t    report_snapshot_id: str | None = None\n  1167\t    # 视图容器按结构化映射接收；任意对象（字符串/列表/模型实例）在边界被拒，\n  1168\t    # 使 schema 漂移在此暴露而不是深入渲染后才失败。\n  1169\t    efficacy_views: Mapping[str, Any] | None = None\n  1170\t    safety_views: Mapping[str, Any] | None = None\n  1171\t    baseline_views: Mapping[str, Any] | None = None\n  1172\t    disposition_views: Mapping[str, Any] | None = None\n  1173\t    supporting_evidence_views: Mapping[str, Any] | None = None\n  1174\t    supporting_views: Mapping[str, Any] | None = None\n  1175\t    subgroup_views: Mapping[str, Any] | None = None\n  1176\t    subgroups_views: Mapping[str, Any] | None = None\n  1177\t    matrix_view: Mapping[str, Any] | None = None\n  1178\t    matrix_views: Mapping[str, Any] | None = None\n  1179\t    views: Mapping[str, Any] | None = None\n  1180\t    view_states: Mapping[str, Any] | None = None\n  1181\t    semantic_proposals: tuple[SemanticGroupingProposal, ...] = Field(\n  1182\t        default=(), exclude_if=lambda value: not value,\n  1183\t    )\n  1184\t    semantic_adjudications: tuple[ApprovedSemanticMerge, ...] = Field(\n  1185\t        default=(), exclude_if=lambda value: not value,\n  1186\t    )\n  1187\t\n  1188\t    @model_validator(mode=\"after\")\n  1189\t    def _snapshot_is_not_blank(self) -> Self:\n  1190\t        if self.report_snapshot_id is not None and not self.report_snapshot_id.strip():\n  1191\t            raise ValueError(\"B 类报告锁定快照标识不得为空\")\n  1192\t        return self\n  1193\t\n  1194\t\n  1195\tdef load_report_b_data(path: Path) -> ReportBPortalData:\n  1196\t    \"\"\"读取并校验 B 类门户数据包。\"\"\"\n  1197\t    try:\n  1198\t        payload = json.loads(path.read_text(encoding=\"utf-8\"))\n  1199\t    except (OSError, json.JSONDecodeError) as exc:\n  1200\t        raise ReportBPortalError(f\"无法读取 B 类报告数据：{path}\") from exc\n  1201\t    try:\n  1202\t        return ReportBPortalData.model_validate(payload)\n  1203\t    except ValueError as exc:\n  1204\t        raise ReportBPortalError(f\"B 类报告数据不符合合同：{exc}\") from exc\n  1205\t\n  1206\t\n  1207\t_BASELINE_REQUIREMENTS = {\n  1208\t    \"baseline_sample_size\": (\"b_baseline_sample_size\", \"样本量\"),\n  1209\t    \"age\": (\"b_baseline_age\", \"年龄\"),\n  1210\t    \"sex\": (\"b_baseline_sex\", \"性别\"),\n  1211\t    \"baseline_severity\": (\"b_baseline_severity_anchor\", \"疾病严重程度\"),\n  1212\t}\n  1213\t\n  1214\t\n  1215\tdef report_b_baseline_gate_failures(data: ReportBPortalData) -> tuple[dict[str, str], ...]:\n  1216\t    \"\"\"逐核心试验逐组检查 D70 四类基线事实，不跨组借值。\"\"\"\n  1217\t    baseline_source = _get(data.baseline_views, \"facts\", ())\n  1218\t    disposition_source = _get(data.disposition_views, \"facts\", ())\n  1219\t    baseline_facts = tuple(item for item in baseline_source if isinstance(item, Mapping))\n  1220\t    disposition_facts = tuple(item for item in disposition_source if isinstance(item, Mapping))\n  1221\t    core_trials = {\n  1222\t        trial.id: trial\n  1223\t        for trial in data.trials\n  1224\t        if \"支持\" not in trial.role and \"事后\" not in trial.role\n  1225\t    }\n  1226\t    groups_by_trial: dict[str, set[str]] = defaultdict(set)\n  1227\t    for fact in (*baseline_facts, *disposition_facts):\n  1228\t        trial_id = _text(fact.get(\"trial_id\"))\n  1229\t        group_id = _text(fact.get(\"group_id\"))\n  1230\t        if trial_id in core_trials and group_id:\n  1231\t            groups_by_trial[trial_id].add(group_id)\n  1232\t\n  1233\t    concepts: dict[tuple[str, str], set[str]] = defaultdict(set)\n  1234\t    for fact in baseline_facts:\n  1235\t        trial_id = _text(fact.get(\"trial_id\"))\n  1236\t        group_id = _text(fact.get(\"group_id\"))\n  1237\t        if trial_id not in core_trials or not group_id:\n  1238\t            continue\n  1239\t        concept = _text(fact.get(\"standardized_concept\"))\n  1240\t        if _text(fact.get(\"variable_domain\")) == \"baseline_severity\":\n  1241\t            concepts[(trial_id, group_id)].add(\"baseline_severity\")\n  1242\t        if concept in {\"baseline_sample_size\", \"sample_size\", \"baseline_n\", \"n\"}:\n  1243\t            concepts[(trial_id, group_id)].add(\"baseline_sample_size\")\n  1244\t        elif concept in {\"age\", \"baseline_age\", \"age_at_baseline\"}:\n  1245\t            concepts[(trial_id, group_id)].add(\"age\")\n  1246\t        elif concept in {\"sex\", \"gender\", \"baseline_sex\", \"baseline_gender\"}:\n  1247\t            concepts[(trial_id, group_id)].add(\"sex\")\n  1248\t\n  1249\t    failures: list[dict[str, str]] = []\n  1250\t    for trial_id, trial in sorted(core_trials.items()):\n  1251\t        groups = sorted(groups_by_trial.get(trial_id) or {\"未识别组别\"})\n  1252\t        for group_id in groups:\n  1253\t            present = concepts.get((trial_id, group_id), set())\n  1254\t            for concept, (failure_code, label) in _BASELINE_REQUIREMENTS.items():\n  1255\t                if concept in present:\n  1256\t                    continue\n  1257\t                failures.append(\n  1258\t                    {\n  1259\t                        \"failure_code\": failure_code,\n  1260\t                        \"trial_id\": trial_id,\n  1261\t                        \"trial\": trial.display_id,\n  1262\t                        \"group_id\": group_id,\n  1263\t                        \"field\": concept,\n  1264\t                        \"field_zh\": label,\n  1265\t                    }\n  1266\t                )\n  1267\t    return tuple(failures)\n  1268\t\n  1269\t\n  1270\t# ---------------------------------------------------------------------------\n  1271\t# Small deterministic adaptation helpers\n  1272\t# ---------------------------------------------------------------------------\n  1273\t\n  1274\t_MISSING = object()\n  1275\t\n  1276\t\n  1277\tdef _get(value: Any, name: str, default: Any = None) -> Any:\n  1278\t    if value is None:\n  1279\t        return default\n  1280\t    if isinstance(value, Mapping):\n  1281\t        return value.get(name, default)\n  1282\t    try:\n  1283\t        return getattr(value, name)\n  1284\t    except (AttributeError, TypeError):\n  1285\t        return default\n  1286\t\n  1287\t\n  1288\tdef _first(value: Any, *names: str, default: Any = None) -> Any:\n  1289\t    for name in names:\n  1290\t        candidate = _get(value, name, _MISSING)\n  1291\t        if candidate is not _MISSING and candidate is not None:\n  1292\t            return candidate\n  1293\t    return default\n  1294\t\n  1295\t\n  1296\tdef _enum_value(value: Any) -> Any:\n  1297\t    return value.value if isinstance(value, Enum) else value\n  1298\t\n  1299\t\n  1300\tdef _text(value: Any, default: str = \"\") -> str:\n  1301\t    value = _enum_value(value)\n  1302\t    if value is None:\n  1303\t        return default\n  1304\t    result = \" \".join(str(value).split())\n  1305\t    return result or default\n  1306\t\n  1307\t\n  1308\tdef _native_text(value: Any, default: str = \"\") -> str:\n  1309\t    text = _text(value, default)\n  1310\t    text = _NATIVE_LABELS.get(text, text)\n  1311\t    return text.replace(\"Other events\", \"其他不良事件\")\n  1312\t\n  1313\t\n  1314\tdef _iter_values(value: Any) -> tuple[Any, ...]:\n  1315\t    if value is None:\n  1316\t        return ()\n  1317\t    if isinstance(value, (str, bytes)):\n  1318\t        return (value,)\n  1319\t    if isinstance(value, Mapping):\n  1320\t        return (value,)\n  1321\t    try:\n  1322\t        return tuple(value)\n  1323\t    except TypeError:\n  1324\t        return (value,)\n  1325\t\n  3890\t            \"disposition_views\",\n  3891\t            \"supporting_evidence_views\",\n  3892\t            \"supporting_views\",\n  3893\t            \"subgroup_views\",\n  3894\t            \"subgroups_views\",\n  3895\t            \"matrix_view\",\n  3896\t            \"matrix_views\",\n  3897\t            \"views\",\n  3898\t            \"view_states\",\n  3899\t            \"semantic_proposals\",\n  3900\t        },\n  3901\t    )\n  3902\t    (site_root / \"data\" / \"report.js\").write_text(\n  3903\t        \"window.REPORT_B=\" + _json(report_payload) + \";\\n\", encoding=\"utf-8\"\n  3904\t    )\n  3905\t\n  3906\t    env = Environment(\n  3907\t        loader=FileSystemLoader(_TEMPLATE_DIR),\n  3908\t        autoescape=True,\n  3909\t        undefined=StrictUndefined,\n  3910\t        trim_blocks=True,\n  3911\t        lstrip_blocks=True,\n  3912\t    )\n  3913\t    page_template = env.get_template(\"page.html.j2\")\n  3914\t    dossier_template = env.get_template(\"dossier.html.j2\")\n  3915\t    generated: list[Path] = []\n  3916\t\n  3917\t    for page in catalog.pages:\n  3918\t        context = _render_page_context(\n  3919\t            data,\n  3920\t            page=page,\n  3921\t            catalog=catalog,\n  3922\t            names=names,\n  3923\t            trial_names=trial_names,\n  3924\t            efficacy=efficacy,\n  3925\t            safety=safety,\n  3926\t            scientific_groups=scientific_groups,\n  3927\t            longitudinal_groups=longitudinal_groups,\n  3928\t            publication_limitation_zh=publication_limitation_zh,\n  3929\t            semantic_adjudications=data.semantic_adjudications,\n  3930\t        )\n  3931\t        output = site_root / f\"{page.id}.html\"\n  3932\t        output.write_text(page_template.render(**context), encoding=\"utf-8\")\n  3933\t        generated.append(output)\n  3934\t\n  3935\t    products_dir = site_root / \"products\"\n  3936\t    trials_dir = site_root / \"trials\"\n  3937\t    products_dir.mkdir(exist_ok=True)\n  3938\t    trials_dir.mkdir(exist_ok=True)\n  3939\t    profile_page = next(page for page in catalog.pages if page.id == \"product-trial-profiles\")\n  3940\t\n  3941\t    for product in data.products:\n  3942\t        records = tuple(item for item in detail_pool if item[0].get(\"product_id\") == product.id)\n  3943\t        context = _render_page_context(\n  3944\t            data,\n  3945\t            page=profile_page,\n  3946\t            catalog=catalog,\n  3947\t            names=names,\n  3948\t            trial_names=trial_names,\n  3949\t            efficacy=efficacy,\n  3950\t            safety=safety,\n  3951\t            scientific_groups=scientific_groups,\n  3952\t            prefix=\"../\",\n  3953\t            current=profile_page.id,\n  3954\t            semantic_adjudications=data.semantic_adjudications,\n  3955\t            detail_records=records\n  3956\t            or tuple(\n  3957\t                item\n  3958\t                for item in _synthetic_status_records(\n  3959\t                    data,\n  3960\t                    page_id=f\"product-{product.id}\",\n  3961\t                    names=names,\n  3962\t                    trial_names=trial_names,\n  3963\t                    include_products=True,\n  3964\t                )\n  3965\t                if item[0].get(\"product_id\") == product.id\n  3966\t            ),\n  3967\t            detail_kind=\"product\",\n  3968\t            detail_id=product.id,\n  3969\t            publication_limitation_zh=publication_limitation_zh,\n  3970\t        )\n  3971\t        context[\"detail_product_obj\"] = product\n  3972\t        context[\"detail_product_trials\"] = tuple(\n  3973\t            {\n  3974\t                \"id\": trial.id,\n  3975\t                \"name\": trial_names.get(trial.id, trial.name),\n","exit_code":0,"status":"completed"}}
