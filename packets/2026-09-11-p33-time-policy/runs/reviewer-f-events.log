 Any) -> Any:\n  2003\t        return _normalize_efficacy_arm_role(value)\n  2004\t\n  2005\t    @field_validator(\"direction\", mode=\"before\")\n  2006\t    @classmethod\n  2007\t    def _direction_alias(cls, value: Any) -> Any:\n  2008\t        return _normalize_efficacy_direction(value)\n  2009\t\n  2010\t    @field_validator(\"compatibility_key\", mode=\"before\")\n  2011\t    @classmethod\n  2012\t    def _compatibility_key_shape(cls, value: Any) -> tuple[str, str]:\n  2013\t        return _parse_efficacy_compatibility_key(value)\n  2014\t\n  2015\t    @field_validator(\"compatibility_difference_labels_zh\", mode=\"before\")\n  2016\t    @classmethod\n  2017\t    def _difference_labels(cls, value: Any) -> tuple[str, ...]:\n  2018\t        return tuple(\n  2019\t            _efficacy_raw_text(str(item), field_name=\"兼容差异标签\")\n  2020\t            for item in _as_tuple(value)\n  2021\t        )\n  2022\t\n  2023\t    @field_validator(\"actual_timepoint\")\n  2024\t    @classmethod\n  2025\t    def _timepoint_scalar(cls, value: int | float | str) -> int | float | str:\n  2026\t        if isinstance(value, bool):\n  2027\t            raise ValueError(\"实际时间点不得为布尔值\")\n  2028\t        if isinstance(value, float) and not math.isfinite(value):\n  2029\t            raise ValueError(\"实际时间点必须是有限数值\")\n  2030\t        if isinstance(value, str):\n  2031\t            _efficacy_raw_text(value, field_name=\"实际时间点\")\n  2032\t        return value\n  2033\t\n  2034\t    @field_validator(\"value\", \"effect_value\", \"effect_lower\", \"effect_upper\")\n  2035\t    @classmethod\n  2036\t    def _finite_fact_number(cls, value: int | float | None) -> int | float | None:\n  2037\t        if isinstance(value, bool):\n  2038\t            raise ValueError(\"疗效事实数值不得为布尔值\")\n  2039\t        if isinstance(value, float) and not math.isfinite(value):\n  2040\t            raise ValueError(\"疗效事实数值必须是有限数值\")\n  2041\t        return value\n  2042\t\n  2043\t    @model_validator(mode=\"after