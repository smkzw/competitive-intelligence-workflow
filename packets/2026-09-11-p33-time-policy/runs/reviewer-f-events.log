{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'nl -ba policies/timepoints/compatibility-v1.yaml\nnl -ba tests/reports/b/test_versioned_time_policy.py'","aggregated_output":"     1\tschema_version: \"1.0\"\n     2\tpolicy_id: timepoint-compatibility-v1\n     3\tversion: \"1.1\"\n     4\trules:\n     5\t  - rule_id: timepoint-day-28-v1\n     6\t    time_unit: day\n     7\t    minimum: 26\n     8\t    maximum: 30\n     9\t    canonical_value: 28\n    10\t    comparison_tolerance_weeks: 2\n    11\t    label_zh: 第 28 天附近\n    12\t    difference_label_zh: 实际时间点不在第 28 天兼容窗内\n    13\t  - rule_id: timepoint-week-12-v1\n    14\t    time_unit: week\n    15\t    minimum: 10\n    16\t    maximum: 14\n    17\t    canonical_value: 12\n    18\t    comparison_tolerance_weeks: 2\n    19\t    label_zh: 第 12 周附近\n    20\t    difference_label_zh: 实际时间点不在第 12 周兼容窗内\n    21\t  - rule_id: timepoint-week-24-v1\n    22\t    time_unit: week\n    23\t    minimum: 22\n    24\t    maximum: 26\n    25\t    canonical_value: 24\n    26\t    comparison_tolerance_weeks: 2\n    27\t    label_zh: 第 24 周附近\n    28\t    difference_label_zh: 实际时间点不在第 24 周兼容窗内\n    29\t  - rule_id: timepoint-week-52-v1\n    30\t    time_unit: week\n    31\t    minimum: 48\n    32\t    maximum: 56\n    33\t    canonical_value: 52\n    34\t    comparison_tolerance_weeks: 2\n    35\t    label_zh: 第 52 周附近\n    36\t    difference_label_zh: 实际时间点不在第 52 周兼容窗内\n    37\t  - rule_id: timepoint-month-6-v1\n    38\t    time_unit: month\n    39\t    minimum: 5.5\n    40\t    maximum: 6.5\n    41\t    canonical_value: 6\n    42\t    comparison_tolerance_weeks: 2\n    43\t    label_zh: 第 6 个月附近\n    44\t    difference_label_zh: 实际时间点不在第 6 个月兼容窗内\n     1\t\"\"\"P3.3 合同：时间窗可比性由版本化政策决定，废除全局 ±2 周硬编码。\n     2\t\n     3\t两套机制统一：观察按 policies/timepoints 规则归类（双侧命中且同规则），\n     4\t数值邻近性由该规则的版本化容差（comparison_tolerance_weeks，默认 2.0）\n     5\t判定；未命中规则或分属不同规则 = 不可比，不再被全局阈值放行。\n     6\t\"\"\"\n     7\tfrom __future__ import annotations\n     8\t\n     9\tfrom pathlib import Path\n    10\t\n    11\tfrom ci_workflow.reports.b.contracts import load_timepoint_compatibility_policy\n    12\tfrom ci_workflow.reports.b.semantic_contract import (\n    13\t    ClinicalConstructObservation,\n    14\t    compare_clinical_constructs,\n    15\t)\n    16\t\n    17\tROOT = Path(__file__).resolve().parents[3]\n    18\t\n    19\t\n    20\tdef _obs(row_id: str, timepoint: float, unit: str = \"week\") -> ClinicalConstructObservation:\n    21\t    return ClinicalConstructObservation.model_validate({\n    22\t        \"observation_id\": row_id,\n    23\t        \"clinical_construct\": \"easi75_response\",\n    24\t        \"definition\": \"EASI-75 应答者比例\",\n    25\t        \"direction\": \"higher_is_better\",\n    26\t        \"unit\": \"%\",\n    27\t        \"estimand\": \"treatment_policy\",\n    28\t        \"denominator\": \"full_analysis_set\",\n    29\t        \"analysis_set\": \"full_analysis_set\",\n    30\t        \"analysis_form\": \"response_rate\",\n    31\t        \"instrument_or_scale\": \"EASI v1.0\",\n    32\t        \"actual_timepoint\": timepoint,\n    33\t        \"actual_timepoint_unit\": unit,\n    34\t    })\n    35\t\n    36\t\n    37\tdef test_unmatched_window_rejected_instead_of_delta_bypass() -> None:\n    38\t    \"\"\"15 周未命中任何版本化窗口：旧 ±2 会放行 13↔15，新合同拒绝。\"\"\"\n    39\t    result = compare_clinical_constructs(_obs(\"a\", 13), _obs(\"b\", 15))\n    40\t    assert not result.compatible\n    41\t    assert any(\"版本化时间窗\" in reason for reason in result.reasons)\n    42\t\n    43\t\n    44\tdef test_off_window_pair_rejected() -> None:\n    45\t    \"\"\"8 周未命中窗口：不得因 |8-10|≤2 放行。\"\"\"\n    46\t    result = compare_clinical_constructs(_obs(\"a\", 8), _obs(\"b\", 10))\n    47\t    assert not result.compatible\n    48\t\n    49\t\n    50\tdef test_same_window_within_tolerance_remains_compatible() -> None:\n    51\t    \"\"\"48↔50 同属 week-52 窗且在默认容差内：保持可比（钉住旧行为）。\"\"\"\n    52\t    result = compare_clinical_constructs(_obs(\"a\", 48), _obs(\"b\", 50))\n    53\t    assert result.compatible\n    54\t    assert result.time_window_note_zh is not None\n    55\t\n    56\t\n    57\tdef test_same_window_beyond_tolerance_remains_incompatible() -> None:\n    58\t    \"\"\"48↔56 同窗但差 8 周 > 默认容差 2：保持不可比（钉住旧行为）。\"\"\"\n    59\t    result = compare_clinical_constructs(_obs(\"a\", 48), _obs(\"b\", 56))\n    60\t    assert not result.compatible\n    61\t    assert any(\"容差\" in reason for reason in result.reasons)\n    62\t\n    63\t\n    64\tdef test_tolerance_comes_from_versioned_policy() -> None:\n    65\t    \"\"\"容差属于政策：week-52 容差调至 4 周时 48↔52 变为可比。\"\"\"\n    66\t    policy_path = ROOT / \"policies/timepoints/compatibility-v1.yaml\"\n    67\t    policy = load_timepoint_compatibility_policy(policy_path)\n    68\t    adjusted = policy.model_copy(update={\n    69\t        \"rules\": tuple(\n    70\t            rule.model_copy(update={\"comparison_tolerance_weeks\": 4.0})\n    71\t            if rule.rule_id == \"timepoint-week-52-v1\" else rule\n    72\t            for rule in policy.rules\n    73\t        ),\n    74\t    })\n    75\t    result = compare_clinical_constructs(\n    76\t        _obs(\"a\", 48), _obs(\"b\", 52), timepoint_policy=adjusted,\n    77\t    )\n    78\t    assert result.compatible\n    79\t    strict = compare_clinical_constructs(\n    80\t        _obs(\"a\", 48), _obs(\"b\", 52),\n    81\t    )\n    82\t    assert not strict.compatible, \"默认政策下 48↔52 仍不可比（容差 2 周）\"\n    83\t\n    84\t\n    85\tdef test_different_windows_rejected() -> None:\n    86\t    \"\"\"12 周与 48 周分属不同版本化窗口：不可比。\"\"\"\n    87\t    result = compare_clinical_constructs(_obs(\"a\", 12), _obs(\"b\", 48))\n    88\t    assert not result.compatible\n    89\t    assert any(\"不同版本化时间窗\" in reason for reason in result.reasons)\n    90\t\n    91\t\n    92\tdef test_policy_file_declares_per_rule_tolerance() -> None:\n    93\t    \"\"\"发货政策必须显式声明每规则容差并升级版本。\"\"\"\n    94\t    policy = load_timepoint_compatibility_policy()\n    95\t    assert policy.version == \"1.1\"\n    96\t    for rule in policy.rules:\n    97\t        assert rule.comparison_tolerance_weeks > 0\n","exit_code":0,"status":"completed"}}
