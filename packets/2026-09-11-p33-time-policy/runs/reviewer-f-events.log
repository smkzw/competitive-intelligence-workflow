{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ci_workflow/reports/b/semantic_grouping.py | sed -n '1,280p'\nnl -ba src/ci_workflow/application/semantic_review_task.py | sed -n '1,310p'\nnl -ba src/ci_workflow/cli.py | sed -n '520,620p'\nnl -ba src/ci_workflow/application/run_service.py | sed -n '700,770p'\"","aggregated_output":"     1\t\"\"\"Bound model proposals for candidate B views; not an independent acceptance receipt.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport hashlib\n     6\timport json\n     7\tfrom collections.abc import Mapping, Sequence\n     8\tfrom typing import Any, Literal\n     9\t\n    10\tfrom pydantic import BaseModel, ConfigDict, TypeAdapter, field_validator, model_validator\n    11\t\n    12\tfrom ci_workflow.reports.b.semantic_contract import (\n    13\t    ClinicalConstructObservation,\n    14\t    SemanticAdjudicationReceipt,\n    15\t    compare_clinical_constructs,\n    16\t    semantic_value_is_unknown,\n    17\t)\n    18\t\n    19\tSEMANTIC_POLICY_VERSION = \"b-candidate-hard-axes-v2\"\n    20\t_SOURCE_JSON = TypeAdapter(Any)\n    21\t\n    22\t\n    23\tdef semantic_source_digest(value: Any) -> str:\n    24\t    \"\"\"Bind the complete supplied fact, including locator and derivation metadata.\n    25\t\n    26\t    This binds declared provenance; it does not attest that external bytes were\n    27\t    retrieved or independently verified. Those remain acquisition/review gates.\n    28\t    \"\"\"\n    29\t    return hashlib.sha256(json.dumps(\n    30\t        _SOURCE_JSON.dump_python(value, mode=\"json\"), ensure_ascii=False,\n    31\t        sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n    32\t    ).encode()).hexdigest()\n    33\t\n    34\t\n    35\tclass SemanticGroupingProposal(BaseModel):\n    36\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    37\t\n    38\t    schema_version: Literal[\"1\"] = \"1\"\n    39\t    status: Literal[\"proposal\"] = \"proposal\"\n    40\t    proposal_id: str\n    41\t    row_ids: tuple[str, str]\n    42\t    row_digests: tuple[str, str]\n    43\t    compatible: bool\n    44\t    time_window_compatible: bool = False\n    45\t    producer_id: str\n    46\t    rationale_zh: str\n    47\t\n    48\t    @field_validator(\"proposal_id\", \"producer_id\", \"rationale_zh\")\n    49\t    @classmethod\n    50\t    def nonempty(cls, value: str) -> str:\n    51\t        if not value.strip():\n    52\t            raise ValueError(\"语义提案标识与理由不能为空\")\n    53\t        return value.strip()\n    54\t\n    55\t    @model_validator(mode=\"after\")\n    56\t    def binding(self) -> SemanticGroupingProposal:\n    57\t        if len(set(self.row_ids)) != 2 or any(not value.strip() for value in self.row_ids):\n    58\t            raise ValueError(\"语义提案必须绑定两个不同观察\")\n    59\t        if any(len(value) != 64 or any(c not in \"0123456789abcdef\" for c in value)\n    60\t               for value in self.row_digests):\n    61\t            raise ValueError(\"语义提案必须绑定完整观察摘要\")\n    62\t        return self\n    63\t\n    64\t\n    65\tclass ApprovedSemanticMerge(BaseModel):\n    66\t    \"\"\"已获独立复核签发的正向语义归并。\n    67\t\n    68\t    候选 :class:`SemanticGroupingProposal` 自身不再授权合并；正向归并\n    69\t    必须同时携带绑定同一观察对、裁决为 compatible 的独立复核回执。\n    70\t    否决方向不需要签发（保守方向不受模型自信影响）。\n    71\t    \"\"\"\n    72\t\n    73\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    74\t\n    75\t    schema_version: Literal[\"1\"] = \"1\"\n    76\t    merge_id: str\n    77\t    proposal: SemanticGroupingProposal\n    78\t    receipt: SemanticAdjudicationReceipt\n    79\t\n    80\t    @field_validator(\"merge_id\")\n    81\t    @classmethod\n    82\t    def _merge_id_not_blank(cls, value: str) -> str:\n    83\t        if not value.strip():\n    84\t            raise ValueError(\"归并标识不能为空\")\n    85\t        return value.strip()\n    86\t\n    87\t    @model_validator(mode=\"after\")\n    88\t    def _receipt_binds_proposal(self) -> ApprovedSemanticMerge:\n    89\t        # 重新走完整校验，阻止 model_copy(update=...) 绕过构造期约束。\n    90\t        proposal = SemanticGroupingProposal.model_validate(\n    91\t            self.proposal.model_dump(mode=\"json\")\n    92\t        )\n    93\t        receipt = SemanticAdjudicationReceipt.model_validate(\n    94\t            self.receipt.model_dump(mode=\"json\")\n    95\t        )\n    96\t        if not proposal.compatible:\n    97\t            raise ValueError(\"否决提案无需签发合并；正向归并提案必须为兼容裁决\")\n    98\t        if receipt.decision != \"compatible\":\n    99\t            raise ValueError(\"独立复核裁决与正向归并不一致\")\n   100\t        if tuple(sorted(receipt.observation_ids)) != tuple(sorted(proposal.row_ids)):\n   101\t            raise ValueError(\"回执观察对与提案观察对不一致\")\n   102\t        return self\n   103\t\n   104\t\n   105\tdef semantic_row_digest(row: Mapping[str, Any]) -> str:\n   106\t    \"\"\"Bind policy, complete supplied fact digest, and projected clinical values.\"\"\"\n   107\t    payload = {key: value for key, value in row.items() if not key.startswith(\"_\")}\n   108\t    payload[\"_source_binding\"] = row.get(\"_source_binding\")\n   109\t    payload[\"_semantic_policy\"] = SEMANTIC_POLICY_VERSION\n   110\t    return hashlib.sha256(json.dumps(\n   111\t        payload, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n   112\t    ).encode()).hexdigest()\n   113\t\n   114\t\n   115\tdef _observation(row: Mapping[str, Any]) -> ClinicalConstructObservation:\n   116\t    return ClinicalConstructObservation.model_validate({\n   117\t        \"observation_id\": row[\"row_id\"],\n   118\t        \"clinical_construct\": row.get(\"clinical_concept\", \"not_reported\"),\n   119\t        \"definition\": row.get(\"semantic_definition\", \"not_reported\"),\n   120\t        \"direction\": row.get(\"semantic_direction\", \"not_reported\"),\n   121\t        \"unit\": row.get(\"unit\", \"not_reported\"),\n   122\t        \"estimand\": row.get(\"semantic_estimand\", \"not_reported\"),\n   123\t        \"denominator\": row.get(\"semantic_denominator\", \"not_reported\"),\n   124\t        \"analysis_set\": row.get(\"semantic_analysis_set\", \"not_reported\"),\n   125\t        \"analysis_form\": row.get(\"semantic_analysis_form\", \"not_reported\"),\n   126\t        \"instrument_or_scale\": row.get(\"semantic_instrument_or_scale\", \"not_reported\"),\n   127\t        \"actual_timepoint\": row.get(\"actual_timepoint\"),\n   128\t        \"actual_timepoint_unit\": row.get(\"actual_timepoint_unit\"),\n   129\t    })\n   130\t\n   131\t\n   132\tdef proposed_semantic_buckets(\n   133\t    buckets: Sequence[Sequence[tuple[dict[str, Any], Any]]],\n   134\t    proposals: Sequence[SemanticGroupingProposal],\n   135\t    *, descriptive_only: bool = False,\n   136\t    approved_merges: Sequence[ApprovedSemanticMerge] = (),\n   137\t) -> tuple[tuple[tuple[dict[str, Any], Any], ...], ...]:\n   138\t    \"\"\"Complete-link grouping: no transitive compatibility and no dropped observations.\n   139\t\n   140\t    Same-trial descriptive groups remain available. Every cross-trial pair passes\n   141\t    the deterministic guard, including pairs for which no proposal was supplied.\n   142\t    Positive (model-asserted) merges additionally require an independently\n   143\t    reviewed :class:`ApprovedSemanticMerge`; candidate proposals alone\n   144\t    contribute vetoes and guard inputs, never merges.\n   145\t    \"\"\"\n   146\t    rows: dict[str, tuple[dict[str, Any], Any]] = {}\n   147\t    origin: dict[str, int] = {}\n   148\t    for index, bucket in enumerate(buckets):\n   149\t        for item in bucket:\n   150\t            row_id = str(item[0][\"row_id\"])\n   151\t            if row_id in rows:\n   152\t                raise ValueError(\"语义视图观察标识重复\")\n   153\t            rows[row_id] = item\n   154\t            origin[row_id] = index\n   155\t    pairs: dict[frozenset[str], SemanticGroupingProposal] = {}\n   156\t    for proposal in proposals:\n   157\t        proposal = SemanticGroupingProposal.model_validate(proposal.model_dump(mode=\"json\"))\n   158\t        for row_id, digest in zip(proposal.row_ids, proposal.row_digests, strict=True):\n   159\t            if row_id in rows and semantic_row_digest(rows[row_id][0]) != digest:\n   160\t                raise ValueError(\"语义提案观察摘要不一致，必须重新研究和复核\")\n   161\t        if not set(proposal.row_ids).issubset(rows):\n   162\t            continue  # Another physical page may own the other observation.\n   163\t        if descriptive_only and proposal.compatible:\n   164\t            raise ValueError(\"该域目前仅支持描述性展示，不能接受正向语义裁决提案\")\n   165\t        key = frozenset(proposal.row_ids)\n   166\t        if key in pairs:\n   167\t            raise ValueError(\"同一观察对存在重复语义提案\")\n   168\t        pairs[key] = proposal\n   169\t    approved_pairs: dict[frozenset[str], ApprovedSemanticMerge] = {}\n   170\t    for merge in approved_merges:\n   171\t        merge = ApprovedSemanticMerge.model_validate(merge.model_dump(mode=\"json\"))\n   172\t        if not set(merge.proposal.row_ids).issubset(rows):\n   173\t            continue  # Page-local projection; the full pool owns the other row.\n   174\t        for row_id, digest in zip(\n   175\t            merge.proposal.row_ids, merge.proposal.row_digests, strict=True\n   176\t        ):\n   177\t            if row_id in rows and semantic_row_digest(rows[row_id][0]) != digest:\n   178\t                raise ValueError(\"已批准归并的观察摘要不一致，必须重新研究和复核\")\n   179\t        if descriptive_only:\n   180\t            raise ValueError(\"描述性域不接受正向语义归并\")\n   181\t        key = frozenset(merge.proposal.row_ids)\n   182\t        if key in approved_pairs:\n   183\t            raise ValueError(\"同一观察对存在重复的已批准归并\")\n   184\t        approved_pairs[key] = merge\n   185\t\n   186\t    def compatible(left_id: str, right_id: str) -> bool:\n   187\t        proposal = pairs.get(frozenset((left_id, right_id)))\n   188\t        if (proposal is not None and proposal.compatible\n   189\t                and frozenset((left_id, right_id)) not in approved_pairs):\n   190\t            # 候选正向提案未经独立复核签发：不作为合并依据，\n   191\t            # 回退到确定性路径（同桶 + 守卫）或维持分离。\n   192\t            proposal = None\n   193\t        if proposal is None:\n   194\t            if origin[left_id] != origin[right_id]:\n   195\t                return False\n   196\t            if descriptive_only:\n   197\t                return True\n   198\t            left_row, right_row = rows[left_id][0], rows[right_id][0]\n   199\t            if (left_row.get(\"trial_id\") and\n   200\t                    left_row.get(\"trial_id\") == right_row.get(\"trial_id\") and\n   201\t                    left_row.get(\"product_id\") == right_row.get(\"product_id\")):\n   202\t                return True  # Within-trial longitudinal description, not cross-trial equivalence.\n   203\t        elif not proposal.compatible:\n   204\t            return False\n   205\t        try:\n   206\t            left, right = _observation(rows[left_id][0]), _observation(rows[right_id][0])\n   207\t        except ValueError:\n   208\t            return False\n   209\t        if any(semantic_value_is_unknown(value) for value in (\n   210\t            left.clinical_construct, left.definition, right.clinical_construct, right.definition,\n   211\t        )):\n   212\t            return False\n   213\t        if proposal is None:\n   214\t            return compare_clinical_constructs(left, right).compatible\n   215\t        if left.timepoint_weeks != right.timepoint_weeks and not proposal.time_window_compatible:\n   216\t            return False\n   217\t        # Only wording is proposed equivalent. Original rows remain unchanged.\n   218\t        right_for_guard = right.model_copy(update={\n   219\t            \"clinical_construct\": left.clinical_construct, \"definition\": left.definition,\n   220\t        })\n   221\t        return compare_clinical_constructs(left, right_for_guard).compatible\n   222\t\n   223\t    groups: list[list[str]] = []\n   224\t    for row_id in sorted(rows):\n   225\t        for group in groups:\n   226\t            if all(compatible(row_id, existing) for existing in group):\n   227\t                group.append(row_id)\n   228\t                break\n   229\t        else:\n   230\t            groups.append([row_id])\n   231\t    return tuple(tuple(rows[row_id] for row_id in group) for group in groups)\n     1\t\"\"\"P3.7 生产者：语义归并复核工作项的发射与提交验证。\n     2\t\n     3\t对选择与消费端分桶语义一致（Reviewer-E 2026-09-11 终审修订）：\n     4\t``build_semantic_review_task`` 以渲染端相同的初始分桶为输入，只在同域\n     5\t内成对；同试验同产品对、未知语义对、硬冲突对跳过；**同桶且确定性可比\n     6\t的对跳过（消费端会自动合并）**；跨桶近窗对与仅措辞差异对进入工作项。\n     7\t``validate_semantic_review_submission`` 绑定任务摘要与当前观察、复验\n     8\t候选资格、执行消费端同等的最终时间窗守卫；伪造、陈旧、任务外、自审\n     9\t一律拒绝。渲染端合同见 :mod:`ci_workflow.reports.b.semantic_grouping`。\n    10\t\"\"\"\n    11\tfrom __future__ import annotations\n    12\t\n    13\tfrom collections.abc import Mapping, Sequence\n    14\tfrom pathlib import Path\n    15\tfrom typing import Any, Literal\n    16\t\n    17\tfrom pydantic import BaseModel, ConfigDict, field_validator, model_validator\n    18\t\n    19\tfrom ci_workflow.reports.b.semantic_contract import (\n    20\t    compare_clinical_constructs,\n    21\t    semantic_value_is_unknown,\n    22\t)\n    23\tfrom ci_workflow.reports.b.semantic_grouping import (\n    24\t    SEMANTIC_POLICY_VERSION,\n    25\t    ApprovedSemanticMerge,\n    26\t    _observation,\n    27\t    semantic_row_digest,\n    28\t)\n    29\t\n    30\tRecord = tuple[dict[str, Any], Any]\n    31\t\n    32\t\n    33\tclass SemanticReviewPair(BaseModel):\n    34\t    \"\"\"一对需要独立复核的跨试验观察；摘要绑定签发时的观察字节。\"\"\"\n    35\t\n    36\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    37\t\n    38\t    row_ids: tuple[str, str]\n    39\t    row_digests: tuple[str, str]\n    40\t    trial_ids: tuple[str, str]\n    41\t    definitions_zh: tuple[str, str]\n    42\t    guard_verdict: Literal[\"undecided\"] = \"undecided\"\n    43\t\n    44\t    @model_validator(mode=\"after\")\n    45\t    def _pair_shape(self) -> SemanticReviewPair:\n    46\t        if len(set(self.row_ids)) != 2:\n    47\t            raise ValueError(\"语义复核对必须绑定两个不同观察\")\n    48\t        return self\n    49\t\n    50\t\n    51\tclass SemanticReviewTask(BaseModel):\n    52\t    \"\"\"宿主语义复核工作项；不是接受回执。\"\"\"\n    53\t\n    54\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    55\t\n    56\t    schema_version: Literal[\"1.0\"] = \"1.0\"\n    57\t    task_id: str\n    58\t    project_id: str\n    59\t    policy_version: str\n    60\t    pairs: tuple[SemanticReviewPair, ...]\n    61\t    state: Literal[\"awaiting_host_review\"] = \"awaiting_host_review\"\n    62\t    next_action_zh: str = (\n    63\t        \"生产模型对每对观察给出兼容与否的提案与中文理由；由不同身份、不同会话\"\n    64\t        \"的独立上下文复核后，按已批准归并结构（提案+复核回执）提交。提交摘要\"\n    65\t        \"必须与工作项逐观察一致；模型与复核者不得为同一身份。\"\n    66\t    )\n    67\t\n    68\t    @field_validator(\"task_id\", \"project_id\", \"policy_version\")\n    69\t    @classmethod\n    70\t    def _required_text(cls, value: str) -> str:\n    71\t        normalized = value.strip()\n    72\t        if not normalized:\n    73\t            raise ValueError(\"语义复核工作项标识不能为空\")\n    74\t        return normalized\n    75\t\n    76\t\n    77\tdef _same_trial_product(left: Mapping[str, Any], right: Mapping[str, Any]) -> bool:\n    78\t    left_product = str(left.get(\"product_id\") or \"\").strip()\n    79\t    right_product = str(right.get(\"product_id\") or \"\").strip()\n    80\t    if not left_product or not right_product:\n    81\t        return False  # 产品未知时不得推定同产品跳过裁决。\n    82\t    return bool(\n    83\t        left.get(\"trial_id\")\n    84\t        and left.get(\"trial_id\") == right.get(\"trial_id\")\n    85\t        and left_product == right_product\n    86\t    )\n    87\t\n    88\t\n    89\tdef _wording_unifiable(\n    90\t    left_row: Mapping[str, Any], right_row: Mapping[str, Any]\n    91\t) -> bool | None:\n    92\t    \"\"\"确定性守卫：True=措辞统一后可比（含近窗）；False=硬冲突；None=语义不完整。\"\"\"\n    93\t    try:\n    94\t        left = _observation(left_row)\n    95\t        right = _observation(right_row)\n    96\t    except ValueError:\n    97\t        return None\n    98\t    if any(semantic_value_is_unknown(value) for value in (\n    99\t        left.clinical_construct, left.definition,\n   100\t        right.clinical_construct, right.definition,\n   101\t    )):\n   102\t        return None\n   103\t    if compare_clinical_constructs(left, right).compatible:\n   104\t        return True\n   105\t    unified = right.model_copy(update={\n   106\t        \"clinical_construct\": left.clinical_construct,\n   107\t        \"definition\": left.definition,\n   108\t    })\n   109\t    return compare_clinical_constructs(left, unified).compatible\n   110\t\n   111\t\n   112\tdef _base_compatible(\n   113\t    left_row: Mapping[str, Any], right_row: Mapping[str, Any]\n   114\t) -> bool:\n   115\t    return compare_clinical_constructs(\n   116\t        _observation(left_row), _observation(right_row),\n   117\t    ).compatible\n   118\t\n   119\t\n   120\tdef _is_review_candidate(\n   121\t    left_row: Mapping[str, Any],\n   122\t    right_row: Mapping[str, Any],\n   123\t    *,\n   124\t    same_bucket: bool,\n   125\t) -> bool:\n   126\t    \"\"\"发射与复验共用的候选判定，与消费端合并语义一致。\"\"\"\n   127\t    if _same_trial_product(left_row, right_row):\n   128\t        return False\n   129\t    unifiable = _wording_unifiable(left_row, right_row)\n   130\t    if unifiable is not True:\n   131\t        return False  # 未知（保留描述性）或硬冲突（模型不可覆盖）。\n   132\t    # 确定性可比且同桶 → 消费端自动合并，无需裁决。\n   133\t    return not (same_bucket and _base_compatible(left_row, right_row))\n   134\t\n   135\t\n   136\tdef build_semantic_review_task(\n   137\t    project_id: str,\n   138\t    records: Sequence[Record],\n   139\t    *,\n   140\t    buckets: Sequence[Sequence[Record]],\n   141\t) -> SemanticReviewTask:\n   142\t    \"\"\"从完整观察池与其初始分桶构建宿主语义复核工作项。\n   143\t\n   144\t    ``buckets`` 必须是渲染端消费的同一初始分桶（科学分区/文本桶）；\n   145\t    候选判定因此与消费端合并语义一致，不出现\"裁了必被拒\"或\"应裁未裁\"。\n   146\t    \"\"\"\n   147\t    rows: dict[str, dict[str, Any]] = {}\n   148\t    origin: dict[str, int] = {}\n   149\t    domain: dict[str, str] = {}\n   150\t    for index, bucket in enumerate(buckets):\n   151\t        for row, _value in bucket:\n   152\t            row_id = str(row[\"row_id\"])\n   153\t            if row_id in rows:\n   154\t                raise ValueError(\"语义复核输入包含重复观察标识\")\n   155\t            rows[row_id] = row\n   156\t            origin[row_id] = index\n   157\t            domain[row_id] = str(row.get(\"_domain\") or \"\")\n   158\t    if len(rows) != len(records):\n   159\t        raise ValueError(\"初始分桶未覆盖全部观察\")\n   160\t\n   161\t    pairs: list[SemanticReviewPair] = []\n   162\t    ids = sorted(rows)\n   163\t    for index, left_id in enumerate(ids):\n   164\t        for right_id in ids[index + 1:]:\n   165\t            if domain[left_id] != domain[right_id]:\n   166\t                continue  # 跨域对不可能被消费端接受，不进入工作项。\n   167\t            if not _is_review_candidate(\n   168\t                rows[left_id], rows[right_id],\n   169\t                same_bucket=origin[left_id] == origin[right_id],\n   170\t            ):\n   171\t                continue\n   172\t            left, right = rows[left_id], rows[right_id]\n   173\t            pairs.append(SemanticReviewPair(\n   174\t                row_ids=(left_id, right_id),\n   175\t                row_digests=(\n   176\t                    semantic_row_digest(left), semantic_row_digest(right),\n   177\t                ),\n   178\t                trial_ids=(\n   179\t                    str(left.get(\"trial_id\") or \"\"), str(right.get(\"trial_id\") or \"\"),\n   180\t                ),\n   181\t                definitions_zh=(\n   182\t                    str(left.get(\"semantic_definition\")\n   183\t                        or left.get(\"original_definition\") or \"\"),\n   184\t                    str(right.get(\"semantic_definition\")\n   185\t                        or right.get(\"original_definition\") or \"\"),\n   186\t                ),\n   187\t            ))\n   188\t    task_id = f\"semantic-review-{len(pairs)}-{ids[0][:12]}\"\n   189\t    return SemanticReviewTask(\n   190\t        task_id=task_id,\n   191\t        project_id=project_id,\n   192\t        policy_version=SEMANTIC_POLICY_VERSION,\n   193\t        pairs=tuple(pairs),\n   194\t    )\n   195\t\n   196\t\n   197\tdef validate_semantic_review_submission(\n   198\t    payloads: Sequence[Mapping[str, Any] | ApprovedSemanticMerge],\n   199\t    task: SemanticReviewTask,\n   200\t    *,\n   201\t    records: Sequence[Record],\n   202\t    buckets: Sequence[Sequence[Record]],\n   203\t) -> tuple[ApprovedSemanticMerge, ...]:\n   204\t    \"\"\"重验宿主提交的已批准归并；任何不一致或资格失效失败关闭。\"\"\"\n   205\t    rows: dict[str, dict[str, Any]] = {}\n   206\t    origin: dict[str, int] = {}\n   207\t    for index, bucket in enumerate(buckets):\n   208\t        for row, _value in bucket:\n   209\t            origin[str(row[\"row_id\"])] = index\n   210\t    for row, _value in records:\n   211\t        rows[str(row[\"row_id\"])] = row\n   212\t\n   213\t    expected = {frozenset(pair.row_ids): pair for pair in task.pairs}\n   214\t    validated: list[ApprovedSemanticMerge] = []\n   215\t    seen: set[frozenset[str]] = set()\n   216\t    for payload in payloads:\n   217\t        merge = (\n   218\t            payload\n   219\t            if isinstance(payload, ApprovedSemanticMerge)\n   220\t            else ApprovedSemanticMerge.model_validate(payload)\n   221\t        )\n   222\t        # 边界整体重验，阻止 model_copy(update=...) 伪造绑定。\n   223\t        merge = ApprovedSemanticMerge.model_validate(merge.model_dump(mode=\"json\"))\n   224\t        key = frozenset(merge.proposal.row_ids)\n   225\t        if key not in expected:\n   226\t            raise ValueError(f\"提交了任务之外的观察对归并：{sorted(merge.proposal.row_ids)}\")\n   227\t        if key in seen:\n   228\t            raise ValueError(\"同一观察对存在重复的已批准归并提交\")\n   229\t        seen.add(key)\n   230\t        pair = expected[key]\n   231\t        task_digests = dict(zip(pair.row_ids, pair.row_digests, strict=True))\n   232\t        submitted = dict(zip(\n   233\t            merge.proposal.row_ids, merge.proposal.row_digests, strict=True,\n   234\t        ))\n   235\t        if task_digests != submitted:\n   236\t            raise ValueError(\"提交摘要与任务摘要不一致，任务已过期，必须重新研究和签发\")\n   237\t        for row_id, digest in submitted.items():\n   238\t            if row_id not in rows:\n   239\t                raise ValueError(f\"提交引用当前观察池之外的观察：{row_id}\")\n   240\t            if semantic_row_digest(rows[row_id]) != digest:\n   241\t                raise ValueError(\"已批准归并的观察摘要与当前观察不一致，必须重新研究和复核\")\n   242\t        left_id, right_id = merge.proposal.row_ids\n   243\t        if not _is_review_candidate(\n   244\t            rows[left_id], rows[right_id],\n   245\t            same_bucket=origin.get(left_id) == origin.get(right_id),\n   246\t        ):\n   247\t            raise ValueError(\"观察已失去候选资格（硬冲突或已确定性可比），必须重新研究和签发\")\n   248\t        # 消费端同等最终守卫：时间窗不兼容的正向提交必然被拒，前置失败。\n   249\t        left_obs = _observation(rows[left_id])\n   250\t        right_obs = _observation(rows[right_id])\n   251\t        if (left_obs.timepoint_weeks != right_obs.timepoint_weeks\n   252\t                and not merge.proposal.time_window_compatible):\n   253\t            raise ValueError(\"提案声明时间窗不兼容，不能作为正向归并提交\")\n   254\t        validated.append(merge)\n   255\t    return tuple(validated)\n   256\t\n   257\t\n   258\tdef store_semantic_adjudications(\n   259\t    project_root: Path,\n   260\t    *,\n   261\t    report: str,\n   262\t    payload_digest: str,\n   263\t    project_id: str,\n   264\t    task_id: str,\n   265\t    adjudications: Sequence[ApprovedSemanticMerge],\n   266\t) -> Path:\n   267\t    \"\"\"把已验证裁决按项目/报告/载荷摘要绑定写入项目状态（原子替换）。\"\"\"\n   268\t    import hashlib\n   269\t    import json\n   270\t    import os\n   271\t    import tempfile\n   272\t    from datetime import UTC, datetime\n   273\t\n   274\t    record = {\n   275\t        \"schema_version\": \"1.0\",\n   276\t        \"project_id\": project_id,\n   277\t        \"report\": report,\n   278\t        \"payload_sha256\": payload_digest,\n   279\t        \"task_id\": task_id,\n   280\t        \"stored_at\": datetime.now(UTC).isoformat(),\n   281\t        \"adjudications\": [\n   282\t            merge.model_dump(mode=\"json\") for merge in adjudications\n   283\t        ],\n   284\t    }\n   285\t    path = project_root / \"state/semantic-adjudications.json\"\n   286\t    path.parent.mkdir(parents=True, exist_ok=True)\n   287\t    encoded = json.dumps(\n   288\t        record, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"),\n   289\t    ).encode(\"utf-8\") + b\"\\n\"\n   290\t    digest = hashlib.sha256(encoded).hexdigest()\n   291\t    descriptor, temp_name = tempfile.mkstemp(\n   292\t        prefix=f\".{path.name}.\", suffix=f\".{digest[:8]}.tmp\", dir=path.parent,\n   293\t    )\n   294\t    temporary = Path(temp_name)\n   295\t    try:\n   296\t        with os.fdopen(descriptor, \"wb\") as stream:\n   297\t            stream.write(encoded)\n   298\t            stream.flush()\n   299\t            os.fsync(stream.fileno())\n   300\t        os.replace(temporary, path)\n   301\t    except BaseException:\n   302\t        temporary.unlink(missing_ok=True)\n   303\t        raise\n   304\t    return path\n   305\t\n   306\t\n   307\tdef load_semantic_adjudications_for_render(\n   308\t    project_root: Path,\n   309\t    *,\n   310\t    report: str,\n   520\t                    entries.append({\n   521\t                        **entry, \"capture_path\": captured.relative_path, \"sha256\": captured.sha256,\n   522\t                    })\n   523\t        receipt = {\n   524\t            \"schema_version\": \"1.0\",\n   525\t            \"acquisition\": result.model_dump(mode=\"json\", exclude={\"studies\"}),\n   526\t            \"projection_status\": projection,\n   527\t            \"records\": entries,\n   528\t            \"limitation\": \"仅获取当前公开记录；历史版本重建、竞品闭包及独立科学复核尚未完成\",\n   529\t        }\n   530\t        blob = store.put_bytes(\n   531\t            json.dumps(receipt, ensure_ascii=False, sort_keys=True).encode(\"utf-8\"),\n   532\t            media_type=\"application/json\",\n   533\t        )\n   534\t    except (OSError, ValueError, ContentIntegrityError, ProjectWorkspaceError) as error:\n   535\t        raise ContractError(\"CT.gov来源获取或项目存储校验失败；不能视为无数据\") from error\n   536\t    print(json.dumps({\n   537\t        \"capture_path\": blob.relative_path, \"sha256\": blob.sha256,\n   538\t        \"status\": result.status, \"projection_status\": projection,\n   539\t        \"records\": len(entries), \"universe_closed\": False,\n   540\t    }, sort_keys=True))\n   541\t    return 0 if result.pagination_complete and projection == \"complete\" else 7\n   542\t\n   543\t\n   544\tdef _research_semantic_review_handler(args: argparse.Namespace) -> int:\n   545\t    \"\"\"发射/提交 B 报告语义复核工作项（P3.7 流程接线）。\"\"\"\n   546\t    import hashlib\n   547\t    import json\n   548\t\n   549\t    from ci_workflow.application.semantic_review_task import (\n   550\t        SemanticReviewTask,\n   551\t        build_semantic_review_task,\n   552\t        store_semantic_adjudications,\n   553\t        validate_semantic_review_submission,\n   554\t    )\n   555\t    from ci_workflow.renderers.portal.report_b import (\n   556\t        ReportBPortalData,\n   557\t        semantic_review_buckets_for,\n   558\t        semantic_review_domain_inputs,\n   559\t    )\n   560\t\n   561\t    root = Path(args.root)\n   562\t    data_path = Path(args.report_data)\n   