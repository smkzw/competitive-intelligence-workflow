\t                *tagged(efficacy, \"efficacy\"),\n  3440\t                *tagged(safety, \"safety\"),\n  3441\t                *tagged(matrix, \"matrix\"),\n  3442\t                *tagged(baseline, \"baseline\"),\n  3443\t                *tagged(disposition, \"disposition\"),\n  3444\t            )\n  3445\t        )\n  3446\t    if page_id in {\"efficacy\", \"longitudinal-results\"}:\n  3447\t        return tuple(tagged(efficacy, \"efficacy\"))\n  3448\t    if page_id == \"subgroups-supporting-evidence\":\n  3449\t        return _state_rows_from_view(\n  3450\t            data,\n  3451\t            view_name=\"supporting_evidence_views\",\n  3452\t            page_id=page_id,\n  3453\t            names=names,\n  3454\t            trial_names=trial_names,\n  3455\t            domain=\"supporting\",\n  3456\t        )\n  3457\t    if page_id == \"safety\":\n  3458\t        return tuple(tagged(safety, \"safety\"))\n  3459\t    if page_id in _BASELINE_PAGE_IDS:\n  3460\t        values = _state_rows_from_view(\n  3461\t            data,\n  3462\t            view_name=\"baseline_views\",\n  3463\t            page_id=page_id,\n  3464\t            names=names,\n  3465\t            trial_names=trial_names,\n  3466\t            domain=\"baseline\",\n  3467\t        )\n  3468\t        allowed = _BASELINE_PAGE_CONCEPTS.get(page_id)\n  3469\t        if allowed is not None:\n  3470\t            values = tuple(\n  3471\t                item for item in values if _text(item[0].get(\"clinical_concept\")) in allowed\n  3472\t            )\n  3473\t        if values or _view_source(data, \"baseline_views\") is not None:\n  3474\t            return values\n  3475\t        return _domain_empty_records(\n  3476\t            data,\n  3477\t            page_id=page_id,\n  3478\t            names=names,\n  3479\t            trial_names=trial_names,\n  3480\t            domain=\"baseline\",\n  3481\t        )\n  3482\t    if page_id in _DISPOSITION_PAGE_IDS:\n  3483\t        values = _s