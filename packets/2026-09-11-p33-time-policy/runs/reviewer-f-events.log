tion\", observation)\n  2079\t        object.__setattr__(self, \"compatibility\", compatibility)\n  2080\t        expected = (\n  2081\t            observation.observation_id,\n  2082\t            observation.trial_id,\n  2083\t            observation.endpoint_id,\n  2084\t            observation.endpoint_definition,\n  2085\t            observation.endpoint_role,\n  2086\t            observation.direction,\n  2087\t            observation.unit,\n  2088\t            observation.analysis_form,\n  2089\t            observation.timepoint,\n  2090\t            observation.time_unit,\n  2091\t        )\n  2092\t        actual = (\n  2093\t            self.observation_id,\n  2094\t            self.trial_id,\n  2095\t            self.original_endpoint,\n  2096\t            self.original_definition,\n  2097\t            self.endpoint_role,\n  2098\t            self.direction,\n  2099\t            self.unit,\n  2100\t            self.analysis_form,\n  2101\t            self.actual_timepoint,\n  2102\t            self.actual_timepoint_unit,\n  2103\t        )\n  2104\t        if expected != actual:\n  2105\t            raise ValueError(\"疗效事实平铺字段不得覆盖原始观察\")\n  2106\t        if not compatibility.compatible:\n  2107\t            raise ValueError(\"不兼容终点观察不得进入疗效视图\")\n  2108\t        if compatibility.compatibility_key != self.compatibility_key:\n  2109\t            raise ValueError(\"疗效事实兼容桶必须与来源兼容结果一致\")\n  2110\t        if compatibility.endpoint_rule_id != self.endpoint_family_id:\n  2111\t            raise ValueError(\"疗效事实终点族必须与来源兼容结果一致\")\n  2112\t        if tuple(self.compatibility_difference_labels_zh) != tuple(\n  2113\t            compatibility.difference_labels_zh\n  2114\t        ):\n  2115\t            raise ValueError(\"疗效事实差异标签必须保留来源兼容结果\")\n  2116\t        if observation != compatibility.observation:\n  2117\t            raise ValueError(\"疗效事实原始观察必须与来源兼容结果一致\")\n  2118\t        return self\n  2119\t\n  2120\t    @property\n  2121\t    def compatibility_bucket_id(