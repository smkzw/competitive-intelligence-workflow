"data_prefix\": f\"{prefix}data\",\n  3761\t        \"asset_prefix\": f\"{prefix}assets\",\n  3762\t        \"snapshot_id\": _text(data.report_snapshot_id, f\"b-{data.report_version}\"),\n  3763\t        \"row_set_digest\": hashlib.sha256(\n  3764\t            _canonical_json([row[\"row_id\"] for row, _source in records])\n  3765\t        ).hexdigest(),\n  3766\t        \"lead\": lead,\n  3767\t        \"section_title\": section_titles.get(page_id, title),\n  3768\t        \"visuals\": page.visuals,\n  3769\t        \"records\": records,\n  3770\t        \"external_sources\": _external_source_entries(data),\n  3771\t        \"bubble_presets\": tuple(item.model_dump(mode=\"json\") for item in BUBBLE_PRESETS),\n  3772\t        \"chart_groups_json\": chart_groups_json,\n  3773\t        \"filter_rows_json\": _json(filter_rows),\n  3774\t        \"row_dimensions_json\": _json(dimensions),\n  3775\t        \"filter_groups\": filter_groups,\n    35\tclass SemanticGroupingProposal(BaseModel):\n    36\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    37\t\n    38\t    schema_version: Literal[\"1\"] = \"1\"\n    39\t    status: Literal[\"proposal\"] = \"proposal\"\n    40\t    proposal_id: str\n    41\t    row_ids: tuple[str, str]\n    42\t    row_digests: tuple[str, str]\n    43\t    compatible: bool\n    44\t    time_window_compatible: bool = False\n    45\t    producer_id: str\n    46\t    rationale_zh: str\n    47\t\n    48\t    @field_validator(\"proposal_id\", \"producer_id\", \"rationale_zh\")\n    49\t    @classmethod\n    50\t    def nonempty(cls, value: str) -> str:\n    51\t        if not value.strip():\n    52\t            raise ValueError(\"语义提案标识与理由不能为空\")\n    53\t        return value.strip()\n    54\t\n    55\t    @model_validator(mode=\"after\")\n    56\t    def binding(self) -> SemanticGroupingProposal:\n    57\t        if len(set(self.row_ids)) != 2 or any(not value.strip() for value in self.row_ids):\n    58\t            raise ValueError(\"语义提案必须绑定两个不同观察\")\n    59\t        if any(len(value) != 64 or any(c not in \"0123456789abcdef\" for c in value)\n    60\t               for value in self.row_digests):\n    61\t            raise ValueError(\"语义提案必须绑定完整观察摘要\")\n    62\t        return self\n    63\t\n    64\t\n    65\tclass ApprovedSemanticMerge(BaseModel):\n    66\t    \"\"\"已获独立复核签发的正向语义归并。\n    67\t\n    68\t    候选 :class:`SemanticGroupingProposal` 自身不再授权合并；正向归并\n    69\t    必须同时携带绑定同一观察对、裁决为 compatible 的独立复核回执。\n    70\t    否决方向不需要签发（保守方向不受模型自信影响）。\n    71\t    \"\"\"\n    72\t\n    73\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    74\t\n    75\t    schema_version: Literal[\"1\"] = \"1\"\n    76\t    merge_id: str\n    77\t    proposal: SemanticGroupingProposal\n    78\t    receipt: SemanticAdjudicationReceipt\n    79\t\n    80\t    @field_validator(\"merge_id\")\n    81\t    @classmethod\n    82\t    def _merge_id_not_blank(cls, value: str) -> str:\n    83\t        if not value.strip():\n    84\t            raise ValueError(\"归并标识不能为空\")\n    85\t        return value.strip()\n    86\t\n    87\t    @model_validator(mode=\"after\")\n    88\t    def _receipt_binds_proposal(self) -> ApprovedSemanticMerge:\n    89\t        # 重新走完整校验，阻止 model_copy(update=...) 绕过构造期约束。\n    90\t        proposal = SemanticGroupingProposal.model_validate(\n    91\t            self.proposal.model_dump(mode=\"json\")\n    92\t        )\n    93\t        receipt = SemanticAdjudicationReceipt.model_validate(\n    94\t            self.receipt.model_dump(mode=\"json\")\n    95\t        )\n    96\t        if not proposal.compatible:\n    97\t            raise ValueError(\"否决提案无需签发合并；正向归并提案必须为兼容裁决\")\n    98\t        if receipt.decision != \"compatible\":\n    99\t            raise ValueError(\"独立复核裁决与正向归并不一致\")\n   100\t        if tuple(sorted(receipt.observation_ids)) != tuple(sorted(proposal.row_ids)):\n   101\t            raise ValueError(\"回执观察对与提案观察对不一致\")\n   102\t        return self\n   103\t\n   104\t\n   105\tdef semantic_row_digest(row: Mapping[str, Any]) -> str:\n   106\t    \"\"\"Bind policy, complete supplied fact digest, and projected clinical values.\"\"\"\n   107\t    payload = {key: value for key, value in row.items() if not key.startswith(\"_\")}\n   108\t    payload[\"_source_binding\"] = row.get(\"_source_binding\")\n   109\t    payload[\"_semantic_policy\"] = SEMANTIC_POLICY_VERSION\n   110\t    return hashlib.sha256(json.dumps(\n   111\t        payload, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n   112\t    ).encode()).hexdigest()\n    51\tclass SemanticReviewTask(BaseModel):\n    52\t    \"\"\"宿主语义复核工作项；不是接受回执。\"\"\"\n    53\t\n    54\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    55\t\n    56\t    schema_version: Literal[\"1.0\"] = \"1.0\"\n    57\t    task_id: str\n    58\t    project_id: str\n    59\t    policy_version: str\n    60\t    pairs: tuple[SemanticReviewPair, ...]\n    61\t    state: Literal[\"awaiting_host_review\"] = \"awaiting_host_review\"\n    62\t    next_action_zh: str = (\n    63\t        \"生产模型对每对观察给出兼容与否的提案与中文理由；由不同身份、不同会话\"\n    64\t        \"的独立上下文复核后，按已批准归并结构（提案+复核回执）提交。提交摘要\"\n    65\t        \"必须与工作项逐观察一致；模型与复核者不得为同一身份。\"\n    66\t    )\n    67\t\n    68\t    @field_validator(\"task_id\", \"project_id\", \"policy_version\")\n    69\t    @classmethod\n    70\t    def _required_text(cls, value: str) -> str:\n   120\tdef _is_review_candidate(\n   121\t    left_row: Mapping[str, Any],\n   122\t    right_row: Mapping[str, Any],\n   123\t    *,\n   124\t    same_bucket: bool,\n   125\t) -> bool:\n   126\t    \"\"\"发射与复验共用的候选判定，与消费端合并语义一致。\"\"\"\n   127\t    if _same_trial_product(left_row, right_row):\n   128\t        return False\n   129\t    unifiable = _wording_unifiable(left_row, right_row)\n   130\t    if unifiable is not True:\n   131\t        return False  # 未知（保留描述性）或硬冲突（模型不可覆盖）。\n   132\t    # 确定性可比且同桶 → 消费端自动合并，无需裁决。\n   133\t    return not (same_bucket and _base_compatible(left_row, right_row))\n   134\t\n   135\t\n   136\tdef build_semantic_review_task(\n   137\t    project_id: str,\n   138\t    records: Sequence[Record],\n   139\t    *,\n   140\t    buckets: Sequence[Sequence[Record]],\n   141\t) -> SemanticReviewTask:\n   142\t    \"\"\"从完整观察池与其初始分桶构建宿主语义复核工作项。\n   143\t\n   144\t    ``buckets`` 必须是渲染端消费的同一初始分桶（科学分区/文本桶）；\n   145\t    候选判定因此与消费端合并语义一致，不出现\"裁了必被拒\"或\"应裁未裁\"。\n   146\t    \"\"\"\n   147\t    rows: dict[str, dict[str, Any]] = {}\n   148\t    origin: dict[str, int] = {}\n   149\t    domain: dict[str, str] = {}\n   150\t    for index, bucket in enumerate(buckets):\n   151\t        for row, _value in bucket:\n   152\t            row_id = str(row[\"row_id\"])\n   153\t            if row_id in rows:\n   154\t                raise ValueError(\"语义复核输入包含重复观察标识\")\n   155\t            rows[row_id] = row\n   156\t            origin[row_id] = index\n   157\t            domain[row_id] = str(row.get(\"_domain\") or \"\")\n   158\t    if len(rows) != len(records):\n   159\t        raise ValueError(\"初始分桶未覆盖全部观察\")\n   160\t\n   161\t    pairs: list[SemanticReviewPair] = []\n   162\t    ids = sorted(rows)\n   163\t    for index, left_id in enumerate(ids):\n   164\t        for right_id in ids[index + 1:]:\n   165\t            if domain[left_id] != domain[right_id]:\n   166\t                continue  # 跨域对不可能被消费端接受，不进入工作项。\n   167\t            if not _is_review_candidate(\n   168\t                rows[left_id], rows[right_id],\n   169\t                same_bucket=origin[left_id] == origin[right_id],\n   170\t            ):\n   171\t                continue\n   172\t            left, right = rows[left_id], rows[right_id]\n   173\t            pairs.append(SemanticReviewPair(\n   174\t                row_ids=(left_id, right_id),\n   175\t                row_digests=(\n   176\t                    semantic_row_digest(left), semantic_row_digest(right),\n   177\t                ),\n   178\t                trial_ids=(\n   179\t                    str(left.get(\"trial_id\") or \"\"), str(right.get(\"trial_id\") or \"\"),\n   180\t                ),\n   181\t                definitions_zh=(\n   182\t                    str(left.get(\"semantic_definition\")\n   183\t                        or left.get(\"original_definition\") or \"\"),\n   184\t                    str(right.get(\"semantic_definition\")\n   185\t                        or right.get(\"original_definition\") or \"\"),\n   186\t                ),\n   187\t            ))\n   188\t    task_id = f\"semantic-review-{len(pairs)}-{ids[0][:12]}\"\n   189\t    return SemanticReviewTask(\n   190\t        task_id=task_id,\n   191\t        project_id=project_id,\n   192\t        policy_version=SEMANTIC_POLICY_VERSION,\n   193\t        pairs=tuple(pairs),\n   194\t    )\n","exit_code":0,"status":"completed"}}
