efault=\"\"))\n  1837\t    sample_size = _number(_source_first(value, source, \"sample_size\", default=None))\n  1838\t    treatment_sample_size = _number(\n  1839\t        _source_first(value, source, \"treatment_sample_size\", default=None)\n  1840\t    )\n  1841\t    modality = _text(_source_first(value, source, \"modality\", default=\"\"))\n  1842\t    developer = _text(_source_first(value, source, \"developer\", default=\"\"))\n  1843\t    mechanism = _text(_source_first(value, source, \"mechanism\", default=\"\"))\n  1844\t    route = _text(_source_first(value, source, \"route\", default=\"\"))\n  1845\t    result_status = _text(_source_first(value, source, \"result_status\", default=\"\"))\n  1846\t    regions = _first(value, \"regions\", default=None)\n  1847\t    if regions is None:\n  1848\t        regions = _first(source, \"regions\", default=None)\n  1849\t    coverage = _number(_source_first(value, source, \"coverage\", default=None))\n  1850\t    result: dict[str, Any] = {\n  1851\t        \"row_id\": row_id,\n  1852\t        \"_domain\": domain,\n  1853\t        \"product_id\": product_id,\n  1854\t        \"trial_id\": trial_id,\n  1855\t        \"target\": target,\n  1856\t        \"target_id\": target,\n  1857\t        \"display_label_zh\": label,\n  1858\t        \"element\": label,\n  1859\t        \"product_zh\": product_name,\n  1860\t        \"trial_zh\": trial_name,\n  1861\t        \"study_identity\": study_identity,\n  1862\t        \"identity_label_zh\": study_identity or \"产品与试验未列示\",\n  1863\t        \"arm\": arm,\n  1864\t        \"group\": arm,\n  1865\t        \"group_id\": group_id,\n  1866\t        \"arm_role\": semantics[\"arm_role\"],\n  1867\t        \"arm_role_label_zh\": semantics[\"arm_role_label_zh\"],\n  1868\t        \"arm_detail\": _native_text(\n  1869\t            _source_first(value, source, \"arm_detail\", \"arm_name\", \"group_name\", default=\"\")\n  1870\t        ),\n  1871\t        \"cohort\": cohort,\n  1872\t    