   return (\n  2856\t            _text(row.get(\"product_id\")),\n  2857\t            _text(row.get(\"trial_id\")),\n  2858\t            arm_priority,\n  2859\t            arm_role,\n  2860\t            _text(row.get(\"group_id\")),\n  2861\t            _text(row.get(\"time_window_band\"), _text(row.get(\"time\"))),\n  2862\t            _text(row.get(\"actual_timepoint\")),\n  2863\t            _text(row.get(\"row_id\")),\n  2864\t        )\n  2865\t\n  2866\t    return tuple(sorted(bucket, key=key))\n  2867\t\n  2868\t\n  2869\tdef _cross_trial_groups(\n  2870\t    records: Sequence[tuple[dict[str, Any], Any]],\n  2871\t    *,\n  2872\t    page_id: str,\n  2873\t    domain: str,\n  2874\t    include_time: bool,\n  2875\t    chart_type: str | None = None,\n  2876\t    semantic_proposals: Sequence[SemanticGroupingProposal] = (),\n  2877\t    science_partition: bool = False,\n  2878\t    semantic_adjudications: Sequence[ApprovedSemanticMerge] = (),\n  2879\t) -> tuple[dict[str, Any], ...]:\n  2880\t    buckets: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n  2881\t    if science_partition:\n  2882\t        # 跨试验可比性的初始裁决来自科学层（版本化终点/时间窗政策）；\n  2883\t        # 未命中政策的观察走下方描述性文本键，不丢弃、不伪装可比。\n  2884\t        partition = efficacy_science_partition(records)\n  2885\t        for key, bucket in zip(partition.bucket_keys, partition.buckets, strict=True):\n  2886\t            buckets[(\"__science__\", *key)] = list(bucket)\n  2887\t        records = partition.unmatched\n  2888\t    for item in records:\n  2889\t        row = item[0]\n  2890\t        key = _semantic_group_key(row, include_time=include_time)\n  2891\t        if any(semantic_value_is_unknown(value) for value in key):\n  2892\t            # Retain source observations, but unknown axes cannot license cross-trial comparison.\n  2893\t            # Without a trial identity even a within-trial descriptive grouping is unproven.\n  2894\t            key += (\n  2895\t                \"source-specific\",\n  2896\t                _text(row.get(\"product_id\")),\n  2897\t                _text(row.get(\"trial_id\"), _text(row.get(\"row_id\"))),\n  2898\t            )\n  2899\t        buckets[key].append(item)\n  2900\t    merged = proposed_semantic_buckets(\n  2901\t        tuple(buckets.values()), semantic_proposals,\n  2902\t        approved_merges=semantic_adjudications,\n  2903\t    )\n  2904\t    buckets = {\n  2905\t        (*_semantic_group_key(bucket[0][0], include_time=include_time), str(index)):\n  2906\t        list(bucket)\n  2907\t        for index, bucket in enumerate(merged)\n  2908\t    }\n  2909\t    groups: list[dict[str, Any]] = []\n  2910\t    bucket_keys = sorted(\n  2911\t        buckets,\n  2912\t        key=lambda key: (\n  2913\t            not any(item[0].get(\"renderable\") for item in buckets[key]),\n  2914\t            key,\n  2915\t        ),\n  2916\t    )\n  2917\t    for key in bucket_keys:\n  2918\t        bucket = _sorted_bucket(buckets[key])\n  2919\t        first = bucket[0][0]\n  2920\t        times = {\n  2921\t            _text(row.get(\"time_window_band\"), _text(row.get(\"time\")))\n  2922\t            for row, _source in bucket\n  2923\t            if _text(row.get(\"time_window_band\"), _text(row.get(\"time\")))\n  2924\t        }\n  2925\t        resolved_chart_type = chart_type or (\n  2926\t            \"line\" if page_id == \"longitudinal-results\" and len(times) > 1 else \"bar\"\n  2927\t        )\n  2928\t        title = _group_title(first, domain=domain, include_time=include_time)\n  2929\t        ids = {str(row[\"row_id\"]) for row, _source in bucket}\n  2930\t        if any(set(proposal.row_ids).issubset(ids) for proposal in semantic_proposals):\n  2931\t            actual_times = tuple(dict.fromkeys(\n  2932\t                f'{row.get(\"actual_timepoint\")} '\n  2933\t                + {\"week\": \"周\", \"day\": \"天\", \"month\": \"个月\", \"year\": \"年\"}.get(\n  2934\t                    str(row.get(\"actual_timepoint_unit\")), str(row.get(\"actual_timepoint_unit\")),\n  2935\t                )\n  3080\t            domain=\"safety\",\n  3081\t            include_time=True,\n  3082\t            chart_type=\"heatmap\",\n  3083\t            semantic_proposals=semantic_proposals,\n  3084\t            semantic_adjudications=semantic_adjudications,\n  3085\t        )\n  3086\t    if page_id == \"overview\":\n  3087\t        efficacy = [item for item in records if item[0].get(\"_domain\") == \"efficacy\"]\n  3088\t        safety = [item for item in records if item[0].get(\"_domain\") == \"safety\"]\n  3089\t        matrix = [item for item in records if item[0].get(\"_domain\") == \"matrix\"]\n  3090\t        baseline = [item for item in records if item[0].get(\"_domain\") == \"baseline\"]\n  3091\t        disposition = [item for item in records if item[0].get(\"_domain\") == \"disposition\"]\n  3092\t        overview_groups: list[dict[str, Any]] = []\n  3093\t        if efficacy:\n  3094\t            overview_groups.extend(_groups_for_page(\n  3095\t                \"efficacy\", efficacy, semantic_proposals=semantic_proposals,\n  3096\t                semantic_adjudications=semantic_adjudications,\n  3097\t            ))\n  3098\t        if safety:\n  3099\t            overview_groups.extend(_groups_for_page(\n  3100\t                \"safety\", safety, semantic_proposals=semantic_proposals,\n  3101\t                semantic_adjudications=semantic_adjudications,\n  3102\t            ))\n  3103\t        for related_page_id, related_records in (\n  3104\t            (\"efficacy-safety-matrix\", matrix),\n  3105\t            (\"baseline-overview\", baseline),\n  3106\t            (\"disposition-overview\", disposition),\n  3107\t        ):\n  3108\t            if related_records:\n  3109\t                overview_groups.extend(_groups_for_page(\n  3110\t                    related_page_id, related_records, semantic_proposals=semantic_proposals,\n  3111\t                    semantic_adjudications=semantic_adjudications,\n  3112\t                ))\n  3113\t        return tuple(overview_groups)\n  3114\t    if page_id == \"efficacy-safety-matrix\":\n  3115\t        chart_type = (\n  3116\t            \"bubble\" if any(item[0].get(\"renderable\") for item in records) else \"status_matrix\"\n  3117\t        )\n  3118\t        matrix_groups = []\n  3119\t        for bucket in proposed_semantic_buckets(\n  3120\t            (records,), semantic_proposals, descriptive_only=True,\n  3121\t            approved_merges=semantic_adjudications,\n  3122\t        ):\n  3123\t            group = _group(\"疗效与安全性观察位置\", bucket, chart_type=chart_type)\n  3124\t            group.update(\n  3125\t                x_axis_label_zh=\"试验内疗效差（百分点）\",\n  3126\t                y_axis_label_zh=\"治疗组治疗期间不良事件发生率（%）\",\n  3127\t                size_label_zh=\"气泡大小：治疗组样本量\",\n  3128\t            )\n  3129\t            matrix_groups.append(group)\n  3130\t        return tuple(matrix_groups)\n  3131\t    if page_id in _BASELINE_PAGE_IDS:\n  3132\t        buckets: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n  3133\t        for item in records:\n  3134\t            buckets[\n  3135\t                _semantic_group_key(\n  3136\t                    item[0],\n  3137\t                    include_time=True,\n  3138\t                    include_domain=True,\n  3139\t                    include_population=True,\n  3140\t                    include_statistic=False,\n  3141\t                    include_unit=False,\n  3142\t                )\n  3143\t            ].append(item)\n  3144\t        groups: list[dict[str, Any]] = []\n  3145\t        baseline_buckets = proposed_semantic_buckets(\n  3146\t            tuple(buckets[key] for key in sorted(buckets, key=_baseline_bucket_sort_key)),\n  3147\t            semantic_proposals, descriptive_only=True,\n  3148\t            approved_merges=semantic_adjudications,\n  3149\t        )\n  3150\t        for raw_bucket in baseline_buckets:\n  3151\t            bucket = _sorted_bucket(raw_bucket)\n  3152\t            first = bucket[0][0]\n  3153\t            chart_type = (\n  3154\t                \"bar\" if any(item[0].get(\"renderable\") for item in bucket) else \"status_matrix\"\n  3155\t            )\n  3156\t            statistic_labels = tuple(\n  3157\t                dict.fromkeys(\n  3158\t                    _text(\n  3159\t                        row.get(\"statistical_form_family_label_zh\"),\n  3160\t                        _text(row.get(\"statistic_form\"), \"报告未注明统计口径\"),\n  3161\t                    )\n  3162\t                    for row, _source in bucket\n  3163\t                )\n  3164\t            )\n  3165\t            title = _group_title(\n  3166\t                first,\n  3167\t                domain=\"baseline\",\n  3168\t                include_population=True,\n  3169\t                include_statistic=len(statistic_labels) == 1,\n  3170\t            )\n  3171\t            if len(statistic_labels) > 1:\n  3172\t                title += \" · 统计形式：\" + \"/\".join(statistic_labels)\n  3173\t            unit_labels = tuple(\n  3174\t                dict.fromkeys(_text(row.get(\"unit\"), \"单位未列示\") for row, _source in bucket)\n  3175\t            )\n  3176\t            if len(unit_labels) > 1:\n  3177\t                title += \" · 单位：\" + \"/\".join(unit_labels)\n  3178\t            group = _group(\n  3179\t                title,\n  3180\t                bucket,\n  3181\t                chart_type=chart_type,\n  3182\t                cross_trial=_bucket_spans_trials(bucket),\n  3183\t                x_axis_label_zh=\"产品｜试验\",\n  3184\t            )\n  3185\t            group[\"title_complete\"] = True\n  3186\t            groups.append(group)\n  3187\t        return tuple(groups)\n  3188\t    if page_id in _DISPOSITION_PAGE_IDS:\n  3189\t        disposition_buckets: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(\n  3190\t            list\n  3191\t        )\n  3192\t        for item in records:\n  3193\t            disposition_buckets[\n  3194\t                _semantic_group_key(item[0], include_time=True, include_domain=False)\n  3195\t            ].append(item)\n  3196\t        groups = []\n  3197\t        for raw_bucket in proposed_semantic_buckets(\n  3198\t            tuple(disposition_buckets[key] for key in sorted(disposition_buckets)),\n  3199\t            semantic_proposals, descriptive_only=True,\n  3200\t            approved_merges=semantic_adjudications,\n  3201\t        ):\n  3202\t            bucket = _sorted_bucket(raw_bucket)\n  3203\t            first = bucket[0][0]\n  3204\t            chart_type = (\n  3205\t                \"bar\" if any(item[0].get(\"renderable\") for item in bucket) else \"status_matrix\"\n  3206\t            )\n  3207\t            group = _group(\n  3208\t                _group_title(first, domain=\"disposition\"),\n  3209\t                bucket,\n  3210\t                chart_type=chart_type,\n  3211\t                cross_trial=_bucket_spans_trials(bucket),\n  3212\t                x_axis_label_zh=\"产品｜试验\",\n  3213\t            )\n  3214\t            group[\"title_complete\"] = True\n  3215\t            groups.append(group)\n  3216\t        return tuple(groups)\n  3217\t    if page_id == \"trial-exposure-context\":\n  3218\t        return (_group(\"试验规模与研究角色\", records, chart_type=\"bar\"),)\n  3219\t    if page_id == \"product-trial-profiles\":\n  3220\t        # 页面入口只服务合成/覆盖状态展示；真实域观察的科学分组必须来自\n  3221\t        # _adjudicate_full_pool 的投影，不得用筛选子集重新裁决。\n  3222\t        real_domains = {\n  3223\t            _text(item[0].get(\"_domain\"))\n  3224\t            for item in records\n  3225\t        } - {\"profile\", \"\", \"generic\"}\n  3590\t    data: ReportBPortalData,\n  3591\t) -> dict[str, tuple[tuple[dict[str, Any], Any], ...]]:\n  3592\t    \"\"\"导出发射语义复核工作项所需的 (域, 观察池)。\n  3593\t\n  3594\t    观察池与渲染端全池裁决使用同一构造；初始分桶由\n  3595\t    :func:`semantic_review_buckets_for` 按域给出，保证宿主裁决的\n  3596\t    对选择与渲染端合并语义一致。\n  3597\t    \"\"\"\n  3598\t    names = {product.id: product.name for product in data.products}\n  3599\t    trial_names = {\n  3600\t        trial.id: _display_trial_name(trial, names.get(trial.product_id, \"未列示产品\"))\n  3601\t        for trial in data.trials\n  3602\t    }\n  3603\t    efficacy = _tag_records(\n  3604\t        _efficacy_records(data, names, trial_names), \"efficacy\",\n  3605\t    )\n  3606\t    safety = _tag_records(_safety_records(data, names, trial_names), \"safety\")\n  3607\t    return {\"efficacy\": efficacy, \"safety\": safety}\n  3608\t\n  3609\t\n  3610\tdef semantic_review_buckets_for(\n  3611\t    domain: str,\n  3612\t    records: Sequence[tuple[dict[str, Any], Any]],\n  3613\t) -> tuple[tuple[tuple[dict[str, Any], Any], ...], ...]:\n  3614\t    \"\"\"按域给出与渲染端一致的初始分桶（科学分区/文本键）。\"\"\"\n  3615\t    if domain == \"efficacy\":\n  3616\t        partition = efficacy_science_partition(records)\n  3617\t        buckets = tuple(tuple(bucket) for bucket in partition.buckets)\n  3618\t        buckets += tuple((record,) for record in partition.unmatched)\n  3619\t        return buckets\n  3620\t    grouped: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n  3621\t    for item in records:\n  3622\t        grouped[_semantic_group_key(item[0], include_time=True)].append(item)\n  3623\t    return tuple(tuple(grouped[key]) for key in sorted(grouped))\n  3624\t\n  3625\t\n  3626\tdef _render_page_context(\n  3627\t    data: ReportBPortalData,\n  3628\t    *,\n  3629\t    page: StaticPage,\n  3630\t    catalog: ReportCatalog,\n  3631\t    names: Mapping[str, str],\n  3632\t    trial_names: Mapping[str, str],\n  3633\t    efficacy: Sequence[tuple[dict[str, Any], Any]],\n  3634\t    safety: Sequence[tuple[dict[str, Any], Any]],\n  3635\t    scientific_groups: Sequence[dict[str, Any]] = (),\n  3636\t    longitudinal_groups: Sequence[dict[str, Any]] = (),\n  3637\t    prefix: str = \"\",\n  3638\t    current: str | None = None,\n  3639\t    semantic_adjudications: Sequence[ApprovedSemanticMerge] = (),\n  3640\t    detail_records: Sequence[tuple[dict[str, Any], Any]] | None = None,\n  3641\t    detail_kind: str | None = None,\n  3642\t    detail_id: str | None = None,\n  3643\t    publication_limitation_zh: str | None = None,\n  3644\t) -> dict[str, Any]:\n  3645\t    page_id = current or page.id\n  3646\t    records = (\n  3647\t        tuple(detail_records)\n  3648\t        if detail_records is not None\n  3649\t        else _page_records(\n  3650\t            data,\n     1\t\"\"\"门户疗效行→科学视图层的策略驱动分区适配。\n     2\t\n     3\t渲染器消费本模块的分区作为跨试验可比性的唯一初始裁决来源：\n     4\t命中版本化终点/时间窗政策的观察按 ``build_efficacy_views`` 的科学\n     5\t分组进入兼容桶；缺少必要语义或未命中政策的观察保留给调用方的\n     6\t描述性路径，不丢弃、不伪装可比。本模块不做任何呈现决策。\n     7\t\"\"\"\n     8\tfrom __future__ import annotations\n     9\t\n    10\tfrom collections.abc import Mapping, Sequence\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Any\n    13\t\n    14\tfrom ci_workflow.domain.evidence import EvidenceLocator\n    15\tfrom ci_workflow.reports.b.contracts import (\n    16\t    EndpointCompatibilityResult,\n    17\t    EndpointDirection,\n    18\t    EndpointObservation,\n    19\t    match_endpoint_compatibility,\n    20\t)\n    21\tfrom ci_workflow.reports.b.efficacy import (\n    22\t    EfficacyArmRole,\n    23\t    EfficacyFactRow,\n    24\t    build_efficacy_views,\n    25\t)\n    26\t\n    27\tRecord = tuple[dict[str, Any], Any]\n    28\t\n    29\t\n    30\tdef _text(row: Mapping[str, object], *names: str) -> str:\n    31\t    for name in names:\n    32\t        value = row.get(name)\n    33\t        if isinstance(value, str) and value.strip():\n    34\t            return value.strip()\n    35\t    return \"\"\n    36\t\n    37\t\n    38\t@dataclass(frozen=True)\n    39\tclass SciencePartition:\n    40\t    \"\"\"策略命中的科学分桶与未裁决观察。\"\"\"\n    41\t\n    42\t    buckets: tuple[tuple[Record, ...], ...]\n    43\t    bucket_keys: tuple[tuple[str, ...], ...]\n    44\t    unmatched: tuple[Record, ...]\n    45\t    difference_labels: Mapping[str, tuple[str, ...]]\n    46\t\n    47\t    @property\n    48\t    def matched_row_ids(self) -> frozenset[str]:\n    49\t        return frozenset(\n    50\t            str(row[\"row_id\"]) for bucket in self.buckets for row, _ in bucket\n    51\t        )\n    52\t\n    53\t\n    54\tdef _observation(row: Mapping[str, object]) -> EndpointObservation | None:\n    55\t    direction_text = _text(row, \"semantic_direction\", \"direction\").lower()\n    56\t    try:\n    57\t        direction = EndpointDirection(direction_text)\n    58\t    except ValueError:\n    59\t        return None\n    60\t    endpoint_id = _text(row, \"original_endpoint\", \"endpoint_id\", \"clinical_concept\")\n    61\t    definition = _text(row, \"semantic_definition\", \"original_definition\")\n    62\t    if not endpoint_id or not definition:\n    63\t        return None\n    64\t    timepoint = row.get(\"actual_timepoint\")\n    65\t    time_unit = _text(row, \"actual_timepoint_unit\")\n    66\t    if timepoint is None or isinstance(timepoint, bool) or not time_unit:\n    67\t        return None\n    68\t    return EndpointObservation.model_validate(\n    69\t        {\n    70\t            \"observation_id\": str(row[\"row_id\"]),\n    71\t            \"trial_id\": _text(row, \"trial_id\") or \"trial-unspecified\",\n    72\t            \"endpoint_id\": endpoint_id,\n    73\t            \"endpoint_definition\": definition,\n    74\t            \"endpoint_role\": _text(row, \"endpoint_role\", \"role\") or \"not_classified\",\n    75\t            \"unit\": _text(row, \"unit\") or \"unit-unspecified\",\n    76\t            \"direction\": direction.value,\n    77\t            \"analysis_form\": _text(row, \"analysis_form\", \"statistical_form_family\")\n    78\t            or \"form-unspecified\",\n    79\t            \"timepoint\": timepoint,\n    80\t            \"time_unit\": time_unit,\n    81\t        }\n    82\t    )\n    83\t\n    84\t\n    85\tdef _fact_row(\n    86\t    row: Mapping[str, object],\n    87\t    value: object,\n    88\t    match: EndpointCompatibilityResult,\n    89\t) -> tuple[EfficacyFactRow | None, tuple[str, ...]]:\n    90\t    arm_role_text = _text(row, \"arm_role\").lower()\n    91\t    try:\n    92\t        arm_role = EfficacyArmRole(arm_role_text)\n    93\t    except ValueError:\n    94\t        return None, (\"组别角色不支持疗效比较视图\",)\n    95\t    locator_raw = None\n    96\t    if isinstance(value, Mapping):\n    97\t        locator_raw = value.get(\"source_locator\", value.get(\"locator\"))\n    98\t    if isinstance(locator_raw, EvidenceLocator):\n    99\t        locator = locator_raw\n   100\t    elif isinstance(locator_raw, Mapping):\n   101\t        try:\n   102\t            locator = EvidenceLocator.model_validate(locator_raw)\n   103\t        except (TypeError, ValueError):\n   104\t            locator = EvidenceLocator(document_role=\"registry\", heading=\"登记结果\")\n   105\t    else:\n   106\t        locator = EvidenceLocator(document_role=\"registry\", heading=\"登记结果\")\n   107\t    assert match.compatibility_key is not None\n   108\t    try:\n   109\t        return EfficacyFactRow.model_validate(\n   110\t            {\n   111\t                \"row_id\": str(row[\"row_id\"]),\n   112\t                \"source_row_id\": str(row[\"row_id\"]),\n   113\t                \"observation_id\": str(row[\"row_id\"]),\n   114\t                \"product_id\": _text(row, \"product_id\") or \"product-unspecified\",\n   115\t                \"trial_id\": _text(row, \"trial_id\") or \"trial-unspecified\",\n   116\t                \"endpoint_family_id\": match.endpoint_rule_id,\n   117\t                \"endpoint_family_label_zh\": None,\n   118\t                \"compatibility_key\": match.compatibility_key,\n   119\t                \"original_endpoint\": _text(\n   120\t       