):\n  2993\t        rows = longitudinal_groups[key]\n  2994\t        series: dict[tuple[Any, ...], list[EfficacyFactRow]] = {}\n  2995\t        for row in rows:\n  2996\t            series_key = (\n  2997\t                row.product_id,\n  2998\t                row.trial_id,\n  2999\t                row.comparison_id,\n  3000\t                row.arm_id,\n  3001\t            )\n  3002\t            series.setdefault(series_key, []).append(row)\n  3003\t        eligible_series = {\n  3004\t            series_key\n  3005\t            for series_key, series_rows in series.items()\n  3006\t            if len({row.actual_timepoint for row in series_rows}) >= 2\n  3007\t        }\n  3008\t        eligible = tuple(\n  3009\t            row\n  3010\t            for row in rows\n  3011\t            if (\n  3012\t                row.product_id,\n  3013\t                row.trial_id,\n  3014\t                row.comparison_id,\n  3015\t                row.arm_id,\n  3016\t            )\n  3017\t            in eligible_series\n  3018\t        )\n  3019\t        if (\n  3020\t            len({row.actual_timepoint for row in eligible}) >= 2\n  3021\t            and any(row.value is not None for row in eligible)\n  3022\t        ):\n  3023\t            longitudinal_rows.append(eligible)\n  3024\t    longitudinal_views = tuple(\n  3025\t        _make_longitudinal_view(rows)\n  3026\t        for rows in longitudinal_rows\n  3027\t    )\n  3028\t\n  3029\t    effect_groups: dict[tuple[Any, ...], list[EfficacyFactRow]] = {}\n  3030\t    effect_rows_by_group: dict[tuple[Any, ...], list[EfficacyFactRow]] = {}\n  3031\t    effect_keys_by_pairing: dict[tuple[Any, ...], set[tuple[Any, ...]]] = {}\n  3032\t    for row in selected:\n  3033\t        if row.effect_value is None:\n  3034\t            continue\n  3035\t        context = (\n  3036\t            row.endpoint_family_id,\n  3037\t            row.compatibility_key,\n  3038\t            row.actual_timepoint_unit,\n  3039\t            r