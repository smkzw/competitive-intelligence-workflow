{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ci_workflow/reports/b/semantic_contract.py | sed -n '1,360p'\"","aggregated_output":"     1\t\"\"\"Deterministic clinical-construct compatibility and B bubble presets.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport math\n     6\tfrom collections.abc import Mapping, Sequence\n     7\tfrom enum import StrEnum\n     8\tfrom functools import lru_cache\n     9\tfrom typing import Any, Literal, Self\n    10\t\n    11\tfrom pydantic import AliasChoices, BaseModel, ConfigDict, Field, field_validator, model_validator\n    12\t\n    13\tfrom ci_workflow.reports.b.contracts import (\n    14\t    TimepointCompatibilityPolicy,\n    15\t    TimepointCompatibilityRule,\n    16\t    load_timepoint_compatibility_policy,\n    17\t)\n    18\t\n    19\t\n    20\tclass ClinicalSemanticError(ValueError):\n    21\t    \"\"\"Clinical observations cannot be safely grouped or rendered.\"\"\"\n    22\t\n    23\t\n    24\tclass SemanticDirection(StrEnum):\n    25\t    HIGHER_IS_BETTER = \"higher_is_better\"\n    26\t    LOWER_IS_BETTER = \"lower_is_better\"\n    27\t    NEUTRAL = \"neutral\"\n    28\t    HIGHER_IS_MORE_SEVERE = \"higher_is_more_severe\"\n    29\t    LOWER_IS_MORE_SEVERE = \"lower_is_more_severe\"\n    30\t\n    31\t\n    32\tclass TimeUnit(StrEnum):\n    33\t    DAY = \"day\"\n    34\t    WEEK = \"week\"\n    35\t    MONTH = \"month\"\n    36\t    YEAR = \"year\"\n    37\t\n    38\t\n    39\tclass ClinicalConstructObservation(BaseModel):\n    40\t    \"\"\"All axes required before two B observations may share a frame.\"\"\"\n    41\t\n    42\t    model_config = ConfigDict(extra=\"forbid\", frozen=True, populate_by_name=True)\n    43\t\n    44\t    schema_version: Literal[\"1.3\"] = \"1.3\"\n    45\t    observation_id: str\n    46\t    clinical_construct: str = Field(\n    47\t        validation_alias=AliasChoices(\"clinical_construct\", \"construct_id\")\n    48\t    )\n    49\t    definition: str = Field(\n    50\t        validation_alias=AliasChoices(\"definition\", \"construct_definition\", \"original_definition\")\n    51\t    )\n    52\t    direction: str\n    53\t    unit: str\n    54\t    estimand: str\n    55\t    denominator: str = Field(validation_alias=AliasChoices(\"denominator\", \"denominator_role\"))\n    56\t    analysis_set: str = Field(\n    57\t        validation_alias=AliasChoices(\"analysis_set\", \"analysis_population\", \"population_context\")\n    58\t    )\n    59\t    analysis_form: str = Field(\n    60\t        validation_alias=AliasChoices(\"analysis_form\", \"statistical_form_family\", \"statistic_form\")\n    61\t    )\n    62\t    instrument_or_scale: str = Field(\n    63\t        default=\"not_reported\",\n    64\t        validation_alias=AliasChoices(\n    65\t            \"instrument_or_scale\", \"instrument\", \"scale\", \"scale_version\"\n    66\t        ),\n    67\t    )\n    68\t    actual_timepoint: float\n    69\t    actual_timepoint_unit: TimeUnit = Field(\n    70\t        validation_alias=AliasChoices(\"actual_timepoint_unit\", \"time_unit\")\n    71\t    )\n    72\t\n    73\t    @field_validator(\n    74\t        \"observation_id\",\n    75\t        \"clinical_construct\",\n    76\t        \"definition\",\n    77\t        \"direction\",\n    78\t        \"unit\",\n    79\t        \"estimand\",\n    80\t        \"denominator\",\n    81\t        \"analysis_set\",\n    82\t        \"analysis_form\",\n    83\t        \"instrument_or_scale\",\n    84\t    )\n    85\t    @classmethod\n    86\t    def _text_fields(cls, value: str, info: Any) -> str:\n    87\t        normalized = \" \".join(value.split())\n    88\t        if not normalized:\n    89\t            raise ValueError(f\"{info.field_name}不能为空\")\n    90\t        return normalized\n    91\t\n    92\t    @field_validator(\"actual_timepoint\")\n    93\t    @classmethod\n    94\t    def _timepoint(cls, value: float) -> float:\n    95\t        if isinstance(value, bool) or not math.isfinite(value) or value < 0:\n    96\t            raise ValueError(\"实际时间点必须是非负有限数值\")\n    97\t        return value\n    98\t\n    99\t    @property\n   100\t    def construct_id(self) -> str:\n   101\t        return self.clinical_construct\n   102\t\n   103\t    @property\n   104\t    def timepoint_weeks(self) -> float:\n   105\t        return {\n   106\t            TimeUnit.DAY: self.actual_timepoint / 7.0,\n   107\t            TimeUnit.WEEK: self.actual_timepoint,\n   108\t            TimeUnit.MONTH: self.actual_timepoint * 4.34524,\n   109\t            TimeUnit.YEAR: self.actual_timepoint * 52.1429,\n   110\t        }[self.actual_timepoint_unit]\n   111\t\n   112\t\n   113\tclass SemanticAdjudicationReceipt(BaseModel):\n   114\t    \"\"\"Model-assisted wording decision; deterministic clinical guards still veto.\"\"\"\n   115\t\n   116\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n   117\t\n   118\t    schema_version: Literal[\"1.3\"] = \"1.3\"\n   119\t    adjudication_id: str\n   120\t    observation_ids: tuple[str, str]\n   121\t    decision: Literal[\"compatible\", \"incompatible\"]\n   122\t    model_id: str\n   123\t    independent_review_id: str\n   124\t    independent_context: str\n   125\t    rationale_zh: str\n   126\t\n   127\t    @field_validator(\n   128\t        \"adjudication_id\",\n   129\t        \"model_id\",\n   130\t        \"independent_review_id\",\n   131\t        \"independent_context\",\n   132\t        \"rationale_zh\",\n   133\t    )\n   134\t    @classmethod\n   135\t    def _required_text(cls, value: str, info: Any) -> str:\n   136\t        normalized = \" \".join(value.split())\n   137\t        if not normalized:\n   138\t            raise ValueError(f\"{info.field_name}不能为空\")\n   139\t        return normalized\n   140\t\n   141\t    @field_validator(\"observation_ids\")\n   142\t    @classmethod\n   143\t    def _pair_is_unique(cls, values: tuple[str, str]) -> tuple[str, str]:\n   144\t        normalized = tuple(\" \".join(value.split()) for value in values)\n   145\t        if any(not value for value in normalized) or len(set(normalized)) != 2:\n   146\t            raise ValueError(\"语义裁决必须绑定两个不同观察\")\n   147\t        return normalized  # type: ignore[return-value]\n   148\t\n   149\t    @model_validator(mode=\"after\")\n   150\t    def _review_is_independent(self) -> Self:\n   151\t        if self.model_id == self.independent_review_id:\n   152\t            raise ValueError(\"模型语义裁决与独立复核不得使用同一身份\")\n   153\t        if not any(\"\\u4e00\" <= char <= \"\\u9fff\" for char in self.rationale_zh):\n   154\t            raise ValueError(\"语义裁决理由必须是用户可读中文\")\n   155\t        return self\n   156\t\n   157\t\n   158\tclass SemanticCompatibility(BaseModel):\n   159\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n   160\t\n   161\t    compatible: bool\n   162\t    reasons: tuple[str, ...] = ()\n   163\t    time_window_note_zh: str | None = None\n   164\t\n   165\t    @model_validator(mode=\"after\")\n   166\t    def _result_has_reasons(self) -> Self:\n   167\t        if self.compatible and self.reasons:\n   168\t            raise ValueError(\"兼容观察不能带冲突原因\")\n   169\t        if not self.compatible and not self.reasons:\n   170\t            raise ValueError(\"不兼容观察必须记录冲突原因\")\n   171\t        return self\n   172\t\n   173\t\n   174\tdef _normalized(value: str) -> str:\n   175\t    return \" \".join(value.split()).casefold()\n   176\t\n   177\t\n   178\tdef semantic_value_is_unknown(value: object) -> bool:\n   179\t    \"\"\"Missing markers are absence of knowledge, never an equivalence class.\"\"\"\n   180\t    if not isinstance(value, str) or not value.strip():\n   181\t        return True\n   182\t    normalized = \"-\".join(value.casefold().replace(\"_\", \"-\").split())\n   183\t    return normalized in {\n   184\t        \"unknown\", \"not-reported\", \"not-publicly-disclosed\", \"not-specified\",\n   185\t        \"unspecified\", \"missing\", \"null\", \"none\", \"n/a\", \"na\", \"-\", \"—\",\n   186\t        \"未报告\", \"未披露\", \"未公开\", \"未注明\", \"未提供\", \"未知\", \"不详\",\n   187\t    } or normalized.endswith((\"-not-reported\", \":unknown\"))\n   188\t\n   189\t\n   190\t@lru_cache(maxsize=1)\n   191\tdef _default_timepoint_policy() -> TimepointCompatibilityPolicy:\n   192\t    \"\"\"加载发货默认时间窗政策；运行期不可变，进程内缓存。\"\"\"\n   193\t    return load_timepoint_compatibility_policy()\n   194\t\n   195\t\n   196\tdef _resolve_timepoint_rule(\n   197\t    observation: ClinicalConstructObservation,\n   198\t    policy: TimepointCompatibilityPolicy,\n   199\t) -> TimepointCompatibilityRule | None:\n   200\t    \"\"\"按版本化规则解析观察所属时间窗；同单位、闭区间、命中必须唯一。\"\"\"\n   201\t    # 两模块各自定义 TimeUnit 枚举；按值比较避免跨类身份判断失败。\n   202\t    unit_value = str(observation.actual_timepoint_unit.value)\n   203\t    matches = tuple(\n   204\t        rule\n   205\t        for rule in policy.rules\n   206\t        if str(rule.time_unit.value) == unit_value\n   207\t        and rule.minimum <= observation.actual_timepoint <= rule.maximum\n   208\t    )\n   209\t    if len(matches) > 1:\n   210\t        raise ValueError(\"时间窗兼容规则匹配不唯一，拒绝依赖规则顺序\")\n   211\t    return matches[0] if matches else None\n   212\t\n   213\t\n   214\tdef compare_clinical_constructs(\n   215\t    left: ClinicalConstructObservation | Mapping[str, Any],\n   216\t    right: ClinicalConstructObservation | Mapping[str, Any],\n   217\t    *,\n   218\t    adjudication: SemanticAdjudicationReceipt | Mapping[str, Any] | None = None,\n   219\t    timepoint_policy: TimepointCompatibilityPolicy | None = None,\n   220\t) -> SemanticCompatibility:\n   221\t    \"\"\"Apply model-assisted wording equivalence behind deterministic vetoes.\"\"\"\n   222\t\n   223\t    first = (\n   224\t        left\n   225\t        if isinstance(left, ClinicalConstructObservation)\n   226\t        else ClinicalConstructObservation.model_validate(left)\n   227\t    )\n   228\t    second = (\n   229\t        right\n   230\t        if isinstance(right, ClinicalConstructObservation)\n   231\t        else ClinicalConstructObservation.model_validate(right)\n   232\t    )\n   233\t    receipt = (\n   234\t        None\n   235\t        if adjudication is None\n   236\t        else adjudication\n   237\t        if isinstance(adjudication, SemanticAdjudicationReceipt)\n   238\t        else SemanticAdjudicationReceipt.model_validate(adjudication)\n   239\t    )\n   240\t    if receipt is not None and set(receipt.observation_ids) != {\n   241\t        first.observation_id,\n   242\t        second.observation_id,\n   243\t    }:\n   244\t        raise ClinicalSemanticError(\"模型语义裁决未绑定当前观察对\")\n   245\t    hard_axes = (\n   246\t        (\"方向不一致\", first.direction, second.direction),\n   247\t        (\"单位不一致\", first.unit, second.unit),\n   248\t        (\"估计目标不一致\", first.estimand, second.estimand),\n   249\t        (\"分母口径不一致\", first.denominator, second.denominator),\n   250\t        (\"分析集不一致\", first.analysis_set, second.analysis_set),\n   251\t        (\"分析形式不一致\", first.analysis_form, second.analysis_form),\n   252\t        (\"量表或工具不一致\", first.instrument_or_scale, second.instrument_or_scale),\n   253\t    )\n   254\t    reasons = tuple(\n   255\t        label\n   256\t        for label, left_value, right_value in hard_axes\n   257\t        if _normalized(left_value) != _normalized(right_value)\n   258\t    )\n   259\t    required_axes = (\n   260\t        (\"临床构念\", first.clinical_construct, second.clinical_construct),\n   261\t        (\"临床定义\", first.definition, second.definition),\n   262\t        *((label.removesuffix(\"不一致\"), left_value, right_value)\n   263\t          for label, left_value, right_value in hard_axes),\n   264\t    )\n   265\t    reasons += tuple(\n   266\t        f\"{label}未明确，不能据此认定临床可比\"\n   267\t        for label, left_value, right_value in required_axes\n   268\t        if semantic_value_is_unknown(left_value) or semantic_value_is_unknown(right_value)\n   269\t    )\n   270\t    wording_differs = (\n   271\t        _normalized(first.clinical_construct) != _normalized(second.clinical_construct)\n   272\t        or _normalized(first.definition) != _normalized(second.definition)\n   273\t    )\n   274\t    if wording_differs and receipt is None:\n   275\t        reasons += (\"临床构念或定义不一致且缺少模型语义裁决\",)\n   276\t    elif receipt is not None and receipt.decision == \"incompatible\":\n   277\t        reasons += (\"模型语义裁决为不兼容\",)\n   278\t    note: str | None = None\n   279\t    policy = (\n   280\t        _default_timepoint_policy() if timepoint_policy is None else timepoint_policy\n   281\t    )\n   282\t    left_rule = _resolve_timepoint_rule(first, policy)\n   283\t    right_rule = _resolve_timepoint_rule(second, policy)\n   284\t    if left_rule is None or right_rule is None:\n   285\t        reasons += (\n   286\t            \"实际观察时间未命中版本化时间窗\"\n   287\t            f\"（{policy.policy_id} v{policy.version}）\",\n   288\t        )\n   289\t    elif left_rule.rule_id != right_rule.rule_id:\n   290\t        reasons += (\n   291\t            f\"观察窗分属不同版本化时间窗（{left_rule.rule_id} 与 {right_rule.rule_id}）\",\n   292\t        )\n   293\t    else:\n   294\t        delta = abs(first.timepoint_weeks - second.timepoint_weeks)\n   295\t        tolerance = left_rule.comparison_tolerance_weeks\n   296\t        if delta > tolerance:\n   297\t            reasons += (\n   298\t                f\"观察窗差异超过{left_rule.label_zh}的版本化容差\"\n   299\t                f\"（{delta:g}周 > {tolerance:g}周）\",\n   300\t            )\n   301\t        elif delta > 0:\n   302\t            note = (\n   303\t                f\"实际观察窗为{first.timepoint_weeks:g}周与{second.timepoint_weeks:g}周；\"\n   304\t                \"同框仅表示临床构念兼容，不代表时间点相同\"\n   305\t            )\n   306\t    return SemanticCompatibility(\n   307\t        compatible=not reasons,\n   308\t        reasons=reasons,\n   309\t        time_window_note_zh=note,\n   310\t    )\n   311\t\n   312\t\n   313\tdef assert_clinical_construct_compatible(\n   314\t    observations: Sequence[ClinicalConstructObservation | Mapping[str, Any]],\n   315\t) -> tuple[ClinicalConstructObservation, ...]:\n   316\t    \"\"\"Validate a proposed frame and raise on any incompatible pair.\"\"\"\n   317\t\n   318\t    validated = tuple(\n   319\t        observation\n   320\t        if isinstance(observation, ClinicalConstructObservation)\n   321\t        else ClinicalConstructObservation.model_validate(observation)\n   322\t        for observation in observations\n   323\t    )\n   324\t    for index, first in enumerate(validated):\n   325\t        for second in validated[index + 1 :]:\n   326\t            result = compare_clinical_constructs(first, second)\n   327\t            if not result.compatible:\n   328\t                raise ClinicalSemanticError(\n   329\t                    f\"临床构念不得共框：{first.observation_id}/{second.observation_id}；\"\n   330\t                    + \"、\".join(result.reasons)\n   331\t                )\n   332\t    return validated\n   333\t\n   334\t\n   335\tBubbleMetric = Literal[\n   336\t    \"efficacy_signal\",\n   337\t    \"overall_safety\",\n   338\t    \"serious_risk\",\n   339\t    \"benefit_durability\",\n   340\t    \"discontinuation_risk\",\n   341\t    \"treatment_sample_size\",\n   342\t    \"effective_analysis_set\",\n   343\t    \"long_term_exposure\",\n   344\t]\n   345\t\n   346\t\n   347\tclass BubblePreset(BaseModel):\n   348\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n   349\t\n   350\t    preset_id: Literal[\n   351\t        \"efficacy_overall_safety\",\n   352\t        \"efficacy_serious_risk\",\n   353\t        \"durability_discontinuation_risk\",\n   354\t    ]\n   355\t    label_zh: str\n   356\t    x_metric: BubbleMetric\n   357\t    y_metric: BubbleMetric\n   358\t    size_metric: BubbleMetric\n   359\t    size_semantics_zh: str\n   360\t    neutral: Litera