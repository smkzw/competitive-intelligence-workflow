{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ci_workflow/reports/b/contracts.py | sed -n '1,240p'\"","aggregated_output":"     1\t\"\"\"B 类试验角色输出合同。\n     2\t\n     3\t研究角色和论文角色来自两条独立的确定性链路：前者由共用研究事实与\n     4\t版本化策略重新计算，后者只接受 PubMed 连接器已经完成的论文分类。B\n     5\t输出保留两列，论文类型的变化不能覆盖母试验的研究角色。\n     6\t\"\"\"\n     7\t\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport json\n    11\timport math\n    12\timport re\n    13\tfrom collections.abc import Mapping\n    14\tfrom enum import StrEnum\n    15\tfrom itertools import combinations\n    16\tfrom pathlib import Path\n    17\tfrom typing import Any, Literal, Self, cast\n    18\t\n    19\timport yaml\n    20\tfrom pydantic import (\n    21\t    AliasChoices,\n    22\t    BaseModel,\n    23\t    ConfigDict,\n    24\t    Field,\n    25\t    ValidationError,\n    26\t    field_validator,\n    27\t    model_validator,\n    28\t)\n    29\t\n    30\tfrom ci_workflow.reports.a.analysis import EndpointDirection\n    31\tfrom ci_workflow.reports.common.study_roles import (\n    32\t    StudyCandidate,\n    33\t    StudyRole,\n    34\t    StudyRolePolicy,\n    35\t    evaluate_study_role,\n    36\t)\n    37\tfrom ci_workflow.sources.connectors.pubmed import (\n    38\t    ClassifiedPublication,\n    39\t    classify_pubmed_records,\n    40\t)\n    41\t\n    42\tPublicationRoleValue = Literal[\n    43\t    \"unclassified\",\n    44\t    \"primary_report\",\n    45\t    \"ad_hoc_analysis\",\n    46\t    \"review\",\n    47\t    \"supporting_publication\",\n    48\t    \"unrelated\",\n    49\t]\n    50\t\n    51\t_NCT_ID = re.compile(r\"NCT[0-9]{8}\", re.IGNORECASE)\n    52\t\n    53\t\n    54\tdef _text(value: str) -> str:\n    55\t    normalized = \" \".join(value.split())\n    56\t    if not normalized:\n    57\t        raise ValueError(\"B 类试验角色合同文本不能为空\")\n    58\t    return normalized\n    59\t\n    60\t\n    61\tclass TrialRoleOutput(BaseModel):\n    62\t    \"\"\"一个 B 类试验的研究角色与独立论文角色输出。\n    63\t\n    64\t    `study_role` 始终描述母试验；`publication_role` 只描述所绑定论文，\n    65\t    没有论文或论文尚未分类时保持 ``unclassified``。\n    66\t    \"\"\"\n    67\t\n    68\t    model_config = ConfigDict(extra=\"forbid\", frozen=True, populate_by_name=True)\n    69\t\n    70\t    study_id: str = Field(validation_alias=AliasChoices(\"study_id\", \"trial_id\"))\n    71\t    study_role: StudyRole\n    72\t    inclusion_rationale_zh: str\n    73\t    matched_rule_ids: tuple[str, ...]\n    74\t    policy_id: str\n    75\t    policy_version: str\n    76\t    evidence_version: str\n    77\t    publication_id: str | None = Field(\n    78\t        default=None,\n    79\t        validation_alias=AliasChoices(\"publication_id\", \"pmid\"),\n    80\t    )\n    81\t    publication_role: PublicationRoleValue = \"unclassified\"\n    82\t    publication_rationale_zh: str | None = None\n    83\t    publication_matched_study_ids: tuple[str, ...] = ()\n    84\t    publication_signals: tuple[str, ...] = ()\n    85\t\n    86\t    @field_validator(\n    87\t        \"study_id\",\n    88\t        \"inclusion_rationale_zh\",\n    89\t        \"policy_id\",\n    90\t        \"policy_version\",\n    91\t        \"evidence_version\",\n    92\t    )\n    93\t    @classmethod\n    94\t    def _required_text(cls, value: str) -> str:\n    95\t        return _text(value)\n    96\t\n    97\t    @field_validator(\"publication_id\", \"publication_rationale_zh\")\n    98\t    @classmethod\n    99\t    def _optional_text(cls, value: str | None) -> str | None:\n   100\t        return None if value is None else _text(value)\n   101\t\n   102\t    @field_validator(\"matched_rule_ids\", \"publication_matched_study_ids\", \"publication_signals\")\n   103\t    @classmethod\n   104\t    def _unique_text_tuple(cls, values: tuple[str, ...]) -> tuple[str, ...]:\n   105\t        normalized = tuple(_text(value) for value in values)\n   106\t        if len(set(normalized)) != len(normalized):\n   107\t            raise ValueError(\"B 类试验角色合同标识不得重复\")\n   108\t        return normalized\n   109\t\n   110\t    @property\n   111\t    def trial_id(self) -> str:\n   112\t        return self.study_id\n   113\t\n   114\t    @property\n   115\t    def role(self) -> StudyRole:\n   116\t        return self.study_role\n   117\t\n   118\t    @property\n   119\t    def study_role_policy_id(self) -> str:\n   120\t        return self.policy_id\n   121\t\n   122\t    @property\n   123\t    def study_role_policy_version(self) -> str:\n   124\t        return self.policy_version\n   125\t\n   126\t    @property\n   127\t    def matched_study_rule_ids(self) -> tuple[str, ...]:\n   128\t        return self.matched_rule_ids\n   129\t\n   130\t    @property\n   131\t    def publication_pmid(self) -> str | None:\n   132\t        return self.publication_id\n   133\t\n   134\t\n   135\tBTrialRoleOutput = TrialRoleOutput\n   136\tTrialRoleRecord = TrialRoleOutput\n   137\t\n   138\t\n   139\tdef _validated_candidate(candidate: StudyCandidate | Mapping[str, Any]) -> StudyCandidate:\n   140\t    try:\n   141\t        raw = (\n   142\t            candidate.model_dump(mode=\"python\", warnings=False)\n   143\t            if isinstance(candidate, StudyCandidate)\n   144\t            else dict(candidate)\n   145\t        )\n   146\t        return StudyCandidate.model_validate(raw)\n   147\t    except ValidationError as error:\n   148\t        raise ValueError(f\"B 类研究事实重新校验失败：{error}\") from error\n   149\t\n   150\t\n   151\tdef _validated_publication(\n   152\t    publication: ClassifiedPublication | Mapping[str, Any],\n   153\t    *,\n   154\t    study_id: str,\n   155\t) -> ClassifiedPublication:\n   156\t    try:\n   157\t        if isinstance(publication, ClassifiedPublication):\n   158\t            raw = dict(vars(publication))\n   159\t            raw[\"record\"] = dict(vars(publication.record))\n   160\t        else:\n   161\t            raw = dict(publication)\n   162\t        validated = ClassifiedPublication.model_validate(raw)\n   163\t    except ValidationError as error:\n   164\t        raise ValueError(f\"论文角色分类结果重新校验失败：{error}\") from error\n   165\t\n   166\t    normalized_study_id = study_id.strip().upper()\n   167\t    if _NCT_ID.fullmatch(normalized_study_id) is None:\n   168\t        raise ValueError(\"非 NCT 试验的论文关联尚不能从当前记录重新计算\")\n   169\t    expected = classify_pubmed_records((validated.record,), target_nct_ids=(normalized_study_id,))[\n   170\t        0\n   171\t    ]\n   172\t    if validated != expected:\n   173\t        raise ValueError(\"论文角色必须由当前论文记录和目标试验重新分类\")\n   174\t    return validated\n   175\t\n   176\t\n   177\tdef build_trial_role_output(\n   178\t    candidate: StudyCandidate | Mapping[str, Any],\n   179\t    *,\n   180\t    publication: ClassifiedPublication | Mapping[str, Any] | None = None,\n   181\t    policy: StudyRolePolicy | None = None,\n   182\t) -> TrialRoleOutput:\n   183\t    \"\"\"从当前研究事实和论文分类构建 B 角色输出。\n   184\t\n   185\t    不接受调用方注入 ``study_role`` 或裸 ``publication_role``；研究角色由\n   186\t    共用策略重新判定，论文角色只能来自 ``ClassifiedPublication``。\n   187\t    \"\"\"\n   188\t\n   189\t    current_candidate = _validated_candidate(candidate)\n   190\t    decision = evaluate_study_role(current_candidate, policy=policy)\n   191\t    publication_record = (\n   192\t        None\n   193\t        if publication is None\n   194\t        else _validated_publication(publication, study_id=current_candidate.study_id)\n   195\t    )\n   196\t    return TrialRoleOutput(\n   197\t        study_id=decision.study_id,\n   198\t        study_role=decision.study_role,\n   199\t        inclusion_rationale_zh=decision.inclusion_rationale_zh,\n   200\t        matched_rule_ids=decision.matched_rule_ids,\n   201\t        policy_id=decision.policy_id,\n   202\t        policy_version=decision.policy_version,\n   203\t        evidence_version=decision.evidence_version,\n   204\t        publication_id=None if publication_record is None else publication_record.record.pmid,\n   205\t        publication_role=(\n   206\t            \"unclassified\" if publication_record is None else publication_record.role\n   207\t        ),\n   208\t        publication_rationale_zh=(\n   209\t            None if publication_record is None else publication_record.rationale_zh\n   210\t        ),\n   211\t        publication_matched_study_ids=(\n   212\t            () if publication_record is None else publication_record.matched_nct_ids\n   213\t        ),\n   214\t        publication_signals=(\n   215\t            () if publication_record is None else publication_record.classification_signals\n   216\t        ),\n   217\t    )\n   218\t\n   219\t\n   220\tdef build_b_trial_role(\n   221\t    candidate: StudyCandidate | Mapping[str, Any],\n   222\t    *,\n   223\t    publication: ClassifiedPublication | Mapping[str, Any] | None = None,\n   224\t    policy: StudyRolePolicy | None = None,\n   225\t) -> TrialRoleOutput:\n   226\t    \"\"\"``build_trial_role_output`` 的 B 类语义别名。\"\"\"\n   227\t\n   228\t    return build_trial_role_output(candidate, publication=publication, policy=policy)\n   229\t\n   230\t\n   231\t# ── Task 6.1：B 类终点—时间窗兼容合同 ──────────────────────────────────────\n   232\t\n   233\t\n   234\tclass EndpointCompatibilityError(ValueError):\n   235\t    \"\"\"终点或时间窗规则/观察不满足失败关闭合同。\"\"\"\n   236\t\n   237\t\n   238\tclass EndpointAnalysisForm(StrEnum):\n   239\t    \"\"\"可进入版本化兼容规则的分析形式。\"\"\"\n   240\t\n","exit_code":0,"status":"completed"}}
