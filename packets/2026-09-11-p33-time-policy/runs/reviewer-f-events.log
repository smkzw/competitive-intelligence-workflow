{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ci_workflow/reports/b/contracts.py | sed -n '231,520p'\"","aggregated_output":"   231\t# ── Task 6.1：B 类终点—时间窗兼容合同 ──────────────────────────────────────\n   232\t\n   233\t\n   234\tclass EndpointCompatibilityError(ValueError):\n   235\t    \"\"\"终点或时间窗规则/观察不满足失败关闭合同。\"\"\"\n   236\t\n   237\t\n   238\tclass EndpointAnalysisForm(StrEnum):\n   239\t    \"\"\"可进入版本化兼容规则的分析形式。\"\"\"\n   240\t\n   241\t    RESPONSE_RATE = \"response_rate\"\n   242\t    CHANGE_FROM_BASELINE = \"change_from_baseline\"\n   243\t    ABSOLUTE_VALUE = \"absolute_value\"\n   244\t    EVENT_RATE = \"event_rate\"\n   245\t    TIME_TO_EVENT = \"time_to_event\"\n   246\t    HAZARD_RATIO = \"hazard_ratio\"\n   247\t    MEAN_DIFFERENCE = \"mean_difference\"\n   248\t    MEDIAN_DIFFERENCE = \"median_difference\"\n   249\t\n   250\t\n   251\tclass TimeUnit(StrEnum):\n   252\t    \"\"\"时间窗规则的封闭单位集合；初版不做单位换算。\"\"\"\n   253\t\n   254\t    DAY = \"day\"\n   255\t    WEEK = \"week\"\n   256\t    MONTH = \"month\"\n   257\t    YEAR = \"year\"\n   258\t\n   259\t\n   260\t_CJK = re.compile(r\"[\\u3400-\\u9fff]\")\n   261\t_TIMEPOINT_TEXT = re.compile(\n   262\t    r\"^第?\\s*([0-9]+(?:\\.[0-9]+)?)\\s*(日|天|d|day|days|周|w|wk|week|weeks|月|mo|month|months|年|y|yr|year|years)?$\",\n   263\t    re.IGNORECASE,\n   264\t)\n   265\t_TIME_UNIT_ALIASES = {\n   266\t    \"d\": \"day\",\n   267\t    \"day\": \"day\",\n   268\t    \"days\": \"day\",\n   269\t    \"日\": \"day\",\n   270\t    \"天\": \"day\",\n   271\t    \"w\": \"week\",\n   272\t    \"wk\": \"week\",\n   273\t    \"week\": \"week\",\n   274\t    \"weeks\": \"week\",\n   275\t    \"周\": \"week\",\n   276\t    \"mo\": \"month\",\n   277\t    \"month\": \"month\",\n   278\t    \"months\": \"month\",\n   279\t    \"月\": \"month\",\n   280\t    \"y\": \"year\",\n   281\t    \"yr\": \"year\",\n   282\t    \"year\": \"year\",\n   283\t    \"years\": \"year\",\n   284\t    \"年\": \"year\",\n   285\t}\n   286\t_ANALYSIS_FORM_ALIASES = {\n   287\t    \"response\": \"response_rate\",\n   288\t    \"response_rate\": \"response_rate\",\n   289\t    \"responder_rate\": \"response_rate\",\n   290\t    \"change\": \"change_from_baseline\",\n   291\t    \"change_from_baseline\": \"change_from_baseline\",\n   292\t    \"absolute\": \"absolute_value\",\n   293\t    \"absolute_value\": \"absolute_value\",\n   294\t    \"event_rate\": \"event_rate\",\n   295\t    \"time_to_event\": \"time_to_event\",\n   296\t    \"hazard_ratio\": \"hazard_ratio\",\n   297\t    \"mean_difference\": \"mean_difference\",\n   298\t    \"median_difference\": \"median_difference\",\n   299\t}\n   300\t\n   301\t\n   302\tdef _compat_text(value: str, *, field_name: str = \"兼容合同字段\") -> str:\n   303\t    normalized = \" \".join(value.split())\n   304\t    if not normalized:\n   305\t        raise ValueError(f\"{field_name}不能为空\")\n   306\t    return normalized\n   307\t\n   308\t\n   309\tdef _raw_compat_text(value: str, *, field_name: str = \"兼容合同字段\") -> str:\n   310\t    if not value.strip():\n   311\t        raise ValueError(f\"{field_name}不能为空\")\n   312\t    return value\n   313\t\n   314\t\n   315\tdef _normalize_time_unit(value: Any) -> Any:\n   316\t    if not isinstance(value, str):\n   317\t        return value\n   318\t    token = value.strip().casefold()\n   319\t    return _TIME_UNIT_ALIASES.get(token, value)\n   320\t\n   321\t\n   322\tdef _normalize_analysis_form(value: Any) -> Any:\n   323\t    if not isinstance(value, str):\n   324\t        return value\n   325\t    token = value.strip().casefold().replace(\"-\", \"_\").replace(\" \", \"_\")\n   326\t    return _ANALYSIS_FORM_ALIASES.get(token, value)\n   327\t\n   328\t\n   329\tdef _as_tuple(value: Any) -> tuple[Any, ...]:\n   330\t    if value is None:\n   331\t        return ()\n   332\t    return (value,) if isinstance(value, str) else tuple(value)\n   333\t\n   334\t\n   335\tclass EndpointObservation(BaseModel):\n   336\t    \"\"\"B 类疗效观察；原始终点、定义、单位、时间点和角色不被规范化覆盖。\"\"\"\n   337\t\n   338\t    model_config = ConfigDict(extra=\"forbid\", frozen=True, populate_by_name=True)\n   339\t\n   340\t    observation_id: str = Field(validation_alias=AliasChoices(\"observation_id\", \"id\"))\n   341\t    trial_id: str = Field(validation_alias=AliasChoices(\"trial_id\", \"study_id\"))\n   342\t    endpoint_id: str = Field(\n   343\t        validation_alias=AliasChoices(\n   344\t            \"endpoint_id\", \"original_endpoint\", \"raw_endpoint\", \"endpoint\"\n   345\t        )\n   346\t    )\n   347\t    endpoint_definition: str = Field(\n   348\t        validation_alias=AliasChoices(\n   349\t            \"endpoint_definition\", \"original_definition\", \"raw_definition\", \"definition\"\n   350\t        )\n   351\t    )\n   352\t    endpoint_role: str = Field(\n   353\t        validation_alias=AliasChoices(\"endpoint_role\", \"original_endpoint_role\", \"role\")\n   354\t    )\n   355\t    unit: str = Field(validation_alias=AliasChoices(\"unit\", \"original_unit\", \"raw_unit\"))\n   356\t    direction: EndpointDirection\n   357\t    analysis_form: str\n   358\t    timepoint: int | float | str = Field(\n   359\t        validation_alias=AliasChoices(\n   360\t            \"timepoint\", \"actual_timepoint\", \"observed_timepoint\", \"timepoint_value\"\n   361\t        )\n   362\t    )\n   363\t    time_unit: str = Field(\n   364\t        validation_alias=AliasChoices(\n   365\t            \"time_unit\", \"actual_timepoint_unit\", \"observed_time_unit\", \"timepoint_unit\"\n   366\t        )\n   367\t    )\n   368\t    clinical_construct: str | None = Field(\n   369\t        default=None,\n   370\t        validation_alias=AliasChoices(\"clinical_construct\", \"construct_id\", \"endpoint_construct\"),\n   371\t    )\n   372\t\n   373\t    @field_validator(\n   374\t        \"observation_id\",\n   375\t        \"trial_id\",\n   376\t        \"endpoint_