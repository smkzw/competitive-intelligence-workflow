29\t    )\n  2130\t    records = [\n  2131\t        (\n  2132\t            _project_record(\n  2133\t                value,\n  2134\t                domain=\"safety\",\n  2135\t                names=names,\n  2136\t                trial_names=trial_names,\n  2137\t                fallback=f\"safety-{index + 1}\",\n  2138\t            ),\n  2139\t            value,\n  2140\t        )\n  2141\t        for index, value in enumerate(values)\n  2142\t    ]\n  2143\t    row_ids = {row[\"row_id\"] for row, _source in records}\n  2144\t    for legacy in data.safety:\n  2145\t        if legacy.row_id in row_ids or legacy.disclosure_state == \"已公开\":\n  2146\t            continue\n  2147\t        records.append(\n  2148\t            (\n  2149\t                _project_record(\n  2150\t                    legacy,\n  2151\t                    domain=\"safety\",\n  2152\t                    names=names,\n  2153\t                    trial_names=trial_names,\n  2154\t                    fallback=legacy.row_id,\n  2155\t                ),\n  2156\t                legacy,\n  2157\t            )\n  2158\t        )\n  2159\t    return _dedupe_records(records)\n  2160\t\n  2960\t        groups.append(group)\n  2961\t    return tuple(groups)\n  2962\t\n  2963\t\n  2964\tdef _baseline_bucket_sort_key(key: tuple[str, ...]) -> tuple[int, tuple[str, ...]]:\n  2965\t    concept = key[0] if key else \"\"\n  2966\t    for rank, family in enumerate(_BASELINE_CONCEPT_FAMILY_ORDER):\n  2967\t        if _semantic_token(concept) in family:\n  2968\t            return (rank, key)\n  2969\t    return (len(_BASELINE_CONCEPT_FAMILY_ORDER), key)\n  2970\t\n  2971\t\n  2972\tdef _bucket_spans_trials(bucket: Sequence[tuple[dict[str, Any], Any]]) -> bool:\n  2973\t    trial_ids = {\n  2974\t        _text(row.get(\"trial_id\"))\n  2975\t        for row, _source in bucket\n  2976\t        if _text(row.get(\"trial_id\"))\n  2977\t    }\n  2978\t    return len(trial_ids) > 1\n  2979\t\n  2980\t\n  2981\t_POOL_ADJUDICATION_DOMAINS: dict[str, str] = {\n  2982\t    \"efficacy\": \"efficacy\",\n  2983\t    \"safety\": \"safety\",\n  2984\t    \"baseline\": \"baseline-overview\",\n  2985\t    \"disposition\": \"disposition-overview\",\n  2986\t    \"matrix\": \"efficacy-safety-matrix\",\n  2987\t    \"supporting\": \"subgroups-supporting-evidence\",\n  2988\t}\n  2989\t\n  2990\t\n  2991\tdef _adjudicate_full_pool(\n  2992\t    records: Sequence[tuple[dict[str, Any], Any]],\n  2993\t    *,\n  2994\t    semantic_proposals: Sequence[SemanticGroupingProposal],\n  2995\t    semantic_adjudications: Sequence[ApprovedSemanticMerge] = (),\n  2996\t) -> tuple[dict[str, Any], ...]:\n  2997\t    \"\"\"完整观察池一次裁决的唯一入口；详情子集不得进入。\n  2998\t\n  2999\t    全池语境下，引用不存在观察的提案是陈旧或错误输入，必须拒绝；\n  3000\t    跨域提案在分域前拒绝；未知域记录失败关闭。\n  3001\t    \"\"\"\n  3002\t    pool = _dedupe_records(records)\n  3003\t    by_id = {str(row[\"row_id\"]): row for row, _source in pool}\n  3004\t    for row, _source in pool:\n  3005\t        domain = _text(row.get(\"_domain\"))\n  3006\t        if domain not in _POOL_ADJUDICATION_DOMAINS:\n  3007\t            raise ValueError(f\"完整观察池包含未支持域：{domain or '未标注'}\")\n  3008\t    for proposal in semantic_proposals:\n  3009\t        missing = [row_id for row_id in proposal.row_ids if row_id not in by_id]\n  3010\t        if missing:\n  3011\t            raise ValueError(f\"语义提案引用完整观察池之外的观察：{missing}\")\n  3012\t        left, right = (by_id[row_id] for row_id in proposal.row_ids)\n  3013\t        if left.get(\"_domain\") != right.get(\"_domain\"):\n  3014\t            raise ValueError(\"跨域语义提案不受支持，必须拆分研究问题\")\n  3015\t    for merge in semantic_adjudications:\n  3016\t        # 池级边界先整体重验，阻止 model_copy(update=...) 伪造的外层绑定。\n  3017\t        merge = ApprovedSemanticMerge.model_validate(merge.model_dump(mode=\"json\"))\n  3018\t        missing = [row_id for row_id in merge.proposal.row_ids if row_id not in by_id]\n  3019\t        if missing:\n  3020\t            raise ValueError(f\"已批准归并引用完整观察池之外的观察：{missing}\")\n  3021\t        left, right = (by_id[row_id] for row_id in merge.proposal.row_ids)\n  3022\t        if left.get(\"_domain\") != right.get(\"_domain\"):\n  3023\t            raise ValueError(\"跨域语义归并不受支持，必须拆分研究问题\")\n  3024\t        if (semantic_row_digest(left) != merge.proposal.row_digests[0]\n  3025\t                or semantic_row_digest(right) != merge.proposal.row_digests[1]):\n  3026\t            raise ValueError(\"已批准归并的观察摘要与完整观察池不一致\")\n  3027\t    groups: list[dict[str, Any]] = []\n  3028\t    for domain, domain_page in _POOL_ADJUDICATION_DOMAINS.items():\n  3029\t        selected = [item for item in pool if item[0].get(\"_domain\") == domain]\n  3030\t        if selected:\n  3031\t            groups.extend(_groups_for_page(\n  3032\t                domain_page, selected, semantic_proposals=semantic_proposals,\n  3033\t                semantic_adjudications=semantic_adjudications,\n  3034\t            ))\n  3035\t    return tuple(groups)\n  3036\t\n  3037\t\n  3038\tdef _assert_page_fallback_only_uncovered(\n  3039\t    uncovered: Sequence[tuple[dict[str, Any], Any]],\n  3040\t) -> None:\n  3800\tdef _reset_site_root(site_root: Path) -> None:\n  3801\t    if site_root.exists() and not site_root.is_dir():\n  3802\t        raise ReportBPortalError(f\"站点目标不是目录：{site_root}\")\n  3803\t    if site_root.exists():\n  3804\t        for child in site_root.iterdir():\n  3805\t            if child.is_dir():\n  3806\t                shutil.rmtree(child)\n  3807\t            else:\n  3808\t                child.unlink()\n  3809\t    site_root.mkdir(parents=True, exist_ok=True)\n  3810\t\n  3811\t\n  3812\tdef render_report_b_site(\n  3813\t    data: ReportBPortalData,\n  3814\t    site_root: Path,\n  3815\t    *,\n  3816\t    publication_limitation_zh: str | None = None,\n  3817\t) -> tuple[Path, ...]:\n  3818\t    \"\"\"Render all B catalog pages plus every product and trial dossier.\"\"\"\n  3819\t    site_root = Path(site_root)\n  3820\t\n  3821\t    registry = PageRegistry.load()\n  3822\t    catalog = registry.catalog(ReportKind.B)\n  3823\t    names = {product.id: product.name for product in data.products}\n  3824\t    trial_names = {\n  3825\t        trial.id: _display_trial_name(trial, names.get(trial.product_id, \"未列示产品\"))\n  3826\t        for trial in data.trials\n  3827\t    }\n  3828\t    efficacy = _efficacy_records(data, names, trial_names)\n  3829\t    safety = _safety_records(data, names, trial_names)\n  3830\t    baseline = _page_records(\n  3831\t        data,\n  3832\t        page_id=\"baseline-overview\",\n  3833\t        names=names,\n  3834\t        trial_names=trial_names,\n  3835\t        efficacy=efficacy,\n  3836\t        safety=safety,\n  3837\t    )\n  3838\t    disposition = _disposition_pool_records(data, names=names, trial_names=trial_names)\n  3839\t    supporting = _page_records(\n  3840\t        data,\n  3841\t        page_id=\"subgroups-supporting-evidence\",\n  3842\t        names=names,\n  3843\t        trial_names=trial_names,\n  3844\t        efficacy=efficacy,\n  3845\t        safety=safety,\n  3846\t    )\n  3847\t    matrix = _matrix_records(data, names, trial_names)\n  3848\t    detail_pool = _dedupe_records(\n  3849\t        (\n  3850\t            *_tag_records(efficacy, \"efficacy\"),\n  3851\t            *_tag_records(safety, \"safety\"),\n  3852\t            *_tag_records(baseline, \"baseline\"),\n  3853\t            *_tag_records(matrix, \"matrix\"),\n  3854\t            *_tag_records(disposition, \"disposition\"),\n  3855\t            *_tag_records(supporting, \"supporting\"),\n  3856\t        )\n  3857\t    )\n  3858\t    # Adjudicate against the full observation universe once. Every physical page\n  3859\t    # (including dossiers) consumes a projection of these same group identities.\n  3860\t    scientific_groups = _adjudicate_full_pool(\n  3861\t        detail_pool, semantic_proposals=data.semantic_proposals,\n  3862\t        semantic_adjudications=data.semantic_adjudications,\n  3863\t    )\n  3864\t    # Longitudinal description is a separate full-view projection purpose, not a\n  3865\t    # fresh cross-trial comparability decision made from a filtered page.\n  3866\t    trial_series: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n  3867\t    for row, source in efficacy:\n  3868\t        trial_series[(_text(row.get(\"product_id\")), _text(row.get(\"trial_id\")),\n  3869\t                      _text(row.get(\"group_id\")), _text(row.get(\"arm_role\")))].append((row, source))\n  3870\t    longitudinal_groups = tuple(\n  3871\t        {**group, \"scientific_group_kind\": \"within_trial_longitudinal\"}\n  3872\t        for key in sorted(trial_series)\n  3873\t        for group in _groups_for_page(\"longitudinal-results\", trial_series[key],\n  3874\t                                       semantic_proposals=data.semantic_proposals)\n  3875\t    )\n  3876\t    _reset_site_root(site_root)\n  3877\t    _copy_assets(site_root)\n  3878\t    (site_root / \"data\").mkdir(parents=True, exist_ok=True)\n  3879\t\n  3880\t    # The standalone report literal intentionally contains only source rows and\n  3881\t    # metadata.  The optional B view objects are implementation inputs, not a\n  3882\t    # second mutable browser data store.\n  3883\t    report_payload = data.model_dump(\n  3884\t        mode=\"json\",\n  3885\t        exclude={\n  3886\t            \"report_snapshot_id\",\n  3887\t            \"efficacy_views\",\n  3888\t            \"safety_views\",\n  3889\t            \"baseline_views\",\n  3890\t            \"disposition_views\",\n  3891\t            \"supporting_evidence_views\",\n  3892\t            \"supporting_views\",\n  3893\t            \"subgroup_views\",\n  3894\t            \"subgroups_views\",\n  3895\t            \"matrix_view\",\n  4160\t    row_ids = [row.row_id for row in result_rows]\n  4161\t    for view_name in (\n  4162\t        \"efficacy_views\",\n  4163\t        \"safety_views\",\n  4164\t        \"baseline_views\",\n  4165\t        \"disposition_views\",\n  4166\t        \"supporting_evidence_views\",\n  4167\t    ):\n  4168\t        source = _view_source(data, view_name)\n  4169\t        for index, row in enumerate(_collection(source, \"facts\", \"rows\")):\n  4170\t            row_ids.append(_stable_row_id(row, f\"{view_name}-{index + 1}\"))\n  4171\t    return tuple(dict.fromkeys(stable_id(\"claim\", row_id) for row_id in row_ids))\n  4172\t\n  4173\t\n  4174\tdef build_report_b_artifact(\n  4175\t    *,\n  4176\t    project_root: Path,\n  4177\t    data_path: Path,\n  4178\t    project_id: str,\n  4179\t    contract_version: int,\n  4180\t    run_id: str,\n  4181\t    publication_limitation_zh: str | None = None,\n  4182\t    extra_adjudications: Sequence[ApprovedSemanticMerge] = (),\n  4183\t) -> tuple[Path, Path, str]:\n  4184\t    \"\"\"生成 B 类站点、锁定报告快照并写入当前运行产物清单。\n  4185\t\n  4186\t    站点先写入未发布事务的 staging 目录；只有清单原子写入成功后，最终\n  4187\t    ``html/`` 目录才出现。中断只留下可证明未发布的残留，重跑自动恢复；\n  4188\t    任何已有清单或完成绑定一律拒绝覆盖。\n  4189\t    \"\"\"\n  4190\t    data = load_report_b_data(data_path)\n  4191\t    if extra_adjudications:\n  4192\t        if data.semantic_adjudications:\n  4193\t            raise ReportBPortalError(\n  4194\t                \"载荷已自带语义裁决，拒绝再注入项目级裁决（双来源）\"\n  4195\t            )\n  4196\t        payload = data.model_dump(mode=\"json\")\n  4197\t        payload[\"semantic_adjudications\"] = [\n  4198\t            merge.model_dump(mode=\"json\") for merge in extra_adjudications\n  4199\t        ]\n  4200\t        data = ReportBPortalData.model_validate(payload)\n  4201\t    started_at = datetime.now(UTC)\n  4202\t    transaction = UnpublishedRenderTransaction(\n  4203\t        project_root,\n  4204\t        report=\"B\",\n  4205\t        report_version=data.report_version,\n  4206\t        run_id=run_id,\n  4207\t    )\n  4208\t    try:\n  4209\t        staging_root = transaction.begin()\n  4210\t    except RenderTransactionError as error:\n  4211\t        raise ReportBPortalError(str(error)) from error\n  4212\t    render_report_b_site(\n  4213\t        data,\n  4214\t        staging_root,\n  4215\t        publication_limitation_zh=publication_limitation_zh,\n  4216\t    )\n  4217\t\n  4218\t    data_digest = hashlib.sha256(_canonical_json(data.model_dump(mode=\"json\"))).hexdigest()\n  4219\t    coverage_projection_id = stable_id(\"coverage-projection\", project_id, \"B\", data.report_version)\n  4220\t    declared_snapshot: ReportSnapshotManifest | None = None\n  4221\t    locked: LockedSnapshot | None = None\n  4222\t    if data.report_snapshot_id is not None:\n  4223\t        snapshot_path = (\n  4224\t            project_root\n  4225\t            / \"snapshots\"\n  4226\t            / \"reports\"\n  4227\t            / \"B\"\n  4228\t            / f\"{data.report_snapshot_id}.json\"\n  4229\t        )\n  4230\t        if snapshot_path.is_file():\n  4231\t            try:\n  4232\t                declared_snapshot = ReportSnapshotManifest.model_validate_json(\n  4233\t                    snapshot_path.read_bytes()\n  4234\t                )\n  4235\t                locked = compute_locked_snapshot(\n  4236\t                    kind=\"report\",\n  4237\t                    report=\"B\",\n  4238\t                    manifest=declared_snapshot.model_dump(mode=\"json\"),\n  4239\t                )\n  4240\t            except (OSError, ValueError, SnapshotIntegrityError) as error:\n  4241\t                raise ReportBPortalError(\n  4242\t                    \"B 类门户引用的报告快照存在但不可信\"\n  4243\t                ) from error\n  4244\t            if (\n  4245\t                locked.snapshot_id != data.report_snapshot_id\n  4246\t                or declared_snapshot.project_id != project_id\n  4247\t                or declared_snapshot.contract_version != contract_version\n  4248\t                or declared_snapshot.report_version != data.report_version\n  4249\t                or declared_snapshot.data_cutoff != data.data_cutoff\n  4250\t            ):\n  4251\t                raise ReportBPortalError(\"B 类门户与已锁定报告快照身份不一致\")\n  4252\t        # 声明的快照不在项目内：调用方声明不被信任，预览路径按数据字节\n  4253\t        # 确定性自锁定快照，运行保持 rendered_unreviewed，不进入任何接受。\n  4254\t    if declared_snapshot is None or locked is None:\n  4255\t        claim_ids = _report_b_claim_ids(data)\n  4256\t        if not claim_ids:\n  4257\t            raise ReportBPortalError(\"B 类报告没有可锁定的结果或基线事实\")\n  4258\t        evidence_snapshot_id = stable_id(\"evidence-snapshot\", project_id, data_digest)\n  4259\t        claim_snapshot_id = stable_id(\"claim-snapshot\", project_id, data_digest)\n  4260\t        coverage_set_id = stable_id(\"coverage-set\", project_id, \"B\", data_digest)\n  4261\t        declared_snapshot = ReportSnapshotManifest(\n  4262\t            schema_version=\"1.0\",\n  4263\t            project_id=project_id,\n  4264\t            contract_version=contract_version,\n  4265\t            report=\"B\",\n  4266\t            report_version=data.report_version,\n  4267\t            data_cutoff=data.data_cutoff,\n  4268\t            evidence_snapshot_id=evidence_snapshot_id,\n  4269\t            claim_snapshot_id=claim_snapshot_id,\n  4270\t            coverage_set_id=coverage_set_id,\n  4271\t            claim_ids=claim_ids,\n  4272\t            created_at=started_at,\n  4273\t        )\n  4274\t        locked = SnapshotStore(project_root).lock_report_snapshot(\n  4275\t            report=\"B\", manifest=declared_snapshot.model_dump(mode=\"json\")\n  4276\t        )\n  4277\t    snapshot = declared_snapshot\n  4278\t    assert snapshot is not None and locked is not None\n  4279\t    claim_ids = snapshot.claim_ids\n  4280\t    evidence_snapshot_id = snapshot.evidence_snapshot_id\n  4281\t    claim_snapshot_id = snapshot.claim_snapshot_id\n  4282\t    coverage_set_id = snapshot.coverage_set_id\n  4283\t    site_digest, site_bytes = site_directory_digest(staging_root)\n  4284\t    modified_at = datetime.fromtimestamp(\n  4285\t        max(path.stat().st_mtime for path in staging_root.rglob(\"*\") if path.is_file()),\n","exit_code":0,"status":"completed"}}
