{"type":"user","uuid":"01a08f76-966d-747e-842f-aafd58f4c5ad","session_id":"01a08f74-c077-7bd3-8de8-2cfab5bccb52","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_7PSgW0uwYbLzQDWwZYtI6070","content":[{"type":"text","text":"   1→\"\"\"Raw-asset/text derivation storage, independent of PDF report output.\"\"\"\n   2→\n   3→from __future__ import annotations\n   4→\n   5→import hashlib\n   6→import json\n   7→from importlib.metadata import version\n   8→from pathlib import Path\n   9→from typing import Literal, NoReturn\n  10→\n  11→from ci_workflow.domain.evidence import CtgovRecordSelector, SourceTextDerivation\n  12→from ci_workflow.storage.content_store import ContentAddressedStore, ContentIntegrityError\n  13→\n  14→\n  15→class SourceDerivationError(ValueError):\n  16→    \"\"\"Raw asset or extraction cannot substantiate the submitted source text.\"\"\"\n  17→\n  18→\n  19→def _unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:\n  20→    result: dict[str, object] = {}\n  21→    for key, value in pairs:\n  22→        if key in result:\n  23→            raise SourceDerivationError(\"JSON对象含重复字段，不能确定原始记录\")\n  24→        result[key] = value\n  25→    return result\n  26→\n  27→\n  28→def _invalid_constant(value: str) -> NoReturn:\n  29→    raise SourceDerivationError(\"JSON来源含非有限数值\")\n  30→\n  31→\n  32→def source_json_decoder() -> json.JSONDecoder:\n  33→    \"\"\"One strict interpretation for acquisition and raw-record derivation.\"\"\"\n  34→    return json.JSONDecoder(object_pairs_hook=_unique_object, parse_constant=_invalid_constant)\n  35→\n  36→\n  37→def _extract_ctgov_record(content: bytes, selector: CtgovRecordSelector) -> str:\n  38→    \"\"\"Return the exact JSON object slice, without rounding numeric tokens.\"\"\"\n  39→    decoder = source_json_decoder()\n  40→    try:\n  41→        text = content.decode(\"utf-8\")\n  42→        payload = decoder.decode(text)\n  43→        if not isinstance(payload, dict) or not isinstance(payload.get(\"studies\"), list):\n  44→            raise ValueError(\"missing studies\")\n  45→        record = payload[\"studies\"][selector.study_index]\n  46→        if record[\"protocolSection\"][\"identificationModule\"][\"nctId\"] != selector.nct_id:\n  47→            raise ValueError(\"record identity mismatch\")\n  48→\n  49→        def whitespace(position: int) -> int:\n  50→            while position < len(text) and text[position] in \" \\r\\n\\t\":\n  51→                position += 1\n  52→            return position\n  53→\n  54→        position = whitespace(0) + 1  # Validated top-level object opening brace.\n  55→        while True:\n  56→            key, position = decoder.raw_decode(text, whitespace(position))\n  57→            position = whitespace(whitespace(position) + 1)  # Colon.\n  58→            if key == \"studies\":\n  59→                position = whitespace(position + 1)  # Array opening bracket.\n  60→                for index in range(selector.study_index + 1):\n  61→                    start = position\n  62→                    _, position = decoder.raw_decode(text, position)\n  63→                    if index == selector.study_index:\n  64→                        return text[start:position]\n  65→                    position = whitespace(whitespace(position) + 1)  # Array comma.\n  66→            _, position = decoder.raw_decode(text, position)\n  67→            position = whitespace(whitespace(position) + 1)  # Object comma.\n  68→    except (ValueError, UnicodeError, IndexError, KeyError, TypeError, RecursionError) as error:\n  69→        raise SourceDerivationError(\"原始JSON无法支持指定登记记录的身份与位置\") from error\n  70→    raise SourceDerivationError(\"原始JSON未找到指定登记记录\")\n  71→\n  72→\n  73→def _extract(\n  74→    content: bytes, media_type: str, record_selector: CtgovRecordSelector | None = None,\n  75→) -> tuple[str, Literal[\"utf8-strip-v1\", \"pypdf-text-v1\", \"ctgov-study-json-v1\"], str]:\n  76→    if record_selector is not None:\n  77→        if media_type != \"application/json\":\n  78→            raise SourceDerivationError(\"登记记录选择器仅适用于JSON响应\")\n  79→        return (\n  80→            _extract_ctgov_record(content, record_selector), \"ctgov-study-json-v1\",\n  81→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a08f74c0e77b339467e8764f913e8f","_messageId":"01a08f758b4f7cfeb2f3e6b87e08ab05","_meta":{"codebuddy.ai/conversationRequestId":"01a08f74c0e77b339467e8764f913e8f","codebuddy.ai/modelRequestId":"01a08f758b4f7cfeb2f3e6b87e08ab05","codebuddy.ai/llmMessageId":"01a08f758b4f7cfeb2f3e6b87e08ab05","traceparent":"00-ad7bdc66d5296f999aa4edc599e201ac-2aad9b60b4e08bab-01","baggage":"codebuddy.session_id=01a08f74-c077-7bd3-8de8-2cfab5bccb52,codebuddy.conversation_request_id=01a08f74c0e77b339467e8764f913e8f"},"__timestamp":"2026-09-11T07:55:08.781Z"}
