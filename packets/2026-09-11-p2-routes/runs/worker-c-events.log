{"type":"user","uuid":"01a08f74-efbc-7d35-b072-1cd2ae7986bf","session_id":"01a08f74-c077-7bd3-8de8-2cfab5bccb52","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_GQVUdM0aYod4m0XjBLHb8913","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→import hashlib\n   4→import json\n   5→import os\n   6→import sqlite3\n   7→import tempfile\n   8→from datetime import datetime\n   9→from pathlib import Path, PurePosixPath\n  10→from typing import cast\n  11→\n  12→from ci_workflow.domain.evidence import (\n  13→    ContentBlob,\n  14→    DateEvidence,\n  15→    DateEvidenceState,\n  16→    DatePrecision,\n  17→    EvidenceFragmentRecord,\n  18→    EvidenceLocator,\n  19→    SourceTextDerivation,\n  20→    SourceVersionRecord,\n  21→    source_version_identity,\n  22→)\n  23→from ci_workflow.domain.ids import stable_id\n  24→from ci_workflow.storage.sqlite import open_database\n  25→\n  26→\n  27→class ContentIntegrityError(RuntimeError):\n  28→    \"\"\"内容寻址文件的路径或摘要与记录不一致。\"\"\"\n  29→\n  30→\n  31→def _canonical_json(value: object) -> str:\n  32→    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"))\n  33→\n  34→\n  35→def _offset_label(value: datetime) -> str:\n  36→    raw = value.strftime(\"%z\")\n  37→    return f\"{raw[:3]}:{raw[3:]}\"\n  38→\n  39→\n  40→class ContentAddressedStore:\n  41→    \"\"\"项目内、可移动、内容寻址的不可变原文库。\"\"\"\n  42→\n  43→    def __init__(self, project_root: Path) -> None:\n  44→        self.project_root = project_root.resolve()\n  45→        self.raw_root = self.project_root / \"evidence/raw/sha256\"\n  46→\n  47→    def resolve_relative(self, relative_path: str) -> Path:\n  48→        pure = PurePosixPath(relative_path)\n  49→        if pure.is_absolute() or \"..\" in pure.parts or \"\\\\\" in relative_path:\n  50→            raise ContentIntegrityError(\"内容路径必须留在项目目录内\")\n  51→        path = self.project_root / Path(*pure.parts)\n  52→        for parent in (path, *path.parents):\n  53→            if parent == self.project_root:\n  54→                break\n  55→            if parent.is_symlink():\n  56→                raise ContentIntegrityError(\"内容寻址路径不得经过软链接\")\n  57→        resolved = path.resolve()\n  58→        if not resolved.is_relative_to(self.project_root):\n  59→            raise ContentIntegrityError(\"内容路径必须留在项目目录内\")\n  60→        return resolved\n  61→\n  62→    def put_bytes(self, content: bytes, *, media_type: str) -> ContentBlob:\n  63→        if not content:\n  64→            raise ValueError(\"原文内容不能为空\")\n  65→        if not media_type.strip():\n  66→            raise ValueError(\"原文媒体类型不能为空\")\n  67→        digest = hashlib.sha256(content).hexdigest()\n  68→        relative = PurePosixPath(\n  69→            \"evidence\", \"raw\", \"sha256\", digest[:2], f\"{digest}.bin\"\n  70→        ).as_posix()\n  71→        destination = self.resolve_relative(relative)\n  72→        destination.parent.mkdir(parents=True, exist_ok=True)\n  73→        if destination.exists():\n  74→            existing_digest = hashlib.sha256(destination.read_bytes()).hexdigest()\n  75→            if existing_digest != digest:\n  76→                raise ContentIntegrityError(\"内容寻址文件摘要不一致\")\n  77→        else:\n  78→            descriptor, temp_name = tempfile.mkstemp(\n  79→                prefix=f\".{digest}.\", dir=destination.parent\n  80→            )\n  81→            try:\n  82→                with os.fdopen(descriptor, \"wb\") as stream:\n  83→                    stream.write(content)\n  84→                    stream.flush()\n  85→                    os.fsync(stream.fileno())\n  86→                os.replace(temp_name, destination)\n  87→            except BaseException:\n  88→                Path(temp_name).unlink(missing_ok=True)\n  89→                raise\n  90→        return ContentBlob(\n  91→            sha256=digest,\n  92→            relative_path=relative,\n  93→            byte_size=len(content),\n  94→            media_type=media_type.strip(),\n  95→        )\n  96→\n  97→    def read_bytes(self, blob: ContentBlob) -> bytes:\n  98→        content = self.resolve_relative(blob.relative_path).read_bytes()\n  99→        if hashlib.sha256(content).hexdigest() != blob.sha256:\n 100→            raise ContentIntegrityError(\"内容寻址文件摘要不一致\")\n 101→        if len(content) != blob.byte_size:\n 102→            raise ContentIntegrityError(\"内容寻址文件大小与记录不一致\")\n 103→        return content\n 104→\n 105→\n 106→class EvidenceRepository:\n 107→    \"\"\"把内容寻址原文、SQLite 来源版本和证据片段连成一条链。\"\"\"\n 108→\n 109→    def __init__(self, database_path: Path, content_store: ContentAddressedStore) -> None:\n 110→        self.database_path = database_path\n 111→        self.content_store = content_store\n 112→\n 113→    def add_source_version(\n 114→        self,\n 115→        *,\n 116→        source_id: str,\n 117→        content: bytes,\n 118→        media_type: str,\n 119→        acquired_at: datetime,\n 120→        published_at: DateEvidence,\n 121→        effective_at: DateEvidence,\n 122→        first_disclosed_at: DateEvidence,\n 123→        text_derivation: SourceTextDerivation | None = None,\n 124→    ) -> SourceVersionRecord:\n 125→        if acquired_at.tzinfo is None or acquired_at.utcoffset() is None:\n 126→            raise ValueError(\"来源获取时间必须包含明确时区偏移\")\n 127→        if text_derivation is not None:\n 128→            self.content_store.read_bytes(text_derivation.raw_asset)\n 129→            if hashlib.sha256(content).hexdigest() != text_derivation.text_sha256:\n 130→                raise ContentIntegrityError(\"入库文本与原始资产派生摘要不一致\")\n 131→        blob = self.content_store.put_bytes(content, media_type=media_type)\n 132→        version_id = source_version_identity(\n 133→            source_id, blob.sha256, published_at=published_at,\n 134→            effective_at=effective_at, first_disclosed_at=first_disclosed_at,\n 135→            text_derivation=text_derivation,\n 136→        )\n 137→        with open_database(self.database_path) as database:\n 138→            exists = database.execute(\n 139→                \"SELECT 1 FROM source_versions WHERE source_version_id = ?\",\n 140→                (version_id,),\n 141→            ).fetchone()\n 142→            if exists is not None:\n 143→                return self._read_source_version(database, version_id)\n 144→\n 145→            database.execute(\n 146→                \"\"\"\n 147→                INSERT OR IGNORE INTO content_blobs (\n 148→                    content_sha256, relative_path, byte_size, media_type, created_at\n 149→                ) VALUES (?, ?, ?, ?, ?)\n 150→                \"\"\",\n 151→                (\n 152→                    blob.sha256,\n 153→                    blob.relative_path,\n 154→                    blob.byte_size,\n 155→                    blob.media_type,\n 156→                    acquired_at.isoformat(),\n 157→                ),\n 158→            )\n 159→            if text_derivation is not None:\n 160→                raw = text_derivation.raw_asset\n 161→                database.execute(\n 162→                    \"INSERT OR IGNORE INTO content_blobs \"\n 163→                    \"(content_sha256, relative_path, byte_size, media_type, created_at) \"\n 164→                    \"VALUES (?, ?, ?, ?, ?)\",\n 165→                    (\n 166→                        raw.sha256, raw.relative_path, raw.byte_size,\n 167→                        raw.media_type, acquired_at.isoformat(),\n 168→                    ),\n 169→                )\n 170→            database.execute(\n 171→                \"\"\"\n 172→                INSERT INTO source_versions (\n 173→                    source_version_id, source_id, content_sha256, acquired_at,\n 174→                    published_at, effective_at, first_disclosed_at, source_locator,\n 175→                    created_at\n 176→                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n 177→                \"\"\",\n 178→                (\n 179→                    version_id,\n 180→                    source_id,\n 181→                    blob.sha256,\n 182→                    acquired_at.isoformat(),\n 183→                    published_at.value.isoformat() if published_at.value else None,\n 184→                    effective_at.value.isoformat() if effective_at.value else None,\n 185→                    first_disclosed_at.value.isoformat()\n 186→                    if first_disclosed_at.value\n 187→                    else None,\n 188→                    _canonical_json(first_disclosed_at.locator.model_dump(mode=\"json\")),\n 189→                    acquired_at.isoformat(),\n 190→                ),\n 191→            )\n 192→            if text_derivation is not None:\n 193→                database.execute(\n 194→                    \"INSERT INTO source_text_derivations \"\n 195→                    \"(source_version_id, raw_content_sha256, derivation_json) VALUES (?, ?, ?)\",\n 196→                    (version_id, text_derivation.raw_asset.sha256,\n 197→                     _canonical_json(text_derivation.model_dump(mode=\"json\"))),\n 198→                )\n 199→            acquired_locator = EvidenceLocator(\n 200→                document_role=\"acquisition-receipt\",\n 201→                field_path=\"acquired_at\",\n 202→            )\n 203→            date_values = {\n 204→                \"acquired_at\": DateEvidence(\n 205→                    state=\"reported\", value=acquired_at, locator=acquired_locator\n 206→                ),\n 207→                \"published_at\": published_at,\n 208→                \"effective_at\": effective_at,\n 209→                \"first_disclosed_at\": first_disclosed_at,\n 210→            }\n 211→            for role, date_evidence in date_values.items():\n 212→                value = date_evidence.value\n 213→                database.execute(\n 214→                    \"\"\"\n 215→                    INSERT INTO source_date_assertions (\n 216→                        assertion_id, source_version_id, date_role, disclosure_state,\n 217→                        observed_at, timezone, date_precision, locator_json, created_at\n 218→                    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n 219→                    \"\"\",\n 220→                    (\n 221→                        stable_id(\"source-date\", version_id, role),\n 222→                        version_id,\n 223→                        role,\n 224→                        date_evidence.state,\n 225→                        value.isoformat() if value else None,\n 226→                        _offset_label(value if value else acquired_at),\n 227→                        date_evidence.precision,\n 228→                        _canonical_json(date_evidence.locator.model_dump(mode=\"json\")),\n 229→                        acquired_at.isoformat(),\n 230→                    ),\n 231→                )\n 232→            return self._read_source_version(database, version_id)\n 233→\n 234→    def _read_source_version(\n 235→        self, database: sqlite3.Connection, source_version_id: str\n 236→    ) -> SourceVersionRecord:\n 237→        row = database.execute(\n 238→            \"\"\"\n 239→            SELECT sv.source_version_id, sv.source_id, sv.content_sha256,\n 240→                   sv.acquired_at, sv.created_at, cb.relative_path, cb.media_type\n 241→            FROM source_versions AS sv\n 242→            JOIN content_blobs AS cb ON cb.content_sha256 = sv.content_sha256\n 243→            WHERE sv.source_version_id = ?\n 244→            \"\"\",\n 245→            (source_version_id,),\n 246→        ).fetchone()\n 247→        if row is None:\n 248→            raise KeyError(f\"来源版本不存在：{source_version_id}\")\n 249→        assertions = {\n 250→            str(item[0]): (\n 251→                str(item[1]),\n 252→                item[2],\n 253→                str(item[3]),\n 254→                json.loads(str(item[4])),\n 255→            )\n 256→            for item in database.execute(\n 257→                \"\"\"\n 258→                SELECT date_role, disclosure_state, observed_at, date_precision,\n 259→                       locator_json\n 260→                FROM source_date_assertions WHERE source_version_id = ?\n 261→                \"\"\",\n 262→                (source_version_id,),\n 263→            )\n 264→        }\n 265→\n 266→        def date_evidence(role: str) -> DateEvidence:\n 267→            state, observed_at, precision, locator = assertions[role]\n 268→            return DateEvidence(\n 269→                state=cast(DateEvidenceState, state),\n 270→                value=datetime.fromisoformat(str(observed_at))\n 271→                if observed_at is not None\n 272→                else None,\n 273→                precision=cast(DatePrecision, precision),\n 274→                locator=EvidenceLocator.model_validate(locator),\n 275→            )\n 276→\n 277→        acquired = date_evidence(\"acquired_at\")\n 278→        if acquired.value is None:\n 279→            raise ContentIntegrityError(\"来源版本缺少获取时间\")\n 280→        has_derivations = database.execute(\n 281→            \"SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'source_text_derivations'\"\n 282→        ).fetchone() is not None\n 283→        derivation_row = (\n 284→            database.execute(\n 285→                \"SELECT derivation_json FROM source_text_derivations WHERE source_version_id = ?\",\n 286→                (source_version_id,),\n 287→            ).fetchone()\n 288→            if has_derivations else None\n 289→        )\n 290→        return SourceVersionRecord(\n 291→            schema_version=\"1.0\",\n 292→            source_version_id=str(row[0]),\n 293→            source_id=str(row[1]),\n 294→            content_sha256=str(row[2]),\n 295→            content_relative_path=str(row[5]),\n 296→            media_type=str(row[6]),\n 297→            text_derivation=(\n 298→                SourceTextDerivation.model_validate_json(str(derivation_row[0]))\n 299→                if derivation_row is not None else None\n 300→            ),\n 301→            acquired_at=acquired.value,\n 302→            acquired_locator=acquired.locator,\n 303→            published_at=date_evidence(\"published_at\"),\n 304→            effective_at=date_evidence(\"effective_at\"),\n 305→            first_disclosed_at=date_evidence(\"first_disclosed_at\"),\n 306→            created_at=datetime.fromisoformat(str(row[4])),\n 307→        )\n 308→\n 309→    def add_fragment(\n 310→        self,\n 311→        *,\n 312→        source_version_id: str,\n 313→        locator: EvidenceLocator,\n 314→        original_text: str,\n 315→        created_at: datetime | None = None,\n 316→    ) -> EvidenceFragmentRecord:\n 317→        timestamp = created_at or datetime.now().astimezone()\n 318→        if timestamp.tzinfo is None or timestamp.utcoffset() is None:\n 319→            raise ValueError(\"证据片段创建时间必须包含明确时区偏移\")\n 320→        digest = hashlib.sha256(original_text.encode(\"utf-8\")).hexdigest()\n 321→        locator_json = _canonical_json(locator.model_dump(mode=\"json\"))\n 322→        fragment_id = stable_id(\n 323→            \"evidence-fragment\", source_version_id, locator_json, digest\n 324→        )\n 325→        record = EvidenceFragmentRecord(\n 326→            schema_version=\"1.0\",\n 327→            fragment_id=fragment_id,\n 328→            source_version_id=source_version_id,\n 329→            locator=locator,\n 330→            original_text=original_text,\n 331→            content_sha256=digest,\n 332→            created_at=timestamp,\n 333→        )\n 334→        with open_database(self.database_path) as database:\n 335→            existing = database.execute(\n 336→                \"SELECT 1 FROM evidence_fragments WHERE fragment_id = ?\",\n 337→                (record.fragment_id,),\n 338→            ).fetchone()\n 339→            if existing is None:\n 340→                database.execute(\n 341→                    \"\"\"\n 342→                    INSERT INTO evidence_fragments (\n 343→                        fragment_id, source_version_id, locator, content_text,\n 344→                        content_sha256, created_at\n 345→                    ) VALUES (?, ?, ?, ?, ?, ?)\n 346→                    \"\"\",\n 347→                    (\n 348→                        record.fragment_id,\n 349→                        record.source_version_id,\n 350→                        locator_json,\n 351→                        record.original_text,\n 352→                        record.content_sha256,\n 353→                        record.created_at.isoformat(),\n 354→                    ),\n 355→                )\n 356→        return record\n 357→\n 358→    def read_fragment(self, fragment_id: str) -> EvidenceFragmentRecord:\n 359→        with open_database(self.database_path) as database:\n 360→            row = database.execute(\n 361→                \"\"\"\n 362→                SELECT fragment_id, source_version_id, locator, content_text,\n 363→                       content_sha256, created_at\n 364→                FROM evidence_fragments WHERE fragment_id = ?\n 365→                \"\"\",\n 366→                (fragment_id,),\n 367→            ).fetchone()\n 368→        if row is None:\n 369→            raise KeyError(f\"证据片段不存在：{fragment_id}\")\n 370→        return EvidenceFragmentRecord(\n 371→            schema_version=\"1.0\",\n 372→            fragment_id=str(row[0]),\n 373→            source_version_id=str(row[1]),\n 374→            locator=EvidenceLocator.model_validate(json.loads(str(row[2]))),\n 375→            original_text=str(row[3]),\n 376→            content_sha256=str(row[4]),\n 377→            created_at=datetime.fromisoformat(str(row[5])),\n 378→        )\n 379→\n 380→    def verify_reopened_fragment_record(\n 381→        self,\n 382→        fragment: EvidenceFragmentRecord,\n 383→        *,\n 384→        reopened_original_text: str,\n 385→        source_version_id: str,\n 386→    ) -> SourceVersionRecord:\n 387→        \"\"\"从项目真源库重读来源、正文和片段，供科学注册表验真。\"\"\"\n 388→\n 389→        stored_fragment = self.read_fragment(fragment.fragment_id)\n 390→        if stored_fragment != fragment:\n 391→            raise ContentIntegrityError(\"待验片段与项目真源库记录不一致\")\n 392→        if fragment.source_version_id != source_version_id:\n 393→            raise ContentIntegrityError(\"重开来源版本与证据片段不一致\")\n 394→        if reopened_original_text != stored_fragment.original_text:\n 395→            raise ContentIntegrityError(\"重开原文与项目真源库片段不一致\")\n 396→        with open_database(self.database_path) as database:\n 397→            source_version = self._read_source_version(database, source_version_id)\n 398→            row = database.execute(\n 399→                \"\"\"\n 400→                SELECT byte_size FROM content_blobs WHERE content_sha256 = ?\n 401→                \"\"\",\n 402→                (source_version.content_sha256,),\n 403→            ).fetchone()\n 404→        if row is None:\n 405→            raise ContentIntegrityError(\"来源版本缺少内容寻址正文\")\n 406→        blob = ContentBlob(\n 407→            sha256=source_version.content_sha256,\n 408→            relative_path=source_version.content_relative_path,\n 409→            byte_size=int(row[0]),\n 410→            media_type=source_version.media_type,\n 411→        )\n 412→        source_content = self.content_store.read_bytes(blob)\n 413→        if source_version.text_derivation is not None:\n 414→            from ci_workflow.storage.source_derivation import (\n 415→                SourceDerivationError,\n 416→                verify_source_text_derivation,\n 417→            )\n 418→\n 419→            try:\n 420→                verify_source_text_derivation(\n 421→                    self.content_store.project_root, source_version.text_derivation,\n 422→                    source_content.decode(\"utf-8\"),\n 423→                )\n 424→            except (UnicodeDecodeError, SourceDerivationError) as error:\n 425→                raise ContentIntegrityError(\"原始资产与重开文本的派生链校验失败\") from error\n 426→        if source_version.media_type.startswith(\"text/\") or any(\n 427→            marker in source_version.media_type\n 428→            for marker in (\"json\", \"xml\", \"javascript\")\n 429→        ):\n 430→            decoded = source_content.decode(\"utf-8\")\n 431→            if stored_fragment.original_text not in decoded:\n 432→                raise ContentIntegrityError(\"证据片段原文不存在于已保存来源正文\")\n 433→        return source_version\n 434→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a08f74c0e77b339467e8764f913e8f","_messageId":"01a08f74e5e872238c6ef2ec7049d5fd","_meta":{"codebuddy.ai/conversationRequestId":"01a08f74c0e77b339467e8764f913e8f","codebuddy.ai/modelRequestId":"01a08f74e5e872238c6ef2ec7049d5fd","codebuddy.ai/llmMessageId":"01a08f74e5e872238c6ef2ec7049d5fd","traceparent":"00-ad7bdc66d5296f999aa4edc599e201ac-2aad9b60b4e08bab-01","baggage":"codebuddy.session_id=01a08f74-c077-7bd3-8de8-2cfab5bccb52,codebuddy.conversation_request_id=01a08f74c0e77b339467e8764f913e8f"},"__timestamp":"2026-09-11T07:53:20.572Z"}
