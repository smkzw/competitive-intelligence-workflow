{"type":"assistant","uuid":"01a08f74-d1a8-791d-8a9a-08a16b061f3e","session_id":"01a08f74-c077-7bd3-8de8-2cfab5bccb52","message":{"id":"01a08f74c7037ba8ba2ec47a6fddb464","content":[{"type":"tool_use","id":"call_01_ET_HcYkmWIJBaCDoSCLFKFz3471","name":"Read","input":{"file_path":"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/pubmed.py"}}],"model":"deepseek-v4-flash","role":"assistant","stop_reason":"tool_use","stop_sequence":null,"type":"message","usage":{"input_tokens":31818,"output_tokens":142,"cache_creation_input_tokens":5962,"cache_read_input_tokens":25856,"cache_creation":null,"server_tool_use":null,"service_tier":null}},"parent_tool_use_id":null,"_requestId":"01a08f74c0e77b339467e8764f913e8f","_messageId":"01a08f74c7037ba8ba2ec47a6fddb464","_meta":{"codebuddy.ai/conversationRequestId":"01a08f74c0e77b339467e8764f913e8f","codebuddy.ai/modelRequestId":"01a08f74c7037ba8ba2ec47a6fddb464","codebuddy.ai/llmMessageId":"01a08f74c7037ba8ba2ec47a6fddb464","traceparent":"00-ad7bdc66d5296f999aa4edc599e201ac-2aad9b60b4e08bab-01","baggage":"codebuddy.session_id=01a08f74-c077-7bd3-8de8-2cfab5bccb52,codebuddy.conversation_request_id=01a08f74c0e77b339467e8764f913e8f"},"__timestamp":"2026-09-11T07:53:12.873Z"}
{"type":"user","uuid":"01a08f74-d1ac-7e97-9554-9876ca5cb920","session_id":"01a08f74-c077-7bd3-8de8-2cfab5bccb52","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_ET_lMvhCOhMRjMXlZhOehtE6962","content":[{"type":"text","text":"   1→\"\"\"Bounded CT.gov v2 acquisition; pagination completion is not universe closure.\n   2→\n   3→This endpoint returns current records, not historical as-of reconstructions.\n   4→Official interface: https://clinicaltrials.gov/data-api/api\n   5→No cookies, authentication, alternate hosts or implicit retries are used.\n   6→\"\"\"\n   7→\n   8→from __future__ import annotations\n   9→\n  10→import json\n  11→from collections.abc import Callable\n  12→from dataclasses import dataclass\n  13→from datetime import UTC, date, datetime\n  14→from pathlib import Path\n  15→from typing import Any, Literal, Protocol\n  16→from urllib.error import HTTPError, URLError\n  17→from urllib.parse import parse_qs, urlencode, urlsplit\n  18→from urllib.request import HTTPRedirectHandler, Request, build_opener\n  19→\n  20→from pydantic import BaseModel, ConfigDict\n  21→\n  22→from ci_workflow.domain.evidence import ContentBlob, CtgovRecordSelector, SourceTextDerivation\n  23→from ci_workflow.sources.connectors.clinicaltrials_gov import (\n  24→    ClinicalTrialsGovCapture,\n  25→    ClinicalTrialsGovStudyVersion,\n  26→    build_next_page_url,\n  27→)\n  28→from ci_workflow.storage.content_store import ContentAddressedStore, ContentIntegrityError\n  29→from ci_workflow.storage.source_derivation import (\n  30→    SourceDerivationError,\n  31→    capture_source_text,\n  32→    source_json_decoder,\n  33→)\n  34→\n  35→API = \"https://clinicaltrials.gov/api/v2/studies\"\n  36→FetchStatus = Literal[\n  37→    \"complete\", \"no_records\", \"incomplete\", \"network_error\", \"rate_limited\",\n  38→    \"access_denied\", \"invalid_response\",\n  39→]\n  40→\n  41→\n  42→@dataclass(frozen=True)\n  43→class HttpPage:\n  44→    status: int\n  45→    content_type: str\n  46→    body: bytes\n  47→    final_url: str\n  48→\n  49→\n  50→class Transport(Protocol):\n  51→    def __call__(self, url: str, timeout: float, max_bytes: int) -> HttpPage: ...\n  52→\n  53→\n  54→class _NoRedirect(HTTPRedirectHandler):\n  55→    def redirect_request(\n  56→        self, req: Request, fp: Any, code: int, msg: str,\n  57→        headers: Any, newurl: str,\n  58→    ) -> None:\n  59→        return None\n  60→\n  61→\n  62→def _download(url: str, timeout: float, max_bytes: int) -> HttpPage:\n  63→    request = Request(url, headers={\n  64→        \"Accept\": \"application/json\", \"User-Agent\": \"CI-Workflow/1.4 public-research\",\n  65→    })\n  66→    try:\n  67→        with build_opener(_NoRedirect()).open(request, timeout=timeout) as response:\n  68→            return HttpPage(\n  69→                response.status, response.headers.get_content_type(),\n  70→                response.read(max_bytes + 1), response.geturl(),\n  71→            )\n  72→    except HTTPError as error:\n  73→        # Do not log or persist a server's error/authentication page.\n  74→        status = error.code\n  75→        error.close()\n  76→        return HttpPage(status, \"\", b\"\", url)\n  77→\n  78→\n  79→class CapturedPage(BaseModel):\n  80→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  81→    page_number: int\n  82→    request_url: str\n  83→    acquired_at: datetime\n  84→    raw_asset: ContentBlob\n  85→    study_ids: tuple[str, ...]\n  86→\n  87→\n  88→class CtgovFetchResult(BaseModel):\n  89→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  90→    condition: str\n  91→    status: FetchStatus\n  92→    pagination_complete: bool\n  93→    universe_closed: Literal[False] = False\n  94→    temporal_scope: Literal[\"current_records\"] = \"current_records\"\n  95→    total_count: int | None\n  96→    studies: tuple[ClinicalTrialsGovStudyVersion, ...]\n  97→    pages: tuple[CapturedPage, ...]\n  98→    diagnostic: str\n  99→\n 100→\n 101→def fetch_ctgov_condition(\n 102→    project_root: Path,\n 103→    condition: str,\n 104→    *,\n 105→    page_size: int = 100,\n 106→    max_pages: int = 1000,\n 107→    timeout: float = 30,\n 108→    max_page_bytes: int = 20 * 1024 * 1024,\n 109→    max_total_bytes: int = 128 * 1024 * 1024,\n 110→    transport: Transport | None = None,\n 111→    clock: Callable[[], datetime] = lambda: datetime.now(UTC),\n 112→) -> CtgovFetchResult:\n 113→    \"\"\"Fetch every cursor page, retaining partial evidence on any failure.\n 114→\n 115→    Resource limits are failures, never Top-N success. Caller owns recovery,\n 116→    alias expansion, historical reconstruction and independent review.\n 117→    \"\"\"\n 118→    condition = condition.strip()\n 119→    if not condition or len(condition) > 4000 or any(ord(char) < 32 for char in condition):\n 120→        raise ValueError(\"检索条件必须是非空、有界的公开研究条件\")\n 121→    if not 1 <= page_size <= 1000 or max_pages < 1 or not 0 < timeout <= 60:\n 122→        raise ValueError(\"分页大小、页数或超时配置无效\")\n 123→    if max_page_bytes < 1 or max_total_bytes < 1:\n 124→        raise ValueError(\"获取字节预算必须为正\")\n 125→    url = API + \"?\" + urlencode({\n 126→        \"query.cond\": condition, \"format\": \"json\", \"pageSize\": page_size, \"countTotal\": \"true\",\n 127→    })\n 128→    download = transport or _download\n 129→    store = ContentAddressedStore(project_root)\n 130→    studies: dict[str, ClinicalTrialsGovStudyVersion] = {}\n 131→    pages: list[CapturedPage] = []\n 132→    tokens: set[str] = set()\n 133→    total: int | None = None\n 134→    platform_holder: str | None = None\n 135→    byte_count = 0\n 136→\n 137→    def finish(status: FetchStatus, diagnostic: str) -> CtgovFetchResult:\n 138→        return CtgovFetchResult(\n 139→            condition=condition, status=status,\n 140→            pagination_complete=status in {\"complete\", \"no_records\"},\n 141→            total_count=total, studies=tuple(studies.values()), pages=tuple(pages),\n 142→            diagnostic=diagnostic,\n 143→        )\n 144→\n 145→    for page_number in range(1, max_pages + 1):\n 146→        remaining = min(max_page_bytes, max_total_bytes - byte_count)\n 147→        if remaining <= 0:\n 148→            return finish(\"incomplete\", \"获取字节预算已耗尽；必须恢复，不能认定检索完成\")\n 149→        try:\n 150→            response = download(url, timeout, remaining)\n 151→        except (OSError, URLError, TimeoutError):\n 152→            return finish(\"network_error\", \"公开接口网络获取失败；不是无数据\")\n 153→        if response.status == 429:\n 154→            return finish(\"rate_limited\", \"接口限流；需按来源恢复策略重试\")\n 155→        if response.status in {401, 403}:\n 156→            return finish(\"access_denied\", \"公开接口拒绝访问；不能当作无记录\")\n 157→        if response.status >= 500:\n 158→            return finish(\"network_error\", \"来源服务暂不可用；不能当作无记录\")\n 159→        if response.status != 200 or response.final_url != url:\n 160→            return finish(\"invalid_response\", \"接口状态或重定向不符合限定来源合同\")\n 161→        if len(response.body) > remaining:\n 162→            return finish(\"incomplete\", \"响应超出获取预算；未保存截断正文\")\n 163→        if response.content_type.split(\";\", 1)[0].strip().lower() != \"application/json\":\n 164→            return finish(\"invalid_response\", \"来源未返回JSON；不接纳错误页作为临床数据\")\n 165→        acquired_at = clock()\n 166→        if acquired_at.tzinfo is None or acquired_at.utcoffset() is None:\n 167→            raise ValueError(\"获取时钟必须有明确时区\")\n 168→        try:\n 169→            payload = source_json_decoder().decode(response.body.decode(\"utf-8\"))\n 170→            if not isinstance(payload, dict):\n 171→                raise ValueError(\"response must be an object\")\n 172→            capture = ClinicalTrialsGovCapture.from_api_payload(\n 173→                payload, acquired_at=acquired_at.isoformat(),\n 174→            )\n 175→            # CT.gov returns countTotal on page one, omitting it on cursor pages.\n 176→            count = payload.get(\"totalCount\", total)\n 177→            if type(count) is not int or count < 0:\n 178→                raise ValueError(\"countTotal response must contain a nonnegative totalCount\")\n 179→            token = payload.get(\"nextPageToken\")\n 180→            if token is not None and (not isinstance(token, str) or not token.strip()):\n 181→                raise ValueError(\"cursor must be a nonempty string\")\n 182→        except (ValueError, TypeError, UnicodeError, RecursionError):\n 183→            return finish(\"invalid_response\", \"来源JSON缺少有效记录、计数或分页字段\")\n 184→        raw = store.put_bytes(response.body, media_type=\"application/json\")\n 185→        pages.append(CapturedPage(\n 186→            page_number=page_number, request_url=url, acquired_at=acquired_at,\n 187→            raw_asset=raw, study_ids=tuple(study.nct_id for study in capture.studies),\n 188→        ))\n 189→        byte_count += len(response.body)\n 190→        if total is not None and total != count:\n 191→            return finish(\"incomplete\", \"分页期间来源总量变化，需重新核查集合\")\n 192→        total = count\n 193→        for study in capture.studies:\n 194→            if platform_holder is not None and platform_holder != study.platform_version_holder:\n 195→                return finish(\"incomplete\", \"分页期间登记平台版本变化；需重新获取一致集合\")\n 196→            platform_holder = study.platform_version_holder\n 197→            previous = studies.get(study.nct_id)\n 198→            if previous is not None and previous.source_version_id != study.source_version_id:\n 199→                return finish(\"incomplete\", \"分页期间同一登记记录发生版本冲突\")\n 200→            studies[study.nct_id] = study\n 201→        if capture.next_page_token is None:\n 202→            if len(studies) != total:\n 203→                return finish(\"incomplete\", \"终页唯一登记数与来源声明总数不一致\")\n 204→            return finish(\n 205→                \"complete\" if studies else \"no_records\", \"当前查询分页已核对；非竞品宇宙闭包\",\n 206→            )\n 207→        if capture.next_page_token in tokens:\n 208→            return finish(\"incomplete\", \"重复分页游标；防止循环及虚假完成\")\n 209→        tokens.add(capture.next_page_token)\n 210→        url = build_next_page_url(url, capture.next_page_token)\n 211→    return finish(\"incomplete\", \"页数预算已耗尽；保留部分证据并等待恢复\")\n 212→\n 213→\n 214→class DerivedCtgovStudy(BaseModel):\n 215→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 216→    nct_id: str\n 217→    title: str\n 218→    record_url: str\n 219→    registry_posted_version_date: str\n 220→    registry_posted_date_precision: Literal[\"calendar_day\"] = \"calendar_day\"\n 221→    temporal_scope: Literal[\"current_record\"] = \"current_record\"\n 222→    acquired_at: datetime\n 223→    content_text: str\n 224→    text_derivation: SourceTextDerivation\n 225→\n 226→\n 227→def derive_ctgov_records(\n 228→    project_root: Path, result: CtgovFetchResult,\n 229→) -> tuple[DerivedCtgovStudy, ...]:\n 230→    \"\"\"Reopen the whole cursor chain, then extract exact per-record JSON slices.\n 231→\n 232→    Publication-date precision is retained; no midnight instant is invented.\n 233→    This does not assign scientific claims, approve a report, or close a universe.\n 234→    \"\"\"\n 235→    if not result.pagination_complete or result.status not in {\"complete\", \"no_records\"}:\n 236→        raise SourceDerivationError(\"分页尚未完成；原始部分证据保留但不能晋级完整记录集\")\n 237→    if not result.pages:\n 238→        raise SourceDerivationError(\"获取结果没有可重开的原始响应\")\n 239→    store = ContentAddressedStore(project_root)\n 240→    page_index = 0\n 241→\n 242→    def replay(url: str, timeout: float, max_bytes: int) -> HttpPage:\n 243→        nonlocal page_index\n 244→        if page_index >= len(result.pages):\n 245→            raise SourceDerivationError(\"原始分页链尚未到终页\")\n 246→        page = result.pages[page_index]\n 247→        page_index += 1\n 248→        if page.request_url != url or page.page_number != page_index:\n 249→            raise SourceDerivationError(\"分页请求条件或顺序与回执不一致\")\n 250→        return HttpPage(200, page.raw_asset.media_type, store.read_bytes(page.raw_asset), url)\n 251→\n 252→    try:\n 253→        query = parse_qs(urlsplit(result.pages[0].request_url).query)\n 254→        size = query.get(\"pageSize\", [])\n 255→        if len(size) != 1:\n 256→            raise SourceDerivationError(\"获取回执缺少唯一分页大小\")\n 257→        verified = fetch_ctgov_condition(\n 258→            project_root, result.condition, page_size=int(size[0]),\n 259→            max_pages=len(result.pages), transport=replay,\n 260→            clock=lambda: result.pages[page_index - 1].acquired_at,\n 261→        )\n 262→        if (\n 263→            page_index != len(result.pages) or not verified.pagination_complete\n 264→            or verified.status != result.status or verified.total_count != result.total_count\n 265→            or verified.studies != result.studies or verified.pages != result.pages\n 266→        ):\n 267→            raise SourceDerivationError(\"获取回执与实际原始响应、版本或总量不一致\")\n 268→        records: dict[str, DerivedCtgovStudy] = {}\n 269→        for page in verified.pages:\n 270→            raw = store.read_bytes(page.raw_asset)\n 271→            capture = ClinicalTrialsGovCapture.from_api_payload(\n 272→                json.loads(raw), acquired_at=page.acquired_at.isoformat(),\n 273→            )\n 274→            for index, study in enumerate(capture.studies):\n 275→                date.fromisoformat(study.registry_posted_version_date)\n 276→                text, receipt = capture_source_text(\n 277→                    project_root, raw, media_type=\"application/json\",\n 278→                    record_selector=CtgovRecordSelector(study_index=index, nct_id=study.nct_id),\n 279→                )\n 280→                records[study.nct_id] = DerivedCtgovStudy(\n 281→                    nct_id=study.nct_id, title=study.title, record_url=study.record_url,\n 282→                    registry_posted_version_date=study.registry_posted_version_date,\n 283→                    acquired_at=study.acquired_at, content_text=text, text_derivation=receipt,\n 284→                )\n 285→        return tuple(records.values())\n 286→    except (OSError, ContentIntegrityError, ValueError) as error:\n 287→        raise SourceDerivationError(\"原始分页证据无法支持当前记录集投影\") from error\n 288→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a08f74c0e77b339467e8764f913e8f","_messageId":"01a08f74c7037ba8ba2ec47a6fddb464","_meta":{"codebuddy.ai/conversationRequestId":"01a08f74c0e77b339467e8764f913e8f","codebuddy.ai/modelRequestId":"01a08f74c7037ba8ba2ec47a6fddb464","codebuddy.ai/llmMessageId":"01a08f74c7037ba8ba2ec47a6fddb464","traceparent":"00-ad7bdc66d5296f999aa4edc599e201ac-2aad9b60b4e08bab-01","baggage":"codebuddy.session_id=01a08f74-c077-7bd3-8de8-2cfab5bccb52,codebuddy.conversation_request_id=01a08f74c0e77b339467e8764f913e8f"},"__timestamp":"2026-09-11T07:53:12.876Z"}
{"type":"user","uuid":"01a08f74-d1ae-70db-855b-1981b8dc591d","session_id":"01a08f74-c077-7bd3-8de8-2cfab5bccb52","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_ET_HcYkmWIJBaCDoSCLFKFz3471","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→import re\n   4→from typing import Literal\n   5→from urllib.parse import urlencode\n   6→from xml.etree import ElementTree\n   7→\n   8→from pydantic import BaseModel, ConfigDict, field_validator\n   9→\n  10→_NCT_ID = re.compile(r\"NCT[0-9]{8}\", re.IGNORECASE)\n  11→PublicationRole = Literal[\n  12→    \"primary_report\",\n  13→    \"ad_hoc_analysis\",\n  14→    \"review\",\n  15→    \"supporting_publication\",\n  16→    \"unrelated\",\n  17→]\n  18→EvidenceFieldDomain = Literal[\"trial_design\", \"efficacy\", \"safety\"]\n  19→EvidenceSourceRole = Literal[\n  20→    \"clinical_trial_registry\",\n  21→    \"primary_publication\",\n  22→    \"regulatory_material\",\n  23→    \"supplementary_material\",\n  24→]\n  25→\n  26→\n  27→class PubMedRecord(BaseModel):\n  28→    \"\"\"由 PubMed EFetch 原文解析得到的最小不可变记录。\"\"\"\n  29→\n  30→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  31→\n  32→    pmid: str\n  33→    title: str\n  34→    abstract: str\n  35→    publication_types: tuple[str, ...]\n  36→\n  37→    @field_validator(\"pmid\")\n  38→    @classmethod\n  39→    def _pmid_is_numeric(cls, value: str) -> str:\n  40→        normalized = value.strip()\n  41→        if not normalized.isdigit():\n  42→            raise ValueError(\"PubMed 标识必须为数字\")\n  43→        return normalized\n  44→\n  45→    @field_validator(\"title\")\n  46→    @classmethod\n  47→    def _title_is_not_blank(cls, value: str) -> str:\n  48→        normalized = \" \".join(value.split())\n  49→        if not normalized:\n  50→            raise ValueError(\"PubMed 题名不能为空\")\n  51→        return normalized\n  52→\n  53→    @field_validator(\"abstract\")\n  54→    @classmethod\n  55→    def _normalize_abstract(cls, value: str) -> str:\n  56→        return \" \".join(value.split())\n  57→\n  58→\n  59→class ClassifiedPublication(BaseModel):\n  60→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  61→\n  62→    record: PubMedRecord\n  63→    role: PublicationRole\n  64→    matched_nct_ids: tuple[str, ...]\n  65→    classification_signals: tuple[str, ...]\n  66→    rationale_zh: str\n  67→    can_replace_primary_report: bool\n  68→\n  69→\n  70→class EvidenceContribution(BaseModel):\n  71→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  72→\n  73→    field_id: str\n  74→    field_domain: EvidenceFieldDomain\n  75→    source_role: EvidenceSourceRole\n  76→    source_record_id: str\n  77→\n  78→    @field_validator(\"field_id\", \"source_record_id\")\n  79→    @classmethod\n  80→    def _contribution_text_is_not_blank(cls, value: str) -> str:\n  81→        normalized = \" \".join(value.split())\n  82→        if not normalized:\n  83→            raise ValueError(\"证据字段和来源记录标识不能为空\")\n  84→        return normalized\n  85→\n  86→\n  87→class RejectedContribution(BaseModel):\n  88→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  89→\n  90→    contribution: EvidenceContribution\n  91→    rationale_zh: str\n  92→\n  93→\n  94→class KeyFieldCoverage(BaseModel):\n  95→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  96→\n  97→    accepted_contributions: tuple[EvidenceContribution, ...]\n  98→    rejected_contributions: tuple[RejectedContribution, ...]\n  99→    missing_fields: tuple[str, ...]\n 100→    supplement_state: Literal[\"not_required\", \"required\"]\n 101→    rationale_zh: str\n 102→\n 103→\n 104→def build_pubmed_nct_search_url(nct_id: str) -> str:\n 105→    normalized = nct_id.strip().upper()\n 106→    if re.fullmatch(r\"NCT[0-9]{8}\", normalized) is None:\n 107→        raise ValueError(\"PubMed NCT 检索需要有效 NCT 号\")\n 108→    query = urlencode(\n 109→        {\n 110→            \"db\": \"pubmed\",\n 111→            \"term\": f\"{normalized}[All Fields]\",\n 112→            \"retmode\": \"json\",\n 113→            \"retmax\": \"10000\",\n 114→        }\n 115→    )\n 116→    return f\"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?{query}\"\n 117→\n 118→\n 119→def _element_text(element: ElementTree.Element | None) -> str:\n 120→    if element is None:\n 121→        return \"\"\n 122→    return \" \".join(\"\".join(element.itertext()).split())\n 123→\n 124→\n 125→def parse_pubmed_efetch_xml(xml_text: str) -> tuple[PubMedRecord, ...]:\n 126→    \"\"\"Parse article identities only from MedlineCitation, never nested relation PMIDs.\"\"\"\n 127→    try:\n 128→        root = ElementTree.fromstring(xml_text)\n 129→    except ElementTree.ParseError as exc:\n 130→        raise ValueError(\"PubMed EFetch XML 无法解析\") from exc\n 131→    records: list[PubMedRecord] = []\n 132→    for article_node in root.findall(\"./PubmedArticle\"):\n 133→        citation = article_node.find(\"./MedlineCitation\")\n 134→        if citation is None:\n 135→            continue\n 136→        pmid = _element_text(citation.find(\"./PMID\"))\n 137→        article = citation.find(\"./Article\")\n 138→        if article is None:\n 139→            raise ValueError(f\"PubMed 记录 {pmid or '未知'} 缺少 Article\")\n 140→        title = _element_text(article.find(\"./ArticleTitle\"))\n 141→        abstract_parts: list[str] = []\n 142→        for abstract_node in article.findall(\"./Abstract/AbstractText\"):\n 143→            text = _element_text(abstract_node)\n 144→            if not text:\n 145→                continue\n 146→            label = \" \".join(abstract_node.attrib.get(\"Label\", \"\").split())\n 147→            abstract_parts.append(f\"{label}: {text}\" if label else text)\n 148→        publication_types = tuple(\n 149→            text\n 150→            for item in article.findall(\"./PublicationTypeList/PublicationType\")\n 151→            if (text := _element_text(item))\n 152→        )\n 153→        records.append(\n 154→            PubMedRecord(\n 155→                pmid=pmid,\n 156→                title=title,\n 157→                abstract=\" \".join(abstract_parts),\n 158→                publication_types=publication_types,\n 159→            )\n 160→        )\n 161→    return tuple(records)\n 162→\n 163→\n 164→def _classify(record: PubMedRecord, matched: tuple[str, ...]) -> ClassifiedPublication:\n 165→    combined = f\"{record.title}\\n{record.abstract}\".casefold()\n 166→    publication_types = {item.casefold() for item in record.publication_types}\n 167→    review_signals = (\n 168→        bool(publication_types & {\"review\", \"meta-analysis\", \"systematic review\"})\n 169→        or \"systematic review\" in combined\n 170→        or \"meta-analysis\" in combined\n 171→    )\n 172→    ad_hoc_signals = any(\n 173→        marker in combined\n 174→        for marker in (\"post hoc\", \"post-hoc\", \"subgroup analysis\", \"exploratory analysis\")\n 175→    )\n 176→    randomized_signal = (\n 177→        \"randomized controlled trial\" in publication_types\n 178→        or \"randomised\" in combined\n 179→        or \"randomized\" in combined\n 180→        or \"phase 2\" in combined\n 181→        or \"phase 3\" in combined\n 182→    )\n 183→    protocol_signal = (\n 184→        \"clinical trial protocol\" in publication_types\n 185→        or \"study protocol\" in combined\n 186→        or combined.startswith(\"protocol \")\n 187→    )\n 188→    primary_endpoint_signal = any(\n 189→        marker in combined\n 190→        for marker in (\n 191→            \"primary endpoint\",\n 192→            \"primary endpoints\",\n 193→            \"co-primary endpoint\",\n 194→            \"co-primary endpoints\",\n 195→            \"primary outcome\",\n 196→            \"primary outcomes\",\n 197→        )\n 198→    )\n 199→    result_signal = any(\n 200→        marker in combined\n 201→        for marker in (\n 202→            \"results are reported\",\n 203→            \"results showed\",\n 204→            \"we report\",\n 205→            \"efficacy and safety\",\n 206→            \"trial findings\",\n 207→        )\n 208→    )\n 209→    signals: tuple[str, ...]\n 210→    if not matched:\n 211→        role: PublicationRole = \"unrelated\"\n 212→        signals = (\"未匹配目标 NCT\",)\n 213→        rationale = \"正文未匹配目标试验登记号，不能据此建立论文—试验关系。\"\n 214→    elif review_signals:\n 215→        role = \"review\"\n 216→        signals = (\"综述或荟萃分析出版类型\",)\n 217→        rationale = \"出版类型或题名摘要表明这是综述/荟萃分析，不能替代主要结果报告。\"\n 218→    elif ad_hoc_signals:\n 219→        role = \"ad_hoc_analysis\"\n 220→        signals = (\"事后、亚组或探索性分析用语\",)\n 221→        rationale = \"题名或摘要明确标记事后、亚组或探索性分析。\"\n 222→    elif protocol_signal:\n 223→        role = \"supporting_publication\"\n 224→        signals = (\"目标 NCT\", \"试验方案出版类型或用语\")\n 225→        rationale = \"这是试验方案或设计论文，不得按主要结果报告使用。\"\n 226→    elif randomized_signal and primary_endpoint_signal and result_signal:\n 227→        role = \"primary_report\"\n 228→        signals = (\"目标 NCT\", \"随机/分期试验\", \"主要终点结果\")\n 229→        rationale = \"论文匹配目标 NCT，并报告随机/分期试验的共同主要终点或主要终点结果。\"\n 230→    else:\n 231→        role = \"supporting_publication\"\n 232→        signals = (\"目标 NCT\", \"未满足主要报告判定条件\")\n 233→        rationale = \"论文与目标 NCT 有关，但未同时提供主要报告所需的试验与主要终点信号。\"\n 234→    return ClassifiedPublication(\n 235→        record=record,\n 236→        role=role,\n 237→        matched_nct_ids=matched,\n 238→        classification_signals=signals,\n 239→        rationale_zh=rationale,\n 240→        can_replace_primary_report=role == \"primary_report\",\n 241→    )\n 242→\n 243→\n 244→def classify_pubmed_records(\n 245→    records: tuple[PubMedRecord, ...], *, target_nct_ids: tuple[str, ...]\n 246→) -> tuple[ClassifiedPublication, ...]:\n 247→    normalized_targets = tuple(dict.fromkeys(item.strip().upper() for item in target_nct_ids))\n 248→    if not normalized_targets or any(\n 249→        re.fullmatch(r\"NCT[0-9]{8}\", item) is None for item in normalized_targets\n 250→    ):\n 251→        raise ValueError(\"论文分类需要至少一个有效目标 NCT 号\")\n 252→    target_set = set(normalized_targets)\n 253→    classified: list[ClassifiedPublication] = []\n 254→    for record in records:\n 255→        text = f\"{record.title}\\n{record.abstract}\"\n 256→        mentioned = {item.upper() for item in _NCT_ID.findall(text)}\n 257→        matched = tuple(item for item in normalized_targets if item in mentioned & target_set)\n 258→        classified.append(_classify(record, matched))\n 259→    return tuple(classified)\n 260→\n 261→\n 262→def assess_key_field_coverage(\n 263→    contributions: tuple[EvidenceContribution, ...], *, required_fields: tuple[str, ...]\n 264→) -> KeyFieldCoverage:\n 265→    required = tuple(dict.fromkeys(\" \".join(item.split()) for item in required_fields))\n 266→    if not required or any(not item for item in required):\n 267→        raise ValueError(\"关键字段清单不能为空\")\n 268→    accepted: list[EvidenceContribution] = []\n 269→    rejected: list[RejectedContribution] = []\n 270→    for contribution in contributions:\n 271→        if contribution.field_domain == \"trial_design\" and contribution.source_role not in {\n 272→            \"clinical_trial_registry\",\n 273→            \"regulatory_material\",\n 274→        }:\n 275→            rejected.append(\n 276→                RejectedContribution(\n 277→                    contribution=contribution,\n 278→                    rationale_zh=(\n 279→                        \"论文及其补充材料可用于结果交叉核验，但不能替代登记平台或监管材料中的方案字段。\"\n 280→                    ),\n 281→                )\n 282→            )\n 283→            continue\n 284→        accepted.append(contribution)\n 285→    covered = {item.field_id for item in accepted}\n 286→    missing = tuple(item for item in required if item not in covered)\n 287→    if missing:\n 288→        state: Literal[\"not_required\", \"required\"] = \"required\"\n 289→        rationale = \"现有主要来源尚未覆盖全部关键字段，需要继续寻找适用材料。\"\n 290→    else:\n 291→        state = \"not_required\"\n 292→        rationale = \"登记结果、主要论文或监管材料已覆盖关键疗效、安全性和方案字段。\"\n 293→    return KeyFieldCoverage(\n 294→        accepted_contributions=tuple(accepted),\n 295→        rejected_contributions=tuple(rejected),\n 296→        missing_fields=missing,\n 297→        supplement_state=state,\n 298→        rationale_zh=rationale,\n 299→    )\n 300→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a08f74c0e77b339467e8764f913e8f","_messageId":"01a08f74c7037ba8ba2ec47a6fddb464","_meta":{"codebuddy.ai/conversationRequestId":"01a08f74c0e77b339467e8764f913e8f","codebuddy.ai/modelRequestId":"01a08f74c7037ba8ba2ec47a6fddb464","codebuddy.ai/llmMessageId":"01a08f74c7037ba8ba2ec47a6fddb464","traceparent":"00-ad7bdc66d5296f999aa4edc599e201ac-2aad9b60b4e08bab-01","baggage":"codebuddy.session_id=01a08f74-c077-7bd3-8de8-2cfab5bccb52,codebuddy.conversation_request_id=01a08f74c0e77b339467e8764f913e8f"},"__timestamp":"2026-09-11T07:53:12.878Z"}
