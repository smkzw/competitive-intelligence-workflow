{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -c 'nl -ba tests/browser/test_b_semantic_proposals.py'","aggregated_output":"     1\t\"\"\"Synthetic bound proposals exercised through real B HTML and browser charts.\"\"\"\n     2\t\n     3\timport json\n     4\tfrom pathlib import Path\n     5\t\n     6\timport pytest\n     7\tfrom playwright.sync_api import sync_playwright\n     8\t\n     9\tfrom ci_workflow.renderers.portal.report_b import (\n    10\t    ReportBPortalData,\n    11\t    _display_trial_name,\n    12\t    _efficacy_records,\n    13\t    render_report_b_site,\n    14\t)\n    15\tfrom tests.reports.b.test_semantic_grouping_proposals import _proposal\n    16\t\n    17\t\n    18\tdef proposal_data() -> ReportBPortalData:\n    19\t    root = Path(__file__).resolve().parents[2]\n    20\t    payload = json.loads(\n    21\t        (root / \"fixtures/synthetic/a-complete/inputs/report-data.json\").read_bytes(),\n    22\t    )\n    23\t    facts = []\n    24\t    for index, trial in enumerate(payload[\"trials\"][:2]):\n    25\t        facts.append({\n    26\t            \"row_id\": f\"proposal-observation-{index}\", \"product_id\": trial[\"product_id\"],\n    27\t            \"trial_id\": trial[\"id\"], \"original_endpoint\": \"EASI-75\",\n    28\t            \"original_definition\": \"EASI改善至少75%的比例\" if index else \"EASI-75应答者比例\",\n    29\t            \"actual_timepoint\": 48 + index * 2, \"actual_timepoint_unit\": \"week\",\n    30\t            \"analysis_form\": \"response_rate\", \"analysis_population\": \"FAS\",\n    31\t            \"arm_label\": \"active\", \"unit\": \"%\", \"value\": 60 + index,\n    32\t            \"direction\": \"higher_is_better\", \"estimand\": \"treatment_policy\",\n    33\t            \"denominator_semantics\": \"full_analysis_set\", \"instrument_or_scale\": \"EASI v1.0\",\n    34\t            \"source_version_id\": f\"synthetic-source-{index}\",\n    35\t        })\n    36\t    payload[\"efficacy_views\"] = {\"facts\": facts}\n    37\t    data = ReportBPortalData.model_validate(payload)\n    38\t    names = {product.id: product.name for product in data.products}\n    39\t    trials = {\n    40\t        trial.id: _display_trial_name(trial, names[trial.product_id]) for trial in data.trials\n    41\t    }\n    42\t    records = _efficacy_records(data, names, trials)\n    43\t    payload[\"semantic_proposals\"] = [\n    44\t        _proposal(records[0][0], records[1][0]).model_dump(mode=\"json\")\n    45\t    ]\n    46\t    return ReportBPortalData.model_validate(payload)\n    47\t\n    48\t\n    49\t@pytest.mark.parametrize(\"engine\", [\"chromium\", \"webkit\"])\n    50\tdef test_dossier_uses_global_scientific_partition(tmp_path: Path, engine: str) -> None:\n    51\t    payload = proposal_data().model_dump(mode=\"json\")\n    52\t    second = payload[\"efficacy_views\"][\"facts\"][1]\n    53\t    third_trial = dict(payload[\"trials\"][1], id=\"synthetic-third-trial\")\n    54\t    payload[\"trials\"].append(third_trial)\n    55\t    payload[\"efficacy_views\"][\"facts\"].append(dict(\n    56\t        second, row_id=\"proposal-observation-2\", trial_id=third_trial[\"id\"],\n    57\t        actual_timepoint=52, original_definition=\"第三种结果定义措辞\",\n    58\t    ))\n    59\t    payload[\"semantic_proposals\"] = []\n    60\t    data = ReportBPortalData.model_validate(payload)\n    61\t    names = {product.id: product.name for product in data.products}\n    62\t    trials = {trial.id: _display_trial_name(trial, names[trial.product_id])\n    63\t              for trial in data.trials}\n    64\t    rows = _efficacy_records(data, names, trials)\n    65\t    payload[\"semantic_proposals\"] = [\n    66\t        _proposal(rows[0][0], rows[1][0]).model_dump(mode=\"json\"),\n    67\t        _proposal(rows[1][0], rows[2][0]).model_dump(mode=\"json\"),\n    68\t    ]\n    69\t    site = tmp_path / \"html\"\n    70\t    render_report_b_site(ReportBPortalData.model_validate(payload), site)\n    71\t    with sync_playwright() as playwright:\n    72\t        browser = getattr(playwright, engine).launch()\n    73\t        page = browser.new_page()\n    74\t        page.goto((site / \"efficacy.html\").as_uri())\n    75\t        full = page.evaluate(\"window.__CHART_GROUPS__\")\n    76\t        expected = {row[\"row_id\"]: group[\"scientific_group_id\"]\n    77\t                    for group in full for row in group[\"rows\"]}\n    78\t        page.goto((site / \"products\" / f'{second[\"product_id\"]}.html').as_uri())\n    79\t        detail = page.evaluate(\"window.__CHART_GROUPS__\")\n    80\t        selected = {row[\"row_id\"]: group[\"scientific_group_id\"]\n    81\t                    for group in detail for row in group[\"rows\"] if row[\"row_id\"] in expected}\n    82\t        assert selected == {key: expected[key] for key in\n    83\t                            (\"proposal-observation-1\", \"proposal-observation-2\")}\n    84\t        assert len(set(selected.values())) == 2\n    85\t        browser.close()\n    86\t\n    87\t\n    88\t@pytest.fixture(scope=\"module\")\n    89\tdef proposal_site(tmp_path_factory: pytest.TempPathFactory) -> Path:\n    90\t    site = tmp_path_factory.mktemp(\"b-semantic-proposal\") / \"html\"\n    91\t    render_report_b_site(proposal_data(), site)\n    92\t    return site\n    93\t\n    94\t\n    95\t@pytest.mark.parametrize(\"engine\", [\"chromium\", \"webkit\"])\n    96\tdef test_full_longitudinal_page_preserves_within_trial_time_series(\n    97\t    tmp_path: Path, engine: str,\n    98\t) -> None:\n    99\t    payload = proposal_data().model_dump(mode=\"json\")\n   100\t    payload[\"semantic_proposals\"] = []\n   101\t    first = dict(payload[\"efficacy_views\"][\"facts\"][0], actual_timepoint=12,\n   102\t                 group_id=\"active-arm\")\n   103\t    payload[\"efficacy_views\"][\"facts\"] = [\n   104\t        first, dict(first, row_id=\"longitudinal-24\", actual_timepoint=24, value=75),\n   105\t    ]\n   106\t    site = tmp_path / \"html\"\n   107\t    render_report_b_site(ReportBPortalData.model_validate(payload), site)\n   108\t    with sync_playwright() as playwright:\n   109\t        browser = getattr(playwright, engine).launch()\n   110\t        page = browser.new_page()\n   111\t        page.goto((site / \"longitudinal-results.html\").as_uri())\n   112\t        groups = page.evaluate(\"window.__CHART_GROUPS__\")\n   113\t        assert len(groups) == 1\n   114\t        assert {row[\"actual_timepoint\"] for row in groups[0][\"rows\"]} == {12, 24}\n   115\t        assert {row[\"_chart_type\"] for row in groups[0][\"rows\"]} == {\"line\"}\n   116\t        assert groups[0][\"cross_trial\"] is False\n   117\t        browser.close()\n   118\t\n   119\t\n   120\t@pytest.mark.parametrize(\"engine\", [\"chromium\", \"webkit\"])\n   121\t@pytest.mark.parametrize(\"width\", [1440, 768, 390, 320])\n   122\tdef test_html_consumes_bound_groups_and_keeps_raw_observations(\n   123\t    proposal_site: Path, tmp_path: Path, engine: str, width: int,\n   124\t) -> None:\n   125\t    with sync_playwright() as playwright:\n   126\t        browser = getattr(playwright, engine).launch()\n   127\t        page = browser.new_page(viewport={\"width\": width, \"height\": 900})\n   128\t        page.goto((proposal_site / \"efficacy.html\").as_uri())\n   129\t        page.wait_for_function(\"window.__CHART_GROUPS__ && window.echarts\")\n   130\t        groups = page.evaluate(\"window.__CHART_GROUPS__\")\n   131\t        assert len(groups) == 1\n   132\t        assert groups[0][\"cross_trial\"] is True\n   133\t        assert {row[\"value\"] for row in groups[0][\"rows\"]} == {60, 61}\n   134\t        assert {row[\"actual_timepoint\"] for row in groups[0][\"rows\"]} == {48, 50}\n   135\t        chart_text = page.locator(\"#kz-chart-module\").inner_text()\n   136\t        assert \"实际观察时间：\" in chart_text and \"48 周\" in chart_text and \"50 周\" in chart_text\n   137\t        assert \"安澜双抗\" in chart_text and \"泰瑞奇单抗\" in chart_text\n   138\t        table_rows = page.locator('#kz-chart-module tr[data-row-id]')\n   139\t        assert table_rows.count() == 2\n   140\t        assert not table_rows.first.is_visible()\n   141\t        page.get_by_text(\"展开完整数据表\", exact=True).click()\n   142\t        assert table_rows.first.is_visible()\n   143\t        assert {row[\"row_id\"] for row in groups[0][\"rows\"]} == set(\n   144\t            table_rows.evaluate_all(\"rows => rows.map(row => row.dataset.rowId)\"),\n   145\t        )\n   146\t        assert page.evaluate(\"document.documentElement.scrollWidth <= innerWidth\")\n   147\t        assert \"synthetic-model\" not in page.locator(\"body\").inner_text()\n   148\t        page.locator(\"#kz-chart-module\").screenshot(\n   149\t            path=str(tmp_path / f\"group-{engine}-{width}.png\"),\n   150\t        )\n   151\t        browser.close()\n   152\t\n   153\t\n   154\t@pytest.fixture(scope=\"module\")\n   155\tdef dense_site(tmp_path_factory: pytest.TempPathFactory) -> Path:\n   156\t    payload = proposal_data().model_dump(mode=\"json\")\n   157\t    payload.pop(\"semantic_proposals\")\n   158\t    template_trial = payload[\"trials\"][0]\n   159\t    template_fact = payload[\"efficacy_views\"][\"facts\"][0]\n   160\t    trials, facts = [], []\n   161\t    for index in range(8):\n   162\t        trial_id = f\"dense-trial-{index}\"\n   163\t        trials.append(dict(template_trial, id=trial_id, name=f\"合成研究{index + 1:02}\",\n   164\t                           display_id=f\"合成研究{index + 1:02}\"))\n   165\t        facts.append(dict(template_fact, row_id=f\"dense-fact-{index}\", trial_id=trial_id))\n   166\t    payload[\"trials\"] = [*payload[\"trials\"], *trials]\n   167\t    payload[\"efficacy_views\"] = {\"facts\": facts}\n   168\t    site = tmp_path_factory.mktemp(\"b-dense-categories\") / \"html\"\n   169\t    render_report_b_site(ReportBPortalData.model_validate(payload), site)\n   170\t    return site\n   171\t\n   172\t\n   173\t@pytest.mark.parametrize(\"engine\", [\"chromium\", \"webkit\"])\n   174\tdef test_all_categories_remain_keyboard_scrollable_after_resize(\n   175\t    dense_site: Path, engine: str,\n   176\t) -> None:\n   177\t    with sync_playwright() as playwright:\n   178\t        browser = getattr(playwright, engine).launch()\n   179\t        page = browser.new_page(viewport={\"width\": 1440, \"height\": 900})\n   180\t        page.goto((dense_site / \"efficacy.html\").as_uri())\n   181\t        page.set_viewport_size({\"width\": 320, \"height\": 900})\n   182\t        viewport = page.locator('[aria-label=\"完整图形，较宽时可左右滚动\"]').first\n   183\t        viewport.scroll_into_view_if_needed()\n   184\t        page.wait_for_function(\n   185\t            \"document.querySelector('[data-chart-type=bar]').parentElement.tabIndex === 0\",\n   186\t        )\n   187\t        assert page.evaluate(\"document.documentElement.scrollWidth <= innerWidth\")\n   188\t        assert viewport.evaluate(\"node => node.scrollWidth > node.clientWidth\")\n   189\t        categories = page.evaluate(\"\"\"() => {\n   190\t          const node = document.querySelector('[data-chart-type=bar]');\n   191\t          return window.echarts.getInstanceByDom(node).getOption().xAxis[0].data;\n   192\t        }\"\"\")\n   193\t        assert len(categories) == 8\n   194\t        viewport.focus()\n   195\t        page.keyboard.press(\"ArrowRight\")\n   196\t        page.wait_for_function(\n   197\t            \"document.querySelector('[data-chart-type=bar]').parentElement.scrollLeft > 0\",\n   198\t        )\n   199\t        browser.close()\n","exit_code":0,"status":"completed"}}
