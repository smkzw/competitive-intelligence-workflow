{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -c \"nl -ba src/ci_workflow/reports/b/semantic_contract.py | sed -n '1,285p'\"","aggregated_output":"     1\t\"\"\"Deterministic clinical-construct compatibility and B bubble presets.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport math\n     6\tfrom collections.abc import Mapping, Sequence\n     7\tfrom enum import StrEnum\n     8\tfrom typing import Any, Literal, Self\n     9\t\n    10\tfrom pydantic import AliasChoices, BaseModel, ConfigDict, Field, field_validator, model_validator\n    11\t\n    12\t\n    13\tclass ClinicalSemanticError(ValueError):\n    14\t    \"\"\"Clinical observations cannot be safely grouped or rendered.\"\"\"\n    15\t\n    16\t\n    17\tclass SemanticDirection(StrEnum):\n    18\t    HIGHER_IS_BETTER = \"higher_is_better\"\n    19\t    LOWER_IS_BETTER = \"lower_is_better\"\n    20\t    NEUTRAL = \"neutral\"\n    21\t    HIGHER_IS_MORE_SEVERE = \"higher_is_more_severe\"\n    22\t    LOWER_IS_MORE_SEVERE = \"lower_is_more_severe\"\n    23\t\n    24\t\n    25\tclass TimeUnit(StrEnum):\n    26\t    DAY = \"day\"\n    27\t    WEEK = \"week\"\n    28\t    MONTH = \"month\"\n    29\t    YEAR = \"year\"\n    30\t\n    31\t\n    32\tclass ClinicalConstructObservation(BaseModel):\n    33\t    \"\"\"All axes required before two B observations may share a frame.\"\"\"\n    34\t\n    35\t    model_config = ConfigDict(extra=\"forbid\", frozen=True, populate_by_name=True)\n    36\t\n    37\t    schema_version: Literal[\"1.3\"] = \"1.3\"\n    38\t    observation_id: str\n    39\t    clinical_construct: str = Field(\n    40\t        validation_alias=AliasChoices(\"clinical_construct\", \"construct_id\")\n    41\t    )\n    42\t    definition: str = Field(\n    43\t        validation_alias=AliasChoices(\"definition\", \"construct_definition\", \"original_definition\")\n    44\t    )\n    45\t    direction: str\n    46\t    unit: str\n    47\t    estimand: str\n    48\t    denominator: str = Field(validation_alias=AliasChoices(\"denominator\", \"denominator_role\"))\n    49\t    analysis_set: str = Field(\n    50\t        validation_alias=AliasChoices(\"analysis_set\", \"analysis_population\", \"population_context\")\n    51\t    )\n    52\t    analysis_form: str = Field(\n    53\t        validation_alias=AliasChoices(\"analysis_form\", \"statistical_form_family\", \"statistic_form\")\n    54\t    )\n    55\t    instrument_or_scale: str = Field(\n    56\t        default=\"not_reported\",\n    57\t        validation_alias=AliasChoices(\n    58\t            \"instrument_or_scale\", \"instrument\", \"scale\", \"scale_version\"\n    59\t        ),\n    60\t    )\n    61\t    actual_timepoint: float\n    62\t    actual_timepoint_unit: TimeUnit = Field(\n    63\t        validation_alias=AliasChoices(\"actual_timepoint_unit\", \"time_unit\")\n    64\t    )\n    65\t\n    66\t    @field_validator(\n    67\t        \"observation_id\",\n    68\t        \"clinical_construct\",\n    69\t        \"definition\",\n    70\t        \"direction\",\n    71\t        \"unit\",\n    72\t        \"estimand\",\n    73\t        \"denominator\",\n    74\t        \"analysis_set\",\n    75\t        \"analysis_form\",\n    76\t        \"instrument_or_scale\",\n    77\t    )\n    78\t    @classmethod\n    79\t    def _text_fields(cls, value: str, info: Any) -> str:\n    80\t        normalized = \" \".join(value.split())\n    81\t        if not normalized:\n    82\t            raise ValueError(f\"{info.field_name}不能为空\")\n    83\t        return normalized\n    84\t\n    85\t    @field_validator(\"actual_timepoint\")\n    86\t    @classmethod\n    87\t    def _timepoint(cls, value: float) -> float:\n    88\t        if isinstance(value, bool) or not math.isfinite(value) or value < 0:\n    89\t            raise ValueError(\"实际时间点必须是非负有限数值\")\n    90\t        return value\n    91\t\n    92\t    @property\n    93\t    def construct_id(self) -> str:\n    94\t        return self.clinical_construct\n    95\t\n    96\t    @property\n    97\t    def timepoint_weeks(self) -> float:\n    98\t        return {\n    99\t            TimeUnit.DAY: self.actual_timepoint / 7.0,\n   100\t            TimeUnit.WEEK: self.actual_timepoint,\n   101\t            TimeUnit.MONTH: self.actual_timepoint * 4.34524,\n   102\t            TimeUnit.YEAR: self.actual_timepoint * 52.1429,\n   103\t        }[self.actual_timepoint_unit]\n   104\t\n   105\t\n   106\tclass SemanticAdjudicationReceipt(BaseModel):\n   107\t    \"\"\"Model-assisted wording decision; deterministic clinical guards still veto.\"\"\"\n   108\t\n   109\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n   110\t\n   111\t    schema_version: Literal[\"1.3\"] = \"1.3\"\n   112\t    adjudication_id: str\n   113\t    observation_ids: tuple[str, str]\n   114\t    decision: Literal[\"compatible\", \"incompatible\"]\n   115\t    model_id: str\n   116\t    independent_review_id: str\n   117\t    independent_context: str\n   118\t    rationale_zh: str\n   119\t\n   120\t    @field_validator(\n   121\t        \"adjudication_id\",\n   122\t        \"model_id\",\n   123\t        \"independent_review_id\",\n   124\t        \"independent_context\",\n   125\t        \"rationale_zh\",\n   126\t    )\n   127\t    @classmethod\n   128\t    def _required_text(cls, value: str, info: Any) -> str:\n   129\t        normalized = \" \".join(value.split())\n   130\t        if not normalized:\n   131\t            raise ValueError(f\"{info.field_name}不能为空\")\n   132\t        return normalized\n   133\t\n   134\t    @field_validator(\"observation_ids\")\n   135\t    @classmethod\n   136\t    def _pair_is_unique(cls, values: tuple[str, str]) -> tuple[str, str]:\n   137\t        normalized = tuple(\" \".join(value.split()) for value in values)\n   138\t        if any(not value for value in normalized) or len(set(normalized)) != 2:\n   139\t            raise ValueError(\"语义裁决必须绑定两个不同观察\")\n   140\t        return normalized  # type: ignore[return-value]\n   141\t\n   142\t    @model_validator(mode=\"after\")\n   143\t    def _review_is_independent(self) -> Self:\n   144\t        if self.model_id == self.independent_review_id:\n   145\t            raise ValueError(\"模型语义裁决与独立复核不得使用同一身份\")\n   146\t        if not any(\"\\u4e00\" <= char <= \"\\u9fff\" for char in self.rationale_zh):\n   147\t            raise ValueError(\"语义裁决理由必须是用户可读中文\")\n   148\t        return self\n   149\t\n   150\t\n   151\tclass SemanticCompatibility(BaseModel):\n   152\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n   153\t\n   154\t    compatible: bool\n   155\t    reasons: tuple[str, ...] = ()\n   156\t    time_window_note_zh: str | None = None\n   157\t\n   158\t    @model_validator(mode=\"after\")\n   159\t    def _result_has_reasons(self) -> Self:\n   160\t        if self.compatible and self.reasons:\n   161\t            raise ValueError(\"兼容观察不能带冲突原因\")\n   162\t        if not self.compatible and not self.reasons:\n   163\t            raise ValueError(\"不兼容观察必须记录冲突原因\")\n   164\t        return self\n   165\t\n   166\t\n   167\tdef _normalized(value: str) -> str:\n   168\t    return \" \".join(value.split()).casefold()\n   169\t\n   170\t\n   171\tdef semantic_value_is_unknown(value: object) -> bool:\n   172\t    \"\"\"Missing markers are absence of knowledge, never an equivalence class.\"\"\"\n   173\t    if not isinstance(value, str) or not value.strip():\n   174\t        return True\n   175\t    normalized = \"-\".join(value.casefold().replace(\"_\", \"-\").split())\n   176\t    return normalized in {\n   177\t        \"unknown\", \"not-reported\", \"not-publicly-disclosed\", \"not-specified\",\n   178\t        \"unspecified\", \"missing\", \"null\", \"none\", \"n/a\", \"na\", \"-\", \"—\",\n   179\t        \"未报告\", \"未披露\", \"未公开\", \"未注明\", \"未提供\", \"未知\", \"不详\",\n   180\t    } or normalized.endswith((\"-not-reported\", \":unknown\"))\n   181\t\n   182\t\n   183\tdef compare_clinical_constructs(\n   184\t    left: ClinicalConstructObservation | Mapping[str, Any],\n   185\t    right: ClinicalConstructObservation | Mapping[str, Any],\n   186\t    *,\n   187\t    adjudication: SemanticAdjudicationReceipt | Mapping[str, Any] | None = None,\n   188\t) -> SemanticCompatibility:\n   189\t    \"\"\"Apply model-assisted wording equivalence behind deterministic vetoes.\"\"\"\n   190\t\n   191\t    first = (\n   192\t        left\n   193\t        if isinstance(left, ClinicalConstructObservation)\n   194\t        else ClinicalConstructObservation.model_validate(left)\n   195\t    )\n   196\t    second = (\n   197\t        right\n   198\t        if isinstance(right, ClinicalConstructObservation)\n   199\t        else ClinicalConstructObservation.model_validate(right)\n   200\t    )\n   201\t    receipt = (\n   202\t        None\n   203\t        if adjudication is None\n   204\t        else adjudication\n   205\t        if isinstance(adjudication, SemanticAdjudicationReceipt)\n   206\t        else SemanticAdjudicationReceipt.model_validate(adjudication)\n   207\t    )\n   208\t    if receipt is not None and set(receipt.observation_ids) != {\n   209\t        first.observation_id,\n   210\t        second.observation_id,\n   211\t    }:\n   212\t        raise ClinicalSemanticError(\"模型语义裁决未绑定当前观察对\")\n   213\t    hard_axes = (\n   214\t        (\"方向不一致\", first.direction, second.direction),\n   215\t        (\"单位不一致\", first.unit, second.unit),\n   216\t        (\"估计目标不一致\", first.estimand, second.estimand),\n   217\t        (\"分母口径不一致\", first.denominator, second.denominator),\n   218\t        (\"分析集不一致\", first.analysis_set, second.analysis_set),\n   219\t        (\"分析形式不一致\", first.analysis_form, second.analysis_form),\n   220\t        (\"量表或工具不一致\", first.instrument_or_scale, second.instrument_or_scale),\n   221\t    )\n   222\t    reasons = tuple(\n   223\t        label\n   224\t        for label, left_value, right_value in hard_axes\n   225\t        if _normalized(left_value) != _normalized(right_value)\n   226\t    )\n   227\t    required_axes = (\n   228\t        (\"临床构念\", first.clinical_construct, second.clinical_construct),\n   229\t        (\"临床定义\", first.definition, second.definition),\n   230\t        *((label.removesuffix(\"不一致\"), left_value, right_value)\n   231\t          for label, left_value, right_value in hard_axes),\n   232\t    )\n   233\t    reasons += tuple(\n   234\t        f\"{label}未明确，不能据此认定临床可比\"\n   235\t        for label, left_value, right_value in required_axes\n   236\t        if semantic_value_is_unknown(left_value) or semantic_value_is_unknown(right_value)\n   237\t    )\n   238\t    wording_differs = (\n   239\t        _normalized(first.clinical_construct) != _normalized(second.clinical_construct)\n   240\t        or _normalized(first.definition) != _normalized(second.definition)\n   241\t    )\n   242\t    if wording_differs and receipt is None:\n   243\t        reasons += (\"临床构念或定义不一致且缺少模型语义裁决\",)\n   244\t    elif receipt is not None and receipt.decision == \"incompatible\":\n   245\t        reasons += (\"模型语义裁决为不兼容\",)\n   246\t    delta = abs(first.timepoint_weeks - second.timepoint_weeks)\n   247\t    note: str | None = None\n   248\t    if delta > 2.0:\n   249\t        reasons += (\"观察窗差异超过近窗口范围\",)\n   250\t    elif delta > 0:\n   251\t        note = (\n   252\t            f\"实际观察窗为{first.timepoint_weeks:g}周与{second.timepoint_weeks:g}周；\"\n   253\t            \"同框仅表示临床构念兼容，不代表时间点相同\"\n   254\t        )\n   255\t    return SemanticCompatibility(\n   256\t        compatible=not reasons,\n   257\t        reasons=reasons,\n   258\t        time_window_note_zh=note,\n   259\t    )\n   260\t\n   261\t\n   262\tdef assert_clinical_construct_compatible(\n   263\t    observations: Sequence[ClinicalConstructObservation | Mapping[str, Any]],\n   264\t) -> tuple[ClinicalConstructObservation, ...]:\n   265\t    \"\"\"Validate a proposed frame and raise on any incompatible pair.\"\"\"\n   266\t\n   267\t    validated = tuple(\n   268\t        observation\n   269\t        if isinstance(observation, ClinicalConstructObservation)\n   270\t        else ClinicalConstructObservation.model_validate(observation)\n   271\t        for observation in observations\n   272\t    )\n   273\t    for index, first in enumerate(validated):\n   274\t        for second in validated[index + 1 :]:\n   275\t            result = compare_clinical_constructs(first, second)\n   276\t            if not result.compatible:\n   277\t                raise ClinicalSemanticError(\n   278\t                    f\"临床构念不得共框：{first.observation_id}/{second.observation_id}；\"\n   279\t                    + \"、\".join(result.reasons)\n   280\t                )\n   281\t    return validated\n   282\t\n   283\t\n   284\tBubbleMetric = Literal[\n   285\t    \"efficacy_signal\",\n","exit_code":0,"status":"completed"}}
