\t            records.append(\n  2253\t                (\n  2254\t                    _project_record(\n  2255\t                        source,\n  2256\t                        domain=domain,\n  2257\t                        names=names,\n  2258\t                        trial_names=trial_names,\n  2259\t                        fallback=row_id,\n  2260\t                    ),\n  2261\t                    source,\n  2262\t                )\n  2263\t            )\n  2264\t    return tuple(records)\n  2265\t\n  2266\t\n  2267\tdef _domain_empty_records(\n  2268\t    data: ReportBPortalData,\n  2269\t    *,\n  2270\t    page_id: str,\n  2271\t    names: Mapping[str, str],\n  2272\t    trial_names: Mapping[str, str],\n  2273\t    domain: str,\n  2274\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2275\t    records: list[tuple[dict[str, Any], Any]] = []\n  2276\t    for trial in data.trials:\n  2277\t        row_id = f\"{page_id}-{trial.id}-empty\"\n  2278\t        label_key = \"variable_label_zh\" if domain == \"baseline\" else \"field_label_zh\"\n  2279\t        source: dict[str, Any] = {\n  2280\t            \"row_id\": row_id,\n  2281\t            \"product_id\": trial.product_id,\n  2282\t            \"trial_id\": trial.id,\n  2283\t            label_key: \"暂无公开记录\",\n  2284\t            \"disclosure_state\": \"not_reported\",\n  2285\t            \"_empty_state\": True,\n  2286\t        }\n  2287\t        row = _project_record(\n  2288\t            source,\n  2289\t            domain=domain,\n  2290\t            names=names,\n  2291\t            trial_names=trial_names,\n  2292\t            fallback=row_id,\n  2293\t        )\n  2294\t        row[\"_empty_state\"] = True\n  2295\t        row[\"status\"] = \"暂无公开记录\"\n  2296\t        records.append((row, source))\n  2297\t    return tuple(records)\n  2298\t\n  2299\t\n  2300\tdef _trial_context_records(\n  2301\t    data: ReportBPortalData,\n  2302\t    names: Mapping[str, str],\n  2303\t    trial_names: Mapping[str, str],\n  2304\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2305\t    records: list[tuple[dict[str, Any], Any]] = []\n  2306\t    for trial in data.trials:\n  2307\t        row_id = f\"trial-context-{trial.id}\"\n  2308\t        source = {\n  2309\t            \"row_id\": row_id,\n  2310\t            \"product_id\": trial.product_id,\n  2311\t            \"trial_id\": trial.id,\n  2312\t            \"display_label_zh\": f\"{trial_names.get(trial.id, trial.name)}样本量\",\n  2313\t            \"value\": trial.sample_size,\n  2314\t            \"unit\": \"人\",\n  2315\t            \"disclosure_state\": \"reported_value\",\n  2316\t            \"status\": trial.status,\n  2317\t            \"role\": trial.role,\n  2318\t            \"phase\": trial.phase,\n  2319\t            \"sample_size\": trial.sample_size,\n  2320\t            \"treatment_sample_size\": trial.treatment_sample_size,\n  2321\t            \"time\": trial.phase,\n  2322\t        }\n  2323\t        records.append(\n  2324\t            (\n  2325\t                _project_record(\n  2326\t                    source,\n  2327\t                    domain=\"generic\",\n  2328\t                    names=names,\n  2329\t                    trial_names=trial_names,\n  2330\t                    fallback=row_id,\n  2331\t                ),\n  2332\t                source,\n  2333\t            )\n  2334\t        )\n  2335\t    return tuple(records)\n  2336\t\n  2337\t\n  2338\tdef _matrix_records(\n  2339\t    data: ReportBPortalData,\n  2340\t    names: Mapping[str, str],\n  2341\t    trial_names: Mapping[str, str],\n  2342\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2343\t    source = _view_source(data, \"matrix_view\")\n  2344\t    if source is None:\n  2345\t        return ()\n  2346\t    if isinstance(source, Mapping):\n  2347\t        source = _get(source, \"efficacy-safety-matrix\", source)\n  2348\t    values = _flatten_view_rows(\n  2349\t        _collection(source, \"complete_table\", \"comparison_rows\", \"rows\", \"matrix_rows\")\n  2350\t    )\n  2351\t    point_by_id: dict[str, Any] = {}\n  2352\t    for point_source in (source, _get(source, \"chart\", None)):\n  2353\t        for point in _collection(point_source, \"points\", \"bubble_points\"):\n  2354\t            point_id = _text(\n  2355\t                _first(point, \"comparison_row_id\", \"row_id\", \"comparison_id\", default=\"\")\n  2356\t            )\n  2357\t            if point_id:\n  2358\t                point_by_id[point_id] = point\n  2359\t    result: list[tuple[dict[str, Any], Any]] = []\n  2360\t    for index, value in enumerate(values):\n  2361\t        comparison = _get(value, \"comparison_row\", None) or value\n  2362\t        original = _first(\n  2363\t            comparison,\n  2364\t            \"efficacy_treatment\",\n  2365\t            \"efficacy_control\",\n  2366\t            \"safety_treatment\",\n  2367\t            \"safety_control\",\n  2368\t            default=comparison,\n  2369\t        )\n  2370\t        point = _first(value, \"point\", default=None)\n  2371\t        if point is None:\n  2372\t            point = point_by_id.get(_stable_row_id(value, \"\"))\n  2373\t        projected_value = value\n  2374\t        if point is not None and _get(value, \"point\", None) is None:\n  2375\t            projected_value = {\n  2376\t                \"row_id\": _stable_row_id(value, f\"matrix-{index + 1}\"),\n  2377\t                \"product_id\": _product_id(value) or _product_id(comparison),\n  2378\t                \"trial_id\": _trial_id(value) or _trial_id(comparison),\n  2379\t                \"target_id\": _first(comparison, \"target_id\", \"target\", default=\"\"),\n  2380\t                \"display_label_zh\": _label_for(comparison, \"efficacy\"),\n  2381\t                \"difference_labels_zh\": _first(\n  2382\t                    comparison,\n  2383\t                    \"compatibility_difference_labels_zh\",\n  2384\t                    \"difference_labels_zh\",\n  2385\t                    default=(),\n  2386\t                ),\n  2387\t                \"comparison_row\": comparison,\n  2388\t                \"point\": point,\n  2389\t            }\n  2390\t        row = _project_record(\n  2391\t            projected_value,\n  2392\t            domain=\"matrix\",\n  2393\t            names=names,\n  2394\t            trial_names=trial_names,\n  2395\t            fallback=f\"matrix-{index + 1}\",\n  3275\t            }\n  3276\t        )\n  3277\t    return tuple(groups)\n  3278\t\n  3279\t\n  3280\tdef _copy_assets(site_root: Path) -> None:\n  3281\t    assets = site_root / \"assets\"\n  3282\t    assets.mkdir(parents=True, exist_ok=True)\n  3283\t    shutil.copy2(resolve_logo_src(), assets / \"logo.svg\")\n  3284\t    for name in (\n  3285\t        \"portal.css\",\n  3286\t        \"portal.js\",\n  3287\t        \"charts.js\",\n  3288\t        \"evidence-drawer.css\",\n  3289\t        \"evidence-drawer.js\",\n  3290\t    ):\n  3291\t        shutil.copy2(resolve_portal_asset(name), assets / name)\n  3292\t    shutil.copy2(_ASSET_DIR / \"report-b.css\", assets / \"report-b.css\")\n  3293\t    shutil.copy2(_ASSET_DIR / \"report-b.js\", assets / \"report-b.js\")\n  3294\t    shutil.copy2(resolve_echarts_bundle(), assets / \"echarts.min.js\")\n  3295\t\n  3296\t\n  3297\tdef _tag_records(\n  3298\t    values: Sequence[tuple[dict[str, Any], Any]],\n  3299\t    domain: str,\n  3300\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  3301\t    return tuple(({**row, \"_domain\": domain}, source) for row, source in values)\n  3302\t\n  3303\t\n  3304\tdef _page_records(\n  3305\t    data: ReportBPortalData,\n  3306\t    *,\n  3307\t    page_id: str,\n  3308\t    names: Mapping[str, str],\n  3309\t    trial_names: Mapping[str, str],\n  3310\t    efficacy: Sequence[tuple[dict[str, Any], Any]],\n  3311\t    safety: Sequence[tuple[dict[str, Any], Any]],\n  3312\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  3313\t    def tagged(\n  3314\t        values: Sequence[tuple[dict[str, Any], Any]],\n  3315\t        domain: str,\n  3316\t    ) -> list[tuple[dict[str, Any], Any]]:\n  3317\t        result: list[tuple[dict[str, Any], Any]] = []\n  3318\t        for row, source in values:\n  3319\t            copied = dict(row)\n  3320\t            copied[\"_domain\"] = domain\n  3321\t            result.append((copied, source))\n  3322\t        return result\n  3323\t\n  3324\t    if page_id == \"overview\":\n  3325\t        baseline = _page_records(\n  3326\t            data,\n  3327\t            page_id=\"baseline-overview\",\n  3328\t            names=names,\n  3329\t            trial_names=trial_names,\n  3330\t            efficacy=efficacy,\n  3331\t            safety=safety,\n  3332\t        )\n  3333\t        disposition = _page_records(\n  3334\t            data,\n  3335\t            page_id=\"disposition-overview\",\n  3336\t            names=names,\n  3337\t            trial_names=trial_names,\n  3338\t            efficacy=efficacy,\n  3339\t            safety=safety,\n  3340\t        )\n  3341\t        matrix = _matrix_records(data, names, trial_names)\n  3342\t        return _dedupe_records(\n  3343\t            (\n  3344\t                *tagged(efficacy, \"efficacy\"),\n  3345\t                *tagged(safety, \"safety\"),\n  3346\t                *tagged(matrix, \"matrix\"),\n  3347\t                *tagged(baseline, \"baseline\"),\n  3348\t                *tagged(disposition, \"disposition\"),\n  3349\t            )\n  3350\t        )\n  3351\t    if page_id in {\"efficacy\", \"longitudinal-results\"}:\n  3352\t        return tuple(tagged(efficacy, \"efficacy\"))\n  3353\t    if page_id == \"subgroups-supporting-evidence\":\n  3354\t        return _state_rows_from_view(\n  3355\t            data,\n  3356\t            view_name=\"supporting_evidence_views\",\n  3357\t            page_id=page_id,\n  3358\t            names=names,\n  3359\t            trial_names=trial_names,\n  3360\t            domain=\"supporting\",\n  3361\t        )\n  3362\t    if page_id == \"safety\":\n  3363\t        return tuple(tagged(safety, \"safety\"))\n  3364\t    if page_id in _BASELINE_PAGE_IDS:\n  3365\t        values = _state_rows_from_view(\n  3366\t            data,\n  3367\t            view_name=\"baseline_views\",\n  3368\t            page_id=page_id,\n  3369\t            names=names,\n  3370\t            trial_names=trial_names,\n  3371\t            domain=\"baseline\",\n  3372\t        )\n  3373\t        allowed = _BASELINE_PAGE_CONCEPTS.get(page_id)\n  3374\t        if allowed is not None:\n  3375\t            values = tuple(\n  3376\t                item for item in values if _text(item[0].get(\"clinical_concept\")) in allowed\n  3377\t            )\n  3378\t        if values or _view_source(data, \"baseline_views\") is not None:\n  3379\t            return values\n  3380\t        return _domain_empty_records(\n  3381\t            data,\n  3382\t            page_id=page_id,\n  3383\t            names=names,\n  3384\t            trial_names=trial_names,\n  3385\t            domain=\"baseline\",\n  3386\t        )\n  3387\t    if page_id in _DISPOSITION_PAGE_IDS:\n  3388\t        values = _state_rows_from_view(\n  3389\t            data,\n  3390\t            view_name=\"disposition_views\",\n  3391\t            page_id=page_id,\n  3392\t            names=names,\n  3393\t            trial_names=trial_names,\n  3394\t            domain=\"disposition\",\n  3395\t        )\n  3396\t        allowed = _DISPOSITION_PAGE_ELEMENTS[page_id]\n  3397\t        values = tuple(\n  3398\t            item\n  3399\t            for item in values\n  3400\t            if _text(item[0].get(\"element\"), _text(item[0].get(\"display_label_zh\"))) in allowed\n  3401\t        )\n  3402\t        if values or _view_source(data, \"disposition_views\") is not None:\n  3403\t            return values\n  3404\t        return _domain_empty_records(\n  3405\t            data,\n  3406\t            page_id=page_id,\n  3407\t            names=names,\n  3408\t            trial_names=trial_names,\n  3409\t            domain=\"disposition\",\n  3410\t        )\n  3411\t    if page_id == \"efficacy-safety-matrix\":\n  3412\t        values = _matrix_records(data, names, trial_names)\n  3413\t        if values:\n  3414\t            return values\n  3415\t        if _view_source(data, \"matrix_view\") is not None:\n  3416\t            return ()\n  3417\t        return _synthetic_status_records(\n  3418\t            data,\n  3419\t            page_id=page_id,\n  3420\t            names=names,\n  3421\t            trial_names=trial_names,\n  3422\t            domain=\"matrix\",\n  3423\t        )\n  3424\t    if page_id == \"trial-exposure-context\":\n  3425\t        return _trial_context_records(data, names, trial_names)\n  3426\t    if page_id == \"product-trial-profiles\":\n  3427\t        return _synthetic_status_records(\n  3428\t            data,\n  3429\t            page_id=page_id,\n  3430\t            names=names,\n  3431\t            trial_names=trial_names,\n  3432\t            include_products=True,\n  3433\t            domain=\"profile\",\n  3434\t        ) + _synthetic_status_records(\n  3435\t            data,\n  3436\t            page_id=page_id + \"-trial\",\n  3437\t            names=names,\n  3438\t            trial_names=trial_names,\n  3439\t            domain=\"profile\",\n  3440\t        )\n  3441\t    return tuple(efficacy) or tuple(safety)\n  3442\t\n  3443\t\n  3444\tdef _external_source_entries(data: ReportBPortalData) -> tuple[dict[str, str | None], ...]:\n  3445\t    entries: list[dict[str, str | None]] = []\n  3446\t    seen: set[str] = set()\n  3447\t    for source in data.sources:\n  3448\t        label = _text(getattr(source, \"source\", None))\n  3449\t        if not label or label in seen:\n  3450\t            continue\n","exit_code":0,"status":"completed"}}
