{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -c \"nl -ba tests/reports/b/test_r13_semantic_grouping.py | sed -n '1,440p'\"","aggregated_output":"     1\t\"\"\"R13 B 类跨产品/试验语义归一化与图表分组合同。\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\tfrom pathlib import Path\n     6\t\n     7\tfrom ci_workflow.renderers.portal.report_b import (\n     8\t    _efficacy_records,\n     9\t    _filter_dimensions,\n    10\t    _groups_for_page,\n    11\t    _page_records,\n    12\t    _project_record,\n    13\t    _safety_records,\n    14\t    load_report_b_data,\n    15\t)\n    16\t\n    17\tROOT = Path(__file__).resolve().parents[3]\n    18\tPNH_DATA = ROOT / \"fixtures/positive/b-pnh/inputs/report-data.json\"\n    19\t\n    20\t\n    21\tdef _project_efficacy(\n    22\t    row_id: str,\n    23\t    endpoint: str,\n    24\t    *,\n    25\t    statistic: str = \"response_rate\",\n    26\t    timepoint: int | float | str = 24,\n    27\t    time_unit: str = \"week\",\n    28\t) -> dict[str, object]:\n    29\t    return _project_record(\n    30\t        {\n    31\t            \"row_id\": row_id,\n    32\t            \"product_id\": \"product-a\",\n    33\t            \"trial_id\": \"trial-a\",\n    34\t            \"endpoint_family_label_zh\": endpoint,\n    35\t            \"original_endpoint\": endpoint,\n    36\t            \"original_definition\": f\"原始定义：{endpoint}\",\n    37\t            \"actual_timepoint\": timepoint,\n    38\t            \"actual_timepoint_unit\": time_unit,\n    39\t            \"analysis_form\": statistic,\n    40\t            \"analysis_population\": \"FAS\",\n    41\t            \"arm_label\": \"active\",\n    42\t            \"unit\": \"%\",\n    43\t            \"value\": 50,\n    44\t            \"numerator\": 5,\n    45\t            \"denominator\": 10,\n    46\t        },\n    47\t        domain=\"efficacy\",\n    48\t        names={\"product-a\": \"产品甲\"},\n    49\t        trial_names={\"trial-a\": \"试验甲\"},\n    50\t        fallback=row_id,\n    51\t    )\n    52\t\n    53\t\n    54\tdef _project_baseline(\n    55\t    row_id: str,\n    56\t    *,\n    57\t    product_id: str,\n    58\t    trial_id: str,\n    59\t    population: str,\n    60\t    variable: str = \"age\",\n    61\t    value: float = 50,\n    62\t) -> dict[str, object]:\n    63\t    return _project_record(\n    64\t        {\n    65\t            \"row_id\": row_id,\n    66\t            \"product_id\": product_id,\n    67\t            \"trial_id\": trial_id,\n    68\t            \"variable\": variable,\n    69\t            \"source_name\": variable,\n    70\t            \"baseline_timepoint\": \"基线\",\n    71\t            \"statistic_form\": \"mean\",\n    72\t            \"analysis_population\": population,\n    73\t            \"arm_label\": \"active\",\n    74\t            \"unit\": \"岁\" if variable == \"age\" else \"g/dL\",\n    75\t            \"value\": value,\n    76\t        },\n    77\t        domain=\"baseline\",\n    78\t        names={product_id: f\"产品{product_id[-1].upper()}\"},\n    79\t        trial_names={trial_id: f\"试验{trial_id[-1].upper()}\"},\n    80\t        fallback=row_id,\n    81\t    )\n    82\t\n    83\t\n    84\tdef test_controlled_semantics_normalize_aliases_and_preserve_raw_identity() -> None:\n    85\t    row = _project_efficacy(\"row-easi\", \"EASI-75 responder proportion\")\n    86\t\n    87\t    assert row[\"clinical_concept\"] == \"easi75_response\"\n    88\t    assert row[\"clinical_concept_label_zh\"] == \"EASI-75应答\"\n    89\t    assert row[\"time_window_band\"] == \"around_month_6\"\n    90\t    assert row[\"statistical_form_family\"] == \"response_rate\"\n    91\t    assert row[\"population_context\"] == \"full_analysis_set\"\n    92\t    assert row[\"arm_role\"] == \"treatment\"\n    93\t    assert row[\"arm\"] == \"治疗组\"\n    94\t    assert row[\"original_endpoint\"] == \"EASI-75 responder proportion\"\n    95\t    assert row[\"original_definition\"] == \"原始定义：EASI-75 responder proportion\"\n    96\t    assert row[\"actual_timepoint\"] == 24\n    97\t    assert row[\"actual_timepoint_unit\"] == \"week\"\n    98\t\n    99\t\n   100\tdef test_time_units_convert_to_controlled_clinical_bands() -> None:\n   101\t    day_28 = _project_efficacy(\"row-day28\", \"EASI-75\", timepoint=28, time_unit=\"day\")\n   102\t    week_12 = _project_efficacy(\"row-week12\", \"EASI-75\", timepoint=12)\n   103\t    month_6 = _project_efficacy(\"row-month6\", \"EASI-75\", timepoint=6, time_unit=\"month\")\n   104\t    week_prefix = _project_efficacy(\"row-week24-prefix\", \"EASI-75\", timepoint=\"week 24\")\n   105\t    around_week = _project_efficacy(\"row-around-week12\", \"EASI-75\", timepoint=\"around 12 weeks\")\n   106\t\n   107\t    assert day_28[\"time_window_band\"] == \"around_day_28\"\n   108\t    assert week_12[\"time_window_band\"] == \"around_week_12\"\n   109\t    assert month_6[\"time_window_band\"] == \"around_month_6\"\n   110\t    assert week_prefix[\"time_window_band\"] == \"around_month_6\"\n   111\t    assert around_week[\"time_window_band\"] == \"around_week_12\"\n   112\t\n   113\t\n   114\tdef test_safety_keeps_original_event_identity() -> None:\n   115\t    data = load_report_b_data(PNH_DATA)\n   116\t    names = {row.id: row.name for row in data.products}\n   117\t    trial_names = {row.id: row.display_id for row in data.trials}\n   118\t    safety = _safety_records(data, names, trial_names)\n   119\t\n   120\t    assert any(\n   121\t        row[\"original_endpoint\"] == \"任何TEAE\"\n   122\t        for row, _source in safety\n   123\t    )\n   124\t\n   125\t\n   126\tdef test_controlled_semantics_do_not_fuzzy_merge_distinct_concepts() -> None:\n   127\t    rows = [\n   128\t        (_project_efficacy(\"row-easi75\", \"EASI-75\"), None),\n   129\t        (_project_efficacy(\"row-easi90\", \"EASI-90\"), None),\n   130\t        (_project_efficacy(\"row-unknown\", \"EASI-76\"), None),\n   131\t    ]\n   132\t\n   133\t    groups = _groups_for_page(\"efficacy\", rows)\n   134\t\n   135\t    assert len(groups) == 3\n   136\t    assert {row[\"clinical_concept\"] for row, _source in rows} == {\n   137\t        \"easi75_response\",\n   138\t        \"easi90_response\",\n   139\t        \"efficacy:easi76\",\n   140\t    }\n   141\t\n   142\t\n   143\tdef test_statistical_form_and_time_band_remain_separate_axes() -> None:\n   144\t    rows = [\n   145\t        (_project_efficacy(\"row-rate\", \"EASI-75\", statistic=\"response_rate\", timepoint=24), None),\n   146\t        (_project_efficacy(\"row-mean\", \"EASI-75\", statistic=\"mean\", timepoint=24), None),\n   147\t        (_project_efficacy(\"row-week12\", \"EASI-75\", statistic=\"response_rate\", timepoint=12), None),\n   148\t    ]\n   149\t\n   150\t    groups = _groups_for_page(\"efficacy\", rows)\n   151\t\n   152\t    assert len(groups) == 3\n   153\t    assert {group[\"title_zh\"] for group in groups} == {\n   154\t        \"EASI-75应答 · 应答率 · 约6个月 · 全分析集 · 语义信息未完整，按试验列示\",\n   155\t        \"EASI-75应答 · 均值 · 约6个月 · 全分析集 · 语义信息未完整，按试验列示\",\n   156\t        \"EASI-75应答 · 应答率 · 约第12周 · 全分析集 · 语义信息未完整，按试验列示\",\n   157\t    }\n   158\t\n   159\t\n   160\tdef test_breakthrough_hemolysis_is_an_adverse_direction_event_rate() -> None:\n   161\t    row = _project_efficacy(\n   162\t        \"row-breakthrough\",\n   163\t        \"breakthrough_hemolysis\",\n   164\t        statistic=\"response_rate\",\n   165\t        timepoint=24,\n   166\t    )\n   167\t\n   168\t    assert row[\"clinical_concept\"] == \"breakthrough_hemolysis_rate\"\n   169\t    assert row[\"clinical_concept_label_zh\"] == \"突破性溶血\"\n   170\t    assert row[\"statistical_form_family\"] == \"event_rate\"\n   171\t    assert row[\"statistical_form_family_label_zh\"] == \"事件发生率（越低越好）\"\n   172\t\n   173\t\n   174\tdef test_incomplete_fixture_semantics_preserve_trials_and_both_arm_roles_without_merging() -> None:\n   175\t    data = load_report_b_data(PNH_DATA)\n   176\t    names = {row.id: row.name for row in data.products}\n   177\t    trial_names = {row.id: row.display_id for row in data.trials}\n   178\t    efficacy = _efficacy_records(data, names, trial_names)\n   179\t\n   180\t    groups = _groups_for_page(\"efficacy\", efficacy)\n   181\t    # 此历史fixture缺关键比较语义；不向真实输入补造参数来保留旧的跨试验预期。\n   182\t    assert len(groups) == 2\n   183\t    assert all(group[\"cross_trial\"] is False for group in groups)\n   184\t    assert all(group[\"x_axis_label_zh\"] == \"产品｜试验\" for group in groups)\n   185\t    assert {row[\"trial_id\"] for row, _source in efficacy} == {\n   186\t        \"nct04558918\",\n   187\t        \"nct04820530\",\n   188\t    }\n   189\t    assert {row[\"arm_role\"] for row, _source in efficacy} == {\"treatment\", \"control\"}\n   190\t    assert {row[\"clinical_concept\"] for row, _source in efficacy} == {\n   191\t        \"hemoglobin_response_without_transfusion\"\n   192\t    }\n   193\t    assert {row[\"_chart_identity_key\"] for group in groups for row in group[\"rows\"]} == {\n   194\t        \"iptacopan::nct04558918\",\n   195\t        \"iptacopan::nct04820530\",\n   196\t    }\n   197\t    assert {row[\"_chart_series_key\"] for group in groups for row in group[\"rows\"]} == {\n   198\t        \"treatment\",\n   199\t        \"control\",\n   200\t    }\n   201\t\n   202\t\n   203\tdef test_duplicate_same_role_arms_keep_distinct_human_labels() -> None:\n   204\t    high = _project_efficacy(\"row-high\", \"EASI-75\")\n   205\t    low = _project_efficacy(\"row-low\", \"EASI-75\")\n   206\t    high[\"group_id\"] = \"treatment-high\"\n   207\t    high[\"arm_detail\"] = \"高剂量\"\n   208\t    low[\"group_id\"] = \"treatment-low\"\n   209\t    low[\"arm_detail\"] = \"低剂量\"\n   210\t\n   211\t    groups = _groups_for_page(\n   212\t        \"efficacy\",\n   213\t        [(high, None), (low, None)],\n   214\t    )\n   215\t\n   216\t    assert len(groups) == 1\n   217\t    assert {row[\"_chart_series_key\"] for row in groups[0][\"rows\"]} == {\n   218\t        \"treatment:treatmenthigh\",\n   219\t        \"treatment:treatmentlow\",\n   220\t    }\n   221\t    assert {row[\"_chart_series_label\"] for row in groups[0][\"rows\"]} == {\n   222\t        \"治疗组（高剂量）\",\n   223\t        \"治疗组（低剂量）\",\n   224\t    }\n   225\t\n   226\t\n   227\tdef test_unknown_semantics_keep_trials_in_adjacent_descriptive_groups() -> None:\n   228\t    first = _project_efficacy(\"first\", \"EASI-75\")\n   229\t    second = dict(first, row_id=\"second\", trial_id=\"trial-b\")\n   230\t    groups = _groups_for_page(\"efficacy\", [(first, None), (second, None)])\n   231\t    assert len(groups) == 2\n   232\t    assert all(group[\"cross_trial\"] is False for group in groups)\n   233\t    assert all(\"语义信息未完整\" in group[\"title_zh\"] for group in groups)\n   234\t    assert {row[\"row_id\"] for group in groups for row in group[\"rows\"]} == {\n   235\t        \"first\", \"second\",\n   236\t    }\n   237\t\n   238\t\n   239\tdef test_complete_known_semantics_still_allow_cross_trial_group() -> None:\n   240\t    first = _project_efficacy(\"first\", \"EASI-75\")\n   241\t    first.update(\n   242\t        semantic_direction=\"higher_is_better\",\n   243\t        semantic_estimand=\"treatment_policy\",\n   244\t        semantic_denominator=\"full_analysis_set\",\n   245\t        semantic_instrument_or_scale=\"EASI v1.0\",\n   246\t    )\n   247\t    second = dict(first, row_id=\"second\", trial_id=\"trial-b\")\n   248\t    groups = _groups_for_page(\"efficacy\", [(first, None), (second, None)])\n   249\t    assert len(groups) == 1\n   250\t    assert groups[0][\"cross_trial\"] is True\n   251\t\n   252\t\n   253\tdef test_longitudinal_group_uses_one_series_across_time_bands() -> None:\n   254\t    first = _project_efficacy(\"row-week24\", \"EASI-75\", timepoint=24)\n   255\t    second = _project_efficacy(\"row-week12\", \"EASI-75\", timepoint=12)\n   256\t    first[\"group_id\"] = \"treatment-arm\"\n   257\t    second[\"group_id\"] = \"treatment-arm\"\n   258\t\n   259\t    groups = _groups_for_page(\n   260\t        \"longitudinal-results\",\n   261\t        [(first, None), (second, None)],\n   262\t    )\n   263\t\n   264\t    assert len(groups) == 1\n   265\t    assert {row[\"_chart_type\"] for row in groups[0][\"rows\"]} == {\"line\"}\n   266\t    assert {row[\"_chart_series_key\"] for row in groups[0][\"rows\"]} == {\"treatment\"}\n   267\t    assert {row[\"_chart_time_key\"] for row in groups[0][\"rows\"]} == {\n   268\t        \"around_month_6\",\n   269\t        \"around_week_12\",\n   270\t    }\n   271\t\n   272\t\n   273\tdef test_baseline_and_disposition_groups_are_identity_aware() -> None:\n   274\t    data = load_report_b_data(PNH_DATA)\n   275\t    names = {row.id: row.name for row in data.products}\n   276\t    trial_names = {row.id: row.display_id for row in data.trials}\n   277\t    efficacy = _efficacy_records(data, names, trial_names)\n   278\t    safety = ()\n   279\t\n   280\t    baseline = _page_records(\n   281\t        data,\n   282\t        page_id=\"baseline-overview\",\n   283\t        names=names,\n   284\t        trial_names=trial_names,\n   285\t        efficacy=efficacy,\n   286\t        safety=safety,\n   287\t    )\n   288\t    assert any(row[\"original_variable\"] == \"baseline_sample_size\" for row, _source in baseline)\n   289\t    assert any(\n   290\t        row[\"original_variable_label_zh\"] == \"基线样本量\"\n   291\t        for row, _source in baseline\n   292\t    )\n   293\t    assert any(\n   294\t        row[\"original_definition\"] == \"基线时点按随机化组列示\"\n   295\t        for row, _source in baseline\n   296\t    )\n   297\t    disposition = _page_records(\n   298\t        data,\n   299\t        page_id=\"disposition-overview\",\n   300\t        names=names,\n   301\t        trial_names=trial_names,\n   302\t        efficacy=efficacy,\n   303\t        safety=safety,\n   304\t    )\n   305\t\n   306\t    baseline_groups = _groups_for_page(\"baseline-overview\", baseline)\n   307\t    disposition_groups = _groups_for_page(\"disposition-overview\", disposition)\n   308\t\n   309\t    assert baseline_groups\n   310\t    assert disposition_groups\n   311\t    for group in (*baseline_groups, *disposition_groups):\n   312\t        assert group[\"x_axis_label_zh\"] == \"产品｜试验\"\n   313\t        if group[\"cross_trial\"]:\n   314\t            assert all(row[\"_chart_identity_key\"] for row in group[\"rows\"])\n   315\t        assert all(row[\"clinical_concept\"] for row in group[\"rows\"])\n   316\t\n   317\t\n   318\tdef test_baseline_comparison_splits_unknown_population_from_fas() -> None:\n   319\t    fas = _project_baseline(\n   320\t        \"baseline-age-fas\",\n   321\t        product_id=\"product-a\",\n   322\t        trial_id=\"trial-a\",\n   323\t        population=\"全分析集\",\n   324\t    )\n   325\t    source_population = _project_baseline(\n   326\t        \"baseline-age-source\",\n   327\t        product_id=\"product-b\",\n   328\t        trial_id=\"trial-b\",\n   329\t        population=\"来源报告基线/相应分析人群\",\n   330\t        value=47,\n   331\t    )\n   332\t\n   333\t    groups = _groups_for_page(\n   334\t        \"baseline-overview\",\n   335\t        [(fas, None), (source_population, None)],\n   336\t    )\n   337\t\n   338\t    assert len(groups) == 2\n   339\t    assert {group[\"title_zh\"] for group in groups} == {\n   340\t        \"基线 · 年龄 · 均值 · 全分析集\",\n   341\t        \"基线 · 年龄 · 均值 · 来源报告基线/相应分析人群\",\n   342\t    }\n   343\t\n   344\t\n   345\tdef test_baseline_internal_hgb_alias_is_never_exposed_as_visible_concept() -> None:\n   346\t    row = _project_baseline(\n   347\t        \"baseline-hgb\",\n   348\t        product_id=\"product-a\",\n   349\t        trial_id=\"trial-a\",\n   350\t        population=\"全分析集\",\n   351\t        variable=\"baseline_hgb_actual\",\n   352\t        value=8.8,\n   353\t    )\n   354\t\n   355\t    assert row[\"clinical_concept\"] == \"baseline_hemoglobin\"\n   356\t    assert row[\"clinical_concept_label_zh\"] == \"基线血红蛋白\"\n   357\t    filters = _filter_dimensions([(row, None)])\n   358\t    assert filters[0][\"element\"] == \"基线血红蛋白\"\n   359\t\n   360\t\n   361\tdef test_baseline_age_mean_and_median_share_one_comparison_with_difference_note() -> None:\n   362\t    mean = _project_baseline(\n   363\t        \"baseline-age-mean\",\n   364\t        product_id=\"product-a\",\n   365\t        trial_id=\"trial-a\",\n   366\t        population=\"全分析集\",\n   367\t    )\n   368\t    median = _project_baseline(\n   369\t        \"baseline-age-median\",\n   370\t        product_id=\"product-b\",\n   371\t        trial_id=\"trial-b\",\n   372\t        population=\"全分析集\",\n   373\t        value=47,\n   374\t    )\n   375\t    median[\"statistic_form\"] = \"中位数\"\n   376\t    median[\"statistical_form_family\"] = \"median\"\n   377\t    median[\"statistical_form_family_label_zh\"] = \"中位数\"\n   378\t\n   379\t    groups = _groups_for_page(\n   380\t        \"baseline-overview\",\n   381\t        [(mean, None), (median, None)],\n   382\t    )\n   383\t\n   384\t    assert len(groups) == 1\n   385\t    assert groups[0][\"title_zh\"] == \"基线 · 年龄 · 全分析集 · 统计形式：均值/中位数\"\n   386\t    assert groups[0][\"title_complete\"] is True\n   387\t\n   388\t\n   389\tdef test_baseline_missing_unit_stays_with_same_measure_and_is_marked() -> None:\n   390\t    reported = _project_baseline(\n   391\t        \"baseline-hgb-reported\",\n   392\t        product_id=\"product-a\",\n   393\t        trial_id=\"trial-a\",\n   394\t        population=\"全分析集\",\n   395\t        variable=\"baseline_hgb_actual\",\n   396\t        value=8.8,\n   397\t    )\n   398\t    undisclosed = _project_baseline(\n   399\t        \"baseline-hgb-undisclosed\",\n   400\t        product_id=\"product-b\",\n   401\t        trial_id=\"trial-b\",\n   402\t        population=\"全分析集\",\n   403\t        variable=\"baseline_hgb_actual\",\n   404\t        value=0,\n   405\t    )\n   406\t    undisclosed[\"unit\"] = \"\"\n   407\t    undisclosed[\"renderable\"] = False\n   408\t    undisclosed[\"disclosure_state\"] = \"not_publicly_disclosed\"\n   409\t\n   410\t    groups = _groups_for_page(\n   411\t        \"baseline-overview\",\n   412\t        [(reported, None), (undisclosed, None)],\n   413\t    )\n   414\t\n   415\t    assert len(groups) == 1\n   416\t    assert (\n   417\t        groups[0][\"title_zh\"]\n   418\t        == \"基线 · 基线血红蛋白 · 均值 · 全分析集 · 单位：g/dL/单位未列示\"\n   419\t    )\n   420\t\n   421\t\n   422\tdef test_disposition_group_title_is_complete_without_duplicate_indicator_prefix() -> None:\n   423\t    data = load_report_b_data(PNH_DATA)\n   424\t    names = {row.id: row.name for row in data.products}\n   425\t    trial_names = {row.id: row.display_id for row in data.trials}\n   426\t    records = _page_records(\n   427\t        data,\n   428\t        page_id=\"participant-flow\",\n   429\t        names=names,\n   430\t        trial_names=trial_names,\n   431\t        efficacy=(),\n   432\t        safety=(),\n   433\t    )\n   434\t\n   435\t    groups = _groups_for_page(\"participant-flow\", records)\n   436\t\n   437\t    assert groups\n   438\t    assert all(group[\"title_complete\"] is True for group in groups)\n   439\t    assert all(group[\"title_zh\"].startswith(\"完成情况 · \") for group in groups)\n","exit_code":0,"status":"completed"}}
