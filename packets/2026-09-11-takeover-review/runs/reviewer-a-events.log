eline-overview\",\n  3665\t        names=names,\n  3666\t        trial_names=trial_names,\n  3667\t        efficacy=efficacy,\n  3668\t        safety=safety,\n  3669\t    )\n  3670\t    disposition = _page_records(\n  3671\t        data,\n  3672\t        page_id=\"disposition-overview\",\n  3673\t        names=names,\n  3674\t        trial_names=trial_names,\n  3675\t        efficacy=efficacy,\n  3676\t        safety=safety,\n  3677\t    )\n  3678\t    matrix = _matrix_records(data, names, trial_names)\n  3679\t    detail_pool = _dedupe_records(\n  3680\t        (\n  3681\t            *_tag_records(efficacy, \"efficacy\"),\n  3682\t            *_tag_records(safety, \"safety\"),\n  3683\t            *_tag_records(baseline, \"baseline\"),\n  3684\t            *_tag_records(matrix, \"matrix\"),\n  3685\t            *_tag_records(disposition, \"disposition\"),\n  3686\t        )\n  3687\t    )\n  3688\t    # Adjudicate against the full observation universe once. Every physical page\n  3689\t    # (including dossiers) consumes a projection of these same group identities.\n  3690\t    scientific_groups = _groups_for_page(\n  3691\t        \"product-trial-profiles\", detail_pool, semantic_proposals=data.semantic_proposals,\n  3692\t    )\n  3693\t    # Longitudinal description is a separate full-view projection purpose, not a\n  3694\t    # fresh cross-trial comparability decision made from a filtered page.\n  3695\t    trial_series: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n  3696\t    for row, source in efficacy:\n  3697\t        trial_series[(_text(row.get(\"product_id\")), _text(row.get(\"trial_id\")),\n  3698\t                      _text(row.get(\"group_id\")), _text(row.get(\"arm_role\")))].append((row, source))\n  3699\t    longitudinal_groups = tuple(\n  3700\t        {**group, \"scientific_group_kind\": \"within_trial_longitudinal\"}\n  3701\t        for key in sorted(trial_series)\n  3702\t        for group in _groups_for_page(\