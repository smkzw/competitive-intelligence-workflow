ow.get(\"trial_id\")),\n  3161\t                \"group\": _text(row.get(\"group\"), _text(row.get(\"arm\"), \"组别未列示\")),\n  3162\t                \"arm_role\": _text(row.get(\"arm_role\")),\n  3163\t                \"element\": _text(\n  3164\t                    row.get(\"clinical_concept_label_zh\"),\n  3165\t                    _text(\n  3435\t            data,\n  3436\t            page_id=page_id + \"-trial\",\n  3437\t            names=names,\n  3438\t            trial_names=trial_names,\n  3439\t            domain=\"profile\",\n  3440\t        )\n  3441\t    return tuple(efficacy) or tuple(safety)\n  3442\t\n  3443\t\n  3444\tdef _external_source_entries(data: ReportBPortalData) -> tuple[dict[str, str | None], ...]:\n  3445\t    entries: list[dict[str, str | None]] = []\n  3446\t    seen: set[str] = set()\n  3447\t    for source in data.sources:\n  3448\t        label = _text(getattr(source, \"source\", None))\n  3449\t        if not label or label in seen:\n  3450\t            continue\n  3451\t        seen.add(label)\n  3452\t        url_match = re.search(r\"https?://[^\\s<>\\\"']+\", label, flags=re.IGNORECASE)\n  3453\t        entries.append(\n  3454\t            {\n  3455\t                \"label\": label,\n  3456\t                \"url\": None if url_match is None else url_match.group(0).rstrip(\".,;\"),\n  3457\t                \"scope\": _text(getattr(source, \"scope\", None)),\n  3458\t                \"limitation\": _text(getattr(source, \"limitation\", None)),\n  3459\t            }\n  3460\t        )\n  3461\t    return tuple(entries)\n  3462\t\n  3463\t\n  3464\tdef _render_page_context(\n  3465\t    data: ReportBPortalData,\n  3466\t    *,\n  3467\t    page: StaticPage,\n  3468\t    catalog: ReportCatalog,\n  3469\t    names: Mapping[str, str],\n  3470\t    trial_names: Mapping[str, str],\n  3471\t    efficacy: Sequence[tuple[dict[str, Any], Any]],\n  3472\t    safety: Sequence[tuple[dict[str, Any], Any]],\n  3473\t    scientific_groups: Sequenc