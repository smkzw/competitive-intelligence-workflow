)\n  1681\t    product_id = _product_id(value) or _product_id(source)\n  1682\t    trial_id = _trial_id(value) or _trial_id(source)\n  1683\t    numeric = _value_for(value)\n  1684\t    raw_state = _first(value, \"disclosure_state\", default=None)\n  1685\t    state = _state(raw_state, numeric)\n  1686\t    renderable = numeric is not None and state in _CONCRETE_STATES\n  1687\t    product_name = names.get(product_id, \"未列示产品\")\n  1688\t    trial_name = trial_names.get(trial_id, \"未列示试验\")\n  1689\t    label = _label_for(value, domain)\n  1690\t    arm = _arm_label(value)\n  1691\t    category = _category_for(value, domain, arm)\n  1692\t    unit = _text(\n  1693\t        _source_first(\n  1694\t            value,\n  1695\t            source,\n  1696\t            \"unit\",\n  1697\t            \"measurement_unit\",\n  1698\t            \"measure_unit\",\n  1699\t            \"effect_unit\",\n  1700\t            default=\"%\" if domain in {\"efficacy\", \"safety\"} else \"\",\n  1701\t        )\n  1702\t    )\n  1703\t    cohort = _native_text(_source_first(value, source, \"cohort_id\", \"cohort\", default=\"\"))\n  1704\t    period = _native_text(_source_first(value, source, \"period_id\", \"period\", \"phase\", default=\"\"))\n  1705\t    reason = _native_text(\n  1706\t        _source_first(value, source, \"canonical_reason\", \"reason_zh\", \"reason\", default=\"\")\n  1707\t    )\n  1708\t    target = _native_text(_source_first(value, source, \"target_id\", \"target\", default=\"\"))\n  1709\t    group_id = _text(_source_first(value, source, \"group_id\", \"arm_id\", \"group\", default=\"\"))\n  1710\t    population = _text(\n  1711\t        _source_first(\n  1712\t            value,\n  1713\t            source,\n  1714\t            \"analysis_population_zh\",\n  1715\t            \"analysis_population\",\n  1716\t            \"population\",\n  1717\t            default=\"\",\n  1718\t        ),\n  1719\t    )\n  1720\t    field_family = _native_text(\n  1721\t        _source_first(value, source, \"field_family\", \"variable_domain\", default=\"\")\n  1722\t    )\n  1723\t    statistic_form = _native_text(\n  1724\t        _source_first(\n  1725\t            value,\n  1726\t            source,\n  1727\t            \"statistic_form\",\n  1728\t            \"statistic_label_zh\",\n  1729\t            \"statistical_form\",\n  1730\t            default=\"\",\n  1731\t        )\n  1732\t    )\n  1733\t    denominator_role = _native_text(_source_first(value, source, \"denominator_role\", default=\"\"))\n  1734\t    measure_object = _native_text(_source_first(value, source, \"measure_object\", default=\"\"))\n  1735\t    time_label = _time_label(value)\n  1736\t    time_window = _text(\n  1737\t        _source_first(\n  1738\t            value,\n  1739\t            source,\n  1740\t            \"time_window_zh\",\n  1741\t            \"time_window\",\n  1742\t            \"baseline_timepoint\",\n  1743\t            default=time_label,\n  1744\t        ),\n  1745\t        time_label,\n  2010\t            )\n  2011\t            if renderable\n  2012\t            else _state_label(state)\n  2013\t        )\n  2014\t    if domain == \"matrix\":\n  2015\t        point = _first(value, \"point\", default=None)\n  2016\t        result[\"x_value\"] = _number(_first(point, \"x_value\", \"x\", default=None))\n  2017\t        result[\"y_value\"] = _number(_first(point, \"y_value\", \"y\", default=None))\n  2018\t        result[\"size\"] = _number(_first(point, \"radius\", \"area\", \"size\", default=None))\n  2019\t        result[\"renderable\"] = all(\n  2020\t            result[key] is not None for key in (\"x_value\", \"y_value\", \"size\")\n  2021\t        )\n  2022\t        result[\"value\"] = result[\"x_value\"]\n  2023\t        result[\"numeric_value\"] = result[\"x_value\"]\n  2024\t        if result[\"renderable\"]:\n  2025\t            result[\"arm\"] = \"试验内治疗组与对照组\"\n  2026\t            result[\"group\"] = result[\"arm\"]\n  2027\t            result[\"status\"] = \"可比较\"\n  2028\t            result[\"disclosure_state\"] = \"reported_value\"\n  2029\t        elif result[\"status\"] == \"不适用\":\n  2030\t            result[\"arm\"] = \"不适用\"\n  2031\t            result[\"group\"] = result[\"arm\"]\n  2032\t            result[\"disclosure_state\"] = \"not_applicable\"\n  2033\t    return result\n  2034\t\n  2035\t\n  2036\tdef _dedupe_records(\n  2037\t    records: Sequence[tuple[dict[str, Any], Any]],\n  2038\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2039\t    seen: dict[str, tuple[str, str]] = {}\n  2040\t    result: list[tuple[dict[str, Any], Any]] = []\n  2041\t    for row, source in records:\n  2042\t        row_id = _text(row.get(\"row_id\"))\n  2043\t        if not row_id:\n  2044\t            raise ValueError(\"科学视图观察缺少标识\")\n  2045\t        identity = (_text(row.get(\"_domain\")), semantic_row_digest(row))\n  2046\t        if row_id in seen:\n  2047\t            if seen[row_id] != identity:\n  2048\t                raise ValueError(\"科学视图同一观察标识存在域或事实冲突\")\n  2049\t            continue\n  2050\t        seen[row_id] = identity\n  2051\t        result.append((row, source))\n  2052\t    return tuple(result)\n  2053\t\n  2054\t\n  2055\tdef _legacy_or_view_rows(\n  2056\t    data: ReportBPortalData,\n  2057\t    *,\n  2058\t    view_name: str,\n  2059\t    legacy_name: str,\n  2060\t    view_fields: tuple[str, ...],\n  2061\t    table_fields: tuple[str, ...] = (),\n  2062\t) -> tuple[Any, ...]:\n  2063\t    source = _view_source(data, view_name)\n  2064\t    if source is not None:\n  2065\t        fields = (\n  2066\t            *view_fields,\n  2067\t            \"single_timepoint_views\",\n  2068\t            \"longitudinal_views\",\n  2069\t            \"source_effect_size_views\",\n  2070\t            \"heatmap_views\",\n  2071\t            \"chart_panels\",\n  2072\t        )\n  2073\t        if isinstance(source, Mapping):\n  2074\t            for field in fields:\n  2075\t                candidate = _get(source, field, _MISSING)\n  2076\t                if candidate is not _MISSING and candidate is not None:\n  2077\t                    rows = _flatten_view_rows(_iter_values(candidate))\n  2078\t                    if rows:\n  2079\t                        return rows\n  2080\t        rows = _flatten_view_rows(_collection(source, *view_fields))\n  2081\t        if rows:\n  2082\t            # A view state complete table is already a projection; its nested\n  2083\t            # fact is unwrapped by the record adapter without recomputation.\n  2084\t            return rows\n  2085\t    return tuple(_get(data, legacy_name, ()) or ())\n  2086\t\n  2087\t\n  2088\tdef _efficacy_records(\n  2089\t    data: ReportBPortalData,\n  2090\t    names: Mapping[str, str],\n  2091\t    trial_names: Mapping[str, str],\n  2092\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2093\t    values = _legacy_or_view_rows(\n  2094\t        data,\n  2095\t        view_name=\"efficacy_views\",\n  2096\t        legacy_name=\"efficacy\",\n  2097\t        view_fields=(\"fact_rows\", \"facts\", \"rows\"),\n  2098\t    )\n  2099\t    records: list[tuple[dict[str, Any], Any]] = []\n  2100\t    for index, value in enumerate(values):\n  2101\t        row = _project_record(\n  2102\t            value,\n  2103\t            domain=\"efficacy\",\n  2104\t            names=names,\n  2105\t            trial_names=trial_names,\n  2106\t            fallback=f\"efficacy-{index + 1}\",\n  2107\t        )\n  2108\t        records.append((row, value))\n  2109\t    return _dedupe_records(records)\n  2110\t\n  2111\t\n  2112\tdef _safety_records(\n  2113\t    data: ReportBPortalData,\n  2114\t    names: Mapping[str, str],\n  2115\t    trial_names: Mapping[str, str],\n  2720\t            base_series_key = _chart_series_key(copied)\n  2721\t            series_key = duplicate_series_keys.get(index, base_series_key)\n  2722\t            copied[\"_chart_series_key\"] = series_key\n  2723\t            copied[\"_chart_series_label\"] = _chart_series_label(copied, series_key)\n  2724\t            copied[\"_chart_time_key\"] = _text(\n  2725\t                copied.get(\"time_window_band\"),\n  2726\t                _text(copied.get(\"time\"), \"时间点未列示\"),\n  2727\t            )\n  2728\t        rows.append(copied)\n  2729\t    result: dict[str, Any] = {\n  2730\t        \"title_zh\": title,\n  2731\t        \"title_complete\": cross_trial,\n  2732\t        \"cross_trial\": cross_trial,\n  2733\t        \"identity_series\": identity_aware,\n  2734\t        \"rows\": rows,\n  2735\t        \"scientific_group_id\": \"b-group-\" + hashlib.sha256(_canonical_json(sorted(\n  2736\t            (str(row[\"row_id\"]), semantic_row_digest(row)) for row, _source in records\n  2737\t        ))).hexdigest(),\n  2738\t    }\n  2739\t    if x_axis_label_zh:\n  2740\t        result[\"x_axis_label_zh\"] = x_axis_label_zh\n  2741\t    if y_axis_label_zh:\n  2742\t        result[\"y_axis_label_zh\"] = y_axis_label_zh\n  2743\t    if size_label_zh:\n  2744\t        result[\"size_label_zh\"] = size_label_zh\n  2745\t    return result\n  2746\t\n  2747\t\n  2748\tdef _project_scientific_groups(\n  2749\t    groups: Sequence[dict[str, Any]],\n  2750\t    records: Sequence[tuple[dict[str, Any], Any]],\n  2751\t) -> tuple[dict[str, Any], ...]:\n  2752\t    \"\"\"Select already-adjudicated observations without recomputing membership.\"\"\"\n  2753\t    selected = {str(row[\"row_id\"]): row for row, _source in _dedupe_records(records)}\n  2754\t    available = {str(row[\"row_id\"]): row for group in groups for row in group[\"rows\"]}\n  2755\t    for row_id, row in selected.items():\n  2756\t        original = available.get(row_id)\n  2757\t        if original is None:\n  2758\t            raise ValueError(\"页面观察不属于完整科学视图\")\n  2759\t        if (row.get(\"_domain\") != original.get(\"_domain\") or\n  2760\t                semantic_row_digest(row) != semantic_row_digest(original)):\n  2761\t            raise ValueError(\"页面观察域或事实摘要与完整科学视图不一致\")\n  2762\t    result: list[dict[str, Any]] = []\n  2763\t    for group in groups:\n  2764\t        rows = [dict(row) for row in group[\"rows\"] if str(row[\"row_id\"]) in selected]\n  2765\t        if rows:\n  2766\t            result.append({**group, \"rows\": rows,\n  2767\t                           \"cross_trial\": _bucket_spans_trials([(row, None) for row in rows])})\n  2768\t    return tuple(result)\n  2769\t\n  2770\t\n  2771\tdef _semantic_group_key(\n  2772\t    row: Mapping[str, Any],\n  2773\t    *,\n  2774\t    include_time: bool,\n  2775\t    include_domain: bool = False,\n  2776\t    include_population: bool = True,\n  2777\t    include_statistic: bool = True,\n  2778\t    include_unit: bool = True,\n  2779\t) -> tuple[str, ...]:\n  2780\t    values = [\n  2781\t        _text(row.get(\"clinical_concept\"), _text(row.get(\"display_label_zh\"), \"clinical-concept\")),\n  2782\t    ]\n  2783\t    if include_statistic:\n  2784\t        values.append(\n  2785\t            _text(\n  2786\t                row.get(\"statistical_form_family\"),\n  2787\t                _text(row.get(\"statistic_form\"), \"statistic-not-reported\"),\n  2788\t            )\n  2789\t        )\n  2790\t    if include_unit:\n  2791\t        values.append(_text(row.get(\"unit\"), \"unit-not-reported\"))\n  2792\t    if include_population:\n  2793\t        values.append(\n  2794\t            _text(\n  2795\t                row.get(\"population_context\"),\n  2796\t                _text(row.get(\"population\"), \"population-not-reported\"),\n  2797\t            )\n  2798\t        )\n  2799\t    if include_domain:\n  2800\t        values.append(_text(row.get(\"field_family\"), \"field-not-reported\"))\n  2801\t    if include_time:\n  2802\t        values.append(\n  2803\t            _text(row.get(\"time_window_band\"), _text(row.get(\"time\"), \"time-not-reported\"))\n  2804\t        )\n  2805\t    if row.get(\"_domain\") in {\"efficacy\", \"safety\"}:\n  2806\t        values.extend(\n  2807\t            (\n  2808\t                _text(\n  2809\t                    row.get(\"semantic_definition\"),\n  2810\t                    _text(row.get(\"original_definition\"), \"definition-not-reported\"),\n  2811\t                ),\n  2812\t                _text(row.get(\"semantic_direction\"), \"direction-not-reported\"),\n  2813\t                _text(row.get(\"semantic_estimand\"), \"estimand-not-reported\"),\n  2814\t                _text(\n  2815\t                    row.get(\"semantic_denominator\"),\n  2816\t                    _text(row.get(\"denominator_role\"), \"denominator-not-reported\"),\n  2817\t                ),\n  2818\t                _text(\n  2819\t                    row.get(\"semantic_analysis_set\"),\n  2820\t                    _text(row.get(\"population_context\"), \"analysis-set-not-reported\"),\n  2821\t                ),\n  2822\t                _text(\n  2823\t                    row.get(\"semantic_analysis_form\"),\n  2824\t                    _text(row.get(\"statistical_form_family\"), \"analysis-form-not-reported\"),\n  2825\t                ),\n  2826\t                _text(\n  2827\t                    row.get(\"semantic_instrument_or_scale\"),\n  2828\t                    \"instrument-or-scale-not-reported\",\n  2829\t                ),\n  2830\t            )\n  2831\t        )\n  2832\t    return tuple(values)\n  2833\t\n  2834\t\n  2835\tdef _sorted_bucket(\n  2836\t    bucket: Sequence[tuple[dict[str, Any], Any]],\n  2837\t) -> tuple[tuple[dict[str, Any], Any], ...]:\n  2838\t    def key(item: tuple[dict[str, Any], Any]) -> tuple[str, ...]:\n  2839\t        row = item[0]\n  2840\t        arm_role = _text(row.get(\"arm_role\"), \"unknown\")\n  2841\t        arm_priority = {\n  2842\t            \"treatment\": \"0\",\n  2843\t            \"control\": \"1\",\n  2844\t            \"single_arm\": \"2\",\n  2845\t            \"unknown\": \"3\",\n  2846\t        }.get(arm_role, \"9\")\n  2847\t        return (\n  2848\t            _text(row.get(\"product_id\")),\n  2849\t            _text(row.get(\"trial_id\")),\n  2850\t            arm_priority,\n  2851\t            arm_role,\n  2852\t            _text(row.get(\"group_id\")),\n  2853\t            _text(row.get(\"time_window_band\"), _text(row.get(\"time\"))),\n  2854\t            _text(row.get(\"actual_timepoint\")),\n  2855\t            _text(row.get(\"row_id\")),\n  2856\t        )\n  2857\t\n  2858\t    return tuple(sorted(bucket, key=key))\n  2859\t\n  2860\t\n  2861\tdef _cross_trial_groups(\n  2862\t    records: Sequence[tuple[dict[str, Any], Any]],\n  2863\t    *,\n  2864\t    page_id: str,\n  2865\t    domain: str,\n  2866\t    include_time: bool,\n  2867\t    chart_type: str | None = None,\n  2868\t    semantic_proposals: Sequence[SemanticGroupingProposal] = (),\n  2869\t) -> tuple[dict[str, Any], ...]:\n  2870\t    buckets: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n  2871\t    for item in records:\n  2872\t        row = item[0]\n  2873\t        key = _semantic_group_key(row, include_time=include_time)\n  2874\t        if any(semantic_value_is_unknown(value) for value in key):\n  2875\t            # Retain source observations, but unknown axes cannot license cross-trial comparison.\n  2876\t            # Without a trial identity even a within-trial descriptive grouping is unproven.\n  2877\t            key += (\n  2878\t                \"source-specific\",\n  2879\t                _text(row.get(\"product_id\")),\n  2880\t                _text(row.get(\"trial_id\"), _text(row.get(\"row_id\"))),\n  2881\t            )\n  2882\t        buckets[key].append(item)\n  2883\t    merged = proposed_semantic_buckets(tuple(buckets.values()), semantic_proposals)\n  2884\t    buckets = {\n  2885\t        (*_semantic_group_key(bucket[0][0], include_time=include_time), str(index)):\n  2886\t        list(bucket)\n  2887\t        for index, bucket in enumerate(merged)\n  2888\t    }\n  2889\t    groups: list[dict[str, Any]] = []\n  2890\t    bucket_keys = sorted(\n  2891\t        buckets,\n  2892\t        key=lambda key: (\n  2893\t            not any(item[0].get(\"renderable\") for item in buckets[key]),\n  2894\t            key,\n  2895\t        ),\n  2896\t    )\n  2897\t    for key in bucket_keys:\n  2898\t        bucket = _sorted_bucket(buckets[key])\n  2899\t        first = bucket[0][0]\n  2900\t        times = {\n  2901\t            _text(row.get(\"time_window_band\"), _text(row.get(\"time\")))\n  2902\t            for row, _source in bucket\n  2903\t            if _text(row.get(\"time_window_band\"), _text(row.get(\"time\")))\n  2904\t        }\n  2905\t        resolved_chart_type = chart_type or (\n  2906\t            \"line\" if page_id == \"longitudinal-results\" and len(times) > 1 else \"bar\"\n  2907\t        )\n  2908\t        title = _group_title(first, domain=domain, include_time=include_time)\n  2909\t        ids = {str(row[\"row_id\"]) for row, _source in bucket}\n  2910\t        if any(set(proposal.row_ids).issubset(ids) for proposal in semantic_proposals):\n  2911\t            actual_times = tuple(dict.fromkeys(\n  2912\t                f'{row.get(\"actual_timepoint\")} '\n  2913\t                + {\"week\": \"周\", \"day\": \"天\", \"month\": \"个月\", \"year\": \"年\"}.get(\n  2914\t                    str(row.get(\"actual_timepoint_unit\")), str(row.get(\"actual_timepoint_unit\")),\n  2915\t                )\n  2916\t                for row, _source in bucket\n  2917\t            ))\n  2918\t            title += \" · 实际观察时间：\" + \" / \".join(actual_times)\n  2919\t        if any(semantic_value_is_unknown(value) for value in key):\n  2920\t            title += \" · 语义信息未完整，按试验列示\"\n  2921\t        group = _group(\n  2922\t            title,\n  2923\t            bucket,\n  2924\t            chart_type=resolved_chart_type,\n  2925\t            cross_trial=_bucket_spans_trials(bucket),\n  2926\t            identity_series=True,\n  2927\t            x_axis_label_zh=\"产品｜试验\",\n  2928\t        )\n  2929\t        group[\"title_complete\"] = True\n  2930\t        if page_id == \"longitudinal-results\":\n  2931\t            values = [\n  2932\t                float(row[\"numeric_value\"])\n  2933\t                for row, _source in bucket\n  2934\t                if isinstance(row.get(\"numeric_value\"), (int, float))\n  2935\t                and not isinstance(row.get(\"numeric_value\"), bool)\n  2936\t            ]\n  2937\t            if values:\n  2938\t                group[\"y_axis_min\"] = min(0.0, min(values))\n  2939\t                group[\"y_axis_max\"] = max(0.0, max(values))\n  2940\t        groups.append(group)\n  2941\t    return tuple(groups)\n  2942\t\n  2943\t\n  2944\tdef _baseline_bucket_sort_key(key: tuple[str, ...]) -> tuple[int, tuple[str, ...]]:\n  2945\t    concept = key[0] if key else \"\"\n  2946\t    for rank, family in enumerate(_BASELINE_CONCEPT_FAMILY_ORDER):\n  2947\t        if _semantic_token(concept) in family:\n  2948\t            return (rank, key)\n  2949\t    return (len(_BASELINE_CONCEPT_FAMILY_ORDER), key)\n  2950\t\n  2951\t\n  2952\tdef _bucket_spans_trials(bucket: Sequence[tuple[dict[str, Any], Any]]) -> bool:\n  2953\t    trial_ids = {\n  2954\t        _text(row.get(\"trial_id\"))\n  2955\t        for row, _source in bucket\n  2956\t        if _text(row.get(\"trial_id\"))\n  2957\t    }\n  2958\t    return len(trial_ids) > 1\n  2959\t\n  2960\t\n  2961\tdef _groups_for_page(\n  2962\t    page_id: str,\n  2963\t    records: Sequence[tuple[dict[str, Any], Any]],\n  2964\t    *, semantic_proposals: Sequence[SemanticGroupingProposal] = (),\n  2965\t) -> tuple[dict[str, Any], ...]:\n  2966\t    if not records:\n  2967\t        return ()\n  2968\t    records = _records_with_semantics(records, page_id=page_id)\n  2969\t    if page_id in {\"overview\", \"product-trial-profiles\"}:\n  2970\t        by_id = {str(row[\"row_id\"]): row for row, _source in _dedupe_records(records)}\n  2971\t        for proposal in semantic_proposals:\n  2972\t            present = [by_id[row_id] for row_id in proposal.row_ids if row_id in by_id]\n  2973\t            if len(present) == 2 and present[0].get(\"_domain\") != present[1].get(\"_domain\"):\n  2974\t                raise ValueError(\"跨域语义提案不受支持，必须拆分研究问题\")\n  2975\t    if page_id in {\"efficacy\", \"longitudinal-results\", \"subgroups-supporting-evidence\"}:\n  2976\t        return _cross_trial_groups(\n  2977\t            records,\n  2978\t            page_id=page_id,\n  2979\t            domain=\"efficacy\",\n  2980\t            include_time=page_id != \"longitudinal-results\",\n  2981\t            semantic_proposals=semantic_proposals,\n  2982\t        )\n  2983\t    if page_id == \"safety\":\n  2984\t        return _cross_trial_groups(\n  2985\t            records,\n  2986\t            page_id=page_id,\n  2987\t            domain=\"safety\",\n  2988\t            include_time=True,\n  2989\t            chart_type=\"heatmap\",\n  2990\t            semantic_proposals=semantic_proposals,\n  2991\t        )\n  2992\t    if page_id == \"overview\":\n  2993\t        efficacy = [item for item in records if item[0].get(\"_domain\") == \"efficacy\"]\n  2994\t        safety = [item for item in records if item[0].get(\"_domain\") == \"safety\"]\n  2995\t        matrix = [item for item in records if item[0].get(\"_domain\") == \"matrix\"]\n  2996\t        baseline = [item for item in records if item[0].get(\"_domain\") == \"baseline\"]\n  2997\t        disposition = [item for item in records if item[0].get(\"_domain\") == \"disposition\"]\n  2998\t        overview_groups: list[dict[str, Any]] = []\n  2999\t        if efficacy:\n  3000\t            overview_groups.extend(_groups_for_page(\n  3001\t                \"efficacy\", efficacy, semantic_proposals=semantic_proposals,\n  3002\t            ))\n  3003\t        if safety:\n  3004\t            overview_groups.extend(_groups_for_page(\n  3005\t                \"safety\", safety, semantic_proposals=semantic_proposals,\n  3006\t            ))\n  3007\t        for related_page_id, related_records in (\n  3008\t            (\"efficacy-safety-matrix\", matrix),\n  3009\t            (\"baseline-overview\", baseline),\n  3010\t            (\"disposition-overview\", disposition),\n  3011\t        ):\n  3012\t            if related_records:\n  3013\t                overview_groups.extend(_groups_for_page(\n  3014\t                    related_page_id, related_records, semantic_proposals=semantic_proposals,\n  3015\t                ))\n  3016\t        return tuple(overview_groups)\n  3017\t    if page_id == \"efficacy-safety-matrix\":\n  3018\t        chart_type = (\n  3019\t            \"bubble\" if any(item[0].get(\"renderable\") for item in records) else \"status_matrix\"\n  3020\t        )\n  3021\t        matrix_groups = []\n  3022\t        for bucket in proposed_semantic_buckets(\n  3023\t            (records,), semantic_proposals, descriptive_only=True,\n  3024\t        ):\n  3025\t            group = _group(\"疗效与安全性观察位置\", bucket, chart_type=chart_type)\n  3026\t            group.update(\n  3027\t                x_axis_label_zh=\"试验内疗效差（百分点）\",\n  3028\t                y_axis_label_zh=\"治疗组治疗期间不良事件发生率（%）\",\n  3029\t                size_label_zh=\"气泡大小：治疗组样本量\",\n  3030\t            )\n  3031\t            matrix_groups.append(group)\n  3032\t        return tuple(matrix_groups)\n  3033\t    if page_id in _BASELINE_PAGE_IDS:\n  3034\t        buckets: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n  3035\t        for item in records:\n  3036\t            buckets[\n  3037\t                _semantic_group_key(\n  3038\t                    item[0],\n  3039\t                    include_time=True,\n  3040\t                    include_domain=True,\n  3041\t                    include_population=True,\n  3042\t                    include_statistic=False,\n  3043\t                    include_unit=False,\n  3044\t                )\n  3045\t            ].append(item)\n  3046\t        groups: list[dict[str, Any]] = []\n  3047\t        baseline_buckets = proposed_semantic_buckets(\n  3048\t            tuple(buckets[key] for key in sorted(buckets, key=_baseline_bucket_sort_key)),\n  3049\t            semantic_proposals, descriptive_only=True,\n  3050\t        )\n  3051\t        for raw_bucket in baseline_buckets:\n  3052\t            bucket = _sorted_bucket(raw_bucket)\n  3053\t            first = bucket[0][0]\n  3054\t            chart_type = (\n  3055\t                \"bar\" if any(item[0].get(\"renderable\") for item in bucket) else \"status_matrix\"\n  3056\t            )\n  3057\t            statistic_labels = tuple(\n  3058\t                dict.fromkeys(\n  3059\t                    _text(\n  3060\t                        row.get(\"statistical_form_family_label_zh\"),\n  3061\t                        _text(row.get(\"statistic_form\"), \"报告未注明统计口径\"),\n  3062\t                    )\n  3063\t                    for row, _source in bucket\n  3064\t                )\n  3065\t            )\n  3066\t            title = _group_title(\n  3067\t                first,\n  3068\t                domain=\"baseline\",\n  3069\t                include_population=True,\n  3070\t                include_statistic=len(statistic_labels) == 1,\n  3071\t            )\n  3072\t            if len(statistic_labels) > 1:\n  3073\t                title += \" · 统计形式：\" + \"/\".join(statistic_labels)\n  3074\t            unit_labels = tuple(\n  3075\t                dict.fromkeys(_text(row.get(\"unit\"), \"单位未列示\") for row, _source in bucket)\n  3076\t            )\n  3077\t            if len(unit_labels) > 1:\n  3078\t                title += \" · 单位：\" + \"/\".join(unit_labels)\n  3079\t            group = _group(\n  3080\t                title,\n  3081\t                bucket,\n  3082\t                chart_type=chart_type,\n  3083\t                cross_trial=_bucket_spans_trials(bucket),\n  3084\t                x_axis_label_zh=\"产品｜试验\",\n  3085\t            )\n  3086\t            group[\"title_complete\"] = True\n  3087\t            groups.append(group)\n  3088\t        return tuple(groups)\n  3089\t    if page_id in _DISPOSITION_PAGE_IDS:\n  3090\t        disposition_buckets: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(\n  3091\t            list\n  3092\t        )\n  3093\t        for item in records:\n  3094\t            disposition_buckets[\n  3095\t                _semantic_group_key(item[0], include_time=True, include_domain=False)\n  3096\t            ].append(item)\n  3097\t        groups = []\n  3098\t        for raw_bucket in proposed_semantic_buckets(\n  3099\t            tuple(disposition_buckets[key] for key in sorted(disposition_buckets)),\n  3100\t            semantic_proposals, descriptive_only=True,\n  3101\t        ):\n  3102\t            bucket = _sorted_bucket(raw_bucket)\n  3103\t            first = bucket[0][0]\n  3104\t            chart_type = (\n  3105\t                \"bar\" if any(item[0].get(\"renderable\") for item in bucket) else \"status_matrix\"\n  3106\t            )\n  3107\t            group = _group(\n  3108\t                _group_title(first, domain=\"disposition\"),\n  3109\t                bucket,\n  3110\t                chart_type=chart_type,\n  3111\t                cross_trial=_bucket_spans_trials(bucket),\n  3112\t                x_axis_label_zh=\"产品｜试验\",\n  3113\t            )\n  3114\t            group[\"title_complete\"] = True\n  3115\t            groups.append(group)\n  3116\t        return tuple(groups)\n  3117\t    if page_id == \"trial-exposure-context\":\n  3118\t        return (_group(\"试验规模与研究角色\", records, chart_type=\"bar\"),)\n  3119\t    if page_id == \"product-trial-profiles\":\n  3120\t        domains = {_text(item[0].get(\"_domain\")) for item in records}\n  3121\t        if domains - {\"profile\", \"