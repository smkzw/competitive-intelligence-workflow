{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -c 'nl -ba tmp/semantic-independent-w1RHFS/test_independent.py'","aggregated_output":"     1\t\"\"\"Read-only audit: expected-contract regressions, synthetic inputs only.\"\"\"\n     2\tfrom itertools import permutations\n     3\tfrom copy import deepcopy\n     4\t\n     5\timport pytest\n     6\t\n     7\tfrom ci_workflow.renderers.portal.report_b import (\n     8\t    ReportBPortalData, _display_trial_name, _efficacy_records, _groups_for_page, _display_locator,\n     9\t)\n    10\tfrom ci_workflow.reports.b.semantic_grouping import _observation, semantic_row_digest\n    11\tfrom ci_workflow.reports.b.semantic_contract import compare_clinical_constructs\n    12\tfrom tests.reports.b.test_semantic_grouping_proposals import _rows, _proposal\n    13\tfrom tests.reports.b.test_r13_semantic_grouping import _project_efficacy, _project_baseline\n    14\tfrom tests.browser.test_b_semantic_proposals import proposal_data\n    15\t\n    16\t\n    17\tdef partition(groups):\n    18\t    return frozenset(frozenset(r['row_id'] for r in g['rows']) for g in groups)\n    19\t\n    20\t\n    21\tdef test_input_order_cannot_change_scientific_partition():\n    22\t    a, b = _rows()\n    23\t    c = dict(b, row_id='third', trial_id='trial-c', actual_timepoint=52,\n    24\t             semantic_definition='第三种措辞', original_definition='第三种措辞')\n    25\t    proposals = (_proposal(a, b), _proposal(b, c))\n    26\t    results = {\n    27\t        partition(_groups_for_page('efficacy', [(r, None) for r in order],\n    28\t                                   semantic_proposals=proposals))\n    29\t        for order in permutations((a, b, c))\n    30\t    }\n    31\t    assert len(results) == 1, results\n    32\t\n    33\t\n    34\t@pytest.mark.parametrize('page', ['efficacy', 'longitudinal-results'])\n    35\tdef test_no_proposal_cannot_bypass_existing_time_veto(page):\n    36\t    a, _ = _rows()\n    37\t    b = _project_efficacy('second', 'EASI-75', timepoint=56)\n    38\t    b.update({k: v for k, v in a.items() if k.startswith('semantic_')})\n    39\t    b['trial_id'] = 'trial-b'\n    40\t    assert not compare_clinical_constructs(_observation(a), _observation(b)).compatible\n    41\t    groups = _groups_for_page(page, [(a, None), (b, None)])\n    42\t    assert len(groups) == 2, [(g['cross_trial'], [r['actual_timepoint'] for r in g['rows']])\n    43\t                              for g in groups]\n    44\t\n    45\t\n    46\tdef records(data):\n    47\t    names = {p.id: p.name for p in data.products}\n    48\t    trials = {t.id: _display_trial_name(t, names[t.product_id]) for t in data.trials}\n    49\t    return _efficacy_records(data, names, trials)\n    50\t\n    51\t\n    52\tdef test_source_locator_drift_invalidates_proposal():\n    53\t    payload = proposal_data().model_dump(mode='json')\n    54\t    for fact in payload['efficacy_views']['facts']:\n    55\t        fact['source_locator'] = {'document_role': 'publication', 'table': 'Table 1', 'page': 1}\n    56\t    before = ReportBPortalData.model_validate(deepcopy(payload))\n    57\t    before_rows = records(before)\n    58\t    proposal = _proposal(before_rows[0][0], before_rows[1][0])\n    59\t    payload['efficacy_views']['facts'][0]['source_locator']['page'] = 99\n    60\t    after_rows = records(ReportBPortalData.model_validate(payload))\n    61\t    assert before_rows[0][1]['source_locator'] != after_rows[0][1]['source_locator']\n    62\t    assert _display_locator(before_rows[0][1], before_rows[0][0]['row_id']).page == 1\n    63\t    assert _display_locator(after_rows[0][1], after_rows[0][0]['row_id']).page == 99\n    64\t    with pytest.raises(ValueError, match='摘要'):\n    65\t        _groups_for_page('efficacy', after_rows, semantic_proposals=(proposal,))\n    66\t\n    67\t\n    68\tdef test_baseline_honors_explicit_incompatibility():\n    69\t    a = _project_baseline('a', product_id='product-a', trial_id='trial-a', population='FAS')\n    70\t    b = _project_baseline('b', product_id='product-b', trial_id='trial-b', population='FAS')\n    71\t    p = _proposal(a, b).model_copy(update={'compatible': False})\n    72\t    groups = _groups_for_page('baseline-overview', [(a, None), (b, None)],\n    73\t                              semantic_proposals=(p,))\n    74\t    assert len(groups) == 2, partition(groups)\n    75\t\n    76\t\n    77\tdef test_existing_cross_page_negative_is_preserved_in_supported_domains():\n    78\t    a, b = _rows()\n    79\t    p = _proposal(a, b).model_copy(update={'compatible': False})\n    80\t    for page in ('efficacy', 'longitudinal-results', 'overview', 'product-trial-profiles'):\n    81\t        rows = [(dict(r, _domain='efficacy'), None) for r in (a, b)]\n    82\t        groups = _groups_for_page(page, rows, semantic_proposals=(p,))\n    83\t        assert partition(groups) == frozenset((frozenset(('first',)), frozenset(('second',))))\n    84\t\n    85\t\n    86\tdef test_render_projection_digest_is_not_full_source_digest():\n    87\t    data = proposal_data()\n    88\t    row, source = records(data)[0]\n    89\t    assert 'source_locator' not in row\n    90\t    assert len(semantic_row_digest(row)) == 64\n    91\t\n    92\t\n    93\tdef test_product_page_is_projection_of_global_groups():\n    94\t    a, b = _rows()\n    95\t    a['product_id'] = 'product-a'\n    96\t    b['product_id'] = 'product-b'\n    97\t    c = dict(b, row_id='third', trial_id='trial-c', actual_timepoint=52,\n    98\t             semantic_definition='第三种措辞', original_definition='第三种措辞')\n    99\t    proposals = (_proposal(a, b), _proposal(b, c))\n   100\t    rows = [(dict(r, _domain='efficacy'), None) for r in (a, b, c)]\n   101\t    full = partition(_groups_for_page('efficacy', rows, semantic_proposals=proposals))\n   102\t    selected = [item for item in rows if item[0]['product_id'] == 'product-b']\n   103\t    detail = partition(_groups_for_page('product-trial-profiles', selected,\n   104\t                                        semantic_proposals=proposals))\n   105\t    selected_ids = frozenset(r['row_id'] for r, _ in selected)\n   106\t    expected = frozenset(g & selected_ids for g in full if g & selected_ids)\n   107\t    assert detail == expected, (full, detail)\n   108\t\n   109\t\n   110\t@pytest.mark.parametrize('axis', ['semantic_direction', 'unit', 'semantic_estimand',\n   111\t    'semantic_denominator', 'semantic_analysis_set', 'semantic_analysis_form',\n   112\t    'semantic_instrument_or_scale'])\n   113\t@pytest.mark.parametrize('mode', ['unknown', 'conflict'])\n   114\tdef test_each_existing_hard_axis_still_vetoes_proposal(axis, mode):\n   115\t    a, b = _rows()\n   116\t    if mode == 'unknown':\n   117\t        a[axis] = b[axis] = 'not_reported'\n   118\t    else:\n   119\t        b[axis] = 'conflicting-value'\n   120\t    groups = _groups_for_page('efficacy', [(a, None), (b, None)],\n   121\t                              semantic_proposals=(_proposal(a, b),))\n   122\t    assert len(groups) == 2\n   123\t    assert {r['row_id'] for g in groups for r in g['rows']} == {'first', 'second'}\n","exit_code":0,"status":"completed"}}
