{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -c 'nl -ba tmp/semantic-rereview-a4bUhi/test_rereview.py'","aggregated_output":"     1\t\"\"\"Synthetic full-render and full-view projection audit; no production writes.\"\"\"\n     2\tfrom copy import deepcopy\n     3\t\n     4\timport pytest\n     5\tfrom playwright.sync_api import sync_playwright\n     6\t\n     7\tfrom ci_workflow.renderers.portal.report_b import (\n     8\t    ReportBPortalData, render_report_b_site, _groups_for_page,\n     9\t    _project_scientific_groups, _efficacy_records, _display_trial_name,\n    10\t)\n    11\tfrom tests.browser.test_b_semantic_proposals import proposal_data\n    12\tfrom tests.reports.b.test_semantic_grouping_proposals import _rows, _proposal\n    13\tfrom tests.reports.b.test_r13_semantic_grouping import _project_baseline\n    14\t\n    15\t\n    16\tdef payload():\n    17\t    result = deepcopy(proposal_data().model_dump(mode='json'))\n    18\t    result['semantic_proposals'] = []\n    19\t    return result\n    20\t\n    21\t\n    22\t@pytest.mark.parametrize('engine', ['chromium', 'webkit'])\n    23\tdef test_full_html_preserves_same_trial_longitudinal_series(tmp_path, engine):\n    24\t    data = payload()\n    25\t    first = data['efficacy_views']['facts'][0]\n    26\t    first['actual_timepoint'] = 12\n    27\t    first['group_id'] = 'active-arm'\n    28\t    second = dict(first, row_id='longitudinal-24', actual_timepoint=24, value=75)\n    29\t    data['efficacy_views']['facts'] = [first, second]\n    30\t    site = tmp_path / 'site'\n    31\t    render_report_b_site(ReportBPortalData.model_validate(data), site)\n    32\t    with sync_playwright() as p:\n    33\t        browser = getattr(p, engine).launch()\n    34\t        try:\n    35\t            page = browser.new_page()\n    36\t            page.goto((site / 'longitudinal-results.html').as_uri())\n    37\t            groups = page.evaluate('window.__CHART_GROUPS__')\n    38\t            assert {r['actual_timepoint'] for g in groups for r in g['rows']} == {12, 24}\n    39\t            assert len(groups) == 1 and all(r['_chart_type'] == 'line' for r in groups[0]['rows']), [\n    40\t                [(r['actual_timepoint'], r['_chart_type']) for r in g['rows']] for g in groups]\n    41\t        finally:\n    42\t            browser.close()\n    43\t\n    44\t\n    45\t@pytest.mark.parametrize('engine', ['chromium', 'webkit'])\n    46\tdef test_cross_domain_same_id_cannot_replace_safety_with_efficacy(tmp_path, engine):\n    47\t    data = payload()\n    48\t    first = data['efficacy_views']['facts'][0]\n    49\t    data['safety_views'] = {'facts': [dict(first, original_endpoint='TEAE',\n    50\t        original_definition='治疗期间不良事件', standard_term='TEAE', source_term='TEAE',\n    51\t        value=2, source_version_id='safety-source')]}\n    52\t    site = tmp_path / 'site'\n    53\t    # Rejecting conflicting identities is also a valid result.\n    54\t    try:\n    55\t        render_report_b_site(ReportBPortalData.model_validate(data), site)\n    56\t    except ValueError:\n    57\t        return\n    58\t    with sync_playwright() as p:\n    59\t        browser = getattr(p, engine).launch()\n    60\t        try:\n    61\t            page = browser.new_page()\n    62\t            page.goto((site / 'safety.html').as_uri())\n    63\t            groups = page.evaluate('window.__CHART_GROUPS__')\n    64\t            rows = [r for g in groups for r in g['rows']]\n    65\t            assert len(rows) == 1\n    66\t            assert rows[0]['value'] == 2, (rows[0]['value'], rows[0]['original_endpoint'])\n    67\t        finally:\n    68\t            browser.close()\n    69\t\n    70\t\n    71\tdef test_explicit_full_view_projection_rejects_fact_drift():\n    72\t    a, b = _rows()\n    73\t    full = _groups_for_page('efficacy', [(a, None), (b, None)],\n    74\t                            semantic_proposals=(_proposal(a, b),))\n    75\t    changed = dict(b, value=99)\n    76\t    with pytest.raises(ValueError):\n    77\t        _project_scientific_groups(full, [(changed, None)])\n    78\t\n    79\t\n    80\tdef test_full_universe_cannot_silently_ignore_cross_domain_positive_proposal():\n    81\t    a, _ = _rows()\n    82\t    b = _project_baseline('baseline-b', product_id='product-b', trial_id='trial-b', population='FAS')\n    83\t    full = [(dict(a, _domain='efficacy'), None), (dict(b, _domain='baseline'), None)]\n    84\t    with pytest.raises(ValueError):\n    85\t        _groups_for_page('product-trial-profiles', full, semantic_proposals=(_proposal(a, b),))\n    86\t\n    87\t\n    88\t@pytest.mark.parametrize('engine', ['chromium', 'webkit'])\n    89\tdef test_actual_product_projection_stable_after_reversing_input(tmp_path, engine):\n    90\t    data = payload()\n    91\t    second = data['efficacy_views']['facts'][1]\n    92\t    trial = next(t for t in data['trials'] if t['id'] == second['trial_id'])\n    93\t    third_trial = dict(trial, id='independent-third-trial')\n    94\t    data['trials'].append(third_trial)\n    95\t    third = dict(second, row_id='proposal-observation-2', trial_id=third_trial['id'],\n    96\t                 actual_timepoint=52, original_definition='第三种措辞', value=77)\n    97\t    data['efficacy_views']['facts'].append(third)\n    98\t    model = ReportBPortalData.model_validate(data)\n    99\t    names = {p.id: p.name for p in model.products}\n   100\t    trials = {t.id: _display_trial_name(t, names[t.product_id]) for t in model.trials}\n   101\t    rows = _efficacy_records(model, names, trials)\n   102\t    data['semantic_proposals'] = [_proposal(rows[0][0], rows[1][0]).model_dump(mode='json'),\n   103\t                                 _proposal(rows[1][0], rows[2][0]).model_dump(mode='json')]\n   104\t    observed = []\n   105\t    with sync_playwright() as p:\n   106\t        browser = getattr(p, engine).launch()\n   107\t        try:\n   108\t            page = browser.new_page()\n   109\t            for index in range(2):\n   110\t                site = tmp_path / f'site-{index}'\n   111\t                render_report_b_site(ReportBPortalData.model_validate(data), site)\n   112\t                page.goto((site / 'efficacy.html').as_uri())\n   113\t                full = page.evaluate('window.__CHART_GROUPS__')\n   114\t                expected = {r['row_id']: (g['scientific_group_id'], r['value'], r['actual_timepoint'])\n   115\t                            for g in full for r in g['rows'] if r['product_id'] == second['product_id']}\n   116\t                page.goto((site / 'products' / f\"{second['product_id']}.html\").as_uri())\n   117\t                detail = page.evaluate('window.__CHART_GROUPS__')\n   118\t                actual = {r['row_id']: (g['scientific_group_id'], r['value'], r['actual_timepoint'])\n   119\t                          for g in detail for r in g['rows'] if r['row_id'] in expected}\n   120\t                assert actual == expected\n   121\t                assert len(actual) == 2 and len({v[0] for v in actual.values()}) == 2\n   122\t                observed.append(actual)\n   123\t                data['efficacy_views']['facts'].reverse()\n   124\t            assert observed[0] == observed[1]\n   125\t        finally:\n   126\t            browser.close()\n","exit_code":0,"status":"completed"}}
