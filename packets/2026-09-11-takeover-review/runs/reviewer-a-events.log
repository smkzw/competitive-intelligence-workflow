str | None = None,\n  3477\t    detail_records: Sequence[tuple[dict[str, Any], Any]] | None = None,\n  3478\t    detail_kind: str | None = None,\n  3479\t    detail_id: str | None = None,\n  3480\t    publication_limitation_zh: str | None = None,\n  3481\t) -> dict[str, Any]:\n  3482\t    page_id = current or page.id\n  3483\t    records = (\n  3484\t        tuple(detail_records)\n  3485\t        if detail_records is not None\n  3486\t        else _page_records(\n  3487\t            data,\n  3488\t            page_id=page_id,\n  3489\t            names=names,\n  3490\t            trial_names=trial_names,\n  3491\t            efficacy=efficacy,\n  3492\t            safety=safety,\n  3493\t        )\n  3494\t    )\n  3495\t    if page_id == \"longitudinal-results\":\n  3496\t        scientific_groups = longitudinal_groups\n  3497\t    covered_ids = {str(row[\"row_id\"]) for group in scientific_groups for row in group[\"rows\"]}\n  3498\t    covered = [item for item in records if str(item[0][\"row_id\"]) in covered_ids]\n  3499\t    uncovered = [item for item in records if str(item[0][\"row_id\"]) not in covered_ids]\n  3500\t    groups = (\n  3501\t        *_project_scientific_groups(scientific_groups, covered),\n  3502\t        *_groups_for_page(page_id, uncovered, semantic_proposals=data.semantic_proposals),\n  3503\t    )\n  3504\t    has_domain_empty_state = bool(records) and all(\n  3505\t        row.get(\"_empty_state\") is True for row, _source in records\n  3506\t    )\n  3507\t    has_drawable_data = any(row.get(\"renderable\") is True for row, _source in records)\n  3508\t    views = tuple(\n  3509\t        _evidence_view(\n  3510\t            data,\n  3511\t            row=row,\n  3512\t            source=source,\n  3513\t            page_id=page.id,\n  3514\t            observation_kind=_observation_kind_for_row(row, page.id),\n  3515\t            names=names,\n  3516\t            trial_names=trial_names,\n  3517\t        )\n  3518\t        for row, source