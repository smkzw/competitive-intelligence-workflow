{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -c 'nl -ba src/ci_workflow/reports/b/semantic_grouping.py'","aggregated_output":"     1\t\"\"\"Bound model proposals for candidate B views; not an independent acceptance receipt.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport hashlib\n     6\timport json\n     7\tfrom collections.abc import Mapping, Sequence\n     8\tfrom typing import Any, Literal\n     9\t\n    10\tfrom pydantic import BaseModel, ConfigDict, TypeAdapter, field_validator, model_validator\n    11\t\n    12\tfrom ci_workflow.reports.b.semantic_contract import (\n    13\t    ClinicalConstructObservation,\n    14\t    compare_clinical_constructs,\n    15\t    semantic_value_is_unknown,\n    16\t)\n    17\t\n    18\tSEMANTIC_POLICY_VERSION = \"b-candidate-hard-axes-v2\"\n    19\t_SOURCE_JSON = TypeAdapter(Any)\n    20\t\n    21\t\n    22\tdef semantic_source_digest(value: Any) -> str:\n    23\t    \"\"\"Bind the complete supplied fact, including locator and derivation metadata.\n    24\t\n    25\t    This binds declared provenance; it does not attest that external bytes were\n    26\t    retrieved or independently verified. Those remain acquisition/review gates.\n    27\t    \"\"\"\n    28\t    return hashlib.sha256(json.dumps(\n    29\t        _SOURCE_JSON.dump_python(value, mode=\"json\"), ensure_ascii=False,\n    30\t        sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n    31\t    ).encode()).hexdigest()\n    32\t\n    33\t\n    34\tclass SemanticGroupingProposal(BaseModel):\n    35\t    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n    36\t\n    37\t    schema_version: Literal[\"1\"] = \"1\"\n    38\t    status: Literal[\"proposal\"] = \"proposal\"\n    39\t    proposal_id: str\n    40\t    row_ids: tuple[str, str]\n    41\t    row_digests: tuple[str, str]\n    42\t    compatible: bool\n    43\t    time_window_compatible: bool = False\n    44\t    producer_id: str\n    45\t    rationale_zh: str\n    46\t\n    47\t    @field_validator(\"proposal_id\", \"producer_id\", \"rationale_zh\")\n    48\t    @classmethod\n    49\t    def nonempty(cls, value: str) -> str:\n    50\t        if not value.strip():\n    51\t            raise ValueError(\"语义提案标识与理由不能为空\")\n    52\t        return value.strip()\n    53\t\n    54\t    @model_validator(mode=\"after\")\n    55\t    def binding(self) -> SemanticGroupingProposal:\n    56\t        if len(set(self.row_ids)) != 2 or any(not value.strip() for value in self.row_ids):\n    57\t            raise ValueError(\"语义提案必须绑定两个不同观察\")\n    58\t        if any(len(value) != 64 or any(c not in \"0123456789abcdef\" for c in value)\n    59\t               for value in self.row_digests):\n    60\t            raise ValueError(\"语义提案必须绑定完整观察摘要\")\n    61\t        return self\n    62\t\n    63\t\n    64\tdef semantic_row_digest(row: Mapping[str, Any]) -> str:\n    65\t    \"\"\"Bind policy, complete supplied fact digest, and projected clinical values.\"\"\"\n    66\t    payload = {key: value for key, value in row.items() if not key.startswith(\"_\")}\n    67\t    payload[\"_source_binding\"] = row.get(\"_source_binding\")\n    68\t    payload[\"_semantic_policy\"] = SEMANTIC_POLICY_VERSION\n    69\t    return hashlib.sha256(json.dumps(\n    70\t        payload, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n    71\t    ).encode()).hexdigest()\n    72\t\n    73\t\n    74\tdef _observation(row: Mapping[str, Any]) -> ClinicalConstructObservation:\n    75\t    return ClinicalConstructObservation.model_validate({\n    76\t        \"observation_id\": row[\"row_id\"],\n    77\t        \"clinical_construct\": row.get(\"clinical_concept\", \"not_reported\"),\n    78\t        \"definition\": row.get(\"semantic_definition\", \"not_reported\"),\n    79\t        \"direction\": row.get(\"semantic_direction\", \"not_reported\"),\n    80\t        \"unit\": row.get(\"unit\", \"not_reported\"),\n    81\t        \"estimand\": row.get(\"semantic_estimand\", \"not_reported\"),\n    82\t        \"denominator\": row.get(\"semantic_denominator\", \"not_reported\"),\n    83\t        \"analysis_set\": row.get(\"semantic_analysis_set\", \"not_reported\"),\n    84\t        \"analysis_form\": row.get(\"semantic_analysis_form\", \"not_reported\"),\n    85\t        \"instrument_or_scale\": row.get(\"semantic_instrument_or_scale\", \"not_reported\"),\n    86\t        \"actual_timepoint\": row.get(\"actual_timepoint\"),\n    87\t        \"actual_timepoint_unit\": row.get(\"actual_timepoint_unit\"),\n    88\t    })\n    89\t\n    90\t\n    91\tdef proposed_semantic_buckets(\n    92\t    buckets: Sequence[Sequence[tuple[dict[str, Any], Any]]],\n    93\t    proposals: Sequence[SemanticGroupingProposal],\n    94\t    *, descriptive_only: bool = False,\n    95\t) -> tuple[tuple[tuple[dict[str, Any], Any], ...], ...]:\n    96\t    \"\"\"Complete-link grouping: no transitive compatibility and no dropped observations.\n    97\t\n    98\t    Same-trial descriptive groups remain available. Every cross-trial pair passes\n    99\t    the deterministic guard, including pairs for which no proposal was supplied.\n   100\t    \"\"\"\n   101\t    rows: dict[str, tuple[dict[str, Any], Any]] = {}\n   102\t    origin: dict[str, int] = {}\n   103\t    for index, bucket in enumerate(buckets):\n   104\t        for item in bucket:\n   105\t            row_id = str(item[0][\"row_id\"])\n   106\t            if row_id in rows:\n   107\t                raise ValueError(\"语义视图观察标识重复\")\n   108\t            rows[row_id] = item\n   109\t            origin[row_id] = index\n   110\t    pairs: dict[frozenset[str], SemanticGroupingProposal] = {}\n   111\t    for proposal in proposals:\n   112\t        proposal = SemanticGroupingProposal.model_validate(proposal.model_dump(mode=\"json\"))\n   113\t        for row_id, digest in zip(proposal.row_ids, proposal.row_digests, strict=True):\n   114\t            if row_id in rows and semantic_row_digest(rows[row_id][0]) != digest:\n   115\t                raise ValueError(\"语义提案观察摘要不一致，必须重新研究和复核\")\n   116\t        if not set(proposal.row_ids).issubset(rows):\n   117\t            continue  # Another physical page may own the other observation.\n   118\t        if descriptive_only and proposal.compatible:\n   119\t            raise ValueError(\"该域目前仅支持描述性展示，不能接受正向语义裁决提案\")\n   120\t        key = frozenset(proposal.row_ids)\n   121\t        if key in pairs:\n   122\t            raise ValueError(\"同一观察对存在重复语义提案\")\n   123\t        pairs[key] = proposal\n   124\t\n   125\t    def compatible(left_id: str, right_id: str) -> bool:\n   126\t        proposal = pairs.get(frozenset((left_id, right_id)))\n   127\t        if proposal is None:\n   128\t            if origin[left_id] != origin[right_id]:\n   129\t                return False\n   130\t            if descriptive_only:\n   131\t                return True\n   132\t            left_row, right_row = rows[left_id][0], rows[right_id][0]\n   133\t            if (left_row.get(\"trial_id\") and\n   134\t                    left_row.get(\"trial_id\") == right_row.get(\"trial_id\") and\n   135\t                    left_row.get(\"product_id\") == right_row.get(\"product_id\")):\n   136\t                return True  # Within-trial longitudinal description, not cross-trial equivalence.\n   137\t        elif not proposal.compatible:\n   138\t            return False\n   139\t        try:\n   140\t            left, right = _observation(rows[left_id][0]), _observation(rows[right_id][0])\n   141\t        except ValueError:\n   142\t            return False\n   143\t        if any(semantic_value_is_unknown(value) for value in (\n   144\t            left.clinical_construct, left.definition, right.clinical_construct, right.definition,\n   145\t        )):\n   146\t            return False\n   147\t        if proposal is None:\n   148\t            return compare_clinical_constructs(left, right).compatible\n   149\t        if left.timepoint_weeks != right.timepoint_weeks and not proposal.time_window_compatible:\n   150\t            return False\n   151\t        # Only wording is proposed equivalent. Original rows remain unchanged.\n   152\t        right_for_guard = right.model_copy(update={\n   153\t            \"clinical_construct\": left.clinical_construct, \"definition\": left.definition,\n   154\t        })\n   155\t        return compare_clinical_constructs(left, right_for_guard).compatible\n   156\t\n   157\t    groups: list[list[str]] = []\n   158\t    for row_id in sorted(rows):\n   159\t        for group in groups:\n   160\t            if all(compatible(row_id, existing) for existing in group):\n   161\t                group.append(row_id)\n   162\t                break\n   163\t        else:\n   164\t            groups.append([row_id])\n   165\t    return tuple(tuple(rows[row_id] for row_id in group) for group in groups)\n","exit_code":0,"status":"completed"}}
