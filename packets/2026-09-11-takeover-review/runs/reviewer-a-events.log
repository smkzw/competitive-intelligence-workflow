{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -c \"nl -ba src/ci_workflow/reports/common/page-catalogs/B.yaml | sed -n '1,205p'\"","aggregated_output":"     1\tcontract_version: \"1.0\"\n     2\treport: B\n     3\tportal_title_pattern: \"{适应症}临床试验结果比较\"\n     4\tselection_policy:\n     5\t  top_n_allowed: false\n     6\t  all_in_scope_objects_visible: true\n     7\t  default_product_order: \"按靶点分组，组内按稳定产品标识\"\n     8\tpresentation_policy:\n     9\t  chart_before_table: true\n    10\t  graph_and_table_same_fact_set: true\n    11\t  complete_table_never_replaced_by_summary: true\n    12\tselection_rules:\n    13\t  version: \"1.0\"\n    14\t  anchor_trial: \"依次按注册角色、研究阶段、结果披露成熟度和稳定试验标识选择；不使用疗效或安全性数值偏好。\"\n    15\t  endpoint_family: \"同时并列显示适用指导原则推荐的主要终点族与核心竞品共同采用的主要终点族；各终点族均完整保留。\"\n    16\t  common_ae_rows: \"强制摘要行优先；其余依次按预定义特别关注不良事件与临床重要性、具有可比已报告值的产品数、最大绝对治疗—对照差、最高报告发生率和稳定术语标识选择默认显示行，不形成安全性排名。\"\n    17\t  baseline_variable_order: \"疾病严重程度与关键判定指标、人口学、疾病背景、既往与合并治疗、其他预设变量；组内按规范变量标识。\"\n    18\t  disposition_field_order: \"筛选与筛败、随机与接受治疗、完成治疗与完成研究、停止治疗与退出研究、失访、依从性、补救治疗、禁用药、方案偏离。\"\n    19\tbubble_chart_contract:\n    20\t  y_axis: 原始治疗期间不良事件发生率倒序\n    21\t  y_axis_annotation: \"向上 = 发生率更低 = 观察到的安全性位置更有利\"\n    22\t  x_axis_direction: 越右表示所选疗效指标的观察信号越强\n    23\t  radius_formula: \"r = k × sqrt(N/pi)\"\n    24\t  no_pooling: true\n    25\t  no_composite_score: true\n    26\tpages:\n    27\t  - id: overview\n    28\t    route: /b/overview\n    29\t    title: 首页\n    30\t    navigation_group: 总览\n    31\t    responsibility: \"图在前展示适用指导原则和核心竞品共同采用的主要终点、关键安全性及疗效安全性位置。\"\n    32\t    visuals: [疗效分组柱状图, 安全性热图, 疗效安全性气泡图]\n    33\t    complete_table: true\n    34\t    filter_profiles: [b-overview, b-matrix]\n    35\t    evidence_drawer_profile: common-clinical\n    36\t  - id: efficacy\n    37\t    route: /b/efficacy\n    38\t    title: 疗效\n    39\t    navigation_group: 疗效与安全性\n    40\t    responsibility: \"展示全部已抽取终点，治疗组与对照组始终并列，并保留原始定义、角色、时间点和差异标记。\"\n    41\t    visuals: [分组柱状图, 不合并森林图, 小多图]\n    42\t    complete_table: true\n    43\t    filter_profiles: [b-efficacy]\n    44\t    evidence_drawer_profile: common-clinical\n    45\t  - id: longitudinal-results\n    46\t    route: /b/longitudinal-results\n    47\t    title: 纵向结果\n    48\t    navigation_group: 疗效与安全性\n    49\t    responsibility: \"按产品、试验、终点和时间点展示纵向序列，不用多轴或未披露统一评分制造可比性。\"\n    50\t    visuals: [折线图, 纵向小多图]\n    51\t    complete_table: true\n    52\t    filter_profiles: [b-longitudinal]\n    53\t    evidence_drawer_profile: common-clinical\n    54\t  - id: safety\n    55\t    route: /b/safety\n    56\t    title: 安全性\n    57\t    navigation_group: 疗效与安全性\n    58\t    responsibility: \"比较严重不良事件、特别关注事件、常见事件及发生率，数值印在热图单元格并区分各种披露状态。\"\n    59\t    visuals: [安全性热图, 事件发生率点图, 小多图]\n    60\t    complete_table: true\n    61\t    filter_profiles: [b-safety]\n    62\t    evidence_drawer_profile: common-clinical\n    63\t  - id: baseline-overview\n    64\t    route: /b/baseline-overview\n    65\t    title: 基线与人群总览\n    66\t    navigation_group: 基线与人群\n    67\t    responsibility: \"概览各试验治疗组与对照组的人口学、疾病语境和基线严重程度，不把均值与中位数或不兼容量表混画。\"\n    68\t    visuals: [基线变量覆盖矩阵, 分组点图, 比例柱状图]\n    69\t    complete_table: true\n    70\t    filter_profiles: [b-baseline]\n    71\t    evidence_drawer_profile: baseline-observation\n    72\t  - id: baseline-demographics\n    73\t    route: /b/baseline-demographics\n    74\t    title: 人口学\n    75\t    navigation_group: 基线与人群\n    76\t    responsibility: \"比较组别样本量、年龄、性别以及公开的种族、地区、体重等人口学变量，保留来源分类和分母。\"\n    77\t    visuals: [分组点图, 区间图, 比例柱状图]\n    78\t    complete_table: true\n    79\t    filter_profiles: [b-baseline-demographics]\n    80\t    evidence_drawer_profile: baseline-observation\n    81\t  - id: baseline-disease-context\n    82\t    route: /b/baseline-disease-context\n    83\t    title: 疾病语境\n    84\t    navigation_group: 基线与人群\n    85\t    responsibility: \"比较病程、既往与背景治疗、表型、既往事件、相关合并症和生物标志物。\"\n    86\t    visu