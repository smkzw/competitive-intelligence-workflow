           item for item in data.companies if item.product_id == product.id\n  3817\t        )\n  3818\t        context[\"detail_product_patents\"] = tuple(\n  3819\t            item for item in data.patents if item.product_id == product.id\n  3820\t        )\n  3821\t        context[\"detail_product_history\"] = tuple(\n  3822\t            item for item in data.history if item.product_id == product.id\n  3823\t        )\n  3824\t        output = products_dir / f\"{product.id}.html\"\n  3825\t        output.write_text(dossier_template.render(**context), encoding=\"utf-8\")\n  3826\t        generated.append(output)\n  3827\t\n  3828\t    for trial in data.trials:\n  3829\t        records = tuple(item for item in detail_pool if item[0].get(\"trial_id\") == trial.id)\n  3830\t        context = _render_page_context(\n  3831\t            data,\n  3832\t            page=profile_page,\n  3833\t            catalog=catalog,\n  3834\t            names=names,\n  3835\t            trial_names=trial_names,\n  3836\t            efficacy=efficacy,\n  3837\t            safety=safety,\n  3838\t            scientific_groups=scientific_groups,\n  3839\t            prefix=\"../\",\n  3840\t            current=profile_page.id,\n  3841\t            detail_records=records\n  3842\t            or tuple(\n  3843\t                item\n  3844\t                for item in _synthetic_status_records(\n  3845\t                    data,\n  3846\t                    page_id=f\"trial-{trial.id}\",\n  3847\t                    names=names,\n  3848\t                    trial_names=trial_names,\n  3849\t                )\n  3850\t                if item[0].get(\"trial_id\") == trial.id\n  3851\t            ),\n  3852\t            detail_kind=\"trial\",\n  3853\t            detail_id=trial.id,\n  3854\t            publication_limitation_zh=publication_limitation_zh,\n  3855\t        )\n  3856\t        context[\"detail_trial_product_obj\"] = next(\n  3857\t            product for product in data.product