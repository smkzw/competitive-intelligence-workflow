{"type":"user","uuid":"01a08c81-1476-7086-bf9e-718e68310fe1","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_01a08c8113537081b0b26192","content":[{"type":"text","text":" 150→        _, raw, body = text.split(\"---\\n\", 2)\n 151→        value = yaml.safe_load(raw)\n 152→    except (ValueError, yaml.YAMLError) as exc:\n 153→        raise ContractError(f\"Skill 元数据无法读取：{path}\") from exc\n 154→    if not isinstance(value, dict) or not body.strip():\n 155→        raise ContractError(f\"Skill 元数据或正文为空：{path}\")\n 156→    if set(value) != {\"name\", \"description\"}:\n 157→        raise ContractError(f\"Skill 元数据只能包含 name 和 description：{path}\")\n 158→    if \"TODO\" in text:\n 159→        raise ContractError(f\"Skill 仍含模板占位内容：{path}\")\n 160→    return cast(dict[str, Any], value)\n 161→\n 162→\n 163→def _verify_asset_manifests(root: Path) -> None:\n 164→    brand = _load_json(root / \"assets/brand/manifest.json\")\n 165→    _verify_digest(root / \"assets/brand\" / str(brand[\"file\"]), str(brand[\"sha256\"]))\n 166→    _verify_digest(root / str(brand[\"source\"]), str(brand[\"sha256\"]))\n 167→\n 168→    portal = _load_json(root / \"assets/portal/manifest.json\")\n 169→    portal_files = cast(dict[str, dict[str, Any]], portal[\"files\"])\n 170→    portal_root = root / \"assets/portal\"\n 171→    echarts_source = root / str(portal.get(\"echarts_source\", \"\"))\n 172→    for relative_path, record in portal_files.items():\n 173→        if not isinstance(record, dict):\n 174→            raise ContractError(f\"门户资源清单条目无效：{relative_path}\")\n 175→        asset_path = (\n 176→            echarts_source if relative_path == \"echarts.min.js\" else portal_root / relative_path\n 177→        )\n 178→        _verify_digest(asset_path, str(record[\"sha256\"]))\n 179→    echarts = _load_json(root / \"assets/third-party/echarts/manifest.json\")\n 180→    echarts_root = root / \"assets/third-party/echarts\"\n 181→    _verify_digest(echarts_root / str(echarts[\"bundle\"]), str(echarts[\"bundle_sha256\"]))\n 182→    _verify_digest(\n 183→        echarts_root / str(echarts[\"license_file\"]),\n 184→        str(echarts[\"license_sha256\"]),\n 185→    )\n 186→\n 187→\n 188→def _verify_kangzhe_contract(root: Path) -> None:\n 189→    manifest = _load_json(root / \"contracts/kangzhe/manifest.json\")\n 190→    runtime = cast(dict[str, Any], manifest[\"runtime\"])\n 191→    files = cast(dict[str, str], runtime[\"files\"])\n 192→    contract_root = root / \"contracts/kangzhe\"\n 193→    for relative_path, expected in files.items():\n 194→        _verify_digest(contract_root / relative_path, expected)\n 195→\n 196→\n 197→def verify_package(root: Path) -> dict[str, Any]:\n 198→    root = root.resolve()\n 199→    manifest = _load_json(root / \"package-manifest.json\")\n 200→    schema = _load_json(root / \"schemas/package-manifest.schema.json\")\n 201→    try:\n 202→        Draft202012Validator.check_schema(schema)\n 203→        Draft202012Validator(schema).validate(manifest)\n 204→    except (SchemaError, ValidationError) as exc:\n 205→        raise ContractError(f\"安装包清单不符合合同：{exc.message}\") from exc\n 206→\n 207→    try:\n 208→        project = tomllib.loads((root / \"pyproject.toml\").read_text(encoding=\"utf-8\"))[\"project\"]\n 209→    except (FileNotFoundError, tomllib.TOMLDecodeError, KeyError) as exc:\n 210→        raise ContractError(\"无法读取 pyproject.toml 中的项目版本\") from exc\n 211→    package = cast(dict[str, Any], manifest[\"package\"])\n 212→    if package[\"name\"] != project[\"name\"] or package[\"version\"] != project[\"version\"]:\n 213→        raise ContractError(\"安装包名称或版本与 pyproject.toml 不一致\")\n 214→    if package[\"cli_version\"] != __version__:\n 215→        raise ContractError(\"安装包声明的 CLI 版本与实际模块不一致\")\n 216→    if package.get(\"release_scope\") != \"site_html_v1\":\n 217→        raise ContractError(\"安装包 release_scope 必须是 site_html_v1\")\n 218→    if package.get(\"formats\") != [\"html\"]:\n 219→        raise ContractError(\"安装包首版格式必须严格为 html\")\n 220→\n 221→    public_path = root / str(manifest[\"public_skill\"])\n 222→    if _skill_frontmatter(public_path)[\"name\"] != PUBLIC_SKILL_TRIGGER:\n 223→        raise ContractError(\"公开 Skill 触发词不符合安装合同\")\n 224→    public_agent = _load_json_or_yaml(public_path.parent / \"agents/openai.yaml\")\n 225→    public_interface = cast(dict[str, Any], public_agent.get(\"interface\", {}))\n 226→    if \"$competitive-intelligence-workflow\" not in str(public_interface.get(\"default_prompt\", \"\")):\n 227→        raise ContractError(\"公开 Skill 默认提示未绑定自身 Skill\")\n 228→\n 229→    internal_items = cast(list[dict[str, Any]], manifest[\"internal_skills\"])\n 230→    declared_ids = {str(item[\"id\"]) for item in internal_items}\n 231→    if declared_ids != EXPECTED_INTERNAL_SKILLS:\n 232→        raise ContractError(\"内部 Skill 集合与冻结合同不一致\")\n 233→    actual_ids = {path.parent.name for path in (root / \"skills/_internal\").glob(\"*/SKILL.md\")}\n 234→    unexpected_ids = actual_ids - EXPECTED_INTERNAL_SKILLS - HISTORICAL_INTERNAL_SKILLS\n 235→    if not EXPECTED_INTERNAL_SKILLS.issubset(actual_ids) or unexpected_ids:\n 236→        raise ContractError(\"安装包中的内部 Skill 目录与冻结合同不一致\")\n 237→    for item in internal_items:\n 238→        skill_id = str(item[\"id\"])\n 239→        skill_path = root / str(item[\"path\"])\n 240→        if _skill_frontmatter(skill_path)[\"name\"] != skill_id:\n 241→            raise ContractError(f\"内部 Skill 名称与清单不一致：{skill_id}\")\n 242→        agent = _load_json_or_yaml(skill_path.parent / \"agents/openai.yaml\")\n 243→        interface = cast(dict[str, Any], agent.get(\"interface\", {}))\n 244→        if f\"${skill_id}\" not in str(interface.get(\"default_prompt\", \"\")):\n 245→            raise ContractError(f\"内部 Skill 默认提示未绑定自身 Skill：{skill_id}\")\n 246→        policy = cast(dict[str, Any], agent.get(\"policy\", {}))\n 247→        if policy.get(\"allow_implicit_invocation\") is not False:\n 248→            raise ContractError(f\"内部 Skill 必须关闭隐式调用：{skill_id}\")\n 249→\n 250→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_01_Lu0OJcaEYTbMXclQKXlC2249","_requestId":"01a08c80d69378c3a0a9754f180e6443","_messageId":"01a08c810b79716baad450b3437bed9c","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d69378c3a0a9754f180e6443","codebuddy.ai/modelRequestId":"01a08c810b79716baad450b3437bed9c","codebuddy.ai/llmMessageId":"01a08c810b79716baad450b3437bed9c","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:44.758Z"}
{"type":"user","uuid":"01a08c81-1477-74bb-abe0-38d8eedabf95","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_01a08c8113537081b0b261ae","content":[{"type":"text","text":" 450→\n 451→\n 452→class TestPortalShell:\n 453→    \"\"\"Portal shell acceptance matrix.\"\"\"\n 454→\n 455→    def test_packaged_assets_match_repo_and_official_logo(self) -> None:\n 456→        module_assets = ROOT / \"src\" / \"ci_workflow\" / \"renderers\" / \"portal\" / \"assets\"\n 457→        repo_css = ROOT / \"assets\" / \"portal\" / \"portal.css\"\n 458→        repo_js = ROOT / \"assets\" / \"portal\" / \"portal.js\"\n 459→        module_css = module_assets / \"portal.css\"\n 460→        module_js = module_assets / \"portal.js\"\n 461→        module_logo = module_assets / \"cms-logo.svg\"\n 462→        brand_logo = ROOT / \"assets\" / \"brand\" / \"cms-logo.svg\"\n 463→\n 464→        assert module_css.read_bytes() == repo_css.read_bytes()\n 465→        assert module_js.read_bytes() == repo_js.read_bytes()\n 466→        assert module_logo.read_bytes() == brand_logo.read_bytes()\n 467→        assert hashlib.sha256(module_logo.read_bytes()).hexdigest() == OFFICIAL_LOGO_SHA256\n 468→\n 469→        manifest = json.loads(\n 470→            (ROOT / \"assets\" / \"portal\" / \"manifest.json\").read_text(encoding=\"utf-8\")\n 471→        )\n 472→        assert (\n 473→            hashlib.sha256(repo_css.read_bytes()).hexdigest()\n 474→            == manifest[\"files\"][\"portal.css\"][\"sha256\"]\n 475→        )\n 476→        assert (\n 477→            hashlib.sha256(repo_js.read_bytes()).hexdigest()\n 478→            == manifest[\"files\"][\"portal.js\"][\"sha256\"]\n 479→        )\n 480→\n 481→    def test_wheel_install_can_build_portal(self, tmp_path: Path) -> None:\n 482→        dist_dir = tmp_path / \"dist\"\n 483→        venv_dir = tmp_path / \"wheel-venv\"\n 484→        site_dir = tmp_path / \"wheel-site\"\n 485→        dist_dir.mkdir()\n 486→        build = subprocess.run(\n 487→            [\"uv\", \"build\", \"--wheel\", \"--out-dir\", str(dist_dir)],\n 488→            cwd=ROOT,\n 489→            check=False,\n 490→            capture_output=True,\n 491→            text=True,\n 492→        )\n 493→        assert build.returncode == 0, build.stderr or build.stdout\n 494→        wheels = list(dist_dir.glob(\"*.whl\"))\n 495→        assert len(wheels) == 1, wheels\n 496→\n 497→        create = subprocess.run(\n 498→            [\"uv\", \"venv\", str(venv_dir), \"--python\", \"3.13\"],\n 499→            cwd=ROOT,\n 500→            check=False,\n 501→            capture_output=True,\n 502→            text=True,\n 503→        )\n 504→        assert create.returncode == 0, create.stderr or create.stdout\n 505→        install = subprocess.run(\n 506→            [\"uv\", \"pip\", \"install\", \"--python\", str(venv_dir / \"bin\" / \"python\"), str(wheels[0])],\n 507→            cwd=ROOT,\n 508→            check=False,\n 509→            capture_output=True,\n 510→            text=True,\n 511→        )\n 512→        assert install.returncode == 0, install.stderr or install.stdout\n 513→\n 514→        probe = subprocess.run(\n 515→            [\n 516→                str(venv_dir / \"bin\" / \"python\"),\n 517→                \"-c\",\n 518→                (\n 519→                    \"from pathlib import Path\\n\"\n 520→                    \"from ci_workflow.renderers.portal import (\"\n 521→                    \"NavEntry, PageSpec, PortalSpec, build_portal, resolve_logo_src, \"\n 522→                    \"resolve_portal_asset)\\n\"\n 523→                    f\"out = Path({str(site_dir)!r})\\n\"\n 524→                    \"spec = PortalSpec(\\n\"\n 525→                    \"  title='特应性皮炎竞品全景',\\n\"\n 526→                    \"  pages=[\\n\"\n 527→                    \"    PageSpec(slug='overview', title='竞品全景', nav_label='竞品全景',\"\n 528→                    \" sections=['靶点分布'], body_text='展示竞品格局要点。'),\\n\"\n 529→                    \"    PageSpec(slug='efficacy', title='疗效比较', nav_label='疗效比较',\"\n 530→                    \" sections=['主要终点'], body_text='终点比较展示。'),\\n\"\n 531→                    \"    PageSpec(slug='safety', title='安全性比较', nav_label='安全性比较',\"\n 532→                    \" sections=['常见不良事件'], body_text='安全性分层展示。'),\\n\"\n 533→                    \"  ],\\n\"\n 534→                    \"  nav=[\\n\"\n 535→                    \"    NavEntry(label='竞品全景', slug='overview'),\\n\"\n 536→                    \"    NavEntry(label='疗效比较', slug='efficacy'),\\n\"\n 537→                    \"    NavEntry(label='安全性比较', slug='safety'),\\n\"\n 538→                    \"  ],\\n\"\n 539→                    \")\\n\"\n 540→                    \"paths = build_portal(spec, out)\\n\"\n 541→                    \"logo = resolve_logo_src()\\n\"\n 542→                    \"css = resolve_portal_asset('portal.css')\\n\"\n 543→                    \"print('PAGES', len(paths))\\n\"\n 544→                    \"print('LOGO', logo.exists(), logo.name)\\n\"\n 545→                    \"print('CSS', css.exists())\\n\"\n 546→                    \"print('OUT_LOGO', (out / 'assets' / 'logo.svg').exists())\\n\"\n 547→                    \"print('OUT_CSS', (out / 'assets' / 'portal.css').exists())\\n\"\n 548→                    \"print('OUT_JS', (out / 'assets' / 'portal.js').exists())\\n\"\n 549→                ),\n 550→            ],\n 551→            cwd=tmp_path,\n 552→            check=False,\n 553→            capture_output=True,\n 554→            text=True,\n 555→        )\n 556→        assert probe.returncode == 0, probe.stderr or probe.stdout\n 557→        assert \"PAGES 3\" in probe.stdout\n 558→        assert \"OUT_LOGO True\" in probe.stdout\n 559→        assert \"OUT_CSS True\" in probe.stdout\n 560→        assert \"OUT_JS True\" in probe.stdout\n 561→        assert (site_dir / \"overview.html\").exists()\n 562→        assert (site_dir / \"assets\" / \"logo.svg\").exists()\n 563→\n 564→    @pytest.mark.parametrize(\"browser_name\", BROWSERS)\n 565→    def test_logo_visible_upper_left_with_real_dimensions(\n 566→        self, browser_name: str, tmp_path: Path\n 567→    ) -> None:\n 568→        portal_dir = _build_portal(tmp_path)\n 569→        url = (portal_dir / \"overview.html\").as_uri()\n 570→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_01_Lu0OJcaEYTbMXclQKXlC2249","_requestId":"01a08c80d69378c3a0a9754f180e6443","_messageId":"01a08c810b79716baad450b3437bed9c","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d69378c3a0a9754f180e6443","codebuddy.ai/modelRequestId":"01a08c810b79716baad450b3437bed9c","codebuddy.ai/llmMessageId":"01a08c810b79716baad450b3437bed9c","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:44.759Z"}
