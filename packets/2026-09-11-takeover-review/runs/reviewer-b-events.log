{"type":"user","uuid":"01a08c81-23f5-768c-9719-5548790ca9bc","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_dSilScje6t5h91O9mYiHY40j","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→import hashlib\n   4→import re\n   5→from datetime import datetime\n   6→from typing import Literal\n   7→from urllib.parse import urlsplit\n   8→\n   9→from pydantic import BaseModel, ConfigDict, field_validator, model_validator\n  10→\n  11→from ci_workflow.domain.evidence import EvidenceLocator\n  12→from ci_workflow.domain.ids import stable_id\n  13→from ci_workflow.sources.policy import (\n  14→    ClaimDomain,\n  15→    SourceAuthority,\n  16→    SourcePolicy,\n  17→)\n  18→\n  19→APPROVED_WECHAT_ACCOUNT_LABELS = {\n  20→    \"medical_cube_info\": \"医药魔方info\",\n  21→    \"pharnex_circle\": \"药融圈\",\n  22→    \"dxy_insight_database\": \"丁香园Insight数据库\",\n  23→    \"menet\": \"米内网\",\n  24→    \"china_drug_review\": \"中国药审\",\n  25→}\n  26→\n  27→_APPROVED_DIRECT_DOMAINS = frozenset(\n  28→    {\n  29→        ClaimDomain.EFFICACY_SAFETY_RESULTS,\n  30→        ClaimDomain.CHINA_DEVELOPMENT_REGULATORY_STATUS,\n  31→        ClaimDomain.COMPANY_RELATIONSHIPS_TRANSACTIONS,\n  32→        ClaimDomain.PATENTS_PROTECTION,\n  33→    }\n  34→)\n  35→_SHA256 = re.compile(r\"[0-9a-f]{64}\")\n  36→\n  37→\n  38→def _required_text(value: str) -> str:\n  39→    normalized = \" \".join(value.split())\n  40→    if not normalized:\n  41→        raise ValueError(\"指定行业信息来源字段不能为空\")\n  42→    return normalized\n  43→\n  44→\n  45→def _offset_datetime(value: str) -> datetime:\n  46→    parsed = datetime.fromisoformat(value)\n  47→    if parsed.tzinfo is None or parsed.utcoffset() is None:\n  48→        raise ValueError(\"指定行业信息来源日期时间必须包含明确时区\")\n  49→    return parsed\n  50→\n  51→\n  52→class AuthoritativeWechatArticleVersion(BaseModel):\n  53→    \"\"\"用户指定行业公众号文章的不可变版本与限定证据角色。\"\"\"\n  54→\n  55→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  56→\n  57→    source_id: str\n  58→    account_label_zh: str\n  59→    source_record_id: str\n  60→    source_version_id: str\n  61→    external_record_id: str\n  62→    title: str\n  63→    article_role: Literal[\"authoritative_secondary_disclosure\"] = (\n  64→        \"authoritative_secondary_disclosure\"\n  65→    )\n  66→    source_role_label_zh: Literal[\"指定行业信息来源\"] = \"指定行业信息来源\"\n  67→    disclosure_maturity_label_zh: str = \"行业信息文章披露\"\n  68→    is_peer_reviewed_publication: bool = False\n  69→    direct_claim_domains: tuple[ClaimDomain, ...]\n  70→    authorities: dict[ClaimDomain, SourceAuthority]\n  71→    policy_id: str\n  72→    policy_version: str\n  73→    product_identity: str | None = None\n  74→    trial_identity: str | None = None\n  75→    event_identity: str | None = None\n  76→    published_at: datetime\n  77→    acquired_at: datetime\n  78→    content_snapshot: str\n  79→    content_sha256: str\n  80→    source_url: str\n  81→    locator: EvidenceLocator\n  82→\n  83→    @field_validator(\n  84→        \"source_id\",\n  85→        \"account_label_zh\",\n  86→        \"source_record_id\",\n  87→        \"source_version_id\",\n  88→        \"external_record_id\",\n  89→        \"title\",\n  90→        \"disclosure_maturity_label_zh\",\n  91→        \"policy_id\",\n  92→        \"policy_version\",\n  93→        \"source_url\",\n  94→        \"content_snapshot\",\n  95→    )\n  96→    @classmethod\n  97→    def _text_is_not_blank(cls, value: str) -> str:\n  98→        return _required_text(value)\n  99→\n 100→    @field_validator(\"product_identity\", \"trial_identity\", \"event_identity\")\n 101→    @classmethod\n 102→    def _optional_identity_is_not_blank(cls, value: str | None) -> str | None:\n 103→        return None if value is None else _required_text(value)\n 104→\n 105→    @field_validator(\"content_sha256\")\n 106→    @classmethod\n 107→    def _content_sha_is_valid(cls, value: str) -> str:\n 108→        if _SHA256.fullmatch(value) is None:\n 109→            raise ValueError(\"指定行业信息来源摘要必须是小写 SHA-256\")\n 110→        return value\n 111→\n 112→    @field_validator(\"published_at\", \"acquired_at\")\n 113→    @classmethod\n 114→    def _times_have_offsets(cls, value: datetime) -> datetime:\n 115→        if value.tzinfo is None or value.utcoffset() is None:\n 116→            raise ValueError(\"指定行业信息来源日期时间必须包含明确时区\")\n 117→        return value\n 118→\n 119→    @model_validator(mode=\"after\")\n 120→    def _account_and_authority_are_limited(self) -> AuthoritativeWechatArticleVersion:\n 121→        if APPROVED_WECHAT_ACCOUNT_LABELS.get(self.source_id) != self.account_label_zh:\n 122→            raise ValueError(\"公众号不在用户指定行业信息来源清单中\")\n 123→        if self.is_peer_reviewed_publication:\n 124→            raise ValueError(\"微信公众号文章不能标记为同行评议论文\")\n 125→        if set(self.direct_claim_domains) != _APPROVED_DIRECT_DOMAINS:\n 126→            raise ValueError(\"指定行业信息来源的直接支持范围超出批准领域\")\n 127→        if set(self.authorities) != set(ClaimDomain):\n 128→            raise ValueError(\"指定行业信息来源的声明范围不完整\")\n 129→        for domain, authority in self.authorities.items():\n 130→            expected = (\n 131→                SourceAuthority.DIRECT\n 132→                if domain in _APPROVED_DIRECT_DOMAINS\n 133→                else SourceAuthority.CROSS_CHECK\n 134→            )\n 135→            if authority != expected:\n 136→                raise ValueError(\"指定行业信息来源的声明权限与批准范围不一致\")\n 137→        if not all((self.product_identity, self.trial_identity, self.event_identity)):\n 138→            raise ValueError(\"公众号临床证据必须绑定产品、试验和披露事件身份\")\n 139→        parts = urlsplit(self.source_url)\n 140→        if (\n 141→            parts.scheme != \"https\"\n 142→            or parts.hostname != \"mp.weixin.qq.com\"\n 143→            or not parts.path.startswith(\"/s/\")\n 144→        ):\n 145→            raise ValueError(\"公众号证据必须使用微信公众平台文章链接\")\n 146→        expected_digest = hashlib.sha256(\n 147→            self.content_snapshot.encode(\"utf-8\")\n 148→        ).hexdigest()\n 149→        if self.content_sha256 != expected_digest:\n 150→            raise ValueError(\"公众号文章摘要与已保存正文不一致\")\n 151→        paragraph = self.locator.paragraph\n 152→        if self.locator.url != self.source_url:\n 153→            raise ValueError(\"公众号定位链接必须与已保存文章链接一致\")\n 154→        if self.locator.document_role != f\"微信公众号：{self.account_label_zh}\":\n 155→            raise ValueError(\"公众号定位必须标明对应账号\")\n 156→        stored_paragraphs = {\n 157→            item.strip() for item in self.content_snapshot.splitlines() if item.strip()\n 158→        }\n 159→        if paragraph is None or paragraph.strip() not in stored_paragraphs:\n 160→            raise ValueError(\"公众号定位必须使用已保存正文中的完整段落\")\n 161→        expected_record_id = stable_id(\n 162→            \"authoritative-wechat-article\", self.source_id, self.external_record_id\n 163→        )\n 164→        expected_version_id = stable_id(\n 165→            \"authoritative-wechat-version\", expected_record_id, self.content_sha256\n 166→        )\n 167→        if self.source_record_id != expected_record_id:\n 168→            raise ValueError(\"公众号文章标识与账号及文章编号不一致\")\n 169→        if self.source_version_id != expected_version_id:\n 170→            raise ValueError(\"公众号文章版本与已保存正文不一致\")\n 171→        return self\n 172→\n 173→    def authority_for(self, claim_domain: ClaimDomain) -> SourceAuthority:\n 174→        return self.authorities[claim_domain]\n 175→\n 176→    @classmethod\n 177→    def create(\n 178→        cls,\n 179→        *,\n 180→        policy: SourcePolicy,\n 181→        source_id: str,\n 182→        account_label_zh: str,\n 183→        external_record_id: str,\n 184→        title: str,\n 185→        published_at: str,\n 186→        acquired_at: str,\n 187→        source_url: str,\n 188→        content_snapshot: str,\n 189→        locator_label: str,\n 190→        product_identity: str | None = None,\n 191→        trial_identity: str | None = None,\n 192→        event_identity: str | None = None,\n 193→    ) -> AuthoritativeWechatArticleVersion:\n 194→        expected_label = APPROVED_WECHAT_ACCOUNT_LABELS.get(source_id)\n 195→        if expected_label is None or expected_label != account_label_zh:\n 196→            raise ValueError(\"公众号不在用户指定行业信息来源清单中\")\n 197→        source_definition = policy.source(source_id)\n 198→        if (\n 199→            source_definition.label_zh != account_label_zh\n 200→            or not source_definition.authoritative_secondary\n 201→        ):\n 202→            raise ValueError(\"来源策略未把该公众号标记为指定行业信息来源\")\n 203→        expected_authorities = {\n 204→            domain: (\n 205→                SourceAuthority.DIRECT\n 206→                if domain in _APPROVED_DIRECT_DOMAINS\n 207→                else SourceAuthority.CROSS_CHECK\n 208→            )\n 209→            for domain in ClaimDomain\n 210→        }\n 211→        if source_definition.authorities != expected_authorities:\n 212→            raise ValueError(\"来源策略中的公众号声明权限与批准范围不一致\")\n 213→        external_record_id = _required_text(external_record_id)\n 214→        content_snapshot = _required_text(content_snapshot)\n 215→        content_sha256 = hashlib.sha256(content_snapshot.encode(\"utf-8\")).hexdigest()\n 216→        source_record_id = stable_id(\n 217→            \"authoritative-wechat-article\", source_id, external_record_id\n 218→        )\n 219→        return cls(\n 220→            source_id=source_id,\n 221→            account_label_zh=account_label_zh,\n 222→            source_record_id=source_record_id,\n 223→            source_version_id=stable_id(\n 224→                \"authoritative-wechat-version\", source_record_id, content_sha256\n 225→            ),\n 226→            external_record_id=external_record_id,\n 227→            title=title,\n 228→            direct_claim_domains=tuple(\n 229→                domain for domain in ClaimDomain if domain in _APPROVED_DIRECT_DOMAINS\n 230→            ),\n 231→            authorities=expected_authorities,\n 232→            policy_id=policy.policy_id,\n 233→            policy_version=policy.version,\n 234→            product_identity=product_identity,\n 235→            trial_identity=trial_identity,\n 236→            event_identity=event_identity,\n 237→            published_at=_offset_datetime(published_at),\n 238→            acquired_at=_offset_datetime(acquired_at),\n 239→            content_snapshot=content_snapshot,\n 240→            content_sha256=content_sha256,\n 241→            source_url=source_url,\n 242→            locator=EvidenceLocator(\n 243→                document_role=f\"微信公众号：{account_label_zh}\",\n 244→                paragraph=locator_label,\n 245→                url=source_url,\n 246→            ),\n 247→        )\n 248→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c81113375e5b5b01ad761ea95d2","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c81113375e5b5b01ad761ea95d2","codebuddy.ai/llmMessageId":"01a08c81113375e5b5b01ad761ea95d2","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:48.725Z"}
