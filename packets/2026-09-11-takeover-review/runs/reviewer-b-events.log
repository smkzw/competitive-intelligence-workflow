t != context.context_digest:\n 527→        raise ScientificReviewTransitionError(\n 528→            \"权威生产上下文摘要与物化内容不一致：文件已被篡改或损坏\"\n 529→        )\n 530→    return context\n 531→\n 532→\n 533→def load_scientific_review_receipt(\n 534→    project_root: Path,\n 535→    report_kind: str,\n 536→) -> ScientificReviewReceipt:\n 537→    \"\"\"读取并完整验证独立复核回执；缺回执或伪回执失败关闭。\"\"\"\n 538→    kind = _validated_kind(report_kind)\n 539→    path = project_root / scientific_review_receipt_path(kind)\n 540→    if not path.is_file():\n 541→        raise ScientificReviewTransitionError(\n 542→            f\"独立复核回执缺失：{scientific_review_receipt_path(report_kind)}\"\n 543→        )\n 544→    try:\n 545→        raw = json.loads(path.read_text(encoding=\"utf-8\"))\n 546→    except (OSError, json.JSONDecodeError) as error:\n 547→        raise ScientificReviewTransitionError(\n 548→            f\"独立复核回执不可读或不是有效 JSON：{path}\"\n 549→        ) from error\n 550→    try:\n 551→        return validate_scientific_review_receipt_payload(raw)\n 552→    except ScientificReviewReceiptError as error:\n 553→        raise ScientificReviewTransitionError(f\"独立复核回执验证失败：{error}\") from error\n 554→\n 555→\n 556→def _review_bundle(context: ScientificQcCurrentContext) -> ScientificQcReviewBundle:\n 557→    \"\"\"从权威上下文构造审阅输入；调用方不能另选覆盖或来源。\"\"\"\n 558→    return ScientificQcReviewBundle(\n 559→        producer_id=context.producer_id,\n 560→        project_id=context.project_id,\n 561→        report_kind=context.report_kind,\n 562→        report_version=context.report_version,\n 563→        report_object_id=context.report_object_id,\n 564→        candidate_snapshot_id=context.candidate_snapshot_id,\n 565→        candidate_content_digest=context.candidate_content_digest,\n 566→        criteria_version=context.criteria_version,\n 567→        gate_result_key=context.gate_result_key,\n 568→        coverage_set_id=context.coverage_set_id,\n 569→        coverage_digest=context.coverage_digest,\n 570→        source_refs=context.source_refs,\n 571→        locators=context.locators,\n 572→    )\n 573→\n 574→\n 575→def accepted_verdict_from_receipt(\n 576→    *,\n 577→    project_root: Path,\n 578→    context: ScientificQcCurrentContext,\n 579→    receipt: ScientificReviewReceipt,\n 580→) -> ScientificQcVerdict:\n 581→    \"\"\"重开回执绑定产物，并验证其确为当前上下文的接受结论。\"\"\"\n 582→    artifact = receipt.artifact\n 583→    if artifact is None:  # require_verified_review_receipt 已失败关闭；保留类型收窄\n 584→        raise ScientificReviewTransitionError(\"独立复核回执缺少科学质控结论产物\")\n 585→    path = project_root / artifact.path\n 586→    try:\n 587→        raw = json.loads(path.read_text(encoding=\"utf-8\"))\n 588→    except (OSError, json.JSONDecodeError) as error:\n 589→        raise ScientificReviewTransitionError(\n 590→            \"科学质控结论产物不可读或不是有效 JSON\"\n 591→        ) from error\n 592→    if not isinstance(raw, dict):\n 593→        raise ScientificReviewTransitionError(\"科学质控结论产物必须是 JSON 对象\")\n 594→    try:\n 595→        verdict = validate_scientific_qc_verdict_payload(raw)\n 596→    except ScientificQcBoundaryError as error:\n 597→        raise ScientificReviewTransitionError(\n 598→            f\"科学质控结论产物验证失败：{error}\"\n 599→        ) from error\n 600→\n 601→    bundle = _review_bundle(context)\n 602→    agreement: tuple[tuple[object, object, str], ...] = (\n 603→        (verdict.project_id, context.project_id, \"项目\"),\n 604→        (verdict.contract_version, context.contract_version, \"合同版本\"),\n 605→        (verdict.report_kind, context.report_kind, \"报告类型\"),\n 606→        (verdict.report_version, context.report_version, \"报告版本\"),\n 607→        (verdict.report_object_id, context.report_object_id, \"报告对象\"),\n 608→        (verdict.candidate_snapshot_id, context.candidate_snapshot_id, \"候选快照\"),\n 609→        (\n 610→            verdict.candidate_content_digest,\n 611→            context.candidate_content_digest,\n 612→            \"候选内容摘要\",\n 613→        ),\n 614→        (verdict.criteria_version, context.criteria_version, \"标准版本\"),\n 615→        (verdict.gate_result_key, context.gate_result_key, \"门槛结果键\"),\n 616→        (verdict.coverage_set_id, context.coverage_set_id, \"覆盖集\"),\n 617→        (verdict.coverage_digest, context.coverage_digest, \"覆盖摘要\"),\n 618→        (verdict.source_refs, context.source_refs, \"来源引用\"),\n 619→        (verdict.locators, context.locators, \"来源定位\"),\n 620→        (verdict.review_input_digest, bundle.input_digest, \"审阅输入摘要\"),\n 621→        (\n 622→            receipt.content.review_input_digest,\n 623→            bundle.input_digest,\n 624→            \"回执审阅输入摘要\",\n 625→        ),\n 626→        (verdict.reviewer_id, receipt.review.reviewer_id, \"独立审查者\"),\n 627→    )\n 628→    for verdict_value, current_value, label in agreement:\n 629→        if verdict_value != current_value:\n 630→            raise ScientificReviewTransitionError(\n 631→                f\"科学质控结论{label}与当前权威上下文或回执不一致\"\n 632→            )\n 633→    if verdict.verdict != \"accepted\" or verdict.has_blocking_issues():\n 634→        raise ScientificReviewTransitionError(\"科学质控结论未接受当前候选\")\n 635→    if not (\n 636→        receipt.review.process.started_at\n 637→        <= verdict.reviewed_at\n 638→        <= receipt.review.process.finished_at\n 639→    ):\n 640→        raise ScientificReviewTransitionError(\"科学质控结论时间不在独立复核进程内\")\n 641→    if verdict.valid_until <= receipt.issued_at:\n 642→        raise ScientificReviewTransitionError(\"科学质控接受结论在回执签发时已失效\")\n 643→    return verdict\n 644→\n 645→\n 646→def promote_rendered_candidate(\n 647→    *,\n 648→    project_root: Path,\n 649→    current_state: str,\n 650→    context: ScientificQcCurrentContext,\n 651→    receipt: ScientificReviewReceipt,\n 652→    promoted_at: datetime | None = None,\n 653→) -> str:\n 654→    \"\"\"两阶段迁移第二阶段：真实回执绑定权威上下文后才产生被接受后继。\n 655→\n 656→    只有 ``rendered_unreviewed`` 候选可进入本迁移（单向、一次性）；回执按序\n 657→    通过内容完整性/verified 状态/复核产物实际字节核验与权威上下文逐字绑定。\n 658→    任何失败都以 ``ScientificReviewTransitionError``（或回执层错误）失败关闭。\n 659→    \"\"\"\n 660→    if current_state != RENDERED_UNREVIEWED:\n 661→        raise ScientificReviewTransitionError(\n 662→            f\"候选状态 {current_state!r} 不是 {RENDERED_UNREVIEWED}：\"\n 663→            \"两阶段科学复核迁移只接受渲染后未复核候选\"\n 664→        )\n 665→    require_verified_review_receipt(receipt, project_root=project_root)\n 666→    bind_receipt_to_production_context(receipt, context)\n 667→    production, review_input_digest, _portal_binding = (\n 668→        _load_scientific_review_request(\n 669→            project_root, context.report_kind.value, context\n 670→        )\n 671→    )\n 672→    if receipt.production != production:\n 673→        raise ScientificReviewTransitionError(\"回执生产身份与运行时发布请求不一致\")\n 674→    if receipt.content.review_input_digest != review_input_digest:\n 675→        raise ScientificReviewTransitionError(\"回执审阅输入与运行时发布请求不一致\")\n 676→    checked_at = datetime.now(UTC) if promoted_at is None else promoted_at\n 677→    if checked_at.tzinfo is None or checked_at.utcoffset() is None:\n 678→        raise ScientificReviewTransitionError(\"科学晋级时间必须包含明确时区\")\n 679→    verdict = accepted_verdict_from_receipt(\n 680→        project_root=project_root,\n 681→        context=context,\n 682→        receipt=receipt,\n 683→    )\n 684→    if checked_at < receipt.issued_at:\n 685→        raise ScientificReviewTransitionError(\"科学晋级时间早于回执签发时间\")\n 686→    if verdict.valid_until <= checked_at:\n 687→        raise ScientificReviewTransitionError(\"科学质控接受结论在晋级时已失效\")\n 688→    return SCIENTIFICALLY_REVIEWED_RENDERED_CANDIDATE\n 689→\n 690→\n 691→__all__ = [\n 692→    \"RENDERED_UNREVIEWED\",\n 693→    \"SCIENTIFICALLY_REVIEWED_RENDERED_CANDIDATE\",\n 694→    \"PortalArtifactBinding\",\n 695→    \"ScientificReviewTransitionError\",\n 696→    \"accepted_verdict_from_receipt\",\n 697→    \"build_scientific_review_context\",\n 698→    \"capture_portal_artifact_binding\",\n 699→    \"derive_scientific_source_refs\",\n 700→    \"load_scientific_review_receipt\",\n 701→    \"production_context_publication_path\",\n 702→    \"promote_rendered_candidate\",\n 703→    \"publish_production_context\",\n 704→    \"publish_scientific_review_request\",\n 705→    \"reload_production_context\",\n 706→    \"scientific_review_receipt_path\",\n 707→    \"scientific_review_request_path\",\n 708→    \"verify_portal_artifact_binding\",\n 709→]\n 710→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c81320870fb81c51d3b3f96a833","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c81320870fb81c51d3b3f96a833","codebuddy.ai/llmMessageId":"01a08c81320870fb81c51d3b3f96a833","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:57.231Z"}
