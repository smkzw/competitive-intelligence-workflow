n3104→            chart_type = (\n3105→                \"bar\" if any(item[0].get(\"renderable\") for item in bucket) else \"status_matrix\"\n3106→            )\n3107→            group = _group(\n3108→                _group_title(first, domain=\"disposition\"),\n3109→                bucket,\n3110→                chart_type=chart_type,\n3111→                cross_trial=_bucket_spans_trials(bucket),\n3112→                x_axis_label_zh=\"产品｜试验\",\n3113→            )\n3114→            group[\"title_complete\"] = True\n3115→            groups.append(group)\n3116→        return tuple(groups)\n3117→    if page_id == \"trial-exposure-context\":\n3118→        return (_group(\"试验规模与研究角色\", records, chart_type=\"bar\"),)\n3119→    if page_id == \"product-trial-profiles\":\n3120→        domains = {_text(item[0].get(\"_domain\")) for item in records}\n3121→        if domains - {\"profile\", \"\"}:\n3122→            profile_groups: list[dict[str, Any]] = []\n3123→            domain_pages = (\n3124→                (\"efficacy\", \"efficacy\"),\n3125→                (\"safety\", \"safety\"),\n3126→                (\"baseline\", \"baseline-overview\"),\n3127→                (\"disposition\", \"disposition-overview\"),\n3128→                (\"matrix\", \"efficacy-safety-matrix\"),\n3129→            )\n3130→            for domain, domain_page in domain_pages:\n3131→                selected = [item for item in records if item[0].get(\"_domain\") == domain]\n3132→                if selected:\n3133→                    profile_groups.extend(_groups_for_page(\n3134→                        domain_page, selected, semantic_proposals=semantic_proposals,\n3135→                    ))\n3136→            return tuple(profile_groups)\n3137→    if page_id == \"product-trial-profiles\":\n3138→        return (_group(\"产品与试验覆盖\", records, chart_type=\"status_matrix\"),)\n3139→    return (_group(\"当前页面记录\", records, chart_type=\"bar\"),)\n3140→\n3141→\n3142→def _filter_dimensions(\n3143→    records: Sequence[tuple[dict[str, Any], Any]],\n3144→    targets: Mapping[str, str] | None = None,\n3145→) -> tuple[dict[str, str], ...]:\n3146→    target_by_product = targets or {}\n3147→    result: list[dict[str, str]] = []\n3148→    seen: set[str] = set()\n3149→    for row, _source in records:\n3150→        row_id = _text(row.get(\"row_id\"))\n3151→        if not row_id or row_id in seen:\n3152→            continue\n3153→        seen.add(row_id)\n3154→        product_id = _text(row.get(\"product_id\"))\n3155→        result.append(\n3156→            {\n3157→                \"id\": row_id,\n3158→                \"product\": product_id,\n3159→                \"target\": _text(row.get(\"target\"), target_by_product.get(product_id, \"\")),\n3160→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c81320870fb81c51d3b3f96a833","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c81320870fb81c51d3b3f96a833","codebuddy.ai/llmMessageId":"01a08c81320870fb81c51d3b3f96a833","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:57.230Z"}
