{"type":"user","uuid":"01a08c81-b894-7600-a020-4d6d2c8c1c61","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_cXF2Upt81JpKdqbbku43HgJk","content":[{"type":"text","text":"   1→\"\"\"Acquisition completeness is not competitor-universe completeness.\"\"\"\n   2→\n   3→import json\n   4→from pathlib import Path\n   5→from urllib.parse import parse_qs, urlsplit\n   6→\n   7→import pytest\n   8→\n   9→from ci_workflow.sources.connectors.ctgov_fetch import HttpPage, fetch_ctgov_condition\n  10→from ci_workflow.storage.content_store import ContentAddressedStore\n  11→\n  12→\n  13→def _study(number: int) -> dict[str, object]:\n  14→    return {\n  15→        \"protocolSection\": {\n  16→            \"identificationModule\": {\"nctId\": f\"NCT{number:08d}\", \"briefTitle\": \"Synthetic\"},\n  17→            \"statusModule\": {\"lastUpdatePostDateStruct\": {\"date\": \"2026-01-01\"}},\n  18→        },\n  19→        \"derivedSection\": {\"miscInfoModule\": {\"versionHolder\": \"2026-09-06\"}},\n  20→    }\n  21→\n  22→\n  23→class Pages:\n  24→    def __init__(self, payloads: list[dict[str, object] | Exception]) -> None:\n  25→        self.payloads = iter(payloads)\n  26→        self.urls: list[str] = []\n  27→\n  28→    def __call__(self, url: str, timeout: float, max_bytes: int) -> HttpPage:\n  29→        self.urls.append(url)\n  30→        value = next(self.payloads)\n  31→        if isinstance(value, Exception):\n  32→            raise value\n  33→        return HttpPage(200, \"application/json\", json.dumps(value).encode(), url)\n  34→\n  35→\n  36→@pytest.mark.parametrize(\"body\", [\n  37→    b'{\"studies\":[],\"totalCount\":9,\"totalCount\":0}',\n  38→    b'{\"studies\":[],\"totalCount\":0,\"extra\":NaN}',\n  39→    b'{\"studies\":[],\"totalCount\":0,\"extra\":' + b'[' * 10000 + b'0' + b']' * 10000 + b'}',\n  40→], ids=[\"duplicate-key\", \"nonfinite\", \"excessive-nesting\"])\n  41→def test_ambiguous_or_excessively_nested_json_is_not_zero_results(\n  42→    tmp_path: Path, body: bytes,\n  43→) -> None:\n  44→    def transport(url: str, timeout: float, max_bytes: int) -> HttpPage:\n  45→        return HttpPage(200, \"application/json\", body, url)\n  46→\n  47→    result = fetch_ctgov_condition(tmp_path, \"synthetic\", transport=transport)\n  48→    assert result.status == \"invalid_response\"\n  49→    assert not result.pagination_complete\n  50→\n  51→\n  52→def test_all_pages_preserve_exact_raw_bytes_and_query(tmp_path: Path) -> None:\n  53→    pages = Pages([\n  54→        {\"studies\": [_study(1)], \"totalCount\": 2, \"nextPageToken\": \"a/b=第二页\"},\n  55→        {\"studies\": [_study(2)]},  # Actual API omits totalCount on cursor pages.\n  56→    ])\n  57→    result = fetch_ctgov_condition(tmp_path, \"PNH OR 合成查询\", page_size=1, transport=pages)\n  58→    assert result.status == \"complete\"\n  59→    assert result.pagination_complete and not result.universe_closed\n  60→    assert len(result.studies) == 2\n  61→    assert len(result.pages) == 2\n  62→    assert parse_qs(urlsplit(pages.urls[1]).query)[\"pageToken\"] == [\"a/b=第二页\"]\n  63→    assert parse_qs(urlsplit(pages.urls[1]).query)[\"query.cond\"] == [\"PNH OR 合成查询\"]\n  64→    raw = ContentAddressedStore(tmp_path).read_bytes(result.pages[0].raw_asset)\n  65→    assert json.loads(raw)[\"studies\"][0] == _study(1)\n  66→\n  67→\n  68→def test_empty_intermediate_page_does_not_end_pagination(tmp_path: Path) -> None:\n  69→    pages = Pages([\n  70→        {\"studies\": [], \"totalCount\": 1, \"nextPageToken\": \"continue\"},\n  71→        {\"studies\": [_study(1)], \"totalCount\": 1},\n  72→    ])\n  73→    assert fetch_ctgov_condition(tmp_path, \"synthetic\", transport=pages).status == \"complete\"\n  74→\n  75→\n  76→@pytest.mark.parametrize(\"failure,expected\", [\n  77→    (TimeoutError(), \"network_error\"),\n  78→    ({\"studies\": [], \"totalCount\": 5}, \"incomplete\"),\n  79→    ({\"message\": \"bad response\"}, \"invalid_response\"),\n  80→])\n  81→def test_failure_is_never_reported_as_no_records(\n  82→    tmp_path: Path, failure: dict[str, object] | Exception, expected: str,\n  83→) -> None:\n  84→    result = fetch_ctgov_condition(tmp_path, \"synthetic\", transport=Pages([failure]))\n  85→    assert result.status == expected\n  86→    assert not result.pagination_complete\n  87→\n  88→\n  89→def test_actual_empty_response_has_a_distinct_state(tmp_path: Path) -> None:\n  90→    result = fetch_ctgov_condition(\n  91→        tmp_path, \"synthetic\", transport=Pages([{\"studies\": [], \"totalCount\": 0}]),\n  92→    )\n  93→    assert result.status == \"no_records\"\n  94→    assert result.pagination_complete and not result.universe_closed\n  95→\n  96→\n  97→@pytest.mark.parametrize(\"mode\", [\n  98→    \"loop\", \"limit\", \"count_drift\", \"duplicate_drift\", \"platform_drift\",\n  99→])\n 100→def test_partial_results_never_become_complete(tmp_path: Path, mode: str) -> None:\n 101→    second = {\"studies\": [_study(2)], \"totalCount\": 2}\n 102→    first = {\"studies\": [_study(1)], \"totalCount\": 2, \"nextPageToken\": \"next\"}\n 103→    if mode == \"loop\":\n 104→        second[\"nextPageToken\"] = \"next\"\n 105→    if mode == \"count_drift\":\n 106→        second[\"totalCount\"] = 3\n 107→    if mode == \"duplicate_drift\":\n 108→        changed = _study(1)\n 109→        changed[\"extra\"] = \"changed mid-pagination\"\n 110→        second[\"studies\"] = [changed]\n 111→    if mode == \"platform_drift\":\n 112→        changed = _study(2)\n 113→        changed[\"derivedSection\"] = {\"miscInfoModule\": {\"versionHolder\": \"2026-09-07\"}}\n 114→        second[\"studies\"] = [changed]\n 115→    result = fetch_ctgov_condition(\n 116→        tmp_path, \"synthetic\", transport=Pages([first, second]),\n 117→        max_pages=1 if mode == \"limit\" else 10,\n 118→    )\n 119→    assert result.status == \"incomplete\"\n 120→    assert not result.pagination_complete\n 121→    assert result.studies\n 122→\n 123→\n 124→@pytest.mark.parametrize(\"status,kind\", [(429, \"rate_limited\"), (503, \"network_error\"),\n 125→                                         (403, \"access_denied\"), (302, \"invalid_response\")])\n 126→def test_http_error_does_not_save_response_body(\n 127→    tmp_path: Path, status: int, kind: str,\n 128→) -> None:\n 129→    def transport(url: str, timeout: float, max_bytes: int) -> HttpPage:\n 130→        return HttpPage(status, \"text/html\", b\"untrusted error body\", url)\n 131→\n 132→    result = fetch_ctgov_condition(tmp_path, \"synthetic\", transport=transport)\n 133→    assert result.status == kind\n 134→    assert not result.pages\n 135→    assert not (tmp_path / \"evidence\").exists()\n 136→\n 137→\n 138→def test_acquisition_derives_each_record_with_raw_page_proof(tmp_path: Path) -> None:\n 139→    from ci_workflow.sources.connectors.ctgov_fetch import derive_ctgov_records\n 140→    from ci_workflow.storage.source_derivation import verify_source_text_derivation\n 141→\n 142→    result = fetch_ctgov_condition(tmp_path, \"synthetic\", transport=Pages([\n 143→        {\"studies\": [_study(1), _study(2)], \"totalCount\": 2},\n 144→    ]))\n 145→    derived = derive_ctgov_records(tmp_path, result)\n 146→    assert [item.nct_id for item in derived] == [\"NCT00000001\", \"NCT00000002\"]\n 147→    for index, item in enumerate(derived):\n 148→        assert item.text_derivation.record_selector.study_index == index\n 149→        assert item.text_derivation.raw_asset == result.pages[0].raw_asset\n 150→        verify_source_text_derivation(tmp_path, item.text_derivation, item.content_text)\n 151→        assert item.registry_posted_date_precision == \"calendar_day\"\n 152→\n 153→\n 154→@pytest.mark.parametrize(\"fault\", [\"partial\", \"bytes\", \"study_identity\", \"query\"])\n 155→def test_record_projection_reopens_and_validates_acquisition(tmp_path: Path, fault: str) -> None:\n 156→    from ci_workflow.sources.connectors.ctgov_fetch import derive_ctgov_records\n 157→    from ci_workflow.storage.source_derivation import SourceDerivationError\n 158→\n 159→    result = fetch_ctgov_condition(tmp_path, \"synthetic\", transport=Pages([\n 160→        {\"studies\": [_study(1)], \"totalCount\": 1},\n 161→    ]))\n 162→    if fault == \"partial\":\n 163→        result = result.model_copy(update={\"status\": \"incomplete\", \"pagination_complete\": False})\n 164→    elif fault == \"bytes\":\n 165→        (tmp_path / result.pages[0].raw_asset.relative_path).write_bytes(b\"drift\")\n 166→    elif fault == \"query\":\n 167→        result = result.model_copy(update={\"condition\": \"changed\"})\n 168→    else:\n 169→        result = result.model_copy(update={\"studies\": (result.studies[0].model_copy(update={\n 170→            \"source_version_id\": \"wrong\",\n 171→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c8193da748898a6e9326de8926b","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c8193da748898a6e9326de8926b","codebuddy.ai/llmMessageId":"01a08c8193da748898a6e9326de8926b","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:08:26.772Z"}
{"type":"user","uuid":"01a08c81-b895-7527-9e51-820531bf7588","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_tYTR3sMnN6ejmYLKMKLh68gN","content":[{"type":"text","text":"1000→                )\n1001→            if not set(round_item.source_ids) <= source_set:\n1002→                raise ResearchPackageValidationError(\n1003→                    f\"恢复轮次引用了未知来源：{round_item.strategy_id}\"\n1004→                )\n1005→            if not set(round_item.target_gap_ids) <= gap_set:\n1006→                raise ResearchPackageValidationError(\n1007→                    f\"恢复轮次引用了未知缺口：{round_item.strategy_id}\"\n1008→                )\n1009→        return self\n1010→\n1011→    def assert_gate_ready(self) -> None:\n1012→        \"\"\"在进入门槛/快照前检查闭包、恢复和独立复核。\"\"\"\n1013→\n1014→        if not self.closure.closed:\n1015→            raise ResearchPackageValidationError(\"竞品宇宙尚未闭包，不得进入门槛\")\n1016→        if not self.closure.candidate_entity_ids:\n1017→            raise ResearchPackageValidationError(\"竞品宇宙为空，应进入证据不足流程而非报告门\")\n1018→        route_by_id = {route.route_id: route for route in self.routes}\n1019→        required_route_ids = (*self.closure.global_route_ids, *self.closure.china_route_ids)\n1020→        for route_id in required_route_ids:\n1021→            route = route_by_id[route_id]\n1022→            if route.result_class not in {\n1023→                \"completed\",\n1024→                \"success_with_evidence\",\n1025→                \"not_applicable\",\n1026→                \"access_blocked\",\n1027→                \"access_or_permission_blocked\",\n1028→            }:\n1029→                raise ResearchPackageValidationError(\n1030→                    f\"必查路线未完成：{route_id}（{route.result_class}）\"\n1031→                )\n1032→        terminal_expansion_results = {\n1033→            \"success_with_evidence\",\n1034→            \"searched_no_evidence\",\n1035→            \"not_applicable\",\n1036→            \"access_or_permission_blocked\",\n1037→        }\n1038→        for expansion in self.expansion_receipts:\n1039→            if expansion.result_class not in terminal_expansion_results:\n1040→                raise ResearchPackageValidationError(\n1041→                    f\"扩展回执未完成：{expansion.receipt_id}（{expansion.result_class}）\"\n1042→                )\n1043→        rounds = {item.round_number: item for item in self.recovery_rounds}\n1044→        recovery_gap_ids = {gap.gap_id for gap in self.gap_strategies if gap.recovery_required}\n1045→        if not recovery_gap_ids and not rounds:\n1046→            return\n1047→        if (\n1048→            len(rounds) != len(self.recovery_rounds)\n1049→            or set(rounds) != set(range(1, len(rounds) + 1))\n1050→            or len(rounds) < 2\n1051→        ):\n1052→            raise ResearchPackageValidationError(\"恢复记录必须从第 1 轮连续编号且至少两轮\")\n1053→        first, second = rounds[len(rounds) - 1], rounds[len(rounds)]\n1054→        if first.strategy_id == second.strategy_id or first.strategy_kind == second.strategy_kind:\n1055→            raise ResearchPackageValidationError(\"最后两轮恢复必须使用不同策略\")\n1056→        if (\n1057→            first.route_ids == second.route_ids\n1058→            and first.query_or_identifier == second.query_or_identifier\n1059→        ):\n1060→            raise ResearchPackageValidationError(\"最后两轮恢复不得重复相同路线与查询\")\n1061→        if first.information_gain not in {\"no-new-evidence\", \"not_applicable\"} or (\n1062→            second.information_gain not in {\"no-new-evidence\", \"not_applicable\"}\n1063→        ):\n1064→            raise ResearchPackageValidationError(\"最后两轮恢复尚未证明信息增益饱和\")\n1065→        for gap_id in recovery_gap_ids:\n1066→            if gap_id not in first.target_gap_ids or gap_id not in second.target_gap_ids:\n1067→                raise ResearchPackageValidationError(\"最后两轮恢复必须逐项绑定关键缺口\")\n1068→        if not self.closure.independent_review_id or not self.closure.independent_c