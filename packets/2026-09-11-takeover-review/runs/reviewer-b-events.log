{"type":"user","uuid":"01a08c83-725b-7417-b776-2102b31f219a","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_03_2fDbHIIsCBY1nwd7POLV2583","content":[{"type":"text","text":"   1→\"\"\"Bound model proposals for candidate B views; not an independent acceptance receipt.\"\"\"\n   2→\n   3→from __future__ import annotations\n   4→\n   5→import hashlib\n   6→import json\n   7→from collections.abc import Mapping, Sequence\n   8→from typing import Any, Literal\n   9→\n  10→from pydantic import BaseModel, ConfigDict, TypeAdapter, field_validator, model_validator\n  11→\n  12→from ci_workflow.reports.b.semantic_contract import (\n  13→    ClinicalConstructObservation,\n  14→    compare_clinical_constructs,\n  15→    semantic_value_is_unknown,\n  16→)\n  17→\n  18→SEMANTIC_POLICY_VERSION = \"b-candidate-hard-axes-v2\"\n  19→_SOURCE_JSON = TypeAdapter(Any)\n  20→\n  21→\n  22→def semantic_source_digest(value: Any) -> str:\n  23→    \"\"\"Bind the complete supplied fact, including locator and derivation metadata.\n  24→\n  25→    This binds declared provenance; it does not attest that external bytes were\n  26→    retrieved or independently verified. Those remain acquisition/review gates.\n  27→    \"\"\"\n  28→    return hashlib.sha256(json.dumps(\n  29→        _SOURCE_JSON.dump_python(value, mode=\"json\"), ensure_ascii=False,\n  30→        sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n  31→    ).encode()).hexdigest()\n  32→\n  33→\n  34→class SemanticGroupingProposal(BaseModel):\n  35→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  36→\n  37→    schema_version: Literal[\"1\"] = \"1\"\n  38→    status: Literal[\"proposal\"] = \"proposal\"\n  39→    proposal_id: str\n  40→    row_ids: tuple[str, str]\n  41→    row_digests: tuple[str, str]\n  42→    compatible: bool\n  43→    time_window_compatible: bool = False\n  44→    producer_id: str\n  45→    rationale_zh: str\n  46→\n  47→    @field_validator(\"proposal_id\", \"producer_id\", \"rationale_zh\")\n  48→    @classmethod\n  49→    def nonempty(cls, value: str) -> str:\n  50→        if not value.strip():\n  51→            raise ValueError(\"语义提案标识与理由不能为空\")\n  52→        return value.strip()\n  53→\n  54→    @model_validator(mode=\"after\")\n  55→    def binding(self) -> SemanticGroupingProposal:\n  56→        if len(set(self.row_ids)) != 2 or any(not value.strip() for value in self.row_ids):\n  57→            raise ValueError(\"语义提案必须绑定两个不同观察\")\n  58→        if any(len(value) != 64 or any(c not in \"0123456789abcdef\" for c in value)\n  59→               for value in self.row_digests):\n  60→            raise ValueError(\"语义提案必须绑定完整观察摘要\")\n  61→        return self\n  62→\n  63→\n  64→def semantic_row_digest(row: Mapping[str, Any]) -> str:\n  65→    \"\"\"Bind policy, complete supplied fact digest, and projected clinical values.\"\"\"\n  66→    payload = {key: value for key, value in row.items() if not key.startswith(\"_\")}\n  67→    payload[\"_source_binding\"] = row.get(\"_source_binding\")\n  68→    payload[\"_semantic_policy\"] = SEMANTIC_POLICY_VERSION\n  69→    return hashlib.sha256(json.dumps(\n  70→        payload, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n  71→    ).encode()).hexdigest()\n  72→\n  73→\n  74→def _observation(row: Mapping[str, Any]) -> ClinicalConstructObservation:\n  75→    return ClinicalConstructObservation.model_validate({\n  76→        \"observation_id\": row[\"row_id\"],\n  77→        \"clinical_construct\": row.get(\"clinical_concept\", \"not_reported\"),\n  78→        \"definition\": row.get(\"semantic_definition\", \"not_reported\"),\n  79→        \"direction\": row.get(\"semantic_direction\", \"not_reported\"),\n  80→        \"unit\": row.get(\"unit\", \"not_reported\"),\n  81→        \"estimand\": row.get(\"semantic_estimand\", \"not_reported\"),\n  82→        \"denominator\": row.get(\"semantic_denominator\", \"not_reported\"),\n  83→        \"analysis_set\": row.get(\"semantic_analysis_set\", \"not_reported\"),\n  84→        \"analysis_form\": row.get(\"semantic_analysis_form\", \"not_reported\"),\n  85→        \"instrument_or_scale\": row.get(\"semantic_instrument_or_scale\", \"not_reported\"),\n  86→        \"actual_timepoint\": row.get(\"actual_timepoint\"),\n  87→        \"actual_timepoint_unit\": row.get(\"actual_timepoint_unit\"),\n  88→    })\n  89→\n  90→\n  91→def proposed_semantic_buckets(\n  92→    buckets: Sequence[Sequence[tuple[dict[str, Any], Any]]],\n  93→    proposals: Sequence[SemanticGroupingProposal],\n  94→    *, descriptive_only: bool = False,\n  95→) -> tuple[tuple[tuple[dict[str, Any], Any], ...], ...]:\n  96→    \"\"\"Complete-link grouping: no transitive compatibility and no dropped observations.\n  97→\n  98→    Same-trial descriptive groups remain available. Every cross-trial pair passes\n  99→    the deterministic guard, including pairs for which no proposal was supplied.\n 100→    \"\"\"\n 101→    rows: dict[str, tuple[dict[str, Any], Any]] = {}\n 102→    origin: dict[str, int] = {}\n 103→    for index, bucket in enumerate(buckets):\n 104→        for item in bucket:\n 105→            row_id = str(item[0][\"row_id\"])\n 106→            if row_id in rows:\n 107→                raise ValueError(\"语义视图观察标识重复\")\n 108→            rows[row_id] = item\n 109→            origin[row_id] = index\n 110→    pairs: dict[frozenset[str], SemanticGroupingProposal] = {}\n 111→    for proposal in proposals:\n 112→        proposal = SemanticGroupingProposal.model_validate(proposal.model_dump(mode=\"json\"))\n 113→        for row_id, digest in zip(proposal.row_ids, proposal.row_digests, strict=True):\n 114→            if row_id in rows and semantic_row_digest(rows[row_id][0]) != digest:\n 115→                raise ValueError(\"语义提案观察摘要不一致，必须重新研究和复核\")\n 116→        if not set(proposal.row_ids).issubset(rows):\n 117→            continue  # Another physical page may own the other observation.\n 118→        if descriptive_only and proposal.compatible:\n 119→            raise ValueError(\"该域目前仅支持描述性展示，不能接受正向语义裁决提案\")\n 120→        key = frozenset(proposal.row_ids)\n 121→        if key in pairs:\n 122→            raise ValueError(\"同一观察对存在重复语义提案\")\n 123→        pairs[key] = proposal\n 124→\n 125→    def compatible(left_id: str, right_id: str) -> bool:\n 126→        proposal = pairs.get(frozenset((left_id, right_id)))\n 127→        if proposal is None:\n 128→            if origin[left_id] != origin[right_id]:\n 129→                return False\n 130→            if descriptive_only:\n 131→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a08c8052637ef99d54eb1364f5e9f1","_messageId":"01a08c83609b7f54b6003c1bf2385874","_meta":{"codebuddy.ai/conversationRequestId":"01a08c8052637ef99d54eb1364f5e9f1","codebuddy.ai/modelRequestId":"01a08c83609b7f54b6003c1bf2385874","codebuddy.ai/llmMessageId":"01a08c83609b7f54b6003c1bf2385874","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:10:19.867Z"}
