→    group_id = _text(row.get(\"group_id\"))\n2613→    return role if role != \"unknown\" or not group_id else group_id\n2614→\n2615→\n2616→def _chart_series_label(row: Mapping[str, Any], key: str) -> str:\n2617→    role_label = _text(\n2618→        row.get(\"arm_role_label_zh\"),\n2619→        _text(row.get(\"arm\"), _text(row.get(\"group\"), \"组别未列示\")),\n2620→    )\n2621→    if key.startswith(\"treatment:\") or key.startswith(\"control:\"):\n2622→        for detail in (\n2623→            _text(row.get(\"arm_detail\")),\n2624→            _text(row.get(\"group_label_zh\")),\n2625→            _text(row.get(\"group\")),\n2626→            _text(row.get(\"arm\")),\n2627→        ):\n2628→            if detail and detail not in {role_label, \"组别未列示\"}:\n2629→                return f\"{role_label}（{detail}）\"\n2630→        return role_label\n2631→    return role_label\n2632→\n2633→\n2634→def _group_title(\n2635→    row: Mapping[str, Any],\n2636→    *,\n2637→    domain: str,\n2638→    include_time: bool = True,\n2639→    include_population: bool = True,\n2640→    include_statistic: bool = True,\n2641→) -> str:\n2642→    concept = _text(\n2643→        row.get(\"clinical_concept_label_zh\"),\n2644→        _text(row.get(\"display_label_zh\"), \"临床指标\"),\n2645→    )\n2646→    statistic = _text(\n2647→        row.get(\"statistical_form_family_label_zh\"),\n2648→        _text(row.get(\"statistic_form\"), \"报告未注明统计口径\"),\n2649→    )\n2650→    time_band = _text(row.get(\"time_window_band_label_zh\"))\n2651→    population = _text(row.get(\"population_context_label_zh\"))\n2652→    parts = [concept]\n2653→    if include_statistic:\n2654→        parts.append(statistic)\n2655→    if include_time and time_band and time_band != \"时间点未列示\":\n2656→        parts.append(time_band)\n2657→    if include_population and population and population != \"分析人群未列示\":\n2658→        parts.append(population)\n2659→    if domain == \"safety\":\n2660→        parts.insert(0, \"安全性\")\n2661→    elif domain 