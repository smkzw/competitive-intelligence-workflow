{"type":"user","uuid":"01a08c81-5187-79fe-8873-1b369f09578f","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_L187NDhYg1owQ6IKA6nLjTbb","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→from datetime import datetime, timedelta\n   4→from enum import StrEnum\n   5→\n   6→from pydantic import BaseModel, ConfigDict, Field\n   7→\n   8→from ci_workflow.domain.evidence import SourceVersionRecord\n   9→from ci_workflow.sources.receipts import EvidenceAuditBundle, RouteAttemptResult\n  10→from ci_workflow.sources.retries import RecoveryExhaustionProof\n  11→\n  12→\n  13→class RouteCompletionState(StrEnum):\n  14→    COMPLETED = \"route_completed\"\n  15→    NOT_APPLICABLE = \"route_not_applicable\"\n  16→    ACCESS_BLOCKED = \"route_access_blocked\"\n  17→\n  18→\n  19→class RouteCompletion(BaseModel):\n  20→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  21→\n  22→    state: RouteCompletionState\n  23→    rationale_zh: str = Field(min_length=1)\n  24→    completed_strategy_unit_ids: tuple[str, ...] = Field(min_length=1)\n  25→\n  26→\n  27→class RouteProgress(BaseModel):\n  28→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  29→\n  30→    route_id: str = Field(min_length=1)\n  31→    attempts: tuple[RouteAttemptResult, ...] = ()\n  32→    completion: RouteCompletion | None = None\n  33→\n  34→    @property\n  35→    def is_complete(self) -> bool:\n  36→        return self.completion is not None\n  37→\n  38→    def record_attempt(self, attempt: RouteAttemptResult) -> RouteProgress:\n  39→        if self.completion is not None:\n  40→            raise ValueError(\"已完成路线不能追加尝试\")\n  41→        if attempt.attempt_id in {item.attempt_id for item in self.attempts}:\n  42→            raise ValueError(\"路线尝试标识不得重复\")\n  43→        return self.model_copy(update={\"attempts\": (*self.attempts, attempt)})\n  44→\n  45→    def complete(\n  46→        self,\n  47→        completion: RouteCompletion,\n  48→        *,\n  49→        audit_bundle: EvidenceAuditBundle,\n  50→        recovery_exhaustion: RecoveryExhaustionProof | None = None,\n  51→    ) -> RouteProgress:\n  52→        if self.completion is not None:\n  53→            raise ValueError(\"路线完成状态不得重复写入\")\n  54→        audit_bundle.assert_supports(\n  55→            route_id=self.route_id,\n  56→            completion_state=completion.state.value,\n  57→            completed_strategy_unit_ids=completion.completed_strategy_unit_ids,\n  58→        )\n  59→        receipts_by_id = {\n  60→            item.receipt_id: item for item in audit_bundle.source_receipts\n  61→        }\n  62→        attempts_by_id = {item.attempt_id: item for item in self.attempts}\n  63→        if set(receipts_by_id) != set(attempts_by_id):\n  64→            raise ValueError(\"路线尝试与来源审计回执必须逐条对应\")\n  65→        for receipt_id, receipt in receipts_by_id.items():\n  66→            attempt = attempts_by_id[receipt_id]\n  67→            if (\n  68→                attempt.strategy_unit_id,\n  69→                attempt.entity_id,\n  70→                attempt.gap_id,\n  71→                attempt.claim_domain,\n  72→                attempt.result_class.value,\n  73→            ) != (\n  74→                receipt.strategy_unit_id,\n  75→                receipt.entity_id,\n  76→                receipt.gap_id,\n  77→                receipt.claim_domain,\n  78→                receipt.result_class,\n  79→            ):\n  80→                raise ValueError(\"路线尝试内容与来源审计回执不一致\")\n  81→        if completion.state is RouteCompletionState.COMPLETED:\n  82→            final_receipts = tuple(\n  83→                max(\n  84→                    (\n  85→                        receipt\n  86→                        for receipt in audit_bundle.source_receipts\n  87→                        if receipt.strategy_unit_id == strategy_unit_id\n  88→                    ),\n  89→                    key=lambda receipt: receipt.attempt_index,\n  90→                )\n  91→                for strategy_unit_id in completion.completed_strategy_unit_ids\n  92→            )\n  93→            if any(item.result_class == \"not_found\" for item in final_receipts):\n  94→                if recovery_exhaustion is None:\n  95→                    raise ValueError(\"未找到适格内容前必须完成恢复与科学穷尽\")\n  96→                first = final_receipts[0]\n  97→                expected_context = (\n  98→                    self.route_id,\n  99→                    first.entity_id,\n 100→                    first.gap_id,\n 101→                    first.claim_domain,\n 102→                )\n 103→                if recovery_exhaustion.execution_context != expected_context:\n 104→                    raise ValueError(\"路线终态与恢复穷尽证据不属于同一任务语境\")\n 105→                if not recovery_exhaustion.completed_strategy_unit_ids <= set(\n 106→                    audit_bundle.evidence_gap.completed_strategies\n 107→                ):\n 108→                    raise ValueError(\"恢复穷尽策略未完整写入证据缺口审计\")\n 109→        elif recovery_exhaustion is not None:\n 110→            raise ValueError(\"非科学性未找到终态不得附加恢复穷尽证据\")\n 111→        return self.model_copy(update={\"completion\": completion})\n 112→\n 113→\n 114→class HistoricalCutoffState(StrEnum):\n 115→    SNAPSHOT_ELIGIBLE = \"snapshot_eligible\"\n 116→    REFRESH_CANDIDATE = \"refresh_candidate\"\n 117→    BLOCKED_UNKNOWN_DISCLOSURE = \"blocked_unknown_disclosure\"\n 118→    BLOCKED_AMBIGUOUS_DISCLOSURE_DAY = \"blocked_ambiguous_disclosure_day\"\n 119→\n 120→\n 121→class HistoricalCutoffAssessment(BaseModel):\n 122→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 123→\n 124→    source_version_id: str\n 125→    state: HistoricalCutoffState\n 126→    can_enter_snapshot: bool\n 127→    refresh_candidate: bool\n 128→    recovery_required: bool\n 129→    rationale_zh: str\n 130→\n 131→\n 132→def assess_historical_source(\n 133→    source: SourceVersionRecord, *, cutoff: datetime, key_evidence: bool\n 134→) -> HistoricalCutoffAssessment:\n 135→    if cutoff.tzinfo is None or cutoff.utcoffset() is None:\n 136→        raise ValueError(\"历史截止日必须包含明确时区\")\n 137→    disclosed = source.first_disclosed_at\n 138→    if (\n 139→        disclosed.state == \"reported\"\n 140→        and disclosed.value is not None\n 141→        and disclosed.precision == \"calendar_day\"\n 142→    ):\n 143→        day_start = disclosed.value\n 144→        next_day = day_start + timedelta(days=1)\n 145→        if cutoff < day_start:\n 146→            return HistoricalCutoffAssessment(\n 147→                source_version_id=source.source_version_id,\n 148→                state=HistoricalCutoffState.REFRESH_CANDIDATE,\n 149→                can_enter_snapshot=False,\n 150→                refresh_candidate=True,\n 151→                recovery_required=False,\n 152→                rationale_zh=\"首次披露自然日晚于历史截止时点，仅进入后续刷新候选\",\n 153→            )\n 154→        if cutoff < next_day - timedelta(microseconds=1):\n 155→            return HistoricalCutoffAssessment(\n 156→                source_version_id=source.source_version_id,\n 157→                state=HistoricalCutoffState.BLOCKED_AMBIGUOUS_DISCLOSURE_DAY,\n 158→                can_enter_snapshot=False,\n 159→                refresh_candidate=False,\n 160→                recovery_required=key_evidence,\n 161→                rationale_zh=\"来源只公开首次披露自然日，当前截止时点位于该日内，无法证明先后顺序\",\n 162→            )\n 163→    if (\n 164→        disclosed.state == \"reported\"\n 165→        and disclosed.value is not None\n 166→        and disclosed.value <= cutoff\n 167→    ):\n 168→        return HistoricalCutoffAssessment(\n 169→            source_version_id=source.source_version_id,\n 170→            state=HistoricalCutoffState.SNAPSHOT_ELIGIBLE,\n 171→            can_enter_snapshot=True,\n 172→            refresh_candidate=False,\n 173→            recovery_required=False,\n 174→            rationale_zh=\"首次披露时间不晚于历史截止日，可进入当前快照\",\n 175→        )\n 176→    if (\n 177→        disclosed.state == \"reported\"\n 178→        and disclosed.value is not None\n 179→        and disclosed.value > cutoff\n 180→    ):\n 181→        return HistoricalCutoffAssessment(\n 182→            source_version_id=source.source_version_id,\n 183→            state=HistoricalCutoffState.REFRESH_CANDIDATE,\n 184→            can_enter_snapshot=False,\n 185→            refresh_candidate=True,\n 186→            recovery_required=False,\n 187→            rationale_zh=\"首次披露时间晚于历史截止日，仅进入后续刷新候选\",\n 188→        )\n 189→    return HistoricalCutoffAssessment(\n 190→        source_version_id=source.source_version_id,\n 191→        state=HistoricalCutoffState.BLOCKED_UNKNOWN_DISCLOSURE,\n 192→        can_enter_snapshot=False,\n 193→        refresh_candidate=False,\n 194→        recovery_required=key_evidence,\n 195→        rationale_zh=(\n 196→            \"关键证据的首次披露时间尚未解决，不能进入当前历史快照\"\n 197→            if key_evidence\n 198→            else \"首次披露时间尚未解决，当前历史快照不采用该来源\"\n 199→        ),\n 200→    )\n 201→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c814538730096a911257036bf63","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c814538730096a911257036bf63","codebuddy.ai/llmMessageId":"01a08c814538730096a911257036bf63","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:08:00.392Z"}
{"type":"user","uuid":"01a08c81-5188-7a08-98b4-43216a0be96a","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_QnSm5Y5GY1AZvkGBkWoPUXhb","content":[{"type":"text","text":"   1→\"\"\"A/B/C 两阶段科学复核状态迁移：真实回执是唯一科学状态迁移授权。\n   2→\n   3→阶段一：A/B/C 候选完成 format 渲染（门户站点与产物清单落盘）后处于\n   4→``rendered_unreviewed``（预览态，不得产生任何科学、视觉或发布接受后继）；\n   5→科学晋级只允许发生在 format 完成之后。\n   6→\n   7→阶段二：真实 ``scientific-review-v1`` 回执（``qc.review_receipt``）按序通过\n   8→\n   9→1. ``require_verified_review_receipt``：内容摘要完整、``verified`` 状态、\n  10→   复核产物实际文件字节核验；\n  11→2. ``bind_receipt_to_production_context``：逐字绑定编排层权威\n  12→   ``ScientificQcCurrentContext``（项目/报告/对象/候选快照/候选内容摘要/\n  13→   生产者/标准版本/门槛结果键/上下文摘要）；\n  14→3. 首次门户 manifest/站点字节绑定核验：review request 在发布时绑定\n  15→   format 产物的 ``PortalArtifactBinding``；恢复与晋级前都用当前磁盘\n  16→   字节重验，任何漂移失败关闭。请求只在首次发布时绑定；跨候选/跨项目/\n  17→   无关历史的既有请求拒绝覆盖。\n  18→\n  19→全部通过后才迁移为 ``scientifically_reviewed_rendered_candidate``。缺回执、\n  20→伪回执（结构/摘要漂移/伪造状态）、同会话复核、生产者自审、旧内容（候选\n  21→内容或上下文漂移）与宿主不可用（``host_context_unavailable``）全部失败\n  22→关闭，绝不产生被接受后继。\n  23→\n  24→权威上下文从当前候选、Gate、coverage 与来源引用重建\n  25→（``build_scientific_review_context``）：来源引用经\n  26→``derive_scientific_source_refs`` 与共享谱系摄取（``ingest_research_evidence``）\n  27→使用同一确定性标识算法重算持久化来源版本/片段标识，杜绝调用方自由伪造\n  28→来源谱系。上下文经 ``publish_production_context`` 物化为确定性状态文件供\n  29→外部复核会话读取；``reload_production_context`` 重载时校验上下文摘要，\n  30→任何篡改失败关闭。\n  31→\n  32→分层边界：回执结构与授权裁决留在 ``qc`` 层真源（``Task 9.4`` 权能边界）；\n  33→本模块只做运行时接线（状态迁移与上下文物化），不得绕过或复制授权门。\n  34→\"\"\"\n  35→\n  36→from __future__ import annotations\n  37→\n  38→import hashlib\n  39→import json\n  40→from collections.abc import Mapping, Sequence\n  41→from datetime import UTC, datetime\n  42→from pathlib import Path, PurePosixPath\n  43→from typing import Final, Literal, cast\n  44→\n  45→from pydantic import BaseModel, ConfigDict\n  46→from pydantic import ValidationError as PydanticValidationError\n  47→\n  48→from ci_workflow.application.source_research_service import (\n  49→    ResearchClaim,\n  50→    ResearchFact,\n  51→    SourceCapture,\n  52→)\n  53→from ci_workflow.capabilities.scientific_qc import (\n  54→    ScientificQcBoundaryError,\n  55→    validate_scientific_qc_verdict_payload,\n  56→)\n  57→from ci_workflow.domain.enums import ReportKind\n  58→from ci_workflow.domain.evidence import source_version_identity\n  59→from ci_workflow.domain.ids import stable_id\n  60→from ci_workflow.qc.review_receipt import (\n  61→    ReviewProductionContext,\n  62→    ScientificReviewReceipt,\n  63→    ScientificReviewReceiptError,\n  64→    bind_receipt_to_production_context,\n  65→    require_verified_review_receipt,\n  66→    validate_scientific_review_receipt_payload,\n  67→)\n  68→from ci_workflow.qc.scientific import (\n  69→    LocatorDetail,\n  70→    LocatorRef,\n  71→    ScientificQcCurrentContext,\n  72→    ScientificQcReviewBundle,\n  73→    ScientificQcVerdict,\n  74→    SourceRef,\n  75→)\n  76→\n  77→ReportKindCode = Literal[\"A\", \"B\", \"C\"]\n  78→\n  79→RENDERED_UNREVIEWED: Final = \"rendered_unreviewed\"\n  80→SCIENTIFICALLY_REVIEWED_RENDERED_CANDIDATE: Final = (\n  81→    \"scientifically_reviewed_rendered_candidate\"\n  82→)\n  83→\n  84→\n  85→class ScientificReviewTransitionError(ValueError):\n  86→    \"\"\"两阶段科学复核状态迁移失败关闭。\"\"\"\n  87→\n  88→\n  89→class PortalArtifactBinding(BaseModel):\n  90→    \"\"\"首次门户产物字节绑定：review request 对 format 产物的信任根。\n  91→\n  92→    ``manifest_sha256`` 是 ``html.manifest.json`` 文件字节摘要；\n  93→    ``site_sha256``/``site_total_bytes`` 与产物清单 artifact 绑定同一合同\n  94→    （``qc.browser.site_directory_digest``）。绑定只在首次发布时写入，\n  95→    之后任何字节漂移都失败关闭。\n  96→    \"\"\"\n  97→\n  98→    model_config = ConfigDict(frozen=True)\n  99→\n 100→    manifest_relative: str\n 101→    manifest_sha256: str\n 102→    site_relative: str\n 103→    site_sha256: str\n 104→    site_total_bytes: int\n 105→\n 106→\n 107→def _validated_kind(report_kind: str) -> ReportKindCode:\n 108→    if report_kind not in (\"A\", \"B\", \"C\"):\n 109→        raise ScientificReviewTransitionError(\n 110→            f\"两阶段科学复核状态迁移只适用于 A/B/C 类报告：{report_kind!r}\"\n 111→        )\n 112→    return cast(ReportKindCode, report_kind)\n 113→\n 114→\n 115→def _canonical_json(value: object) -> str:\n 116→    # 与 storage.content_store / qc.scientific 同一规范化，保证确定性标识\n 117→    # 与摄取层逐字节一致。\n 118→    return json.dumps(\n 119→        value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\")\n 120→    )\n 121→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c814538730096a911257036bf63","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c814538730096a911257036bf63","codebuddy.ai/llmMessageId":"01a08c814538730096a911257036bf63","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:08:00.392Z"}
{"type":"user","uuid":"01a08c81-518a-7555-b397-c690e6f4446b","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_m0qM0q6rCSN9vPQ3YVRYij1R","content":[{"type":"text","text":"   1→\"\"\"Bound model proposals must reach the actual B chart grouping, without losing rows.\"\"\"\n   2→\n   3→from itertools import permutations\n   4→\n   5→import pytest\n   6→\n   7→from ci_workflow.renderers.portal.report_b import _groups_for_page\n   8→from tests.reports.b.test_r13_semantic_grouping import _project_efficacy\n   9→\n  10→\n  11→def _rows():\n  12→    first = _project_efficacy(\"first\", \"EASI-75\", timepoint=48)\n  13→    first.update(\n  14→        semantic_direction=\"higher_is_better\", semantic_estimand=\"treatment_policy\",\n  15→        semantic_denominator=\"full_analysis_set\", semantic_instrument_or_scale=\"EASI v1.0\",\n  16→    )\n  17→    second = dict(\n  18→        first, row_id=\"second\", trial_id=\"trial-b\", actual_timepoint=50,\n  19→        semantic_definition=\"达到基线EASI改善不少于75%的比例\",\n  20→        original_definition=\"达到基线EASI改善不少于75%的比例\",\n  21→    )\n  22→    return first, second\n  23→\n  24→\n  25→def _proposal(first, second):\n  26→    from ci_workflow.reports.b.semantic_grouping import (\n  27→        SemanticGroupingProposal,\n  28→        semantic_row_digest,\n  29→    )\n  30→\n  31→    return SemanticGroupingProposal(\n  32→        proposal_id=\"synthetic-proposal\", row_ids=(first[\"row_id\"], second[\"row_id\"]),\n  33→        row_digests=(semantic_row_digest(first), semantic_row_digest(second)),\n  34→        compatible=True, rationale_zh=\"同一临床构念，实际时间分别为48与50周。\",\n  35→        producer_id=\"synthetic-model\", time_window_compatible=True,\n  36→    )\n  37→\n  38→\n  39→def test_bound_wording_proposal_reaches_chart_groups() -> None:\n  40→    first, second = _rows()\n  41→    groups = _groups_for_page(\n  42→        \"efficacy\", [(first, None), (second, None)],\n  43→        semantic_proposals=(_proposal(first, second),),\n  44→    )\n  45→    assert len(groups) == 1\n  46→    assert groups[0][\"cross_trial\"] is True\n  47→    assert {row[\"row_id\"] for row in groups[0][\"rows\"]} == {\"first\", \"second\"}\n  48→    assert \"48\" in groups[0][\"title_zh\"] and \"50\" in groups[0][\"title_zh\"]\n  49→\n  50→\n  51→@pytest.mark.parametrize(\"change\", [\"semantic_analysis_set\", \"value\", \"source_version_id\"])\n  52→def test_proposal_rejects_changed_observation(change: str) -> None:\n  53→    first, second = _rows()\n  54→    proposal = _proposal(first, second)\n  55→    second[change] = 99 if change == \"value\" else \"changed\"\n  56→    with pytest.raises(ValueError, match=\"摘要\"):\n  57→        _groups_for_page(\n  58→            \"efficacy\", [(first, None), (second, None)], semantic_proposals=(proposal,),\n  59→        )\n  60→\n  61→\n  62→def test_model_cannot_override_known_hard_conflict() -> None:\n  63→    first, second = _rows()\n  64→    second[\"semantic_analysis_set\"] = \"per_protocol\"\n  65→    groups = _groups_for_page(\n  66→        \"efficacy\", [(first, None), (second, None)],\n  67→        semantic_proposals=(_proposal(first, second),),\n  68→    )\n  69→    assert len(groups) == 2\n  70→    assert all(not group[\"cross_trial\"] for group in groups)\n  71→\n  72→\n  73→def test_model_cannot_supply_missing_definition_by_copying_other_observation() -> None:\n  74→    first, second = _rows()\n  75→    first[\"semantic_definition\"] = \"not_reported\"\n  76→    groups = _groups_for_page(\n  77→        \"efficacy\", [(first, None), (second, None)],\n  78→        semantic_proposals=(_proposal(first, second),),\n  79→    )\n  80→    assert len(groups) == 2\n  81→\n  82→\n  83→def test_pairwise_compatibility_is_not_transitive() -> None:\n  84→    first, second = _rows()\n  85→    third = dict(second, row_id=\"third\", trial_id=\"trial-c\", actual_timepoint=52,\n  86→                 semantic_definition=\"第三种定义措辞\")\n  87→    groups = _groups_for_page(\n  88→        \"efficacy\", [(first, None), (second, None), (third, None)],\n  89→        semantic_proposals=(_proposal(first, second), _proposal(second, third)),\n  90→    )\n  91→    assert len(groups) == 2\n  92→    assert sum(len(group[\"rows\"]) for group in groups) == 3\n  93→\n  94→\n  95→def test_model_copy_cannot_forge_proposal_acceptance_state() -> None:\n  96→    first, second = _rows()\n  97→    forged = _proposal(first, second).model_copy(update={\"status\": \"accepted\"})\n  98→    with pytest.raises(ValueError):\n  99→        _groups_for_page(\"efficacy\", [(first, None), (second, None)], semantic_proposals=(forged,))\n 100→\n 101→\n 102→@pytest.mark.parametrize(\"page\", [\"efficacy\", \"longitudinal-results\"])\n 103→def test_no_proposal_still_applies_cross_trial_time_guard(page: str) -> None:\n 104→    first, _ = _rows()\n 105→    second = dict(first, row_id=\"second\", trial_id=\"trial-b\", actual_timepoint=56)\n 106→    groups = _groups_for_page(page, [(first, None), (second, None)])\n 107→    assert len(groups) == 2\n 108→    assert all(not group[\"cross_trial\"] for group in groups)\n 109→\n 110→\n 111→def test_complete_link_partition_is_input_order_independent() -> None:\n 112→    first, second = _rows()\n 113→    third = dict(second, row_id=\"third\", trial_id=\"trial-c\", actual_timepoint=52,\n 114→                 semantic_definition=\"第三种定义措辞\")\n 115→    proposals = (_proposal(first, second), _proposal(second, third))\n 116→    partitions = {\n 117→        frozenset(frozenset(row[\"row_id\"] for row in group[\"rows\"]) for group in\n 118→                  _groups_for_page(\"efficacy\", [(row, None) for row in order],\n 119→                                   semantic_proposals=proposals))\n 120→        for order in permutations((first, second, third))\n 121→    }\n 122→    assert len(partitions) == 1\n 123→\n 124→\n 125→def test_source_locator_change_invalidates_bound_proposal() -> None:\n 126→    from ci_workflow.renderers.portal.report_b import (\n 127→        _display_trial_name,\n 128→        _efficacy_records,\n 129→    )\n 130→    from tests.browser.test_b_semantic_proposals import proposal_data\n 131→\n 132→    data = proposal_data()\n 133→    names = {product.id: product.name for product in data.products}\n 134→    trials = {trial.id: _display_trial_name(trial, names[trial.product_id])\n 135→              for trial in data.trials}\n 136→    before = _efficacy_records(data, names, trials)\n 137→    proposal = _proposal(before[0][0], before[1][0])\n 138→    data.efficacy_views[\"facts\"][0][\"source_locator\"] = {\n 139→        \"document_role\": \"publication\", \"page\": 99, \"table\": \"Table 1\",\n 140→    }\n 141→    after = _efficacy_records(data, names, trials)\n 142→    with pytest.raises(ValueError, match=\"摘要\"):\n 143→        _groups_for_page(\"efficacy\", after, semantic_proposals=(proposal,))\n 144→\n 145→\n 146→def test_detail_projects_full_scientific_partition_without_regrouping() -> None:\n 147→    from ci_workflow.renderers.portal.report_b import _project_scientific_groups\n 148→\n 149→    first, second = _rows()\n 150→    third = dict(second, row_id=\"third\", trial_id=\"trial-c\", actual_timepoint=52,\n 151→                 semantic_definition=\"第三种定义措辞\")\n 152→    proposals = (_proposal(first, second), _proposal(second, third))\n 153→    full = _groups_for_page(\"efficacy\", [(row, None) for row in (first, second, third)],\n 154→                            semantic_proposals=proposals)\n 155→    detail = _project_scientific_groups(full, [(second, None), (third, None)])\n 156→    assert {frozenset(row[\"row_id\"] for row in group[\"rows\"]) for group in detail} == {\n 157→        frozenset((\"second\",)), frozenset((\"third\",)),\n 158→    }\n 159→    assert {group[\"scientific_group_id\"] for group in detail} == {\n 160→        group[\"scientific_group_id\"] for group in full\n 161→    }\n 162→\n 163→\n 164→@pytest.mark.parametrize(\"page\", [\"baseline-overview\", \"disposition-overview\",\n 165→                                   \"efficacy-safety-matrix\"])\n 166→def test_descriptive_domains_honor_veto_and_reject_positive_adjudication(page: str) -> None:\n 167→    from tests.reports.b.test_r13_semantic_grouping import _project_baseline\n 168→\n 169→    first = _project_baseline(\"a\", product_id=\"product-a\", trial_id=\"trial-a\", population=\"FAS\")\n 170→    second = _project_baseline(\"b\", product_id=\"product-b\", trial_id=\"trial-b\", population=\"FAS\")\n 171→    proposal = _proposal(first, second)\n 172→    groups = _groups_for_page(\n 173→        page, [(first, None), (second, None)],\n 174→        semantic_proposals=(proposal.model_copy(update={\"compatible\": False}),),\n 175→    )\n 176→    assert len(groups) == 2\n 177→    with pytest.raises(ValueError, match=\"描述性\"):\n 178→        _groups_for_page(page, [(first, None), (second, None)], semantic_proposals=(proposal,))\n 179→\n 180→\n 181→def test_projection_rejects_changed_fact_instead_of_returning_previous_value() -> None:\n 182→    from ci_workflow.renderers.portal.report_b import _project_scientific_groups\n 183→\n 184→    first, second = _rows()\n 185→    groups = _groups_for_page(\"efficacy\", [(first, None), (second, None)],\n 186→                             semantic_proposals=(_proposal(first, second),))\n 187→    with pytest.raises(ValueError, match=\"摘要\"):\n 188→        _project_scientific_groups(groups, [(dict(second, value=99), None)])\n 189→\n 190→\n 191→def test_duplicate_identity_rejects_conflicting_fact_or_domain() -> None:\n 192→    from ci_workflow.renderers.portal.report_b import _dedupe_records\n 193→\n 194→    first, _ = _rows()\n 195→    assert len(_dedupe_records([(first, None), (dict(first), None)])) == 1\n 196→    for changed in (dict(first, value=99), dict(first, _domain=\"safety\")):\n 197→        with pytest.raises(ValueError, match=\"冲突\"):\n 198→            _dedupe_records([(first, None), (changed, None)])\n 199→\n 200→\n 201→def test_full_view_rejects_cross_domain_proposal_before_dispatch() -> None:\n 202→    from tests.reports.b.test_r13_semantic_grouping import _project_baseline\n 203→\n 204→    first, _ = _rows()\n 205→    second = _project_baseline(\"baseline-b\", product_id=\"b\", trial_id=\"b\", population=\"FAS\")\n 206→    with pytest.raises(ValueError, match=\"跨域\"):\n 207→        _groups_for_page(\"product-trial-profiles\", [\n 208→            (dict(first, _domain=\"efficacy\"), None),\n 209→            (dict(second, _domain=\"baseline\"), None),\n 210→        ], semantic_proposals=(_proposal(first, second),))\n 211→\n 212→\n 213→def test_conflicting_identity_fails_before_touching_existing_site(tmp_path) -> None:\n 214→    from ci_workflow.renderers.portal.report_b import ReportBPortalData, render_report_b_site\n 215→    from tests.browser.test_b_semantic_proposals import proposal_data\n 216→\n 217→    payload = proposal_data().model_dump(mode=\"json\")\n 218→    payload[\"semantic_proposals\"] = []\n 219→    payload[\"safety_views\"] = {\"facts\": [dict(\n 220→        payload[\"efficacy_views\"][\"facts\"][0], value=2, original_endpoint=\"TEAE\",\n 221→        original_definition=\"治疗期间不良事件\", source_version_id=\"synthetic-safety-source\",\n 222→    )]}\n 223→    site = tmp_path / \"html\"\n 224→    site.mkdir()\n 225→    sentinel = site / \"keep.txt\"\n 226→    sentinel.write_text(\"existing user artifact\", encoding=\"utf-8\")\n 227→    with pytest.raises(ValueError, match=\"冲突\"):\n 228→        render_report_b_site(ReportBPortalData.model_validate(payload), site)\n 229→    assert sentinel.read_text(encoding=\"utf-8\") == \"existing user artifact\"\n 230→    assert list(site.iterdir()) == [sentinel]\n 231→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c814538730096a911257036bf63","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80