8→    \"participant_flow\": \"受试者流转\",\n 249→    \"reason\": \"原因\",\n 250→    \"subject\": \"受试者\",\n 251→    \"mean\": \"均值\",\n 252→    \"proportion\": \"比例\",\n 253→    \"count\": \"例数\",\n 254→    \"response_rate\": \"应答率\",\n 255→    \"comparable\": \"可比较\",\n 256→    \"unplottable\": \"暂不形成坐标\",\n 257→    \"accepted\": \"已核定\",\n 258→    \"registry_result_or_primary_report\": \"登记结果或主要试验报告\",\n 259→    \"reported_value\": \"已报告值\",\n 260→    \"reported_zero\": \"已报告零值\",\n 261→    **_MISSING_STATE_LABELS,\n 262→}\n 263→# ---------------------------------------------------------------------------\n 264→# Controlled clinical semantics for cross-trial presentation\n 265→# ---------------------------------------------------------------------------\n 266→\n 267→# Presentation grouping is deliberately controlled.  These aliases are not a\n 268→# general-purpose similarity matcher: an observation only joins a clinical\n 269→# family when its normalized token is explicitly listed here.\n 270→_SEMANTIC_TOKEN_RE = re.compile(r\"[^0-9a-z\\u3400-\\u9fff]+\")\n 271→\n 272→\n 273→def _semantic_token(value: Any) -> str:\n 274→    if isinstance(value, Enum):\n 275→        value = value.value\n 276→    if value is None:\n 277→        return \"\"\n 278→    text = str(value).strip().casefold()\n 279→    text = text.replace(\"≥\", \"ge\").replace(\"≤\", \"le\").replace(\"％\", \"%\")\n 280→    return _SEMANTIC_TOKEN_RE.sub(\"\", text)\n 281→\n 282→\n 283→def _concept_family(*concepts: str) -> frozenset[str]:\n 284→    return frozenset(_semantic_token(concept) for concept in concepts)\n 285→\n 286→\n 287→_BASELINE_CONCEPT_FAMILY_ORDER: tuple[frozenset[str], ...] = (\n 288→    _concept_family(\"baseline_sample_size\", \"sample_size\", \"baseline_n\", \"n\"),\n 289→    _concept_family(\"age\", \"baseline_age\", \"age_at_baseline\"),\n 290→    _concept_family(\"sex\", \"gender\", \"baseline_sex\", \"baseline_gender\"),\n 291→    _concept_family(\"disease_duration\"),\n 292→    _concept_family(\"baseline_easi\", \"baseline_hemoglobin\", \"baseline_ldh\"),\n 293→)\n 294→\n 295→\n 296→def _alias_lookup(groups: Mapping[str, Sequence[str]]) -> dict[str, str]:\n 297→    result: dict[str, str] = {}\n 298→    for canonical, aliases in groups.items():\n 299→        for alias in (canonical, *aliases):\n 300→            token = _semantic_token(alias)\n 301→            if not token:\n 302→                continue\n 303→            existing = result.get(token)\n 304→            if existing is not None and existing != canonical:\n 305→                raise RuntimeError(f\"B 类临床别名冲突：{token}\")\n 306→            result[token] = canonical\n 307→    return result\n 308→\n 309→\n 310→_CLINICAL_CONCEPT_GROUPS: dict[str, dict[str, tuple[str, ...]]] = {\n 311→    \"efficacy\": {\n 312→        \"easi75_response\": (\n 313→            \"easi75\",\n 314→            \"easi_75\",\n 315→            \"easi-75\",\n 316→            \"easi75_response\",\n 317→            \"easi 75 response\",\n 318→            \"easi-75 response\",\n 319→            \"easi-75 responder rate\",\n 320→            \"easi75 responder rate\",\n 321→            \"easi-75 应答\",\n 322→            \"easi-75应答者比例\",\n 323→            \"easi75应答率\",\n 324→            \"easi-75 responder proportion\",\n 325→            \"easi75 responder proportion\",\n 326→            \"easi-75应答比例\",\n 327→            \"easi-75 response rate\",\n 328→            \"easi 75 response rate\",\n 329→            \"easi75 response rate\",\n 330→            \"easi-75 responders\",\n 331→        ),\n 332→        \"easi90_response\": (\n 333→            \"easi90\",\n 334→            \"easi_90\",\n 335→            \"easi-90\",\n 336→            \"easi90_response\",\n 337→            \"easi-90 response\",\n 338→            \"easi-90 responder rate\",\n 339→            \"easi-90应答\",\n 340→            \"easi-90 response rate\",\n 341→            \"easi 90 response rate\",\n 342→            \"easi90 response rate\",\n 343→        ),