{"type":"user","uuid":"01a08c81-23dd-7105-9ae1-211017685924","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_pMQZEwE1xI4ZhqHijvtdHjEl","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→import re\n   4→from typing import Literal\n   5→from urllib.parse import urlencode\n   6→from xml.etree import ElementTree\n   7→\n   8→from pydantic import BaseModel, ConfigDict, field_validator\n   9→\n  10→_NCT_ID = re.compile(r\"NCT[0-9]{8}\", re.IGNORECASE)\n  11→PublicationRole = Literal[\n  12→    \"primary_report\",\n  13→    \"ad_hoc_analysis\",\n  14→    \"review\",\n  15→    \"supporting_publication\",\n  16→    \"unrelated\",\n  17→]\n  18→EvidenceFieldDomain = Literal[\"trial_design\", \"efficacy\", \"safety\"]\n  19→EvidenceSourceRole = Literal[\n  20→    \"clinical_trial_registry\",\n  21→    \"primary_publication\",\n  22→    \"regulatory_material\",\n  23→    \"supplementary_material\",\n  24→]\n  25→\n  26→\n  27→class PubMedRecord(BaseModel):\n  28→    \"\"\"由 PubMed EFetch 原文解析得到的最小不可变记录。\"\"\"\n  29→\n  30→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  31→\n  32→    pmid: str\n  33→    title: str\n  34→    abstract: str\n  35→    publication_types: tuple[str, ...]\n  36→\n  37→    @field_validator(\"pmid\")\n  38→    @classmethod\n  39→    def _pmid_is_numeric(cls, value: str) -> str:\n  40→        normalized = value.strip()\n  41→        if not normalized.isdigit():\n  42→            raise ValueError(\"PubMed 标识必须为数字\")\n  43→        return normalized\n  44→\n  45→    @field_validator(\"title\")\n  46→    @classmethod\n  47→    def _title_is_not_blank(cls, value: str) -> str:\n  48→        normalized = \" \".join(value.split())\n  49→        if not normalized:\n  50→            raise ValueError(\"PubMed 题名不能为空\")\n  51→        return normalized\n  52→\n  53→    @field_validator(\"abstract\")\n  54→    @classmethod\n  55→    def _normalize_abstract(cls, value: str) -> str:\n  56→        return \" \".join(value.split())\n  57→\n  58→\n  59→class ClassifiedPublication(BaseModel):\n  60→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  61→\n  62→    record: PubMedRecord\n  63→    role: PublicationRole\n  64→    matched_nct_ids: tuple[str, ...]\n  65→    classification_signals: tuple[str, ...]\n  66→    rationale_zh: str\n  67→    can_replace_primary_report: bool\n  68→\n  69→\n  70→class EvidenceContribution(BaseModel):\n  71→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  72→\n  73→    field_id: str\n  74→    field_domain: EvidenceFieldDomain\n  75→    source_role: EvidenceSourceRole\n  76→    source_record_id: str\n  77→\n  78→    @field_validator(\"field_id\", \"source_record_id\")\n  79→    @classmethod\n  80→    def _contribution_text_is_not_blank(cls, value: str) -> str:\n  81→        normalized = \" \".join(value.split())\n  82→        if not normalized:\n  83→            raise ValueError(\"证据字段和来源记录标识不能为空\")\n  84→        return normalized\n  85→\n  86→\n  87→class RejectedContribution(BaseModel):\n  88→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  89→\n  90→    contribution: EvidenceContribution\n  91→    rationale_zh: str\n  92→\n  93→\n  94→class KeyFieldCoverage(BaseModel):\n  95→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  96→\n  97→    accepted_contributions: tuple[EvidenceContribution, ...]\n  98→    rejected_contributions: tuple[RejectedContribution, ...]\n  99→    missing_fields: tuple[str, ...]\n 100→    supplement_state: Literal[\"not_required\", \"required\"]\n 101→    rationale_zh: str\n 102→\n 103→\n 104→def build_pubmed_nct_search_url(nct_id: str) -> str:\n 105→    normalized = nct_id.strip().upper()\n 106→    if re.fullmatch(r\"NCT[0-9]{8}\", normalized) is None:\n 107→        raise ValueError(\"PubMed NCT 检索需要有效 NCT 号\")\n 108→    query = urlencode(\n 109→        {\n 110→            \"db\": \"pubmed\",\n 111→            \"term\": f\"{normalized}[All Fields]\",\n 112→            \"retmode\": \"json\",\n 113→            \"retmax\": \"10000\",\n 114→        }\n 115→    )\n 116→    return f\"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?{query}\"\n 117→\n 118→\n 119→def _element_text(element: ElementTree.Element | None) -> str:\n 120→    if element is None:\n 121→        return \"\"\n 122→    return \" \".join(\"\".join(element.itertext()).split())\n 123→\n 124→\n 125→def parse_pubmed_efetch_xml(xml_text: str) -> tuple[PubMedRecord, ...]:\n 126→    \"\"\"Parse article identities only from MedlineCitation, never nested relation PMIDs.\"\"\"\n 127→    try:\n 128→        root = ElementTree.fromstring(xml_text)\n 129→    except ElementTree.ParseError as exc:\n 130→        raise ValueError(\"PubMed EFetch XML 无法解析\") from exc\n 131→    records: list[PubMedRecord] = []\n 132→    for article_node in root.findall(\"./PubmedArticle\"):\n 133→        citation = article_node.find(\"./MedlineCitation\")\n 134→        if citation is None:\n 135→            continue\n 136→        pmid = _element_text(citation.find(\"./PMID\"))\n 137→        article = citation.find(\"./Article\")\n 138→        if article is None:\n 139→            raise ValueError(f\"PubMed 记录 {pmid or '未知'} 缺少 Article\")\n 140→        title = _element_text(article.find(\"./ArticleTitle\"))\n 141→        abstract_parts: list[str] = []\n 142→        for abstract_node in article.findall(\"./Abstract/AbstractText\"):\n 143→            text = _element_text(abstract_node)\n 144→            if not text:\n 145→                continue\n 146→            label = \" \".join(abstract_node.attrib.get(\"Label\", \"\").split())\n 147→            abstract_parts.append(f\"{label}: {text}\" if label else text)\n 148→        publication_types = tuple(\n 149→            text\n 150→            for item in article.findall(\"./PublicationTypeList/PublicationType\")\n 151→            if (text := _element_text(item))\n 152→        )\n 153→        records.append(\n 154→            PubMedRecord(\n 155→                pmid=pmid,\n 156→                title=title,\n 157→                abstract=\" \".join(abstract_parts),\n 158→                publication_types=publication_types,\n 159→            )\n 160→        )\n 161→    return tuple(records)\n 162→\n 163→\n 164→def _classify(record: PubMedRecord, matched: tuple[str, ...]) -> ClassifiedPublication:\n 165→    combined = f\"{record.title}\\n{record.abstract}\".casefold()\n 166→    publication_types = {item.casefold() for item in record.publication_types}\n 167→    review_signals = (\n 168→        bool(publication_types & {\"review\", \"meta-analysis\", \"systematic review\"})\n 169→        or \"systematic review\" in combined\n 170→        or \"meta-analysis\" in combined\n 171→    )\n 172→    ad_hoc_signals = any(\n 173→        marker in combined\n 174→        for marker in (\"post hoc\", \"post-hoc\", \"subgroup analysis\", \"exploratory analysis\")\n 175→    )\n 176→    randomized_signal = (\n 177→        \"randomized controlled trial\" in publication_types\n 178→        or \"randomised\" in combined\n 179→        or \"randomized\" in combined\n 180→        or \"phase 2\" in combined\n 181→        or \"phase 3\" in combined\n 182→    )\n 183→    protocol_signal = (\n 184→        \"clinical trial protocol\" in publication_types\n 185→        or \"study protocol\" in combined\n 186→        or combined.startswith(\"protocol \")\n 187→    )\n 188→    primary_endpoint_signal = any(\n 189→        marker in combined\n 190→        for marker in (\n 191→            \"primary endpoint\",\n 192→            \"primary endpoints\",\n 193→            \"co-primary endpoint\",\n 194→            \"co-primary endpoints\",\n 195→            \"primary outcome\",\n 196→            \"primary outcomes\",\n 197→        )\n 198→    )\n 199→    result_signal = any(\n 200→        marker in combined\n 201→        for marker in (\n 202→            \"results are reported\",\n 203→            \"results showed\",\n 204→            \"we report\",\n 205→            \"efficacy and safety\",\n 206→            \"trial findings\",\n 207→        )\n 208→    )\n 209→    signals: tuple[str, ...]\n 210→    if not matched:\n 211→        role: PublicationRole = \"unrelated\"\n 212→        signals = (\"未匹配目标 NCT\",)\n 213→        rationale = \"正文未匹配目标试验登记号，不能据此建立论文—试验关系。\"\n 214→    elif review_signals:\n 215→        role = \"review\"\n 216→        signals = (\"综述或荟萃分析出版类型\",)\n 217→        rationale = \"出版类型或题名摘要表明这是综述/荟萃分析，不能替代主要结果报告。\"\n 218→    elif ad_hoc_signals:\n 219→        role = \"ad_hoc_analysis\"\n 220→        signals = (\"事后、亚组或探索性分析用语\",)\n 221→        rationale = \"题名或摘要明确标记事后、亚组或探索性分析。\"\n 222→    elif protocol_signal:\n 223→        role = \"supporting_publication\"\n 224→        signals = (\"目标 NCT\", \"试验方案出版类型或用语\")\n 225→        rationale = \"这是试验方案或设计论文，不得按主要结果报告使用。\"\n 226→    elif randomized_signal and primary_endpoint_signal and result_signal:\n 227→        role = \"primary_report\"\n 228→        signals = (\"目标 NCT\", \"随机/分期试验\", \"主要终点结果\")\n 229→        rationale = \"论文匹配目标 NCT，并报告随机/分期试验的共同主要终点或主要终点结果。\"\n 230→    else:\n 231→        role = \"supporting_publication\"\n 232→        signals = (\"目标 NCT\", \"未满足主要报告判定条件\")\n 233→        rationale = \"论文与目标 NCT 有关，但未同时提供主要报告所需的试验与主要终点信号。\"\n 234→    return ClassifiedPublication(\n 235→        record=record,\n 236→        role=role,\n 237→        matched_nct_ids=matched,\n 238→        classification_signals=signals,\n 239→        rationale_zh=rationale,\n 240→        can_replace_primary_report=role == \"primary_report\",\n 241→    )\n 242→\n 243→\n 244→def classify_pubmed_records(\n 245→    records: tuple[PubMedRecord, ...], *, target_nct_ids: tuple[str, ...]\n 246→) -> tuple[ClassifiedPublication, ...]:\n 247→    normalized_targets = tuple(dict.fromkeys(item.strip().upper() for item in target_nct_ids))\n 248→    if not normalized_targets or any(\n 249→        re.fullmatch(r\"NCT[0-9]{8}\", item) is None for item in normalized_targets\n 250→    ):\n 251→        raise ValueError(\"论文分类需要至少一个有效目标 NCT 号\")\n 252→    target_set = set(normalized_targets)\n 253→    classified: list[ClassifiedPublication] = []\n 254→    for record in records:\n 255→        text = f\"{record.title}\\n{record.abstract}\"\n 256→        mentioned = {item.upper() for item in _NCT_ID.findall(text)}\n 257→        matched = tuple(item for item in normalized_targets if item in mentioned & target_set)\n 258→        classified.append(_classify(record, matched))\n 259→    return tuple(classified)\n 260→\n 261→\n 262→def assess_key_field_coverage(\n 263→    contributions: tuple[EvidenceContribution, ...], *, required_fields: tuple[str, ...]\n 264→) -> KeyFieldCoverage:\n 265→    required = tuple(dict.fromkeys(\" \".join(item.split()) for item in required_fields))\n 266→    if not required or any(not item for item in required):\n 267→        raise ValueError(\"关键字段清单不能为空\")\n 268→    accepted: list[EvidenceContribution] = []\n 269→    rejected: list[RejectedContribution] = []\n 270→    for contribution in contributions:\n 271→        if contribution.field_domain == \"trial_design\" and contribution.source_role not in {\n 272→            \"clinical_trial_registry\",\n 273→            \"regulatory_material\",\n 274→        }:\n 275→            rejected.append(\n 276→                RejectedContribution(\n 277→                    contribution=contribution,\n 278→                    rationale_zh=(\n 279→                        \"论文及其补充材料可用于结果交叉核验，但不能替代登记平台或监管材料中的方案字段。\"\n 280→                    ),\n 281→                )\n 282→            )\n 283→            continue\n 284→        accepted.append(contribution)\n 285→    covered = {item.field_id for item in accepted}\n 286→    missing = tuple(item for item in required if item not in covered)\n 287→    if missing:\n 288→        state: Literal[\"not_required\", \"required\"] = \"required\"\n 289→        rationale = \"现有主要来源尚未覆盖全部关键字段，需要继续寻找适用材料。\"\n 290→    else:\n 291→        state = \"not_required\"\n 292→        rationale = \"登记结果、主要论文或监管材料已覆盖关键疗效、安全性和方案字段。\"\n 293→    return KeyFieldCoverage(\n 294→        accepted_contributions=tuple(accepted),\n 295→        rejected_contributions=tuple(rejected),\n 296→        missing_fields=missing,\n 297→        supplement_state=state,\n 298→        rationale_zh=rationale,\n 299→    )\n 300→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c81113375e5b5b01ad761ea95d2","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c81113375e5b5b01ad761ea95d2","codebuddy.ai/llmMessageId":"01a08c81113375e5b5b01ad761ea95d2","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:48.701Z"}
{"type":"user","uuid":"01a08c81-23f1-7b51-ae4a-6476cb535c79","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_HEpLr2wedzSbNhTNhck7qg8d","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→import re\n   4→from collections.abc import Mapping\n   5→from datetime import date, datetime\n   6→from typing import Literal\n   7→\n   8→from pydantic import BaseModel, ConfigDict, field_validator, model_validator\n   9→\n  10→from ci_workflow.domain.evidence import EvidenceLocator\n  11→from ci_workflow.domain.ids import stable_id\n  12→\n  13→_SHA256 = re.compile(r\"[0-9a-f]{64}\")\n  14→\n  15→\n  16→def _text(value: str) -> str:\n  17→    normalized = \" \".join(value.split())\n  18→    if not normalized:\n  19→        raise ValueError(\"监管材料字段不能为空\")\n  20→    return normalized\n  21→\n  22→\n  23→def _datetime(value: str) -> datetime:\n  24→    parsed = datetime.fromisoformat(value)\n  25→    if parsed.tzinfo is None or parsed.utcoffset() is None:\n  26→        raise ValueError(\"监管材料日期必须包含明确时区\")\n  27→    return parsed\n  28→\n  29→\n  30→class RegulatoryClaimScope(BaseModel):\n  31→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  32→\n  33→    claim_domain: str\n  34→    locator: EvidenceLocator\n  35→\n  36→    @field_validator(\"claim_domain\")\n  37→    @classmethod\n  38→    def _claim_domain_is_not_blank(cls, value: str) -> str:\n  39→        return _text(value)\n  40→\n  41→\n  42→class RegulatoryDocumentVersion(BaseModel):\n  43→    \"\"\"一个监管文件的不可变版本及其允许支持的声明领域。\"\"\"\n  44→\n  45→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  46→\n  47→    source_document_id: str\n  48→    source_version_id: str\n  49→    jurisdiction: str\n  50→    authority: str\n  51→    document_id: str\n  52→    title: str\n  53→    version_label: str\n  54→    published_at: datetime\n  55→    acquired_at: datetime\n  56→    content_sha256: str\n  57→    source_url: str\n  58→    claim_scopes: tuple[RegulatoryClaimScope, ...]\n  59→\n  60→    @field_validator(\n  61→        \"jurisdiction\",\n  62→        \"authority\",\n  63→        \"document_id\",\n  64→        \"title\",\n  65→        \"version_label\",\n  66→        \"source_url\",\n  67→    )\n  68→    @classmethod\n  69→    def _required_text(cls, value: str) -> str:\n  70→        return _text(value)\n  71→\n  72→    @field_validator(\"content_sha256\")\n  73→    @classmethod\n  74→    def _valid_sha256(cls, value: str) -> str:\n  75→        if _SHA256.fullmatch(value) is None:\n  76→            raise ValueError(\"监管材料内容摘要必须是小写 SHA-256\")\n  77→        return value\n  78→\n  79→    @field_validator(\"published_at\", \"acquired_at\")\n  80→    @classmethod\n  81→    def _dates_have_offsets(cls, value: datetime) -> datetime:\n  82→        if value.tzinfo is None or value.utcoffset() is None:\n  83→            raise ValueError(\"监管材料日期必须包含明确时区\")\n  84→        return value\n  85→\n  86→    @classmethod\n  87→    def create(\n  88→        cls,\n  89→        *,\n  90→        jurisdiction: str,\n  91→        authority: str,\n  92→        document_id: str,\n  93→        title: str,\n  94→        version_label: str,\n  95→        published_at: str,\n  96→        acquired_at: str,\n  97→        content_sha256: str,\n  98→        source_url: str,\n  99→        claim_scopes: tuple[Mapping[str, str], ...],\n 100→    ) -> RegulatoryDocumentVersion:\n 101→        jurisdiction = _text(jurisdiction).upper()\n 102→        authority = _text(authority)\n 103→        document_id = _text(document_id)\n 104→        source_document_id = stable_id(\n 105→            \"regulatory-document\", jurisdiction, authority, document_id\n 106→        )\n 107→        scopes: list[RegulatoryClaimScope] = []\n 108→        for item in claim_scopes:\n 109→            missing = {\"claim_domain\", \"field_path\", \"locator_label\"} - set(item)\n 110→            if missing:\n 111→                raise ValueError(\"监管材料声明范围缺少领域、字段或位置\")\n 112→            scopes.append(\n 113→                RegulatoryClaimScope(\n 114→                    claim_domain=item[\"claim_domain\"],\n 115→                    locator=EvidenceLocator(\n 116→                        document_role=f\"{authority} 监管材料\",\n 117→                        field_path=item[\"field_path\"],\n 118→                        paragraph=item[\"locator_label\"],\n 119→                        url=source_url,\n 120→                    ),\n 121→                )\n 122→            )\n 123→        if not scopes:\n 124→            raise ValueError(\"监管材料必须明确至少一个声明领域\")\n 125→        if len({item.claim_domain for item in scopes}) != len(scopes):\n 126→            raise ValueError(\"同一监管材料版本的声明领域不得重复\")\n 127→        return cls(\n 128→            source_document_id=source_document_id,\n 129→            source_version_id=stable_id(\n 130→                \"regulatory-version\", source_document_id, version_label, content_sha256\n 131→            ),\n 132→            jurisdiction=jurisdiction,\n 133→            authority=authority,\n 134→            document_id=document_id,\n 135→            title=title,\n 136→            version_label=version_label,\n 137→            published_at=_datetime(published_at),\n 138→            acquired_at=_datetime(acquired_at),\n 139→            content_sha256=content_sha256,\n 140→            source_url=source_url,\n 141→            claim_scopes=tuple(scopes),\n 142→        )\n 143→\n 144→    def allows_claim(self, claim_domain: str) -> bool:\n 145→        normalized = _text(claim_domain)\n 146→        return any(item.claim_domain == normalized for item in self.claim_scopes)\n 147→\n 148→\n 149→class GuidelineBasis(BaseModel):\n 150→    \"\"\"监管指南的一条版本化、可定位使用依据。\"\"\"\n 151→\n 152→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 153→\n 154→    guideline_series_id: str\n 155→    guideline_version_id: str\n 156→    jurisdiction: str\n 157→    agency: str\n 158→    document_id: str\n 159→    title: str\n 160→    guidance_status: Literal[\"draft\", \"final\"]\n 161→    version_date: date\n 162→    population_context: str\n 163→    development_context: str\n 164→    source_url: str\n 165→    locator: EvidenceLocator\n 166→    content_sha256: str\n 167→    captured_at: datetime\n 168→    lifecycle_status: Literal[\"active\", \"superseded\", \"withdrawn\"]\n 169→    supersedes_version_ids: tuple[str, ...] = ()\n 170→    superseded_by_version_id: str | None = None\n 171→    withdrawn_at: date | None = None\n 172→    can_drive_current_default: bool\n 173→\n 174→    @field_validator(\n 175→        \"guideline_series_id\",\n 176→        \"guideline_version_id\",\n 177→        \"jurisdiction\",\n 178→        \"agency\",\n 179→        \"document_id\",\n 180→        \"title\",\n 181→        \"population_context\",\n 182→        \"development_context\",\n 183→        \"source_url\",\n 184→    )\n 185→    @classmethod\n 186→    def _guideline_text_is_not_blank(cls, value: str) -> str:\n 187→        return _text(value)\n 188→\n 189→    @field_validator(\"content_sha256\")\n 190→    @classmethod\n 191→    def _guideline_sha256(cls, value: str) -> str:\n 192→        if _SHA256.fullmatch(value) is None:\n 193→            raise ValueError(\"指南内容摘要必须是小写 SHA-256\")\n 194→        return value\n 195→\n 196→    @field_validator(\"captured_at\")\n 197→    @classmethod\n 198→    def _captured_at_has_offset(cls, value: datetime) -> datetime:\n 199→        if value.tzinfo is None or value.utcoffset() is None:\n 200→            raise ValueError(\"指南采集时间必须包含明确时区\")\n 201→        return value\n 202→\n 203→    @model_validator(mode=\"after\")\n 204→    def _lifecycle_is_consistent(self) -> GuidelineBasis:\n 205→        expected = self.guidance_status == \"final\" and self.lifecycle_status == \"active\"\n 206→        if self.can_drive_current_default != expected:\n 207→            raise ValueError(\"指南当前默认状态与草案/生命周期不一致\")\n 208→        if self.lifecycle_status == \"superseded\" and not self.superseded_by_version_id:\n 209→            raise ValueError(\"已替代指南必须指向替代版本\")\n 210→        if self.lifecycle_status != \"superseded\" and self.superseded_by_version_id:\n 211→            raise ValueError(\"只有已替代指南可设置替代版本\")\n 212→        if self.lifecycle_status == \"withdrawn\" and self.withdrawn_at is None:\n 213→            raise ValueError(\"已撤回指南必须保存撤回日期\")\n 214→        if self.lifecycle_status != \"withdrawn\" and self.withdrawn_at is not None:\n 215→            raise ValueError(\"未撤回指南不得设置撤回日期\")\n 216→        return self\n 217→\n 218→    @classmethod\n 219→    def create(\n 220→        cls,\n 221→        *,\n 222→        jurisdiction: str,\n 223→        agency: str,\n 224→        document_id: str,\n 225→        title: str,\n 226→        guidance_status: Literal[\"draft\", \"final\"],\n 227→        version_date: str,\n 228→        population_context: str,\n 229→        development_context: str,\n 230→        source_url: str,\n 231→        locator_label: str,\n 232→        locator_page: int,\n 233→        content_sha256: str,\n 234→        captured_at: str,\n 235→        lifecycle_status: Literal[\"active\", \"superseded\", \"withdrawn\"],\n 236→        supersedes_version_ids: tuple[str, ...] = (),\n 237→        superseded_by_version_id: str | None = None,\n 238→        withdrawn_at: str | None = None,\n 239→    ) -> GuidelineBasis:\n 240→        jurisdiction = _text(jurisdiction).upper()\n 241→        agency = _text(agency)\n 242→        document_id = _text(document_id)\n 243→        series_id = stable_id(\"guideline-series\", jurisdiction, agency, document_id)\n 244→        parsed_version_date = date.fromisoformat(version_date)\n 245→        version_id = stable_id(\n 246→            \"guideline-version\",\n 247→            series_id,\n 248→            parsed_version_date.isoformat(),\n 249→            content_sha256,\n 250→        )\n 251→        return cls(\n 252→            guideline_series_id=series_id,\n 253→            guideline_version_id=version_id,\n 254→            jurisdiction=jurisdiction,\n 255→            agency=agency,\n 256→            document_id=document_id,\n 257→            title=title,\n 258→            guidance_status=guidance_status,\n 259→            version_date=parsed_version_date,\n 260→            population_context=population_context,\n 261→            development_context=development_context,\n 262→            source_url=source_url,\n 263→            locator=EvidenceLocator(\n 264→                document_role=f\"{agency} 指南\",\n 265→                page=locator_page,\n 266→                paragraph=locator_label,\n 267→                url=source_url,\n 268→            ),\n 269→            content_sha256=content_sha256,\n 270→            captured_at=_datetime(captured_at),\n 271→            lifecycle_status=lifecycle_status,\n 272→            supersedes_version_ids=tuple(\n 273→                dict.fromkeys(_text(item) for item in supersedes_version_ids)\n 274→            ),\n 275→            superseded_by_version_id=(\n 276→                None if superseded_by_version_id is None else _text(superseded_by_version_id)\n 277→            ),\n 278→            withdrawn_at=None if withdrawn_at is None else date.fromisoformat(withdrawn_at),\n 279→            can_drive_current_default=(\n 280→                guidance_status == \"final\" and lifecycle_status == \"active\"\n 281→            ),\n 282→        )\n 283→\n 284→\n 285→def select_current_guideline_basis(\n 286→    guidelines: tuple[GuidelineBasis, ...], *, jurisdiction: str, population_context: str\n 287→) -> tuple[GuidelineBasis, ...]:\n 288→    validate_guideline_lineage(guidelines)\n 289→    target_jurisdiction = _text(jurisdiction).upper()\n 290→    target_population = _text(population_context)\n 291→    current = tuple(\n 292→        item\n 293→        for item in guidelines\n 294→        if item.jurisdiction == target_jurisdiction\n 295→        and item.population_context == target_population\n 296→        and item.can_drive_current_default\n 297→    )\n 298→    return tuple(sorted(current, key=lambda item: (item.version_date, item.title), reverse=True))\n 299→\n 300→\n 301→def validate_guideline_lineage(guidelines: tuple[GuidelineBasis, ...]) -> None:\n 302→    by_version = {item.guideline_version_id: item for item in guidelines}\n 303→    if len(by_version) != len(guidelines):\n 304→        raise ValueError(\"指南版本标识不得重复\")\n 305→    current_by_series: dict[str, list[str]] = {}\n 306→    for item in guidelines:\n 307→        if item.can_drive_current_default:\n 308→            current_by_series.setdefault(item.guideline_series_id, []).append(\n 309→                item.guideline_version_id\n 310→            )\n 311→    if any(len(version_ids) > 1 for version_ids in current_by_series.values()):\n 312→        raise ValueError(\"同一指南系列存在多个当前版本\")\n 313→    for item in guidelines:\n 314→        if item.lifecycle_status == \"superseded\":\n 315→            successor_id = item.superseded_by_version_id\n 316→            if successor_id not in by_version:\n 317→                raise ValueError(\"已替代指南指向不存在的后续版本\")\n 318→            successor = by_version[successor_id]\n 319→            if item.guideline_version_id not in successor.supersedes_version_ids:\n 320→                raise ValueError(\"指南替代关系必须双向一致\")\n 321→        for predecessor_id in item.supersedes_version_ids:\n 322→            if predecessor_id not in by_version:\n 323→                raise ValueError(\"指南版本引用了不存在的历史版本\")\n 324→            predecessor = by_version[predecessor_id]\n 325→            if (\n 326→                predecessor.lifecycle_status != \"superseded\"\n 327→                or predecessor.superseded_by_version_id != item.guideline_version_id\n 328→            ):\n 329→                raise ValueError(\"指南替代关系必须双向一致\")\n 330→\n 331→    visited: set[str] = set()\n 332→    active_path: set[str] = set()\n 333→\n 334→    def visit(version_id: str) -> None:\n 335→        if version_id in active_path:\n 336→            raise ValueError(\"指南替代关系存在循环\")\n 337→        if version_id in visited:\n 338→            return\n 339→        active_path.add(version_id)\n 340→        successor_id = by_version[version_id].superseded_by_version_id\n 341→        if successor_id is not None:\n 342→            visit(successor_id)\n 343→        active_path.remove(version_id)\n 344→        visited.add(version_id)\n 345→\n 346→    for version_id in by_version:\n 347→        visit(version_id)\n 348→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c81113375e5b5b01ad761ea95d2","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c81113375e5b5b01ad761ea95d2","codebuddy.ai/llmMessageId":"01a08c81113375e5b5b01ad761ea95d2","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:48.721Z"}
{"type":"user","uuid":"01a08c81-23f3-7497-908a-83538eace9a3","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_d1rYXewzHpdHLe5vmQzAQzdt","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→import re\n   4→from datetime import datetime\n   5→from typing import Literal\n   6→\n   7→from pydantic import BaseModel, ConfigDict, field_validator, model_validator\n   8→\n   9→from ci_workflow.domain.evidence import EvidenceLocator\n  10→from ci_workflow.domain.ids import stable_id\n  11→\n  12→DisclosureKind = Literal[\n  13→    \"company_regulatory_filing\",\n  14→    \"company_press_release\",\n  15→    \"topline_results\",\n  16→    \"conference_abstract\",\n  17→    \"conference_presentation\",\n  18→    \"pipeline_summary\",\n  19→]\n  20→\n  21→_SHA256 = re.compile(r\"[0-9a-f]{64}\")\n  22→_DISCLOSURE_PROPERTIES: dict[DisclosureKind, tuple[str, bool, bool]] = {\n  23→    \"company_regulatory_filing\": (\"企业法定披露\", True, True),\n  24→    \"company_press_release\": (\"企业新闻披露\", True, True),\n  25→    \"topline_results\": (\"主要结果初步披露\", True, True),\n  26→    \"conference_abstract\": (\"学术会议摘要\", False, True),\n  27→    \"conference_presentation\": (\"学术会议披露\", False, True),\n  28→    \"pipeline_summary\": (\"企业管线概览\", True, False),\n  29→}\n  30→\n  31→\n  32→def _required_text(value: str) -> str:\n  33→    normalized = \" \".join(value.split())\n  34→    if not normalized:\n  35→        raise ValueError(\"企业披露字段不能为空\")\n  36→    return normalized\n  37→\n  38→\n  39→def _offset_datetime(value: str) -> datetime:\n  40→    parsed = datetime.fromisoformat(value)\n  41→    if parsed.tzinfo is None or parsed.utcoffset() is None:\n  42→        raise ValueError(\"企业披露日期时间必须包含明确时区\")\n  43→    return parsed\n  44→\n  45→\n  46→class CompanyDisclosureVersion(BaseModel):\n  47→    \"\"\"企业、topline 与会议披露的不可变版本及其证据成熟度。\"\"\"\n  48→\n  49→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  50→\n  51→    disclosure_kind: DisclosureKind\n  52→    source_record_id: str\n  53→    source_version_id: str\n  54→    issuer: str\n  55→    external_record_id: str\n  56→    title: str\n  57→    product_name: str\n  58→    trial_identifier: str | None\n  59→    disclosure_maturity_label_zh: str\n  60→    may_support_company_fact: bool\n  61→    may_support_numeric_result: bool\n  62→    is_trial_registry_result: bool = False\n  63→    is_peer_reviewed_publication: bool = False\n  64→    published_at: datetime\n  65→    acquired_at: datetime\n  66→    content_sha256: str\n  67→    source_url: str\n  68→    locator: EvidenceLocator\n  69→\n  70→    @field_validator(\n  71→        \"source_record_id\",\n  72→        \"source_version_id\",\n  73→        \"issuer\",\n  74→        \"external_record_id\",\n  75→        \"title\",\n  76→        \"product_name\",\n  77→        \"disclosure_maturity_label_zh\",\n  78→        \"source_url\",\n  79→    )\n  80→    @classmethod\n  81→    def _text_is_not_blank(cls, value: str) -> str:\n  82→        return _required_text(value)\n  83→\n  84→    @field_validator(\"trial_identifier\")\n  85→    @classmethod\n  86→    def _optional_trial_identifier_is_not_blank(cls, value: str | None) -> str | None:\n  87→        return None if value is None else _required_text(value)\n  88→\n  89→    @field_validator(\"content_sha256\")\n  90→    @classmethod\n  91→    def _content_sha256_is_valid(cls, value: str) -> str:\n  92→        if _SHA256.fullmatch(value) is None:\n  93→            raise ValueError(\"企业披露摘要必须是小写 SHA-256\")\n  94→        return value\n  95→\n  96→    @field_validator(\"published_at\", \"acquired_at\")\n  97→    @classmethod\n  98→    def _times_have_offsets(cls, value: datetime) -> datetime:\n  99→        if value.tzinfo is None or value.utcoffset() is None:\n 100→            raise ValueError(\"企业披露日期时间必须包含明确时区\")\n 101→        return value\n 102→\n 103→    @model_validator(mode=\"after\")\n 104→    def _maturity_matches_disclosure_kind(self) -> CompanyDisclosureVersion:\n 105→        label, supports_company, supports_numbers = _DISCLOSURE_PROPERTIES[\n 106→            self.disclosure_kind\n 107→        ]\n 108→        if self.is_peer_reviewed_publication:\n 109→            raise ValueError(\"企业或会议披露不能标记为同行评议论文\")\n 110→        if self.is_trial_registry_result:\n 111→            raise ValueError(\"企业或会议披露不能标记为试验登记结果\")\n 112→        if (\n 113→            self.disclosure_maturity_label_zh != label\n 114→            or self.may_support_company_fact != supports_company\n 115→            or self.may_support_numeric_result != supports_numbers\n 116→        ):\n 117→            raise ValueError(\"企业披露成熟度与披露类型不一致\")\n 118→        return self\n 119→\n 120→    @classmethod\n 121→    def create(\n 122→        cls,\n 123→        *,\n 124→        disclosure_kind: DisclosureKind,\n 125→        issuer: str,\n 126→        external_record_id: str,\n 127→        title: str,\n 128→        product_name: str,\n 129→        trial_identifier: str | None,\n 130→        published_at: str,\n 131→        acquired_at: str,\n 132→        content_sha256: str,\n 133→        source_url: str,\n 134→        locator_label: str,\n 135→    ) -> CompanyDisclosureVersion:\n 136→        label, supports_company, supports_numbers = _DISCLOSURE_PROPERTIES[\n 137→            disclosure_kind\n 138→        ]\n 139→        issuer = _required_text(issuer)\n 140→        external_record_id = _required_text(external_record_id)\n 141→        source_record_id = stable_id(\n 142→            \"company-disclosure\", disclosure_kind, issuer, external_record_id\n 143→        )\n 144→        return cls(\n 145→            disclosure_kind=disclosure_kind,\n 146→            source_record_id=source_record_id,\n 147→            source_version_id=stable_id(\n 148→                \"company-disclosure-version\", source_record_id, content_sha256\n 149→            ),\n 150→            issuer=issuer,\n 151→            external_record_id=external_record_id,\n 152→            title=title,\n 153→            product_name=product_name,\n 154→            trial_identifier=trial_identifier,\n 155→            disclosure_maturity_label_zh=label,\n 156→            may_support_company_fact=supports_company,\n 157→            may_support_numeric_result=supports_numbers,\n 158→            published_at=_offset_datetime(published_at),\n 159→            acquired_at=_offset_datetime(acquired_at),\n 160→            content_sha256=content_sha256,\n 161→            source_url=source_url,\n 162→            locator=EvidenceLocator(\n 163→                document_role=label,\n 164→                paragraph=locator_label,\n 165→                url=source_url,\n 166→            ),\n 167→        )\n 168→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c81113375e5b5b01ad761ea95d2","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c81113375e5b5b01ad761ea95d2","codebuddy.ai/llmMessageId":"01a08c81113375e5b5b01ad761ea95d2","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:48.723Z"}
{"type":"user","uuid":"01a08c81-23f4-7355-abaa-497fb3a8cb81","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_SNmg46k5vEIPrVyCWsYNC2bm","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→import hashlib\n   4→import json\n   5→import re\n   6→from collections.abc import Iterator, Mapping\n   7→from datetime import date, datetime, timedelta, timezone\n   8→from typing import Any, Literal\n   9→from urllib.parse import urlencode, urlsplit\n  10→\n  11→from pydantic import BaseModel, ConfigDict, field_validator, model_validator\n  12→\n  13→from ci_workflow.domain.evidence import EvidenceLocator\n  14→from ci_workflow.domain.ids import stable_id\n  15→from ci_workflow.sources.connectors.regulators import GuidelineBasis\n  16→from ci_workflow.sources.policy import ClaimDomain, SourceAuthority, SourcePolicy\n  17→\n  18→_SHA256 = re.compile(r\"[0-9a-f]{64}\")\n  19→ChinaAuthority = Literal[\"CDE\", \"NMPA\"]\n  20→ChinaRegulatoryEventType = Literal[\n  21→    \"application_accepted\",\n  22→    \"review_in_progress\",\n  23→    \"priority_review\",\n  24→    \"breakthrough_therapy\",\n  25→    \"clinical_trial_implied_license\",\n  26→    \"review_suspended\",\n  27→    \"application_withdrawn\",\n  28→    \"review_resumed\",\n  29→    \"marketing_approved\",\n  30→    \"approval_withdrawn\",\n  31→]\n  32→\n  33→_CDE_REGULATORY_EVENTS = {\n  34→    \"application_accepted\",\n  35→    \"review_in_progress\",\n  36→    \"priority_review\",\n  37→    \"breakthrough_therapy\",\n  38→    \"clinical_trial_implied_license\",\n  39→    \"review_suspended\",\n  40→    \"application_withdrawn\",\n  41→    \"review_resumed\",\n  42→}\n  43→_OFFICIAL_CHINA_DOMAINS = {\n  44→    \"CDE\": frozenset({\"cde.org.cn\", \"www.cde.org.cn\"}),\n  45→    \"NMPA\": frozenset({\"nmpa.gov.cn\", \"www.nmpa.gov.cn\"}),\n  46→}\n  47→_CHINA_TRIAL_DOMAINS = frozenset(\n  48→    {\"chinadrugtrials.org.cn\", \"www.chinadrugtrials.org.cn\"}\n  49→)\n  50→\n  51→\n  52→def _text(value: str) -> str:\n  53→    normalized = \" \".join(value.split())\n  54→    if not normalized:\n  55→        raise ValueError(\"中国监管记录字段不能为空\")\n  56→    return normalized\n  57→\n  58→\n  59→def _offset_datetime(value: str) -> datetime:\n  60→    parsed = datetime.fromisoformat(value)\n  61→    if parsed.tzinfo is None or parsed.utcoffset() is None:\n  62→        raise ValueError(\"中国监管记录日期时间必须包含明确时区\")\n  63→    return parsed\n  64→\n  65→\n  66→class ChinaRegulatoryRecordVersion(BaseModel):\n  67→    \"\"\"CDE/NMPA 的一个不可变公开记录版本和一个明确监管事件。\"\"\"\n  68→\n  69→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  70→\n  71→    source_record_id: str\n  72→    source_version_id: str\n  73→    event_id: str\n  74→    jurisdiction: Literal[\"CN\"] = \"CN\"\n  75→    authority: ChinaAuthority\n  76→    external_record_id: str\n  77→    product_name: str\n  78→    application_number: str\n  79→    indication: str\n  80→    event_type: ChinaRegulatoryEventType\n  81→    status_label_zh: str\n  82→    occurred_on: date\n  83→    published_at: datetime\n  84→    acquired_at: datetime\n  85→    content_snapshot: str\n  86→    content_sha256: str\n  87→    source_url: str\n  88→    locator: EvidenceLocator\n  89→    is_marketing_approval: bool\n  90→\n  91→    @field_validator(\n  92→        \"source_record_id\",\n  93→        \"source_version_id\",\n  94→        \"event_id\",\n  95→        \"external_record_id\",\n  96→        \"product_name\",\n  97→        \"application_number\",\n  98→        \"indication\",\n  99→        \"status_label_zh\",\n 100→        \"source_url\",\n 101→        \"content_snapshot\",\n 102→    )\n 103→    @classmethod\n 104→    def _required_text(cls, value: str) -> str:\n 105→        return _text(value)\n 106→\n 107→    @field_validator(\"content_sha256\")\n 108→    @classmethod\n 109→    def _valid_sha256(cls, value: str) -> str:\n 110→        if _SHA256.fullmatch(value) is None:\n 111→            raise ValueError(\"中国监管记录摘要必须是小写 SHA-256\")\n 112→        return value\n 113→\n 114→    @field_validator(\"published_at\", \"acquired_at\")\n 115→    @classmethod\n 116→    def _dates_have_offsets(cls, value: datetime) -> datetime:\n 117→        if value.tzinfo is None or value.utcoffset() is None:\n 118→            raise ValueError(\"中国监管记录日期时间必须包含明确时区\")\n 119→        return value\n 120→\n 121→    @model_validator(mode=\"after\")\n 122→    def _approval_flag_matches_event(self) -> ChinaRegulatoryRecordVersion:\n 123→        if self.is_marketing_approval != (self.event_type == \"marketing_approved\"):\n 124→            raise ValueError(\"只有 NMPA 批准上市事件可标记为已批准\")\n 125→        if (\n 126→            self.event_type in {\"marketing_approved\", \"approval_withdrawn\"}\n 127→            and self.authority != \"NMPA\"\n 128→        ):\n 129→            raise ValueError(\"批准及批准撤回事项必须归属 NMPA\")\n 130→        if self.event_type in _CDE_REGULATORY_EVENTS and self.authority != \"CDE\":\n 131→            raise ValueError(\"CDE 专有事项不能归属 NMPA\")\n 132→        parts = urlsplit(self.source_url)\n 133→        if (\n 134→            parts.scheme != \"https\"\n 135→            or parts.hostname not in _OFFICIAL_CHINA_DOMAINS[self.authority]\n 136→        ):\n 137→            raise ValueError(\"中国监管记录必须使用对应机构官方网站\")\n 138→        if self.locator.url != self.source_url:\n 139→            raise ValueError(\"中国监管记录定位链接必须与来源链接一致\")\n 140→        expected_digest = hashlib.sha256(\n 141→            self.content_snapshot.encode(\"utf-8\")\n 142→        ).hexdigest()\n 143→        if self.content_sha256 != expected_digest:\n 144→            raise ValueError(\"中国监管记录摘要与已保存正文不一致\")\n 145→        expected_record_id = stable_id(\n 146→            \"china-regulatory-record\", self.authority, self.external_record_id\n 147→        )\n 148→        expected_version_id = stable_id(\n 149→            \"china-regulatory-version\", expected_record_id, self.content_sha256\n 150→        )\n 151→        expected_event_id = stable_id(\n 152→            \"china-regulatory-event\",\n 153→            expected_record_id,\n 154→            self.event_type,\n 155→            self.occurred_on.isoformat(),\n 156→        )\n 157→        if self.source_record_id != expected_record_id:\n 158→            raise ValueError(\"中国监管记录标识与机构及记录编号不一致\")\n 159→        if self.source_version_id != expected_version_id:\n 160→            raise ValueError(\"中国监管记录版本与已保存正文不一致\")\n 161→        if self.event_id != expected_event_id:\n 162→            raise ValueError(\"中国监管事件标识与事件内容不一致\")\n 163→        return self\n 164→\n 165→    @classmethod\n 166→    def create(\n 167→        cls,\n 168→        *,\n 169→        source_system: ChinaAuthority,\n 170→        external_record_id: str,\n 171→        product_name: str,\n 172→        application_number: str,\n 173→        indication: str,\n 174→        event_type: ChinaRegulatoryEventType,\n 175→        status_label_zh: str,\n 176→        occurred_on: str,\n 177→        published_at: str,\n 178→        acquired_at: str,\n 179→        content_snapshot: str,\n 180→        source_url: str,\n 181→        locator_label: str,\n 182→    ) -> ChinaRegulatoryRecordVersion:\n 183→        authority = source_system\n 184→        external_record_id = _text(external_record_id)\n 185→        content_snapshot = _text(content_snapshot)\n 186→        content_sha256 = hashlib.sha256(content_snapshot.encode(\"utf-8\")).hexdigest()\n 187→        source_record_id = stable_id(\n 188→            \"china-regulatory-record\", authority, external_record_id\n 189→        )\n 190→        occurred = date.fromisoformat(occurred_on)\n 191→        return cls(\n 192→            source_record_id=source_record_id,\n 193→            source_version_id=stable_id(\n 194→                \"china-regulatory-version\", source_record_id, content_sha256\n 195→            ),\n 196→            event_id=stable_id(\n 197→                \"china-regulatory-event\",\n 198→                source_record_id,\n 199→                event_type,\n 200→                occurred.isoformat(),\n 201→            ),\n 202→            authority=authority,\n 203→            external_record_id=external_record_id,\n 204→            product_name=product_name,\n 205→            application_number=application_number,\n 206→            indication=indication,\n 207→            event_type=event_type,\n 208→            status_label_zh=status_label_zh,\n 209→            occurred_on=occurred,\n 210→            published_at=_offset_datetime(published_at),\n 211→            acquired_at=_offset_datetime(acquired_at),\n 212→            content_snapshot=content_snapshot,\n 213→            content_sha256=content_sha256,\n 214→            source_url=source_url,\n 215→            locator=EvidenceLocator(\n 216→                document_role=f\"{authority} 官方公开信息\",\n 217→                paragraph=locator_label,\n 218→                url=source_url,\n 219→            ),\n 220→            is_marketing_approval=event_type == \"marketing_approved\",\n 221→        )\n 222→\n 223→\n 224→def build_china_regulatory_timeline(\n 225→    records: tuple[ChinaRegulatoryRecordVersion, ...],\n 226→) -> tuple[ChinaRegulatoryRecordVersion, ...]:\n 227→    event_ids = tuple(item.event_id for item in records)\n 228→    if len(set(event_ids)) != len(event_ids):\n 229→        raise ValueError(\"中国监管时间线事件不得重复\")\n 230→    return tuple(\n 231→        sorted(records, key=lambda item: (item.occurred_on, item.authority, item.event_id))\n 232→    )\n 233→\n 234→\n 235→_CTR_ID = re.compile(r\"CTR[0-9]{8}\")\n 236→\n 237→\n 238→class ChinaDrugTrialVersion(BaseModel):\n 239→    \"\"\"中国药物临床试验登记平台的一个不可变公开页面版本。\"\"\"\n 240→\n 241→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 242→\n 243→    ctr_number: str\n 244→    source_trial_id: str\n 245→    source_version_id: str\n 246→    title: str\n 247→    trial_status: str\n 248→    protocol_number: str\n 249→    protocol_version: str\n 250→    updated_on: date\n 251→    first_disclosed_at: datetime\n 252→    first_disclosed_precision: Literal[\"calendar_day\"] = \"calendar_day\"\n 253→    acquired_at: datetime\n 254→    source_url: str\n 255→    result_disclosure_state: Literal[\"reported\", \"not_publicly_disclosed\"]\n 256→    raw_record_json: str\n 257→    content_sha256: str\n 258→\n 259→    @field_validator(\n 260→        \"ctr_number\",\n 261→        \"source_trial_id\",\n 262→        \"source_version_id\",\n 263→        \"title\",\n 264→        \"trial_status\",\n 265→        \"protocol_number\",\n 266→        \"protocol_version\",\n 267→        \"source_url\",\n 268→    )\n 269→    @classmethod\n 270→    def _trial_text_is_not_blank(cls, value: str) -> str:\n 271→        return _text(value)\n 272→\n 273→    @field_validator(\"ctr_number\")\n 274→    @classmethod\n 275→    def _valid_ctr(cls, value: str) -> str:\n 276→        normalized = value.upper()\n 277→        if _CTR_ID.fullmatch(normalized) is None:\n 278→            raise ValueError(\"中国登记记录缺少有效 CTR 号\")\n 279→        return normalized\n 280→\n 281→    @field_validator(\"acquired_at\", \"first_disclosed_at\")\n 282→    @classmethod\n 283→    def _trial_acquired_at_has_offset(cls, value: datetime) -> datetime:\n 284→        if value.tzinfo is None or value.utcoffset() is None:\n 285→            raise ValueError(\"中国登记采集时间必须包含明确时区\")\n 286→        return value\n 287→\n 288→    @field_validator(\"content_sha256\")\n 289→    @classmethod\n 290→    def _trial_digest_is_valid(cls, value: str) -> str:\n 291→        if _SHA256.fullmatch(value) is None:\n 292→            raise ValueError(\"中国登记记录摘要必须是小写 SHA-256\")\n 293→        return value\n 294→\n 295→    @model_validator(mode=\"after\")\n 296→    def _trial_snapshot_is_official_and_immutable(self) -> ChinaDrugTrialVersion:\n 297→        parts = urlsplit(self.source_url)\n 298→        if parts.scheme != \"https\" or parts.hostname not in _CHINA_TRIAL_DOMAINS:\n 299→            raise ValueError(\"中国试验登记记录必须使用官方平台链接\")\n 300→        expected_digest = hashlib.sha256(\n 301→            self.raw_record_json.encode(\"utf-8\")\n 302→        ).hexdigest()\n 303→        if self.content_sha256 != expected_digest:\n 304→            raise ValueError(\"中国登记记录摘要与已保存正文不一致\")\n 305→        expected_trial_id = stable_id(\n 306→            \"source-trial\", \"chinadrugtrials\", self.ctr_number\n 307→        )\n 308→        expected_version_id = stable_id(\n 309→            \"source-version\", \"chinadrugtrials\", self.ctr_number, expected_digest\n 310→        )\n 311→        if self.source_trial_id != expected_trial_id:\n 312→            raise ValueError(\"中国登记试验标识与 CTR 号不一致\")\n 313→        if self.source_version_id != expected_version_id:\n 314→            raise ValueError(\"中国登记版本与已保存正文不一致\")\n 315→        if any(\n 316→            (\n 317→                self.first_disclosed_at.hour,\n 318→                self.first_disclosed_at.minute,\n 319→                self.first_disclosed_at.second,\n 320→                self.first_disclosed_at.microsecond,\n 321→            )\n 322→        ):\n 323→            raise ValueError(\"仅公开自然日的首次披露时间必须按北京时间零点保存\")\n 324→        if self.first_disclosed_at.utcoffset() != timedelta(hours=8):\n 325→            raise ValueError(\"中国登记首次披露自然日必须按北京时间保存\")\n 326→        return self\n 327→\n 328→    @property\n 329→    def raw_record(self) -> dict[str, Any]:\n 330→        parsed = json.loads(self.raw_record_json)\n 331→        if not isinstance(parsed, dict):\n 332→            raise ValueError(\"已保存的中国登记记录不是对象\")\n 333→        return parsed\n 334→\n 335→    @classmethod\n 336→    def from_public_record(\n 337→        cls,\n 338→        record: Mapping[str, Any],\n 339→        *,\n 340→        acquired_at: str,\n 341→        source_url: str,\n 342→    ) -> ChinaDrugTrialVersion:\n 343→        required = {\n 344→            \"ctr_number\",\n 345→            \"trial_status\",\n 346→            \"protocol_number\",\n 347→            \"protocol_version\",\n 348→            \"updated_on\",\n 349→            \"first_disclosed_on\",\n 350→            \"sections\",\n 351→        }\n 352→        missing = required - set(record)\n 353→        if missing:\n 354→            raise ValueError(\"中国登记记录缺少必需字段\")\n 355→        ctr_number = str(record[\"ctr_number\"]).strip().upper()\n 356→        if _CTR_ID.fullmatch(ctr_number) is None:\n 357→            raise ValueError(\"中国登记记录缺少有效 CTR 号\")\n 358→        sections = record[\"sections\"]\n 359→        if not isinstance(sections, Mapping):\n 360→            raise ValueError(\"中国登记 sections 必须是对象\")\n 361→        title = _text(str(sections.get(\"试验题目\", \"\")))\n 362→        result_summary = sections.get(\"试验结果摘要\")\n 363→        has_results = isinstance(result_summary, Mapping) and bool(result_summary)\n 364→        canonical = json.dumps(\n 365→            record,\n 366→            ensure_ascii=False,\n 367→            sort_keys=True,\n 368→            separators=(\",\", \":\"),\n 369→        )\n 370→        source_trial_id = stable_id(\"source-trial\", \"chinadrugtrials\", ctr_number)\n 371→        content_sha256 = hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()\n 372→        first_disclosed_on = date.fromisoformat(str(record[\"first_disclosed_on\"]))\n 373→        first_disclosed_at = datetime.combine(\n 374→            first_disclosed_on,\n 375→            datetime.min.time(),\n 376→            tzinfo=timezone(timedelta(hours=8)),\n 377→        )\n 378→        return cls(\n 379→            ctr_number=ctr_number,\n 380→            source_trial_id=source_trial_id,\n 381→            source_version_id=stable_id(\n 382→                \"source-version\", \"chinadrugtrials\", ctr_number, content_sha256\n 383→            ),\n 384→            title=title,\n 385→            trial_status=str(record[\"trial_status\"]),\n 386→            protocol_number=str(record[\"protocol_number\"]),\n 387→            protocol_version=str(record[\"protocol_version\"]),\n 388→            updated_on=date.fromisoformat(str(record[\"updated_on\"])),\n 389→            first_disclosed_at=first_disclosed_at,\n 390→            acquired_at=_offset_datetime(acquired_at),\n 391→            source_url=source_url,\n 392→            result_disclosure_state=(\n 393→                \"reported\" if has_results else \"not_publicly_disclosed\"\n 394→            ),\n 395→            raw_record_json=canonical,\n 396→            content_sha256=content_sha256,\n 397→        )\n 398→\n 399→\n 400→class ChinaTrialObservation(BaseModel):\n 401→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 402→\n 403→    observation_id: str\n 404→    source_version_id: str\n 405→    ctr_number: str\n 406→    claim_domain: Literal[\"trial_design\", \"trial_results\"]\n 407→    original_value: str | int | float | bool\n 408→    locator: EvidenceLocator\n 409→\n 410→\n 411→def _walk_leaves(value: Any, path: str) -> Iterator[tuple[str, str | int | float | bool]]:\n 412→    if isinstance(value, Mapping):\n 413→        for key, child in value.items():\n 414→            yield from _walk_leaves(child, f\"{path}.{key}\")\n 415→        return\n 416→    if isinstance(value, list):\n 417→        for index, child in enumerate(value):\n 418→            yield from _walk_leaves(child, f\"{path}[{index}]\")\n 419→        return\n 420→    if isinstance(value, (str, int, float, bool)):\n 421→        yield path, value\n 422→\n 423→\n 424→def extract_china_trial_observations(\n 425→    trial: ChinaDrugTrialVersion,\n 426→) -> tuple[ChinaTrialObservation, ...]:\n 427→    sections = trial.raw_record.get(\"sections\")\n 428→    if not isinstance(sections, Mapping):\n 429→        raise ValueError(\"中国登记记录缺少可解析 sections\")\n 430→    observations: list[ChinaTrialObservation] = []\n 431→    for field_path, value in _walk_leaves(sections, \"sections\"):\n 432→        claim_domain: Literal[\"trial_design\", \"trial_results\"] = (\n 433→            \"trial_results\"\n 434→            if field_path.startswith(\"sections.试验结果摘要\")\n 435→            else \"trial_design\"\n 436→        )\n 437→        observations.append(\n 438→            ChinaTrialObservation(\n 439→                observation_id=stable_id(\n 440→                    \"china-trial-observation\", trial.source_version_id, field_path\n 441→                ),\n 442→                source_version_id=trial.source_version_id,\n 443→                ctr_number=trial.ctr_number,\n 444→                claim_domain=claim_domain,\n 445→                original_value=value,\n 446→                locator=EvidenceLocator(\n 447→                    document_role=\"中国药物临床试验登记与信息公示平台\",\n 448→                    field_path=field_path,\n 449→                    url=trial.source_url,\n 450→                ),\n 451→            )\n 452→        )\n 453→    return tuple(observations)\n 454→\n 455→\n 456→def build_china_trial_search_url(ctr_number: str) -> str:\n 457→    normalized = ctr_number.strip().upper()\n 458→    if _CTR_ID.fullmatch(normalized) is None:\n 459→        raise ValueError(\"中国登记检索需要有效 CTR 号\")\n 460→    query = urlencode({\"keywords\": normalized})\n 461→    return (\n 462→        \"https://www.chinadrugtrials.org.cn/clinicaltrials.searchlist.dhtml?\"\n 463→        f\"{query}\"\n 464→    )\n 465→\n 466→\n 467→ChinaDrugReferenceSystem = Literal[\n 468→    \"dxy_drug_assistant\", \"nmpa_official\", \"cde_official\"\n 469→]\n 470→ChinaDrugReferenceRole = Literal[\n 471→    \"secondary_drug_reference\",\n 472→    \"official_marketing_authority\",\n 473→    \"official_review_authority\",\n 474→]\n 475→\n 476→_CHINA_REFERENCE_ROLES: dict[\n 477→    ChinaDrugReferenceSystem, tuple[ChinaDrugReferenceRole, str, bool]\n 478→] = {\n 479→    \"dxy_drug_assistant\": (\n 480→        \"secondary_drug_reference\",\n 481→        \"专业药品资料（二次参考）\",\n 482→        False,\n 483→    ),\n 484→    \"nmpa_official\": (\n 485→        \"official_marketing_authority\",\n 486→        \"国家药品监督管理局官方信息\",\n 487→        True,\n 488→    ),\n 489→    \"cde_official\": (\n 490→        \"official_review_authority\",\n 491→        \"国家药品监督管理局药品审评中心官方信息\",\n 492→        True,\n 493→    ),\n 494→}\n 495→_CHINA_REFERENCE_POLICY_SOURCES: dict[ChinaDrugReferenceSystem, str] = {\n 496→    \"dxy_drug_assistant\": \"dxy_drug_assistant\",\n 497→    \"nmpa_official\": \"regulator_official\",\n 498→    \"cde_official\": \"cde\",\n 499→}\n 500→\n 501→\n 502→class ChinaDrugReferenceVersion(BaseModel):\n 503→    \"\"\"国内药品参考页的不可变版本，明确区分官方事实与二次参考。\"\"\"\n 504→\n 505→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 506→\n 507→    source_system: ChinaDrugReferenceSystem\n 508→    source_record_id: str\n 509→    source_version_id: str\n 510→    external_record_id: str\n 511→    product_name: str\n 512→    content_label_zh: str\n 513→    source_role: ChinaDrugReferenceRole\n 514→    source_role_label_zh: str\n 515→    may_establish_official_regulatory_status: bool\n 516→    policy_id: str\n 517→    policy_version: str\n 518→    published_at: datetime\n 519→    acquired_at: datetime\n 520→    content_sha256: str\n 521→    source_url: str\n 522→    locator: EvidenceLocator\n 523→\n 524→    @field_validator(\n 525→        \"source_record_id\",\n 526→        \"source_version_id\",\n 527→        \"external_record_id\",\n 528→        \"product_name\",\n 529→        \"content_label_zh\",\n 530→        \"source_role_label_zh\",\n 531→        \"policy_id\",\n 532→        \"policy_version\",\n 533→        \"source_url\",\n 534→    )\n 535→    @classmethod\n 536→    def _reference_text_is_not_blank(cls, value: str) -> str:\n 537→        return _text(value)\n 538→\n 539→    @field_validator(\"content_sha256\")\n 540→    @classmethod\n 541→    def _reference_sha256_is_valid(cls, value: str) -> str:\n 542→        if _SHA256.fullmatch(value) is None:\n 543→            raise ValueError(\"国内药品参考页摘要必须是小写 SHA-256\")\n 544→        return value\n 545→\n 546→    @field_validator(\"published_at\", \"acquired_at\")\n 547→    @classmethod\n 548→    def _reference_times_have_offsets(cls, value: datetime) -> datetime:\n 549→        if value.tzinfo is None or value.utcoffset() is None:\n 550→            raise ValueError(\"国内药品参考页日期时间必须包含明确时区\")\n 551→        return value\n 552→\n 553→    @model_validator(mode=\"after\")\n 554→    def _source_role_matches_source_system(self) -> ChinaDrugReferenceVersion:\n 555→        expected_role, expected_label, expected_official = _CHINA_REFERENCE_ROLES[\n 556→            self.source_system\n 557→        ]\n 558→        if self.source_system == \"dxy_drug_assistant\" and (\n 559→            self.source_role != expected_role\n 560→            or self.may_establish_official_regulatory_status\n 561→        ):\n 562→            raise ValueError(\"丁香园用药助手不能标记为官方监管来源\")\n 563→        if (\n 564→            self.source_role != expected_role\n 565→            or self.source_role_label_zh != expected_label\n 566→            or self.may_establish_official_regulatory_status != expected_official\n 567→        ):\n 568→            raise ValueError(\"国内药品参考页的来源角色与来源系统不一致\")\n 569→        return self\n 570→\n 571→    @classmethod\n 572→    def create(\n 573→        cls,\n 574→        *,\n 575→        policy: SourcePolicy,\n 576→        source_system: ChinaDrugReferenceSystem,\n 577→        external_record_id: str,\n 578→        product_name: str,\n 579→        content_label_zh: str,\n 580→        published_at: str,\n 581→        acquired_at: str,\n 582→        content_sha256: str,\n 583→        source_url: str,\n 584→        locator_label: str,\n 585→    ) -> ChinaDrugReferenceVersion:\n 586→        source_role, role_label, is_official = _CHINA_REFERENCE_ROLES[source_system]\n 587→        policy_source = policy.source(_CHINA_REFERENCE_POLICY_SOURCES[source_system])\n 588→        china_status_authority = policy_source.authorities[\n 589→            ClaimDomain.CHINA_DEVELOPMENT_REGULATORY_STATUS\n 590→        ]\n 591→        if source_system == \"dxy_drug_assistant\":\n 592→            if (\n 593→                not policy_source.required_for_china\n 594→                or policy_source.authoritative_secondary\n 595→                or china_status_authority != SourceAuthority.CROSS_CHECK\n 596→            ):\n 597→                raise ValueError(\"来源策略未把丁香园用药助手限定为二次参考\")\n 598→        elif (\n 599→            china_status_authority != SourceAuthority.DIRECT\n 600→            or policy_source.authoritative_secondary\n 601→        ):\n 602→            raise ValueError(\"来源策略未把中国官方页面标记为直接监管来源\")\n 603→        external_record_id = _text(external_record_id)\n 604→        source_record_id = stable_id(\n 605→            \"china-drug-reference\", source_system, external_record_id\n 606→        )\n 607→        return cls(\n 608→            source_system=source_system,\n 609→            source_record_id=source_record_id,\n 610→            source_version_id=stable_id(\n 611→                \"china-drug-reference-version\", source_record_id, content_sha256\n 612→            ),\n 613→            external_record_id=external_record_id,\n 614→            product_name=product_name,\n 615→            content_label_zh=content_label_zh,\n 616→            source_role=source_role,\n 617→            source_role_label_zh=role_label,\n 618→            may_establish_official_regulatory_status=is_official,\n 619→            policy_id=policy.policy_id,\n 620→            policy_version=policy.version,\n 621→            published_at=_offset_datetime(published_at),\n 622→            acquired_at=_offset_datetime(acquired_at),\n 623→            content_sha256=content_sha256,\n 624→            source_url=source_url,\n 625→            locator=EvidenceLocator(\n 626→                document_role=role_label,\n 627→                paragraph=locator_label,\n 628→                url=source_url,\n 629→            ),\n 630→        )\n 631→\n 632→\n 633→def capture_cde_guideline_basis(\n 634→    *,\n 635→    document_id: str,\n 636→    title: str,\n 637→    guidance_status: Literal[\"draft\", \"final\"],\n 638→    version_date: str,\n 639→    population_context: str,\n 640→    development_context: str,\n 641→    source_url: str,\n 642→    locator_label: str,\n 643→    locator_page: int,\n 644→    content_sha256: str,\n 645→    captured_at: str,\n 646→    lifecycle_status: Literal[\"active\", \"superseded\", \"withdrawn\"],\n 647→    supersedes_version_ids: tuple[str, ...] = (),\n 648→    superseded_by_version_id: str | None = None,\n 649→    withdrawn_at: str | None = None,\n 650→) -> GuidelineBasis:\n 651→    \"\"\"把 CDE 指导原则接入与 FDA 相同、但司法辖区独立的版本谱系。\"\"\"\n 652→\n 653→    return GuidelineBasis.create(\n 654→        jurisdiction=\"CN\",\n 655→        agency=\"CDE\",\n 656→        document_id=document_id,\n 657→        title=title,\n 658→        guidance_status=guidance_status,\n 659→        version_date=version_date,\n 660→        population_context=population_context,\n 661→        development_context=development_context,\n 662→        source_url=source_url,\n 663→        locator_label=locator_label,\n 664→        locator_page=locator_page,\n 665→        content_sha256=content_sha256,\n 666→        captured_at=captured_at,\n 667→        lifecycle_status=lifecycle_status,\n 668→        supersedes_version_ids=supersedes_version_ids,\n 669→        superseded_by_version_id=superseded_by_version_id,\n 670→        withdrawn_at=withdrawn_at,\n 671→    )\n 672→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c81113375e5b5b01ad761ea95d2","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c81113375e5b5b01ad761ea95d2","codebuddy.ai/llmMessageId":"01a08c81113375e5b5b01ad761ea95d2","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c80526