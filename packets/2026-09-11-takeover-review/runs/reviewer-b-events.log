    \"_domain\": domain,\n1846→        \"product_id\": product_id,\n1847→        \"trial_id\": trial_id,\n1848→        \"target\": target,\n1849→        \"target_id\": target,\n1850→        \"display_label_zh\": label,\n1851→        \"element\": label,\n1852→        \"product_zh\": product_name,\n1853→        \"trial_zh\": trial_name,\n1854→        \"study_identity\": study_identity,\n1855→        \"identity_label_zh\": study_identity or \"产品与试验未列示\",\n1856→        \"arm\": arm,\n1857→        \"group\": arm,\n1858→        \"group_id\": group_id,\n1859→        \"arm_role\": semantics[\"arm_role\"],\n1860→        \"arm_role_label_zh\": semantics[\"arm_role_label_zh\"],\n1861→        \"arm_detail\": _native_text(\n1862→            _source_first(value, source, \"arm_detail\", \"arm_name\", \"group_name\", default=\"\")\n1863→        ),\n1864→        \"cohort\": cohort,\n1865→        \"period\": period,\n1866→        \"category\": category,\n1867→        \"event\": label,\n1868→        \"time\": time_label,\n1869→        \"actual_timepoint\": actual_timepoint,\n1870→        \"actual_timepoint_unit\": actual_timepoint_unit,\n1871→        \"time_window\": time_window,\n1872→        \"time_window_band\": semantics[\"time_window_band\"],\n1873→        \"time_window_band_label_zh\": semantics[\"time_window_band_label_zh\"],\n1874→        \"population\": population,\n1875→        \"population_context\": semantics[\"population_context\"],\n1876→        \"population_context_label_zh\": semantics[\"population_context_label_zh\"],\n1877→        \"field_family\": field_family,\n1878→        \"reason\": reason,\n1879→        \"statistic_form\": statistic_form,\n1880→        \"statistical_form_family\": semantics[\"statistical_form_family\"],\n1881→        \"statistical_form_family_label_zh\": semantics[\"statistical_form_family_label_zh\"],\n1882→        \"clinical_concept\": semantics[\"clinical_concept\"],\n1883→        \"clinical_concept_label_zh\": semantics[\"clinical_concept_l