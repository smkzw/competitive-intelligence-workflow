{"type":"user","uuid":"01a08c81-353e-7dc4-9952-f3594e438936","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_01a08c8133ad7dd1b64dc23f","content":[{"type":"text","text":" 273→def _semantic_token(value: Any) -> str:\n 274→    if isinstance(value, Enum):\n 275→        value = value.value\n 276→    if value is None:\n 277→        return \"\"\n 278→    text = str(value).strip().casefold()\n 279→    text = text.replace(\"≥\", \"ge\").replace(\"≤\", \"le\").replace(\"％\", \"%\")\n 280→    return _SEMANTIC_TOKEN_RE.sub(\"\", text)\n 281→\n 282→\n 283→def _concept_family(*concepts: str) -> frozenset[str]:\n 284→    return frozenset(_semantic_token(concept) for concept in concepts)\n 285→\n 286→\n 287→_BASELINE_CONCEPT_FAMILY_ORDER: tuple[frozenset[str], ...] = (\n 288→    _concept_family(\"baseline_sample_size\", \"sample_size\", \"baseline_n\", \"n\"),\n 289→    _concept_family(\"age\", \"baseline_age\", \"age_at_baseline\"),\n 290→    _concept_family(\"sex\", \"gender\", \"baseline_sex\", \"baseline_gender\"),\n 291→    _concept_family(\"disease_duration\"),\n 292→    _concept_family(\"baseline_easi\", \"baseline_hemoglobin\", \"baseline_ldh\"),\n 293→)\n 294→\n 295→\n 296→def _alias_lookup(groups: Mapping[str, Sequence[str]]) -> dict[str, str]:\n 297→    result: dict[str, str] = {}\n 298→    for canonical, aliases in groups.items():\n 299→        for alias in (canonical, *aliases):\n 300→            token = _semantic_token(alias)\n 301→            if not token:\n 302→                continue\n 303→            existing = result.get(token)\n 304→            if existing is not None and existing != canonical:\n 305→                raise RuntimeError(f\"B 类临床别名冲突：{token}\")\n 306→            result[token] = canonical\n 307→    return result\n 308→\n 309→\n 310→_CLINICAL_CONCEPT_GROUPS: dict[str, dict[str, tuple[str, ...]]] = {\n 311→    \"efficacy\": {\n 312→        \"easi75_response\": (\n 313→            \"e