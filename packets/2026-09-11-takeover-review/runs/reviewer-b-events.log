{"type":"user","uuid":"01a08c81-62ee-7f76-9c9b-0b247e4477cf","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_DooJxd4w9y9L1WNg496pPx9h","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→from enum import StrEnum\n   4→\n   5→from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator\n   6→\n   7→from ci_workflow.domain.evidence import EvidenceGap, SourceReceipt, SourceVersionRecord\n   8→from ci_workflow.sources.policy import SourceApplicability, SourceEligibility\n   9→\n  10→\n  11→class AttemptResultClass(StrEnum):\n  12→    CONTENT_ACQUIRED = \"content_acquired\"\n  13→    NOT_FOUND = \"not_found\"\n  14→    NETWORK_ERROR = \"network_error\"\n  15→    RATE_LIMITED = \"rate_limited\"\n  16→    CAPTCHA_REQUIRED = \"captcha_required\"\n  17→    PERMISSION_DENIED = \"permission_denied\"\n  18→    PROXY_ERROR = \"proxy_error\"\n  19→    DNS_ERROR = \"dns_error\"\n  20→    TLS_ERROR = \"tls_error\"\n  21→    HTTP_ERROR = \"http_error\"\n  22→    PARSER_ERROR = \"parser_error\"\n  23→    TOOL_UNAVAILABLE = \"tool_unavailable\"\n  24→    CONTENT_TRUNCATED = \"content_truncated\"\n  25→\n  26→\n  27→class RouteAttemptResult(BaseModel):\n  28→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  29→\n  30→    attempt_id: str = Field(min_length=1)\n  31→    strategy_unit_id: str = Field(min_length=1)\n  32→    entity_id: str = Field(min_length=1)\n  33→    gap_id: str = Field(min_length=1)\n  34→    claim_domain: str = Field(min_length=1)\n  35→    result_class: AttemptResultClass\n  36→    detail_zh: str = Field(min_length=1)\n  37→\n  38→    @field_validator(\n  39→        \"attempt_id\",\n  40→        \"strategy_unit_id\",\n  41→        \"entity_id\",\n  42→        \"gap_id\",\n  43→        \"claim_domain\",\n  44→        \"detail_zh\",\n  45→    )\n  46→    @classmethod\n  47→    def _text_is_not_blank(cls, value: str) -> str:\n  48→        normalized = \" \".join(value.split())\n  49→        if not normalized:\n  50→            raise ValueError(\"路线尝试结果字段不能为空\")\n  51→        return normalized\n  52→\n  53→\n  54→class EvidenceAuditBundle(BaseModel):\n  55→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  56→\n  57→    source_receipts: tuple[SourceReceipt, ...] = ()\n  58→    source_versions: tuple[SourceVersionRecord, ...] = ()\n  59→    source_eligibilities: tuple[SourceEligibility, ...] = Field(min_length=1)\n  60→    evidence_gap: EvidenceGap\n  61→\n  62→    @model_validator(mode=\"after\")\n  63→    def _receipts_bind_one_gap(self) -> EvidenceAuditBundle:\n  64→        if any(\n  65→            receipt.gap_id != self.evidence_gap.gap_id\n  66→            for receipt in self.source_receipts\n  67→        ):\n  68→            raise ValueError(\"来源回执与证据缺口标识不一致\")\n  69→        if any(\n  70→            item.gap_id != self.evidence_gap.gap_id\n  71→            for item in self.source_eligibilities\n  72→        ):\n  73→            raise ValueError(\"来源适用性与证据缺口标识不一致\")\n  74→        receipt_ids = tuple(item.receipt_id for item in self.source_receipts)\n  75→        if len(set(receipt_ids)) != len(receipt_ids):\n  76→            raise ValueError(\"来源回执标识不得重复\")\n  77→        attempt_keys = tuple(\n  78→            (item.strategy_unit_id, item.attempt_index)\n  79→            for item in self.source_receipts\n  80→        )\n  81→        if len(set(attempt_keys)) != len(attempt_keys):\n  82→            raise ValueError(\"同一策略单元的尝试序号不得重复\")\n  83→        versions_by_id = {\n  84→            item.source_version_id: item for item in self.source_versions\n  85→        }\n  86→        if len(versions_by_id) != len(self.source_versions):\n  87→            raise ValueError(\"来源版本注册表不得重复\")\n  88→        for receipt in self.source_receipts:\n  89→            if receipt.result_class != \"content_acquired\":\n  90→                continue\n  91→            version = versions_by_id.get(rece