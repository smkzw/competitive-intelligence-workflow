{"type":"user","uuid":"01a08c81-452e-7a00-9997-6b8ef763c984","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_5E5Y1naZL7PqbUdIpbMf3kbe","content":[{"type":"text","text":"2860→\n2861→def _cross_trial_groups(\n2862→    records: Sequence[tuple[dict[str, Any], Any]],\n2863→    *,\n2864→    page_id: str,\n2865→    domain: str,\n2866→    include_time: bool,\n2867→    chart_type: str | None = None,\n2868→    semantic_proposals: Sequence[SemanticGroupingProposal] = (),\n2869→) -> tuple[dict[str, Any], ...]:\n2870→    buckets: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n2871→    for item in records:\n2872→        row = item[0]\n2873→        key = _semantic_group_key(row, include_time=include_time)\n2874→        if any(semantic_value_is_unknown(value) for value in key):\n2875→            # Retain source observations, but unknown axes cannot license cross-trial comparison.\n2876→            # Without a trial identity even a within-trial descriptive grouping is unproven.\n2877→            key += (\n2878→                \"source-specific\",\n2879→                _text(row.get(\"product_id\")),\n2880→                _text(row.get(\"trial_id\"), _text(row.get(\"row_id\"))),\n2881→            )\n2882→        buckets[key].append(item)\n2883→    merged = proposed_semantic_buckets(tuple(buckets.values()), semantic_proposals)\n2884→    buckets = {\n2885→        (*_semantic_group_key(bucket[0][0], include_time=include_time), str(index)):\n2886→        list(bucket)\n2887→        for index, bucket in enumerate(merged)\n2888→    }\n2889→    groups: list[dict[str, Any]] = []\n2890→    bucket_keys = sorted(\n2891→        buckets,\n2892→        key=lambda key: (\n2893→            not any(item[0].get(\"renderable\") for item in buckets[key]),\n2894→            key,\n2895→        ),\n2896→    )\n2897→    for key in bucket_keys:\n2898→        bucket = _sorted_bucket(buckets[key])\n2899→        first = bucket[0][0]\n2900→        times = {\n2901→            _text(row.get(\"time_window_band\"), _text(row.get(\"time\")))\n2902→            for row, _source in bucket\n2903→            if _text(row.get(\"time_window_band\"), _text(row.get(\"time\")))\n2904→        }\n2905→        resolved_chart_type = chart_type or (\n2906→            \"line\" if page_id == \"longitudinal-results\" and len(times) > 1 else \"bar\"\n2907→        )\n2908→        title = _group_title(first, domain=domain, include_time=include_time)\n2909→        ids = {str(row[\"row_id\"]) for row, _source in bucket}\n2910→        if any(set(proposal.row_ids).issubset(ids) for proposal in semantic_proposals):\n2911→            actual_times = tuple(dict.fromkeys(\n2912→                f'{row.get(\"actual_timepoint\")} '\n2913→                + {\"week\": \"周\", \"day\": \"天\", \"month\": \"个月\", \"year\": \"年\"}.get(\n2914→                    str(row.get(\"actual_timepoint_unit\")), str(row.get(\"actual_timepoint_unit\")),\n2915→                )\n2916→                for row, _source in bucket\n2917→            ))\n2918→            title += \" · 实际观察时间：\" + \" / \".join(actual_times)\n2919→        if any(semantic_value_is_unknown(value) for value in key):\n2920→            title += \" · 语义信息未完整，按试验列示\"\n2921→        group = _group(\n2922→            title,\n2923→            bucket,\n2924→            chart_type=resolved_chart_type,\n2925→            cross_trial=_bucket_spans_trials(bucket),\n2926→            identity_series=True,\n2927→            x_axis_label_zh=\"产品｜试验\",\n2928→        )\n2929→        group[\"title_complete\"] = True\n2930→        if page_id == \"longitudinal-results\":\n2931→            values = [\n2932→                float(row[\"numeric_value\"])\n2933→                for row, _source in bucket\n2934→                if isinstance(row.get(\"numeric_value\"), (int, float))\n2935→                and not isinstance(row.get(\"numeric_value\"), bool)\n2936→            ]\n2937→            if values:\n2938→                group[\"y_axis_min\"] = min(0.0, min(values))\n2939→                group[\"y_axis_max\"] = max(0.0, max(values))\n2940→        groups.append(group)\n2941→    return tuple(groups)\n2942→\n2943→\n2944→def _baseline_bucket_sort_key(key: tuple[str, ...]) -> tuple[int, tuple[str, ...]]:\n2945→    concept = key[0] if key else \"\"\n2946→    for rank, family in enumerate(_BASELINE_CONCEPT_FAMILY_ORDER):\n2947→        if _semantic_token(concept) in family:\n2948→            return (rank, key)\n2949→    return (len(_BASELINE_CONCEPT_FAMILY_ORDER), key)\n2950→\n2951→\n2952→def _bucket_spans_trials(bucket: Sequence[tuple[dict[str, Any], Any]]) -> bool:\n2953→    trial_ids = {\n2954→        _text(row.get(\"trial_id\"))\n2955→        for row, _source in bucket\n2956→        if _text(row.get(\"trial_id\"))\n2957→    }\n2958→    return len(trial_ids) > 1\n2959→\n2960→\n2961→def _groups_for_page(\n2962→    page_id: str,\n2963→    records: Sequence[tuple[dict[str, Any], Any]],\n2964→    *, semantic_proposals: Sequence[SemanticGroupingProposal] = (),\n2965→) -> tuple[dict[str, Any], ...]:\n2966→    if not records:\n2967→        return ()\n2968→    records = _records_with_semantics(records, page_id=page_id)\n2969→    if page_id in {\"overview\", \"product-trial-profiles\"}:\n2970→        by_id = {str(row[\"row_id\"]): row for row, _source in _dedupe_records(records)}\n2971→        for proposal in semantic_proposals:\n2972→            present = [by_id[row_id] for row_id in proposal.row_ids if row_id in by_id]\n2973→            if len(present) == 2 and present[0].get(\"_domain\") != present[1].get(\"_domain\"):\n2974→                raise ValueError(\"跨域语义提案不受支持，必须拆分研究问题\")\n2975→    if page_id in {\"efficacy\", \"longitudinal-results\", \"subgroups-supporting-evidence\"}:\n2976→        return _cross_trial_groups(\n2977→            records,\n2978→            page_id=page_id,\n2979→            domain=\"efficacy\",\n2980→            include_time=page_id != \"longitudinal-results\",\n2981→            semantic_proposals=semantic_proposals,\n2982→        )\n2983→    if page_id == \"safety\":\n2984→        return _cross_trial_groups(\n2985→            records,\n2986→            page_id=page_id,\n2987→            domain=\"safety\",\n2988→            include_time=True,\n2989→            chart_type=\"heatmap\",\n2990→            semantic_proposals=semantic_proposals,\n2991→        )\n2992→    if page_id == \"overview\":\n2993→        efficacy = [item for item in records if item[0].get(\"_domain\") == \"efficacy\"]\n2994→        safety = [item for item in records if item[0].get(\"_domain\") == \"safety\"]\n2995→        matrix = [item for item in records if item[0].get(\"_domain\") == \"matrix\"]\n2996→        baseline = [item for item in records if item[0].get(\"_domain\") == \"baseline\"]\n2997→        disposition = [item for item in records if item[0].get(\"_domain\") == \"disposition\"]\n2998→        overview_groups: list[dict[str, Any]] = []\n2999→        if efficacy:\n3000→            overview_groups.extend(_groups_for_page(\n3001→                \"efficacy\", efficacy, semantic_proposals=semantic_proposals,\n3002→            ))\n3003→        if safety:\n3004→            overview_groups.extend(_groups_for_page(\n3005→                \"safety\", safety, semantic_proposals=semantic_proposals,\n3006→            ))\n3007→        for related_page_id, related_records in (\n3008→            (\"efficacy-safety-matrix\", matrix),\n3009→            (\"baseline-overview\", baseline),\n3010→            (\"disposition-overview\", disposition),\n3011→        ):\n3012→            if related_records:\n3013→                overview_groups.extend(_groups_for_page(\n3014→                    related_page_id, related_records, semantic_proposals=semantic_proposals,\n3015→                ))\n3016→        return tuple(overview_groups)\n3017→    if page_id == \"efficacy-safety-matrix\":\n3018→        chart_type = (\n3019→            \"bubble\" if any(item[0].get(\"renderable\") for item in records) else \"status_matrix\"\n3020→        )\n3021→        matrix_groups = []\n3022→        for bucket in proposed_semantic_buckets(\n3023→            (records,), semantic_proposals, descriptive_only=True,\n3024→        ):\n3025→            group = _group(\"疗效与安全性观察位置\", bucket, chart_type=chart_type)\n3026→            group.update(\n3027→                x_axis_label_zh=\"试验内疗效差（百分点）\",\n3028→                y_axis_label_zh=\"治疗组治疗期间不良事件发生率（%）\",\n3029→                size_label_zh=\"气泡大小：治疗组样本量\",\n3030→            )\n3031→            matrix_groups.append(group)\n3032→        return tuple(matrix_groups)\n3033→    if page_id in _BASELINE_PAGE_IDS:\n3034→        buckets: dict[tuple[str, ...], list[tuple[dict[str, Any], Any]]] = defaultdict(list)\n3035→        for item in records:\n3036→            buckets[\n3037→                _semantic_group_key(\n3038→                    item[0],\n3039→                    include_time=True,\n3040→                    include_domain=True,\n3041→                    include_population=True,\n3042→                    include_statistic=False,\n3043→                    include_unit=False,\n3044→                )\n3045→            ].append(item)\n3046→        groups: list[dict[str, Any]] = []\n3047→        baseline_buckets = proposed_semantic_buckets(\n3048→            tuple(buckets[key] for key in sorted(buckets, key=_baseline_bucket_sort_key)),\n3049→            semantic_proposals, descriptive_only=True,\n3050→        )\n3051→        for raw_bucket in baseline_buckets:\n3052→            bucket = _sorted_bucket(raw_bucket)\n3053→            first = bucket[0][0]\n3054→            chart_type = (\n3055→                \"bar\" if any(item[0].get(\"renderable\") for item in bucket) else \"status_matrix\"\n3056→            )\n3057→            statistic_labels = tuple(\n3058→                dict.fromkeys(\n3059→                    _text(\n3060→                        row.get(\"statistical_form