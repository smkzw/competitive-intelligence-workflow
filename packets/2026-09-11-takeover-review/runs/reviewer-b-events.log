{"type":"user","uuid":"01a08c83-7257-7da3-b3d8-77a120f07f7b","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_NhL9HETe8usnafhzFy0V8157","content":[{"type":"text","text":"   1→#!/usr/bin/env bash\n   2→# One fail-closed quality entry point.  It reports the exact checked scope and\n   3→# never turns a non-zero child command into a green verdict.\n   4→set -u -o pipefail\n   5→\n   6→ROOT=\"$(CDPATH= cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n   7→REQUIRE_CLEAN=0\n   8→SOURCE_SET=\"\"\n   9→\n  10→usage() {\n  11→  cat <<'EOF'\n  12→用法：tools/gate.sh [--require-clean] [--source-set PATH]\n  13→\n  14→默认检查（HTML-only v1 分层）：\n  15→  ruff                       src tests tools\n  16→  mypy                       src tools（strict；仅允许代码行上的精确豁免）\n  17→  v1-fast-tests              tests/unit tests/contract 活跃层\n  18→  retained-compat-smoke      tests/unit+tests/contract 内保留轨文件的兼容性 smoke；\n  19→                             不是全量保留轨（18 个声明文件大多位于 tests/pdf、\n  20→                             tests/html_ppt 等产品轨），不算 v1 release gate；\n  21→                             全量口径见分层合同 RETAINED_FILES\n  22→  v1-layer-audit             分层合同\n  23→  legacy                     tools/check_no_legacy_refs.py\n  24→\n  25→--require-clean 另外要求 Git 工作树无 staged/unstaged/untracked 改动；不代表可发布。\n  26→--source-set    另外比对一个历史脏树基线 JSON；仅用于诊断漂移。\n  27→EOF\n  28→}\n  29→\n  30→while (($# > 0)); do\n  31→  case \"$1\" in\n  32→    --require-clean)\n  33→      REQUIRE_CLEAN=1\n  34→      shift\n  35→      ;;\n  36→    --source-set)\n  37→      if (($# < 2)); then\n  38→        echo \"GATE_USAGE_ERROR --source-set 需要路径\" >&2\n  39→        exit 2\n  40→      fi\n  41→      SOURCE_SET=\"$2\"\n  42→      shift 2\n  43→      ;;\n  44→    -h|--help)\n  45→      usage\n  46→      exit 0\n  47→      ;;\n  48→    *)\n  49→      echo \"GATE_USAGE_ERROR 未知参数：$1\" >&2\n  50→      usage >&2\n  51→      exit 2\n  52→      ;;\n  53→  esac\n  54→done\n  55→\n  56→if ((REQUIRE_CLEAN)) && [[ -n \"$SOURCE_SET\" ]]; then\n  57→  echo \"GATE_USAGE_ERROR 历史脏树基线不能与 --require-clean 组合为发布证明\" >&2\n  58→  exit 2\n  59→fi\n  60→\n  61→if ! command -v uv >/dev/null 2>&1; then\n  62→  echo \"GATE_ENV_ERROR 缺少 uv；无法执行锁定开发环境检查\" >&2\n  63→  exit 2\n  64→fi\n  65→\n  66→failures=0\n  67→steps=0\n  68→run_step() {\n  69→  local name=\"$1\"\n  70→  shift\n  71→  steps=$((steps + 1))\n  72→  printf 'GATE_STEP name=%s command=' \"$name\"\n  73→  printf '%q ' \"$@\"\n  74→  printf '\\n'\n  75→  \"$@\"\n  76→  local code=$?\n  77→  if ((code != 0)); then\n  78→    printf 'GATE_STEP_FAIL name=%s exit=%d\\n' \"$name\" \"$code\" >&2\n  79→    failures=$((failures + 1))\n  80→  else\n  81→    printf 'GATE_STEP_OK name=%s\\n' \"$name\"\n  82→  fi\n  83→}\n  84→\n  85→cd \"$ROOT\" || {\n  86→  echo \"GATE_ENV_ERROR 无法进入仓库根目录：$ROOT\" >&2\n  87→  exit 2\n  88→}\n  89→\n  90→printf 'GATE_SCOPE root=%s ruff=src,tests,tools mypy=src,tools,strict,no-global-ignore v1_active_tests=tests/unit,tests/contract,-m+\"not+retained_legacy_format\" retained_compat_smoke=tests/unit,tests/contract,-m+\"retained_legacy_format\" retained_compat_smoke_semantics=bounded-compat-subset,full-retained-track-not-run-here v1_layer_audit=test_v1_test_layering legacy=check_no_legacy_refs release_semantics=retained-steps-are-not-v1-release-gate' \"$ROOT\"\n  91→if ((REQUIRE_CLEAN)); then\n  92→  printf ' clean=required'\n  93→else\n  94→  printf ' clean=not-required'\n  95→fi\n  96→if [[ -n \"$SOURCE_SET\" ]]; then\n  97→  printf ' source_set=%s' \"$SOURCE_SET\"\n  98→fi\n  99→printf '\\n'\n 100→\n 101→run_step ruff uv run ruff check src tests tools\n 102→run_step mypy uv run python -m mypy --no-incremental --strict src tools --show-error-codes\n 103→run_step v1-fast-tests uv run python -m pytest tests/unit tests/contract -q -m \"not retained_legacy_format\"\n 104→run_step retained-compat-smoke uv run python -m pytest tests/unit tests/contract -q -m \"retained