difference\": \"均值差\",\n 634→    \"median_difference\": \"中位数差\",\n 635→    \"mean\": \"均值\",\n 636→    \"median\": \"中位数\",\n 637→    \"proportion\": \"比例\",\n 638→    \"count\": \"例数\",\n 639→    \"event_count\": \"事件数\",\n 640→    \"adherence_summary\": \"依从性概览\",\n 641→    \"other\": \"其他统计形式\",\n 642→    \"range\": \"区间\",\n 643→    \"not_reported\": \"报告未注明统计口径\",\n 644→}\n 645→\n 646→_POPULATION_GROUPS = {\n 647→    \"full_analysis_set\": (\n 648→        \"full analysis set\",\n 649→        \"full analysis population\",\n 650→        \"fas\",\n 651→        \"全分析集\",\n 652→        \"全分析人群\",\n 653→    ),\n 654→    \"intention_to_treat\": (\"itt\", \"intention to treat\", \"意向性分析集\", \"意向治疗集\"),\n 655→    \"per_protocol\": (\"pp\", \"per protocol\", \"符合方案集\", \"方案符合集\"),\n 656→    \"safety_set\": (\"safety set\", \"safety population\", \"安全性分析集\", \"安全性人群\"),\n 657→    \"randomized_set\": (\"randomized set\", \"randomised set\", \"随机集\", \"随机人群\"),\n 658→    \"treated_set\": (\"treated set\", \"treated population\", \"治疗集\", \"接受治疗人群\"),\n 659→    \"all_participants\": (\"all participants\", \"all subjects\", \"全部受试者\", \"全体受试者\"),\n 660→}\n 661→_POPULATION_LOOKUP = _alias_lookup(_POPULATION_GROUPS)\n 662→_POPULATION_LABELS = {\n 663→    \"full_analysis_set\": \"全分析集\",\n 664→    \"intention_to_treat\": \"意向性分析集\",\n 665→    \"per_protocol\": \"符合方案集\",\n 666→    \"safety_set\": \"安全性分析集\",\n 667→    \"randomized_set\": \"随机集\",\n 668→    \"treated_set\": \"治疗集\",\n 669→    \"all_participants\": \"全部受试者\",\n 670→    \"not_reported\": \"分析人群未列示\",\n 671→}\n 672→\n 673→_ARM_ROLE_ALIASES = {\n 674→    \"treatment\": \"treatment\",\n 675→    \"treated\": \"treatment\",\n 676→    \"intervention\": \"treatment\",\n 677→    \"active\": \"treatment\",\n 678→    \"treatmentarm\": \"treatment\",\n 679→    \"治疗组\": \"treatment\",\n 680→    \"治疗臂\": \"treatment\",\n 681→    \"干预组\": \"treatment\",\n 682→    \"control\": \"control\",\n 683→    \"placebo\": \"control\",\n 684→    \"comparator\": \"control\",\n 685→    \"controlarm\": \"control\",\n 686→    \"placeboarm\": \"control\",\n 687→    \"comparatorarm\": \"control\",\n 688→    \"对照组\": \"control\",\n 689→    \"对照臂\": \"control\",\n 690→    \"安慰剂\": \"control\",\n 691→    \"单臂\": \"single_arm\",\n 692→    \"singlearm\": \"single_arm\",\n 693→    \"singlearmstudy\": \"single_arm\",\n 694→    \"singlearmtrial\": \"single_arm\",\n 695→    \"single\": \"single_arm\",\n 696→}\n 697→\n 698→_TIME_UNIT_CANONICAL = {\n 699→    \"d\": \"day\",\n 700→    \"day\": \"day\",\n 701→    \"days\": \"day\",\n 702→    \"日\": \"day\",\n 703→    \"天\": \"day\",\n 704→    \"w\": \"week\",\n 705→    \"wk\": \"week\",\n 706→    \"week\": \"week\",\n 707→    \"weeks\": \"week\",\n 708→    \"周\": \"week\",\n 709→    \"mo\": \"month\",\n 710→    \"month\": \"month\",\n 711→    \"months\": \"month\",\n 712→    \"月\": \"month\",\n 713→    \"y\": \"year\",\n 714→    \"yr\": \"year\",\n 715→    \"year\": \"year\",\n 716→    \"years\": \"year\",\n 717→    \"年\": \"year\",\n 718→}\n 719→_TIMEPOINT_PATTERN = re.compile(\n 720→    r\"^(?:约|around|approximately|approx\\.?|about|at)?\\s*第?\\s*(?P<low>[0-9]+(?:\\.[0-9]+)?)\"\n 721→    r\"(?:\\s*(?:至|-|–|—)\\s*(?P<high>[0-9]+(?:\\.[0-9]+)?))?\"\n 722→    r\"\\s*(?P<unit>日|天|d|day|days|周|w|wk|week|weeks|月|mo|month|months|年|y|yr|year|years)?$\",\n 723→    re.IGNORECASE,\n 724→)\n 725→_TIMEPOINT_PREFIX_PATTERN = re.compile(\n 726→    r\"^(?:约|around|approximately|approx\\.?|about|at)?\\s*\"\n 727→    r\"(?P<unit>日|天|d|day|days|周|w|wk|week|weeks|月|mo|month|months|年|y|yr|year|years)\"\n 728→    r\"\\s*第?\\s*(?P<low>[0-9]+(?:\\.[0-9]+)?)\"\n 729→    r\"(?:\\s*(?:至|-|–|—)\\s*(?P<high>[0-9]+(?:\\.[0-9]+)?))?$\",\n 730→    re.IGNORECASE,\n 731→)\n 732→_TIME_BAND_LABELS = {\n 733→    \"around_day_28\": \"约第28天\",\n 734→    \"around_week_12\": \"约第12周\",\n 735→    \"around_month_6\": \"约6个月\",\n 736→    \"around_year_1\": \"约1年\",\n 737→    \"baseline\": \"基线\",\n 738→    \"treatment_period\": \"治疗期间\",\n 739→    \"follow_up\": \"随访期\",\n 740→    \"study_period\": \"研究期间\",\n 741→    \"time_not_reported\": \"时间点未列示\",\n 742→}\n 743→\n 744→\n 745→def _unknown_semantic_key(prefix: str, value: Any) -> str:\n 746→    token = _semantic_token(value)\n 747→    return f\"{prefix}:{token or 'not_reported'}\"\n 748→\n 749→\n 750→def _controlled_concept(\n 751→    value: Any,\n 752→    *,\n 753→    domain: str,\n 754→    fallback: Any = None,\n 755→) -> tuple[str, str]:\n 756→    lookup = _CLINICAL_CONCEPT_LOOKUPS.get(domain, {})\n 757→    candidates = (value, fallback)\n 758→    first_text = \"\"\n 759→    for candidate in candidates:\n 760→        if candidate is None:\n 761→            continue\n 762→        if not first_text:\n 763→            first_text = _text(candidate)\n 764→        canonical = lookup.get(_semantic_token(candidate))\n 765→        if canonical is not None:\n 766→            return canonical, _CLINICAL_CONCEPT_LABELS.get(canonical, _native_text(candidate))\n 767→    canonical = _unknown_semantic_key(domain, first_text)\n 768→    return canonical, _native_text(first_text, \"临床概念未列示\")\n 769→\n 770→\n 771→def _canonical_statistical_form(\n 772→    value: Any,\n 773→    *,\n 774→    domain: str,\n 775→    concept: str,\n 776→    unit: Any = None,\n 777→    numerator: Any = None,\n 778→    denominator: Any = None,\n 779→) -> tuple[str, str]:\n 780→    if domain == \"efficacy\" and concept == \"breakthrough_hemolysis_rate\":\n 781→        return \"event_rate\", \"事件发生率（越低越好）\"\n 782→    canonical = _STATISTICAL_FORM_LOOKUP.get(_semantic_token(value))\n 783→    if canonical is not None:\n 784→        return canonical, _STATISTICAL_FORM_LABELS[canonical]\n 785→    unit_token = _text(unit).strip().casefold().replace(\"％\", \"%\")\n 786→    if domain == \"safety\":\n 787→        return \"event_rate\", _STATISTICAL_FORM_LABELS[\"event_rate\"]\n 788→    if domain == \"efficacy\":\n 789→        if concept.endswith(\"_response\") or concept == \"hemoglobin_response_without_transfusion\":\n 790→            return \"response_rate\", _STATISTICAL_FORM_LABELS[\"response_rate\"]\n 791→        if unit_token in {\"%\", \"percent\", \"percentage\"}:\n 792→            return \"proportion\", _STATISTICAL_FORM_LABELS[\"proportion\"]\n 793→    if domain == \"baseline\":\n 794→        if concept == \"baseline_sample_size\":\n 795→            return \"count\", _STATISTICAL_FORM_LABELS[\"count\"]\n 796→        if numerator is not None and denominator is not None:\n 797→            return \"proportion\", _STATISTICAL_FORM_LABELS[\"proportion\"]\n 798→    if domain == \"disposition\":\n 799→        if unit_token in {\"%\", \"percent\", \"percentage\"}:\n 800→            return \"proportion\", _STATISTICAL_FORM_LABELS[\"proportion\"]\n 801→        if unit_token in {\"人\", \"例\", \"subjects\", \"participants\"}:\n 802→            return \"count\", _STATISTICAL_FORM_LABELS[\"count\"]\n 803→    return \"not_reported\", _STATISTICAL_FORM_LABELS[\"not_reported\"]\n 804→\n 805→\n 806→def _canonical_population(value: Any) -> tuple[str, str]:\n 807→    if value is None or not _text(value):\n 808→        return \"not_reported\", _POPULATION_LABELS[\"not_reported\"]\n 809→    canonical = _POPULATION_LOOKUP.get(_semantic_token(value))\n 810→    if canonical is not None:\n 811→        return canonical, _POPULATION_LABELS[canonical]\n 812→    return _unknown_semantic_key(\"population\", value), _native_text(value)\n 813→\n 814→\n 815→def _canonical_arm_role(value: Any) -> tuple[str, str]:\n 816→    candidates = (value,)\n 817→    for candidate in candidates:\n 818→        token = _semantic_token(candidate)\n 819→        canonical = _ARM_ROLE_ALIASES.get(token)\n 820→        if canonical is not None:\n 821→            return canonical, {\n 822→                \"treatment\": \"治疗组\",\n 823→                \"control\": \"对照组\",\n 824→                \"single_arm\": \"单臂\",\n 825→            }[canonical]\n 826→        if any(\n 827→            marker in token for marker in (\"control\", \"placebo\", \"comparator\", \"对照\", \"安慰剂\")\n 828→        ):\n 829→            return \"control\", \"对照组\"\n 830→        if any(marker in token for marker in (\"treat\", \"intervention\", \"active\", \"治疗\", \"干预\")):\n 831→            return \"treatment\", \"治疗组\"\n 832→    return \"unknown\", \"组别未列示\"\n 833→\n 834→\n 835→def _time_band(value: Any, explicit_unit: Any = None) -> tuple[str, str]:\n 836→    if value is None or not _text(value):\n 837→        return \"time_not_reported\", _TIME_BAND_LABELS[\"time_not_reported\"]\n 838→    text = _text(value)\n 839→    token = _semantic_token(text)\n 840→    if any(marker in token for marker in (\"baseline\", \"基线\", \"screening\", \"筛选期\")):\n 841→        return \"baseline\", _TIME_BAND_LABELS[\"baseline\"]\n 842→    if any(marker in token for marker in (\"treatmentperiod\", \"treatment\", \"治疗期间\", \"治疗期\")):\n 843→        return \"treatment_period\", _TIME_BAND_LABELS[\"treatment_period\"]\n 844→    if any(marker in token for marker in (\"followup\", \"follow\", \"随访\")):\n 845→        return \"follow_up\", _TIME_BAND_LABELS[\"follow_up\"]\n 846→    if any(marker in token for marker in (\"studyperiod\", \"study\", \"研究期间\")):\n 847→        return \"study_period\", _TIME_BAND_LABELS[\"study_period\"]\n 848→    candidate_text = text.replace(\"months\", \"month\").replace(\"weeks\", \"week\").replace(\"days\", \"day\")\n 849→    match = _TIMEPOINT_PATTERN.fullmatch(candidate_text)\n 850→    if match is None:\n 851→        match = _TIMEPOINT_PREFIX_PATTERN.fullmatch(candidate_text)\n 852→    if match is None:\n 853→        return _unknown_semantic_key(\"time\", text), text\n 854→    low = float(match.group(\"low\"))\n 855→    high = float(match.group(\"high\") or match.group(\"low\"))\n 856→    value_num = (low + high) / 2.0\n 857→    raw_unit = match.group(\"unit\") or _text(explicit_unit)\n 858→    unit = _TIME_UNIT_CANONICAL.get(raw_unit.casefold()) if raw_unit else None\n 859→    if unit is None:\n 860→        return _unknown_semantic_key(\"time\", text), text\n 861→    weeks = {\n 862→        \"day\": value_num / 7.0,\n 863→        \"week\": value_num,\n 864→        \"month\": value_num * 4.34524,\n 865→        \"year\": value_num * 52.1429,\n 866→    }[unit]\n 867→    if unit == \"day\" and 26 <= value_num <= 30:\n 868→        return \"around_day_28\", _TIME_BAND_LABELS[\"around_day_28\"]\n 869→    if 10 <= weeks <= 14:\n 870→        return \"around_week_12\", _TIME_BAND_LABELS[\"around_week_12\"]\n 871→    if 22 <= weeks <= 26.5:\n 872→        return \"around_month_6\", _TIME_BAND_LABELS[\"around_month_6\"]\n 873→    if 48 <= weeks <= 56:\n 874→        return \"around_year_1\", _TIME_BAND_LABELS[\"around_year_1\"]\n 875→    unit_label = {\"day\": \"天\", \"week\": \"周\", \"month\": \"个月\", \"year\": \"年\"}[unit]\n 876→    shown = f\"{value_num:g}\"\n 877→    if low != high:\n 878→        shown = f\"{low:g}–{high:g}\"\n 879→    return f\"{unit}_{shown}\", f\"第{shown}{unit_label}\"\n 880→\n 881→\n 882→def _semantic_projection(value: Any, source: Any, *, domain: str) -> dict[str, str]:\n 883→    if domain == \"efficacy\":\n 884→        concept_value = _first(\n 885→            value,\n 886→            \"clinical_concept\",\n 887→            \"construct_id\",\n 888→            \"endpoint_family_label_zh\",\n 889→            \"endpoint_family_id\",\n 890→            \"original_endpoint\",\n 891→            \"original_definition\",\n 892→            \"endpoint_id\",\n 893→            \"endpoint\",\n 894→            default=None,\n 895→        )\n 896→        fallback_concept = _first(\n 897→            source,\n 898→            \"clinical_concept\",\n 899→            \"construct_id\",\n 900→            \"endpoint_family_label_zh\",\n 901→            \"endpoint_family_id\",\n 902→            \"original_endpoint\",\n 903→            \"original_definition\",\n 904→            \"endpoint\",\n 905→            default=None,\n 906→        )\n 907→    elif domain == \"baseline\":\n 908→        concept_value = _first(\n 909→            value,\n 910→            \"clinical_concept\",\n 911→            \"standardized_concept\",\n 912→            \"variable_label_zh\",\n 913→            \"variable\",\n 914→            \"source_name\",\n 915→            \"variable_domain\",\n 916→            default=None,\n 917→        )\n 918→        fallback_concept = _first(\n 919→            source,\n 920→            \"clinical_concept\",\n 921→            \"standardized_concept\",\n 922→            \"source_name\",\n 923→            \"variable_domain\",\n 924→            default=None,\n 925→        )\n 926→    elif domain == \"safety\":\n 927→        concept_value = _first(\n 928→            value,\n 929→            \"clinical_concept\",\n 930→            \"standardized_concept\",\n 931→            \"standard_term\",\n 932→            \"source_term\",\n 933→            \"original_term\",\n 934→            \"term\",\n 935→            \"event_term\",\n 936→            \"event\",\n 937→            \"category\",\n 938→            \"family\",\n 939→            \"safety_family\",\n 940→            default=None,\n 941→        )\n 942→        fallback_concept = _first(\n 943→            source,\n 944→            \"clinical_concept\",\n 945→            \"standardized_concept\",\n 946→            \"standard_term\",\n 947→            \"source_term\",\n 948→            \"original_term\",\n 949→            \"term\",\n 950→            \"event_term\",\n 951→            \"event\",\n 952→            \"category\",\n 953→            \"family\",\n 954→            \"safety_family\",\n 955→            default=None,\n 956→        )\n 957→    elif domain == \"disposition\":\n 958→        concept_value = _first(\n 959→            value,\n 960→            \"clinical_concept\",\n 961→            \"standardized_concept\",\n 962→            \"field_label_zh\",\n 963→            \"field\",\n 964→            \"source_field_name\",\n 965→            \"field_family\",\n 966→            default=None,\n 967→        )\n 968→        fallback_concept = _first(\n 969→            source,\n 970→            \"clinical_concept\",\n 971→            \"standardized_concept\",\n 972→            \"field\",\n 973→            \"source_field_name\",\n 974→            \"field_family\",\n 975→            default=None,\n 976→        )\n 977→    else:\n 978→        concept_value = _first(\n 979→            value,\n 980→            \"clinical_concept\",\n 981→            \"standardized_concept\",\n 982→            \"label_zh\",\n 983→            default=None,\n 984→        )\n 985→        fallback_concept = _first(\n 986→            source,\n 987→            \"clinical_concept\",\n 988→            \"standardized_concept\",\n 989→            \"label_zh\",\n 990→            default=None,\n 991→        )\n 992→    concept, concept_label = _controlled_concept(\n 993→        concept_value if concept_value is not None else fallback_concept,\n 994→        domain=domain if domain in _CLINICAL_CONCEPT_LOOKUPS else \"efficacy\",\n 995→        fallback=fallback_concept,\n 996→    )\n 997→    raw_time = _first(\n 998→        value,\n 999→        \"time_window\",\n1000→        \"time_window_zh\",\n1001→        \"timepoint\",\n1002→        \"actual_timepoint\",\n1003→        \"observed_timepoint\",\n1004→        \"timepoint_value\",\n1005→        \"baseline_timepoint\",\n1006→        \"time\",\n1007→        default=None,\n1008→    )\n1009→    if raw_time is None:\n1010→        raw_time = _first(\n1011→            source,\n1012→            \"time_window\",\n1013→            \"time_window_zh\",\n1014→            \"timepoint\",\n1015→            \"actual_timepoint\",\n1016→            \"observed_timepoint\",\n1017→            \"timepoint_value\",\n1018→            \"baseline_timepoint\",\n1019→            \"time\",\n1020→            default=None,\n1021→        )\n1022→    raw_time_unit = _first(\n1023→        value,\n1024→        \"actual_timepoint_unit\",\n1025→        \"time_unit\",\n1026→        \"observed_time_unit\",\n1027→        \"timepoint_unit\",\n1028→        default=None,\n1029→    )\n1030→    if raw_time_unit is None:\n1031→        raw_time_unit = _first(\n1032→            source,\n1033→            \"actual_timepoint_unit\",\n1034→            \"time_unit\",\n1035→            \"observed_time_unit\",\n1036→            \"timepoint_unit\",\n1037→            default=None,\n1038→        )\n1039→    time_band, time_band_label = _time_band(raw_time, raw_time_unit)\n1040→    raw_statistic = _first(\n1041→        value,\n1042→        \"statistical_form_family\",\n1043→        \"statistic_form\",\n1044→        \"statistic_label_zh\",\n1045→        \"analysis_form\",\n1046→        \"effect_measure\",\n1047→        \"measure_object\",\n1048→        \"statistical_form\",\n1049→        default=None,\n1050→    )\n1051→    if raw_statistic is None:\n1052→        raw_statistic = _first(\n1053→            source,\n1054→            \"statistical_form_family\",\n1055→            \"statistic_form\",\n1056→            \"statistic_label_zh\",\n1057→            \"analysis_form\",\n1058→            \"effect_measure\",\n1059→            \"measure_object\",\n1060→            \"statistical_form\",\n1061→            default=None,\n1062→        )\n1063→    statistic, statistic_label = _canonical_statistical_form(\n1064→        raw_statistic,\n1065→        domain=domain,\n1066→        concept=concept,\n1067→        unit=_source_first(\n1068→            value,\n1069→            source,\n1070→            \"unit\",\n1071→            \"measurement_unit\",\n1072→            \"measure_unit\",\n1073→            \"effect_unit\",\n1074→            default=None,\n1075→        ),\n1076→        numerator=_source_first(value, source, \"numerator\", default=None),\n1077→        denominator=_source_first(value, source, \"denominator\", default=None),\n1078→    )\n1079→    raw_population = _first(\n1080→        value,\n1081→        \"population_context\",\n1082→        \"analysis_population\",\n1083→        \"analysis_population_zh\",\n1084→        \"population\",\n1085→        default=None,\n1086→    )\n1087→    if raw_population is None:\n1088→        raw_population = _first(\n1089→            source,\n1090→            \"population_context\",\n1091→            \"analysis_population\",\n1092→            \"analysis_population_zh\",\n1093→            \"population\",\n1094→            default=None,\n1095→        )\n1096→    population, population_label = _canonical_population(raw_population)\n1097→    raw_arm = _first(\n1098→        value,\n1099→        \"arm_role\",\n1100→        \"group_role\",\n1101→        \"arm_type\",\n1102→        \"arm_label\",\n1103→        \"group_label\",\n1104→        \"group_label_zh\",\n1105→        \"arm\",\n1106→        \"group\",\n1107→        \"arm_id\",\n1108→        \"group_id\",\n1109→        default=None,\n1110→    )\n1111→    if raw_arm is None:\n1112→        raw_arm = _first(\n1113→            source,\n1114→            \"arm_role\",\n1115→            \"group_role\",\n1116→            \"arm_type\",\n1117→            \"arm_label\",\n1118→            \"group_label\",\n1119→            \"group_label_zh\",\n1120→            \"arm\",\n1121→            \"group\",\n1122→            \"arm_id\",\n1123→            \"group_id\",\n1124→            default=None,\n1125→        )\n1126→    arm_role, arm_label = _canonical_arm_role(raw_arm)\n1127→    return {\n1128→        \"clinical_concept\": concept,\n1129→        \"clinical_concept_label_zh\": concept_label,\n1130→        \"time_window_band\": time_band,\n1131→        \"time_window_band_label_zh\": time_band_label,\n1132→        \"statistical_form_family\": statistic,\n1133→        \"statistical_form_family_label_zh\": statistic_label,\n1134→        \"population_context\": population,\n1135→        \"population_context_label_zh\": population_label,\n1136→        \"arm_role\": arm_role,\n1137→        \"arm_role_label_zh\": arm_label,\n1138→    }\n1139→\n1140→\n1141→class ReportBPortalError(ValueError):\n1142→    \"\"\"B 类门户输入、视图适配或物理站点构建失败。\"\"\"\n1143→\n1144→\n1145→class ReportBSafetyRow(SafetyRow):\n1146→    \"\"\"B 类安全性行允许显式保存非数值披露状态及其医学原因。\"\"\"\n1147→\n1148→    disclosure_state: Literal[\"已公开\", \"未公开\", \"不适用\"] = \"已公开\"\n1149→    reason_zh: str | None = None\n1150→\n1151→\n1152→class ReportBPortalData(ReportAPortalData):\n1153→    \"\"\"B 类门户输入合同。\n1154→\n1155→    The legacy report-data rows remain the minimum fixture contract.  Optional\n1156→    immutable view sets are accepted under their Task 6.1--6.8 names so a real\n1157→    B snapshot can be rendered without moving scientific projection into this\n1158→    module's templates or JavaScript.\n1159→    \"\"\"\n1160→\n1161→    model_config = ConfigDict(extra=\"forbid\", frozen=True, arbitrary_types_allowed=True)\n1162→\n1163→    safety: tuple[ReportBSafetyRow, ...] = Field(min_length=1)\n1164→    report_snapshot_id: str | None = None\n1165→    efficacy_views: Any | None = None\n1166→    safety_views: Any | None = None\n1167→    baseline_views: Any | None = None\n1168→    disposition_views: Any | None = None\n1169→    supporting_evidence_views: Any | None = None\n1170→    supporting_views: Any | None = None\n1171→    subgroup_views: Any | None = None\n1172→    subgroups_views: Any | None = None\n1173→    matrix_view: Any | None = None\n1174→    matrix_views: Any | None = None\n1175→    views: Mapping[str, Any] | None = None\n1176→    view_states: Mapping[str, Any] | None = None\n1177→    semantic_proposals: tuple[SemanticGroupingProposal, ...] = Field(\n1178→        default=(), exclude_if=lambda value: not value,\n1179→    )\n1180→\n1181→    @model_validator(mode=\"after\")\n1182→    def _snapshot_is_not_blank(self) -> Self:\n1183→        if self.report_snapshot_id is not None and not self.report_snapshot_id.strip():\n1184→            raise ValueError(\"B 类报告锁定快照标识不得为空\")\n1185→        return self\n1186→\n1187→\n1188→def load_report_b_data(path: Path) -> ReportBPortalData:\n1189→    \"\"\"读取并校验 B 类门户数据包。\"\"\"\n1190→    try:\n1191→        payload = json.loads(path.read_text(encoding=\"utf-8\"))\n1192→    except (OSError, json.JSONDecodeError) as exc:\n1193→        raise ReportBPortalError(f\"无法读取 B 类报告数据：{path}\") from exc\n1194→    try:\n1195→        return ReportBPortalData.model_validate(payload)\n1196→    except ValueError as exc:\n1197→        raise ReportBPortalError(f\"B 类报告数据不符合合同：{exc}\") from exc\n1198→\n1199→\n1200→_BASELINE_REQUIREMENTS = {\n1201→    \"baseline_sample_size\": (\"b_baseline_sample_size\", \"样本量\"),\n1202→    \"age\": (\"b_baseline_age\", \"年龄\"),\n1203→    \"sex\": (\"b_baseline_sex\", \"性别\"),\n1204→    \"baseline_severity\": (\"b_baseline_severity_anchor\", \"疾病严重程度\"),\n1205→}\n1206→\n1207→\n1208→def report_b_baseline_gate_failures(data: ReportBPortalData) -> tuple[dict[str, str], ...]:\n1209→    \"\"\"逐核心试验逐组检查 D70 四类基线事实，不跨组借值。\"\"\"\n1210→    baseline_source = _get(data.baseline_views, \"facts\", ())\n1211→    disposition_source = _get(data.disposition_views, \"facts\", ())\n1212→    baseline_facts = tuple(item for item in baseline_source if isinstance(item, Mapping))\n1213→    disposition_facts = tuple(item for item in disposition_source if isinstance(item, Mapping))\n1214→    core_trials = {\n1215→        trial.id: trial\n1216→        for trial in data.trials\n1217→        if \"支持\" not in trial.role and \"事后\" not in trial.role\n1218→    }\n1219→    groups_by_trial: dict[str, set[str]] = defaultdict(set)\n1220→    for fact in (*baseline_facts, *disposition_facts):\n1221→        trial_id = _text(fact.get(\"trial_id\"))\n1222→        group_id = _text(fact.get(\"group_id\"))\n1223→        if trial_id in core_trials and group_id:\n1224→            groups_by_trial[trial_id].add(group_id)\n1225→\n1226→    concepts: dict[tuple[str, str], set[str]] = defaultdict(set)\n1227→    for fact in baseline_facts:\n1228→        trial_id = _text(fact.get(\"trial_id\"))\n1229→        group_id = _text(fact.get(\"group_id\"))\n1230→        if trial_id not in core_trials or not group_id:\n1231→            continue\n1232→        concept = _text(fact.get(\"standardized_concept\"))\n1233→        if _text(fact.get(\"variable_domain\")) == \"baseline_severity\":\n1234→            concepts[(trial_id, group_id)].add(\"baseline_severity\")\n1235→        if concept in {\"baseline_sample_size\", \"sample_size\", \"baseline_n\", \"n\"}:\n1236→            concepts[(trial_id, group_id)].add(\"baseline_sample_size\")\n1237→        elif concept in {\"age\", \"baseline_age\", \"age_at_baseline\"}:\n1238→            concepts[(trial_id, group_id)].add(\"age\")\n1239→        elif concept in {\"sex\", \"gender\", \"baseline_sex\", \"baseline_gender\"}:\n1240→            concepts[(trial_id, group_id)].add(\"sex\")\n1241→\n1242→    failures: list[dict[str, str]] = []\n1243→    for trial_id, trial in sorted(core_trials.items()):\n1244→        groups = sorted(groups_by_trial.get(trial_id) or {\"未识别组别\"})\n1245→        for group_id in groups:\n1246→            present = concepts.get((trial_id, group_id), set())\n1247→            for concept, (failure_code, label) in _BASELINE_REQUIREMENTS.items():\n1248→                if concept in present:\n1249→                    continue\n1250→                failures.append(\n1251→                    {\n1252→                        \"failure_code\": failure_code,\n1253→                        \"trial_id\": trial_id,\n1254→                        \"trial\": trial.display_id,\n1255→                        \"group_id\": group_id,\n1256→                        \"field\": concept,\n1257→                        \"field_zh\": label,\n1258→                    }\n1259→                )\n1260→    return tuple(failures)\n1261→\n1262→\n1263→# ---------------------------------------------------------------------------\n1264→# Small deterministic adaptation helpers\n1265→# ---------------------------------------------------------------------------\n1266→\n1267→_MISSING = object()\n1268→\n1269→\n1270→def _get(value: Any, name: str, default: Any = None) -> Any:\n1271→    if value is None:\n1272→        return default\n1273→    if isinstance(value, Mapping):\n1274→        return value.get(name, default)\n1275→    try:\n1276→        return getattr(value, name)\n1277→    except (AttributeError, TypeError):\n1278→        return default\n1279→\n1280→\n1281→def _first(value: Any, *names: str, default: Any = None) -> Any:\n1282→    for name in names:\n1283→        candidate = _get(value, name, _MISSING)\n1284→        if candidate is not _MISSING and candidate is not None:\n1285→            return candidate\n1286→    return default\n1287→\n1288→\n1289→def _enum_value(value: Any) -> Any:\n1290→    return value.value if isinstance(value, Enum) else value\n1291→\n1292→\n1293→def _text(value: Any, default: str = \"\") -> str:\n1294→    value = _enum_value(value)\n1295→    if value is None:\n1296→        return default\n1297→    result = \" \".join(str(value).split())\n1298→    return result or default\n1299→\n1300→\n1301→def _native_text(value: Any, default: str = \"\") -> str:\n1302→    text = _text(value, default)\n1303→    text = _NATIVE_LABELS.get(text, text)\n1304→    return text.replace(\"Other events\", \"其他不良事件\")\n1305→\n1306→\n1307→def _iter_values(value: Any) -> tuple[Any, ...]:\n1308→    if value is None:\n1309→        return ()\n1310→    if isinstance(value, (str, bytes)):\n1311→        return (value,)\n1312→    if isinstance(value, Mapping):\n1313→        return (value,)\n1314→    try:\n1315→        return tuple(value)\n1316→    except TypeError:\n1317→        return (value,)\n1318→\n1319→\n1320→def _collection(source: Any, *names: str) -> tuple[Any, ...]:\n1321→    if source is None:\n1322→        return ()\n1323→    if isinstance(source, (list, tuple, set, frozenset)):\n1324→        return tuple(source)\n1325→    for name in names:\n1326→        candidate = _get(source, name, _MISSING)\n1327→        if candidate is not _MISSING and candidate is not None:\n1328→            return _iter_values(candidate)\n1329→    return ()\n1330→\n1331→\n1332→def _flatten_view_rows(values: Sequence[Any]) -> tuple[Any, ...]:\n1333→    result: list[Any] = []\n1334→    nested_names = (\n1335→        \"complete_table\",\n1336→        \"table_rows\",\n1337→        \"fact_rows\",\n1338→        \"selected_facts\",\n1339→        \"facts\",\n1340→        \"effect_rows\",\n1341→        \"rows\",\n1342→    )\n1343→    for value in values:\n1344→        nested = _collection(value, *nested_names)\n1345→        if nested:\n1346→            result.extend(nested)\n1347→        else:\n1348→            result.append(value)\n1349→    return tuple(result)\n1350→\n1351→\n1352→def _number(value: Any) -> int | float | None:\n1353→    value = _enum_value(value)\n1354→    if isinstance(value, bool) or value is None:\n1355→        return None\n1356→    if isinstance(value, (int, float)):\n1357→        if isinstance(value, float) and not math.isfinite(value):\n1358→            return None\n1359→        return value\n1360→    if isinstance(value, Mapping):\n1361→        for key in (\"value\", \"numeric_value\", \"number\"):\n1362→            if key in value:\n1363→                return _number(value[key])\n1364→    nested = _get(value, \"value\", _MISSING)\n1365→    if nested is not _MISSING and nested is not value:\n1366→        return _number(nested)\n1367→    return None\n1368→\n1369→\n1370→def _state(value: Any, numeric: int | float | None) -> str:\n1371→    value = _enum_value(value)\n1372→    if value is not None:\n1373→        state = _STATE_ALIASES.get(str(value), str(value))\n1374→    else:\n1375→        state = \"reported_value\" if numeric is not None else \"not_reported\"\n1376→    if numeric is None and state in _CONCRETE_STATES:\n1377→        return \"not_reported\"\n1378→    return state\n1379→\n1380→\n1381→def _state_label(state: str) -> str:\n1382→    return {\n1383→        \"reported_value\": \"已报告值\",\n1384→        \"reported_zero\": \"已报告零值\",\n1385→        **_MISSING_STATE_LABELS,\n1386→    }.get(state, \"已报告\")\n1387→\n1388→\n1389→def _json(value: Any) -> str:\n1390→    \"\"\"Encode inline JSON safely for a file:// script block.\"\"\"\n1391→    return (\n1392→        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"))\n1393→        .replace(\"<\", \"\\\\u003c\")\n1394→        .replace(\">\", \"\\\\u003e\")\n1395→        .replace(\"&\", \"\\\\u0026\")\n1396→    )\n1397→\n1398→\n1399→def _canonical_json(value: Any) -> bytes:\n1400→    payload = json.dumps(\n1401→        value,\n1402→        ensure_ascii=False,\n1403→        sort_keys=True,\n1404→        separators=(\",\", \":\"),\n1405→    )\n1406→    return f\"{payload}\\n\".encode()\n1407→\n1408→\n1409→def _view_source(data: ReportBPortalData, name: str) -> Any:\n1410→    candidates = [name]\n1411→    aliases = {\n1412→        \"supporting_evidence_views\": (\n1413→            \"supporting_views\",\n1414→            \"subgroup_views\",\n1415→            \"subgroups_views\",\n1416→            \"supporting_evidence\",\n1417→            \"subgroups\",\n1418→        ),\n1419→    }\n1420→    candidates.extend(aliases.get(name, ()))\n1421→    if name.endswith(\"_views\"):\n1422→        candidates.append(name.removesuffix(\"_views\"))\n1423→    if name == \"matrix_view\":\n1424→        candidates.append(\"matrix_views\")\n1425→    for candidate_name in candidates:\n1426→        candidate = _get(data, candidate_name, None)\n1427→        if candidate is not None:\n1428→            return candidate\n1429→    for container_name in (\"views\", \"view_states\"):\n1430→        container = _get(data, container_name, None)\n1431→        if isinstance(container, Mapping):\n1432→            for candidate_name in candidates:\n1433→                if candidate_name in container and container[candidate_name] is not None:\n1434→                    return container[candidate_name]\n1435→    return None\n1436→\n1437→\n1438→def _unwrap_fact(value: Any) -> Any:\n1439→    for name in (\"fact\", \"observation\", \"original_observation\"):\n1440→        nested = _get(value, name, _MISSING)\n1441→        if nested is not _MISSING and nested is not None:\n1442→            return nested\n1443→    return value\n1444→\n1445→\n1446→def _stable_row_id(value: Any, fallback: str) -> str:\n1447→    candidate = _first(\n1448→        value,\n1449→        \"row_id\",\n1450→        \"fact_row_id\",\n1451→        \"fact_version_id\",\n1452→        \"comparison_row_id\",\n1453→        \"source_row_id\",\n1454→        \"id\",\n1455→        default=None,\n1456→    )\n1457→    return _text(candidate, fallback)\n1458→\n1459→\n1460→def _source_row_id(value: Any, fallback: str) -> str:\n1461→    return _text(\n1462→        _first(value, \"source_row_id\", \"source_row\", \"source_line_id\", \"row_ref\", default=None),\n1463→        fallback,\n1464→    )\n1465→\n1466→\n1467→def _product_id(value: Any) -> str:\n1468→    return _text(_first(value, \"product_id\", \"project_id\", default=\"\"))\n1469→\n1470→\n1471→def _trial_id(value: Any) -> str:\n1472→    return _text(_first(value, \"trial_id\", \"study_id\", default=\"\"))\n1473→\n1474→\n1475→def _label_for(value: Any, domain: str) -> str:\n1476→    if domain == \"efficacy\":\n1477→        candidate = _first(\n1478→            value,\n1479→            \"endpoint_family_label_zh\",\n1480→            \"endpoint_label_zh\",\n1481→            \"family_label_zh\",\n1482→            \"original_endpoint\",\n1483→            \"endpoint\",\n1484→            \"endpoint_family_id\",\n1485→            default=None,\n1486→        )\n1487→        return _native_text(candidate, \"疗效指标\")\n1488→    if domain == \"safety\":\n1489→        candidate = _first(\n1490→            value,\n1491→            \"standard_term\",\n1492→            \"source_term\",\n1493→            \"term\",\n1494→            \"event_term\",\n1495→            \"category\",\n1496→            \"family\",\n1497→            default=None,\n1498→        )\n1499→        return _native_text(candidate, \"安全性事件\")\n1500→    if domain == \"baseline\":\n1501→        candidate = _first(\n1502→            value,\n1503→            \"variable_label_zh\",\n1504→            \"standardized_concept\",\n1505→            \"source_name\",\n1506→            \"variable_domain\",\n1507→            default=None,\n1508→        )\n1509→        return _native_text(candidate, \"基线变量\")\n1510→    if domain == \"disposition\":\n1511→        candidate = _first(\n1512→            value,\n1513→            \"field_label_zh\",\n1514→            \"field\",\n1515→            \"source_field_name\",\n1516→            \"field_family\",\n1517→            default=None,\n1518→        )\n1519→        return _native_text(candidate, \"试验完成情况\")\n1520→    candidate = _first(value, \"display_label_zh\", \"name\", \"label_zh\", default=None)\n1521→    return _native_text(candidate, \"研究记录\")\n1522→\n1523→\n1524→def _arm_label(value: Any) -> str:\n1525→    candidate = _first(value, \"arm_label\", \"group_label\", \"group_label_zh\", \"arm\", default=None)\n1526→    if candidate is not None:\n1527→        raw = _text(_enum_value(candidate))\n1528→        canonical, canonical_label = _canonical_arm_role(raw)\n1529→        if canonical != \"unknown\":\n1530→            return canonical_label\n1531→        return raw\n1532→    role = _text(_first(value, \"arm_role\", \"group_role\", \"arm_type\", default=\"\"))\n1533→    canonical, canonical_label = _canonical_arm_role(role)\n1534→    if canonical != \"unknown\":\n1535→        return canonical_label\n1536→    identifier = _text(_first(value, \"group_id\", \"arm_id\", \"cohort_id\", default=\"\")).casefold()\n1537→    if \"control\" in identifier or \"placebo\" in identifier:\n1538→        return \"对照组\"\n1539→    if \"treatment\" in identifier or \"treated\" in identifier:\n1540→        return \"治疗组\"\n1541→    if \"cohort\" in identifier:\n1542→        return \"全研究人群\"\n1543→    return \"组别未列示\"\n1544→\n1545→\n1546→def _category_for(value: Any, domain: str, arm: str) -> str:\n1547→    if domain != \"safety\":\n1548→        return arm\n1549→    category = _text(\n1550→        _first(value, \"category\", \"family\", \"event_family\", \"safety_family\", default=\"\"),\n1551→        \"安全性事件\",\n1552→    )\n1553→    aliases = {\n1554→        \"teae\": \"治疗期间不良事件\",\n1555→        \"sae\": \"严重不良事件\",\n1556→        \"aesi\": \"特别关注不良事件\",\n1557→        \"common_ae\": \"常见不良事件\",\n1558→        \"death\": \"死亡\",\n1559→        \"grade_3_plus\": \"3级及以上不良事件\",\n1560→        \"discontinuation_ae\": \"导致停药不良事件\",\n1561→        \"treatment_related_teae\": \"治疗相关不良事件\",\n1562→    }\n1563→    return aliases.get(category.casefold(), category)\n1564→\n1565→\n1566→def _time_label(value: Any) -> str:\n1567→    candidate = _first(\n1568→        value,\n1569→        \"timepoint\",\n1570→        \"actual_timepoint\",\n1571→        \"observed_timepoint\",\n1572→        \"timepoint_value\",\n1573→        \"time_window_zh\",\n1574→        \"time_window\",\n1575→        default=None,\n1576→    )\n1577→    if candidate is None:\n1578→        return \"时间点未列示\"\n1579→    unit = _first(value, \"actual_timepoint_unit\", \"time_unit\", \"timepoint_unit\", default=None)\n1580→    if unit and isinstance(candidate, (int, float)):\n1581→        unit_zh = {\n1582→            \"day\": \"天\",\n1583→            \"days\": \"天\",\n1584→            \"week\": \"周\",\n1585→            \"weeks\": \"周\",\n1586→            \"month\": \"个月\",\n1587→            \"months\": \"个月\",\n1588→            \"year\": \"年\",\n1589→            \"years\": \"年\",\n1590→        }.get(_text(unit).casefold(), _text(unit))\n1591→        return f\"第{candidate:g}{unit_zh}\"\n1592→    return _text(candidate, \"时间点未列示\")\n1593→\n1594→\n1595→def _value_for(value: Any) -> int | float | None:\n1596→    candidate = _first(\n1597→        value,\n1598→        \"numeric_value\",\n1599→        \"observed_value\",\n1600→        \"value\",\n1601→        \"reported_proportion\",\n1602→        \"effect_value\",\n1603→        \"raw_numeric_value\",\n1604→        default=None,\n1605→    )\n1606→    return _number(candidate)\n1607→\n1608→\n1609→def _unit_for(value: Any, default: str = \"\") -> str:\n1610→    return _text(\n1611→        _first(\n1612→            value,\n1613→            \"unit\",\n1614→            \"measurement_unit\",\n1615→            \"measure_unit\",\n1616→            \"effect_unit\",\n1617→            default=default,\n1618→        )\n1619→    )\n1620→\n1621→\n1622→def _source_version(value: Any) -> str:\n1623→    return _text(\n1624→        _first(\n1625→            value,\n1626→            \"source_version_id\",\n1627→            \"source_version\",\n1628→            \"captured_version\",\n1629→            default=\"ctgov-fixture\",\n1630→        ),\n1631→        \"ctgov-fixture\",\n1632→    )\n1633→\n1634→\n1635→def _source_locator(value: Any, row_id: str) -> EvidenceLocator:\n1636→    candidate = _first(value, \"source_locator\", \"locator\", \"source_location\", default=None)\n1637→    if isinstance(candidate, EvidenceLocator):\n1638→        return candidate\n1639→    if isinstance(candidate, Mapping):\n1640→        try:\n1641→            return EvidenceLocator.model_validate(candidate)\n1642→        except (TypeError, ValueError):\n1643→            pass\n1644→    return EvidenceLocator(document_role=\"registry\", heading=\"登记结果\")\n1645→\n1646→\n1647→def _display_locator(value: Any, row_id: str) -> EvidenceLocator:\n1648→    \"\"\"Hide storage keys while keeping a useful source-facing anchor.\"\"\"\n1649→    locator = _source_locator(value, row_id)\n1650→    visible = {\n1651→        \"document_role\": locator.document_role,\n1652→        \"heading\": locator.heading,\n1653→        \"page\": locator.page,\n1654→        \"table\": locator.table,\n1655→        \"column\": locator.column,\n1656→        \"paragraph\": locator.paragraph,\n1657→        \"url\": locator.url,\n1658→    }\n1659→    if not any(value for key, value in visible.items() if key != \"document_role\"):\n1660→        visible[\"heading\"] = \"登记结果\"\n1661→    return EvidenceLocator.model_validate(visible)\n1662→\n1663→\n1664→def _source_first(value: Any, source: Any, *names: str, default: Any = None) -> Any:\n1665→    candidate = _first(value, *names, default=_MISSING)\n1666→    if candidate is not _MISSING and candidate is not None:\n1667→        return candidate\n1668→    return _first(source, *names, default=default)\n1669→\n1670→\n1671→def _project_record(\n1672→    value: Any,\n1673→    *,\n1674→    domain: str,\n1675→    names: Mapping[str, str],\n1676→    trial_names: Mapping[str, str],\n1677→    fallback: str,\n1678→) -> dict[str, Any]:\n1679→    source = _unwrap_fact(value)\n1680→    row_id = _stable_row_id(value, fallback)\n1681→    product_id = _product_id(value) or _product_id(source)\n1682→    trial_id = _trial_id(value) or _trial_id(source)\n1683→    numeric = _value_for(value)\n1684→    raw_state = _first(value, \"disclosure_state\", default=None)\n1685→    state = _state(raw_state, numeric)\n1686→    renderable = numeric is not None and state in _CONCRETE_STATES\n1687→    product_name = names.get(product_id, \"未列示产品\")\n1688→    trial_name = trial_names.get(trial_id, \"未列示试验\")\n1689→    label = _label_for(value, domain)\n1690→    arm = _arm_label(value)\n1691→    category = _category_for(value, domain, arm)\n1692→    unit = _text(\n1693→        _source_first(\n1694→            value,\n1695→            source,\n1696→            \"unit\",\n1697→            \"measurement_unit\",\n1698→            \"measure_unit\",\n1699→            \"effect_unit\",\n1700→            default=\"%\" if domain in {\"efficacy\", \"safety\"} else \"\",\n1701→        )\n1702→    )\n1703→    cohort = _native_text(_source_first(value, source, \"cohort_id\", \"cohort\", default=\"\"))\n1704→    period = _native_text(_source_first(value, source, \"period_id\", \"period\", \"phase\", default=\"\"))\n1705→    reason = _native_text(\n1706→        _source_first(value, source, \"canonical_reason\", \"reason_zh\", \"reason\", default=\"\")\n1707→    )\n1708→    target = _native_text(_source_first(value, source, \"target_id\", \"target\", default=\"\"))\n1709→    group_id = _text(_source_first(value, source, \"group_id\", \"arm_id\", \"group\", default=\"\"))\n1710→    population = _text(\n1711→        _source_first(\n1712→            value,\n1713→            source,\n1714→            \"analysis_population_zh\",\n1715→            \"analysis_population\",\n1716→            \"population\",\n1717→            default=\"\",\n1718→        ),\n1719→    )\n1720→    field_family = _native_text(\n1721→        _source_first(value, source, \"field_family\", \"variable_domain\", default=\"\")\n1722→    )\n1723→    statistic_form = _native_text(\n1724→        _source_first(\n1725→            value,\n1726→            source,\n1727→            \"statistic_form\",\n1728→            \"statistic_label_zh\",\n1729→            \"statistical_form\",\n1730→            default=\"\",\n1731→        )\n1732→    )\n1733→    denominator_role = _native_text(_source_first(value, source, \"denominator_role\", default=\"\"))\n1734→    measure_object = _native_text(_source_first(value, source, \"measure_object\", default=\"\"))\n1735→    time_label = _time_label(value)\n1736→    time_window = _text(\n1737→        _source_first(\n1738→            value,\n1739→            source,\n1740→            \"time_window_zh\",\n1741→            \"time_window\",\n1742→            \"baseline_timepoint\",\n1743→            default=time_label,\n1744→        ),\n1745→        time_label,\n1746→    )\n1747→    numerator = _number(_source_first(value, source, \"numerator\", default=None))\n1748→    denominator = _number(_source_first(value, source, \"denominator\", default=None))\n1749→    semantics = _semantic_projection(value, source, do