{"type":"user","uuid":"01a08c83-608d-7d45-a750-e3d0a2311b66","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_00_XV63tf4NeuM1X894yjtA9040","content":[{"type":"text","text":"   1→\"\"\"HTML-only v1 活跃 pytest 分层合同（v1.3 §1.3/§13.1）。\n   2→\n   3→v1 发布面是 HTML-only：PDF/HTML-PPT/PPTX 的源码与测试作为保留回归轨存在\n   4→（marker ``retained_legacy_format``），但不得冒充 v1 release gate。本合同\n   5→失败关闭地保证：\n   6→\n   7→- 声明的每一条保留轨文件都存在且带模块级 marker；\n   8→- tests/pdf、tests/html_ppt 两个 legacy 根下的文件必须全部被声明；\n   9→- 保留轨之外的活跃测试不得直接 import 非 HTML 格式运行时；\n  10→- marker 必须在 pyproject 中注册（配合 --strict-markers 失败关闭）；\n  11→- marker 文件集合与声明集合双向精确相等，防止活跃测试被静默移出门禁；\n  12→- gate 的保留轨步骤只能自称 ``retained-compat-smoke``：它是 tests/unit 与\n  13→  tests/contract 内声明保留轨文件的有界兼容性 smoke，不是全量保留轨，\n  14→  也不是 v1 release gate（CodeBuddy 裁决：修口径，不重启排除格式产品轨）。\n  15→\n  16→分层后的可复现命令（债清单见 reviews/）：\n  17→  活跃层：uv run python -m pytest -q -m \"not retained_legacy_format\" <路径...>\n  18→  保留轨：uv run python -m pytest -q -m \"retained_legacy_format\" <路径...>\n  19→\"\"\"\n  20→\n  21→from __future__ import annotations\n  22→\n  23→import re\n  24→from pathlib import Path\n  25→\n  26→ROOT = Path(__file__).resolve().parents[2]\n  27→TESTS_ROOT = ROOT / \"tests\"\n  28→\n  29→MARKER = \"retained_legacy_format\"\n  30→MARKER_LINE = f\"pytestmark = [pytest.mark.{MARKER}]\"\n  31→\n  32→# 非 HTML 格式运行时的 import 签名：只允许出现在已声明保留轨中。\n  33→LEGACY_RUNTIME_IMPORTS = (\n  34→    \"ci_workflow.renderers.pdf_native\",\n  35→    \"ci_workflow.renderers.html_ppt\",\n  36→    \"ci_workflow.renderers.pptx_master\",\n  37→    \"ci_workflow.application.ppt_master_job\",\n  38→)\n  39→\n  40→# legacy 测试根：根下所有测试文件都必须进入 RETAINED_FILES。\n  41→LEGACY_TEST_ROOTS = (\n  42→    \"tests/pdf\",\n  43→    \"tests/html_ppt\",\n  44→)\n  45→\n  46→# 已声明保留轨（相对仓库根；与各文件中的模块级 marker 一一对应）。\n  47→RETAINED_FILES: tuple[str, ...] = (\n  48→    \"tests/acceptance/test_html_ppt_runtime_smoke.py\",\n  49→    \"tests/acceptance/test_native_pdf_slice.py\",\n  50→    \"tests/acceptance/test_pdf_outputs.py\",\n  51→    \"tests/contract/test_ppt_master_job.py\",\n  52→    \"tests/contract/test_ppt_master_job_contract_vectors.py\",\n  53→    \"tests/graph/test_pptx_confirmation_interrupt.py\",\n  54→    \"tests/html_ppt/test_html_ppt_browser_contract.py\",\n  55→    \"tests/html_ppt/test_projection_contract.py\",\n  56→    \"tests/html_ppt/test_report_a_html_ppt.py\",\n  57→    \"tests/html_ppt/test_report_bc_html_ppt.py\",\n  58→    \"tests/pdf/test_pdf09_shared_coverage.py\",\n  59→    \"tests/pdf/test_report_a_pdf.py\",\n  60→    \"tests/pdf/test_report_b_pdf.py\",\n  61→    \"tests/pdf/test_report_c_pdf.py\",\n  62→    \"tests/pdf/test_table_identity_wrap.py\",\n  63→    \"tests/renderers/test_pdf_vertical_slice.py\",\n  64→    \"tests/renderers/test_ppt_master_confirmation.py\",\n  65→    \"tests/renderers/test_ppt_master_source_pack.py\",\n  66→)\n  67→\n  68→\n  69→def _iter_test_files() -> list[Path]:\n  70→    return sorted(TESTS_ROOT.rglob(\"test_*.py\"))\n  71→\n  72→\n  73→def test_marker_is_registered_in_pyproject() -> None:\n  74→    text = (ROOT / \"pyproject.toml\").read_text(encoding=\"utf-8\")\n  75→    assert MARKER in text, \"marker 必须在 pyproject [tool.pytest.ini_options] 注册\"\n  76→\n  77→\n  78→def test_declared_retained_files_exist_and_carry_the_marker() -> None:\n  79→    missing: list[str] = []\n  80→    unmarked: list[str] = []\n  81→    for relative in RETAINED_FILES:\n  82→        path = ROOT / relative\n  83→        if not path.is_file():\n  84→            missing.append(relative)\n  85→            continue\n  86→        if MARKER_LINE not in path.read_text(encoding=\"utf-8\"):\n  87→            unmarked.append(relative)\n  88→    assert not missing, f\"声明的保留轨文件不存在：{missing}\"\n  89→    assert not unmarked, f\"保留轨文件缺少模块级 marker：{unmarked}\"\n  90→\n  91→\n  92→def test_every_test_file_under_legacy_roots_is_declared() -> None:\n  93→    for root in LEGACY_TEST_ROOTS:\n  94→        for path in sorted((ROOT / root).rglob(\"test_*.py\")):\n  95→            relative = path.relative_to(ROOT).as_posix()\n  96→            assert relative in RETAINED_FILES, (\n  97→                f\"legacy 根下出现未声明文件：{relative}；\"\n  98→                \"必须加入保留轨声明并携带 marker\"\n  99→            )\n 100→\n 101→\n 102→def test_active_tests_do_not_import_legacy_format_runtimes() -> None:\n 103→    retained = set(RETAINED_FILES)\n 104→    offenders: list[str] = []\n 105→    for path in _iter_test_files():\n 106→        relative = path.relative_to(ROOT).as_posix()\n 107→        if relative in retained:\n 108→            continue\n 109→        text = path.read_text(encoding=\"utf-8\")\n 110→        if MARKER_LINE in text:\n 111→            continue\n 112→        for signature in LEGACY_RUNTIME_IMPORTS:\n 113→            if re.search(rf\"^\\s*(from|import)\\s+{re.escape(signature)}\\b\", text, re.M):\n 114→                offenders.append(f\"{relative} -> {signature}\")\n 115→    assert not offenders, (\n 116→        \"活跃层测试不得直接依赖非 HTML 格式运行时\"\n 117→        f\"（请声明加入保留轨或改为负面断言）：{offenders}\"\n 118→    )\n 119→\n 120→\n 121→def test_marker_carrying_files_exactly_equal_declared_retained_files() -> None:\n 122→    \"\"\"双向精确相等：带 marker 的文件必须全部声明，声明文件必须真实带 marker。\"\"\"\n 123→\n 124→    marked = {\n 125→        path.relative_to(ROOT).as_posix()\n 126→        for path in _iter_test_files()\n 127→        if MARKER_LINE in path.read_text(encoding=\"utf-8\")\n 128→    }\n 129→    declared = set(RETAINED_FILES)\n 130→    undeclared = sorted(marked - declared)\n 131→    phantom = sorted(declared - marked)\n 132→    assert not undeclared, (\n 133→        \"带 marker 但未声明进保留轨的文件会被活跃层集合排除在守护之外，\"\n 134→        f\"必须补声明或移除 marker：{undeclared}\"\n 135→    )\n 136→    assert not phantom, f\"声明进保留轨但实际不带 marker 的文件：{phantom}\"\n 137→\n 138→\n 139→# gate 的保留轨兼容性 smoke 只运行 tests/unit 与 tests/contract 下的声明保留轨\n 140→# 文件；它是子集冒烟，不是全量保留轨（18 个声明文件），更不算 v1 release gate。\n 141→RETAINED_COMPAT_SMOKE_ROOTS = (\"tests/unit\", \"tests/contract\")\n 142→\n 143→# 当前有界 smoke 的精确文件集合；变化必须在此显式改合同，不允许静默漂移。\n 144→EXPECTED_RETAINED_COMPAT_SMOKE_FILES: tuple[str, ...] = (\n 145→    \"tests/contract/test_ppt_master_job.py\",\n 146→    \"tests/contract/test_ppt_master_job_contract_vectors.py\",\n 147→)\n 148→\n 149→GATE_SCRIPT = ROOT / \"tools\" / \"gate.sh\"\n 150→\n 151→\n 152→def retained_compat_smoke_files() -> tuple[str, ...]:\n 153→    return tuple(\n 154→        relative\n 155→        for relative in RETAINED_FILES\n 156→        if relative.startswith(RETAINED_COMPAT_SMOKE_ROOTS)\n 157→    )\n 158→\n 159→\n 160→def test_gate_retained_smoke_scope_is_exact_declared_subset() -> None:\n 161→    expected = retained_compat_smoke_files()\n 162→    assert expected == EXPECTED_RETAINED_COMPAT_SMOKE_FILES, (\n 163→        \"gate 兼容性 smoke 的声明子集发生变化；必须同步更新精确口径：\"\n 164→        f\"实际={expected} 合同={EXPECTED_RETAINED_COMPAT_SMOKE_FILES}\"\n 165→    )\n 166→\n 167→\n 168→def test_gate_labels_retained_step_as_bounded_compat_smoke_not_release_gate() -> None:\n 169→    text = GATE_SCRIPT.read_text(encoding=\"utf-8\")\n 170→    # 步骤只运行 unit/contract 两个目录并带保留轨 marker 过滤；不得悄悄扩大\n 171→    # 到 tests/pdf、tests/html_ppt 等产品轨，也不得保留旧的全量暗示名称。\n 172→    assert (\n 173→        'run_step retained-compat-smoke uv run python -m pytest tests/unit tests/contract '\n 174→        '-q -m \"retained_legacy_format\"'\n 175→    ) in text, \"gate 保留轨步骤必须是有界兼容性 smoke：仅 tests/unit+tests/contract\"\n 176→    assert \"retained-legacy-fast-tests\" not in text, (\n 177→        \"旧步骤名 retained-legacy-fast-tests 暗示保留轨基础回归，已废弃\"\n 178→    )\n 179→    scope = next(line for line in text.splitlines() if \"GATE_SCOPE\" in line)\n 180→    assert 'retained_compat_smoke=tests/unit,tests/contract,-m+\"retained_legacy_format\"' in scope\n 181→    assert \"full-retained-track-not-run-here\" in scope, (\n 182→        \"scope 必须声明全量保留轨未随 gate 运行\"\n 183→    )\n 184→    assert \"retained-steps-are-not-v1-release-gate\" in scope\n 185→    usage_start = text.index(\"usage()\")\n 186→    usage_end = text.index(\"while (($# > 0))\")\n 187→    usage = text[usage_start:usage_end]\n 188→    assert \"兼容性 smoke\" in usage\n 189→    assert \"不是全量保留轨\" in usage, \"用法说明必须写明 smoke 不是全量保留轨\"\n 190→    assert \"不算 v1 release gate\" in usage\n 191→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a08c8052637ef99d54eb1364f5e9f1","_messageId":"01a08c834fc37e0694700d96c4b1955c","_meta":{"codebuddy.ai/conversationRequestId":"01a08c8052637ef99d54eb1364f5e9f1","codebuddy.ai/modelRequestId":"01a08c834fc37e0694700d96c4b1955c","codebuddy.ai/llmMessageId":"01a08c834fc37e0694700d96c4b1955c","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:10:15.310Z"}
