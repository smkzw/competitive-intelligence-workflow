gory === \"对照组\") return row.category;\n  52→    var gid = String(row.group_id || \"\");\n  53→    if (gid.indexOf(\"treat\") !== -1) return \"治疗组\";\n  54→    if (gid.indexOf(\"ctrl\") !== -1) return \"对照组\";\n  55→    return row.category || \"\";\n  56→  }\n  57→\n  58→  function groupHasRenderable(group) {\n  59→    for (var i = 0; i < group.rows.length; i++) {\n  60→      if (isRenderable(group.rows[i])) return true;\n  61→    }\n  62→    return false;\n  63→  }\n  64→\n  65→  function visibleRowIdsInDom() {\n  66→    var visible = [];\n  67→    var rows = document.querySelectorAll(\".kz-chart-table__row\");\n  68→    for (var i = 0; i < rows.length; i++) {\n  69→      if (rows[i].style.display !== \"none\") {\n  70→        visible.push(rows[i].getAttribute(\"data-row-id\"));\n  71→      }\n  72→    }\n  73→    return visible;\n  74→  }\n  75→\n  76→  function nullPoint(row) {\n  77→    var status = row.disclosure_state || \"not_publicly_disclosed\";\n  78→    return {\n  79→      value: null,\n  80→      status: status,\n  81→      statusLabel: disclosureLabelZh(status),\n  82→      itemStyle: { color: \"#D1D5DB\", opacity: 0.55 },\n  83→      label: {\n  84→        show: true,\n  85→        formatter: disclosureLabelZh(status),\n  86→        color: \"#6B7280\",\n  87→        fontSize: 16\n  88→      }\n  89→    };\n  90→  }\n  91→\n  92→  function collectRowIds(group) {\n  93→    var ids = [];\n  94→    for (var i = 0; i < group.rows.length; i++) ids.push(group.rows[i].row_id);\n  95→    return ids;\n  96→  }\n  97→\n  98→  function collectRenderableRowIds(group) {\n  99→    var ids = [];\n 100→    for (var i = 0; i < group.rows.length; i++) {\n 101→      if (isRenderable(group.rows[i])) ids.push(group.rows[i].row_id);\n 102→    }\n 103→    return ids;\n 104→  }\n 105→\n 106→  function withMeta(option, rowIds) {\n 107→    option.animation = false;\n 108→    option._rowIds = rowIds;\n 109→    option._snapshotId = snapshotId;\n 110→    option._rowSetDigest = row