{"type":"user","uuid":"01a08c83-86aa-7b3a-ab36-ccf8274a4e32","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_01_3lzXqwXKUEc5hcPfkycS9934","content":[{"type":"text","text":"   1→\"\"\"Atomic per-report publication pointers; candidate directories are never latest.\"\"\"\n   2→\n   3→from __future__ import annotations\n   4→\n   5→import os\n   6→import tempfile\n   7→from datetime import datetime\n   8→from pathlib import Path\n   9→from typing import Literal\n  10→\n  11→from pydantic import BaseModel, ConfigDict, Field\n  12→\n  13→from ci_workflow.application.delivered_artifacts import _ordinary, read_accepted_html_artifacts\n  14→from ci_workflow.storage.manifest_store import ArtifactManifest, ManifestStore\n  15→from ci_workflow.storage.sqlite import open_database\n  16→\n  17→\n  18→class LatestDelivery(BaseModel):\n  19→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  20→\n  21→    schema_version: Literal[\"1.0\"] = \"1.0\"\n  22→    project_id: str\n  23→    contract_version: int = Field(ge=1)\n  24→    report: Literal[\"A\", \"B\", \"C\"]\n  25→    report_version: str\n  26→    manifest_id: str\n  27→    report_snapshot_id: str\n  28→    artifact_sha256: str = Field(pattern=r\"^[0-9a-f]{64}$\")\n  29→    entry_relative_path: str\n  30→    accepted_at: datetime\n  31→\n  32→\n  33→def _projection(manifest: ArtifactManifest) -> LatestDelivery:\n  34→    return LatestDelivery(\n  35→        project_id=manifest.project_id, contract_version=manifest.contract_version,\n  36→        report=manifest.report, report_version=manifest.report_version,\n  37→        manifest_id=manifest.manifest_id, report_snapshot_id=manifest.report_snapshot_id,\n  38→        artifact_sha256=manifest.artifact.sha256,\n  39→        entry_relative_path=f\"{manifest.artifact.relative_path}/index.html\",\n  40→        accepted_at=manifest.render_verdict.verified_at,\n  41→    )\n  42→\n  43→\n  44→def _pointer(root: Path, report: str) -> Path:\n  45→    if report not in {\"A\", \"B\", \"C\"}:\n  46→        raise ValueError(\"最新版报告类型只能是A/B/C\")\n  47→    path = root / \"reports\" / report / \"latest.json\"\n  48→    _ordinary(root, path)\n  49→    return path\n  50→\n  51→\n  52→def read_latest_delivery(project_root: Path, report: str) -> LatestDelivery | None:\n  53→    root = project_root.expanduser().resolve()\n  54→    path = _pointer(root, report)\n  55→    if not path.exists():\n  56→        return None\n  57→    pointer = LatestDelivery.model_validate_json(path.read_bytes())\n  58→    artifacts = read_accepted_html_artifacts(root, contract_version=pointer.contract_version)\n  59→    matches = [\n  60→        item for item in artifacts\n  61→        if item.manifest_id == pointer.manifest_id and item.report == report\n  62→    ]\n  63→    if len(matches) != 1 or _projection(matches[0]) != pointer:\n  64→        raise ValueError(\"最新版指针未绑定可验证的已接受产物\")\n  65→    return pointer\n  66→\n  67→\n  68→def publish_latest_delivery(project_root: Path, manifest_id: str) -> LatestDelivery:\n  69→    root = project_root.expanduser().resolve()\n  70→    matches = [\n  71→        item for item in read_accepted_html_artifacts(root) if item.manifest_id == manifest_id\n  72→    ]\n  73→    if len(matches) != 1:\n  74→        raise ValueError(\"仅唯一的已接受产物可以发布最新版\")\n  75→    manifest = matches[0]\n  76→    candidate = _projection(manifest)\n  77→    path = _pointer(root, manifest.report)\n  78→    encoded = (candidate.model_dump_json() + \"\\n\").encode()\n  79→    for _attempt in range(3):\n  80→        previous_bytes = path.read_bytes() if path.exists() else None\n  81→        previous = read_latest_delivery(root, manifest.report)\n  82→        if previous == candidate:\n  83→            return candidate\n  84→        if previous is not None and (\n  85→            previous.contract_version > candidate.contract_version\n  86→            or previous.accepted_at >= candidate.accepted_at\n  87→        ):\n  88→            raise ValueError(\"不得自动回退或以同一接受时刻覆盖最新版\")\n  89→        # Serialize publishers using the existing project DB, then compare-and-swap.\n  90→        with open_database(root / \"state/project.sqlite\") as database:\n  91→            database.execute(\"BEGIN IMMEDIATE\")\n  92→            _ordinary(root, path)\n  93→            current_bytes = path.read_bytes() if path.exists() else None\n  94→            if current_bytes != previous_bytes:\n  95→                continue\n  96→            ManifestStore(root).verify_artifact(manifest)\n  97→            descriptor, temporary = tempfile.mkstemp(prefix=\".latest-\", dir=path.parent)\n  98→            try:\n  99→                with os.fdopen(descriptor, \"wb\") as stream:\n 100→                    stream.write(encoded)\n 101→                    stream.flush()\n 102→                    os.fsync(stream.fileno())\n 103→                os.replace(temporary, path)\n 104→            finally:\n 105→                Path(temporary).unlink(missing_ok=True)\n 106→            return candidate\n 107→    raise ValueError(\"最新版被并发更新，请重新验证后重试\")\n 108→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":null,"_requestId":"01a08c8052637ef99d54eb1364f5e9f1","_messageId":"01a08c837e8678aa80cd90f3915736b7","_meta":{"codebuddy.ai/conversationRequestId":"01a08c8052637ef99d54eb1364f5e9f1","codebuddy.ai/modelRequestId":"01a08c837e8678aa80cd90f3915736b7","codebuddy.ai/llmMessageId":"01a08c837e8678aa80cd90f3915736b7","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:10:25.067Z"}
