{"type":"user","uuid":"01a08c81-112b-704b-8c57-ce2cb40a94c7","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_mnDksELAM479E21LocjrxHQb","content":[{"type":"text","text":"   1→\"\"\"Bound model proposals for candidate B views; not an independent acceptance receipt.\"\"\"\n   2→\n   3→from __future__ import annotations\n   4→\n   5→import hashlib\n   6→import json\n   7→from collections.abc import Mapping, Sequence\n   8→from typing import Any, Literal\n   9→\n  10→from pydantic import BaseModel, ConfigDict, TypeAdapter, field_validator, model_validator\n  11→\n  12→from ci_workflow.reports.b.semantic_contract import (\n  13→    ClinicalConstructObservation,\n  14→    compare_clinical_constructs,\n  15→    semantic_value_is_unknown,\n  16→)\n  17→\n  18→SEMANTIC_POLICY_VERSION = \"b-candidate-hard-axes-v2\"\n  19→_SOURCE_JSON = TypeAdapter(Any)\n  20→\n  21→\n  22→def semantic_source_digest(value: Any) -> str:\n  23→    \"\"\"Bind the complete supplied fact, including locator and derivation metadata.\n  24→\n  25→    This binds declared provenance; it does not attest that external bytes were\n  26→    retrieved or independently verified. Those remain acquisition/review gates.\n  27→    \"\"\"\n  28→    return hashlib.sha256(json.dumps(\n  29→        _SOURCE_JSON.dump_python(value, mode=\"json\"), ensure_ascii=False,\n  30→        sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n  31→    ).encode()).hexdigest()\n  32→\n  33→\n  34→class SemanticGroupingProposal(BaseModel):\n  35→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  36→\n  37→    schema_version: Literal[\"1\"] = \"1\"\n  38→    status: Literal[\"proposal\"] = \"proposal\"\n  39→    proposal_id: str\n  40→    row_ids: tuple[str, str]\n  41→    row_digests: tuple[str, str]\n  42→    compatible: bool\n  43→    time_window_compatible: bool = False\n  44→    producer_id: str\n  45→    rationale_zh: str\n  46→\n  47→    @field_validator(\"proposal_id\", \"producer_id\", \"rationale_zh\")\n  48→    @classmethod\n  49→    def nonempty(cls, value: str) -> str:\n  50→        if not value.strip():\n  51→            raise ValueError(\"语义提案标识与理由不能为空\")\n  52→        return value.strip()\n  53→\n  54→    @model_validator(mode=\"after\")\n  55→    def binding(self) -> SemanticGroupingProposal:\n  56→        if len(set(self.row_ids)) != 2 or any(not value.strip() for value in self.row_ids):\n  57→            raise ValueError(\"语义提案必须绑定两个不同观察\")\n  58→        if any(len(value) != 64 or any(c not in \"0123456789abcdef\" for c in value)\n  59→               for value in self.row_digests):\n  60→            raise ValueError(\"语义提案必须绑定完整观察摘要\")\n  61→        return self\n  62→\n  63→\n  64→def semantic_row_digest(row: Mapping[str, Any]) -> str:\n  65→    \"\"\"Bind policy, complete supplied fact digest, and projected clinical values.\"\"\"\n  66→    payload = {key: value for key, value in row.items() if not key.startswith(\"_\")}\n  67→    payload[\"_source_binding\"] = row.get(\"_source_binding\")\n  68→    payload[\"_semantic_policy\"] = SEMANTIC_POLICY_VERSION\n  69→    return hashlib.sha256(json.dumps(\n  70→        payload, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False,\n  71→    ).encode()).hexdigest()\n  72→\n  73→\n  74→def _observation(row: Mapping[str, Any]) -> ClinicalConstructObservation:\n  75→    return ClinicalConstructObservation.model_validate({\n  76→        \"observation_id\": row[\"row_id\"],\n  77→        \"clinical_construct\": row.get(\"clinical_concept\", \"not_reported\"),\n  78→        \"definition\": row.get(\"semantic_definition\", \"not_reported\"),\n  79→        \"direction\": row.get(\"semantic_direction\", \"not_reported\"),\n  80→        \"unit\": row.get(\"unit\", \"not_reported\"),\n  81→        \"estimand\": row.get(\"semantic_estimand\", \"not_reported\"),\n  82→        \"denominator\": row.get(\"semantic_denominator\", \"not_reported\"),\n  83→        \"analysis_set\": row.get(\"semantic_analysis_set\", \"not_reported\"),\n  84→        \"analysis_form\": row.get(\"semantic_analysis_form\", \"not_reported\"),\n  85→        \"instrument_or_scale\": row.get(\"semantic_instrument_or_scale\", \"not_reported\"),\n  86→        \"actual_timepoint\": row.get(\"actual_timepoint\"),\n  87→        \"actual_timepoint_unit\": row.get(\"actual_timepoint_unit\"),\n  88→    })\n  89→\n  90→\n  91→def proposed_semantic_buckets(\n  92→    buckets: Sequence[Sequence[tuple[dict[str, Any], Any]]],\n  93→    proposals: Sequence[SemanticGroupingProposal],\n  94→    *, descriptive_only: bool = False,\n  95→) -> tuple[tuple[tuple[dict[str, Any], Any], ...], ...]:\n  96→    \"\"\"Complete-link grouping: no transitive compatibility and no dropped observations.\n  97→\n  98→    Same-trial descriptive groups remain available. Every cross-trial pair passes\n  99→    the deterministic guard, including pairs for which no proposal was supplied.\n 100→    \"\"\"\n 101→    rows: dict[str, tuple[dict[str, Any], Any]] = {}\n 102→    origin: dict[str, int] = {}\n 103→    for index, bucket in enumerate(buckets):\n 104→        for item in bucket:\n 105→            row_id = str(item[0][\"row_id\"])\n 106→            if row_id in rows:\n 107→                raise ValueError(\"语义视图观察标识重复\")\n 108→            rows[row_id] = item\n 109→            origin[row_id] = index\n 110→    pairs: dict[frozenset[str], SemanticGroupingProposal] = {}\n 111→    for proposal in proposals:\n 112→        proposal = SemanticGroupingProposal.model_validate(proposal.model_dump(mode=\"json\"))\n 113→        for row_id, digest in zip(proposal.row_ids, proposal.row_digests, strict=True):\n 114→            if row_id in rows and semantic_row_digest(rows[row_id][0]) != digest:\n 115→                raise ValueError(\"语义提案观察摘要不一致，必须重新研究和复核\")\n 116→        if not set(proposal.row_ids).issubset(rows):\n 117→            continue  # Another physical page may own the other observation.\n 118→        if descriptive_only and proposal.compatible:\n 119→            raise ValueError(\"该域目前仅支持描述性展示，不能接受正向语义裁决提案\")\n 120→        key = frozenset(proposal.row_ids)\n 121→        if key in pairs:\n 122→            raise ValueError(\"同一观察对存在重复语义提案\")\n 123→        pairs[key] = proposal\n 124→\n 125→    def compatible(left_id: str, right_id: str) -> bool:\n 126→        proposal = pairs.get(frozenset((left_id, right_id)))\n 127→        if proposal is None:\n 128→            if origin[left_id] != origin[right_id]:\n 129→                return False\n 130→            if descriptive_only:\n 131→                return True\n 132→            left_row, right_row = rows[left_id][0], rows[right_id][0]\n 133→            if (left_row.get(\"trial_id\") and\n 134→                    left_row.get(\"trial_id\") == right_row.get(\"trial_id\") and\n 135→                    left_row.get(\"product_id\") == right_row.get(\"product_id\")):\n 136→                return True  # Within-trial longitudinal description, not cross-trial equivalence.\n 137→        elif not proposal.compatible:\n 138→            return False\n 139→        try:\n 140→            left, right = _observation(rows[left_id][0]), _observation(rows[right_id][0])\n 141→        except ValueError:\n 142→            return False\n 143→        if any(semantic_value_is_unknown(value) for value in (\n 144→            left.clinical_construct, left.definition, right.clinical_construct, right.definition,\n 145→        )):\n 146→            return False\n 147→        if proposal is None:\n 148→            return compare_clinical_constructs(left, right).compatible\n 149→        if left.timepoint_weeks != right.timepoint_weeks and not proposal.time_window_compatible:\n 150→            return False\n 151→        # Only wording is proposed equivalent. Original rows remain unchanged.\n 152→        right_for_guard = right.model_copy(update={\n 153→            \"clinical_construct\": left.clinical_construct, \"definition\": left.definition,\n 154→        })\n 155→        return compare_clinical_constructs(left, right_for_guard).compatible\n 156→\n 157→    groups: list[list[str]] = []\n 158→    for row_id in sorted(rows):\n 159→        for group in groups:\n 160→            if all(compatible(row_id, existing) for existing in group):\n 161→                group.append(row_id)\n 162→                break\n 163→        else:\n 164→            groups.append([row_id])\n 165→    return tuple(tuple(rows[row_id] for row_id in group) for group in groups)\n 166→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c8102c777dba04a50ce29adf759","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c8102c777dba04a50ce29adf759","codebuddy.ai/llmMessageId":"01a08c8102c777dba04a50ce29adf759","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:43.915Z"}
{"type":"user","uuid":"01a08c81-112c-7f8e-9986-5fd727fe5adc","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_s7euMg8BMOe6LbVO3gVO8bsf","content":[{"type":"text","text":"   1→\"\"\"独立科学复核签发入口：真实执行证据是 ``scientific-review-v1`` 回执的\n   2→唯一签发来源（Astra P1-1 裁决修复）。\n   3→\n   4→本入口供**独立复核宿主会话**（不得是生产者会话）重复调用：\n   5→\n   6→1. 绑定现有请求：只接受运行时发布的权威生产上下文\n   7→   （``reload_production_context``）与唯一科学复核请求\n   8→   （``state/scientific_review/<kind>/review_request.json``，含请求摘要\n   9→   核验）；请求与当前候选上下文不一致即拒绝；\n  10→2. 真实 reviewer/producer 分离：复核者身份、复核会话与请求中的生产者\n  11→   身份/会话逐字比较，相同即在**任何执行前**失败关闭；\n  12→3. runner/host 执行证据：``review.process`` 只能来自本入口真实启动的\n  13→   外部复核子进程（PID、完整 argv、起止时间、退出码、输出尾部），\n  14→   argv 必须以宿主可执行文件开头；宿主可执行文件不可用、进程失败退出、\n  15→   进程时间出现在未来（注入时钟裁决）一律拒绝签发；\n  16→4. 正式 verdict 字节：回执只绑定通过打包 Schema/模型/语义校验、且与\n  17→   当前权威上下文一致的接受结论实际文件字节（``accepted_verdict_from_receipt``\n  18→   复核结论绑定、时间窗与有效期）；\n  19→5. 真实签发记录：回执落盘的同时写入同源签发记录\n  20→   （``state/scientific_review/<kind>/issuance.json``，含记录摘要）；\n  21→   ``verify_receipt_issuance`` 把回执与记录逐字段交叉核验，只有自洽\n  22→   JSON、没有真实签发记录的伪造回执（含测试进程内手工构造的自洽回执）\n  23→   一律失败关闭。\n  24→\n  25→失败关闭边界：不引入 PKI、签名服务或第二套回执体系；签发记录复用既有\n  26→回执类型字段并按 ``hosts.receipt`` 同一规范化算法计算摘要。分层边界：\n  27→授权裁决仍属 ``qc.review_receipt`` 与 ``scientific_review_transition``；\n  28→本模块只做真实执行接线，绝不放宽任何既有授权门。\n  29→\"\"\"\n  30→\n  31→from __future__ import annotations\n  32→\n  33→import hashlib\n  34→import json\n  35→import os\n  36→import shutil\n  37→import subprocess\n  38→from collections.abc import Callable, Sequence\n  39→from dataclasses import dataclass\n  40→from datetime import UTC, datetime\n  41→from pathlib import Path, PurePosixPath\n  42→from typing import Any, Final\n  43→\n  44→from pydantic import ValidationError as PydanticValidationError\n  45→\n  46→from ci_workflow.application.scientific_review_transition import (\n  47→    ScientificReviewTransitionError,\n  48→    accepted_verdict_from_receipt,\n  49→    load_scientific_review_receipt,\n  50→    reload_production_context,\n  51→    scientific_review_receipt_path,\n  52→    scientific_review_request_path,\n  53→)\n  54→from ci_workflow.capabilities.scientific_qc import (\n  55→    ScientificQcBoundaryError,\n  56→    validate_scientific_qc_verdict_payload,\n  57→)\n  58→from ci_workflow.hosts.receipt import (\n  59→    HostExecutableEvidence as ReviewExecutableEvidence,\n  60→)\n  61→from ci_workflow.hosts.receipt import (\n  62→    HostProcessBinding as ReviewProcessEvidence,\n  63→)\n  64→from ci_workflow.hosts.receipt import (\n  65→    HostSessionBinding as ReviewHostSession,\n  66→)\n  67→from ci_workflow.qc.review_receipt import (\n  68→    ReviewArtifactBinding,\n  69→    ReviewContentBinding,\n  70→    ReviewContextEvidence,\n  71→    ReviewProductionContext,\n  72→    ReviewReceiptHost,\n  73→    ScientificReviewReceipt,\n  74→    build_scientific_review_receipt,\n  75→)\n  76→\n  77→REVIEW_ISSUANCE_RECORD_KIND: Final = \"scientific-review-issuance-v1\"\n  78→_DEFAULT_TIMEOUT_SECONDS: Final = 3600.0\n  79→_STDOUT_TAIL_CHARS: Final = 2000\n  80→_VERSION_PROBE_TIMEOUT_SECONDS: Final = 30.0\n  81→\n  82→ReviewClock = Callable[[], datetime]\n  83→\n  84→\n  85→class ReviewIssuanceError(ValueError):\n  86→    \"\"\"独立复核签发入口失败关闭：绑定、分离、执行或结论核验不通过。\"\"\"\n  87→\n  88→\n  89→@dataclass(frozen=True)\n  90→class ExternalProcessResult:\n  91→    \"\"\"一次真实外部进程运行的结果证据。\"\"\"\n  92→\n  93→    pid: int\n  94→    argv: tuple[str, ...]\n  95→    cwd: str\n  96→    started_at: datetime\n  97→    finished_at: datetime\n  98→    returncode: int\n  99→    stdout_tail: str = \"\"\n 100→    stderr_tail: str = \"\"\n 101→\n 102→\n 103→ReviewProcessRunner = Callable[[tuple[str, ...], str, float], ExternalProcessResult]\n 104→\n 105→\n 106→@dataclass(frozen=True)\n 107→class ReviewIssuanceOutcome:\n 108→    \"\"\"一次成功签发的回执与真实签发记录落盘位置。\"\"\"\n 109→\n 110→    receipt: ScientificReviewReceipt\n 111→    receipt_path: Path\n 112→    record_path: Path\n 113→\n 114→\n 115→def run_external_process(\n 116→    argv: tuple[str, ...], cwd: str, timeout: float\n 117→) -> ExternalProcessResult:\n 118→    \"\"\"生产运行器：真实启动外部复核子进程并捕获运行证据。\"\"\"\n 119→\n 120→    started_at = datetime.now(UTC)\n 121→    try:\n 122→        process = subprocess.Popen(\n 123→            argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE\n 124→        )\n 125→    except OSError as error:\n 126→        raise ReviewIssuanceError(f\"复核进程启动失败：{error}\") from error\n 127→    try:\n 128→        stdout, stderr = process.communicate(timeout=timeout)\n 129→    except subprocess.TimeoutExpired as error:\n 130→        process.kill()\n 131→        process.communicate()\n 132→        raise ReviewIssuanceError(\"复核进程超时未结束，拒绝签发\") from error\n 133→    finished_at = datetime.now(UTC)\n 134→    return ExternalProcessResult(\n 135→        pid=process.pid,\n 136→        argv=tuple(argv),\n 137→        cwd=cwd,\n 138→        started_at=started_at,\n 139→        finished_at=finished_at,\n 140→        returncode=process.returncode if process.returncode is not None else -1,\n 141→        stdout_tail=(stdout or b\"\").decode(\"utf-8\", errors=\"replace\")[\n 142→            -_STDOUT_TAIL_CHARS:\n 143→        ],\n 144→        stderr_tail=(stderr or b\"\").decode(\"utf-8\", errors=\"replace\")[\n 145→            -_STDOUT_TAIL_CHARS:\n 146→        ],\n 147→    )\n 148→\n 149→\n 150→def _system_clock() -> datetime:\n 151→    return datetime.now(UTC)\n 152→\n 153→\n 154→def _launcher_parent_pid(pid: int) -> int:\n 155→    try:\n 156→        output = subprocess.run(\n 157→            (\"ps\", \"-o\", \"ppid=\", \"-p\", str(pid)),\n 158→            capture_output=True,\n 159→            timeout=10.0,\n 160→            check=False,\n 161→        )\n 162→    except (subprocess.TimeoutExpired, OSError) as error:\n 163→        raise ReviewIssuanceError(f\"无法查询宿主会话启动进程的父进程：{error}\") from error\n 164→    if output.returncode != 0:\n 165→        raise ReviewIssuanceError(\"无法查询宿主会话启动进程的父进程（ps 失败）\")\n 166→    text = (output.stdout or b\"\").decode(\"utf-8\", errors=\"replace\").strip()\n 167→    if not text.isdigit() or int(text) < 1:\n 168→        raise ReviewIssuanceError(\"宿主会话启动进程的父进程标识无效\")\n 169→    return int(text)\n 170→\n 171→\n 172→def _current_host_session(session_id: str) -> ReviewHostSession:\n 173→    \"\"\"从当前进程推导宿主会话绑定：启动进程为本进程真实父进程。\"\"\"\n 174→\n 175→    launcher_pid = os.getppid()\n 176→    return ReviewHostSession(\n 177→        session_id=session_id,\n 178→        launcher_pid=launcher_pid,\n 179→        launcher_parent_pid=_launcher_parent_pid(launcher_pid),\n 180→    )\n 181→\n 182→\n 183→def _probe_version(executable: str, run: ReviewProcessRunner) -> str:\n 184→    result = run(\n 185→        (executable, \"--version\"), os.getcwd(), _VERSION_PROBE_TIMEOUT_SECONDS\n 186→    )\n 187→    if result.returncode != 0:\n 188→        raise ReviewIssuanceError(\n 189→            f\"宿主可执行文件版本探测失败（退出码 {result.returncode}）\"\n 190→        )\n 191→    lines = result.stdout_tail.strip().splitlines()\n 192→    if not lines or not lines[0].strip():\n 193→        raise ReviewIssuanceError(\"宿主可执行文件版本探测输出为空\")\n 194→    return lines[0].strip()\n 195→\n 196→\n 197→def resolve_host_executable(\n 198→    host: ReviewReceiptHost,\n 199→    *,\n 200→    explicit_path: str | None = None,\n 201→    runner: ReviewProcessRunner | None = None,\n 202→) -> ReviewExecutableEvidence:\n 203→    \"\"\"解析宿主可执行文件证据：显式路径或 PATH 真实解析，版本真实探测。\"\"\"\n 204→\n 205→    run = runner if runner is not None else run_external_process\n 206→    if explicit_path is not None:\n 207→        path = Path(explicit_path).expanduser()\n 208→        if not path.is_file():\n 209→            raise ReviewIssuanceError(f\"宿主可执行文件不存在：{explicit_path}\")\n 210→        resolved = str(path.resolve())\n 211→        return ReviewExecutableEvidence(\n 212→            provenance=\"explicit\",\n 213→            path=explicit_path,\n 214→            resolved_realpath=resolved,\n 215→            version=_probe_version(resolved, run),\n 216→        )\n 217→    discovered = shutil.which(host)\n 218→    if discovered is None:\n 219→        raise ReviewIssuanceError(\n 220→            f\"宿主可执行文件在 PATH 中不可用：{host}；无独立上下文能力，拒绝签发\"\n 221→        )\n 222→    resolved = str(Path(discovered).resolve())\n 223→    return ReviewExecutableEvidence(\n 224→        provenance=\"path_resolved\",\n 225→        path=discovered,\n 226→        resolved_realpath=resolved,\n 227→        version=_probe_version(resolved, run),\n 228→    )\n 229→\n 230→\n 231→def _validated_kind(report_kind: str) -> str:\n 232→    if report_kind not in (\"A\", \"B\", \"C\"):\n 233→        raise ReviewIssuanceError(\n 234→            f\"独立复核签发入口只适用于 A/B/C 类报告：{report_kind!r}\"\n 235→        )\n 236→    return report_kind\n 237→\n 238→\n 239→def _canonical_json_bytes(value: object) -> bytes:\n 240→    # 与 hosts.receipt / qc.review_receipt / scientific_review_transition\n 241→    # 同一规范化：排序键、紧凑分隔符、无结尾换行。\n 242→    return json.dumps(\n 243→        value,\n 244→        ensure_ascii=False,\n 245→        sort_keys=True,\n 246→        separators=(\",\", \":\"),\n 247→        allow_nan=False,\n 248→    ).encode(\"utf-8\")\n 249→\n 250→\n 251→def _body_digest(body: dict[str, Any]) -> str:\n 252→    return hashlib.sha256(_canonical_json_bytes(body) + b\"\\n\").hexdigest()\n 253→\n 254→\n 255→def _read_request_body(project_root: Path, kind: str) -> tuple[dict[str, Any], str]:\n 256→    path = project_root / scientific_review_request_path(kind)\n 257→    try:\n 258→        raw = json.loads(path.read_text(encoding=\"utf-8\"))\n 259→    except (OSError, json.JSONDecodeError) as error:\n 260→        raise ReviewIssuanceError(\"科学复核请求缺失或损坏，拒绝签发\") from error\n 261→    if not isinstance(raw, dict):\n 262→        raise ReviewIssuanceError(\"科学复核请求必须是 JSON 对象\")\n 263→    digest = raw.pop(\"request_digest\", None)\n 264→    body = {key: value for key, value in raw.items()}\n 265→    if not isinstance(digest, str) or digest != _body_digest(body):\n 266→        raise ReviewIssuanceError(\"科学复核请求摘要漂移：请求已被篡改或损坏\")\n 267→    return body, digest\n 268→\n 269→\n 270→def _load_published_request(\n 271→    project_root: Path,\n 272→    kind: str,\n 273→    context_digest: str,\n 274→) -> tuple[ReviewProductionContext, str, str]:\n 275→    body, digest = _read_request_body(project_root, kind)\n 276→    scientific_context = body.get(\"scientific_context\")\n 277→    if (\n 278→        not isinstance(scientific_context, dict)\n 279→        or scientific_context.get(\"context_digest\") != context_digest\n 280→    ):\n 281→        raise ReviewIssuanceError(\"科学复核请求不属于当前候选上下文，拒绝签发\")\n 282→    try:\n 283→        production = ReviewProductionContext.model_validate(body.get(\"production\"))\n 284→    except PydanticValidationError as error:\n 285→        raise ReviewIssuanceError(\"科学复核请求中的生产身份无效\") from error\n 286→    review_input_digest = body.get(\"review_input_digest\")\n 287→    if not isinstance(review_input_digest, str):\n 288→        raise ReviewIssuanceError(\"科学复核请求缺少审阅输入摘要\")\n 289→    return production, review_input_digest, digest\n 290→\n 291→\n 292→def review_issuance_record_path(report_kind: str) -> PurePosixPath:\n 293→    \"\"\"真实签发记录的确定性项目相对路径。\"\"\"\n 294→\n 295→    kind = _validated_kind(report_kind)\n 296→    return PurePosixPath(\"state\") / \"scientific_review\" / kind / \"issuance.json\"\n 297→\n 298→\n 299→def _bind_formal_verdict(\n 300→    project_root: Path, verdict_relative_path: str\n 301→) -> ReviewArtifactBinding:\n 302→    pure = PurePosixPath(verdict_relative_path)\n 303→    if (\n 304→        pure.is_absolute()\n 305→        or \"..\" in pure.parts\n 306→        or \"\\\\\" in verdict_relative_path\n 307→        or verdict_relative_path == \".\"\n 308→    ):\n 309→        raise ReviewIssuanceError(\"复核结论路径必须是项目内 POSIX 相对路径\")\n 310→    path = project_root / pure\n 311→    if not path.is_file():\n 312→        raise ReviewIssuanceError(f\"复核结论产物不存在：{verdict_relative_path}\")\n 313→    try:\n 314→        raw = json.loads(path.read_text(encoding=\"utf-8\"))\n 315→    except (OSError, json.JSONDecodeError) as error:\n 316→        raise ReviewIssuanceError(\"复核结论产物不可读或不是有效 JSON\") from error\n 317→    if not isinstance(raw, dict):\n 318→        raise ReviewIssuanceError(\"复核结论产物必须是 JSON 对象\")\n 319→    try:\n 320→        validate_scientific_qc_verdict_payload(raw)\n 321→    except ScientificQcBoundaryError as error:\n 322→        raise ReviewIssuanceError(f\"正式质控结论验证失败：{error}\") from error\n 323→    return ReviewArtifactBinding(\n 324→        artifact_kind=\"scientific_qc_verdict\",\n 325→        path=verdict_relative_path,\n 326→        artifact_sha256=hashlib.sha256(path.read_bytes()).hexdigest(),\n 327→    )\n 328→\n 329→\n 330→def issue_review_receipt(\n 331→    *,\n 332→    project_root: Path,\n 333→    report_kind: str,\n 334→    reviewer_id: str,\n 335→    review_session_id: str,\n 336→    host: ReviewReceiptHost,\n 337→    host_executable: ReviewExecutableEvidence,\n 338→    review_argv: Sequence[str],\n 339→    verdict_relative_path: str,\n 340→    session: ReviewHostSession | None = None,\n 341→    runner: ReviewProcessRunner | None = None,\n 342→    clock: ReviewClock | None = None,\n 343→) -> ReviewIssuanceOutcome:\n 344→    \"\"\"运行真实独立复核进程并签发绑定现有请求的正式回执（唯一签发入口）。\n 345→\n 346→    ``runner``/``clock``/``session`` 是测试 seam；生产路径必须使用默认\n 347→    真实实现。任何绑定、分离、执行、结论或落盘前核验失败都不产生回执。\n 348→    \"\"\"\n 349→\n 350→    kind = _validated_kind(report_kind)\n 351→    run = runner if runner is not None else run_external_process\n 352→    now = clock if clock is not None else _system_clock\n 353→    root = project_root.expanduser().resolve()\n 354→\n 355→    try:\n 356→        context = reload_production_context(root, kind)\n 357→    except ScientificReviewTransitionError as error:\n 358→        raise ReviewIssuanceError(f\"权威生产上下文未就绪：{error}\") from error\n 359→    production, review_input_digest, request_digest = _load_published_request(\n 360→        root, kind, context.context_digest\n 361→    )\n 362→\n 363→    if reviewer_id == production.producer_id:\n 364→        raise ReviewIssuanceError(\n 365→            \"复核者与生产者身份相同：生产者自审不构成独立复核，拒绝签发\"\n 366→        )\n 367→    if review_session_id == production.producer_session_id:\n 368→        raise ReviewIssuanceError(\n 369→            \"复核会话与生产者会话相同：同会话复核不构成独立上下文，拒绝签发\"\n 370→        )\n 371→    if session is not None and session.session_id != review_session_id:\n 372→        raise ReviewIssuanceError(\"复核会话标识与会话绑定不一致，拒绝签发\")\n 373→\n 374→    if host_executable.provenance == \"unavailable\" or not host_executable.path:\n 375→        raise ReviewIssuanceError(\"宿主可执行文件不可用：无独立上下文能力，拒绝签发\")\n 376→    argv = (host_executable.path, *(str(part) for part in review_argv))\n 377→    if len(argv) < 2:\n 378→        raise ReviewIssuanceError(\"请提供宿主可执行文件之后的复核命令参数\")\n 379→\n 380→    result = run(argv, str(root), _DEFAULT_TIMEOUT_SECONDS)\n 381→    issued_at = now()\n 382→    if result.returncode != 0:\n 383→        raise ReviewIssuanceError(\n 384→            f\"复核进程失败退出（退出码 {result.returncode}），拒绝签发\"\n 385→        )\n 386→    if result.started_at > issued_at or result.finished_at > issued_at:\n 387→        raise ReviewIssuanceError(\"复核进程时间出现在未来：拒绝签发\")\n 388→\n 389→    artifact = _bind_formal_verdict(root, verdict_relative_path)\n 390→    resolved_session = (\n 391→        session if session is not None else _current_host_session(review_session_id)\n 392→    )\n 393→    try:\n 394→        receipt = build_scientific_review_receipt(\n 395→            host=host,\n 396→            issued_at=issued_at,\n 397→            production=production,\n 398→            review=ReviewContextEvidence(\n 399→                reviewer_id=reviewer_id,\n 400→                host_executable=host_executable,\n 401→                session=resolved_session,\n 402→                process=ReviewProcessEvidence(\n 403→                    kind=\"external_subprocess\",\n 404→                    pid=result.pid,\n 405→                    argv=result.argv,\n 406→                    cwd=result.cwd,\n 407→                    started_at=result.started_at,\n 408→                    finished_at=result.finished_at,\n 409→                    returncode=result.returncode,\n 410→                    stdout_tail=result.stdout_tail,\n 411→                    stderr_tail=result.stderr_tail,\n 412→                ),\n 413→                independent_context=\"external_subprocess_session\",\n 414→            ),\n 415→            content=ReviewContentBinding(\n 416→                reviewed_content_digest=production.candidate_content_digest,\n 417→                review_input_digest=review_input_digest,\n 418→            ),\n 419→            artifact=artifact,\n 420→        )\n 421→    except (PydanticValidationError, ValueError) as error:\n 422→        raise ReviewIssuanceError(f\"独立复核回执构造被拒绝：{error}\") from error\n 423→\n 424→    try:\n 425→        accepted_verdict_from_receipt(project_root=root, context=context, receipt=receipt)\n 426→    except ScientificReviewTransitionError as error:\n 427→        raise ReviewIssuanceError(f\"复核结论不能授权签发：{error}\") from error\n 428→\n 429→    receipt_path = root / scientific_review_receipt_path(kind)\n 430→    receipt_path.parent.mkdir(parents=True, exist_ok=True)\n 431→    receipt_payload = receipt.model_dump(mode=\"json\")\n 432→    record: dict[str, Any] = {\n 433→        \"record_kind\": REVIEW_ISSUANCE_RECORD_KIND,\n 434→        \"report_kind\": kind,\n 435→        \"request_digest\": request_digest,\n 436→        \"receipt_digest\": receipt.receipt_digest,\n 437→        \"host\": receipt_payload[\"host\"],\n 438→        \"reviewer_id\": receipt_payload[\"review\"][\"reviewer_id\"],\n 439→        \"issued_at\": receipt_payload[\"issued_at\"],\n 440→        \"process\": receipt_payload[\"review\"][\"process\"],\n 441→        \"artifact\": receipt_payload[\"artifact\"],\n 442→    }\n 443→    record[\"record_digest\"] = _body_digest(record)\n 444→    record_path = root / review_issuance_record_path(kind)\n 445→    record_path.parent.mkdir(parents=True, exist_ok=True)\n 446→    record_path.write_bytes(_canonical_json_bytes(record) + b\"\\n\")\n 447→    receipt_path.write_bytes(_canonical_json_bytes(receipt_payload) + b\"\\n\")\n 448→    return ReviewIssuanceOutcome(\n 449→        receipt=receipt, receipt_path=receipt_path, record_path=record_path\n 450→    )\n 451→\n 452→\n 453→def verify_receipt_issuance(\n 454→    project_root: Path,\n 455→    report_kind: str,\n 456→    *,\n 457→    checked_at: datetime | None = None,\n 458→) -> ScientificReviewReceipt:\n 459→    \"\"\"授权前的真实签发核验：回执必须与真实签发记录逐字段一致。\n 460→\n 461→    只有自洽 JSON、没有真实签发记录；记录被篡改；回执在签发后被替换；\n 462→    请求已为其他候选重新发布——全部失败关闭。通过核验时返回完整验证的\n 463→    回执；调用方仍须执行 ``qc`` 层授权门与本项目的候选绑定核验。\n 464→    \"\"\"\n 465→\n 466→    kind = _validated_kind(report_kind)\n 467→    root = project_root.expanduser().resolve()\n 468→    record_path = root / review_issuance_record_path(kind)\n 469→    if not record_path.is_file():\n 470→        raise ReviewIssuanceError(\n 471→            \"真实签发记录缺失：只有自洽 JSON、没有经签发入口的回执不被接受\"\n 472→        )\n 473→    try:\n 474→        raw = json.loads(record_path.read_text(encoding=\"utf-8\"))\n 475→    except (OSError, json.JSONDecodeError) as error:\n 476→        raise ReviewIssuanceError(\"真实签发记录不可读或不是有效 JSON\") from error\n 477→    if not isinstance(raw, dict) or raw.get(\"record_kind\") != REVIEW_ISSUANCE_RECORD_KIND:\n 478→        raise ReviewIssuanceError(\"真实签发记录类别无效\")\n 479→    digest = raw.pop(\"record_digest\", None)\n 480→    body = {key: value for key, value in raw.items()}\n 481→    if not isinstance(digest, str) or digest != _body_digest(body):\n 482→        raise ReviewIssuanceError(\"真实签发记录摘要漂移：记录已被篡改或损坏\")\n 483→\n 484→    _, current_request_digest = _read_request_body(root, kind)\n 485→    if raw.get(\"request_digest\") != current_request_digest:\n 486→        raise ReviewIssuanceError(\"签发记录不属于当前候选的科学复核请求\")\n 487→\n 488→    try:\n 489→        receipt = load_scientific_review_receipt(root, kind)\n 490→    except ScientificReviewTransitionError as error:\n 491→        raise ReviewIssuanceError(f\"回执验证失败：{error}\") from error\n 492→    payload = receipt.model_dump(mode=\"json\")\n 493→    expected: tuple[tuple[str, object], ...] = (\n 494→        (\"receipt_digest\", receipt.receipt_digest),\n 495→        (\"report_kind\", kind),\n 496→        (\"host\", payload[\"host\"]),\n 497→        (\"reviewer_id\", payload[\"review\"][\"reviewer_id\"]),\n 498→        (\"issued_at\", payload[\"issued_at\"]),\n 499→        (\"process\", payload[\"review\"][\"process\"]),\n 500→        (\"artifact\", payload[\"artifact\"]),\n 501→    )\n 502→    for field, value in expected:\n 503→        if raw.get(field) != value:\n 504→            raise ReviewIssuanceError(\n 505→                f\"真实签发记录与回执的 {field} 不一致：回执可能已被替换\"\n 506→            )\n 507→    verified_at = _system_clock() if checked_at is None else checked_at\n 508→    if verified_at.tzinfo is None or verified_at.utcoffset() is None:\n 509→        raise ReviewIssuanceError(\"签发核验时间必须包含明确时区\")\n 510→    if verified_at < receipt.issued_at:\n 511→        raise ReviewIssuanceError(\"签发核验时间早于回执签发时间\")\n 512→    context = reload_production_context(root, kind)\n 513→    try:\n 514→        verdict = accepted_verdict_from_receipt(\n 515→            project_root=root, context=context, receipt=receipt\n 516→        )\n 517→    except ScientificReviewTransitionError as error:\n 518→        raise ReviewIssuanceError(f\"回执不能授权当前候选：{error}\") from error\n 519→    if verdict.valid_until <= verified_at:\n 520→        raise ReviewIssuanceError(\"科学质控接受结论在签发核验时已失效\")\n 521→    return receipt\n 522→\n 523→\n 524→__all__ = [\n 525→    \"ExternalProcessResult\",\n 526→    \"ReviewClock\",\n 527→    \"ReviewIssuanceError\",\n 528→    \"ReviewIssuanceOutcome\",\n 529→    \"ReviewProcessRunner\",\n 530→    \"issue_review_receipt\",\n 531→    \"resolve_host_executable\",\n 532→    \"review_issuance_record_path\",\n 533→    \"run_external_process\",\n 534→    \"verify_receipt_issuance\",\n 535→]\n 536→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c8102c777dba04a50ce29adf759","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c8102c777dba04a50ce29adf759","codebuddy.ai/llmMessageId":"01a08c8102c777dba04a50ce29adf759","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:43.916Z"}
{"type":"user","uuid":"01a08c81-112d-7fe1-81bf-de81ce43ae08","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_dSceXCr7lxBIA995RU8ceHQq","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→from datetime import datetime\n   4→from enum import StrEnum\n   5→from pathlib import Path\n   6→from typing import Literal, cast\n   7→\n   8→import yaml\n   9→from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator\n  10→\n  11→\n  12→class ClaimDomain(StrEnum):\n  13→    DRUG_IDENTITY_MECHANISM = \"drug_identity_mechanism\"\n  14→    TRIAL_IDENTITY_DESIGN_STATUS = \"trial_identity_design_status\"\n  15→    EFFICACY_SAFETY_RESULTS = \"efficacy_safety_results\"\n  16→    BASELINE_DISPOSITION = \"baseline_disposition\"\n  17→    REGULATORY_DEVELOPMENT_STATUS = \"regulatory_development_status\"\n  18→    CHINA_DEVELOPMENT_REGULATORY_STATUS = (\n  19→        \"china_development_regulatory_status\"\n  20→    )\n  21→    COMPANY_RELATIONSHIPS_TRANSACTIONS = (\n  22→        \"company_relationships_transactions\"\n  23→    )\n  24→    PATENTS_PROTECTION = \"patents_protection\"\n  25→\n  26→\n  27→class SourceAuthority(StrEnum):\n  28→    DIRECT = \"direct\"\n  29→    CROSS_CHECK = \"cross_check\"\n  30→    LEAD_ONLY = \"lead_only\"\n  31→    NOT_APPLICABLE = \"not_applicable\"\n  32→\n  33→\n  34→class SourceApplicability(StrEnum):\n  35→    APPLICABLE = \"applicable\"\n  36→    NOT_APPLICABLE = \"not_applicable\"\n  37→    ACCESS_BLOCKED = \"access_blocked\"\n  38→\n  39→\n  40→class SourceEligibility(BaseModel):\n  41→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  42→\n  43→    schema_version: Literal[\"1.0\"]\n  44→    source_eligibility_id: str\n  45→    route_id: str\n  46→    strategy_unit_id: str\n  47→    entity_id: str\n  48→    gap_id: str\n  49→    claim_domain: ClaimDomain\n  50→    applicability: SourceApplicability\n  51→    required_by_policy: bool\n  52→    rationale_zh: str\n  53→    policy_id: str\n  54→    policy_version: str\n  55→    evidence_fragment_ids: tuple[str, ...] = Field(min_length=1)\n  56→    decided_by: str\n  57→    decided_at: datetime\n  58→\n  59→    @field_validator(\n  60→        \"source_eligibility_id\",\n  61→        \"route_id\",\n  62→        \"strategy_unit_id\",\n  63→        \"entity_id\",\n  64→        \"gap_id\",\n  65→        \"rationale_zh\",\n  66→        \"policy_id\",\n  67→        \"policy_version\",\n  68→        \"decided_by\",\n  69→    )\n  70→    @classmethod\n  71→    def _required_text_is_not_blank(cls, value: str) -> str:\n  72→        normalized = \" \".join(value.split())\n  73→        if not normalized:\n  74→            raise ValueError(\"来源适用性字段不能为空\")\n  75→        return normalized\n  76→\n  77→    @field_validator(\"evidence_fragment_ids\")\n  78→    @classmethod\n  79→    def _evidence_ids_are_unique(cls, values: tuple[str, ...]) -> tuple[str, ...]:\n  80→        if len(set(values)) != len(values) or any(not item.strip() for item in values):\n  81→            raise ValueError(\"来源适用性证据必须非空且不重复\")\n  82→        return values\n  83→\n  84→    @field_validator(\"decided_at\")\n  85→    @classmethod\n  86→    def _decision_time_has_offset(cls, value: datetime) -> datetime:\n  87→        if value.tzinfo is None or value.utcoffset() is None:\n  88→            raise ValueError(\"来源适用性决定时间必须包含时区\")\n  89→        return value\n  90→\n  91→\n  92→class SourceDefinition(BaseModel):\n  93→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  94→\n  95→    source_id: str = Field(min_length=1)\n  96→    label_zh: str = Field(min_length=1)\n  97→    required_global_baseline: bool\n  98→    required_for_china: bool\n  99→    authoritative_secondary: bool\n 100→    authorities: dict[ClaimDomain, SourceAuthority]\n 101→\n 102→    @model_validator(mode=\"after\")\n 103→    def _all_claim_domains_are_explicit(self) -> SourceDefinition:\n 104→        if set(self.authorities) != set(ClaimDomain):\n 105→            raise ValueError(\"每个来源必须明确覆盖全部声明域\")\n 106→        return self\n 107→\n 108→\n 109→class SourcePolicy(BaseModel):\n 110→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 111→\n 112→    schema_version: str\n 113→    policy_id: str\n 114→    version: str\n 115→    claim_domains: tuple[ClaimDomain, ...]\n 116→    sources: tuple[SourceDefinition, ...]\n 117→\n 118→    @model_validator(mode=\"after\")\n 119→    def _matrix_is_complete_and_unique(self) -> SourcePolicy:\n 120→        if set(self.claim_domains) != set(ClaimDomain):\n 121→            raise ValueError(\"来源策略声明域矩阵不完整\")\n 122→        if len(set(self.claim_domains)) != len(self.claim_domains):\n 123→            raise ValueError(\"来源策略声明域不得重复\")\n 124→        source_ids = tuple(item.source_id for item in self.sources)\n 125→        if len(set(source_ids)) != len(source_ids):\n 126→            raise ValueError(\"来源策略标识不得重复\")\n 127→        return self\n 128→\n 129→    @classmethod\n 130→    def from_yaml(cls, path: Path) -> SourcePolicy:\n 131→        try:\n 132→            payload = yaml.safe_load(path.read_text(encoding=\"utf-8\"))\n 133→        except (OSError, yaml.YAMLError) as error:\n 134→            raise ValueError(\"无法读取来源策略\") from error\n 135→        if not isinstance(payload, dict):\n 136→            raise ValueError(\"来源策略顶层必须是对象\")\n 137→        return cls.model_validate(cast(dict[str, object], payload))\n 138→\n 139→    def source(self, source_id: str) -> SourceDefinition:\n 140→        matches = tuple(item for item in self.sources if item.source_id == source_id)\n 141→        if len(matches) != 1:\n 142→            raise KeyError(f\"未找到唯一来源：{source_id}\")\n 143→        return matches[0]\n 144→\n 145→    def authority_for(\n 146→        self, source_id: str, claim_domain: ClaimDomain\n 147→    ) -> SourceAuthority:\n 148→        return self.source(source_id).authorities[claim_domain]\n 149→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c8102c777dba04a50ce29adf759","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c8102c777dba04a50ce29adf759","codebuddy.ai/llmMessageId":"01a08c8102c777dba04a50ce29adf759","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:43.918Z"}
{"type":"user","uuid":"01a08c81-1131-70cf-9984-321450b1c72f","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_j9eHyMZRksPuIzeccAYvI95R","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→from datetime import datetime, timedelta\n   4→from enum import StrEnum\n   5→\n   6→from pydantic import BaseModel, ConfigDict, Field\n   7→\n   8→from ci_workflow.domain.evidence import SourceVersionRecord\n   9→from ci_workflow.sources.receipts import EvidenceAuditBundle, RouteAttemptResult\n  10→from ci_workflow.sources.retries import RecoveryExhaustionProof\n  11→\n  12→\n  13→class RouteCompletionState(StrEnum):\n  14→    COMPLETED = \"route_completed\"\n  15→    NOT_APPLICABLE = \"route_not_applicable\"\n  16→    ACCESS_BLOCKED = \"route_access_blocked\"\n  17→\n  18→\n  19→class RouteCompletion(BaseModel):\n  20→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  21→\n  22→    state: RouteCompletionState\n  23→    rationale_zh: str = Field(min_length=1)\n  24→    completed_strategy_unit_ids: tuple[str, ...] = Field(min_length=1)\n  25→\n  26→\n  27→class RouteProgress(BaseModel):\n  28→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  29→\n  30→    route_id: str = Field(min_length=1)\n  31→    attempts: tuple[RouteAttemptResult, ...] = ()\n  32→    completion: RouteCompletion | None = None\n  33→\n  34→    @property\n  35→    def is_complete(self) -> bool:\n  36→        return self.completion is not None\n  37→\n  38→    def record_attempt(self, attempt: RouteAttemptResult) -> RouteProgress:\n  39→        if self.completion is not None:\n  40→            raise ValueError(\"已完成路线不能追加尝试\")\n  41→        if attempt.attempt_id in {item.attempt_id for item in self.attempts}:\n  42→            raise ValueError(\"路线尝试标识不得重复\")\n  43→        return self.model_copy(update={\"attempts\": (*self.attempts, attempt)})\n  44→\n  45→    def complete(\n  46→        self,\n  47→        completion: RouteCompletion,\n  48→        *,\n  49→        audit_bundle: EvidenceAuditBundle,\n  50→        recovery_exhaustion: RecoveryExhaustionProof | None = None,\n  51→    ) -> RouteProgress:\n  52→        if self.completion is not None:\n  53→            raise ValueError(\"路线完成状态不得重复写入\")\n  54→        audit_bundle.assert_supports(\n  55→            route_id=self.route_id,\n  56→            completion_state=completion.state.value,\n  57→            completed_strategy_unit_ids=completion.completed_strategy_unit_ids,\n  58→        )\n  59→        receipts_by_id = {\n  60→            item.receipt_id: item for item in audit_bundle.source_receipts\n  61→        }\n  62→        attempts_by_id = {item.attempt_id: item for item in self.attempts}\n  63→        if set(receipts_by_id) != set(attempts_by_id):\n  64→            raise ValueError(\"路线尝试与来源审计回执必须逐条对应\")\n  65→        for receipt_id, receipt in receipts_by_id.items():\n  66→            attempt = attempts_by_id[receipt_id]\n  67→            if (\n  68→                attempt.strategy_unit_id,\n  69→                attempt.entity_id,\n  70→                attempt.gap_id,\n  71→                attempt.claim_domain,\n  72→                attempt.result_class.value,\n  73→            ) != (\n  74→                receipt.strategy_unit_id,\n  75→                receipt.entity_id,\n  76→                receipt.gap_id,\n  77→                receipt.claim_domain,\n  78→                receipt.result_class,\n  79→            ):\n  80→                raise ValueError(\"路线尝试内容与来源审计回执不一致\")\n  81→        if completion.state is RouteCompletionState.COMPLETED:\n  82→            final_receipts = tuple(\n  83→                max(\n  84→                    (\n  85→                        receipt\n  86→                        for receipt in audit_bundle.source_receipts\n  87→                        if receipt.strategy_unit_id == strategy_unit_id\n  88→                    ),\n  89→                    key=lambda receipt: receipt.attempt_index,\n  90→                )\n  91→                for strategy_unit_id in completion.completed_strategy_unit_ids\n  92→            )\n  93→            if any(item.result_class == \"not_found\" for item in final_receipts):\n  94→                if recovery_exhaustion is None:\n  95→                    raise ValueError(\"未找到适格内容前必须完成恢复与科学穷尽\")\n  96→                first = final_receipts[0]\n  97→                expected_context = (\n  98→                    self.route_id,\n  99→                    first.entity_id,\n 100→                    first.gap_id,\n 101→                    first.claim_domain,\n 102→                )\n 103→                if recovery_exhaustion.execution_context != expected_context:\n 104→                    raise ValueError(\"路线终态与恢复穷尽证据不属于同一任务语境\")\n 105→                if not recovery_exhaustion.completed_strategy_unit_ids <= set(\n 106→                    audit_bundle.evidence_gap.completed_strategies\n 107→                ):\n 108→                    raise ValueError(\"恢复穷尽策略未完整写入证据缺口审计\")\n 109→        elif recovery_exhaustion is not None:\n 110→            raise ValueError(\"非科学性未找到终态不得附加恢复穷尽证据\")\n 111→        return self.model_copy(update={\"completion\": completion})\n 112→\n 113→\n 114→class HistoricalCutoffState(StrEnum):\n 115→    SNAPSHOT_ELIGIBLE = \"snapshot_eligible\"\n 116→    REFRESH_CANDIDATE = \"refresh_candidate\"\n 117→    BLOCKED_UNKNOWN_DISCLOSURE = \"blocked_unknown_disclosure\"\n 118→    BLOCKED_AMBIGUOUS_DISCLOSURE_DAY = \"blocked_ambiguous_disclosure_day\"\n 119→\n 120→\n 121→class HistoricalCutoffAssessment(BaseModel):\n 122→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 123→\n 124→    source_version_id: str\n 125→    state: HistoricalCutoffState\n 126→    can_enter_snapshot: bool\n 127→    refresh_candidate: bool\n 128→    recovery_required: bool\n 129→    rationale_zh: str\n 130→\n 131→\n 132→def assess_historical_source(\n 133→    source: SourceVersionRecord, *, cutoff: datetime, key_evidence: bool\n 134→) -> HistoricalCutoffAssessment:\n 135→    if cutoff.tzinfo is None or cutoff.utcoffset() is None:\n 136→        raise ValueError(\"历史截止日必须包含明确时区\")\n 137→    disclosed = source.first_disclosed_at\n 138→    if (\n 139→        disclosed.state == \"reported\"\n 140→        and disclosed.value is not None\n 141→        and disclosed.precision == \"calendar_day\"\n 142→    ):\n 143→        day_start = disclosed.value\n 144→        next_day = day_start + timedelta(days=1)\n 145→        if cutoff < day_start:\n 146→            return HistoricalCutoffAssessment(\n 147→                source_version_id=source.source_version_id,\n 148→                state=HistoricalCutoffState.REFRESH_CANDIDATE,\n 149→                can_enter_snapshot=False,\n 150→                refresh_candidate=True,\n 151→                recovery_required=False,\n 152→                rationale_zh=\"首次披露自然日晚于历史截止时点，仅进入后续刷新候选\",\n 153→            )\n 154→        if cutoff < next_day - timedelta(microseconds=1):\n 155→            return HistoricalCutoffAssessment(\n 156→                source_version_id=source.source_version_id,\n 157→                state=HistoricalCutoffState.BLOCKED_AMBIGUOUS_DISCLOSURE_DAY,\n 158→                can_enter_snapshot=False,\n 159→                refresh_candidate=False,\n 160→                recovery_required=key_evidence,\n 161→                rationale_zh=\"来源只公开首次披露自然日，当前截止时点位于该日内，无法证明先后顺序\",\n 162→            )\n 163→    if (\n 164→        disclosed.state == \"reported\"\n 165→        and disclosed.value is not None\n 166→        and disclosed.value <= cutoff\n 167→    ):\n 168→        return HistoricalCutoffAssessment(\n 169→            source_version_id=source.source_version_id,\n 170→            state=HistoricalCutoffState.SNAPSHOT_ELIGIBLE,\n 171→            can_enter_snapshot=True,\n 172→            refresh_candidate=False,\n 173→            recovery_required=False,\n 174→            rationale_zh=\"首次披露时间不晚于历史截止日，可进入当前快照\",\n 175→        )\n 176→    if (\n 177→        disclosed.state == \"reported\"\n 178→        and disclosed.value is not None\n 179→        and disclosed.value > cutoff\n 180→    ):\n 181→        return HistoricalCutoffAssessment(\n 182→            source_version_id=source.source_version_id,\n 183→            state=HistoricalCutoffState.REFRESH_CANDIDATE,\n 184→            can_enter_snapshot=False,\n 185→            refresh_candidate=True,\n 186→            recovery_required=False,\n 187→            rationale_zh=\"首次披露时间晚于历史截止日，仅进入后续刷新候选\",\n 188→        )\n 189→    return HistoricalCutoffAssessment(\n 190→        source_version_id=source.source_version_id,\n 191→        state=HistoricalCutoffState.BLOCKED_UNKNOWN_DISCLOSURE,\n 192→        can_enter_snapshot=False,\n 193→        refresh_candidate=False,\n 194→        recovery_required=key_evidence,\n 195→        rationale_zh=(\n 196→            \"关键证据的首次披露时间尚未解决，不能进入当前历史快照\"\n 197→            if key_evidence\n 198→            else \"首次披露时间尚未解决，当前历史快照不采用该来源\"\n 199→        ),\n 200→    )\n 201→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c8102c777dba04a50ce29adf759","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c8102c777dba04a50ce29adf759","codebuddy.ai/llmMessageId":"01a08c8102c777dba04a50ce29adf759","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:07:43.921Z"}
