{"type":"user","uuid":"01a08c80-ed35-71cf-8e81-66947f40f8f2","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_01a08c80ebf872a38b72774a","content":[{"type":"text","text":"   1→\"\"\"Portal builder: typed page specs → deterministic physical HTML files.\n   2→\n   3→Produces a complete static portal directory with:\n   4→  - Shared assets (CSS, JS, SVG logo)\n   5→  - One ``<slug>.html`` per ``PageSpec``\n   6→  - ``search-index.js`` for global search\n   7→\n   8→Assets resolve from the packaged module tree first (wheel-safe), then from\n   9→the repository ``assets/`` tree in editable source checkouts.  The builder\n  10→never fetches remote resources.  Output is ``file://``-safe.\n  11→\"\"\"\n  12→\n  13→from __future__ import annotations\n  14→\n  15→import hashlib\n  16→import shutil\n  17→from pathlib import Path\n  18→from typing import Any, cast\n  19→\n  20→from pydantic import BaseModel, Field, field_validator, model_validator\n  21→\n  22→from ci_workflow.renderers.portal.global_search import SearchIndexEntry, build_search_index\n  23→from ci_workflow.renderers.portal.page_shell import render_page_html, render_search_index_json\n  24→\n  25→# ---------------------------------------------------------------------------\n  26→# Public types\n  27→# ---------------------------------------------------------------------------\n  28→\n  29→_MAX_REPORT_TITLE_CHARS = 24\n  30→\n  31→\n  32→class NavEntry(BaseModel):\n  33→    \"\"\"One leaf navigation link (used when flat nav is explicitly supplied).\"\"\"\n  34→\n  35→    label: str = Field(..., description=\"Chinese navigation label, e.g. 首页\")\n  36→    slug: str = Field(\n  37→        ...,\n  38→        description=\"Target page slug (matches PageSpec.slug)\",\n  39→        pattern=r\"^[a-z0-9][a-z0-9-]*$\",\n  40→    )\n  41→    group: str = Field(\n  42→        default=\"\",\n  43→        description=\"Optional Chinese navigation group label\",\n  44→    )\n  45→\n  46→\n  47→class PageSpec(BaseModel):\n  48→    \"\"\"Typed specification for a single physical portal page.\"\"\"\n  49→\n  50→    slug: str = Field(\n  51→        ...,\n  52→        description=\"Page slug used as filename: <slug>.html\",\n  53→        pattern=r\"^[a-z0-9][a-z0-9-]*$\",\n  54→    )\n  55→    title: str = Field(..., description=\"Page title shown in <title> and h1\")\n  56→    nav_label: str = Field(..., description=\"Label in header navigation\")\n  57→    nav_group: str = Field(\n  58→        default=\"\",\n  59→        description=\"Chinese navigation group, e.g. 基线与人群\",\n  60→    )\n  61→    sections: list[str] = Field(\n  62→        default_factory=list,\n  63→        description=\"Section headings rendered as reading-path cards\",\n  64→    )\n  65→    body_text: str = Field(\n  66→        default=\"\",\n  67→        description=\"Page summary shown immediately under the title\",\n  68→    )\n  69→\n  70→\n  71→class PortalSpec(BaseModel):\n  72→    \"\"\"Complete portal specification: pages, navigation, metadata.\"\"\"\n  73→\n  74→    title: str = Field(..., description=\"Report title shown in header\")\n  75→    pages: list[PageSpec] = Field(..., min_length=1)\n  76→    nav: list[NavEntry] = Field(default_factory=list)\n  77→    footer_text: str = Field(\n  78→        default=\"仅供产品中心医学部内部研判使用。\",\n  79→        description=\"Quiet footer disclaimer for medical readers\",\n  80→    )\n  81→\n  82→    @field_validator(\"title\")\n  83→    @classmethod\n  84→    def _title_must_be_concise(cls, value: str) -> str:\n  85→        normalized = \" \".join(value.split())\n  86→        if not normalized:\n  87→            raise ValueError(\"报告标题不能为空\")\n  88→        if len(normalized) > _MAX_REPORT_TITLE_CHARS:\n  89→            raise ValueError(\n  90→                f\"报告标题过长（{len(normalized)}字），请缩短为\"\n  91→                f\"不超过{_MAX_REPORT_TITLE_CHARS}个字的简洁中文标题\"\n  92→            )\n  93→        return normalized\n  94→\n  95→    @model_validator(mode=\"after\")\n  96→    def _default_nav_from_pages(self) -> PortalSpec:\n  97→        if not self.nav:\n  98→            self.nav = [\n  99→                NavEntry(\n 100→                    label=page.nav_label,\n 101→                    slug=page.slug,\n 102→                    group=page.nav_group or page.nav_label,\n 103→                )\n 104→                for page in self.pages\n 105→            ]\n 106→        return self\n 107→\n 108→\n 109→class PortalBuildError(RuntimeError):\n 110→    \"\"\"Raised when the builder encounters an invalid spec or I/O failure.\"\"\"\n 111→\n 112→\n 113→# ---------------------------------------------------------------------------\n 114→# Asset resolution (wheel-safe)\n 115→# ---------------------------------------------------------------------------\n 116→\n 117→_MODULE_DIR = Path(__file__).resolve().parent\n 118→_MODULE_ASSETS_DIR = _MODULE_DIR / \"assets\"\n 119→_OFFICIAL_LOGO_SHA256 = \"8d16d3ae8353dd31f46a50d401e66f9e62af40be6cc42cdf5050866a4e6e1cae\"\n 120→_ECHARTS_BUNDLE_SHA256 = \"b66b25aeb4df84e33199dc21694014d336d222cbd9deb0e5a7c14bd6aa0d0fd0\"\n 121→_ECHARTS_BUNDLE_NAME = \"echarts.min.js\"\n 122→\n 123→\n 124→def _sha256(path: Path) -> str:\n 125→    digest = hashlib.sha256()\n 126→    with path.open(\"rb\") as handle:\n 127→        for chunk in iter(lambda: handle.read(65536), b\"\"):\n 128→            digest.update(chunk)\n 129→    return digest.hexdigest()\n 130→\n 131→\n 132→def _repo_assets_root() -> Path | None:\n 133→    \"\"\"Best-effort repository ``assets/`` root for editable checkouts.\"\"\"\n 134→    candidate = _MODULE_DIR.parents[3] / \"assets\"\n 135→    if candidate.is_dir():\n 136→        return candidate\n 137→    for parent in _MODULE_DIR.parents:\n 138→        assets = parent / \"assets\"\n 139→        if (assets / \"portal\").is_dir() and (assets / \"brand\").is_dir():\n 140→            return assets\n 141→    return None\n 142→\n 143→\n 144→def resolve_portal_asset(name: str) -> Path:\n 145→    \"\"\"Resolve a portal static asset for copy into a generated site.\"\"\"\n 146→    module_candidate = _MODULE_ASSETS_DIR / name\n 147→    if module_candidate.is_file():\n 148→        return module_candidate\n 149→\n 150→    repo_assets = _repo_assets_root()\n 151→    if repo_assets is not None:\n 152→        if name in {\n 153→            \"portal.css\",\n 154→            \"portal.js\",\n 155→            \"charts.js\",\n 156→            \"evidence-drawer.css\",\n 157→            \"evidence-drawer.js\",\n 158→        }:\n 159→            repo_candidate = repo_assets / \"portal\" / name\n 160→            if repo_candidate.is_file():\n 161→                return repo_candidate\n 162→        if name in {\"cms-logo.svg\", \"logo.svg\"}:\n 163→            brand = repo_assets / \"brand\" / \"cms-logo.svg\"\n 164→            if brand.is_file():\n 165→                return brand\n 166→\n 167→    raise PortalBuildError(\n 168→        f\"Portal asset '{name}' not found in packaged module assets \"\n 169→        f\"({_MODULE_ASSETS_DIR}) or repository assets tree\"\n 170→    )\n 171→\n 172→\n 173→def resolve_echarts_bundle() -> Path:\n 174→    \"\"\"Resolve offline ECharts 6.1.0 bundle (wheel-safe; no silent repo fallback).\n 175→\n 176→    Fail-closed if the packaged module asset is missing or digest mismatches.\n 177→    Repository ``assets/third-party/echarts/`` is never used as a silent runtime path.\n 178→    \"\"\"\n 179→    candidate = _MODULE_ASSETS_DIR / _ECHARTS_BUNDLE_NAME\n 180→    if not candidate.is_file():\n 181→        raise PortalBuildError(\n 182→            \"包内缺少 ECharts 离线包（失败关闭）：\"\n 183→            f\"{candidate}。请将 assets/third-party/echarts/echarts.min.js \"\n 184→            \"以可测试资源合同复制到 src/ci_workflow/renderers/portal/assets/\"\n 185→        )\n 186→    digest = _sha256(candidate)\n 187→    if digest != _ECHARTS_BUNDLE_SHA256:\n 188→        raise PortalBuildError(f\"ECharts 包摘要不匹配：{digest} != {_ECHARTS_BUNDLE_SHA256}\")\n 189→    return candidate\n 190→\n 191→\n 192→def resolve_logo_src() -> Path:\n 193→    \"\"\"Return the official CMS logo path and verify its digest.\"\"\"\n 194→    for name in (\"cms-logo.svg\", \"logo.svg\"):\n 195→        try:\n 196→            logo = resolve_portal_asset(name)\n 197→        except PortalBuildError:\n 198→            continue\n 199→        digest = _sha256(logo)\n 200→        if digest != _OFFICIAL_LOGO_SHA256:\n 201→            raise PortalBuildError(\n 202→                f\"Logo digest mismatch for {logo}: {digest} != {_OFFICIAL_LOGO_SHA256}\"\n 203→            )\n 204→        return logo\n 205→    raise PortalBuildError(\"Official CMS logo asset not found\")\n 206→\n 207→\n 208→def _copy_asset(src: Path, dest_dir: Path, name: str) -> Path:\n 209→    dest = dest_dir / name\n 210→    shutil.copy2(src, dest)\n 211→    return dest\n 212→\n 213→\n 214→# ---------------------------------------------------------------------------\n 215→# Builder\n 216→# ---------------------------------------------------------------------------\n 217→\n 218→\n 219→def build_portal(spec: PortalSpec, output_dir: Path) -> list[Path]:\n 220→    \"\"\"Build the complete portal into *output_dir*.\n 221→\n 222→    Returns the list of generated HTML file paths in page order.\n 223→    \"\"\"\n 224→    page_slugs = {page.slug for page in spec.pages}\n 225→    if len(page_slugs) != len(spec.pages):\n 226→        raise PortalBuildError(\"Page slugs must be unique\")\n 227→    nav_slugs = [nav.slug for nav in spec.nav]\n 228→    if len(nav_slugs) != len(set(nav_slugs)):\n 229→        raise PortalBuildError(\"导航项存在重复页面\")\n 230→    if set(nav_slugs) != page_slugs:\n 231→        raise PortalBuildError(\"导航必须覆盖全部页面且不得引用未知页面\")\n 232→    for nav in spec.nav:\n 233→        if nav.slug not in page_slugs:\n 234→            raise PortalBuildError(\n 235→                f\"Nav entry '{nav.label}' references slug '{nav.slug}' \"\n 236→                f\"which is not in the page list\"\n 237→            )\n 238→\n 239→    output_dir.mkdir(parents=True, exist_ok=True)\n 240→    assets_dir = output_dir / \"assets\"\n 241→    assets_dir.mkdir(parents=True, exist_ok=True)\n 242→\n 243→    logo_src = resolve_logo_src()\n 244→    _copy_asset(logo_src, assets_dir, \"logo.svg\")\n 245→    _copy_asset(resolve_portal_asset(\"portal.css\"), assets_dir, \"portal.css\")\n 246→    _copy_asset(resolve_portal_asset(\"portal.js\"), assets_dir, \"portal.js\")\n 247→    _copy_asset(resolve_portal_asset(\"charts.js\"), assets_dir, \"charts.js\")\n 248→    _copy_asset(resolve_portal_asset(\"evidence-drawer.css\"), assets_dir, \"evidence-drawer.css\")\n 249→    _copy_asset(resolve_portal_asset(\"evidence-drawer.js\"), assets_dir, \"evidence-drawer.js\")\n 250→    _copy_asset(resolve_echarts_bundle(), assets_dir, _ECHARTS_BUNDLE_NAME)\n 251→\n 252→    search_entries: list[SearchIndexEntry] = build_search_index(spec.pages)\n 253→    search_index_js = render_search_index_json(search_entries)\n 254→    (assets_dir / \"search-index.js\").write_text(search_index_js, encoding=\"utf-8\")\n 255→\n 256→    generated: list[Path] = []\n 257→    for page in spec.pages:\n 258→        html = render_page_html(\n 259→            page=page,\n 260→            spec=cast(Any, spec),\n 261→            assets_rel=\"assets\",\n 262→        )\n 263→        html_path = output_dir / f\"{page.slug}.html\"\n 264→        html_path.write_text(html, encoding=\"utf-8\")\n 265→        generated.append(html_path)\n 266→\n 267→    return generated\n 268→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_01_Lu0OJcaEYTbMXclQKXlC2249","_requestId":"01a08c80d69378c3a0a9754f180e6443","_messageId":"01a08c80e64672868600a926453b07b1","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d69378c3a0a9754f180e6443","codebuddy.ai/modelRequestId":"01a08c80e64672868600a926453b07b1","codebuddy.ai/llmMessageId":"01a08c80e64672868600a926453b07b1","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-