{"type":"user","uuid":"01a08c81-23db-7bce-b11d-2f3f2a2f6e26","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_0jWhrc5mtAzkB5jHKly8a0CT","content":[{"type":"text","text":"   1→from __future__ import annotations\n   2→\n   3→import copy\n   4→import json\n   5→import re\n   6→from collections.abc import Iterator, Mapping\n   7→from datetime import datetime\n   8→from typing import Any, Literal\n   9→from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit\n  10→\n  11→from pydantic import BaseModel, ConfigDict, field_validator, model_validator\n  12→\n  13→from ci_workflow.domain.evidence import EvidenceLocator\n  14→from ci_workflow.domain.ids import stable_id\n  15→\n  16→_NCT_ID = re.compile(r\"NCT[0-9]{8}\")\n  17→\n  18→\n  19→def _offset_datetime(value: str) -> datetime:\n  20→    parsed = datetime.fromisoformat(value)\n  21→    if parsed.tzinfo is None or parsed.utcoffset() is None:\n  22→        raise ValueError(\"采集时间必须包含明确时区\")\n  23→    return parsed\n  24→\n  25→\n  26→def _required(mapping: Mapping[str, Any], key: str, *, path: str) -> Any:\n  27→    if key not in mapping:\n  28→        raise ValueError(f\"ClinicalTrials.gov 记录缺少字段：{path}.{key}\")\n  29→    return mapping[key]\n  30→\n  31→\n  32→def _mapping(value: Any, *, path: str) -> Mapping[str, Any]:\n  33→    if not isinstance(value, Mapping):\n  34→        raise ValueError(f\"ClinicalTrials.gov 字段必须是对象：{path}\")\n  35→    return value\n  36→\n  37→\n  38→def _normalized_nct_id(value: Any) -> str:\n  39→    normalized = str(value).strip().upper()\n  40→    if _NCT_ID.fullmatch(normalized) is None:\n  41→        raise ValueError(\"ClinicalTrials.gov 记录缺少有效 NCT 号\")\n  42→    return normalized\n  43→\n  44→\n  45→def _scientific_record_digest_input(study: Mapping[str, Any]) -> str:\n  46→    \"\"\"Exclude the daily platform holder while retaining the scientific record.\"\"\"\n  47→    scientific = copy.deepcopy(dict(study))\n  48→    derived = scientific.get(\"derivedSection\")\n  49→    if isinstance(derived, dict):\n  50→        misc = derived.get(\"miscInfoModule\")\n  51→        if isinstance(misc, dict):\n  52→            misc.pop(\"versionHolder\", None)\n  53→    return json.dumps(scientific, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"))\n  54→\n  55→\n  56→class ClinicalTrialsGovStudyVersion(BaseModel):\n  57→    \"\"\"一个 NCT 来源身份下的不可变登记内容版本。\"\"\"\n  58→\n  59→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  60→\n  61→    nct_id: str\n  62→    source_study_id: str\n  63→    source_version_id: str\n  64→    title: str\n  65→    registry_posted_version_date: str\n  66→    platform_version_holder: str\n  67→    acquired_at: datetime\n  68→    record_url: str\n  69→    history_url: str\n  70→    raw_record_json: str\n  71→\n  72→    @field_validator(\"acquired_at\")\n  73→    @classmethod\n  74→    def _acquired_at_has_offset(cls, value: datetime) -> datetime:\n  75→        if value.tzinfo is None or value.utcoffset() is None:\n  76→            raise ValueError(\"采集时间必须包含明确时区\")\n  77→        return value\n  78→\n  79→    @property\n  80→    def raw_record(self) -> dict[str, Any]:\n  81→        parsed = json.loads(self.raw_record_json)\n  82→        return dict(_mapping(parsed, path=\"stored ClinicalTrials.gov record\"))\n  83→\n  84→    @classmethod\n  85→    def from_api_record(\n  86→        cls, record: Mapping[str, Any], *, acquired_at: str\n  87→    ) -> ClinicalTrialsGovStudyVersion:\n  88→        protocol = _mapping(\n  89→            _required(record, \"protocolSection\", path=\"study\"),\n  90→            path=\"study.protocolSection\",\n  91→        )\n  92→        identification = _mapping(\n  93→            _required(protocol, \"identificationModule\", path=\"study.protocolSection\"),\n  94→            path=\"study.protocolSection.identificationModule\",\n  95→        )\n  96→        status = _mapping(\n  97→            _required(protocol, \"statusModule\", path=\"study.protocolSection\"),\n  98→            path=\"study.protocolSection.statusModule\",\n  99→        )\n 100→        last_update = _mapping(\n 101→            _required(\n 102→                status,\n 103→                \"lastUpdatePostDateStruct\",\n 104→                path=\"study.protocolSection.statusModule\",\n 105→            ),\n 106→            path=\"study.protocolSection.statusModule.lastUpdatePostDateStruct\",\n 107→        )\n 108→        derived = _mapping(\n 109→            _required(record, \"derivedSection\", path=\"study\"),\n 110→            path=\"study.derivedSection\",\n 111→        )\n 112→        misc = _mapping(\n 113→            _required(derived, \"miscInfoModule\", path=\"study.derivedSection\"),\n 114→            path=\"study.derivedSection.miscInfoModule\",\n 115→        )\n 116→        nct_id = _normalized_nct_id(_required(identification, \"nctId\", path=\"identificationModule\"))\n 117→        title = str(\n 118→            identification.get(\"briefTitle\")\n 119→            or identification.get(\"officialTitle\")\n 120→            or nct_id\n 121→        ).strip()\n 122→        if not title:\n 123→            raise ValueError(\"ClinicalTrials.gov 记录缺少试验标题\")\n 124→        registry_version_date = str(\n 125→            _required(last_update, \"date\", path=\"lastUpdatePostDateStruct\")\n 126→        ).strip()\n 127→        holder = str(_required(misc, \"versionHolder\", path=\"miscInfoModule\")).strip()\n 128→        if not registry_version_date or not holder:\n 129→            raise ValueError(\"ClinicalTrials.gov 记录缺少版本日期\")\n 130→        digest_input = _scientific_record_digest_input(record)\n 131→        record_url = f\"https://clinicaltrials.gov/study/{nct_id}\"\n 132→        return cls(\n 133→            nct_id=nct_id,\n 134→            source_study_id=stable_id(\"source-study\", \"clinicaltrials.gov\", nct_id),\n 135→            source_version_id=stable_id(\n 136→                \"source-version\", \"clinicaltrials.gov\", nct_id, digest_input\n 137→            ),\n 138→            title=title,\n 139→            registry_posted_version_date=registry_version_date,\n 140→            platform_version_holder=holder,\n 141→            acquired_at=_offset_datetime(acquired_at),\n 142→            record_url=record_url,\n 143→            history_url=f\"{record_url}?tab=history\",\n 144→            raw_record_json=json.dumps(\n 145→                record,\n 146→                ensure_ascii=False,\n 147→                sort_keys=True,\n 148→                separators=(\",\", \":\"),\n 149→            ),\n 150→        )\n 151→\n 152→\n 153→class ClinicalTrialsGovCapture(BaseModel):\n 154→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 155→\n 156→    studies: tuple[ClinicalTrialsGovStudyVersion, ...]\n 157→    next_page_token: str | None = None\n 158→\n 159→    @classmethod\n 160→    def from_api_payload(\n 161→        cls, payload: Mapping[str, Any], *, acquired_at: str\n 162→    ) -> ClinicalTrialsGovCapture:\n 163→        raw_studies = _required(payload, \"studies\", path=\"response\")\n 164→        if not isinstance(raw_studies, list):\n 165→            raise ValueError(\"ClinicalTrials.gov studies 必须是列表\")\n 166→        token = payload.get(\"nextPageToken\")\n 167→        if token is not None and not str(token).strip():\n 168→            raise ValueError(\"ClinicalTrials.gov 下一页令牌不能为空\")\n 169→        return cls(\n 170→            studies=tuple(\n 171→                ClinicalTrialsGovStudyVersion.from_api_record(\n 172→                    _mapping(item, path=f\"studies[{index}]\"),\n 173→                    acquired_at=acquired_at,\n 174→                )\n 175→                for index, item in enumerate(raw_studies)\n 176→            ),\n 177→            next_page_token=None if token is None else str(token),\n 178→        )\n 179→\n 180→\n 181→class RegistryObservation(BaseModel):\n 182→    \"\"\"保留登记原值和 API 字段路径，不在连接器层解释临床含义。\"\"\"\n 183→\n 184→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 185→\n 186→    observation_id: str\n 187→    source_version_id: str\n 188→    nct_id: str\n 189→    claim_domain: Literal[\"trial_design\", \"trial_results\"]\n 190→    original_value: str | int | float | bool\n 191→    locator: EvidenceLocator\n 192→\n 193→\n 194→class PublicationCrossReference(BaseModel):\n 195→    \"\"\"登记平台提供的 NCT—PMID 边；论文角色留待论文分类器判定。\"\"\"\n 196→\n 197→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 198→\n 199→    edge_id: str\n 200→    source_version_id: str\n 201→    nct_id: str\n 202→    pmid: str\n 203→    platform_reference_type: str\n 204→    publication_role: Literal[\"unclassified\"] = \"unclassified\"\n 205→    citation: str | None\n 206→    citation_state: Literal[\"reported\", \"not_publicly_disclosed\"]\n 207→    locator: EvidenceLocator\n 208→\n 209→    @field_validator(\"pmid\")\n 210→    @classmethod\n 211→    def _pmid_is_numeric(cls, value: str) -> str:\n 212→        normalized = value.strip()\n 213→        if not normalized.isdigit():\n 214→            raise ValueError(\"PubMed 标识必须为数字\")\n 215→        return normalized\n 216→\n 217→    @field_validator(\"citation\")\n 218→    @classmethod\n 219→    def _citation_is_not_blank(cls, value: str | None) -> str | None:\n 220→        if value is None:\n 221→            return None\n 222→        normalized = \" \".join(value.split())\n 223→        if not normalized:\n 224→            raise ValueError(\"已披露引文不能为空\")\n 225→        return normalized\n 226→\n 227→    @model_validator(mode=\"after\")\n 228→    def _citation_state_matches_value(self) -> PublicationCrossReference:\n 229→        if self.citation_state == \"reported\" and self.citation is None:\n 230→            raise ValueError(\"已披露引文必须保留引文内容\")\n 231→        if self.citation_state == \"not_publicly_disclosed\" and self.citation is not None:\n 232→            raise ValueError(\"未提供引文时不得伪造引文内容\")\n 233→        return self\n 234→\n 235→\n 236→def _walk_leaves(value: Any, path: str) -> Iterator[tuple[str, str | int | float | bool]]:\n 237→    if isinstance(value, Mapping):\n 238→        for key, child in value.items():\n 239→            child_path = f\"{path}.{key}\" if path else str(key)\n 240→            yield from _walk_leaves(child, child_path)\n 241→        return\n 242→    if isinstance(value, list):\n 243→        for index, child in enumerate(value):\n 244→            yield from _walk_leaves(child, f\"{path}[{index}]\")\n 245→        return\n 246→    if isinstance(value, (str, int, float, bool)):\n 247→        yield path, value\n 248→\n 249→\n 250→def extract_registry_observations(\n 251→    study: ClinicalTrialsGovStudyVersion,\n 252→) -> tuple[RegistryObservation, ...]:\n 253→    selected_modules: tuple[tuple[str, Literal[\"trial_design\", \"trial_results\"]], ...] = (\n 254→        (\"protocolSection.designModule\", \"trial_design\"),\n 255→        (\"protocolSection.eligibilityModule\", \"trial_design\"),\n 256→        (\"protocolSection.armsInterventionsModule\", \"trial_design\"),\n 257→        (\"protocolSection.outcomesModule\", \"trial_design\"),\n 258→        (\"resultsSection\", \"trial_results\"),\n 259→    )\n 260→    observations: list[RegistryObservation] = []\n 261→    for prefix, claim_domain in selected_modules:\n 262→        current: Any = study.raw_record\n 263→        for part in prefix.split(\".\"):\n 264→            if not isinstance(current, Mapping) or part not in current:\n 265→                current = None\n 266→                break\n 267→            current = current[part]\n 268→        if current is None:\n 269→            continue\n 270→        for field_path, original_value in _walk_leaves(current, prefix):\n 271→            observations.append(\n 272→                RegistryObservation(\n 273→                    observation_id=stable_id(\n 274→                        \"registry-observation\",\n 275→                        study.source_version_id,\n 276→                        field_path,\n 277→                    ),\n 278→                    source_version_id=study.source_version_id,\n 279→                    nct_id=study.nct_id,\n 280→                    claim_domain=claim_domain,\n 281→                    original_value=original_value,\n 282→                    locator=EvidenceLocator(\n 283→                        document_role=\"ClinicalTrials.gov 登记记录\",\n 284→                        field_path=field_path,\n 285→                        url=study.record_url,\n 286→                    ),\n 287→                )\n 288→            )\n 289→    return tuple(observations)\n 290→\n 291→\n 292→def create_publication_cross_references(\n 293→    study: ClinicalTrialsGovStudyVersion,\n 294→) -> tuple[PublicationCrossReference, ...]:\n 295→    protocol = study.raw_record.get(\"protocolSection\", {})\n 296→    references_module = (\n 297→        protocol.get(\"referencesModule\", {}) if isinstance(protocol, Mapping) else {}\n 298→    )\n 299→    references = (\n 300→        references_module.get(\"references\", [])\n 301→        if isinstance(references_module, Mapping)\n 302→        else []\n 303→    )\n 304→    if not isinstance(references, list):\n 305→        raise ValueError(\"ClinicalTrials.gov references 必须是列表\")\n 306→    edges: list[PublicationCrossReference] = []\n 307→    for index, reference in enumerate(references):\n 308→        item = _mapping(reference, path=f\"references[{index}]\")\n 309→        pmid = item.get(\"pmid\")\n 310→        if pmid is None:\n 311→            continue\n 312→        reference_type = str(item.get(\"type\", \"UNSPECIFIED\")).strip()\n 313→        raw_citation = item.get(\"citation\")\n 314→        citation = None if raw_citation is None else str(raw_citation).strip() or None\n 315→        if not reference_type:\n 316→            raise ValueError(\"带 PMID 的登记引用必须保留引用类型\")\n 317→        normalized_pmid = str(pmid).strip()\n 318→        field_path = f\"protocolSection.referencesModule.references[{index}]\"\n 319→        edges.append(\n 320→            PublicationCrossReference(\n 321→                edge_id=stable_id(\n 322→                    \"publication-cross-reference\",\n 323→                    study.source_version_id,\n 324→                    normalized_pmid,\n 325→                    field_path,\n 326→                ),\n 327→                source_version_id=study.source_version_id,\n 328→                nct_id=study.nct_id,\n 329→                pmid=normalized_pmid,\n 330→                platform_reference_type=reference_type,\n 331→                citation=citation,\n 332→                citation_state=(\n 333→                    \"reported\" if citation is not None else \"not_publicly_disclosed\"\n 334→                ),\n 335→                locator=EvidenceLocator(\n 336→                    document_role=\"ClinicalTrials.gov 关联论文\",\n 337→                    field_path=field_path,\n 338→                    url=study.record_url,\n 339→                ),\n 340→            )\n 341→        )\n 342→    return tuple(edges)\n 343→\n 344→\n 345→def build_next_page_url(base_url: str, next_page_token: str) -> str:\n 346→    if not next_page_token.strip():\n 347→        raise ValueError(\"下一页令牌不能为空\")\n 348→    parts = urlsplit(base_url)\n 349→    query = parse_qsl(parts.query, keep_blank_values=True)\n 350→    query = [(key, value) for key, value in query if key != \"pageToken\"]\n 351→    query.append((\"pageToken\", next_page_token))\n 352→    return urlunsplit((parts.scheme, parts.netloc, parts.path, urlencode(query), parts.fragment))\n 353→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c81113375e5b5b01ad761ea95d2","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c81113375e5b5b01ad761ea95d2","codebuddy.ai/llmMessageId":"01a08c81113375e5b5b01ad761ea95d2","traceparent":"00-