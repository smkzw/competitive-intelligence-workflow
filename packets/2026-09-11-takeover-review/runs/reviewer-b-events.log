idenceObservationKind,\n  45→    EvidenceView,\n  46→    OriginalTextStatus,\n  47→)\n  48→from ci_workflow.reports.common.page_registry import PageRegistry, ReportCatalog, StaticPage\n  49→from ci_workflow.reports.common.view_state import ReportRow\n  50→from ci_workflow.storage.manifest_store import (\n  51→    ArtifactFileBinding,\n  52→    ArtifactManifest,\n  53→    DesignContractBinding,\n  54→    DeterministicCheck,\n  55→    RendererBinding,\n  56→    RenderVerdict,\n  57→)\n  58→from ci_workflow.storage.render_transaction import (\n  59→    RenderTransactionError,\n  60→    UnpublishedRenderTransaction,\n  61→)\n  62→from ci_workflow.storage.snapshot_store import (\n  63→    LockedSnapshot,\n  64→    ReportSnapshotManifest,\n  65→    SnapshotIntegrityError,\n  66→    SnapshotStore,\n  67→    compute_locked_snapshot,\n  68→)\n  69→\n  70→from .builder import resolve_echarts_bundle, resolve_logo_src, resolve_portal_asset\n  71→from .evidence_drawer import render_evidence_drawer_embed, render_evidence_drawer_host\n  72→from .report_a import EfficacyRow, ReportAPortalData, SafetyRow, TrialRow, _git_commit\n  73→\n  74→_TEMPLATE_DIR = Path(__file__).resolve().parent / \"templates\" / \"b\"\n  75→_ASSET_DIR = Path(__file__).resolve().parent / \"assets\"\n  76→\n  77→# B's static route authority is the frozen catalog.  The tuple below is only a\n  78→# dispatch map for page data; it intentionally contains no route strings.\n  79→_BASELINE_PAGE_IDS = frozenset(\n  80→    {\n  81→        \"baseline-overview\",\n  82→        \"baseline-demographics\",\n  83→        \"baseline-disease-context\",\n  84→        \"baseline-severity\",\n  85→    }\n  86→)\n  87→_BASELINE_PAGE_CONCEPTS: dict[str, frozenset[str]] = {\n  88→    \"baseline-demographics\": frozenset({\"age\", \"sex\"}),\n  89→    \"baseline-disease-context\": frozenset({\"disease_duration\"}),\n  90→    \"baseline-severity\": frozenset({\"baseline_easi\", \"baseline_hemoglobin\", \"baseline_ldh\"}),\n  91→}\n 