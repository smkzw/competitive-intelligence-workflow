{"type":"user","uuid":"01a08c81-71df-752e-92e8-d00347b2c0e2","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_p4fJfdpVQaAKR28zkCYyyJHN","content":[{"type":"text","text":"[\"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/__init__.py\",\"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/clinicaltrials_gov.py\",\"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/pubmed.py\",\"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/regulators.py\",\"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/company.py\",\"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/authoritative_wechat.py\",\"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/china_registries.py\",\"/Users/smkzw/Documents/AI Products/competitive-intelligence-workflow/src/ci_workflow/sources/connectors/ctgov_fetch.py\"]"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c8162fa7f92b3edb11c0a2fa93a","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c8162fa7f92b3edb11c0a2fa93a","codebuddy.ai/llmMessageId":"01a08c8162fa7f92b3edb11c0a2fa93a","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:08:08.672Z"}
{"type":"user","uuid":"01a08c81-71e1-7818-a4be-c9b204d51a6a","session_id":"01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6","message":{"content":[{"type":"tool_result","tool_use_id":"call_pjlu5c0gXHkSpoPge7G5VTZM","content":[{"type":"text","text":"   1→\"\"\"Bounded CT.gov v2 acquisition; pagination completion is not universe closure.\n   2→\n   3→This endpoint returns current records, not historical as-of reconstructions.\n   4→Official interface: https://clinicaltrials.gov/data-api/api\n   5→No cookies, authentication, alternate hosts or implicit retries are used.\n   6→\"\"\"\n   7→\n   8→from __future__ import annotations\n   9→\n  10→import json\n  11→from collections.abc import Callable\n  12→from dataclasses import dataclass\n  13→from datetime import UTC, date, datetime\n  14→from pathlib import Path\n  15→from typing import Any, Literal, Protocol\n  16→from urllib.error import HTTPError, URLError\n  17→from urllib.parse import parse_qs, urlencode, urlsplit\n  18→from urllib.request import HTTPRedirectHandler, Request, build_opener\n  19→\n  20→from pydantic import BaseModel, ConfigDict\n  21→\n  22→from ci_workflow.domain.evidence import ContentBlob, CtgovRecordSelector, SourceTextDerivation\n  23→from ci_workflow.sources.connectors.clinicaltrials_gov import (\n  24→    ClinicalTrialsGovCapture,\n  25→    ClinicalTrialsGovStudyVersion,\n  26→    build_next_page_url,\n  27→)\n  28→from ci_workflow.storage.content_store import ContentAddressedStore, ContentIntegrityError\n  29→from ci_workflow.storage.source_derivation import (\n  30→    SourceDerivationError,\n  31→    capture_source_text,\n  32→    source_json_decoder,\n  33→)\n  34→\n  35→API = \"https://clinicaltrials.gov/api/v2/studies\"\n  36→FetchStatus = Literal[\n  37→    \"complete\", \"no_records\", \"incomplete\", \"network_error\", \"rate_limited\",\n  38→    \"access_denied\", \"invalid_response\",\n  39→]\n  40→\n  41→\n  42→@dataclass(frozen=True)\n  43→class HttpPage:\n  44→    status: int\n  45→    content_type: str\n  46→    body: bytes\n  47→    final_url: str\n  48→\n  49→\n  50→class Transport(Protocol):\n  51→    def __call__(self, url: str, timeout: float, max_bytes: int) -> HttpPage: ...\n  52→\n  53→\n  54→class _NoRedirect(HTTPRedirectHandler):\n  55→    def redirect_request(\n  56→        self, req: Request, fp: Any, code: int, msg: str,\n  57→        headers: Any, newurl: str,\n  58→    ) -> None:\n  59→        return None\n  60→\n  61→\n  62→def _download(url: str, timeout: float, max_bytes: int) -> HttpPage:\n  63→    request = Request(url, headers={\n  64→        \"Accept\": \"application/json\", \"User-Agent\": \"CI-Workflow/1.4 public-research\",\n  65→    })\n  66→    try:\n  67→        with build_opener(_NoRedirect()).open(request, timeout=timeout) as response:\n  68→            return HttpPage(\n  69→                response.status, response.headers.get_content_type(),\n  70→                response.read(max_bytes + 1), response.geturl(),\n  71→            )\n  72→    except HTTPError as error:\n  73→        # Do not log or persist a server's error/authentication page.\n  74→        status = error.code\n  75→        error.close()\n  76→        return HttpPage(status, \"\", b\"\", url)\n  77→\n  78→\n  79→class CapturedPage(BaseModel):\n  80→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  81→    page_number: int\n  82→    request_url: str\n  83→    acquired_at: datetime\n  84→    raw_asset: ContentBlob\n  85→    study_ids: tuple[str, ...]\n  86→\n  87→\n  88→class CtgovFetchResult(BaseModel):\n  89→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n  90→    condition: str\n  91→    status: FetchStatus\n  92→    pagination_complete: bool\n  93→    universe_closed: Literal[False] = False\n  94→    temporal_scope: Literal[\"current_records\"] = \"current_records\"\n  95→    total_count: int | None\n  96→    studies: tuple[ClinicalTrialsGovStudyVersion, ...]\n  97→    pages: tuple[CapturedPage, ...]\n  98→    diagnostic: str\n  99→\n 100→\n 101→def fetch_ctgov_condition(\n 102→    project_root: Path,\n 103→    condition: str,\n 104→    *,\n 105→    page_size: int = 100,\n 106→    max_pages: int = 1000,\n 107→    timeout: float = 30,\n 108→    max_page_bytes: int = 20 * 1024 * 1024,\n 109→    max_total_bytes: int = 128 * 1024 * 1024,\n 110→    transport: Transport | None = None,\n 111→    clock: Callable[[], datetime] = lambda: datetime.now(UTC),\n 112→) -> CtgovFetchResult:\n 113→    \"\"\"Fetch every cursor page, retaining partial evidence on any failure.\n 114→\n 115→    Resource limits are failures, never Top-N success. Caller owns recovery,\n 116→    alias expansion, historical reconstruction and independent review.\n 117→    \"\"\"\n 118→    condition = condition.strip()\n 119→    if not condition or len(condition) > 4000 or any(ord(char) < 32 for char in condition):\n 120→        raise ValueError(\"检索条件必须是非空、有界的公开研究条件\")\n 121→    if not 1 <= page_size <= 1000 or max_pages < 1 or not 0 < timeout <= 60:\n 122→        raise ValueError(\"分页大小、页数或超时配置无效\")\n 123→    if max_page_bytes < 1 or max_total_bytes < 1:\n 124→        raise ValueError(\"获取字节预算必须为正\")\n 125→    url = API + \"?\" + urlencode({\n 126→        \"query.cond\": condition, \"format\": \"json\", \"pageSize\": page_size, \"countTotal\": \"true\",\n 127→    })\n 128→    download = transport or _download\n 129→    store = ContentAddressedStore(project_root)\n 130→    studies: dict[str, ClinicalTrialsGovStudyVersion] = {}\n 131→    pages: list[CapturedPage] = []\n 132→    tokens: set[str] = set()\n 133→    total: int | None = None\n 134→    platform_holder: str | None = None\n 135→    byte_count = 0\n 136→\n 137→    def finish(status: FetchStatus, diagnostic: str) -> CtgovFetchResult:\n 138→        return CtgovFetchResult(\n 139→            condition=condition, status=status,\n 140→            pagination_complete=status in {\"complete\", \"no_records\"},\n 141→            total_count=total, studies=tuple(studies.values()), pages=tuple(pages),\n 142→            diagnostic=diagnostic,\n 143→        )\n 144→\n 145→    for page_number in range(1, max_pages + 1):\n 146→        remaining = min(max_page_bytes, max_total_bytes - byte_count)\n 147→        if remaining <= 0:\n 148→            return finish(\"incomplete\", \"获取字节预算已耗尽；必须恢复，不能认定检索完成\")\n 149→        try:\n 150→            response = download(url, timeout, remaining)\n 151→        except (OSError, URLError, TimeoutError):\n 152→            return finish(\"network_error\", \"公开接口网络获取失败；不是无数据\")\n 153→        if response.status == 429:\n 154→            return finish(\"rate_limited\", \"接口限流；需按来源恢复策略重试\")\n 155→        if response.status in {401, 403}:\n 156→            return finish(\"access_denied\", \"公开接口拒绝访问；不能当作无记录\")\n 157→        if response.status >= 500:\n 158→            return finish(\"network_error\", \"来源服务暂不可用；不能当作无记录\")\n 159→        if response.status != 200 or response.final_url != url:\n 160→            return finish(\"invalid_response\", \"接口状态或重定向不符合限定来源合同\")\n 161→        if len(response.body) > remaining:\n 162→            return finish(\"incomplete\", \"响应超出获取预算；未保存截断正文\")\n 163→        if response.content_type.split(\";\", 1)[0].strip().lower() != \"application/json\":\n 164→            return finish(\"invalid_response\", \"来源未返回JSON；不接纳错误页作为临床数据\")\n 165→        acquired_at = clock()\n 166→        if acquired_at.tzinfo is None or acquired_at.utcoffset() is None:\n 167→            raise ValueError(\"获取时钟必须有明确时区\")\n 168→        try:\n 169→            payload = source_json_decoder().decode(response.body.decode(\"utf-8\"))\n 170→            if not isinstance(payload, dict):\n 171→                raise ValueError(\"response must be an object\")\n 172→            capture = ClinicalTrialsGovCapture.from_api_payload(\n 173→                payload, acquired_at=acquired_at.isoformat(),\n 174→            )\n 175→            # CT.gov returns countTotal on page one, omitting it on cursor pages.\n 176→            count = payload.get(\"totalCount\", total)\n 177→            if type(count) is not int or count < 0:\n 178→                raise ValueError(\"countTotal response must contain a nonnegative totalCount\")\n 179→            token = payload.get(\"nextPageToken\")\n 180→            if token is not None and (not isinstance(token, str) or not token.strip()):\n 181→                raise ValueError(\"cursor must be a nonempty string\")\n 182→        except (ValueError, TypeError, UnicodeError, RecursionError):\n 183→            return finish(\"invalid_response\", \"来源JSON缺少有效记录、计数或分页字段\")\n 184→        raw = store.put_bytes(response.body, media_type=\"application/json\")\n 185→        pages.append(CapturedPage(\n 186→            page_number=page_number, request_url=url, acquired_at=acquired_at,\n 187→            raw_asset=raw, study_ids=tuple(study.nct_id for study in capture.studies),\n 188→        ))\n 189→        byte_count += len(response.body)\n 190→        if total is not None and total != count:\n 191→            return finish(\"incomplete\", \"分页期间来源总量变化，需重新核查集合\")\n 192→        total = count\n 193→        for study in capture.studies:\n 194→            if platform_holder is not None and platform_holder != study.platform_version_holder:\n 195→                return finish(\"incomplete\", \"分页期间登记平台版本变化；需重新获取一致集合\")\n 196→            platform_holder = study.platform_version_holder\n 197→            previous = studies.get(study.nct_id)\n 198→            if previous is not None and previous.source_version_id != study.source_version_id:\n 199→                return finish(\"incomplete\", \"分页期间同一登记记录发生版本冲突\")\n 200→            studies[study.nct_id] = study\n 201→        if capture.next_page_token is None:\n 202→            if len(studies) != total:\n 203→                return finish(\"incomplete\", \"终页唯一登记数与来源声明总数不一致\")\n 204→            return finish(\n 205→                \"complete\" if studies else \"no_records\", \"当前查询分页已核对；非竞品宇宙闭包\",\n 206→            )\n 207→        if capture.next_page_token in tokens:\n 208→            return finish(\"incomplete\", \"重复分页游标；防止循环及虚假完成\")\n 209→        tokens.add(capture.next_page_token)\n 210→        url = build_next_page_url(url, capture.next_page_token)\n 211→    return finish(\"incomplete\", \"页数预算已耗尽；保留部分证据并等待恢复\")\n 212→\n 213→\n 214→class DerivedCtgovStudy(BaseModel):\n 215→    model_config = ConfigDict(extra=\"forbid\", frozen=True)\n 216→    nct_id: str\n 217→    title: str\n 218→    record_url: str\n 219→    registry_posted_version_date: str\n 220→    registry_posted_date_precision: Literal[\"calendar_day\"] = \"calendar_day\"\n 221→    temporal_scope: Literal[\"current_record\"] = \"current_record\"\n 222→    acquired_at: datetime\n 223→    content_text: str\n 224→    text_derivation: SourceTextDerivation\n 225→\n 226→\n 227→def derive_ctgov_records(\n 228→    project_root: Path, result: CtgovFetchResult,\n 229→) -> tuple[DerivedCtgovStudy, ...]:\n 230→    \"\"\"Reopen the whole cursor chain, then extract exact per-record JSON slices.\n 231→\n 232→    Publication-date precision is retained; no midnight instant is invented.\n 233→    This does not assign scientific claims, approve a report, or close a universe.\n 234→    \"\"\"\n 235→    if not result.pagination_complete or result.status not in {\"complete\", \"no_records\"}:\n 236→        raise SourceDerivationError(\"分页尚未完成；原始部分证据保留但不能晋级完整记录集\")\n 237→    if not result.pages:\n 238→        raise SourceDerivationError(\"获取结果没有可重开的原始响应\")\n 239→    store = ContentAddressedStore(project_root)\n 240→    page_index = 0\n 241→\n 242→    def replay(url: str, timeout: float, max_bytes: int) -> HttpPage:\n 243→        nonlocal page_index\n 244→        if page_index >= len(result.pages):\n 245→            raise SourceDerivationError(\"原始分页链尚未到终页\")\n 246→        page = result.pages[page_index]\n 247→        page_index += 1\n 248→        if page.request_url != url or page.page_number != page_index:\n 249→            raise SourceDerivationError(\"分页请求条件或顺序与回执不一致\")\n 250→        return HttpPage(200, page.raw_asset.media_type, store.read_bytes(page.raw_asset), url)\n 251→\n 252→    try:\n 253→        query = parse_qs(urlsplit(result.pages[0].request_url).query)\n 254→        size = query.get(\"pageSize\", [])\n 255→        if len(size) != 1:\n 256→            raise SourceDerivationError(\"获取回执缺少唯一分页大小\")\n 257→        verified = fetch_ctgov_condition(\n 258→            project_root, result.condition, page_size=int(size[0]),\n 259→            max_pages=len(result.pages), transport=replay,\n 260→            clock=lambda: result.pages[page_index - 1].acquired_at,\n 261→        )\n 262→        if (\n 263→            page_index != len(result.pages) or not verified.pagination_complete\n 264→            or verified.status != result.status or verified.total_count != result.total_count\n 265→            or verified.studies != result.studies or verified.pages != result.pages\n 266→        ):\n 267→            raise SourceDerivationError(\"获取回执与实际原始响应、版本或总量不一致\")\n 268→        records: dict[str, DerivedCtgovStudy] = {}\n 269→        for page in verified.pages:\n 270→            raw = store.read_bytes(page.raw_asset)\n 271→            capture = ClinicalTrialsGovCapture.from_api_payload(\n 272→                json.loads(raw), acquired_at=page.acquired_at.isoformat(),\n 273→            )\n 274→            for index, study in enumerate(capture.studies):\n 275→                date.fromisoformat(study.registry_posted_version_date)\n 276→                text, receipt = capture_source_text(\n 277→                    project_root, raw, media_type=\"application/json\",\n 278→                    record_selector=CtgovRecordSelector(study_index=index, nct_id=study.nct_id),\n 279→                )\n 280→                records[study.nct_id] = DerivedCtgovStudy(\n 281→                    nct_id=study.nct_id, title=study.title, record_url=study.record_url,\n 282→                    registry_posted_version_date=study.registry_posted_version_date,\n 283→                    acquired_at=study.acquired_at, content_text=text, text_derivation=receipt,\n 284→                )\n 285→        return tuple(records.values())\n 286→    except (OSError, ContentIntegrityError, ValueError) as error:\n 287→        raise SourceDerivationError(\"原始分页证据无法支持当前记录集投影\") from error\n 288→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_02_7faHW2LQzop1uyMQUW6r9666","_requestId":"01a08c80d6917d96bda67b4c7a4cb76d","_messageId":"01a08c8162fa7f92b3edb11c0a2fa93a","_meta":{"codebuddy.ai/conversationRequestId":"01a08c80d6917d96bda67b4c7a4cb76d","codebuddy.ai/modelRequestId":"01a08c8162fa7f92b3edb11c0a2fa93a","codebuddy.ai/llmMessageId":"01a08c8162fa7f92b3edb11c0a2fa93a","traceparent":"00-a4b4af999c08dd6458b96ec034bb4fe0-e2f7c4948accacf5-01","baggage":"codebuddy.session_id=01a08c80-51fc-7e4d-8c44-75c5d8fe8dd6,codebuddy.conversation_request_id=01a08c8052637ef99d54eb1364f5e9f1"},"__timestamp":"2026-09-10T18:08:08.673Z"}
