{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"jq '.studies[] | select(.protocolSection.identificationModule.nctId==\\\"NCT01335165\\\") | {identification:.protocolSection.identificationModule,arms:.protocolSection.armsInterventionsModule,design:.protocolSection.designModule,desc:.protocolSection.descriptionModule}' .artifacts/source-cas/ctgov-live-20260906/evidence/raw/sha256/c3/c3bdbe61b97e175e0a312cb37be064d3a74c38ada1c02dfde33e4e61a46fbdf3.bin\"","aggregated_output":"{\n  \"identification\": {\n    \"nctId\": \"NCT01335165\",\n    \"orgStudyIdInfo\": {\n      \"id\": \"TT30-PNH-002\"\n    },\n    \"organization\": {\n      \"fullName\": \"Alexion Pharmaceuticals, Inc.\",\n      \"class\": \"INDUSTRY\"\n    },\n    \"briefTitle\": \"Safety and Pharmacokinetics of TT30 in Subjects With Paroxysmal Nocturnal Hemoglobinuria (PNH)\",\n    \"officialTitle\": \"A Phase 1, Single Ascending Dose Study of the Safety and Pharmacokinetics of TT30 in Subjects With Paroxysmal Nocturnal Hemoglobinuria (PNH)\"\n  },\n  \"arms\": {\n    \"armGroups\": [\n      {\n        \"label\": \"TT30 (ALXN1102 Formulation)\",\n        \"type\": \"EXPERIMENTAL\",\n        \"description\": \"IV: 0.1, 0.3, and 1.0 mg/kg\",\n        \"interventionNames\": [\n          \"Drug: ALXN1102\"\n        ]\n      },\n      {\n        \"label\": \"TT30 (ALXN1103 Formulation)\",\n        \"type\": \"EXPERIMENTAL\",\n        \"description\": \"IV: 3.0, 6.0, and 10.0 mg/kg\\n\\nSC: 1.0 and 3.0 mg/kg\",\n        \"interventionNames\": [\n          \"Drug: ALXN1103\"\n        ]\n      }\n    ],\n    \"interventions\": [\n      {\n        \"type\": \"DRUG\",\n        \"name\": \"ALXN1102\",\n        \"description\": \"Single Ascending Dose IV\",\n        \"armGroupLabels\": [\n          \"TT30 (ALXN1102 Formulation)\"\n        ]\n      },\n      {\n        \"type\": \"DRUG\",\n        \"name\": \"ALXN1103\",\n        \"description\": \"Single Ascending Dose IV or SC\",\n        \"armGroupLabels\": [\n          \"TT30 (ALXN1103 Formulation)\"\n        ]\n      }\n    ]\n  },\n  \"design\": {\n    \"studyType\": \"INTERVENTIONAL\",\n    \"phases\": [\n      \"PHASE1\"\n    ],\n    \"designInfo\": {\n      \"allocation\": \"NON_RANDOMIZED\",\n      \"interventionModel\": \"PARALLEL\",\n      \"primaryPurpose\": \"TREATMENT\",\n      \"maskingInfo\": {\n        \"masking\": \"NONE\"\n      }\n    },\n    \"enrollmentInfo\": {\n      \"count\": 10,\n      \"type\": \"ACTUAL\"\n    }\n  },\n  \"desc\": {\n    \"briefSummary\": \"The purpose of this research study is to understand the safety, pharmacokinetics and pharmacodynamics of a single dose of TT30 (ALXN1102 and ALXN1103 formulations) when given IV (through a vein) or SC (under the skin) to patients with PNH.\",\n    \"detailedDescription\": \"This is an open-label, single-dose, dose-escalation study to assess the safety, tolerability, PK, PD, and immunogenicity of TT30 given as an IV infusion and as a SC injection in subjects with PNH or evidence of circulating PNH cells.\\n\\nEligible subjects with PNH will be vaccinated with meningococcal vaccine at least two weeks prior to dosing (if not previously vaccinated or if revaccination is required).\\n\\nOn study day 1, the subject will receive the single dose of TT30 as an IV infusion over 60 minutes or as a SC injection, and be followed with additional study evaluations over the next 59 days.\"\n  }\n}\n","exit_code":0,"status":"completed"}}
