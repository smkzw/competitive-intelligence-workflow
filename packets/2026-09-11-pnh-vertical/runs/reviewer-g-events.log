ducts\"]),\"payload trials\",len(payload[\"trials\"])); print(\"MULTI\");\nfor pid,d in sorted(by.items()):\n pp=next((x for x in payload[\"products\"] if x[\"id\"]==pid),{});\n if len(d[\"statuses\"])>1 or len(d[\"phases\"])>1: print(pid,\"|\",d[\"name\"],\"| n=\",len(d[\"ncts\"]),\"| phases=\",sorted(d[\"phases\"]),\"| statuses=\",sorted(d[\"statuses\"]),\"| payload=\",pp.get(\"phase\"),pp.get(\"status\")); print(\"NONDRUG\");\nfor pid,d in sorted(by.items()):\n if not any(\"DRUG\" in t.upper() for t in d[\"types\"]): print(pid,\"|\",d[\"name\"],\"| types=\",sorted(d[\"types\"]),\"| n=\",len(d[\"ncts\"])); entered={x[\"product_id\"] for x in payload[\"trials\"]}; print(\"NO TRIAL\");\nfor x in payload[\"products\"]:\n if x[\"id\"] not in entered: print(x[\"id\"],x[\"name\"])'\"'\"","aggregated_output":"raw studies 189 raw products 109 payload products 109 payload trials 184\nMULTI\nadx-038 | ADX-038 | n= 1 | phases= ['II期', 'I期'] | statuses= ['招募中'] | payload= I/II期 招募中\nNONDRUG\naln-cc5 | ALN-CC5 | n= 1 | phases= ['II期', 'I期'] | statuses= ['已完成'] | payload= I/II期 已完成\nNONDRUG\naln-cfb | ALN-CFB | n= 1 | phases= ['II期', 'I期'] | statuses= ['招募中'] | payload= I/II期 招募中\nNONDRUG\nalxn1210 | ALXN1210 | n= 1 | phases= ['II期', 'I期'] | statuses= ['已完成'] | payload= I/II期 已完成\nNONDRUG\nbcx9930 | BCX9930 | n= 3 | phases= ['II期', 'I期'] | statuses= ['已完成', '已终止'] | payload= II期 已完成\nNONDRUG\ncrovalimab | Crovalimab | n= 4 | phases= ['III期', 'II期', 'I期'] | statuses= ['已完成', '进行中（不招募）'] | payload= III期 进行中（不招募）\nNONDRUG\ncyclophosphamide | Cyclophosphamide | n= 3 | phases= ['II期'] | statuses= ['已完成', '已终止', '招募中'] | payload= II期 已完成\nNONDRUG\ndanicopan | Danicopan | n= 8 | phases= ['III期', 'II期'] | statuses= ['可用', '已完成', '招募中', '进行中（不招募）'] | payload= III期 已完成\nNONDRUG\neculizumab | Eculizumab | n= 14 | phases= ['III期', 'II期', 'IV期'] | statuses= ['已完成', '已批准上市', '已终止'] | payload= IV期 已完成\nNONDRUG\nfludarabine-phosphate | fludarabine phosphate | n= 2 | phases= ['II期', '未分期'] | st