ource_locator\": {\n      \"page_sha256\": \"1e0a9bbe959e38c122c9894782ff56b4ae3dc566179d199108c0af64eb56ab98\",\n      \"array_index\": 1,\n      \"nct_id\": \"NCT01174108\"\n    }\n  }\n]\n","exit_code":0,"status":"completed"}}
