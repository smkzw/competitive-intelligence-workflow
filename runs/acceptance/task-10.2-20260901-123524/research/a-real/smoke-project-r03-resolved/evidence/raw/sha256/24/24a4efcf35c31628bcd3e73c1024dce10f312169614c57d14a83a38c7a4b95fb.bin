 mL) of placebo.</p>"},{"id":"BG002","title":"Total","description":"Total of all reporting groups"}],"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"measures":[{"title":"Age, Continuous","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"years","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"38.6","spread":"13.7"},{"groupId":"BG001","value":"39.4","spread":"15.2"},{"groupId":"BG002","value":"38.8","spread":"14.1"}]}]}]},{"title":"Age, Customized","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"title":"18-64 years","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"574"},{"groupId":"BG001","value":"185"},{"groupId":"BG002","value":"759"}]}]},{"title":"65-84 years","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"28"},{"groupId":"BG001","value":"14"},{"groupId":"BG002","value":"42"}]}]},{"title":"&gt;=85 years","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"1"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"1"}]}]}]},{"title":"Sex: Female, Male","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"title":"Female","measurements":[{"groupId":"BG000","value":"252"},{"groupId":"BG001","value":"76"},{"groupId":"BG002","value":"328"}]},{"title":"Male","measurements":[{"groupId":"BG000","value":"351"},{"groupId":"BG001","value":"123"},{"groupId":"BG002","value":"474"}]}]}]},{"title":"Ethnicity (NIH&#x2F;OMB)","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"title":"Hispanic or Latino","measurements":[{"groupId":"BG000","value":"53"},{"groupId":"BG001","value":"17"},{"groupId":"BG002","value":"70"}]},{"title":"Not Hispanic or Latino","measurements":[{"groupId":"BG000","value":"548"},{"groupId":"BG001","value":"179"},{"groupId":"BG002","value":"727"}]},{"title":"Unknown or Not Reported","measurements":[{"groupId":"BG000","value":"2"},{"groupId":"BG001","value":"3"},{"groupId":"BG002","value":"5"}]}]}]},{"title":"Race&#x2F;Ethnicity, Customized","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"title":"White","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"426"},{"groupId":"BG001","value":"138"},{"groupId":"BG002","value":"564"}]}]},{"title":"Black or african american","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"41"},{"groupId":"BG001","value":"18"},{"groupId":"BG002","value":"59"}]}]},{"title":"Asian","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"120"},{"groupId":"BG001","value":"40"},{"groupId":"BG002","value":"160"}]}]},{"title":"American indian or alaska native","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"1"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"1"}]}]},{"title":"Native hawaiian or other pacific islander","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"5"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"5"}]}]},{"title":"Other","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"8"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"8"}]}]},{"title":"Missing","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"2"},{"groupId":"BG001","value":"3"},{"groupId":"BG002","value":"5"}]}]}]},{"title":"Region of Enrollment","paramType":"NUMBER","unitOfMeasure":"participants","classes":[{"title":"United States","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"149"},{"groupId":"BG001","value":"49"},{"groupId":"BG002","value":"198"}]}]},{"title":"Japan","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"96"},{"groupId":"BG001","value":"31"},{"groupId":"BG002","value":"127"}]}]},{"title":"France","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"85"},{"groupId":"BG001","value":"23"},{"groupId":"BG002","value":"108"}]}]},{"title":"Germany","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"200"},{"groupId":"BG001","value":"73"},{"groupId":"BG002","value":"273"}]}]},{"title":"Spain","denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"73"},{"groupId":"BG001","value":"23"},{"groupId":"BG002","value":"96"}]}]}]},{"title":"Investigator&#x27;s Global Assessment","description":"The Investigator&#x27;s Global Assessment (IGA) is an instrument used in clinical trials to rate the severity of the subject&#x27;s global atopic dermatitis and is based on a 5-point scale ranging from 0 (clear) to 4 (severe).","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"199"},{"groupId":"BG002","value":"802"}]}],"categories":[{"title":"Clear","measurements":[{"groupId":"BG000","value":"0"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"0"}]},{"title":"Almost clear","measurements":[{"groupId":"BG000","value":"0"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"0"}]},{"title":"Mild","measurements":[{"groupId":"BG000","value":"0"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"0"}]},{"title":"Moderate","measurements":[{"groupId":"BG000","value":"296"},{"groupId":"BG001","value":"95"},{"groupId":"BG002","value":"391"}]},{"title":"Severe","measurements":[{"groupId":"BG000","value":"305"},{"groupId":"BG001","value":"102"},{"groupId":"BG002","value":"407"}]},{"title":"Missing","measurements":[{"groupId":"BG000","value":"2"},{"groupId":"BG001","value":"2"},{"groupId":"BG002","value":"4"}]}]}]},{"title":"Eczema Area and Severity Index","description":"The Eczema Area and Severity Index (EASI) is a validated measure used in clinical practice and clinical trials to assess the severity and extent of atopic dermatitis.\nThe EASI is a composite index with scores ranging from 0 to 72, with higher values indicating more severe and&#x2F;or more extensive condition.","populationDescription":"Number of subjects analysed = subjects with available data for the baseline parameter.","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"units on a scale","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"601"},{"groupId":"BG001","value":"197"},{"groupId":"BG002","value":"798"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"32.2","spread":"13.7"},{"groupId":"BG001","value":"32.9","spread":"13.9"},{"groupId":"BG002","value":"32.4","spread":"13.8"}]}]}]},{"title":"Scoring Atopic Dermatitis","description":"The Scoring Atopic Dermatitis (SCORAD) is a validated tool to evaluate the extent and severity of atopic dermatitis lesions, along with subjective symptoms.\nThe score ranges from 0 to 103, with higher values indicating more extensive and&#x2F;or severe condition.","populationDescription":"Number of subjects analysed = subjects with available data for the baseline parameter.","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"units on a scale","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"601"},{"groupId":"BG001","value":"197"},{"groupId":"BG002","value":"798"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"70.3","spread":"13.0"},{"groupId":"BG001","value":"71.7","spread":"12.5"},{"groupId":"BG002","value":"70.6","spread":"12.9"}]}]}]},{"title":"Dermatology Life Quality Index","description":"The Dermatology Life Quality Index (DLQI) consists of 10 items addressing the subject&#x27;s perception of the impact of their skin disease on different aspects of their health-related quality of life (HQoL) over the last week such as dermatology-related symptoms and feelings, daily activities, leisure, work or school, personal relationships, and the treatment.\nEach item is scored on a 4-point Likert scale (0 = &#x27;not at all ⁄not relevant&#x27;; 1 = &#x27;a little&#x27;; 2 = &#x27;a lot&#x27;; 3 = &#x27;very much&#x27;).\nThe total score is the sum of the 10 items (0 to 30); a high score is indicative of a poor HQoL.","populationDescription":"Number of subjects analysed = subjects with available data for the baseline parameter.","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"units on a scale","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"591"},{"groupId":"BG001","value":"194"},{"groupId":"BG002","value":"785"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"16.8","spread":"7.1"},{"groupId":"BG001","value":"17.0","spread":"6.6"},{"groupId":"BG002","value":"16.9","spread":"7.0"}]}]}]},{"title":"Worst Daily Pruritus NRS (weekly average)","description":"Subjects assess their worst itch severity over the past 24 hours using an 11-point NRS (&#x27;Worst Daily Pruritus NRS&#x27;) with 0 indicating &#x27;no itch&#x27; and 10 indicating &#x27;worst itch imaginable&#x27;.","populationDescription":"Number of subjects analysed = subjects with available data for the baseline parameter.","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"units on a scale","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"598"},{"groupId":"BG001","value":"195"},{"groupId":"BG002","value":"793"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"7.7","spread":"1.4"},{"groupId":"BG001","value":"7.7","spread":"1.4"},{"groupId":"BG002","value":"7.7","spread":"1.4"}]}]}]},{"title":"Body surface area affected by atopic dermatitis (AD)","populationDescription":"Number of subjects analysed = subjects with available data for the baseline parameter.","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"percentage affected","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"198"},{"groupId":"BG002","value":"801"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"52.7","spread":"24.1"},{"groupId":"BG001","value":"54.2","spread":"25.6"},{"groupId":"BG002","value":"53.1","spread":"24.5"}]}]}]},{"title":"Age of onset of atopic dermatitis (AD)","populationDescription":"Number of subjects analysed = subjects with available data for the baseline parameter.","paramType":"MEDIAN","dispersionType":"INTER_QUARTILE_RANGE","unitOfMeasure":"years","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"198"},{"groupId":"BG002","value":"801"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"3.0","lowerLimit":"1.0","upperLimit":"14.0"},{"groupId":"BG001","value":"3.0","lowerLimit":"0.0","upperLimit":"13.0"},{"groupId":"BG002","value":"3.0","lowerLimit":"0.0","upperLimit":"13.0"}]}]}]},{"title":"Duration of atopic dermatitis (AD)","populationDescription":"Number of subjects analysed = subjects with available data for the baseline parameter.","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"years","classes":[{"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"603"},{"groupId":"BG001","value":"198"},{"groupId":"BG002","value":"801"}]}],"categories":[{"measurements":[{"groupId":"BG000","value":"27.9","spread":"14.5"},{"groupId":"BG001","value":"29.6","spread":"15.1"},{"groupId":"BG002","value":"28.3","spread":"14.7"}]}]}]}]},"outcomeMeasuresModule":{"outcomeMeasures":[{"type":"PRIMARY","title":"Subjects With Investigator&#x27;s Global Assessment (IGA) Score of 0 (Clear) or 1 (Almost Clear) at Week 16","description":"The IGA is an instrument used in clinical trials to rate the severity of the subject&#x27;s global AD and is based on a 5-point scale ranging from 0 (clear) to 4 (severe).","populationDescription":"The full analysis set (FAS: all subjects randomised to initial treatment who were exposed to IMP) was used for the primary analysis; 802 subjects were randomised to initial treatment and 798 received IMP, thus the FAS comprised of 798 subjects.","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"At Week 16","groups":[{"id":"OG000","title":"Tralokinumab 300 mg Q2W","description":"<p>Week 0 to Week 16:</p><p>Tralokinumab 300 mg Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total loading dose of 600 mg tralokinumab (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total dose of 300 mg tralokinumab.</p>"},{"id":"OG001","title":"Placebo Q2W","description":"<p>Week 0 to Week 16:</p><p>Placebo Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of placebo to receive a total loading dose (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of placebo.</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"601"},{"groupId":"OG001","value":"197"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"95"},{"groupId":"OG001","value":"14"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Analysis was performed using Cochran-Mantel-Haenszel test stratified by region and baseline disease severity.The null hypothesis of no difference in response rates between tralokinumab and placebo were tested against the 2-sided alternative that there is a difference.","nonInferiorityType":"SUPERIORITY","nonInferiorityComment":"Primary endpoints tested sequentially at a 5% significance level.","pValue":"0.002","pValueComment":"Based on the primary analysis of the primary estimand &#x27;composite&#x27;.\nSubjects with missing data or subjects who received rescue medication prior to Week 16 were considered non-responders.","statisticalMethod":"Cochran-Mantel-Haenszel","statisticalComment":"Primary endpoints tested sequentially at a 5% significance level.","paramType":"Risk Difference (RD)","paramValue":"8.6","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"4.1","ciUpperLimit":"13.1","estimateComment":"Mantel-Haenszel risk difference, stratified by region and baseline disease severity."}]},{"type":"PRIMARY","title":"Subjects Achieving at Least 75% Reduction in Eczema Area and Severity Index [EASI] at Week 16","description":"The EASI is a validated measure used in clinical practice and clinical trials to assess the severity and extent of AD.\nThe EASI is a composite index with scores ranging from 0 to 72, with higher values indicating more severe and&#x2F;or more extensive condition.","populationDescription":"Full analysis set","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"At Week 16","groups":[{"id":"OG000","title":"Tralokinumab 300 mg Q2W","description":"<p>Week 0 to Week 16:</p><p>Tralokinumab 300 mg Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total loading dose of 600 mg tralokinumab (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total dose of 300 mg tralokinumab.</p>"},{"id":"OG001","title":"Placebo Q2W","description":"<p>Week 0 to Week 16:</p><p>Placebo Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of placebo to receive a total loading dose (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of placebo.</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"601"},{"groupId":"OG001","value":"197"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"150"},{"groupId":"OG001","value":"25"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Analysis was performed using Cochran-Mantel-Haenszel test stratified by region and baseline disease severity.\nThe null hypothesis of no difference in response rates between tralokinumab and placebo were tested against the 2-sided alternative that there is a difference.","nonInferiorityType":"SUPERIORITY","nonInferiorityComment":"Primary endpoints tested sequentially at a 5% significance level.","pValue":"&lt;0.001","pValueComment":"Based on the primary analysis of the primary estimand &#x27;composite&#x27;.\nSubjects with missing data or subjects who received rescue medication prior to Week 16 were considered non-responders.","statisticalMethod":"Cochran-Mantel-Haenszel","statisticalComment":"Primary endpoints tested sequentially at a 5% significance level.","paramType":"Risk Difference (RD)","paramValue":"12.1","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"6.5","ciUpperLimit":"17.7","estimateComment":"Mantel-Haenszel risk difference, stratified by region and baseline disease severity."}]},{"type":"SECONDARY","title":"Reduction of Worst Daily Pruritus Numeric Rating Scale (Weekly Average) of at Least 4 From Baseline to Week 16.","description":"Subjects will assess their worst itch severity over the past 24 hours using an 11 point NRS (&#x27;Worst Daily Pruritus NRS&#x27;) with 0 indicating &#x27;no itch&#x27; and 10 indicating &#x27;worst itch imaginable&#x27;.","populationDescription":"Full analysis set (FAS).\nNumber of subjects analysed = subjects with baseline pruritus NRS weekly average ≥4.","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"Week 0 to Week 16","groups":[{"id":"OG000","title":"Tralokinumab 300 mg Q2W","description":"<p>Week 0 to Week 16:</p><p>Tralokinumab 300 mg Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total loading dose of 600 mg tralokinumab (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total dose of 300 mg tralokinumab.</p>"},{"id":"OG001","title":"Placebo Q2W","description":"<p>Week 0 to Week 16:</p><p>Placebo Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of placebo to receive a total loading dose (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of placebo.</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"594"},{"groupId":"OG001","value":"194"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"119"},{"groupId":"OG001","value":"20"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Reduction of Worst Daily Pruritus NRS weekly average ≥4 at Week 16 was tested after the sequential testing of IGA 0&#x2F;1 and EASI75 if these tests showed statistical significance.","nonInferiorityType":"SUPERIORITY","pValue":"0.002","pValueComment":"Based on the primary analysis of the primary estimand &#x27;Composite&#x27;, subjects who received rescue medication prior to Week 16 or have missing data at Week 16 were considered as non-responders.","statisticalMethod":"Cochran-Mantel-Haenszel","statisticalComment":"Tested sequentially at a 5% significance level.","paramType":"Risk Difference (RD)","paramValue":"9.7","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"4.4","ciUpperLimit":"15","estimateComment":"Mantel-Haenszel risk difference, stratified by region and baseline disease severity."}]},{"type":"SECONDARY","title":"Change in Scoring Atopic Dermatitis (SCORAD) From Baseline to Week 16","description":"The SCORAD is a validated tool to evaluate the extent and severity of atopic dermatitis lesions, along with subjective symptoms.\nThe score ranges from 0 to 103, with higher values indicating a more extensive and&#x2F;or severe condition.","populationDescription":"Full analysis set","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"Standard Error","unitOfMeasure":"units on a scale","timeFrame":"Week 0 to Week 16","groups":[{"id":"OG000","title":"Tralokinumab 300 mg Q2W","description":"<p>Week 0 to Week 16:</p><p>Tralokinumab 300 mg Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total loading dose of 600 mg tralokinumab (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total dose of 300 mg tralokinumab.</p>"},{"id":"OG001","title":"Placebo Q2W","description":"<p>Week 0 to Week 16:</p><p>Placebo Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of placebo to receive a total loading dose (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of placebo.</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"601"},{"groupId":"OG001","value":"197"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"-25.2","spread":"0.94"},{"groupId":"OG001","value":"-14.7","spread":"1.80"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Data collected after permanent discontinuation of IMP or after initiation of rescue medication were not included in the analysis.","nonInferiorityType":"SUPERIORITY","nonInferiorityComment":"Multiplicity adjustment using the Holm method.","pValue":"&lt;0.001","pValueComment":"Based on the primary analysis of the primary estimand &#x27;hypothetical&#x27;.\nRepeated measurements model on post-baseline data.\nIn case of no post-baseline assessments before initiation of rescue medication, the Week 2 change was imputed as 0.","statisticalMethod":"Repeated measurements model","paramType":"Difference of least square means","paramValue":"-10.4","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-14.4","ciUpperLimit":"-6.5"}]},{"type":"SECONDARY","title":"Change in Dermatology Life Quality Index (DLQI) Score From Baseline to Week 16","description":"The Dermatology Life Quality Index (DLQI) is a validated questionnaire with content specific to those with dermatology conditions.\nIt consists of 10 items addressing the subject&#x27;s perception of the impact of their skin disease on different aspects of their quality of life (QoL) over the last week such as dermatology-related symptoms and feelings, daily activities, leisure, work or school, personal relationships, and the treatment.\nEach item is scored on a 4 point Likert scale (0 = not at all ⁄not relevant; 1 = a little; 2 = a lot; 3 = very much).\nThe total score is the sum of the 10 items (0 to 30); a high score is indicative of a poor QoL.","populationDescription":"Full analysis set.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"Standard Error","unitOfMeasure":"units on a scale","timeFrame":"Week 0 to Week 16","groups":[{"id":"OG000","title":"Tralokinumab 300 mg Q2W","description":"<p>Week 0 to Week 16:</p><p>Tralokinumab 300 mg Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total loading dose of 600 mg tralokinumab (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total dose of 300 mg tralokinumab.</p>"},{"id":"OG001","title":"Placebo Q2W","description":"<p>Week 0 to Week 16:</p><p>Placebo Q2W</p><p>At Day 0, each subject received 4 SC injections (each 1.0 mL) of placebo to receive a total loading dose (4.0 mL).\nAt subsequent visits (Q2W) each subject received 2 SC injections (each 1.0 mL) of placebo.</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"601"},{"groupId":"OG001","value":"197"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"-7.1","spread":"0.31"},{"groupId":"OG001","value":"-5.0","spread":"0.59"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Data collected after permanent discontinuation of IMP or initiation of rescue medication not included.","nonInferiorityType":"SUPERIORITY","nonInferiorityComment":"Multiplicity adjustment using Holm method.","pValue":"0.002","pValueComment":"Based on the primary analysis of the primary estimand &#x27;hypothetical&#x27;.\nRepeated measurements model on post-baseline data.\nIn case of no post-baseline assessments before initiation of rescue medication, the Week 2 change was imputed as 0.","statisticalMethod":"Repeated measurements model","paramType":"Difference of least square means","paramValue":"-2.1","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-3.4","ciUpperLimit":"-0.8"}]},{"type":"SECONDARY","title":"Subjects With Investigator&#x27;s Global Assessment (IGA) Score of 0 (Clear) or 1 (Almost Clear) at Week 52 Among Subjects With IGA of 0&#x2F;1 at Week 16","description":"The IGA is an instrument used in clinical trials to rate the severity of the subject&#x27;s global AD and is based on a 5-point scale ranging from 0 (clear) to 4 (severe).","populationDescription":"<p>Maintenance analysis set - Subjects who achieved IGA 0&#x2F;1 at Week 16 after initial treatment with tralokinumab without use of rescue medication.</p><p>Subjects who were treated with placebo during initial treatment period (tralokinumab naïve arm) and who continued to the maintenance period were not part of the analysis of maintenance endpoints and therefore this arm is not included for outcome measures.</p>","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"At Week 52","groups":[{"id":"OG000","title":"Tralokinumab 300 mg Q2W","description":"<p>Week 16 to Week 52:</p><p>Subjects achieving a clinical response at Week 16 and initially randomized to tralokinumab re-randomized to tralokinumab 300 mg Q2W maintenance dosing regimen.</p><p>At each visit, subject received 2 SC injections (each 1.0 mL) of 150 mg tralokinumab Q2W to receive a total dose of 300 mg tralokinumab.</p>"},{"id":"OG001","title":"Tralokinumab 300 mg Q4W","description":"<p>Week 16 to Week 52:</p><p>Subjects achieving a clinical response at Week 16 and initially randomized to tralokinumab re-randomized to tralokinumab 300 mg Q4W maintenance dosing regimen.</p><p>At each visit, subject received alternating dose administrations: 2 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total dose of 300 mg tralokinumab and 2 SC injections (each 1.0 mL) of placebo.</p>"},{"id":"OG002","title":"Placebo Q2W","description":"<p>Week 16 to Week 52:</p><p>Subjects achieving a clinical response at Week 16 and initially randomized to tralokinumab re-randomized to placebo Q2W dosing regimen.</p><p>At each visit, subject received 2 SC injections (each 1.0 mL) of placebo Q2W to receive a total dose of placebo.</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"39"},{"groupId":"OG001","value":"36"},{"groupId":"OG002","value":"19"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"20"},{"groupId":"OG001","value":"14"},{"groupId":"OG002","value":"9"}]}]}],"analyses":[{"groupIds":["OG000","OG002"],"groupDescription":"<p>Testing according to the hierarchical testing procedure in the order:</p><p>IGA 0&#x2F;1 at Week 52 between Q2W vs Placebo, EASI75 at Week 52 between Q2W vs Placebo, IGA 0&#x2F;1 at Week 52 between Q4W vs Placebo, and EASI75 at Week 52 between Q4W vs Placebo.</p>","nonInferiorityType":"SUPERIORITY","pValue":"0.68","pValueComment":"<p>Based on the primary analysis of the &#x27;composite&#x27; estimand.\nSubjects who received rescue medication or were transferred to open-label treatment were considered non-responders.</p><p>P value was considered non-significant.</p>","statisticalMethod":"Cochran-Mantel-Haenszel","statisticalComment":"This test was not statistically significant and hence next maintenance endpoint in the sequential testing procedure was not evaluated.","paramType":"Risk Difference (RD)","paramValue":"6.0","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-21.8","ciUpperLimit":"33.7","estimateComment":"Mantel-Haenszel risk difference compared to placebo, stratified by region."},{"groupIds":["OG001","OG002"],"groupDescription":"<p>Testing according to the hierarchical testing procedure in the order:</p><p>IGA 0&#x2F;1 at Week 52 between Q2W vs Placebo, EASI75 at Week 52 between Q2W vs Placebo, IGA 0&#x2F;1 at Week 52 between Q4W vs Placebo, and EASI75 at Week 52 between Q4W vs Placebo.</p>","nonInferiorityType":"SUPERIORITY","pValue":"0.50","pValueComment":"Test not evaluated for significance.\nBased on the primary analysis of the &#x27;composite&#x27; estimand.\nSubjects who received rescue medication or were transferred to open-label treatment were considered non-responders.","statisticalMethod":"Cochran-Mantel-Haenszel","paramType":"Risk Difference (RD)","paramValue":"-9.5","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-37.1","ciUpperLimit":"18.0","estimateComment":"Mantel-Haenszel risk difference compared to placebo, stratified by region."}]},{"type":"SECONDARY","title":"Subjects With at Least 75% Reduction in Eczema Area and Severity Index [EASI] at Week 52 Among Subjects With EASI75 at Week 16","description":"The EASI is a validated measure used in clinical practice and clinical trials to assess the severity and extent of AD.\nThe EASI is a composite index with scores ranging from 0 to 72, with higher values indicating more severe and&#x2F;or more extensive condition.","populationDescription":"<p>Maintenance analysis set: Subjects who achieved EASI75 at Week 16 after inital treatment with tralokinumab without use of rescue medication.</p><p>Subjects who were treated with placebo during initial treatment period (tralokinumab naïve arm) and who continued to the maintenance period were not part of the analysis of maintenance endpoints and therefore this arm is not included for outcome measures.</p>","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"At Week 52","groups":[{"id":"OG000","title":"Tralokinumab 300 mg Q2W","description":"<p>Week 16 to Week 52:</p><p>Subjects achieving a clinical response at Week 16 and initially randomized to tralokinumab re-randomized to tralokinumab 300 mg Q2W maintenance dosing regimen.</p><p>At each visit, subject received 2 SC injections (each 1.0 mL) of 150 mg tralokinumab Q2W to receive a total dose of 300 mg tralokinumab.</p>"},{"id":"OG001","title":"Tralokinumab 300 mg Q4W","description":"<p>Week 16 to Week 52:</p><p>Subjects achieving a clinical response at Week 16 and initially randomized to tralokinumab re-randomised to tralokinumab 300 mg Q4W maintenance dosing regimen.</p><p>At each visit, subject received alternating dose administrations: 2 SC injections (each 1.0 mL) of 150 mg tralokinumab to receive a total dose of 300 mg tralokinumab and 2 SC injections (each 1.0 mL) of placebo.</p>"},{"id":"OG002","title":"Placebo Q2W","description":"<p>Week 16 to Week 52:</p><p>Subjects achieving a clinical response at Week 16 and initially randomized to tralokinumab re-randomized to placebo Q2W dosing regimen.</p><p>At each visit, subject received 2 SC injections (each 1.0 mL) of placebo Q2W to receive a total dose of placebo.</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"47"},{"groupId":"OG001","value":"57"},{"groupId":"OG002","value":"30"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"28"},{"