r","state":"Pennsylvania","zip":"15241","country":"United States","geoPoint":{"lat":40.3359,"lon":-80.08339}},{"facility":"International Clinical Research - Tennessee LLC","city":"Murfreesboro","state":"Tennessee","zip":"37130","country":"United States","geoPoint":{"lat":35.84562,"lon":-86.39027}},{"facility":"Arlington Research Center, Inc.","city":"Arlington","state":"Texas","zip":"76011","country":"United States","geoPoint":{"lat":32.73569,"lon":-97.10807}},{"facility":"North Texas Center for Clinical Research","city":"Frisco","state":"Texas","zip":"75034","country":"United States","geoPoint":{"lat":33.15067,"lon":-96.82361}},{"facility":"Center for Clinical Studies, Ltd, LLP","city":"Houston","state":"Texas","zip":"77004","country":"United States","geoPoint":{"lat":29.76328,"lon":-95.36327}},{"facility":"Houston Center for Clinical Research","city":"Sugar Land","state":"Texas","zip":"77479","country":"United States","geoPoint":{"lat":29.61968,"lon":-95.63495}},{"facility":"Premier Clinical Research, LLC","city":"Spokane","state":"Washington","zip":"99202","country":"United States","geoPoint":{"lat":47.65966,"lon":-117.42908}}]},"ipdSharingStatementModule":{"ipdSharing":"NO"}},"hasResults":true,"resultsSection":{"participantFlowModule":{"groups":[{"id":"FG000","title":"Difamilast Ointment","description":"<p>1% Difamilast Ointment</p><p>The first dose of the study drug (Day 1) will be applied in the study clinic under the supervision of the study personnel after which the subject will administer the study drug at home, unless otherwise directed by the study personnel.\nSubjects are to apply a thin layer of study drug twice daily (morning and evening) to all affected areas, including newly appearing lesions and lesions/areas that improve during the study.\nThroughout the study, the time of each study drug application and daily itch assessment (subjects ≥6 years of age) will be recorded in a diary.</p>"},{"id":"FG001","title":"Vehicle Controlled","description":"<p>Matching placebo ointment.</p><p>Subjects will apply a thin layer of placebo ointment twice daily (morning and evening) to all affected areas, including newly appearing lesions and lesions/areas that improve during the study.\nThroughout the study, the time of each application and daily itch assessment (subjects ≥6 years of age) will be recorded in a diary.</p>"}],"periods":[{"title":"Overall Study","milestones":[{"type":"STARTED","achievements":[{"groupId":"FG000","numSubjects":"94"},{"groupId":"FG001","numSubjects":"59"}]},{"type":"COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"90"},{"groupId":"FG001","numSubjects":"55"}]},{"type":"NOT COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"4"},{"groupId":"FG001","numSubjects":"4"}]}]}]},"baselineCharacteristicsModule":{"groups":[{"id":"BG000","title":"Difamilast Ointment","description":"1% Difamilast Ointment"},{"id":"BG001","title":"Vehicle Controlled","description":"Matching placebo ointment"},{"id":"BG002","title":"Total","description":"Total of all reporting groups"}],"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"94"},{"groupId":"BG001","value":"59"},{"groupId":"BG002","value":"153"}]}],"measures":[{"title":"Age, Customized","paramType":"MEAN","unitOfMeasure":"years","classes":[{"categories":[{"measurements":[{"groupId":"BG000","value":"38.0","spread":"21.67"},{"groupId":"BG001","value":"39.0","spread":"22.35"},{"groupId":"BG002","value":"38.4","spread":"21.87"}]}]}],"dispersionType":"STANDARD_DEVIATION"},{"title":"Sex: Female, Male","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"Female","measurements":[{"groupId":"BG000","value":"59"},{"groupId":"BG001","value":"36"},{"groupId":"BG002","value":"95"}]},{"title":"Male","measurements":[{"groupId":"BG000","value":"35"},{"groupId":"BG001","value":"23"},{"groupId":"BG002","value":"58"}]}]}]},{"title":"Race (NIH/OMB)","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"American Indian or Alaska Native","measurements":[{"groupId":"BG000","value":"2"},{"groupId":"BG001","value":"2"},{"groupId":"BG002","value":"4"}]},{"title":"Asian","measurements":[{"groupId":"BG000","value":"4"},{"groupId":"BG001","value":"6"},{"groupId":"BG002","value":"10"}]},{"title":"Native Hawaiian or Other Pacific Islander","measurements":[{"groupId":"BG000","value":"0"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"0"}]},{"title":"Black or African American","measurements":[{"groupId":"BG000","value":"27"},{"groupId":"BG001","value":"14"},{"groupId":"BG002","value":"41"}]},{"title":"White","measurements":[{"groupId":"BG000","value":"55"},{"groupId":"BG001","value":"37"},{"groupId":"BG002","value":"92"}]},{"title":"More than one race","measurements":[{"groupId":"BG000","value":"6"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"6"}]},{"title":"Unknown or Not Reported","measurements":[{"groupId":"BG000","value":"0"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"0"}]}]}]},{"title":"Baseline Fitzpatrick skin type","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"measurements":[{"groupId":"BG000","value":"94"},{"groupId":"BG001","value":"59"},{"groupId":"BG002","value":"153"}]}]}],"reviewUnit":{"resetReasons":["One or more numbers in the table appear to be nonmeaningful placeholders that do not reflect data collected during the study."]}}]},"outcomeMeasuresModule":{"outcomeMeasures":[{"type":"PRIMARY","title":"Efficacy of Twice-daily Topical Application of Difamilast Ointment 1% Compared to Vehicle Control in Subjects ≥2 Years of Age With Mild to Moderate AD","description":"The proportion of subjects achieving success on the the 5-point Investigator Global Assessment (IGA) of AD Severity score at Day 29, and the success is defined as a score of Clear (0) or Almost clear (1), with at least a 2-grade improvement from Baseline on the 5-point IGA of AD Severity score at Day 29","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"Baseline, Day 29","groups":[{"id":"OG000","title":"Difamilast Ointment","description":"<p>1% Difamilast Ointment</p><p>Difamilast: Off-white ointment containing active ingredient, petrolatum and other ingredients</p>"},{"id":"OG001","title":"Vehicle Controlled","description":"<p>Matching placebo ointment</p><p>Placebo: Matching Difamilast (Study drug) ointment without active ingredient</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"94"},{"groupId":"OG001","value":"59"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"94"},{"groupId":"OG001","value":"59"}]}]}]},{"type":"SECONDARY","title":"Efficacy of Difamilast Ointment 1% Compared to Vehicle Control in Subjects With Mild to Moderate AD","description":"<ul><li>The proportion of subjects achieving an IGA of AD Severity score of Clear (0) or Almost clear (1) at Day 29</li><li>The proportion of subjects achieving success on the 5-point IGA of AD Severity score at Day 22</li><li>The proportion of subjects achieving success on the 5-point IGA of AD Severity score at Day 15</li><li>The proportion of subjects achieving success on the 5-point IGA of AD Severity score at Day 8</li><li>The proportion of subjects ≥6 years of age (capable of self-reporting and with a baseline Peak Pruritus Numeric Rating Scale (PP-NRS) ≥4 achieving a 4-point improvement from Baseline in Peak Pruritus Numeric Rating Scale (PP-NRS) at Day 29</li></ul>","reportingStatus":"POSTED","timeFrame":"Baseline, Day 8, Day 15, Day 22 and Day 29","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","groups":[{"id":"OG000","title":"Difamilast Ointment","description":"<p>1% Difamilast Ointment</p><p>Difamilast: Off-white ointment containing active ingredient, petrolatum and other ingredients</p>"},{"id":"OG001","title":"Vehicle Controlled","description":"<p>Matching placebo</p><p>Placebo: Matching Difamilast (Study drug) ointment without active ingredient</p>"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"94"},{"groupId":"OG001","value":"59"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"94"},{"groupId":"OG001","value":"59"}]}]}],"measureCategoriesReviewUnit":{"resetReasons":["One or more numbers in the table appear to be nonmeaningful placeholders that do not reflect data collected during the study."]}}]},"adverseEventsModule":{"frequencyThreshold":"0","timeFrame":"Adverse event data were collected over a period of 8 months","description":"Adverse events information were collected according to severity.","eventGroups":[{"id":"EG000","title":"Difamilast Ointment","description":"<p>1% Difamilast Ointment</p><p>Difamilast: Off-white ointment containing active ingredient, petrolatum and other ingredients</p>","deathsNumAffected":0,"deathsNumAtRisk":94,"seriousNumAffected":1,"seriousNumAtRisk":94,"otherNumAffected":15,"otherNumAtRisk":94},{"id":"EG001","title":"Vehicle Controlled","description":"<p>Matching placebo ointment</p><p>Placebo: Matching Difamilast (Study drug) ointment without active ingredient</p>","deathsNumAffected":0,"deathsNumAtRisk":59,"seriousNumAffected":0,"seriousNumAtRisk":59,"otherNumAffected":11,"otherNumAtRisk":59}],"seriousEvents":[{"term":"Thyroid Cancer","organSystem":"Endocrine disorders","sourceVocabulary":"MedDRA Version 25.0","assessmentType":"SYSTEMATIC_ASSESSMENT","notes":"1 serious adverse event deemed not related to the study drug. 1 subject in the Difamilast Ointment group diagnosed with thyroid cancer on study day 7 and recovered on study day 104.\nSubject did not discontinue or modify treatment with the study drug.","stats":[{"groupId":"EG000","numEvents":1,"numAffected":1,"numAtRisk":94},{"groupId":"EG001","numEvents":0,"numAffected":0,"numAtRisk":59}]}],"otherEvents":[{"term":"Contact Dermatitis","organSystem":"Skin and subcutaneous tissue disorders","sourceVocabulary":"MedDRA Version 25.0","assessmentType":"SYSTEMATIC_ASSESSMENT","notes":"Subject in the Difamilast Ointment group had moderate contact dermatitis on study day 14 and was treated and recovered on study day 29.","stats":[{"groupId":"EG000","numEvents":15,"numAffected":15,"numAtRisk":94},{"groupId":"EG001","numEvents":11,"numAffected":11,"numAtRisk":59}]}]},"moreInfoModule":{"certainAgreement":{"piSponsorEmployee":false,"restrictionType":"OTHER","restrictiveAgreement":true},"pointOfContact":{"title":"Uma S Atmuri","organization":"Acrotech Biopharma Inc","email":"uatmuri@acrotechbiopharma.com","phone":"732-917-2420"}}},"annotationSection":{"annotationModule":{"unpostedAnnotation":{"unpostedResponsibleParty":"Acrotech Biopharma Inc.","unpostedEvents":[{"type":"RESET","date":"2026-07-07"}]}}},"documentSection":{"largeDocumentModule":{"largeDocs":[{"typeAbbrev":"Prot","hasProtocol":true,"hasSap":false,"hasIcf":false,"label":"Study Protocol","date":"2023-03-02","uploadDate":"2026-04-08T14:26","filename":"Prot_000.pdf","size":9520288},{"typeAbbrev":"SAP","hasProtocol":false,"hasSap":true,"hasIcf":false,"label":"Statistical Analysis Plan","date":"2023-10-20","uploadDate":"2026-04-08T14:27","filename":"SAP_001.pdf","size":10766306}]}},"reviewUnit":{"resetReasons":["This record has new issues that must be addressed."]}}