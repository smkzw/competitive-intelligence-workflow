   </tr>
   <tr style="height:2.9pt;white-space:pre-wrap;word-break:break-word;">
    <td style="border-right:0.5pt solid;border-left:0.5pt solid;padding-left:0.019in;vertical-align:top;border-bottom:0.5pt solid;padding-right:0.019in;"><p style="font-size:11pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;min-width:fit-content;">LGBTQ+</span></p><p style="font-size:11pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;min-width:fit-content;">&#160;</span></p></td>
