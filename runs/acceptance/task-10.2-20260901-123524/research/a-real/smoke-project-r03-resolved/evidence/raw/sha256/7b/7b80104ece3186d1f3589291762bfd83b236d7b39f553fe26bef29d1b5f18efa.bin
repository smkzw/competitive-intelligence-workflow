        <td style="vertical-align:middle;text-align:left;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span><ix:nonNumeric id="F_9754f0c6-9c28-4284-b6be-6cc71006ecd0" contextRef="C_055039ae-4be7-4149-8a50-bdf8d2790eb7" name="asln:DescriptionSignificantUnobservableInputs"><span style="color:#000000;white-space:pre-wrap;min-width:fit-content;">Volatility</span></ix:nonNumeric></span></p></td>
