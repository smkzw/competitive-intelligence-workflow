<script type="text/javascript">
    //onload
    window.addEventListener('load', () => {
        setTimeout(() => {
            const hash = window.location.hash;

            if (! hash) {
                return;
            }

            const element = document.querySelector(hash);

            if (element) {
                element.scrollIntoView({ behavior: 'smooth', block: 'start', inline: 'start' });
            }
        }, 999);
    });
</script>
