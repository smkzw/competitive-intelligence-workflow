":"6160","country":"Australia","geoPoint":{"lat":-32.05632,"lon":115.74557}},{"facility":"Doctor Chih-Ho Hong Medical Incorporated","city":"Surrey","state":"British Columbia","zip":"V3R 6A7","country":"Canada","geoPoint":{"lat":49.10635,"lon":-122.82509}},{"facility":"DermEffects","city":"London","state":"Ontario","zip":"N6H 5L5","country":"Canada","geoPoint":{"lat":42.98339,"lon":-81.23304}},{"facility":"Lynderm Research Inc","city":"Markham","state":"Ontario","zip":"L3P 1X3","country":"Canada","geoPoint":{"lat":43.86682,"lon":-79.2663}},{"facility":"Cheema Research Incorporated","city":"Mississauga","state":"Ontario","zip":"L5A 3V4","country":"Canada","geoPoint":{"lat":43.5789,"lon":-79.6583}},{"facility":"SKDS Research Incorporated","city":"Newmarket","state":"Ontario","zip":"L3Y 5G8","country":"Canada","geoPoint":{"lat":44.05011,"lon":-79.46631}},{"facility":"Gordon Sussman Clinical Research Incorporated","city":"North York","state":"Ontario","zip":"M3B 3S6","country":"Canada"},{"facility":"JRB Research Incorporated","city":"Ottawa","state":"Ontario","zip":"K1H 7X3","country":"Canada","geoPoint":{"lat":45.41117,"lon":-75.69812}},{"facility":"Fakultni nemocnice u sv Anny v Brne","city":"Brno","zip":"656 91","country":"Czechia","geoPoint":{"lat":49.19522,"lon":16.60796}},{"facility":"Nemocnice Novy Jicin as","city":"Nový Jičín","zip":"741 01","country":"Czechia","geoPoint":{"lat":49.59438,"lon":18.01028}},{"facility":"Fakultni nemocnice Ostrava","city":"Ostrava-Poruba","zip":"708 52","country":"Czechia"},{"facility":"Sanatorium profesora Arenbergera","city":"Prague","zip":"110 00","country":"Czechia","geoPoint":{"lat":50.08804,"lon":14.42076}},{"facility":"Nemocnice Na Bulovce","city":"Prague","zip":"180 81","country":"Czechia","geoPoint":{"lat":50.08804,"lon":14.42076}},{"facility":"North Estonia Medical Centre","city":"Tallinn","zip":"13419","country":"Estonia","geoPoint":{"lat":59.43696,"lon":24.75353}},{"facility":"Clinical Research Centre","city":"Tartu","zip