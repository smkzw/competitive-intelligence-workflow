<thead valign="top">
<tr style="border-bottom:solid 1px #000000">
<th align="left" rowspan="2" valign="top" colspan="1"></th>
<th align="left" colspan="3" style="border-bottom:solid 1px #000000" valign="top" rowspan="1">ECZTRA 1</th>
<th align="left" colspan="3" style="border-bottom:solid 1px #000000" valign="top" rowspan="1">ECZTRA 2</th>
</tr>
<tr style="border-bottom:solid 1px #000000">
<th align="left" valign="top" rowspan="1" colspan="1">Placebo, <em>n</em> = 197</th>
<th align="left" valign="top" rowspan="1" colspan="1">Tralokinumab Q2W, <em>n</em> = 601</th>
<th align="left" valign="top" rowspan="1" colspan="1">Difference vs. placebo (95% CI)</th>
<th align="left" valign="top" rowspan="1" colspan="1">Placebo, n = 201</th>
