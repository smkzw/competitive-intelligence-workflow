          "source_sha256": "87cb8ee2da66aced2308003cb0242d41317ea04393e5a8ab284ee6d1d16e0161",
          "raw_sha256": "9a50b06f42aad22785c85821cc561a7655a2ec9f218e51603e9ff0fdafca4786",
          "url": "https://www.accessdata.fda.gov/drugsatfda_docs/label/2025/761390s002%2C761391s001lbl.pdf",
          "page": 9,
          "original_text": "Nemolizumab-ilto is a humanized IgG2 monoclonal antibody that inhibits IL-31 signaling by binding \nselectively to IL-31 RA.",
          "acquired_at": "2026-10-07T12:53:16.701306Z",
          "observed_publicly_available_at": "2026-10-07T12:28:06.672448Z"
        },
        {
