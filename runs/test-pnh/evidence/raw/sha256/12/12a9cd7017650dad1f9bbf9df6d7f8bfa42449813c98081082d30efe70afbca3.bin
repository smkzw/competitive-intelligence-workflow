nts","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"2.94","spread":"0.383"},{"groupId":"OG001","value":"0.27","spread":"0.759"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.0019","pValueComment":"P-value for baseline, strata and treatment is from LS mean of proc mixed and proc mianalyze based on parameter estimates.","statisticalMethod":"ANCOVA","paramType":"LS mean difference","paramValue":"2.67","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.99","ciUpperLimit":"4.35"}]},{"type":"SECONDARY","title":"Percentage of Subjects Who Received Transfusion or Decrease of Hb >2 g/dL From Baseline","description":"Transfusion refers to any transfusion of PRBC, leukocyte-depleted red blood cells (LDPRC), leukocyte poor packed red blood cell (LPRC), leukocyte poor blood (LPB) or whole blood.","populationDescription":"The ITT set included all subjects assigned to treatment.","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"percentage of subjects","timeFrame":"At Week 26","groups":[{"id":"OG000","title":"Pegcetacoplan","description":"Subjects were received SC infusion of pegcetacoplan 1080 mg twice weekly or every 3 days up to end of the RCP (Week 26). Subjects were not allowed to receive treatment with other complement inhibitors."},{"id":"OG001","title":"Standard of Care","description":"Subjects continued to receive SoC treatment but were not allowed to receive treatment with a complement inhibitor unless they qualified for pegcetacoplan escape therapy."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"11.4"},{"groupId":"OG001","value":"100"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"<0.0001","pValueComment":"Cochran-Mantel-Haenszel test is stratified by number of PRBC within 12 months prior to screening (\\<4, ≥4) reported in EDC data.","statisticalMethod":"Cochran-Mantel-Haenszel","paramType":"Difference","paramValue":"-0.7505","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-0.9041","ciUpperLimit":"-0.5969"}]},{"type":"SECONDARY","title":"Percentage of Subjects With Transfusion Avoidance","description":"Transfusion avoidance was defined as the percentage of subjects who did not require a transfusion during the RCP. Transfusion refers to any transfusion of PRBC, LDPRC, LPRC, LPB or whole blood.","populationDescription":"The ITT set included all subjects assigned to treatment.","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"percentage of subjects","timeFrame":"At Week 26","groups":[{"id":"OG000","title":"Pegcetacoplan","description":"Subjects were received SC infusion of pegcetacoplan 1080 mg twice weekly or every 3 days up to end of the RCP (Week 26). Subjects were not allowed to receive treatment with other complement inhibitors."},{"id":"OG001","title":"Standard of Care","description":"Subjects continued to receive SoC treatment but were not allowed to receive treatment with a complement inhibitor unless they qualified for pegcetacoplan escape therapy."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"91.4"},{"groupId":"OG001","value":"5.6"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"<0.0001","pValueComment":"Cochran-Mantel-Haenszel test is stratified by number of PRBC within 12 months prior to screening (\\<4, ≥4) reported in EDC data.","statisticalMethod":"Cochran-Mantel-Haenszel","paramType":"Difference","paramValue":"0.7241","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.5583","ciUpperLimit":"0.8899"}]},{"type":"SECONDARY","title":"Number of PRBC Units Transfused From Baseline Through Week 26","description":"The number of units of PRBC transfusions was estimated. In one transfusion subjects received one or more units.","populationDescription":"The ITT set included all subjects assigned to treatment.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"Full Range","unitOfMeasure":"PRBC transfusions","timeFrame":"Up to Week 26","groups":[{"id":"OG000","title":"Pegcetacoplan","description":"Subjects were received SC infusion of pegcetacoplan 1080 mg twice weekly or every 3 days up to end of the RCP (Week 26). Subjects were not allowed to receive treatment with other complement inhibitors."},{"id":"OG001","title":"Standard of Care","description":"Subjects continued to receive SoC treatment but were not allowed to receive treatment with a complement inhibitor unless they qualified for pegcetacoplan escape therapy."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"0.0","lowerLimit":"0","upperLimit":"19"},{"groupId":"OG001","value":"3.0","lowerLimit":"0","upperLimit":"13"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"<0.0001","pValueComment":"Wilcoxon rank-sum test p-value for the comparison between treatments is based on median using stratified non-parametric analysis. The 95% confidence interval (CI) is constructed using Hodges-Lehmann Estimation of Location Shift.","statisticalMethod":"Wilcoxon Rank-Sum Test","paramType":"Median Difference (Net)","paramValue":"3","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"2","ciUpperLimit":"4"}]},{"type":"SECONDARY","title":"Change From Baseline in Functional Assessment of Chronic Illness Therapy- (FACIT-Fatigue) Scale Score at Week 26","description":"The FACIT-Fatigue Scale is a 13-item Likert scaled instrument that is self-administered by the subjects during clinic visits. Subjects were presented with 13 statements and asked to indicate their responses as it applied to the past 7 days. The 5 possible responses are \"Not at all\" (0), \"A little bit\" (1), \"Somewhat\" (2), \"Quite a bit\" (3), and \"Very much\" (4). With 13 statements, the total score has a range of 0 to 52. The higher score corresponded to a higher quality of life. Baseline is defined as average of measurements prior to first dose of pegcetacoplan or on or prior to randomization of SoC. Post baseline missing values are imputed using multiple imputation method with Markov Chain Mont Carlo method.","populationDescription":"The ITT set included all subjects assigned to treatment.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"Standard Error","unitOfMeasure":"scores on a scale","timeFrame":"Baseline and Week 26","groups":[{"id":"OG000","title":"Pegcetacoplan","description":"Subjects were received SC infusion of pegcetacoplan 1080 mg twice weekly or every 3 days up to end of the RCP (Week 26). Subjects were not allowed to receive treatment with other complement inhibitors."},{"id":"OG001","title":"Standard of Care","description":"Subjects continued to receive SoC treatment but were not allowed to receive treatment with a complement inhibitor unless they qualified for pegcetacoplan escape therapy."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"7.78","spread":"1.210"},{"groupId":"OG001","value":"3.26","spread":"2.113"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.061","pValueComment":"P-value for baseline, strata and treatment is from LS mean of proc mixed and proc mianalyze based on parameter estimates.","statisticalMethod":"ANCOVA","paramType":"LS mean difference","paramValue":"4.51","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-0.21","ciUpperLimit":"9.24"}]},{"type":"SECONDARY","title":"Percentage of Subjects With Hb Normalization Levels at Week 26","description":"Normalization of Hb levels defined as \\>= 1x LLN at Week 26 in the absence of transfusion. Transfusion refers to any transfusion of PRBC, LDPRC, LPRC, LPB or whole blood.","populationDescription":"The ITT set included all subjects assigned to treatment.","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"percentage of subjects","timeFrame":"Baseline and Week 26","groups":[{"id":"OG000","title":"Pegcetacoplan","description":"Subjects were received SC infusion of pegcetacoplan 1080 mg twice weekly or every 3 days up to end of the RCP (Week 26). Subjects were not allowed to receive treatment with other complement inhibitors."},{"id":"OG001","title":"Standard of Care","description":"Subjects continued to receive SoC treatment but were not allowed to receive treatment with a complement inhibitor unless they qualified for pegcetacoplan escape therapy."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"45.7"},{"groupId":"OG001","value":"0"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.001","statisticalMethod":"Cochran-Mantel-Haenszel","paramType":"Difference","paramValue":"0.3645","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.1648","ciUpperLimit":"0.5642"}]},{"type":"SECONDARY","title":"Percentage of Subjects With LDH Normalization at Week 26","description":"The LDH normalization was defined as LDH \\<= 1xupper limit of normal (ULN) of normal range at week 26 in the absence of transfusion. Transfusion refers to any transfusion of PRBC, LDPRC, LPPRC, LPRC, LPB or whole blood.","populationDescription":"The ITT set included all subjects assigned to treatment.","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"percentage of subjects","timeFrame":"At Week 26","groups":[{"id":"OG000","title":"Pegcetacoplan","description":"Subjects were received SC infusion of pegcetacoplan 1080 mg twice weekly or every 3 days up to end of the RCP (Week 26). Subjects were not allowed to receive treatment with other complement inhibitors."},{"id":"OG001","title":"Standard of Care","description":"Subjects continued to receive SoC treatment but were not allowed to receive treatment with a complement inhibitor unless they qualified for pegcetacoplan escape therapy."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"65.7"},{"groupId":"OG001","value":"0"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"<0.0001","statisticalMethod":"Cochran-Mantel-Haenszel","paramType":"Difference","paramValue":"0.5592","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.3682","ciUpperLimit":"0.7502"}]},{"type":"SECONDARY","title":"Change From Baseline in European Organization for Research and Treatment of Cancer (EORTC) 30-item Core Quality of Life Questionnaire (QLQ-C30) Scores at Week 26","description":"The EORTC QLQ-C30 questionnaire (version 3.0) consisted of 30 questions comprised of both multi-item scales and single-item measures to assess overall quality of life in subjects. Questions were designated by functional scales, symptom scales, and global subject QOL/overall perceived health status. For the first 28 questions the 4 possible responses are \"Not at all' (1), 'A little' (2), 'Quite a bit' (3) and 'Very much' (4). For the remaining 2 questions the response is requested on a 7-point scale from 1 ('Very poor') to 7 ('Excellent'). Each scale has a range of 0% - 100%. A high scale score represents a higher response level. Baseline is defined as average of measurements prior to first dose of pegcetacoplan or on or prior to randomization of SoC. Post baseline missing values are imputed using multiple imputation method with Markov Chain Mont Carlo method.","populationDescription":"The ITT set included all subjects assigned to treatment.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"Standard Error","unitOfMeasure":"scores on a scale","timeFrame":"Baseline and Week 26","groups":[{"id":"OG000","title":"Pegcetacoplan","description":"Subjects were received SC infusion of pegcetacoplan 1080 mg twice weekly or every 3 days up to end of the RCP (Week 26). Subjects were not allowed to receive treatment with other complement inhibitors."},{"id":"OG001","title":"Standard of Care","description":"Subjects continued to receive SoC treatment but were not allowed to receive treatment with a complement inhibitor unless they qualified for pegcetacoplan escape therapy."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"18.90","spread":"2.909"},{"groupId":"OG001","value":"-2.85","spread":"5.703"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.0006","pValueComment":"P-value for baseline, strata and treatment is from LS mean of proc mixed and proc mianalyze based on parameter estimates.","statisticalMethod":"ANCOVA","paramType":"LS mean difference","paramValue":"21.75","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"9.35","ciUpperLimit":"34.16"}]},{"type":"SECONDARY","title":"Change From Baseline in Linear Analog Assessment (LASA) Scales Score at Week 26","description":"The LASA consisted of 3 items asking respondents to rate their perceived level of functioning. Specific domains include activity level, ability to carry out daily activities, and an item for overall QOL. Their level of functioning was reported on a 0-100 scale with 0 representing \"As low as could be\" and 100 representing \"As high as could be\".","populationDescription":"The ITT set included all subjects assigned to treatment.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"Standard Error","unitOfMeasure":"scores on a scale","timeFrame":"Baseline and Week 26","groups":[{"id":"OG000","title":"Pegcetacoplan","description":"Subjects were received SC infusion of pegcetacoplan 1080 mg twice weekly or every 3 days up to end of the RCP (Week 26). Subjects were not allowed to receive treatment with other complement inhibitors."},{"id":"OG001","title":"Standard of Care","description":"Subjects continued to receive SoC treatment but were not allowed to receive treatment with a complement inhibitor unless they qualified for pegcetacoplan escape therapy."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"35"},{"groupId":"OG001","value":"18"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"50.39","spread":"9.062"},{"groupId":"OG001","value":"-5.39","spread":"17.689"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.005","pValueComment":"P-value for baseline, strata and treatment is from LS mean of proc mixed and proc mianalyze based on parameter estimates.","statisticalMethod":"ANCOVA","paramType":"LS mean difference","paramValue":"55.79","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"16.83","ciUpperLimit":"94.74"}]},{"type":"SECONDARY","title":"Percentage of Subjects With ARC Normalization","description":"Absolute reticulocyte count normalization is defined as ARC \\< 1x ULN of the gender-specific normal range at week 26 in the absence of transfusion. Subjects who received a transfusion or withdraw from study or escaped from SoC to pegcetacoplan treatment group or lost to follow up without providing efficacy data at Week 26 were classified as non-responders. Transfusion refers to any transfusion of PRBC, LDPRC, LPRC, LPB or whole blood.","populationDescription