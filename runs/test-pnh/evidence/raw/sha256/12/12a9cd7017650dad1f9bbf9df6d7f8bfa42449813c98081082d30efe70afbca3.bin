tients enrolled and received treatment, excluding the patient who entered after the stopping rule was met.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"days","timeFrame":"Transplant (Day 0) up to 1 year","groups":[{"id":"OG000","title":"Overall","description":"Patients administered 40 mg of basiliximab as a single intravenous dose on day +7, +8, or +9 following infusion of allogeneic peripheral blood hematopoietic cells"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"16"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"12.0","lowerLimit":"8.0","upperLimit":"18.0"}]}]}]}]},"adverseEventsModule":{"frequencyThreshold":"5","timeFrame":"From transplant until the end of the study, for up to 2 years","eventGroups":[{"id":"EG000","title":"Overall","description":"Patients administered 40 mg of basiliximab as a single intravenous dose on day +7, +8, or +9 following infusion of allogeneic peripheral blood hematopoietic cells","seriousNumAffected":7,"seriousNumAtRisk":17,"otherNumAffected":17,"otherNumAtRisk":17}],"seriousEvents":[{"term":"CARDIAC ARRHYTHMIA - OTHER","organSystem":"Cardiac disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":17}]},{"term":"CONDUCTION ABNORMALITY/ATRIOVENTRICULAR HEART BLOCK - ASYSTOLE","organSystem":"Cardiac disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":17}]},{"term":"DIARRHEA","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":17}]},{"term":"GASTROINTESTINAL - OTHER","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000",