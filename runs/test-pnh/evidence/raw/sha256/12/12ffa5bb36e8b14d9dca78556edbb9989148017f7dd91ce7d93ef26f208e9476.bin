 to 144 weeks.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"12\"},{\"groupId\":\"OG001\",\"value\":\"7\"}]}],\"classes\":[{\"title\":\"Baseline\",\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"12\"},{\"groupId\":\"OG001\",\"value\":\"7\"}]}],\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"11.88\",\"spread\":\"1.688\"},{\"groupId\":\"OG001\",\"value\":\"11.53\",\"spread\":\"1.803\"}]}]},{\"title\":\"Change at Week 24\",\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"11\"},{\"groupId\":\"OG001\",\"value\":\"6\"}]}],\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"0.75\",\"spread\":\"1.159\"},{\"groupId\":\"OG001\",\"value\":\"-1.32\",\"spread\":\"2.578\"}]}]},{\"title\":\"Change at Week 48\",\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"8\"},{\"groupId\":\"OG001\",\"value\":\"2\"}]}],\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"-0.61\",\"spread\":\"1.974\"},{\"groupId\":\"OG001\",\"value\":\"-0.95\",\"spread\":\"2.333\"}]}]},{\"title\":\"Change at Week 72\",\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"8\"},{\"groupId\":\"OG001\",\"value\":\"3\"}]}],\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"-0.64\",\"spread\":\"2.327\"},{\"groupId\":\"OG001\",\"value\":\"-0.93\",\"spread\":\"1.484\"}]}]},{\"title\":\"Change at Week 96\",\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"8\"},{\"groupId\":\"OG001\",\"value\":\"2\"}]}],\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"-0.33\",\"spread\":\"1.914\"},{\"groupId\":\"OG001\",\"value\":\"-0.70\",\"spread\":\"2.687\"}]}]},{\"title\":\"Change at Week 120\",\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"8\"},{\"groupId\":\"OG001\",\"valu