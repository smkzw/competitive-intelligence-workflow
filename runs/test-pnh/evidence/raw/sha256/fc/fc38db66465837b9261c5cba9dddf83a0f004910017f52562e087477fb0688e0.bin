to 4 (Very much). Total scores range from 0 to 52, with higher score indicating better quality of life.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"units on a scale\",\"timeFrame\":\"From time of first infusion through 24 months of study treatment\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Eculizumab\",\"description\":\"eculizumab: 600 mg intravenous infusion every week x 4 then 900 mg iv every two weeks\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"184\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"9.24\",\"spread\":\"12.42\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Incidence of Thrombosis After Eculizumab Infusion\",\"description\":\"Thrombosis was defined as occurrence of major adverse vascular events\",\"reportingStatus\":\"POSTED\",\"paramType\":\"NUMBER\",\"unitOfMeasure\":\"Number of events per 100 patient-years\",\"timeFrame\":\"From time of first ever dose through last dose (up to 24 months of study treatment)\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Eculizumab\",\"description\":\"eculizumab: 600 mg intravenous infusion every week x 4 then 900 mg iv every two weeks\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"184\"}]}],\"classes\":[{\"title\":\"Prior to first eculizumab dose\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"7.82\"}]}]},{\"title\":\"From first dose of eculizumab through last dose\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"1.99\"}]}]}]}]},\"adverseEventsModule\":{\"frequencyThreshold\":\"5\",\"timeFrame\":\"From time of consent to a maximum of 2.5 years of study treatment\",\"eventGroups\":[{\"id\":\"EG000\",\"title\":\"Eculizumab\",\"description\":\"eculizumab: 600 mg intravenous infusion every week x 4 then 900 mg iv every two weeks\",\"deathsNumAffected\":3,\"deathsNumAtRisk\":18