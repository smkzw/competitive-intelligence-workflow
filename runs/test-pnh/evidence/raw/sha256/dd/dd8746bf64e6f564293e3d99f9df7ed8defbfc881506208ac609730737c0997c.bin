5; 900 mg Q2W."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"7"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"-60634","spread":"72916"}]}]}]},{"type":"SECONDARY","title":"Concentration Of Plasma-free Hemoglobin At Baseline And Week 12","description":"Plasma-free hemoglobin was determined for each participant by using standard laboratory assays. The values of plasma-free hemoglobin were summarized by visit.","populationDescription":"ITT Population: Participants who received at least 1 dose of study drug.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"mg per deciliter (mg/dL)","timeFrame":"Baseline, EOT (Day 84 [Week 12]) or ET","groups":[{"id":"OG000","title":"Eculizumab","description":"Eculizumab was administered as an IV infusion for 12 weeks. All participants weighed more than 45 kg and received the following weight-based dosing regimen: induction/loading = 600 mg weekly x 4; maintenance = 900 mg at Wk 5; 900 mg Q2W."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"7"}]}],"classes":[{"title":"Baseline","categories":[{"measurements":[{"groupId":"OG000","value":"17.70","spread":"19.091"}]}]},{"title":"Week 12","categories":[{"measurements":[{"groupId":"OG000","value":"7.44","spread":"3.145"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline In LDH Levels","description":"Levels of LDH were determined by using standard laboratory assays. LDH values and the change of LDH from baseline were summarized by visit.","populationDescription":"ITT Population: Participants who received at least 1 dose of study drug.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"U/L","timeFrame":"Baseline, Weeks 1 to 12 or ET","groups":[{"id":"OG000","title":"Eculizumab","description":"Eculizumab was administered as an IV infusion for 12 weeks. All participants weighed more than 45 kg and received the following weight-based dosing regimen: induction/loading = 600 mg weekly x 4; maintenance = 900 mg at Wk 5; 900 mg Q2W."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"7"}]}],"classes":[{"title":"Baseline","categories":[{"measurements":[{"groupId":"OG000","value":"1020","spread":"967"}]}]},{"title":"Change from baseline at Week 1","categories":[{"measurements":[{"groupId":"OG000","value":"-672","spread":"837"}]}]},{"title":"Change from baseline at Week 2","categories":[{"measurements":[{"groupId":"OG000","value":"-763","spread":"916"}]}]},{"title":"Change from baseline at Week 3","categories":[{"measurements":[{"groupId":"OG000","value":"-752","spread":"934"}]}]},{"title":"Change from baseline at Week 4","categories":[{"measurements":[{"groupId":"OG000","value":"-761","spread":"924"}]}]},{"title":"Change from baseline at Week 8","categories":[{"measurements":[{"groupId":"OG000","value":"-747","spread":"904"}]}]},{"title":"Change from baseline at Week 12","categories":[{"measurements":[{"groupId":"OG000","value":"-771","spread":"914"}]}]}]}]},"adverseEventsModule":{"frequencyThreshold":"0","timeFrame":"First dose of study drug (Day 0) to End of Follow-up (Week 20 [8 weeks after EOT])","eventGroups":[{"id":"EG000","title":"Eculizumab","description":"Eculizumab was administered as an IV infusion for 12 weeks. All participants weighed more than 45 kg and received the following weight-based dosing regimen: induction/loading = 600 mg weekly x 4; maintenance = 900 mg at Wk 5; 900 mg Q2W.","seriousNumAffected":2,"seriousNumAtRisk":7,"otherNumAffected":7,"otherNumAtRisk":7}],"seriousEvents":[{"term":"Anaemia","organSystem":"Blood and lymphatic system disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Aplastic anaemia","organSystem":"Blood and lymphatic system disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Thrombocytopenia","organSystem":"Blood and lymphatic system disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Headache","organSystem":"Nervous system disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Menorrhagia","organSystem":"Reproductive system and breast disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","notes":"Includes only female participants.","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":4}]},{"term":"Vaginal haemorrhage","organSystem":"Reproductive system and breast disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","notes":"Includes only female participants.","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":4}]},{"term":"Acute sinusitis","organSystem":"Infections and infestations","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Catheter site cellulitis","organSystem":"Infections and infestations","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Otitis media acute","organSystem":"Infections and infestations","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]}],"otherEvents":[{"term":"Haemolysis","organSystem":"Blood and lymphatic system disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Lymph node pain","organSystem":"Blood and lymphatic system disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Abdominal pain upper","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":7}]},{"term":"Diarrhoea","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Nausea","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Fatigue","organSystem":"General disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Pyrexia","organSystem":"General disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":7}]},{"term":"Upper respiratory tract infection","organSystem":"Infections and infestations","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":7}]},{"term":"Contusion","organSystem":"Injury, poisoning and procedural complications","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Blood glucose increased","organSystem":"Investigations","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Decreased appetite","organSystem":"Metabolism and nutrition disorders","sourceVocabulary":"MedDRA (13.0)","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":7}]},{"term":"Pain in extremity","organSystem":"Musculoskeletal and c