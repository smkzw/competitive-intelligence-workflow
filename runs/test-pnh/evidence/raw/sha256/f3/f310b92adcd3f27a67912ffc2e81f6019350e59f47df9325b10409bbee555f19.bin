upId":"OG000","value":"-59.80","spread":"14.217"}]}]},{"title":"Change at Week 145","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"2"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-52.43","spread":"2.779"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in Free Hgb at Weeks 49 and 169","description":"Change from Baseline = free Hgb at specified postbaseline visit - Baseline free Hgb. Baseline was the baseline value from the primary Study ACH471-100.","populationDescription":"Full analysis set included all enrolled and treated participants. Here, 'Overall number of participants analyzed' = participants with both baseline and the postbaseline assessments for free Hgb. 'Number analyzed' = participants evaluable at specified timepoint.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"mg/dL","timeFrame":"Baseline, Weeks 49 and 169","groups":[{"id":"OG000","title":"Danicopan","description":"Participants in this study continued to receive danicopan tablets orally at the same dose (150, 175, or 200 milligrams \\[mg\\] 3 times daily \\[TID\\]) that they were receiving upon completion of the primary Study ACH471-100. Dose escalation was done in increments of 25 mg to a maximum of 250 mg TID, in case additional clinical benefit was expected as per Investigator and Sponsor decision."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"6"}]}],"classes":[{"title":"Change at Week 49","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"6"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"105.92","spread":"92.308"}]}]},{"title":"Change at Week 169","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"2"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-30.75","spread":"54.942"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in Functional Assessment of Chronic Illness Therapy (FACIT)-Fatigue Scale Score at Weeks 21, 41, and 153","description":"The FACIT-Fatigue scale is a collection of quality of life questionnaires pertaining to the management of fatigue symptoms due to a chronic illness. The FACIT-Fatigue is a 13-item questionnaire that assesses self-reported fatigue and its impact upon daily activities and function over the preceding 7 days. Participants score each item on a 5-point scale: 0 (Not at all) to 4 (Very much). Total scores range from 0 to 52, with higher score indicating better quality of life.","populationDescription":"Full analysis set included all enrolled and treated participants. Here, 'Overall number of participants analyzed' = participants with both baseline and the postbaseline assessments for FACIT-Fatigue scale score. 'Number analyzed' = participants evaluable at specified timepoint.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"units on a scale","timeFrame":"Baseline, Weeks 21, 41, and 153","groups":[{"id":"OG000","title":"Danicopan","description":"Participants in this study continued to receive danicopan tablets orally at the same dose (150, 175, or 200 milligrams \\[mg\\] 3 times daily \\[TID\\]) that they were receiving upon completion of the primary Study ACH471-100. Dose escalation was done in increments of 25 mg to a maximum of 250 mg TID, in case additional clinical benefit was expected as per Investigator and Sponsor decision."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"8"}]}],"classes":[{"title":"Change at Week 21","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"8"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"8.4","spread":"11.75"}]}]},{"title":"Change at Week 41","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"7"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"9.1","spread":"13.37"}]}]},{"title":"Change at Week 153","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"2"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"3.0","spread":"0.00"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in European Organisation for Research and Treatment of Cancer, Quality of Life Questionnaire-Core 30 Scale (EORTC-QLQ-C30): Global Health Status/Qol Score at Weeks 21, 41, and 153","description":"EORTC-QLQ-C30 is comprised of 30 questions. First 28 questions used 4-point scale (1=not at all,2=a little,3=quite a bit,4=very much) for evaluating 5 functional scales (physical, role, emotional, cognitive, social), 3 symptom scales (fatigue, nausea/vomiting, pain) \\& other single items. For each item, high score = high level of symptomatology/problem. Last 2 questions represented participant's assessment of overall health (global health status) and quality of life, coded on 7-point scale (1=very poor to 7=excellent). Answers were converted into grading scale, with total score between 0 and 100. A high score represented a favourable outcome with a best quality of life for participant.","populationDescription":"Full analysis set included all enrolled and treated participants. Here, 'Overall number of participants analyzed' = participants with both baseline and the postbaseline assessments for EORTC-QLQ-C30 (Global Health Status/Qol) score. 'Number analyzed' = participants evaluable at specified timepoint.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"units on a scale","timeFrame":"Baseline, Weeks 21, 41, and 153","groups":[{"id":"OG000","title":"Danicopan","description":"Participants in this study continued to receive danicopan tablets orally at the same dose (150, 175, or 200 milligrams \\[mg\\] 3 times daily \\[TID\\]) that they were receiving upon completion of the primary Study ACH471-100. Dose escalation was done in increments of 25 mg to a maximum of 250 mg TID, in case additional clinical benefit was expected as per Investigator and Sponsor decision."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"8"}]}],"classes":[{"title":"Change at Week 21","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"8"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"16.67","spread":"25.973"}]}]},{"title":"Change at Week 41","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"7"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"11.90","spread":"29.603"}]}]},{"title":"Change at Week 153","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"2"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"4.17","spread":"17.678"}]}]}]}]},"adverseEventsModule":{"frequencyThreshold":"5","timeFrame":"Baseline up to 4.5 years","description":"Safety analysis set included all enrolled participants who received at least 1 dose of danicopan.","eventGroups":[{"id":"EG000","title":"Danicopan","description":"Participants in this study continued to receive danicopan tablets orally at the same dose (150, 175, or 200 milligrams \\[mg\\] 3 times daily \\[TID\\]) that they were receiving upon completion of the primary Study ACH471-100. Dose escalation was done in increments of 25 mg to a maximum of 250 mg TID, in case additional clinical benefit was expected as per Investigator and Sponsor decision.","deathsNumAffected":0,"deathsNumAtRisk":8,"seriousNumAffected":3,"seriousNumAtRisk":8,"otherNumAffected":8,"otherNumAtRisk":8}],"seriousEvents":[{"term":"Cystitis","organSystem":"Infections and infestations","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]},{"term":"Gastroenteritis","organSystem":"Infections and infestations","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]},{"term":"Infectious mononucleosis","organSystem":"Infections and infestations","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]},{"term":"Haemolysis","organSystem":"Blood and lymphatic system disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]},{"term":"Pyrexia","organSystem":"General disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]}],"otherEvents":[{"term":"Dysphagia","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":8}]},{"term":"Abdominal pain","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":8}]},{"term":"Nausea","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":8}]},{"term":"Constipation","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]},{"term":"Diarrhoea","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]},{"term":"Gastrooesophageal reflux disease","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]},{"term":"Vomiting","organSystem":"Gastrointestinal disorders","sourceVocabulary":"MedDRA 23.0","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":8}]},{"term":"Non-cardiac chest pain","organSyste