\":\"Ōshū\",\"zip\":\"023-0864\",\"country\":\"Japan\",\"geoPoint\":{\"lat\":39.13927,\"lon\":141.1685}},{\"facility\":\"NTT Medical Center Tokyo\",\"city\":\"Tokyo\",\"zip\":\"141-8625\",\"country\":\"Japan\",\"geoPoint\":{\"lat\":35.6895,\"lon\":139.69171}},{\"facility\":\"Tokyo Medical University Hospital\",\"city\":\"Tokyo\",\"zip\":\"160-0023\",\"country\":\"Japan\",\"geoPoint\":{\"lat\":35.6895,\"lon\":139.69171}},{\"facility\":\"Toyama Prefectual Central Hospital\",\"city\":\"Toyama\",\"zip\":\"930-8550\",\"country\":\"Japan\",\"geoPoint\":{\"lat\":36.7,\"lon\":137.21667}},{\"facility\":\"Amsterdam UMC, Locatie AMC\",\"city\":\"Amsterdam\",\"zip\":\"1105 AZ\",\"country\":\"Netherlands\",\"geoPoint\":{\"lat\":52.37403,\"lon\":4.88969}},{\"facility\":\"Szpital Uniwersytecki nr2 im. dr J. Biziela\",\"city\":\"Bydgoszcz\",\"zip\":\"85-168\",\"country\":\"Poland\",\"geoPoint\":{\"lat\":53.1235,\"lon\":18.00762}},{\"facility\":\"Uniwersyteckie Centrum Kliniczne\",\"city\":\"Gda?sk\",\"zip\":\"80-214\",\"country\":\"Poland\"},{\"facility\":\"Samodzielny Publiczny Szpital Kliniczny nr 1\",\"city\":\"Lublin\",\"zip\":\"20-081\",\"country\":\"Poland\",\"geoPoint\":{\"lat\":51.25058,\"lon\":22.57009}},{\"facility\":\"Pratia Poznan\",\"city\":\"Skórzewo\",\"zip\":\"60-185\",\"country\":\"Poland\",\"geoPoint\":{\"lat\":53.03629,\"lon\":17.81889}},{\"facility\":\"MTZ Clinical Research Powered by Pratia\",\"city\":\"Warsaw\",\"zip\":\"02-172\",\"country\":\"Poland\",\"geoPoint\":{\"lat\":52.22977,\"lon\":21.01178}},{\"facility\":\"Centro Hospitalar do Baixo Vouga E.P.E. - Hospital de Aveiro\",\"city\":\"Aveiro\",\"zip\":\"3814-501\",\"country\":\"Portugal\",\"geoPoint\":{\"lat\":40.64575,\"lon\":-8.64643}},{\"facility\":\"Centro Hospitalar do Porto - Hospital de Santo António\",\"city\":\"Porto\",\"zip\":\"4099-001\",\"country\":\"Portugal\",\"geoPoint\":{\"lat\":41.1485,\"lon\":-8.61097}},{\"facility\":\"King Faisal Specialist Hospital & Research Center\",\"city\":\"Riyadh