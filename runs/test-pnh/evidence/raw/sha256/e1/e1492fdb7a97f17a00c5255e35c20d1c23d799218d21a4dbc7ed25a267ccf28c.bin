 nutrition disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":35,\"numAffected\":35,\"numAtRisk\":129}]},{\"term\":\"Hypokalemia\",\"organSystem\":\"Metabolism and nutrition disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":60,\"numAffected\":60,\"numAtRisk\":129}]},{\"term\":\"Hyponatremia\",\"organSystem\":\"Metabolism and nutrition disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":35,\"numAffected\":35,\"numAtRisk\":129}]},{\"term\":\"Hypophosphatemia\",\"organSystem\":\"Metabolism and nutrition disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":48,\"numAffected\":48,\"numAtRisk\":129}]},{\"term\":\"Leukocytes\",\"organSystem\":\"Blood and lymphatic system disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":125,\"numAffected\":125,\"numAtRisk\":129}]},{\"term\":\"Lymphopenia\",\"organSystem\":\"Blood and lymphatic system disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":125,\"numAffected\":125,\"numAtRisk\":129}]},{\"term\":\"Neutrophils\",\"organSystem\":\"Blood and lymphatic system disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":123,\"numAffected\":123,\"numAtRisk\":129}]},{\"term\":\"Platelets\",\"organSystem\":\"Blood and lymphatic system disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":124,\"numAffected\":124,\"numAtRisk\":129}]},{\"term\":\"Prothrombin time (PT)\",\"organSystem\":\"Blood and lymphatic system disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":11,\"numAffected\":11,\"numAtRisk\":129}]},{\"term\":\"Partial thromboplastin time (PTT)\",\"organSystem\":\"Blood and lymphatic system disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":22,\"numAffected\":22,\"numAtRisk\":129}]},{\"term\":\"SGOT (AST)\",\"organSystem\":\"Blood and lymphatic system disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":28,\"numAffected\":28,\"numAtRisk\":129}]},{\"term\":\"SGPT (ALT)\",\"organSystem\":\"Blood and lymphatic system disorders\",\"sourceVocabulary\":\"CTC-2.0\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":42,\"numAffected\":42,\"numAtRisk\":129}]}]},\"moreInfoModule\":{\"certainAgreement\":{\"piSponsorEmployee\":true,\"restrictiveAgreement\":false},\"pointOfContact\":{\"title\":\"Dr. Ann Jakubowski\",\"organization\":\"Memorial Sloan-Kettering Cancer Center\",\"email\":\"jakubowa@mskcc.org\",\"phone\":\"212-639-5013\"}}},\"derivedSection\":{\"miscInfoModule\":{\"versionHolder\":\"2026-09-18\"},\"conditionBrowseModule\":{\"meshes\":[{\"id\":\"D007938\",\"term\":\"Leukemia\"},{\"id\":\"D054198\",\"term\":\"Precursor Cell Lymphoblastic Leukemia-Lymphoma\"},{\"id\":\"D009190\",\"term\":\"Myelodysplastic Syndromes\"},{\"id\":\"D006457\",\"term\":\"Hemoglobinuria, Paroxysmal\"}],\"ancestors\":[{\"id\":\"D009370\",\"term\":\"Neoplasms by Histologic Type\"},{\"id\":\"D009369\",\"term\":\"Neoplasms\"},{\"id\":\"D006402\",\"term\":\"Hematologic Diseases\"},{\"id\":\"D006425\",\"term\":\"Hemic and Lymphatic Diseases\"},{\"id\":\"D007945\",\"term\":\"Leukemia, Lymphoid\"},{\"id\":\"D008232\",\"term\":\"Lymphoproliferative Disorders\"},{\"id\":\"D008206\",\"term\":\"Lymphatic Diseases\"},{\"id\":\"D007160\",\"term\":\"Immunoproliferative Disorders\"},{\"id\":\"D007154\",\"term\":\"Immune System Diseases\"},{\"id\":\"D001855\",\"term\":\"Bone Marrow Diseases\"},{\"id\":\"D000743\",\"term\":\"Anemia, Hemolytic\"},{\"id\":\"D000740\",\"term\":\"Anemia\"}]}},\"hasResults\":true}", "media_type": "application/json", "text_derivation": {"extractor_version": "stdlib-json-object-slice-v1", "method": "ctgov-study-json-v1", "raw_asset": {"byte_size": 755752, "media_type": "application/json", "relative_path": "evidence/raw/sha256/5d/5dd12c54d3a576e19b9631428ca8595659384a5b98a42bd3e57279bf004d0d96.bin", "sha256": "5dd12c54d3a576e19b9631428ca8595659384a5b98a42bd3e57279bf004d0d96"}, "record_selector": {"nct_id": "NCT00587054", "study_index": 15}, "schema_version": "1.0", "text_sha256": "11a1948df1dbf5dd9f6faf8c79d771ce0cbe3d02fa03cef2f6c8be958ffc7c6b"}}