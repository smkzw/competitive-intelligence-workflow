{"content_text": "{\"protocolSection\":{\"identificationModule\":{\"nctId\":\"NCT00438789\",\"orgStudyIdInfo\":{\"id\":\"C06-002\"},\"organization\":{\"fullName\":\"Alexion Pharmaceuticals, Inc.\",\"class\":\"INDUSTRY\"},\"briefTitle\":\"The Paroxysmal Nocturnal Hemoglobinuria Early Access Treatment Protocol\",\"acronym\":\"EMBRACE\"},\"statusModule\":{\"statusVerifiedDate\":\"2011-09\",\"overallStatus\":\"APPROVED_FOR_MARKETING\",\"studyFirstSubmitDate\":\"2007-02-20\",\"studyFirstSubmitQcDate\":\"2007-02-21\",\"studyFirstPostDateStruct\":{\"date\":\"2007-02-22\",\"type\":\"ESTIMATED\"},\"lastUpdateSubmitDate\":\"2014-05-05\",\"lastUpdatePostDateStruct\":{\"date\":\"2014-05-06\",\"type\":\"ESTIMATED\"}},\"sponsorCollaboratorsModule\":{\"responsibleParty\":{\"oldNameTitle\":\"Maria Whelden\",\"oldOrganization\":\"Alexion Pharmaceuticals\"},\"leadSponsor\":{\"name\":\"Alexion Pharmaceuticals, Inc.\",\"class\":\"INDUSTRY\"}},\"descriptionModule\":{\"briefSummary\":\"The primary objective is to provide access to eculizumab for PNH patient pending commercial availability.\"},\"conditionsModule\":{\"conditions\":[\"Hemoglobinuria, Paroxysmal\"]},\"designModule\":{\"studyType\":\"EXPANDED_ACCESS\"},\"armsInterventionsModule\":{\"interventions\":[{\"type\":\"DRUG\",\"name\":\"eculizumab\",\"description\":\"600mg IV every week and 900mg IV every 2 weeks\"}]},\"eligibilityModule\":{\"eligibilityCriteria\":\"Inclusion Criteria:\\n\\n* PNH;\\n* At least 18 years old\\n* Avoid conception; and\\n* Willing and able to give written informed consent\\n\\nExclusion Criteria:\\n\\n* Active bacterial infection\\n* Participation in any other drug trial\\n* Pregnant breast feeding, or intending to conceive\\n* Not vaccinated against N meningitidis\",\"sex\":\"ALL\",\"minimumAge\":\"18 Years\",\"stdAges\":[\"ADULT\",\"OLDER_ADULT\"]},\"contactsLocationsModule\":{\"locations\":[{\"facility\":\"Anthony Botti\",\"city\":\"Livingston\",\"state\":\"New Jersey\",\"country\":\"United States\",\"geoPoint\":{\"lat\":40.79593,\"lon\":-74.31487}}]}},\"derivedSection\":{\"miscInfoModule\":{\"versionHolder\":\"2026-09-18\"},\"conditionBrowseModule\":{\"meshes\":[{\"id\":\"D006457\",\"term\":\"Hemoglobinuria, Paroxysmal\"}],\"ancestors\":[{\"id\":\"D000743\",\"term\":\"Anemia, Hemolytic\"},{\"id\":\"D000740\",\"term\":\"Anemia\"},{\"id\":\"D006402\",\"term\":\"Hematologic Diseases\"},{\"id\":\"D006425\",\"term\":\"Hemic and Lymphatic Diseases\"},{\"id\":\"D009190\",\"term\":\"Myelodysplastic Syndromes\"},{\"id\":\"D001855\",\"term\":\"Bone Marrow Diseases\"}]},\"interventionBrowseModule\":{\"meshes\":[{\"id\":\"C481642\",\"term\":\"eculizumab\"}]}},\"hasResults\":false}", "media_type": "application/json", "text_derivation": {"extractor_version": "stdlib-json-object-slice-v1", "method": "ctgov-study-json-v1", "raw_asset": {"byte_size": 666988, "media_type": "application/json", "relative_path": "evidence/raw/sha256/7c/7ce4995256632f1ce93e0e7444e375fecb7379ed09eb6dc461c4c809907a31f1.bin", "sha256": "7ce4995256632f1ce93e0e7444e375fecb7379ed09eb6dc461c4c809907a31f1"}, "record_selector": {"nct_id": "NCT00438789", "study_index": 6}, "schema_version": "1.0", "text_sha256": "edbe3b139c213a65fed2bed2aaa65b1d9a55a2b4e7522b965390eb6e8b3a9429"}}