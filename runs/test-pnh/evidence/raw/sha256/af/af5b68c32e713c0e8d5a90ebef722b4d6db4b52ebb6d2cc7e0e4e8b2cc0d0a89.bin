)\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":1,\"numAffected\":1,\"numAtRisk\":4}]}]},\"moreInfoModule\":{\"limitationsAndCaveats\":{\"description\":\"Given the small sample size, no conclusions should be drawn from the results summarized and reported as descriptive statistics in Outcome Measures 9-12.\"},\"certainAgreement\":{\"piSponsorEmployee\":false,\"restrictiveAgreement\":true},\"pointOfContact\":{\"title\":\"Apellis Clinical Trial Information Line\",\"organization\":\"Apellis Pharmaceuticals, Inc\",\"email\":\"clinicaltrials@apellis.com\",\"phone\":\"1-833-284-6361\"}}},\"documentSection\":{\"largeDocumentModule\":{\"largeDocs\":[{\"typeAbbrev\":\"Prot\",\"hasProtocol\":true,\"hasSap\":false,\"hasIcf\":false,\"label\":\"Study Protocol\",\"date\":\"2018-01-31\",\"uploadDate\":\"2020-07-23T23:05\",\"filename\":\"Prot_000.pdf\",\"size\":2136488},{\"typeAbbrev\":\"SAP\",\"hasProtocol\":false,\"hasSap\":true,\"hasIcf\":false,\"label\":\"Statistical Analysis Plan\",\"date\":\"2019-07-17\",\"uploadDate\":\"2020-07-23T23:07\",\"filename\":\"SAP_001.pdf\",\"size\":4946878}]}},\"derivedSection\":{\"miscInfoModule\":{\"versionHolder\":\"2026-09-18\",\"removedCountries\":[\"Greece\",\"Poland\",\"Romania\"],\"submissionTracking\":{\"firstMcpInfo\":{\"postDateStruct\":{\"date\":\"2020-08-18\",\"type\":\"ACTUAL\"}}}},\"conditionBrowseModule\":{\"meshes\":[{\"id\":\"D006457\",\"term\":\"Hemoglobinuria, Paroxysmal\"},{\"id\":\"D000740\",\"term\":\"Anemia\"},{\"id\":\"D006456\",\"term\":\"Hemoglobinuria\"},{\"id\":\"D006461\",\"term\":\"Hemolysis\"},{\"id\":\"D006402\",\"term\":\"Hematologic Diseases\"}],\"ancestors\":[{\"id\":\"D000743\",\"term\":\"Anemia, Hemolytic\"},{\"id\":\"D006425\",\"term\":\"Hemic and Lymphatic Diseases\"},{\"id\":\"D009190\",\"term\":\"Myelodysplastic Syndromes\"},{\"id\":\"D001855\",\"term\":\"Bone Marrow Diseases\"},{\"id\":\"D011507\",\"term\":\"Proteinuria\"},{\"id\":\"D014555\",\"term\":\"Urin