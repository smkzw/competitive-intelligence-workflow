{"content_text": "{\"protocolSection\":{\"identificationModule\":{\"nctId\":\"NCT03593200\",\"orgStudyIdInfo\":{\"id\":\"APL2-202\"},\"organization\":{\"fullName\":\"Apellis Pharmaceuticals, Inc.\",\"class\":\"INDUSTRY\"},\"briefTitle\":\"A Phase IIa Study to Assess the Safety, Efficacy, and Pharmacokinetics of Subcutaneously Administered Pegcetacoplan (APL-2) in Subjects With PNH\",\"officialTitle\":\"Phase IIa, Open Label, Multiple Dose Study to Assess the Safety, Efficacy and Pharmacokinetics of Subcutaneously Administered APL-2 in Subjects With Paroxysmal Nocturnal Hemoglobinuria (PNH).\"},\"statusModule\":{\"statusVerifiedDate\":\"2020-12\",\"overallStatus\":\"COMPLETED\",\"startDateStruct\":{\"date\":\"2018-08-16\",\"type\":\"ACTUAL\"},\"primaryCompletionDateStruct\":{\"date\":\"2019-10-22\",\"type\":\"ACTUAL\"},\"completionDateStruct\":{\"date\":\"2019-10-22\",\"type\":\"ACTUAL\"},\"studyFirstSubmitDate\":\"2018-06-28\",\"studyFirstSubmitQcDate\":\"2018-07-10\",\"studyFirstPostDateStruct\":{\"date\":\"2018-07-20\",\"type\":\"ACTUAL\"},\"resultsFirstSubmitDate\":\"2020-08-04\",\"resultsFirstSubmitQcDate\":\"2020-12-21\",\"resultsFirstPostDateStruct\":{\"date\":\"2020-12-22\",\"type\":\"ACTUAL\"},\"lastUpdateSubmitDate\":\"2020-12-21\",\"lastUpdatePostDateStruct\":{\"date\":\"2020-12-22\",\"type\":\"ACTUAL\"}},\"sponsorCollaboratorsModule\":{\"responsibleParty\":{\"type\":\"SPONSOR\"},\"leadSponsor\":{\"name\":\"Apellis Pharmaceuticals, Inc.\",\"class\":\"INDUSTRY\"}},\"oversightModule\":{\"oversightHasDmc\":true,\"isFdaRegulatedDrug\":true,\"isFdaRegulatedDevice\":false},\"descriptionModule\":{\"briefSummary\":\"This is a Phase IIa, open-label, multiple dose, study in patients with PNH who have not received eculizumab (Soliris ®) in the past. A single cohort of subjects is planned for evaluation.\"},\"conditionsModule\":{\"conditions\":[\"PNH\"],\"keywords\":[\"PNH\",\"Paroxysmal Nocturnal Hemoglobinuria\",\"Complement inhibitor\",\"Anemia\",\"Hemoglobinuria\",\"Hemolysis\",\"Hematologic diseases\",\"Extravascular hemolysis (EVH)\",\"Intravascular hemolysis (IVH)\",\"C3 inhibitor\"]},\"designModule\":{\"studyType\":\"INTERVENTIONAL\",\"phases\":[\"PHASE2\"],\"designInfo\":{\"allocation\":\"NA\",\"interventionModel\":\"SINGLE_GROUP\",\"primaryPurpose\":\"TREATMENT\",\"maskingInfo\":{\"masking\":\"NONE\"}},\"enrollmentInfo\":{\"count\":4,\"type\":\"ACTUAL\"}},\"armsInterventionsModule\":{\"armGroups\":[{\"label\":\"Experimental: Cohort 1\",\"type\":\"EXPERIMENTAL\",\"description\":\"270 mg/day (up to 360 mg/day from Day 29) from Day 1 to Day 364\\\\*\",\"interventionNames\":[\"Drug: Pegcetacoplan\"]}],\"interventions\":[{\"type\":\"DRUG\",\"name\":\"Pegcetacoplan\",\"description\":\"Complement (C3) Inhibitor\",\"armGroupLabels\":[\"Experimental: Cohort 1\"],\"otherNames\":[\"APL-2\"]}]},\"outcomesModule\":{\"primaryOutcomes\":[{\"measure\":\"Number of Subjects With Treatment Emergent Adverse Events (TEAEs) Including by Severity\",\"description\":\"TEAEs were defined as adverse events (AE) that occurred after dosing on Day 1 and up to 30 days after the last dose of study drug. A treatment-related TEAE was defined as a TEAE with a relationship to study drug of possible, probable, or definite. TEAEs were graded according to the Common Terminology Criteria for Adverse Events (v4.03) based on: Grade 1: Mild, Grade 2: Moderate, Grade 3: Severe, Grade 4: Life-threatening, Grade 5: Death related to AE.\",\"timeFrame\":\"From Day 1 to 30 days after the last dose (approximately 56 weeks)\"},{\"measure\":\"Mean Change From Baseline in Lactate Dehydrogenase (LDH) Level\",\"description\":\"Serum chemistry assessments of LDH were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"timeFrame\":\"Baseline and Day 365\"},{\"measure\":\"Mean Change From Baseline in Haptoglobin Level\",\"description\":\"Serum chemistry assessments of haptoglobin were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"timeFrame\":\"Baseline and Day 365\"},{\"measure\":\"Mean Change From Baseline in Hemoglobin (Hb) Level\",\"description\":\"Hematology assessments of Hb were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"timeFrame\":\"Baseline and Day 365\"}],\"secondaryOutcomes\":[{\"measure\":\"Mean Change From Baseline in Functional Assessment of Chronic Illness Therapy (FACIT)-Fatigue Score\",\"description\":\"The FACIT-Fatigue scale is a 13 item Likert scaled instrument where the subject was presented with 13 statements and asked to indicate their response as it applied to the past 7 days. The 5 possible responses were 'Not at all' (0), 'A little bit (1), 'Somewhat' (2), 'Quite a bit' (3) and 'Very much' (4). With 13 statements the total score had a range of 0 to 52. Higher score corresponds to a higher quality of life (QoL).\",\"timeFrame\":\"Baseline and Day 365\"},{\"measure\":\"Mean Change From Baseline in Absolute Reticulocyte Count (ARC) Level\",\"description\":\"Hematology assessments of ARC were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"timeFrame\":\"Baseline and Day 365\"},{\"measure\":\"Mean Change From Baseline in Total Bilirubin Level\",\"description\":\"Serum chemistry assessments of total bilirubin were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"timeFrame\":\"Baseline and Day 365\"},{\"measure\":\"Mean Number of Red Blood Cell (RBC) Transfusions Per Month\",\"description\":\"The number of on-study RBC transfusions was monitored throughout the treatment period.\",\"timeFrame\":\"From Day 1 to Day 364\"},{\"measure\":\"Mean Change From Baseline in Linear Analog Scale Assessment (LASA) Score for QoL\",\"description\":\"The LASA consists of 3 items, where the respondents were asked to rate their perceived level of functioning. Specific domains included activity level, ability to carry out daily activities, and an item for overall QoL. Their level of functioning was reported on a 0 to 100 scale with 0 indicates \\\"As low as could be\\\" and 100 indicates \\\"As high as could be\\\". The combined score ranged from 0 to 300, with higher scores corresponding to a higher QoL.\",\"timeFrame\":\"Baseline and Day 365\"},{\"measure\":\"Mean Serum Concentrations of Pegcetacoplan\",\"description\":\"Serum concentrations of pegcetacoplan at Day 365 are presented.\",\"timeFrame\":\"Day 365\"},{\"measure\":\"Mean Area Under the Serum Concentration Versus Time Curve From Time 0 to the Last Measurable Concentration at the End of the Study (AUCtotal)\",\"description\":\"The AUCtotal of pegcetacoplan was estimated using a non-compartmental approach.\",\"timeFrame\":\"Blood samples were collected predose and at least 2.5 hours post dose on Day 1 and predose on Days 2 up to Day 365.\"},{\"measure\":\"Mean Maximum Observed Predose Serum Concentration During the Study (Ctrough,Max,Total)\",\"description\":\"The Ctrough,max,total of pegcetacoplan was estimated using a non-compartmental approach.\",\"timeFrame\":\"Blood samples were collected predose and at least 2.5 hours post dose on Day 1 and predose on Days 2 up to Day 365.\"}]},\"eligibilityModule\":{\"eligibilityCriteria\":\"Inclusion Criteria:\\n\\n* At least 18 years old (inclusive)\\n* Diagnosed with PNH (white blood cell (WBC) clone \\\\>10%)\\n* Lactose dehydrogenase (LD) ≥2 times the upper limit of normal\\n* Screening Ferritin ≥ normal and Total Iron Binding Capacity (TIBC) \\\\< LLN based on central lab reference ranges. If a subject is receiving iron supplements at screening, the investigator must ensure that his/her dose has been stable for 8 weeks prior to enrolment and must be maintained throughout the study\\n* Last transfusion within 12 months prior to screening\\n* Platelet count of \\\\>30,000/mm3 at the screening visit\\n* Absolute neutrophil count \\\\>500/ mm3 at the screening visit\\n* Women of child-bearing potential (WOCBP) must have a negative pregnancy test at screening and must agree to use protocol defined methods of contraception for the duration of the study\\n* Males must agree to use protocol defined methods of contraception and agree to refrain from donating sperm for the duration of the study\\n* Vaccination against Neisseria meningitides types A, C, W, Y and B, Streptococcus pneumoniae and Haemophilus influenzae Type B (Hib) either within 2 years prior to Day 1 dosing, or within 14 days after starting treatment with pegcetacoplan. Unless documented evidence exists that subjects are non-responders to vaccination as evidenced by titers or display titer levels within acceptable local limits\\n* Willing and able to give informed consent\\n\\nExclusion Criteria:\\n\\n* Prior eculizumab (Soliris®) treatment\\n* Active bacterial infection\\n* Hereditary complement deficiency\\n* History of bone marrow transplantation\\n* Concurrent severe aplastic anemia (SAA), defined as currently receiving immunosuppressive therapy for SAA including but not limited to cyclosporin A, tacrolimus, mycophenolate mofetil or anti-thymocyte globulin\\n* Participation in any other investigational drug trial or exposure to another investigational agent, device or procedure within 30 days\\n* Evidence of QTcF prolongation defined as \\\\>450 ms for males and \\\\>470 ms for females at screening\\n* Breast-feeding women\\n* History of meningococcal disease\",\"healthyVolunteers\":false,\"sex\":\"ALL\",\"minimumAge\":\"18 Years\",\"stdAges\":[\"ADULT\",\"OLDER_ADULT\"]},\"contactsLocationsModule\":{\"overallOfficials\":[{\"name\":\"Federico Grossi, MD, PhD\",\"affiliation\":\"Study Director\",\"role\":\"STUDY_DIRECTOR\"}],\"locations\":[{\"facility\":\"Acibadem City Clinic MHAT Tokuda EAD Sofia\",\"city\":\"Sofia\",\"country\":\"Bulgaria\",\"geoPoint\":{\"lat\":42.69751,\"lon\":23.32415}},{\"facility\":\"Specialized Hospital for Active Treatment of Hematologic Diseases EAD, Sofia\",\"city\":\"Sofia\",\"country\":\"Bulgaria\",\"geoPoint\":{\"lat\":42.69751,\"lon\":23.32415}},{\"facility\":\"Klinički centar Srbije\",\"city\":\"Belgrade\",\"country\":\"Serbia\",\"geoPoint\":{\"lat\":44.80401,\"lon\":20.46513}}]},\"referencesModule\":{\"references\":[{\"pmid\":\"35869170\",\"type\":\"DERIVED\",\"citation\":\"Wong RSM, Pullon HWH, Amine I, Bogdanovic A, Deschatelets P, Francois CG, Ignatova K, Issaragrisil S, Niparuck P, Numbenjapon T, Roman E, Sathar J, Xu R, Al-Adhami M, Tan L, Tse E, Grossi FV. Inhibition of C3 with pegcetacoplan results in normalization of hemolysis markers in paroxysmal nocturnal hemoglobinuria. Ann Hematol. 2022 Sep;101(9):1971-1986. doi: 10.1007/s00277-022-04903-x. Epub 2022 Jul 22.\"}]}},\"resultsSection\":{\"participantFlowModule\":{\"preAssignmentDetails\":\"Up to 20 subjects were planned to be enrolled; however, the sponsor decided to close recruitment after 4 subjects were enrolled based on the conclusion that sufficient data were collected to meet the study objectives.\",\"recruitmentDetails\":\"This Phase 2a, open-label, multiple-dose study was conducted in subjects with paroxysmal nocturnal hemoglobinuria (PNH) who had not received treatment with eculizumab (Soliris®) in the past, between 16 August 2018 and 22 October 2019.\",\"groups\":[{\"id\":\"FG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received subcutaneous (SC) infusions of pegcetacoplan 270 milligrams (mg)/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"periods\":[{\"title\":\"Overall Study\",\"milestones\":[{\"type\":\"STARTED\",\"achievements\":[{\"groupId\":\"FG000\",\"numSubjects\":\"4\"}]},{\"type\":\"COMPLETED\",\"comment\":\"All subjects transitioned to an open-label extension study after Day 364.\",\"achievements\":[{\"groupId\":\"FG000\",\"numSubjects\":\"4\"}]},{\"type\":\"NOT COMPLETED\",\"achievements\":[{\"groupId\":\"FG000\",\"numSubjects\":\"0\"}]}]}]},\"baselineCharacteristicsModule\":{\"populationDescription\":\"The safety set consisted of all subjects who received at least 1 dose of study drug.\",\"groups\":[{\"id\":\"BG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"BG000\",\"value\":\"4\"}]}],\"measures\":[{\"title\":\"Age, Continuous\",\"paramType\":\"MEAN\",\"dispersionType\":\"STANDARD_DEVIATION\",\"unitOfMeasure\":\"years\",\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"BG000\",\"value\":\"30.8\",\"spread\":\"11.81\"}]}]}]},{\"title\":\"Sex: Female, Male\",\"paramType\":\"COUNT_OF_PARTICIPANTS\",\"unitOfMeasure\":\"Participants\",\"classes\":[{\"categories\":[{\"title\":\"Female\",\"measurements\":[{\"groupId\":\"BG000\",\"value\":\"3\"}]},{\"title\":\"Male\",\"measurements\":[{\"groupId\":\"BG000\",\"value\":\"1\"}]}]}]},{\"title\":\"Race/Ethnicity, Customized\",\"paramType\":\"COUNT_OF_PARTICIPANTS\",\"unitOfMeasure\":\"Participants\",\"classes\":[{\"title\":\"White\",\"categories\":[{\"measurements\":[{\"groupId\":\"BG000\",\"value\":\"4\"}]}]},{\"title\":\"Not Hispanic or Latino\",\"categories\":[{\"measurements\":[{\"groupId\":\"BG000\",\"value\":\"4\"}]}]}]},{\"title\":\"Region of Enrollment\",\"paramType\":\"NUMBER\",\"unitOfMeasure\":\"participants\",\"classes\":[{\"title\":\"Bulgaria\",\"categories\":[{\"measurements\":[{\"groupId\":\"BG000\",\"value\":\"2\"}]}]},{\"title\":\"Serbia\",\"categories\":[{\"measurements\":[{\"groupId\":\"BG000\",\"value\":\"2\"}]}]}]}]},\"outcomeMeasuresModule\":{\"outcomeMeasures\":[{\"type\":\"PRIMARY\",\"title\":\"Number of Subjects With Treatment Emergent Adverse Events (TEAEs) Including by Severity\",\"description\":\"TEAEs were defined as adverse events (AE) that occurred after dosing on Day 1 and up to 30 days after the last dose of study drug. A treatment-related TEAE was defined as a TEAE with a relationship to study drug of possible, probable, or definite. TEAEs were graded according to the Common Terminology Criteria for Adverse Events (v4.03) based on: Grade 1: Mild, Grade 2: Moderate, Grade 3: Severe, Grade 4: Life-threatening, Grade 5: Death related to AE.\",\"populationDescription\":\"The safety set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"COUNT_OF_PARTICIPANTS\",\"unitOfMeasure\":\"Participants\",\"calculatePct\":false,\"timeFrame\":\"From Day 1 to 30 days after the last dose (approximately 56 weeks)\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"title\":\"All TEAEs\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"3\"}]}]},{\"title\":\"Treatment-related TEAEs\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"2\"}]}]},{\"title\":\"Serious TEAEs\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"1\"}]}]},{\"title\":\"TEAEs leading to study drug discontinuation\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"0\"}]}]},{\"title\":\"TEAEs with mild intensity\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"2\"}]}]},{\"title\":\"TEAEs with moderate intensity\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"0\"}]}]},{\"title\":\"TEAEs with severe intensity\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"1\"}]}]},{\"title\":\"TEAEs with life threatening intensity\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"0\"}]}]},{\"title\":\"TEAEs leading to death\",\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"0\"}]}]}]},{\"type\":\"PRIMARY\",\"title\":\"Mean Change From Baseline in Lactate Dehydrogenase (LDH) Level\",\"description\":\"Serum chemistry assessments of LDH were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"populationDescription\":\"The Intent-to-treat (ITT) set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"units/liter\",\"timeFrame\":\"Baseline and Day 365\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"-2322.8\",\"spread\":\"635.41\"}]}]}]},{\"type\":\"PRIMARY\",\"title\":\"Mean Change From Baseline in Haptoglobin Level\",\"description\":\"Serum chemistry assessments of haptoglobin were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"populationDescription\":\"The ITT set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"grams/liter\",\"timeFrame\":\"Baseline and Day 365\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"0.08\",\"spread\":\"0.150\"}]}]}]},{\"type\":\"PRIMARY\",\"title\":\"Mean Change From Baseline in Hemoglobin (Hb) Level\",\"description\":\"Hematology assessments of Hb were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"populationDescription\":\"The ITT set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"grams/deciliter\",\"timeFrame\":\"Baseline and Day 365\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"5.27\",\"spread\":\"1.875\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Mean Change From Baseline in Functional Assessment of Chronic Illness Therapy (FACIT)-Fatigue Score\",\"description\":\"The FACIT-Fatigue scale is a 13 item Likert scaled instrument where the subject was presented with 13 statements and asked to indicate their response as it applied to the past 7 days. The 5 possible responses were 'Not at all' (0), 'A little bit (1), 'Somewhat' (2), 'Quite a bit' (3) and 'Very much' (4). With 13 statements the total score had a range of 0 to 52. Higher score corresponds to a higher quality of life (QoL).\",\"populationDescription\":\"The ITT set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"score on a scale\",\"timeFrame\":\"Baseline and Day 365\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"6.5\",\"spread\":\"5.45\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Mean Change From Baseline in Absolute Reticulocyte Count (ARC) Level\",\"description\":\"Hematology assessments of ARC were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"populationDescription\":\"The ITT set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"ARC/nanoliter\",\"timeFrame\":\"Baseline and Day 365\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"-144.3\",\"spread\":\"98.51\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Mean Change From Baseline in Total Bilirubin Level\",\"description\":\"Serum chemistry assessments of total bilirubin were made at the last measurement prior to the first dose of pegcetacoplan (baseline) and periodically throughout the treatment period.\",\"populationDescription\":\"The ITT set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"micromoles/liter\",\"timeFrame\":\"Baseline and Day 365\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"-21.53\",\"spread\":\"8.358\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Mean Number of Red Blood Cell (RBC) Transfusions Per Month\",\"description\":\"The number of on-study RBC transfusions was monitored throughout the treatment period.\",\"populationDescription\":\"The ITT set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Full Range\",\"unitOfMeasure\":\"transfusions\",\"timeFrame\":\"From Day 1 to Day 364\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"0\",\"lowerLimit\":\"0\",\"upperLimit\":\"0\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Mean Change From Baseline in Linear Analog Scale Assessment (LASA) Score for QoL\",\"description\":\"The LASA consists of 3 items, where the respondents were asked to rate their perceived level of functioning. Specific domains included activity level, ability to carry out daily activities, and an item for overall QoL. Their level of functioning was reported on a 0 to 100 scale with 0 indicates \\\"As low as could be\\\" and 100 indicates \\\"As high as could be\\\". The combined score ranged from 0 to 300, with higher scores corresponding to a higher QoL.\",\"populationDescription\":\"The ITT set consisted of all subjects who received at least 1 dose of study drug.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"score on a scale\",\"timeFrame\":\"Baseline and Day 365\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"66.5\",\"spread\":\"55.75\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Mean Serum Concentrations of Pegcetacoplan\",\"description\":\"Serum concentrations of pegcetacoplan at Day 365 are presented.\",\"populationDescription\":\"The Pharmacokinetic (PK) set consisted of all subjects in the safety set who had at least 1 quantifiable PK sample post dose PK measurement.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"microgram per milliliter (ug/mL)\",\"timeFrame\":\"Day 365\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"622.0\",\"spread\":\"92.13\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Mean Area Under the Serum Concentration Versus Time Curve From Time 0 to the Last Measurable Concentration at the End of the Study (AUCtotal)\",\"description\":\"The AUCtotal of pegcetacoplan was estimated using a non-compartmental approach.\",\"populationDescription\":\"The PK set consisted of all subjects in the safety set who had at least 1 quantifiable PK sample post dose PK measurement.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"hour*ug/mL\",\"timeFrame\":\"Blood samples were collected predose and at least 2.5 hours post dose on Day 1 and predose on Days 2 up to Day 365.\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"5818803.2534\",\"spread\":\"975444.77662\"}]}]}]},{\"type\":\"SECONDARY\",\"title\":\"Mean Maximum Observed Predose Serum Concentration During the Study (Ctrough,Max,Total)\",\"description\":\"The Ctrough,max,total of pegcetacoplan was estimated using a non-compartmental approach.\",\"populationDescription\":\"The PK set consisted of all subjects in the safety set who had at least 1 quantifiable PK sample post dose PK measurement.\",\"reportingStatus\":\"POSTED\",\"paramType\":\"MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"ug/mL\",\"timeFrame\":\"Blood samples were collected predose and at least 2.5 hours post dose on Day 1 and predose on Days 2 up to Day 365.\",\"groups\":[{\"id\":\"OG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"4\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"783.5\",\"spread\":\"116.25\"}]}]}]}]},\"adverseEventsModule\":{\"frequencyThreshold\":\"0\",\"timeFrame\":\"TEAEs were collected from Day 1 up to 30 days after the last dose of study drug (a total of approximately 56 weeks).\",\"description\":\"The safety set consisted of all subjects who received at least 1 dose of study drug.\",\"eventGroups\":[{\"id\":\"EG000\",\"title\":\"Pegcetacoplan 270 mg/Day\",\"description\":\"Subjects received SC infusions of pegcetacoplan 270 mg/day up to Day 364. Intrasubject dose escalation up to a dosage of 360 mg/day was permitted if clinically indicated.\",\"deathsNumAffected\":0,\"deathsNumAtRisk\":4,\"seriousNumAffected\":1,\"seriousNumAtRisk\":4,\"otherNumAffected\":3,\"otherNumAtRisk\":4}],\"seriousEvents\":[{\"term\":\"Rib fracture\",\"organSystem\":\"Injury, poisoning and procedural complications\",\"sourceVocabulary\":\"MedDRA (21.0)\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":1,\"numAffected\":1,\"numAtRisk\":4}]}],\"otherEvents\":[{\"term\":\"Administration site swelling\",\"organSystem\":\"General disorders\",\"sourceVocabulary\":\"MedDRA (21.0)\",\"assessmentType\":\"SYSTEMATIC_ASSESSMENT\",\"stats\":[{\"groupId\":\"EG000\",\"numEvents\":1,\"numAffected\":1,\"numAtRisk\":4}]},{\"term\":\"Injection site discolouration\",\"organSystem\":\"General disorders\",\"sourceVocabulary\":\"MedDRA (21.0)