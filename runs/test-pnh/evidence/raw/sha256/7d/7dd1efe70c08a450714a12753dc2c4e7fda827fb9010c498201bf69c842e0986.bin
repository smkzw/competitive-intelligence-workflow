\":\"C000718467\",\"term\":\"danicopan\"}]}},\"hasResults\":false}", "media_type": "application/json", "text_derivation": {"extractor_version": "stdlib-json-object-slice-v1", "method": "ctgov-study-json-v1", "raw_asset": {"byte_size": 487260, "media_type": "application/json", "relative_path": "evidence/raw/sha256/12/12a9cd7017650dad1f9bbf9df6d7f8bfa42449813c98081082d30efe70afbca3.bin", "sha256": "12a9cd7017650dad1f9bbf9df6d7f8bfa42449813c98081082d30efe70afbca3"}, "record_selector": {"nct_id": "NCT05389449", "study_index": 2}, "schema_version": "1.0", "text_sha256": "0dc1aaa0e7038ede51c39821293fe70ad46854022720149e1d4f2dba0c35c9b9"}}