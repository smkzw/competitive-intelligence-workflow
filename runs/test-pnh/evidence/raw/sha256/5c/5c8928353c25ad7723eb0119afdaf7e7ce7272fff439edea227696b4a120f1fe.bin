 Info\",\"url\":\"https://learningcenter.ehaweb.org/eha/2018/stockholm/214782/anita.hill.ra101495.a.subcutaneously-administered.peptide.inhibitor.of.html?f=menu=14*media=3*speaker=664274\"}]},\"ipdSharingStatementModule\":{\"ipdSharing\":\"NO\"}},\"resultsSection\":{\"participantFlowModule\":{\"groups\":[{\"id\":\"FG000\",\"title\":\"Cohort A (Treatment Naive)\",\"description\":\"0.3mg/kg subcutaneously (SC) at Day 1 (loading dose) followed by a starting maintenance dose of 0.1 mg/kg daily SC\"},{\"id\":\"FG001\",\"title\":\"Cohort B (Previously on Eculizumab)\",\"description\":\"0.3mg/kg subcutaneously (SC) at Day 1 (loading dose) followed by a starting maintenance dose of 0.1 mg/kg daily SC\"}],\"periods\":[{\"title\":\"Overall Study\",\"milestones\":[{\"type\":\"STARTED\",\"achievements\":[{\"groupId\":\"FG000\",\"numSubjects\":\"10\"},{\"groupId\":\"FG001\",\"numSubjects\":\"16\"}]},{\"type\":\"COMPLETED\",\"achievements\":[{\"groupId\":\"FG000\",\"numSubjects\":\"10\"},{\"groupId\":\"FG001\",\"numSubjects\":\"8\"}]},{\"type\":\"NOT COMPLETED\",\"achievements\":[{\"groupId\":\"FG000\",\"numSubjects\":\"0\"},{\"groupId\":\"FG001\",\"numSubjects\":\"8\"}]}],\"dropWithdraws\":[{\"type\":\"Adverse Event\",\"reasons\":[{\"groupId\":\"FG000\",\"numSubjects\":\"0\"},{\"groupId\":\"FG001\",\"numSubjects\":\"8\"}]}]}]},\"baselineCharacteristicsModule\":{\"groups\":[{\"id\":\"BG000\",\"title\":\"Cohort A (Treatment Naive)\",\"description\":\"0.3mg/kg subcutaneously (SC) at Day 1 (loading dose) followed by a starting maintenance dose of 0.1 mg/kg daily SC\"},{\"id\":\"BG001\",\"title\":\"Cohort B (Previously on Eculizumab)\",\"description\":\"0.3mg/kg subcutaneously (SC) at Day 1 (loading dose) followed by a starting maintenance dose of 0.1 mg/kg daily SC\"},{\"id\":\"BG002\",\"title\":\"Total\",\"description\":\"Total of all reporting groups\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"BG000\",\"value\":\"10\"},{\"groupId\":\"BG001\",\"value\":\"