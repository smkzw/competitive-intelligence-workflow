ference\",\"paramValue\":\"34.48\",\"ciPctValue\":\"95\",\"ciNumSides\":\"TWO_SIDED\",\"ciLowerLimit\":\"-47.66\",\"ciUpperLimit\":\"116.62\"}]},{\"type\":\"PRIMARY\",\"title\":\"Time-adjusted AUEC of LDH From Week 14 to Week 26 and From Week 40 to Week 52\",\"populationDescription\":\"Per-Protocol Set for AUEC of LDH\",\"reportingStatus\":\"POSTED\",\"paramType\":\"GEOMETRIC_LEAST_SQUARES_MEAN\",\"dispersionType\":\"Standard Deviation\",\"unitOfMeasure\":\"U/L\",\"timeFrame\":\"From Week 14 to Week 26 and from Week 40 to Week 52\",\"groups\":[{\"id\":\"OG000\",\"title\":\"SB12\",\"description\":\"SB12 treated group\"},{\"id\":\"OG001\",\"title\":\"Soliris\",\"description\":\"Soliris treated group\"}],\"denoms\":[{\"units\":\"Participants\",\"counts\":[{\"groupId\":\"OG000\",\"value\":\"38\"},{\"groupId\":\"OG001\",\"value\":\"38\"}]}],\"classes\":[{\"categories\":[{\"measurements\":[{\"groupId\":\"OG000\",\"value\":\"279.65\",\"spread\":\"325.37\"},{\"groupId\":\"OG001\",\"value\":\"258.73\",\"spread\":\"95.09\"}]}]}],\"analyses\":[{\"groupIds\":[\"OG000\",\"OG001\"],\"nonInferiorityType\":\"EQUIVALENCE\",\"nonInferiorityComment\":\"Pre-defined equivalence margin was \\\\[0.77 to 1.29\\\\].\",\"paramType\":\"Ratio of geometric least squares mean\",\"paramValue\":\"1.08\",\"ciPctValue\":\"90\",\"ciNumSides\":\"TWO_SIDED\",\"ciLowerLimit\":\"0.95\",\"ciUpperLimit\":\"1.23\"}]}]},\"adverseEventsModule\":{\"frequencyThreshold\":\"5\",\"timeFrame\":\"From the time of signing the informed consent form until Week 58 (EOS Visit) or ET Visit\",\"eventGroups\":[{\"id\":\"EG000\",\"title\":\"SB12\",\"description\":\"SB12 treated group\",\"deathsNumAffected\":0,\"deathsNumAtRisk\":47,\"seriousNumAffected\":3,\"seriousNumAtRisk\":47,\"otherNumAffected\":18,\"otherNumAtRisk\":47},{\"id\":\"EG001\",\"title\":\"Soliris\",\"description\":\"Soliris treated group\",\"deathsNumAffected\":1,\"deathsNumAtRisk\":47,\"seriousNumAffected\":2,\"seriousNumAtRisk\":47,\"otherNumAffected\":11,