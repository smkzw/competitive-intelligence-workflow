read":"48.6"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in Serum Free Complement 5 (C5) Concentration","description":"Blood samples were collected for measurement of serum concentration of free C5 at specified timepoints. No study intervention administered on Day 449. A decrease indicated a reduction in disease activity.","populationDescription":"Pharmacodynamic Analysis Set: all participants who received at least 1 dose of study intervention and who have evaluable pharmacodynamic data. Here, 'Number Analyzed' signifies those participants evaluable for this outcome measure at specified timepoints.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"ug/mL","timeFrame":"Day 1, Day 29, Day 85, Day 169, Day 253, Day 337, Day 421, Day 449","groups":[{"id":"OG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"classes":[{"title":"Day 1","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-80.6911","spread":"21.2241"}]}]},{"title":"Day 29","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-80.6911","spread":"21.2241"}]}]},{"title":"Day 85","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-80.6911","spread":"21.2241"}]}]},{"title":"Day 169","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-80.6911","spread":"21.2241"}]}]},{"title":"Day 253","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-80.6911","spread":"21.2241"}]}]},{"title":"Day 337","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"23"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-81.5460","spread":"21.1775"}]}]},{"title":"Day 421","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"22"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-82.2563","spread":"21.3936"}]}]},{"title":"Day 449","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"19"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-82.4700","spread":"21.8728"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in Serum Total C5 Concentration","description":"Blood samples were collected for measurement of serum concentration of total C5 at specified timepoints. No study intervention administered on Day 449. A decrease indicated a reduction in disease activity.","populationDescription":"Pharmacodynamic Analysis Set: all participants who received at least 1 dose of study intervention and who have evaluable pharmacodynamic data. Here, 'Number Analyzed' signifies those participants evaluable for this outcome measure at specified timepoints.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"ug/mL","timeFrame":"Day 1, Day 29, Day 85, Day 169, Day 253, Day 337, Day 421, Day 449","groups":[{"id":"OG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"classes":[{"title":"Day 1","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"-13.3422","spread":"6.3902"}]}]},{"title":"Day 29","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"49.5372","spread":"15.2890"}]}]},{"title":"Day 85","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"52.8607","spread":"17.8070"}]}]},{"title":"Day 169","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"50.9998","spread":"17.9024"}]}]},{"title":"Day 253","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"61.3600","spread":"24.0315"}]}]},{"title":"Day 337","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"23"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"60.9581","spread":"24.3898"}]}]},{"title":"Day 421","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"22"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"62.8651","spread":"19.0970"}]}]},{"title":"Day 449","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"20"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"64.4332","spread":"22.4364"}]}]}]},{"type":"SECONDARY","title":"Number of Participants With Treatment-emergent Antidrug Antibodies (ADAs) to Eculizumab","description":"Blood samples were collected for measurement of treatment-emergent ADAs to eculizumab at specified timepoints.","populationDescription":"Immunogenicity Analysis Set: all participants who received at least 1 dose of eculizumab and with an ADA result at baseline and at least 1 post-baseline assessment.","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"Baseline through Week 64","groups":[{"id":"OG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"0"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in Functional Assessment of Chronic Illness Therapy (FACIT)-Fatigue Score at Week 12","description":"The FACIT-Fatigue is a 13-item questionnaire that assesses self-reported fatigue and its impact upon daily activities and function over the preceding 7 days. The FACIT-Fatigue scale is a collection of quality of life (QoL) questionnaires pertaining to the management of fatigue symptoms due to a chronic illness. Participants scored each item on a 5-point scale: 0 (Not at all) to 4 (Very much). Total scores were calculated as the sum from all 13 items and ranged from 0 to 52, with higher scores indicating an increased QoL. Analysis was performed using a MMRM, including FACIT-Fatigue score change from baseline values at the scheduled visits from Week 1 to Week 12 as the dependent variable, with the fixed categorical effect of study visit, fixed continuous effect of baseline value of FACIT-Fatigue, and participant as random effect. Assessed at baseline, 1, 2, 3, 4, 6, 8, 10, and 12 weeks, Week 12 reported.","populationDescription":"Full Analysis Set: all participants who received at least 1 dose of study intervention and had at least 1 efficacy assessment post first dose.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"score on a scale","timeFrame":"Baseline, Week 12","groups":[{"id":"OG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"5.6","lowerLimit":"2.3","upperLimit":"8.9"}]}]}]},{"type":"SECONDARY","title":"Percentage of Participants With Breakthrough Hemolysis","description":"Breakthrough hemolysis was defined as at least 1 new or worsening symptom or sign of intravascular hemolysis (fatigue, hemoglobinuria, abdominal pain, shortness of breath \\[dyspnea\\], anemia \\[hemoglobin \\<10 grams/deciliter\\], major adverse vascular event \\[including thrombosis\\], dysphagia, or erectile dysfunction) in the presence of elevated LDH ≥2 times (\\*) upper limit of normal (ULN), after prior LDH reduction to \\<1.5\\* ULN on therapy.","populationDescription":"Full Analysis Set: all participants who received at least 1 dose of study intervention and had at least 1 efficacy assessment post first dose.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"percentage of participants","timeFrame":"Baseline through Week 12","groups":[{"id":"OG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"4.0","lowerLimit":"0.1","upperLimit":"20.4"}]}]}]},{"type":"SECONDARY","title":"Percentage of Participants Achieving LDH Normalization","description":"Blood samples were collected for measurement of LDH at specified timepoints. LDH normalization was defined as LDH ≤ULN.","populationDescription":"Full Analysis Set: all participants who received at least 1 dose of study intervention and had at least 1 efficacy assessment post first dose.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"percentage of participants","timeFrame":"Baseline through Week 12","groups":[{"id":"OG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"36.0","lowerLimit":"18.0","upperLimit":"57.5"}]}]}]},{"type":"SECONDARY","title":"Percentage of Participants Achieving Transfusion Avoidance","description":"Transfusion avoidance was defined as remaining transfusion free (that is, had not received any transfusion) and did not require transfusion as per protocol.","populationDescription":"Full Analysis Set: all participants who received at least 1 dose of study intervention and had at least 1 efficacy assessment post first dose.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"percentage of participants","timeFrame":"Baseline through Week 12","groups":[{"id":"OG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"96.0","lowerLimit":"79.6","upperLimit":"99.9"}]}]}]},{"type":"SECONDARY","title":"Percentage of Participants With LDH ≤1.5* ULN at Week 12","description":"Blood samples were collected for measurement of LDH at specified timepoints.","populationDescription":"Full Analysis Set: all participants who received at least 1 dose of study intervention and had at least 1 efficacy assessment post first dose.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"percentage of participants","timeFrame":"Baseline through Week 12","groups":[{"id":"OG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"25"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"80.0","lowerLimit":"59.3","upperLimit":"93.2"}]}]}]}]},"adverseEventsModule":{"frequencyThreshold":"5","timeFrame":"Baseline through Week 64","description":"All reported safety data based upon Safety Set: all participants who received at least 1 dose of eculizumab. All deaths regardless of causality or whether they were reported as a reason for study discontinuation are reported in the All-Cause Mortality section.","eventGroups":[{"id":"EG000","title":"Eculizumab","description":"Participants received eculizumab by IV infusion.","deathsNumAffected":1,"deathsNumAtRisk":25,"ser