}]}]},"moreInfoModule":{"limitationsAndCaveats":{"description":"The sponsor decided to terminate the development program (including this study)."},"certainAgreement":{"piSponsorEmployee":false,"restrictiveAgreement":true},"pointOfContact":{"title":"Study Director","organization":"BioCryst Pharmaceuticals Inc","email":"clinicaltrials@biocryst.com","phone":"+1 919-859-1302"}}},"documentSection":{"largeDocumentModule":{"largeDocs":[{"typeAbbrev":"Prot","hasProtocol":true,"hasSap":false,"hasIcf":false,"label":"Study Protocol","date":"2022-08-01","uploadDate":"2024-09-13T07:25","filename":"Prot_000.pdf","size":1522466},{"typeAbbrev":"SAP","hasProtocol":false,"hasSap":true,"hasIcf":false,"label":"Statistical Analysis Plan","date":"2023-10-04","uploadDate":"2024-09-13T07:26","filename":"SAP_001.pdf","size":708534}]}},"derivedSection":{"miscInfoModule":{"versionHolder":"2026-09-18","removedCountries":["Spain","Taiwan","United States"],"submissionTracking":{"firstMcpInfo":{"postDateStruct":{"date":"2024-10-08","type":"ACTUAL"}}}},"conditionBrowseModule":{"meshes":[{"id":"D006457","term":"Hemoglobinuria, Paroxysmal"}],"ancestors":[{"id":"D000743","term":"Anemia, Hemolytic"},{"id":"D000740","term":"Anemia"},{"id":"D006402","term":"Hematologic Diseases"},{"id":"D006425","term":"Hemic and Lymphatic Diseases"},{"id":"D009190","term":"Myelodysplastic Syndromes"},{"id":"D001855","term":"Bone Marrow Diseases"}]}},"hasResults":true},
{"protocolSection":{"identificationModule":{"nctId":"NCT06593938","orgStudyIdInfo":{"id":"HRS-5965-301"},"organization":{"fullName":"Chengdu Suncadia Medicine Co., Ltd.","class":"INDUSTRY"},"briefTitle":"A Study to Evaluate the Efficacy and Safety of Oral HRS-5965 in Adult Paroxysmal Nocturnal Hemoglobinuria (PNH) Patients Who Are Naive to Complement Inhibitor Therapy","officialTitle":"A Multicenter, Randomized, Open-label, Active-comparator Controlled Phase III Study to Evaluate the Efficacy and Safety of HRS-5965 Capsule in Patients With Paroxysmal Nocturnal Hemoglobinuria"},"statusModule":{"statusVerifiedDate":"2025-09","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2024-10-25","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2025-07-31","type":"ACTUAL"},"completionDateStruct":{"date":"2025-07-31","type":"ACTUAL"},"studyFirstSubmitDate":"2024-09-10","studyFirstSubmitQcDate":"2024-09-10","studyFirstPostDateStruct":{"date":"2024-09-19","type":"ACTUAL"},"lastUpdateSubmitDate":"2025-09-10","lastUpdatePostDateStruct":{"date":"2025-09-11","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Chengdu Suncadia Medicine Co., Ltd.","class":"INDUSTRY"}},"oversightModule":{"isFdaRegulatedDrug":false,"isFdaRegulatedDevice":false},"descriptionModule":{"briefSummary":"A study of the efficacy and safety of HRS-5965 capsules compared to eculizumab for 24 weeks in patients with PNH."},"conditionsModule":{"conditions":["Paroxysmal Nocturnal Hemoglobinuria"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":76,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"HRS-5965 capsule","type":"EXPERIMENTAL","interventionNames":["Drug: HRS-5965 capsule"]},{"label":"Eculizumab Injection","type":"EXPERIMENTAL","interventionNames":["Drug: Eculizumab Injection"]}],"interventions":[{"type":"DRUG","name":"HRS-5965 capsule","description":"HRS-5965 capsule for 24 weeks","armGroupLabels":["HRS-5965 capsule"]},{"type":"DRUG","name":"Eculizumab Injection","description":"Eculizumab Injection for 24 weeks","armGroupLabels":["Eculizumab Injection"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Proportion of subjects with the hemoglobin levels are ≥ 12 g/dL at least on three out of four measurements in the absence of red blood cell transfusions","timeFrame":"24 weeks"}],"secondaryOutcomes":[{"measure":"Proportion of subjects with the change from baseline in hemoglobin is ≥ 2 g/dL at least on three out of four measurements in the absence of red blood cell transfusions","timeFrame":"24 weeks"},{"measure":"Proportion of subjects who absence of administration of red blood cell transfusions","timeFrame":"24 weeks"},{"measure":"Mean change from baseline in hemoglobin","timeFrame":"24 weeks"},{"measure":"Mean percent change from baseline in LDH levels","timeFrame":"24 weeks"},{"measure":"Mean change from baseline in reticulocyte counts","timeFrame":"24 weeks"},{"measure":"Mean change from baseline in FACIT-Fatigue scores","timeFrame":"24 weeks"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n1. Diagnosis of PNH confirmed by flow cytometry with clone size \\> 10%.\n2. Have not received complement inhibitor therapy;\n3. LDH \\> 1.5\\*ULN at screening.\n4. Hemoglobin level \\< 10 g/dL at screening.\n\nExclusion Criteria:\n\n1. Known or suspected hereditary or acquired complement deficiency;\n2. Patients with laboratory evidence of bone marrow failure (reticulocytes \\<100x109/L; platelets \\<30x109/L; neutrophils \\<0.5x109/L);\n3. Presence or suspicion of a systemic active bacterial, viral, or fungal infection (based on judgment of the investigator) within 2 weeks prior to the first dose of HRS-5965;\n4. History of infection with capsular bacteria (e.g., meningococcus, pneumococcus, etc.)\n5. Positive of HIV, HBsAg or HCVAb.","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Peking Union Medical College Hospital, Chinese Academy of Medical Sciences","city":"Beijing","state":"Beijing Municipality","zip":"100730","country":"China","geoPoint":{"lat":39.9075,"lon":116.39723}},{"facility":"The Blood Disease Hospital of the Chinese Academy of Medical Sciences","city":"Tianjin","state":"Tianjin Municipality","zip":"300020","country":"China","geoPoint":{"lat":39.14222,"lon":117.17667}}]},"ipdSharingStatementModule":{"ipdSharing":"UNDECIDED"}},"derivedSection":{"miscInfoModule":{"versionHolder":"2026-09-18"},"conditionBrowseModule":{"meshes":[{"id":"D006457","term":"Hemoglobinuria, Paroxysmal"}],"ancestors":[{"id":"D000743","term":"Anemia, Hemolytic"},{"id":"D000740","term":"Anemia"},{"id":"D006402","term":"Hematologic Diseases"},{"id":"D006425","term":"Hemic and Lymphatic Diseases"},{"id":"D009190","term":"Myelodysplastic Syndromes"},{"id":"D001855","term":"Bone Marrow Diseases"}]},"interventionBrowseModule":{"meshes":[{"id":"C481642","term":"eculizumab"}]}},"hasResults":false},
{"protocolSection":{"identificationModule":{"nctId":"NCT04058158","orgStudyIdInfo":{"id":"SB12-3003"},"organization":{"fullName":"Samsung Bioepis Co., Ltd.","class":"INDUSTRY"},"briefTitle":"A Study to Compare SB12 (Proposed Eculizumab Biosimilar) to Soliris in Subjects With Paroxysmal Nocturnal Haemoglobinuria","officialTitle":"A Phase III Randomised, Double-blind, Multicentre Study to Compare the Efficacy, Safety, Pharmacokinetics, and Immunogenicity Between SB12 (Proposed Eculizumab Biosimilar) and Soliris® in Subjects With Paroxysmal Nocturnal Haemoglobinuria"},"statusModule":{"statusVerifiedDate":"2024-03","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2019-08-07","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2021-09-21","type":"ACTUAL"},"completionDateStruct":{"date":"2021-10-21","type":"ACTUAL"},"studyFirstSubmitDate":"2019-08-12","studyFirstSubmitQcDate":"2019-08-13","studyFirstPostDateStruct":{"date":"2019-08-15","type":"ACTUAL"},"resultsFirstSubmitDate":"2023-09-14","resultsFirstSubmitQcDate":"2024-03-25","resultsFirstPostDateStruct":{"date":"2024-03-26","type":"ACTUAL"},"lastUpdateSubmitDate":"2024-03-25","lastUpdatePostDateStruct":{"date":"2024-03-26","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Samsung Bioepis Co., Ltd.","class":"INDUSTRY"}},"oversightModule":{"isFdaRegulatedDrug":false,"isFdaRegulatedDevice":false},"descriptionModule":{"briefSummary":"This is a randomised Phase III, double-blind, multicentre, cross-over study to compare the efficacy, safety, pharmacokinetics, and immunogenicity between SB12 and Soliris® in subjects with PNH.","detailedDescription":"Subjects will be randomised in a 1:1 ratio to either treatment sequence. Subjects randomly assigned to treatment with SB12 or Soliris® will receive 600 mg of eculizumab IV every week for first 4 weeks (initial phase) and 900 mg for the fifth week, followed by 900 mg every 2 weeks until Week 52. Subjects who are randomised to initially receive SB12 will be switched to receive Soliris® and subjects who are randomised to initially receive Soliris® will be switched to receive SB12 at Week 26."},"conditionsModule":{"conditions":["Paroxysmal Nocturnal Hemoglobinuria"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"CROSSOVER","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"QUADRUPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]}},"enrollmentInfo":{"count":50,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Treatment Sequence I","type":"EXPERIMENTAL","description":"Subjects who are randomised to initially receive SB12 will be switched to receive Soliris® at Week 26","interventionNames":["Drug: SB12 (proposed eculizumab biosimilar)","Drug: Soliris (eculizumab)"]},{"label":"Treatment Sequence II","type":"EXPERIMENTAL","description":"Subjects who are randomised to initially receive Soliris® will be switched to receive SB12 at Week 26","interventionNames":["Drug: SB12 (proposed eculizumab biosimilar)","Drug: Soliris (eculizumab)"]}],"interventions":[{"type":"DRUG","name":"SB12 (proposed eculizumab biosimilar)","description":"600 mg IV every week for first 4 weeks and 900 mg for the fifth week, followed by 900 mg every 2 weeks thereafter","armGroupLabels":["Treatment Sequence I","Treatment Sequence II"]},{"type":"DRUG","name":"Soliris (eculizumab)","description":"600 mg IV every week for first 4 weeks and 900 mg for the fifth week, followed by 900 mg every 2 weeks thereafter","armGroupLabels":["Treatment Sequence I","Treatment Sequence II"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Lactate Dehydrogenase (U/L) at Week 26","timeFrame":"Week 26"},{"measure":"Time-adjusted AUEC of LDH From Week 14 to Week 26 and From Week 40 to Week 52","timeFrame":"From Week 14 to Week 26 and from Week 40 to Week 52"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Male or female aged 18 or older\n* Eculizumab-naïve patients with PNH\n* Presence of the PNH white blood cell (WBC) clone ≥ 10%\n* Documented LDH level ≥ 1.5 x ULN at Screening\n* History of transfusion for anaemia within 12 months prior to Screening or having PNH-related symptoms at Screening\n* Subjects must be vaccinated against Neisseria meningitides\n\nExclusion Criteria:\n\n* Previous treatment with any complement pathway inhibitors\n* ANC ≤ 500/mm3 or Platelet count \\< 70,000/mm3\n* History of meningococcal disease\n* History of bone marrow transplantation\n* Known or suspected active bacterial/viral/fungal infection within 30 days\n* Stable use of erythropoietic, corticosteroids, heparin, warfarin before randomisation","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Fortis Memorial Research Institute","city":"Gurgaon","state":"Haryana","zip":"122002","country":"India","geoPoint":{"lat":28.4601,"lon":77.02635}},{"facility":"Post Graduate Institute of Medical Education and Research (PGIMER)","city":"Chandigarh","country":"India","geoPoint":{"lat":30.73629,"lon":76.7884}},{"facility":"Apollo Hospitals International Limited","city":"Chennai","country":"India","geoPoint":{"lat":13.08784,"lon":80.27847}},{"facility":"Amrita Institute of Medical Sciences and Research Centre","city":"Kochi","country":"India","geoPoint":{"lat":9.93988,"lon":76.26022}},{"facility":"Nil Ratan Sircar Medical College and Hospital","city":"Kolkata","country":"India","geoPoint":{"lat":22.56263,"lon":88.36304}},{"facility":"Hospital Ampang","city":"Ampang","country":"Malaysia","geoPoint":{"lat":3.15,"lon":101.76667}},{"facility":"Hospital Sultanah Aminah","city":"Johor Bahru","country":"Malaysia","geoPoint":{"lat":1.4655,"lon":103.7578}},{"facility":"Queen Elizabeth Hospital - Kota Kinabalu","city":"Kota Kinabalu","country":"Malaysia","geoPoint":{"lat":5.9749,"lon":116.0724}},{"facility":"Hospital Tengku Ampuan Afzan","city":"Kuantan","country":"Malaysia","geoPoint":{"lat":3.8077,"lon":103.326}},{"facility":"Hospital Pulau Pinang","city":"Pulau Pinang","country":"Malaysia","geoPoint":{"lat":3.55,"lon":102.56667}},{"facility":"Instituto Nacional de Ciencias Medicas y Nutricion Salvador Zubiran","city":"Tlalpan","country":"Mexico","geoPoint":{"lat":19.29513,"lon":-99.16206}},{"facility":"Colentina Clinical Hospital","city":"Bucharest","country":"Romania","geoPoint":{"lat":44.43225,"lon":26.10626}},{"facility":"Emergency University Hospital","city":"Bucharest","country":"Romania","geoPoint":{"lat":44.43225,"lon":26.10626}},{"facility":"Prof Dr I Chiricuta Institute of Oncology","city":"Cluj-Napoca","country":"Romania","geoPoint":{"lat":46.76667,"lon":23.6}},{"facility":"Filantropia Municipal Clinical Hospital","city":"Craiova","country":"Romania","geoPoint":{"lat":44.31667,"lon":23.8}},{"facility":"Samsung Medical Center","city":"Seoul","country":"South Korea","geoPoint":{"lat":37.566,"lon":126.9784}},{"facility":"Seoul National University Hospital","city":"Seoul","country":"South Korea","geoPoint":{"lat":37.566,"lon":126.9784}},{"facility":"National Cheng Kung University Hospital","city":"Tainan","country":"Taiwan","geoPoint":{"lat":22.99083,"lon":120.21333}},{"facility":"National Taiwan University Hospital","city":"Taipei","country":"Taiwan","geoPoint":{"lat":25.05306,"lon":121.52639}},{"facility":"Tri-Service General Hospital","city":"Taipei","country":"Taiwan","geoPoint":{"lat":25.05306,"lon":121.52639}},{"facility":"Chang Gung Memorial Hospital","city":"Taoyuan","country":"Taiwan","geoPoint":{"lat":24.99368,"lon":121.29696}},{"facility":"Chulalongkorn University","city":"Bangkok","country":"Thailand","geoPoint":{"lat":13.75398,"lon":100.50144}},{"facility":"Srinagarind Hospital","city":"Nai Muang","country":"Thailand","geoPoint":{"lat":15.17901,"lon":100.1282}},{"facility":"Vinnytsia Regional Clinical Hospital n.a. M.I.Pyrohov","city":"Vinnytsia","state":"Vinnytsia Oblast","zip":"21018","country":"Ukraine","geoPoint":{"lat":49.2322,"lon":28.46871}},{"facility":"Municipal Institution Cherkasy Regional Oncology Dispensary of Cherkasy Regional Council","city":"Cherkasy","zip":"18009","country":"Ukraine","geoPoint":{"lat":49.44452,"lon":32.05738}},{"facility":"Communal Non-profit Enterprise Regional Center of Oncology","city":"Kharkiv","country":"Ukraine","geoPoint":{"lat":49.98177,"lon":36.25475}},{"facility":"Poltava Regional Clinical Hospital n.a. M.V. Sklifosovskyi","city":"Poltava","country":"Ukraine","geoPoint":{"lat":49.58925,"lon":34.55367}}]}},"resultsSection":{"participantFlowModule":{"groups":[{"id":"FG000","title":"Soliris to SB12","description":"Subjects randomly assigned to treatment with Soliris received 600 mg of eculizumab intravenous (IV) infusion every week for first 4 weeks (initial phase) and 900 mg for the fifth week, followed by 900 mg every 2 weeks thereafter."},{"id":"FG001","title":"SB12 to Soliris","description":"Subjects randomly assigned to treatment with SB12 received 600 mg of eculizumab intravenous (IV) infusion every week for first 4 weeks (initial phase) and 900 mg for the fifth week, followed by 900 mg every 2 weeks thereafter."}],"periods":[{"title":"Period 1","milestones":[{"type":"STARTED","achievements":[{"groupId":"FG000","numSubjects":"25"},{"groupId":"FG001","numSubjects":"25"}]},{"type":"COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"23"},{"groupId":"FG001","numSubjects":"23"}]},{"type":"NOT COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"2"},{"groupId":"FG001","numSubjects":"2"}]}],"dropWithdraws":[{"type":"Death","reasons":[{"groupId":"FG000","numSubjects":"1"},{"groupId":"FG001","numSubjects":"0"}]},{"type":"Adverse Event","reasons":[{"groupId":"FG000","numSubjects":"1"},{"groupId":"FG001","numSubjects":"1"}]},{"type":"Pregnancy","reasons":[{"groupId":"FG000","n