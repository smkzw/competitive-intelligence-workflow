:{\"lat\":34.20442,\"lon\":117.28386}},{\"facility\":\"Research Site\",\"city\":\"Nanchang\",\"state\":\"Jiangxi\",\"zip\":\"330006\",\"country\":\"China\",\"geoPoint\":{\"lat\":28.68396,\"lon\":115.85306}},{\"facility\":\"Research Site\",\"city\":\"Nanchang\",\"state\":\"Jiangxi\",\"zip\":\"330008\",\"country\":\"China\",\"geoPoint\":{\"lat\":28.68396,\"lon\":115.85306}},{\"facility\":\"Research Site\",\"city\":\"Changchun\",\"state\":\"Jilin\",\"zip\":\"130021\",\"country\":\"China\",\"geoPoint\":{\"lat\":43.88,\"lon\":125.32278}},{\"facility\":\"Research Site\",\"city\":\"Shenyang\",\"state\":\"Liaoning\",\"zip\":\"110001\",\"country\":\"China\",\"geoPoint\":{\"lat\":41.79222,\"lon\":123.43278}},{\"facility\":\"Research Site\",\"city\":\"Jinan\",\"state\":\"Shandong\",\"zip\":\"250000\",\"country\":\"China\",\"geoPoint\":{\"lat\":36.66833,\"lon\":116.99722}},{\"facility\":\"Research Site\",\"city\":\"Qingdao\",\"state\":\"Shandong\",\"zip\":\"266000\",\"country\":\"China\",\"geoPoint\":{\"lat\":36.06488,\"lon\":120.38042}},{\"facility\":\"Research Site\",\"city\":\"Zibo\",\"state\":\"Shandong\",\"zip\":\"255090\",\"country\":\"China\",\"geoPoint\":{\"lat\":36.79056,\"lon\":118.06333}},{\"facility\":\"Research Site\",\"city\":\"Linyi\",\"state\":\"Shangdong\",\"zip\":\"276034\",\"country\":\"China\",\"geoPoint\":{\"lat\":35.06306,\"lon\":118.34278}},{\"facility\":\"Research Site\",\"city\":\"Shanghai\",\"state\":\"Shanghai Municipality\",\"zip\":\"200040\",\"country\":\"China\",\"geoPoint\":{\"lat\":31.22222,\"lon\":121.45806}},{\"facility\":\"Research Site\",\"city\":\"Shanghai\",\"state\":\"Shanghai Municipality\",\"zip\":\"200336\",\"country\":\"China\",\"geoPoint\":{\"lat\":31.22222,\"lon\":121.45806}},{\"facility\":\"Research Site\",\"city\":\"Taiyuan\",\"state\":\"Shanxi\",\"zip\":\"030000\",\"country\":\"China\",\"geoPoint\":{\"lat\":37.86944,\"lon\":112.56028}},{\"facility\":\"Research Site\",\"city\":\"Xi’an\",\"state\":\"Shanxi\",\"zip\":\"710061\",\"country\":\"China\",\"geoPoint\":{\"lat\":35.99785,\"lon\":113.52486}},{\"facility\":\"Research Site\",\"city\":\"Xi’an\",\"state\":\"Shanxi\",\"zip\":\"710068\",\"country\":\"China\",\"geoPoint\":{\"lat\":35.99785,\"lon\":113.52486}},{\"facility\":\"Research Site\",\"city\":\"Chengdu\",\"state\":\"Sichuan\",\"zip\":\"610041\",\"country\":\"China\",\"geoPoint\":{\"lat\":30.66667,\"lon\":104.06667}},{\"facility\":\"Research Site\",\"city\":\"Chengdu\",\"state\":\"Sichuan\",\"zip\":\"610072\",\"country\":\"China\",\"geoPoint\":{\"lat\":30.66667,\"lon\":104.06667}},{\"facility\":\"Research Site\",\"city\":\"Tianjin\",\"state\":\"Tianjin Municipality\",\"zip\":\"300020\",\"country\":\"China\",\"geoPoint\":{\"lat\":39.14222,\"lon\":117.17667}},{\"facility\":\"Research Site\",\"city\":\"Tianjin\",\"state\":\"Tianjin Municipality\",\"zip\":\"300052\",\"country\":\"China\",\"geoPoint\":{\"lat\":39.14222,\"lon\":117.17667}},{\"facility\":\"Research Site\",\"city\":\"Tianjin\",\"state\":\"Tianjin Municipality\",\"zip\":\"300190\",\"country\":\"China\",\"geoPoint\":{\"lat\":39.14222,\"lon\":117.17667}},{\"facility\":\"Research Site\",\"city\":\"Kunming\",\"state\":\"Yunnan\",\"zip\":\"650034\",\"country\":\"China\",\"geoPoint\":{\"lat\":25.03889,\"lon\":102.71833}},{\"facility\":\"Research Site\",\"city\":\"Hangzhou\",\"country\":\"China\",\"geoPoint\":{\"lat\":30.29365,\"lon\":120.16142}}]},\"referencesModule\":{\"references\":[{\"pmid\":\"42707331\",\"type\":\"DERIVED\",\"citation\":\"Han B, Liu H, He G, Jia J, Hong M, Weng J, Wang S, Zhang F, Niu T, Ma T, Xu J, Fu R. A real-world, multi-center, prospective, observational study for paroxysmal nocturnal haemoglobinuria (PNH) in China: Baseline characteristics, disease burden and treatment patterns. Ther Adv Hematol. 2026 Sep 4;17:20406207261481224. doi: 10.1177/20406207261481224. eCollection 2026.\"}]},\"ipdSharingStatementModule\":{\"ipdSharing\":\"YES\",\"description\":\"Qualified researchers can request access to anonymized individual patient-level data from AstraZeneca group of companies sponsored clinical trials via the request portal Vivli.org. All requests will be evaluated as per the AZ disclosure commitment: https://astrazenecagrouptrials.pharmacm.com/ST/Submission/Disclosure.\\n\\n\\\"Yes\\\", indicates that AZ are accepting requests for IPD, but this does not mean all requests will be approved.\",\"timeFrame\":\"AstraZeneca will meet or exceed data availability as per the commitments made to the EFPIA/PhRMA Data-Sharing Principles. For details of our timelines, please refer to our disclosure commitment at https://astrazenecagrouptrials.pharmacm.com/ST/Submission/Disclosure.\",\"accessCriteria\":\"When a request has been approved AstraZeneca will provide access to the anonymized individual patient-level data via secure research environment Vivli.org. A Signed Data Usage Agreement (non-negotiable contract for data accessors) must be in place before accessing requested information.\",\"url\":\"https://vivli.org/\"}},\"derivedSection\":{\"miscInfoModule\":{\"versionHolder\":\"2026-09-18\"},\"conditionBrowseModule\":{\"meshes\":[{\"id\":\"D006457\",\"term\":\"Hemoglobinuria, Paroxysmal\"}],\"ancestors\":[{\"id\":\"D000743\",\"term\":\"Anemia, Hemolytic\"},{\"id\":\"D000740\",\"term\":\"Anemia\"},{\"id\":\"D006402\",\"term\":\"Hematologic Diseases\"},{\"id\":\"D006425\",\"term\":\"Hemic and Lymphatic Diseases\"},{\"id\":\"D009190\",\"term\":\"Myelodysplastic Syndromes\"},{\"id\":\"D001855\",\"term\":\"Bone Marrow Diseases\"}]}},\"hasResults\":false}", "media_type": "application/json", "text_derivation": {"extractor_version": "stdlib-json-object-slice-v1", "method": "ctgov-study-json-v1", "raw_asset": {"byte_size": 680043, "media_type": "application/json", "relative_path": "evidence/raw/sha256/ab/ab9c3025e06b2ce4476316d0474d9565f6dc62bd92600f8b6b62099912ce558d.bin", "sha256": "ab9c3025e06b2ce4476316d0474d9565f6dc62bd92600f8b6b62099912ce558d"}, "record_selector": {"nct_id": "NCT06154512", "study_index": 15}, "schema_version": "1.0", "text_sha256": "52920a2ae145343a6c5a7119d29762144584f1ced5fe5ef9d0c999a4d4eb0ccd"}}