{"content_text": "{\"protocolSection\":{\"identificationModule\":{\"nctId\":\"NCT07035665\",\"orgStudyIdInfo\":{\"id\":\"HRS-5965-108\"},\"organization\":{\"fullName\":\"Chengdu Suncadia Medicine Co., Ltd.\",\"class\":\"INDUSTRY\"},\"briefTitle\":\"A Clinical Study to Evaluate the Effect of Food on the Pharmacokinetic Profiles of HRS-5965 Capsules in Healthy Subjects\",\"officialTitle\":\"A Single-Center, Randomized, Open-Label, Crossover Clinical Study to Evaluate the Effect of Food on the Pharmacokinetic Profiles of HRS-5965 Capsules in Healthy Subjects\"},\"statusModule\":{\"statusVerifiedDate\":\"2025-08\",\"overallStatus\":\"COMPLETED\",\"expandedAccessInfo\":{\"hasExpandedAccess\":false},\"startDateStruct\":{\"date\":\"2025-06-30\",\"type\":\"ACTUAL\"},\"primaryCompletionDateStruct\":{\"date\":\"2025-07-22\",\"type\":\"ACTUAL\"},\"completionDateStruct\":{\"date\":\"2025-07-22\",\"type\":\"ACTUAL\"},\"studyFirstSubmitDate\":\"2025-06-16\",\"studyFirstSubmitQcDate\":\"2025-06-16\",\"studyFirstPostDateStruct\":{\"date\":\"2025-06-25\",\"type\":\"ACTUAL\"},\"lastUpdateSubmitDate\":\"2025-08-19\",\"lastUpdatePostDateStruct\":{\"date\":\"2025-08-20\",\"type\":\"ACTUAL\"}},\"sponsorCollaboratorsModule\":{\"responsibleParty\":{\"type\":\"SPONSOR\"},\"leadSponsor\":{\"name\":\"Chengdu Suncadia Medicine Co., Ltd.\",\"class\":\"INDUSTRY\"}},\"oversightModule\":{\"isFdaRegulatedDrug\":false,\"isFdaRegulatedDevice\":false},\"descriptionModule\":{\"briefSummary\":\"The study is being conducted to evaluate the effect of food on pharmacokinetics of HRS-5965 capsules after oral administration.\"},\"conditionsModule\":{\"conditions\":[\"IgA Nephropathy\",\"Paroxysmal Nocturnal Hemoglobinuria\"]},\"designModule\":{\"studyType\":\"INTERVENTIONAL\",\"phases\":[\"PHASE1\"],\"designInfo\":{\"allocation\":\"RANDOMIZED\",\"interventionModel\":\"CROSSOVER\",\"primaryPurpose\":\"TREATMENT\",\"maskingInfo\":{\"masking\":\"NONE\"}},\"enrollmentInfo\":{\"count\":16,\"type\":\"ACTUAL\"}},\"armsInterventionsModule\":{\"armGroups\":[{\"label\":\"HRS-5965 Group A\",\"type\":\"EXPERIMENTAL\",\"interventionNames\":[\"Drug: HRS-5965 Capsules\"]},{\"label\":\"HRS-5965 Group B\",\"type\":\"EXPERIMENTAL\",\"interventionNames\":[\"Drug: HRS-5965 Capsules\"]}],\"interventions\":[{\"type\":\"DRUG\",\"name\":\"HRS-5965 Capsules\",\"description\":\"Oral doses of HRS-5965 capsules at fasted and fed conditions.\",\"armGroupLabels\":[\"HRS-5965 Group A\",\"HRS-5965 Group B\"]}]},\"outcomesModule\":{\"primaryOutcomes\":[{\"measure\":\"Peak concentration (Cmax) of HRS-5965\",\"timeFrame\":\"Day 1 to Day 13.\"},{\"measure\":\"Area under the plasma concentration - time curve from time 0 to the last quantifiable timepoint (AUC0-t)\",\"timeFrame\":\"Day 1 to Day 13.\"}],\"secondaryOutcomes\":[{\"measure\":\"Time to peak concentration (Tmax)\",\"timeFrame\":\"Day 1 to Day 13.\"},{\"measure\":\"Adverse events (AEs)\",\"timeFrame\":\"Day 1 to Day 20.\"}]},\"eligibilityModule\":{\"eligibilityCriteria\":\"Inclusion Criteria:\\n\\n1. Signed the informed consent form pre-trial.\\n2. Aged 18-45 years at signing the informed consent form.\\n3. Childbearing potential subjects: no pregnancy/sperm/egg donation plans; effective contraception.\\n\\nExclusion Criteria:\\n\\n1. Recent infection (≤2 weeks): pathogen-positive test, systemic antibiotics, or fever \\\\> 38°C.\\n2. Major trauma/surgery (≤8 weeks) or planned surgery during the study.\\n3. Drug abuse history or positive urine drug screen.\\n4. Investigator-assessed suitability concerns: increased risk, compliance issues, or clinical ineligibility.\",\"healthyVolunteers\":true,\"sex\":\"ALL\",\"minimumAge\":\"18 Years\",\"maximumAge\":\"45 Years\",\"stdAges\":[\"ADULT\"]},\"contactsLocationsModule\":{\"locations\":[{\"facility\":\"ZhongShan Hospital FuDan University\",\"city\":\"Shanghai\",\"state\":\"Shanghai Municipality\",\"zip\":\"200032\",\"country\":\"China\",\"geoPoint\":{\"lat\":31.22222,\"lon\":121.45806}}]},\"ipdSharingStatementModule\":{\"ipdSharing\":\"UNDECIDED\"}},\"derivedSection\":{\"miscInfoModule\":{\"versionHolder\":\"2026-09-18\"},\"conditionBrowseModule\":{\"meshes\":[{\"id\":\"D005922\",\"term\":\"Glomerulonephritis, IGA\"},{\"id\":\"D006457\",\"term\":\"Hemoglobinuria, Paroxysmal\"}],\"ancestors\":[{\"id\":\"D005921\",\"term\":\"Glomerulonephritis\"},{\"id\":\"D009393\",\"term\":\"Nephritis\"},{\"id\":\"D007674\",\"term\":\"Kidney Diseases\"},{\"id\":\"D014570\",\"term\":\"Urologic Diseases\"},{\"id\":\"D052776\",\"term\":\"Female Urogenital Diseases\"},{\"id\":\"D005261\",\"term\":\"Female Urogenital Diseases and Pregnancy Complications\"},{\"id\":\"D000091642\",\"term\":\"Urogenital Diseases\"},{\"id\":\"D052801\",\"term\":\"Male Urogenital Diseases\"},{\"id\":\"D001327\",\"term\":\"Autoimmune Diseases\"},{\"id\":\"D007154\",\"term\":\"Immune System Diseases\"},{\"id\":\"D000743\",\"term\":\"Anemia, Hemolytic\"},{\"id\":\"D000740\",\"term\":\"Anemia\"},{\"id\":\"D006402\",\"term\":\"Hematologic Diseases\"},{\"id\":\"D006425\",\"term\":\"Hemic and Lymphatic Diseases\"},{\"id\":\"D009190\",\"term\":\"Myelodysplastic Syndromes\"},{\"id\":\"D001855\",\"term\":\"Bone Marrow Diseases\"}]}},\"hasResults\":false}", "media_type": "application/json", "text_derivation": {"extractor_version": "stdlib-json-object-slice-v1", "method": "ctgov-study-json-v1", "raw_asset": {"byte_size": 457706, "media_type": "application/json", "relative_path": "evidence/raw/sha256/3f/3fe1ddcfbfa71754f89255193ae05b8e4bd6fd439e53f59968601536f5d8d004.bin", "sha256": "3fe1ddcfbfa71754f89255193ae05b8e4bd6fd439e53f59968601536f5d8d004"}, "record_selector": {"nct_id": "NCT07035665", "study_index": 1}, "schema_version": "1.0", "text_sha256": "b3472b541f828f4df3a93e18c7bd41327010f5c07ba5963cab51cf86a5cd07f2"}}