}]}]},"moreInfoModule":{"limitationsAndCaveats":{"description":"The sponsor decided to terminate the development program (including this study)."},"certainAgreement":{"piSponsorEmployee":false,"restrictiveAgreement":true},"pointOfContact":{"title":"Study Director","organization":"BioCryst Pharmaceuticals Inc","email":"clinicaltrials@biocryst.com","phone":"+1 919-859-1302"}}},"documentSection":{"largeDocumentModule":{"largeDocs":[{"typeAbbrev":"Prot","hasProtocol":true,"hasSap":false,"hasIcf":false,"label":"Study Protocol","date":"2022-08-01","uploadDate":"2024-09-13T07:25","filename":"Prot_000.pdf","size":1522466},{"typeAbbrev":"SAP","hasProtocol":false,"hasSap":true,"hasIcf":false,"label":"Statistical Analysis Plan","date":"2023-10-04","uploadDate":"2024-09-13T07:26","filename":"SAP_001.pdf","size":708534}]}},"derivedSection":{"miscInfoModule":{"versionHolder":"2026-09-04","removedCountries":["Spain","Taiwan","United States"],"submissionTracking":{"firstMcpInfo":{"postDateStruct":{"date":"2024-10-08","type":"ACTUAL"}}}},"conditionBrowseModule":{"meshes":[{"id":"D006457","term":"Hemoglobinuria, Paroxysmal"}],"ancestors":[{"id":"D000743","term":"Anemia, Hemolytic"},{"id":"D000740","term":"Anemia"},{"id":"D006402","term":"Hematologic Diseases"},{"id":"D006425","term":"Hemic and Lymphatic Diseases"},{"id":"D009190","term":"Myelodysplastic Syndromes"},{"id":"D001855","term":"Bone Marrow Diseases"}]}},"hasResults":true},
{"protocolSection":{"identificationModule":{"nctId":"NCT05776472","orgStudyIdInfo":{"id":"Sobi.PEGCET-304"},"organization":{"fullName":"Swedish Orphan Biovitrum","class":"INDUSTRY"},"briefTitle":"A Real World Effectiveness Study of Pegcetacoplan in Patients With Paroxysmal Nocturnal Hemoglobinuria (PNH)","officialTitle":"A Single Arm, Long-term, Multicentre Observational Study to Evaluate Effectiveness of Pegcetacoplan Under Real World Conditions in Patients With Paroxysmal Nocturnal Hemoglobinuria (PNH)","acronym":"COMPLETE"},"statusModule":{"statusVerifiedDate":"2026-06","overallStatus":"ACTIVE_NOT_RECRUITING","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2023-06-26","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2029-08-15","type":"ESTIMATED"},"completionDateStruct":{"date":"2029-08-15","type":"ESTIMATED"},"studyFirstSubmitDate":"2023-02-20","studyFirstSubmitQcDate":"2023-03-17","studyFirstPostDateStruct":{"date":"2023-03-20","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-09-01","lastUpdatePostDateStruct":{"date":"2026-09-03","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Swedish Orphan Biovitrum","class":"INDUSTRY"},"collaborators":[{"name":"IQVIA Pty Ltd","class":"INDUSTRY"}]},"oversightModule":{"oversightHasDmc":false,"isFdaRegulatedDrug":true,"isFdaRegulatedDevice":false},"descriptionModule":{"briefSummary":"This is a 36-month, long-term, multicenter, observational study designed to describe the real world effectiveness of pegcetacoplan in patients with PNH. Patients meeting the eligibility criteria will be enrolled in the study and followed prospectively for approximately 36 months. Patient data will be collected from start of pegcetacoplan treatment to end of follow-up. Retrospective data on pegcetacoplan will be captured from the time of pegcetacoplan treatment initiation. Pegcetacoplan treatment data will be collected for a minimum of approximately 36 months and up to a maximum of approximately 72 months, including retrospective period depending on when the patient started pegcetacoplan treatment. After pegcetacoplan treatment discontinuation, patients will remain in the study for 8 weeks to capture any AEs. The scope of the study is to collect both retrospective and prospective data. Baseline is defined as start of pegcetacoplan treatment. The main part of the study will be prospective,collecting data on effectiveness, safety (all AEs), patient- and clinician-reported outcomes and health care resource use.","detailedDescription":"As pegcetacoplan is a new product on the market, with a new mechanism of action, there is an urgent need to provide data to treaters, payers and the PNH community on the real-world usage and effectiveness of pegcetacoplan. This study aims to fill part of that knowledge gap and to add to the knowledge base regarding the use of pegcetacoplan in routine medical practice. Another important rationale for this study is to provide information on RBC transfusions and health care resource utilization pre and post pegcetacoplan treatment initiation.\n\nThe study plans to include approximately 200 patients at 70 sites in Europe, Middle East, Canada and Australia. Additional countries may be added in the study if necessary. Patients meeting the eligibility criteria will be enrolled in the study and followed prospectively for approximately 36 months. Patient data will be collected from start of pegcetacoplan treatment to end of follow-up. Retrospective data on pegcetacoplan will be captured from the time of pegcetacoplan treatment initiation. Pegcetacoplan treatment data will be collected for a minimum of approximately 36 months and up to a maximum of approximately 72 months, including retrospective period depending on when the patient started pegcetacoplan treatment. After pegcetacoplan treatment discontinuation, patients will remain in the study for 8 weeks to capture any AEs. Patients will come to their routine visits and the available data from each visit will be collected.\n\nThe scope of the study is to collect both retrospective and prospective data. The main part of the study will be prospective, collecting data on effectiveness, safety, patient- and clinician-reported outcomes and health care resource use. The study will also collect retrospective data before pegcetacoplan treatment start, which will consist of information on PNH treatment, blood transfusions and healthcare resource use. Data will be collected for up to 12 months prior to pegcetacoplan treatment start. As patients may have been treated with pegcetacoplan for up to 12 months prior to enrollment, retrospective data may be collected for up to 24 months. This means that the total data collection period including both the retrospective and the prospective part is up to 48 (+/- 3) months."},"conditionsModule":{"conditions":["Paroxysmal Nocturnal Hemoglobinuria"]},"designModule":{"studyType":"OBSERVATIONAL","patientRegistry":false,"designInfo":{"observationalModel":"COHORT","timePerspective":"OTHER"},"enrollmentInfo":{"count":165,"type":"ACTUAL"}},"armsInterventionsModule":{"interventions":[{"type":"DRUG","name":"Pegcetacoplan","description":"Pegcetacoplan will be prescribed according to the label in patients with PNH.","otherNames":["Aspaveli, Empaveli"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Change in observed hemoglobin level from initiation of treatment with pegcetacoplan to 6 months","description":"Hemoglobin level in g/dL.","timeFrame":"6 months"}],"secondaryOutcomes":[{"measure":"Change of LDH values from initiation of pegcetacoplan treatment to 6 months","description":"Lactate Dehydrogenase (LDH) in U/L","timeFrame":"6 months"},{"measure":"Change in Absolute Reticulocyte Count (ARC) from initiation of pegcetacoplan treatment to 6 months","description":"Absolute Reticulocyte Count (ARC) in 10\\^9/L","timeFrame":"6 months"},{"measure":"Change in indirect/ total bilirubin from initiation of pegcetacoplan treatment to 6 months","description":"Indirect/ total bilirubin in umol/L","timeFrame":"6 months"},{"measure":"Change in Haptoglobin from initiation of pegcetacoplan treatment to 6 months","description":"Haptoglobin in mg/dL","timeFrame":"6 months"},{"measure":"Change in Ferritin from initiation of pegcetacoplan treatment to 6 months","description":"Ferritin in ug/L","timeFrame":"6 months"},{"measure":"Hemoglobin at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Hemoglobin in g/dL","timeFrame":"6 months"},{"measure":"Hemoglobin at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Hemoglobin in g/dL","timeFrame":"12 months"},{"measure":"Hemoglobin at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Hemoglobin in g/dL","timeFrame":"18 months"},{"measure":"Hemoglobin at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Hemoglobin in g/dL","timeFrame":"24 months"},{"measure":"Hemoglobin at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Hemoglobin in g/dL","timeFrame":"30 months"},{"measure":"Hemoglobin at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Hemoglobin in g/dL","timeFrame":"36 months"},{"measure":"Lactate Dehydrogenase at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Lactate Dehydrogenase (LDH) in U/L","timeFrame":"6 months"},{"measure":"Lactate Dehydrogenase at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Lactate Dehydrogenase (LDH) in U/L","timeFrame":"12 months"},{"measure":"Lactate Dehydrogenase at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Lactate Dehydrogenase (LDH) in U/L","timeFrame":"18 months"},{"measure":"Lactate Dehydrogenase at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Lactate Dehydrogenase (LDH) in U/L","timeFrame":"24 months"},{"measure":"Lactate Dehydrogenase at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Lactate Dehydrogenase (LDH) in U/L","timeFrame":"30 months"},{"measure":"Lactate Dehydrogenase at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Lactate Dehydrogenase (LDH) in U/L","timeFrame":"36 months"},{"measure":"Absolute Reticulocyte Count at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Absolute Reticulocyte Count (ARC) in 10\\^9/L","timeFrame":"6 months"},{"measure":"Absolute Reticulocyte Count at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Absolute Reticulocyte Count (ARC) in 10\\^9/L","timeFrame":"12 months"},{"measure":"Absolute Reticulocyte Count at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Absolute Reticulocyte Count (ARC) in 10\\^9/L","timeFrame":"18 months"},{"measure":"Absolute Reticulocyte Count at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Absolute Reticulocyte Count (ARC) in 10\\^9/L","timeFrame":"24 months"},{"measure":"Absolute Reticulocyte Count at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Absolute Reticulocyte Count (ARC) in 10\\^9/L","timeFrame":"30 months"},{"measure":"Absolute Reticulocyte Count at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Absolute Reticulocyte Count (ARC) in 10\\^9/L","timeFrame":"36 months"},{"measure":"Indirect/ total bilirubin at initiation of pegcetacoplan treatment and each 6 months until end of follow-up","description":"Indirect/ total bilirubin in umo