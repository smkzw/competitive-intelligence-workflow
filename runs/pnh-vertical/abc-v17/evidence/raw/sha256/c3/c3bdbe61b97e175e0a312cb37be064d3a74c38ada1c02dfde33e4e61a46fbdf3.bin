HEAD/HEADACHE","organSystem":"Nervous system disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":7,"numAtRisk":17}]},{"term":"SEIZURE","organSystem":"Nervous system disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":17}]},{"term":"TREMOR","organSystem":"Nervous system disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":7,"numAtRisk":17}]},{"term":"MOOD ALTERATION - ANXIETY","organSystem":"Psychiatric disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":17}]},{"term":"MOOD ALTERATION - DEPRESSION","organSystem":"Psychiatric disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":4,"numAtRisk":17}]},{"term":"PSYCHOSIS (HALLUCINATIONS/DELUSIONS)","organSystem":"Psychiatric disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":17}]},{"term":"BLADDER SPASMS","organSystem":"Renal and urinary disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":1,"numAtRisk":17}]},{"term":"PAIN - BLADDER","organSystem":"Renal and urinary disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":17}]},{"term":"RENAL FAILURE","organSystem":"Renal and urinary disorders","sourceVocabulary":"MedDRA (9.0)","assessmentType":"NON_SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numAffected":2,"numAtRisk":17}]},{"term":"RENAL/GENITOURINARY - OTHER","organSystem":"Renal and urinary disorders","sourceVocabulary":"MedDRA (9.0)",