002","value":"0"}]}]}]}]},"outcomeMeasuresModule":{"outcomeMeasures":[{"type":"PRIMARY","title":"Percent Change in Lactate Dehydrogenase (LDH) From Baseline to Week 36","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"From baseline to week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Percentage of Participants With Transfusion Avoidance After Day 1 Through Week 36","description":"Participants who do not receive a red blood cell (RBC) transfusion as per protocol algorithm based on post baseline hemoglobin values","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints..","reportingStatus":"POSTED","timeFrame":"Day 1 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Percentage of Participants With Transfusion Avoidance From Week 4 Through Week 36","description":"Participants who do not receive an RBC transfusion as per protocol algorithm based on post baseline hemoglobin values","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints..","reportingStatus":"POSTED","timeFrame":"Week 4 through week 36","groups":[{"id":"OG000","ti