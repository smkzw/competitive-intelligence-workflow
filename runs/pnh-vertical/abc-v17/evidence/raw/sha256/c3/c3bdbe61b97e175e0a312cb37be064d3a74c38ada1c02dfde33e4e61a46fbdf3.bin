escription":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Percentage of Participants With Adequate Control of LDH After Day 1 Though Week 36","description":"Percentage of participants with adequate control of LDH as defined in the protocol","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints..","reportingStatus":"POSTED","timeFrame":"Day 1 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Percentage of Participants Who Maintained Adequate Control of Hemolysis From Week 8 Through Week 36","description":"Percentage of participants with adequate control of LDH as defined in the protocol","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Week 8 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Percentage of Participants Who Maintained Adequate Control of Hemolysis After Day 1 Through Week 36","description":"Percentage of participants with adequate control of LDH as defined in the protocol","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Day 1 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Percentage of Participants With Normalization of LDH From Week 8 Through Week 36","description":"Percentage of participants with normalization of LDH as defined in the protocol","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints..","reportingStatus":"POSTED","timeFrame":"Week 8 (day 57) through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Percentage of Participants With Normalization of LDH After Day 1 Through Week 36","description":"Percentage of participants with normalization of LDH as defined in the protocol","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints..","reportingStatus":"POSTED","timeFrame":"Day 1 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Change in Fatigue as Measured by the Functional Assessment of Chronic Illness Therapy-Fatigue (FACIT-Fatigue) Scale From Baseline to Week 36","description":"The FACIT-Fatigue is a 13 item, self-administered clinical outcome assessment (COA) assessing an individual's level of fatigue during their usual daily activities over the past week. This questionnaire is part of the FACIT measurement system, a compilation of questions measuring health related quality of life (QoL) in patients with cancer and other chronic illnesses. The FACIT-Fatigue assesses the level of fatigue using a Likert scale ranging from 0 (not at all) to 4 (very much). Scores range from 0 to 52, with higher scores indicating greater fatigue.","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints..","reportingStatus":"POSTED","timeFrame":"From baseline to week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Change in Physical Function (PF) Score on the European Organization for Research and Treatment of Cancer Quality-of-Life Questionnaire Core 30 Items (EORTC-QLQ-C30) From Baseline to Week 36","description":"EORTC-QLQ-C30 is a 30-item subject self-report questionnaire composed of both multi-item and single scales, including global health status/quality of life, functional Scales (physical, role, emotional, cognitive, and social), symptom scales (fatigue, nausea and vomiting, and pain), and 6 single items (dyspnea, insomnia, appetite loss, constipation, diarrhea, and financial difficulties). Participants rate items on a 4-point scale, with 1 as \"not at all\" and 4 as \"very much.\"","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints..","reportingStatus":"POSTED","timeFrame":"From baseline to week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Change in Global Health Status (GHS)/QoL Scale Score on the EORTC-QLQ-C30 From Baseline to Week 36","description":"EORTC-QLQ-C30 is a 30-item subject self-report questionnaire composed of both multi-item and single scales, including global health status/quality of life, functional Scales (physical, role, emotional, cognitive, and social), symptom scales (fatigue, nausea and vomiting, and pain), and 7 single items (dyspnea, insomnia, appetite loss, constipation, diarrhea, sleep and financial difficulties). Participants rate items on a 4-point scale, with 1 as \"not at all\" and 4 as \"very much.\"","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints..","reportingStatus":"POSTED","timeFrame":"From baseline to week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Rate of RBCs Transfused Per Protocol Algorithm After Day 1 Through Week 36","description":"Per protocol algorithm","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Day 1 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Rate of RBCs Transfused Per Protocol Algorithm From Week 4 Through Week 36","description":"Per protocol algorithm","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Week 4 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Number of Units of RBCs Transfused Per Protocol Algorithm After Day 1 Through Week 36","description":"Per protocol algorithm","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Day 1 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Number of Units of RBCs Transfused Per Protocol Algorithm From Week 4 Through Week 36","description":"Per protocol algorithm","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Week 4 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Change in Hemoglobin Levels From Baseline to Week 36","description":"Per protocol algorithm","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"From baseline to week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Incidence of Treatment Emergent Serious Adverse Events (SAEs)","description":"Treatment period and safety follow up period","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"Events","timeFrame":"Up to week 29","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"2"},{"groupId":"OG001","value":"1"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]}]},{"type":"SECONDARY","title":"Incidence of Treatment-emergent Adverse Events (TEAEs) of Special Interest","description":"Treatment period and safety follow up period","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"Events","timeFrame":"Up to week 29","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms