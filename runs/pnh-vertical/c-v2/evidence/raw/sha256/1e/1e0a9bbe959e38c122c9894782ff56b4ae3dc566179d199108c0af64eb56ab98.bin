"OG001","value":"5"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"1240","spread":"372"},{"groupId":"OG001","value":"1800","spread":"368"}]}]},{"title":"Day 57","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"6"},{"groupId":"OG003","value":"5"}]}],"categories":[{"measurements":[{"groupId":"OG002","value":"2640","spread":"590"},{"groupId":"OG003","value":"4520","spread":"1520"}]}]}]},{"type":"SECONDARY","title":"Pharmacokinetics Profile: Area Under the Curve Tau (AUCtau)","description":"The AUCtau is the area under the plasma concentration-time curve calculated to the end of a dosing interval (tau) at steady-state (amount x time x volume-1).\n\nAUCtau was estimated by imputing the 12-hour iptacopan plasma concentration as the PK profile's corresponding pre-dose (0-hour) value, that is, by assuming that at steady-state the iptacopan plasma concentration is the same as the beginning (pre-dose) and end (12 hours postdose) of the dosing interval.\n\nPK parameters were determined, using non-compartmental method(s) with Phoenix WinNonlin (Version 8.3), from the plasma concentration-time data.","populationDescription":"The overall number of participants analyzed represents the participants in the PK analysis set who had at least one valid measurement of AUCtau.\n\nThe number analyzed per row represents the participants with a valid AUCtau value for that particular visit.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"h*ng/mL","timeFrame":"Days 29 and 57","groups":[{"id":"OG000","title":"LNP023 25 mg Bid","description":"Four weeks of treatment with iptacopan 25 mg bid in Period 1"},{"id":"OG001","title":"LNP023 50 mg Bid","description":"Four weeks of treatment with iptacopan 50 mg bid in Period 1"},{"id":"OG002","title":"LNP023 100 mg Bid","description":"Treatment with iptacopan 100 mg bid in Period 2 and Period 3."},{"id":"OG003","title":"LNP023 200 mg Bid","description":"Treatment with iptacopan 200 mg bid in Period 2 and Period 3"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"6"},{"groupId":"OG001","value":"5"},{"groupId":"OG002","value":"6"},{"groupId":"OG003","value":"5"}]}],"classes":[{"title":"Day 29","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"6"},{"groupId":"OG001","value":"5"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"9630","spread":"3870"},{"groupId":"OG001","value":"15200","spread":"2390"}]}]},{"title":"Day 57","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"6"},{"groupId":"OG003","value":"5"}]}],"categories":[{"measurements":[{"groupId":"OG002","value":"19800","spread":"4900"},{"groupId":"OG003","value":"33300","spread":"8830"}]}]}]},{"type":"SECONDARY","title":"Pharmacokinetics Profile: Minimum Plasma Concentration (Cmin)","description":"Cmin is the lowest plasma concentration observed during a dosing interval at steady state \\[mass / volume\\].\n\nPK parameters were determined, using non-compartmental method(s) with Phoenix WinNonlin (Version 8.3), from the plasma concentration-time data.","populationDescription":"The overall number of participants analyzed represents the participants in the PK analysis set who had at least one valid measurement of Cmin.\n\nThe number analyzed per row represents the participants with a valid Cmin value for that particular visit.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"ng/mL","timeFrame":"Days 29 and 57","groups":[{"id":"OG000","title":"LNP023 25 mg Bid","description":"Four weeks of treatment with iptacopan 25 mg bid in Period 1"},{"id":"OG001","title":"LNP023 50 mg Bid","description"