","stats":[{"groupId":"EG000","numEvents":1,"numAffected":1,"numAtRisk":5},{"groupId":"EG001","numEvents":0,"numAffected":0,"numAtRisk":8}]},{"term":"Administration site pain","organSystem":"General disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":0,"numAffected":0,"numAtRisk":5},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":8}]},{"term":"Cholelithiasis","organSystem":"Hepatobiliary disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":0,"numAffected":0,"numAtRisk":5},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":8}]},{"term":"Pallor","organSystem":"Vascular disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":0,"numAffected":0,"numAtRisk":5},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":8}]},{"term":"Dysmenorrhoea","organSystem":"Reproductive system and breast disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","notes":"The N for this adverse event has been adjusted to the number of females in the study as it is a sex-specific event.","stats":[{"groupId":"EG000","numEvents":0,"numAffected":0,"numAtRisk":1},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":7}]},{"term":"Asthenia","organSystem":"General disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":0,"numAffected":0,"numAtRisk":5},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":8}]},{"term":"Catheter site pain","organSystem":"General disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":1,"numAffected":1,"numAtRisk":5},{"groupId":"EG001","numEvents":0,"numAffected":0,"numAtRisk":8}]},{"term":"Chest pain","organSystem":"General disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":0,"numAffected":0,"numAtRisk":5},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":8}]},{"term":"Non-cardiac chest pain","organSystem":"General disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":0,"numAffected":0,"numAtRisk":5},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":8}]},{"term":"Chromosomal deletion","organSystem":"Congenital, familial and genetic disorders","sourceVocabulary":"MedDRA 25.1","assessmentType":"SYSTEMATIC_ASSESSMENT","stats":[{"groupId":"EG000","numEvents":0,"numAffected":0,"numAtRisk":5},{"groupId":"EG001","numEvents":1,"numAffected":1,"numAtRisk":8}]}]},"moreInfoModule":{"certainAgreement":{"piSponsorEmployee":false,"restrictiveAgreement":true},"pointOfContact":{"title":"Alexion Pharmaceuticals, Inc.","organization":"Alexion Pharmaceuticals, Inc.","email":"clinicaltrials@alexion.com","phone":"1.855.752.2356"}}},"documentSection":{"largeDocumentModule":{"largeDocs":[{"typeAbbrev":"Prot","hasProtocol":true,"hasSap":false,"hasIcf":false,"label":"Study Protocol","date":"2020-04-22","uploadDate":"2023-02-23T14:03","filename":"Prot_002.pdf","size":3962070},{"typeAbbrev":"SAP","hasProtocol":false,"hasSap":true,"hasIcf":false,"label":"Statistical Analysis Plan","date":"2020-05-08","uploadDate":"2021-09-15T11:35","filename":"SAP_001.pdf","size":2630384}]}},"derivedSection":{"miscInfoModule":{"versionHolder":"2026-09-04","submissionTracking":{"firstMcpInfo":{"postDateStruct":{"date":"2021-10-19","type":"ACTUAL"}}}},"conditionBrowseModule":{"meshes":[{"id":"D006457","term":"Hemoglobinuria, Paroxysmal"}],"ancestors":[{"id":"D000743","term":"Anemia, Hemolytic"},{"id":"D000740","term":"Anemia"},{"id":"D006402","term":"Hematologic Diseases"},{"id":"D006425","term":"Hemic and Lymphatic Diseases"},{"id":"D009190","term":"Myelodysplastic Syndromes"},{"id":"D001855","