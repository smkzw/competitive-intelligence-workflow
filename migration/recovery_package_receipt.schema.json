{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/recovery-package-receipt.schema.json",
  "title": "recovery-package-v1 恢复包严格回执",
  "description": "字段集合与 tools/legacy_cutover.py 消费端 _verify_recovery 完全锁定：恰好五个字段，未知字段一律拒绝。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "status",
    "recovery_package_sha256",
    "issued_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_kind": {"const": "recovery-package-v1"},
    "status": {"const": "passed"},
    "recovery_package_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
