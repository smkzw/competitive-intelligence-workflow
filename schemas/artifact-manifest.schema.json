{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.example/schemas/artifact-manifest.schema.json",
  "title": "附录 C 产物清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "project_id", "contract_version", "report",
    "report_version", "data_cutoff", "producer_run_id", "source_commit",
    "package_digest", "evidence_snapshot_id", "claim_snapshot_id",
    "report_snapshot_id", "coverage_set_id", "coverage_projection_id",
    "structured_exceptions", "pages_or_sections", "product_ids", "trial_ids",
    "claim_ids", "chart_ids", "table_ids", "evidence_reference_ids",
    "design_contract", "renderer", "filter_state", "generated_at",
    "deterministic_checks", "render_verdict", "accepted_by", "artifact", "status",
    "supersedes_manifest_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "integer", "minimum": 1},
    "report": {"enum": ["A", "B", "C"]},
    "report_version": {"type": "string", "minLength": 1},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "producer_run_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "package_digest": {"$ref": "#/$defs/sha256"},
    "evidence_snapshot_id": {"type": "string", "minLength": 1},
    "claim_snapshot_id": {"type": "string", "minLength": 1},
    "report_snapshot_id": {"type": "string", "minLength": 1},
    "coverage_set_id": {"type": "string", "minLength": 1},
    "coverage_projection_id": {"type": "string", "minLength": 1},
    "structured_exceptions": {"type": "array", "items": {"type": "object"}},
    "pages_or_sections": {"$ref": "#/$defs/nonempty_unique_strings"},
    "product_ids": {"$ref": "#/$defs/unique_strings"},
    "trial_ids": {"$ref": "#/$defs/unique_strings"},
    "claim_ids": {"$ref": "#/$defs/nonempty_unique_strings"},
    "chart_ids": {"$ref": "#/$defs/unique_strings"},
    "table_ids": {"$ref": "#/$defs/unique_strings"},
    "evidence_reference_ids": {"$ref": "#/$defs/nonempty_unique_strings"},
    "design_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "digest", "applicable_sections"],
      "properties": {
        "roles": {"$ref": "#/$defs/nonempty_unique_strings"},
        "digest": {"$ref": "#/$defs/sha256"},
        "applicable_sections": {"$ref": "#/$defs/nonempty_unique_strings"}
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "filter_state": {"type": "object"},
    "generated_at": {"type": "string", "format": "date-time"},
    "deterministic_checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "receipt"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "receipt": {"type": "string", "minLength": 1}
        }
      }
    },
    "render_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict_id", "status", "verified_at", "anchor_ids"],
      "properties": {
        "verdict_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["accepted", "rejected"]},
        "verified_at": {"type": "string", "format": "date-time"},
        "anchor_ids": {"$ref": "#/$defs/nonempty_unique_strings"}
      }
    },
    "accepted_by": {"type": ["string", "null"], "minLength": 1},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "byte_size", "modified_at", "media_type"],
      "properties": {
        "relative_path": {
          "type": "string", "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1},
        "modified_at": {"type": "string", "format": "date-time"},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["generated", "quality_check", "accepted", "failed", "superseded"]},
    "supersedes_manifest_id": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "accepted"}}, "required": ["status"]},
      "then": {
        "properties": {
          "accepted_by": {"type": "string", "minLength": 1},
          "render_verdict": {
            "properties": {"status": {"const": "accepted"}},
            "required": ["status"]
          },
          "deterministic_checks": {
            "items": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unique_strings": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonempty_unique_strings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
