{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/source-version.schema.json",
  "title": "来源版本",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_role": {"type": "string", "minLength": 1},
        "field_path": {"type": ["string", "null"], "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "table": {"type": ["string", "null"], "minLength": 1},
        "paragraph": {"type": ["string", "null"], "minLength": 1},
        "url": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["document_role", "field_path", "page", "table", "paragraph", "url"],
      "anyOf": [
        {"properties": {"field_path": {"type": "string"}}},
        {"properties": {"page": {"type": "integer"}}},
        {"properties": {"table": {"type": "string"}}},
        {"properties": {"paragraph": {"type": "string"}}},
        {"properties": {"url": {"type": "string"}}}
      ]
    },
    "date_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["reported", "not_publicly_disclosed", "not_applicable"]},
        "value": {
          "type": ["string", "null"], "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "locator": {"$ref": "#/$defs/locator"}
      },
      "required": ["state", "value", "locator"],
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "reported"}}},
          "then": {
            "properties": {
              "value": {
                "type": "string", "format": "date-time",
                "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              }
            }
          },
          "else": {"properties": {"value": {"type": "null"}}}
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_version_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_relative_path": {
      "type": "string",
      "pattern": "^evidence/raw/sha256/[0-9a-f]{2}/[0-9a-f]{64}\\.bin$"
    },
    "media_type": {"type": "string", "minLength": 1},
    "acquired_at": {
      "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "acquired_locator": {"$ref": "#/$defs/locator"},
    "published_at": {"$ref": "#/$defs/date_evidence"},
    "effective_at": {"$ref": "#/$defs/date_evidence"},
    "first_disclosed_at": {"$ref": "#/$defs/date_evidence"},
    "created_at": {
      "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "schema_version", "source_version_id", "source_id", "content_sha256",
    "content_relative_path", "media_type", "acquired_at", "acquired_locator",
    "published_at", "effective_at", "first_disclosed_at", "created_at"
  ]
}
