{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/source-eligibility.schema.json",
  "title": "来源路线适用性",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_eligibility_id": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "minLength": 1},
    "strategy_unit_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "gap_id": {"type": "string", "minLength": 1},
    "claim_domain": {
      "enum": [
        "drug_identity_mechanism",
        "trial_identity_design_status",
        "efficacy_safety_results",
        "baseline_disposition",
        "regulatory_development_status",
        "china_development_regulatory_status",
        "company_relationships_transactions",
        "patents_protection"
      ]
    },
    "applicability": {"enum": ["applicable", "not_applicable", "access_blocked"]},
    "required_by_policy": {"type": "boolean"},
    "rationale_zh": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "evidence_fragment_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decided_by": {"type": "string", "minLength": 1},
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "schema_version", "source_eligibility_id", "route_id", "strategy_unit_id",
    "entity_id", "gap_id", "claim_domain", "applicability",
    "required_by_policy", "rationale_zh", "policy_id", "policy_version",
    "evidence_fragment_ids", "decided_by", "decided_at"
  ]
}
