{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/gate-override.schema.json",
  "title": "项目证据门槛覆盖版本",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "override_id",
    "base_spec_version",
    "parent_contract_version",
    "child_contract_version",
    "change_summary_zh",
    "changed_unit_ids",
    "affected_report_kinds",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "override_id": {"type": "string", "minLength": 1},
    "base_spec_version": {"type": "string", "minLength": 1},
    "parent_contract_version": {"type": "string", "minLength": 1},
    "child_contract_version": {"type": "string", "minLength": 1},
    "change_summary_zh": {"type": "string", "minLength": 1},
    "changed_unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "affected_report_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["A", "B", "C"]}
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
