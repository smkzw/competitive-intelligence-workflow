{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.example/ci-workflow/project-contract.schema.json",
  "$comment": "验证器必须注册项目运行时提供的 iana-timezone 格式检查器。",
  "title": "竞品调研项目合同",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "project_id",
    "indication",
    "reports",
    "outputs",
    "timezone",
    "data_cutoff",
    "cutoff_was_user_supplied",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "pattern": "^project_[0-9a-f]{24}$"},
    "indication": {"type": "string", "minLength": 1},
    "reports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["A", "B", "C"]}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "prefixItems": [{"const": "html"}],
      "contains": {"const": "html"},
      "items": {"enum": ["html", "pdf", "html-ppt", "pptx"]}
    },
    "timezone": {"type": "string", "format": "iana-timezone", "minLength": 1},
    "data_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "cutoff_was_user_supplied": {"type": "boolean"},
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
