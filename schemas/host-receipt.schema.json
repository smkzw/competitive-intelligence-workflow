{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.example/schemas/host-receipt.schema.json",
  "title": "竞品调研宿主回执（host-smoke-v1）",
  "description": "证明一次真实 Codex/Hermes/OMP 宿主冒烟运行的唯一回执合同。绑定：已安装包（名称/版本/摘要）、fixture 案例与逐文件摘要、真实安装入口、宿主可执行文件/版本及 path_resolved|explicit|unavailable 来源、启动进程与外部子进程（PID、完整 argv、开始/结束时间、真实退出码）、会话、项目/运行、事件链（数量与摘要）、no-draft 断言与最终 manifest（路径/摘要/manifest_digest）。receipt_digest 是除自身外全部字段的规范 JSON SHA-256；同进程伪造、旧回执与 adapter-only JSON 由 HA09 验证器对照项目当前状态裁决，本 Schema 在结构层失败关闭。关键证据阻断（state=blocked）必须零产物且 no_draft 为真；complete/partially_delivered 必须至少一个站点式 HTML 产物。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "host",
    "status",
    "unavailable_reason_zh",
    "issued_at",
    "package",
    "entry",
    "host_executable",
    "session",
    "process",
    "fixture",
    "interruption",
    "recovery",
    "run",
    "event_chain",
    "manifest",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_kind": {"const": "host-smoke-v1"},
    "host": {"enum": ["codex", "hermes", "omp"]},
    "status": {"enum": ["verified", "host_unavailable"]},
    "unavailable_reason_zh": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "package": {"$ref": "#/$defs/package"},
    "entry": {"$ref": "#/$defs/entry"},
    "host_executable": {"$ref": "#/$defs/executable"},
    "session": {"$ref": "#/$defs/session"},
    "process": {"$ref": "#/$defs/process"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "interruption": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/interruption"}]
    },
    "recovery": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/recovery"}]
    },
    "run": {"$ref": "#/$defs/run"},
    "event_chain": {"$ref": "#/$defs/event_chain"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "host_unavailable"}}},
      "then": {
        "properties": {
          "host_executable": {
            "properties": {"provenance": {"const": "unavailable"}}
          },
          "unavailable_reason_zh": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "verified"}}},
      "then": {
        "properties": {
          "host_executable": {
            "properties": {"provenance": {"enum": ["path_resolved", "explicit"]}}
          },
          "unavailable_reason_zh": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "package_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "package_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "resolved_path", "sha256"],
      "properties": {
        "kind": {"enum": ["console_script", "python_module"]},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "resolved_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "path", "resolved_realpath", "version"],
      "properties": {
        "provenance": {"enum": ["path_resolved", "explicit", "unavailable"]},
        "path": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "resolved_realpath": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "version": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"provenance": {"const": "unavailable"}}},
          "then": {
            "properties": {
              "path": {"type": "null"},
              "resolved_realpath": {"type": "null"},
              "version": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"provenance": {"enum": ["path_resolved", "explicit"]}}},
          "then": {
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "launcher_pid", "launcher_parent_pid"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "launcher_pid": {"type": "integer", "minimum": 1},
        "launcher_parent_pid": {"type": "integer", "minimum": 1}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pid",
        "argv",
        "cwd",
        "started_at",
        "finished_at",
        "returncode",
        "stdout_tail",
        "stderr_tail"
      ],
      "properties": {
        "kind": {"const": "external_subprocess"},
        "pid": {"type": "integer", "minimum": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "description": "外部进程完整 argv；可为直接安装入口，Task 9.5 必须为真实宿主入口。"
        },
        "cwd": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "returncode": {"type": "integer"},
        "stdout_tail": {"type": "string"},
        "stderr_tail": {"type": "string"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_digest", "inputs"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "case_digest": {"$ref": "#/$defs/sha256"},
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/sha256"},
          "description": "fixture 逐文件摘要：fixture 内 POSIX 相对路径 → SHA-256。"
        }
      }
    },
    "interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "project_id", "outcome", "exit_code", "no_draft",
        "report_file_count", "manifest_relative_path", "manifest_sha256", "manifest_digest",
        "event_count", "event_stream_digest"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "outcome": {"const": "evidence_blocked"},
        "exit_code": {"const": 4},
        "no_draft": {"const": true},
        "report_file_count": {"const": 0},
        "manifest_relative_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_digest": {"$ref": "#/$defs/sha256"},
        "event_count": {"type": "integer", "minimum": 1},
        "event_stream_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason", "reopen_event_id", "reopen_event_digest", "rebind_event_id",
        "rebind_event_digest", "input_relative_path", "input_sha256"
      ],
      "properties": {
        "reason": {"const": "user_material_accepted"},
        "reopen_event_id": {"type": "string", "minLength": 1},
        "reopen_event_digest": {"$ref": "#/$defs/sha256"},
        "rebind_event_id": {"type": "string", "minLength": 1},
        "rebind_event_digest": {"$ref": "#/$defs/sha256"},
        "input_relative_path": {"type": "string", "minLength": 1},
        "input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_root",
        "run_id",
        "project_id",
        "state",
        "outcome",
        "no_draft",
        "exit_code",
        "semantic_receipt_digest",
        "artifacts"
      ],
      "properties": {
        "project_root": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["complete", "partially_delivered", "blocked"]},
        "outcome": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["rendered", "evidence_blocked"]}
          ]
        },
        "no_draft": {"type": "boolean"},
        "exit_code": {"type": "integer"},
        "semantic_receipt_digest": {"$ref": "#/$defs/sha256"},
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "blocked"}}},
          "then": {
            "properties": {
              "artifacts": {"maxItems": 0},
              "no_draft": {"const": true},
              "outcome": {"const": "evidence_blocked"}
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "complete"}}},
          "then": {
            "properties": {
              "artifacts": {"minItems": 1},
              "no_draft": {"const": false},
              "outcome": {"const": "rendered"}
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "partially_delivered"}}},
          "then": {
            "properties": {
              "artifacts": {"minItems": 1},
              "no_draft": {"const": false},
              "outcome": {"type": "null"}
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "output", "entry_relative_path", "entry_sha256"],
      "properties": {
        "report": {"enum": ["A", "B", "C"]},
        "output": {
          "const": "html",
          "description": "首版真实输出仅站点式 HTML（ADR 0013）；其他格式不签发回执绑定。"
        },
        "entry_relative_path": {
          "type": "string",
          "minLength": 1,
          "description": "项目内 POSIX 相对路径，不得包含 .. 或绝对路径。"
        },
        "entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "event_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "stream_digest"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "stream_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "run_id", "outcome", "manifest_digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "项目内 POSIX 相对路径（如 manifests/current_run.json）。"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1},
        "outcome": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["rendered", "evidence_blocked"]}
          ]
        },
        "manifest_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
