{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/fact.schema.json",
  "title": "原子事实版本",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "rule_version": {"type": "string", "minLength": 1},
        "method_zh": {"type": "string", "minLength": 1},
        "original_raw_value": {"type": "string", "minLength": 1},
        "normalized_value": {"type": ["string", "number", "boolean"]},
        "normalized_unit": {"type": ["string", "null"], "minLength": 1},
        "reversible": {"const": true},
        "reverse_expression": {"type": "string", "minLength": 1},
        "created_at": {
          "type": "string", "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "rule_id", "rule_version", "method_zh", "original_raw_value",
        "normalized_value", "normalized_unit", "reversible",
        "reverse_expression", "created_at"
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "fact_id": {"type": "string", "minLength": 1},
    "fact_version_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "field_id": {"type": "string", "minLength": 1},
    "raw_value": {"type": ["string", "null"], "minLength": 1},
    "normalized_value": {"type": ["string", "number", "boolean", "null"]},
    "unit": {"type": ["string", "null"], "minLength": 1},
    "normalized_unit": {"type": ["string", "null"], "minLength": 1},
    "context": {"type": "string", "minLength": 1},
    "arm_id": {"type": ["string", "null"], "minLength": 1},
    "cohort_id": {"type": ["string", "null"], "minLength": 1},
    "population": {"type": "string", "minLength": 1},
    "timepoint": {"type": ["string", "null"], "minLength": 1},
    "time_window": {"type": ["string", "null"], "minLength": 1},
    "numerator": {"type": ["integer", "null"], "minimum": 0},
    "denominator": {"type": ["integer", "null"], "minimum": 1},
    "primary_fragment_id": {"type": "string", "minLength": 1},
    "source_fragment_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "extraction_method": {"type": "string", "minLength": 1},
    "quality_state": {"type": "string", "minLength": 1},
    "disclosure_maturity": {"type": "string", "minLength": 1},
    "source_role": {"type": "string", "minLength": 1},
    "disclosure_state": {
      "enum": [
        "reported_value", "reported_zero", "not_reported",
        "below_reporting_threshold", "not_publicly_disclosed",
        "not_applicable", "conflicting", "unresolved_due_to_route"
      ]
    },
    "review_state": {"enum": ["candidate", "accepted", "rejected", "superseded"]},
    "normalization": {"anyOf": [{"$ref": "#/$defs/normalization"}, {"type": "null"}]},
    "applicability_predicate_id": {"type": ["string", "null"], "minLength": 1},
    "unresolved_route_receipt_id": {"type": ["string", "null"], "minLength": 1},
    "published_at": {
      "type": ["string", "null"], "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "effective_at": {
      "type": ["string", "null"], "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "created_at": {
      "type": "string", "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "supersedes_fact_version_id": {"type": ["string", "null"], "minLength": 1}
  },
  "required": [
    "schema_version", "fact_id", "fact_version_id", "entity_id", "field_id",
    "raw_value", "normalized_value", "unit", "normalized_unit", "context",
    "arm_id", "cohort_id", "population", "timepoint", "time_window",
    "numerator", "denominator", "primary_fragment_id", "source_fragment_ids",
    "extraction_method", "quality_state", "disclosure_maturity", "source_role",
    "disclosure_state", "review_state", "normalization",
    "applicability_predicate_id", "unresolved_route_receipt_id", "published_at",
    "effective_at", "created_at", "supersedes_fact_version_id"
  ],
  "allOf": [
    {
      "anyOf": [
        {"properties": {"timepoint": {"type": "string", "minLength": 1}}},
        {"properties": {"time_window": {"type": "string", "minLength": 1}}}
      ]
    },
    {
      "if": {
        "properties": {
          "disclosure_state": {
            "enum": ["reported_value", "reported_zero", "below_reporting_threshold"]
          }
        }
      },
      "then": {"properties": {"raw_value": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "reported_zero"}}},
      "then": {
        "properties": {
          "raw_value": {
            "type": "string",
            "pattern": "(^|[^0-9.])0(?:\\.0+)?\\s*(?:%|/|$|\\))"
          },
          "numerator": {"enum": [0, null]},
          "normalized_value": {"enum": [0, 0.0, null]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "disclosure_state": {
            "enum": ["not_reported", "not_publicly_disclosed"]
          }
        }
      },
      "then": {
        "properties": {
          "raw_value": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "string",
                "not": {
                  "pattern": "^\\s*[<>≤≥~≈]?\\s*[+-]?(?:[0-9０-９]+(?:[.．][0-9０-９]+)?|[.．][0-9０-９]+)\\s*(?:[%％]|[A-Za-z一-龥][^\\n]*)?\\s*$"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "not_applicable"}}},
      "then": {"properties": {"applicability_predicate_id": {"type": "string"}}}
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "unresolved_due_to_route"}}},
      "then": {"properties": {"unresolved_route_receipt_id": {"type": "string"}}}
    }
  ]
}
