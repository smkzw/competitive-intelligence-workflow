        "candidate_trial_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "eligible_trial_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_trial_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "search_scope_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "exclusion_receipt_summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exhaustion": {
          "$ref": "#/$defs/double_exhaustion"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_digest": {
          "type": "string",
          "minLength": 1
