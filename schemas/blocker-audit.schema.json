{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/blocker-audit.schema.json",
  "title": "证据不足阻断说明",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "report_kind": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "report_version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}(?:-[a-z0-9][a-z0-9.-]*)?$"
    },
    "rule_spec_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "spec_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "evidence_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "universe_summary": {
      "type": "string",
      "minLength": 1
    },
    "gate_result_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "empty_universe": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "a_no_eligible_innovative_product",
        "b_no_eligible_result_trial",
        "c_no_eligible_core_design_trial",
        null
      ]
    },
    "empty_evidence": {
      "$ref": "#/$defs/empty_evidence"
    },
    "empty_justification_zh": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "failed_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failed_unit"
      }
    },
    "impacted_products": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "impacted_trials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "per_gap_audits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gap_audit"
      }
    },
    "route_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route_summary"
      }
    },
    "omission_review_result_zh": {
      "type": "string",
      "minLength": 1
    },
    "has_technical_access_issue": {
      "type": "boolean"
    },
    "residual_uncertainty_zh": {
      "type": "string",
      "minLength": 1
    },
    "user_help_needed": {
      "type": "boolean"
    },
    "user_input_directory": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "minimal_user_action_zh": {
      "type": "string",
      "minLength": 1
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audit_directory": {
      "type": "string",
      "minLength": 1
    },
    "no_draft": {
      "const": true
    },
    "resume_node": {
      "const": "recovery"
    },
    "resume_instruction_zh": {
      "type": "string",
      "minLength": 1
    },
    "record_digest": {
      "type": "string",
      "minLength": 1
    },
    "gap_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audit_digest": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
