{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/baseline-observation.schema.json",
  "title": "B 类基线观察事实",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "row_id",
    "source_row_id",
    "observation_id",
    "product_id",
    "trial_id",
    "cohort_id",
    "group_id",
    "analysis_population",
    "variable_domain",
    "source_name",
    "source_definition",
    "standardized_concept",
    "data_type",
    "statistic_form",
    "baseline_definition",
    "baseline_timepoint",
    "source_version_id",
    "source_locator",
    "source_role",
    "disclosure_maturity",
    "review_state",
    "disclosure_state",
    "conflict_disposition",
    "compatibility_rule"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "row_id": {"type": "string", "minLength": 1},
    "source_row_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "cohort_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "minLength": 1},
    "analysis_population": {"type": "string", "minLength": 1},
    "variable_domain": {"enum": ["demographics", "disease_context", "baseline_severity"]},
    "source_name": {"type": "string", "minLength": 1},
    "source_definition": {"type": "string", "minLength": 1},
    "standardized_concept": {"type": "string", "minLength": 1},
    "scale": {"type": ["string", "null"], "minLength": 1},
    "scale_version": {"type": ["string", "null"], "minLength": 1},
    "direction": {"type": ["string", "null"], "minLength": 1},
    "theoretical_range": {"type": ["string", "null"], "minLength": 1},
    "data_type": {"enum": ["continuous", "categorical", "count"]},
    "statistic_form": {
      "enum": [
        "sample_size",
        "mean",
        "standard_deviation",
        "median",
        "quartiles",
        "range",
        "count",
        "proportion",
        "other"
      ]
    },
    "value": {"type": ["number", "null"]},
    "raw_value": {"type": ["string", "null"], "minLength": 1},
    "unit": {"type": ["string", "null"], "minLength": 1},
    "dispersion": {"type": ["number", "null"], "minimum": 0},
    "range_lower": {"type": ["number", "null"]},
    "range_upper": {"type": ["number", "null"]},
    "category_level": {"type": ["string", "null"], "minLength": 1},
    "bin_label": {"type": ["string", "null"], "minLength": 1},
    "bin_lower": {"type": ["number", "null"]},
    "bin_upper": {"type": ["number", "null"]},
    "numerator": {"type": ["integer", "null"], "minimum": 0},
    "denominator": {"type": ["integer", "null"], "minimum": 1},
    "denominator_role": {"type": ["string", "null"], "minLength": 1},
    "baseline_definition": {"type": "string", "minLength": 1},
    "baseline_timepoint": {"type": "string", "minLength": 1},
    "source_version_id": {"type": "string", "minLength": 1},
    "source_locator": {"$ref": "#/$defs/evidence_locator"},
    "source_role": {
      "enum": [
        "clinical_trial_registry",
        "regulatory_material",
        "primary_trial_report",
        "protocol_sap",
        "conference_disclosure",
        "company_disclosure",
        "designated_industry_source"
      ]
    },
    "disclosure_maturity": {
      "enum": [
        "attributable_numeric_disclosure",
        "conference_complete_numerics",
        "registry_result_or_primary_report",
        "final_regulatory_conclusion"
      ]
    },
    "review_state": {"enum": ["candidate", "accepted", "rejected", "superseded"]},
    "disclosure_state": {
      "enum": [
        "reported_value",
        "reported_zero",
        "not_reported",
        "below_reporting_threshold",
        "not_publicly_disclosed",
        "not_applicable",
        "conflicting",
        "unresolved_due_to_route"
      ]
    },
    "conflict_disposition": {
      "enum": ["resolved_selected_accepted_fact", "open_conflict_preserved"]
    },
    "reported_zero_text": {"type": ["string", "null"], "minLength": 1},
    "route_receipt_id": {"type": ["string", "null"], "minLength": 1},
    "applicability_predicate_id": {"type": ["string", "null"], "minLength": 1},
    "compatibility_rule": {"type": "string", "minLength": 1},
    "difference_labels_zh": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "evidence_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_role"],
      "properties": {
        "document_role": {"type": "string", "minLength": 1},
        "field_path": {"type": ["string", "null"], "minLength": 1},
        "heading": {"type": ["string", "null"], "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "table": {"type": ["string", "null"], "minLength": 1},
        "row": {"type": ["string", "null"], "minLength": 1},
        "column": {"type": ["string", "null"], "minLength": 1},
        "paragraph": {"type": ["string", "null"], "minLength": 1},
        "url": {"type": ["string", "null"], "minLength": 1}
      },
      "anyOf": [
        {"required": ["field_path"], "properties": {"field_path": {"type": "string"}}},
        {"required": ["heading"], "properties": {"heading": {"type": "string"}}},
        {"required": ["page"], "properties": {"page": {"type": "integer"}}},
        {"required": ["table"], "properties": {"table": {"type": "string"}}},
        {"required": ["row"], "properties": {"row": {"type": "string"}}},
        {"required": ["column"], "properties": {"column": {"type": "string"}}},
        {"required": ["paragraph"], "properties": {"paragraph": {"type": "string"}}},
        {"required": ["url"], "properties": {"url": {"type": "string"}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disclosure_state": {"enum": ["not_reported", "below_reporting_threshold", "not_publicly_disclosed", "unresolved_due_to_route"]}}},
      "then": {
        "properties": {
          "value": {"type": "null"},
          "dispersion": {"type": "null"},
          "range_lower": {"type": "null"},
          "range_upper": {"type": "null"},
          "bin_lower": {"type": "null"},
          "bin_upper": {"type": "null"},
          "numerator": {"type": "null"},
          "denominator": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "not_applicable"}}},
      "then": {
        "required": ["applicability_predicate_id"],
        "properties": {
          "value": {"type": "null"},
          "dispersion": {"type": "null"},
          "range_lower": {"type": "null"},
          "range_upper": {"type": "null"},
          "bin_lower": {"type": "null"},
          "bin_upper": {"type": "null"},
          "numerator": {"type": "null"},
          "denominator": {"type": "null"},
          "applicability_predicate_id": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "unresolved_due_to_route"}}},
      "then": {
        "required": ["route_receipt_id"],
        "properties": {"route_receipt_id": {"type": "string"}}
      }
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "reported_zero"}}},
      "then": {
        "required": ["reported_zero_text"],
        "properties": {
          "value": {"type": "number", "const": 0},
          "reported_zero_text": {"type": "string"}
        }
      },
      "else": {"properties": {"reported_zero_text": {"type": "null"}}}
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "conflicting"}}},
      "then": {"properties": {"conflict_disposition": {"const": "open_conflict_preserved"}}},
      "else": {"properties": {"conflict_disposition": {"const": "resolved_selected_accepted_fact"}}}
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "reported_zero"}}},
      "then": {
        "required": ["raw_value"],
        "properties": {"raw_value": {"type": "string"}}
      }
    },
    {
      "if": {"properties": {"disclosure_state": {"const": "reported_value"}}},
      "then": {
        "required": ["raw_value"],
        "properties": {"raw_value": {"type": "string"}}
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"disclosure_state": {"const": "reported_value"}}},
          {"not": {"properties": {"statistic_form": {"enum": ["quartiles", "range"]}}}}
        ]
      },
      "then": {
        "required": ["value"],
        "properties": {"value": {"type": "number"}}
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"disclosure_state": {"enum": ["reported_value", "reported_zero"]}}},
          {"properties": {"data_type": {"const": "continuous"}}}
        ]
      },
      "then": {
        "required": ["unit"],
        "properties": {"unit": {"type": "string"}}
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"disclosure_state": {"enum": ["reported_value", "reported_zero"]}}},
          {"properties": {"statistic_form": {"const": "sample_size"}}}
        ]
      },
      "then": {
        "required": ["unit"],
        "properties": {"unit": {"type": "string"}}
      }
    },
    {
      "if": {
        "properties": {
          "statistic_form": {
            "enum": ["mean", "standard_deviation", "median", "quartiles", "range"]
          }
        }
      },
      "then": {"properties": {"data_type": {"const": "continuous"}}}
    },
    {
      "if": {"properties": {"statistic_form": {"const": "sample_size"}}},
      "then": {"properties": {"data_type": {"const": "count"}}}
    },
    {
      "if": {"properties": {"statistic_form": {"const": "proportion"}}},
      "then": {"properties": {"data_type": {"const": "categorical"}}}
    },
    {
      "if": {
        "allOf": [
          {"properties": {"statistic_form": {"enum": ["sample_size", "count"]}}},
          {"properties": {"disclosure_state": {"enum": ["reported_value", "reported_zero"]}}}
        ]
      },
      "then": {"properties": {"value": {"type": "integer", "minimum": 0}}}
    },
    {
      "if": {
        "allOf": [
          {"properties": {"statistic_form": {"enum": ["quartiles", "range"]}}},
          {"properties": {"disclosure_state": {"enum": ["reported_value", "reported_zero"]}}}
        ]
      },
      "then": {
        "required": ["range_lower", "range_upper"],
        "properties": {
          "range_lower": {"type": "number"},
          "range_upper": {"type": "number"},
          "value": {"type": "null"},
          "dispersion": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"statistic_form": {"const": "proportion"}}},
          {"properties": {"disclosure_state": {"enum": ["reported_value", "reported_zero"]}}}
        ]
      },
      "then": {
        "required": ["denominator"],
        "anyOf": [
          {"required": ["category_level"], "properties": {"category_level": {"type": "string"}}},
          {"required": ["bin_label"], "properties": {"bin_label": {"type": "string"}}}
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"data_type": {"const": "categorical"}}},
          {"properties": {"disclosure_state": {"enum": ["reported_value", "reported_zero"]}}}
        ]
      },
      "then": {
        "anyOf": [
          {"required": ["category_level"], "properties": {"category_level": {"type": "string"}}},
          {"required": ["bin_label"], "properties": {"bin_label": {"type": "string"}}}
        ]
      }
    },
    {
      "if": {
        "required": ["scale_version"],
        "properties": {"scale_version": {"type": "string"}}
      },
      "then": {"required": ["scale"], "properties": {"scale": {"type": "string"}}}
    },
    {
      "anyOf": [
        {"properties": {"bin_lower": {"type": "null"}, "bin_upper": {"type": "null"}}},
        {"required": ["bin_lower", "bin_upper"], "properties": {"bin_lower": {"type": "number"}, "bin_upper": {"type": "number"}}}
      ]
    }
  ]
}
