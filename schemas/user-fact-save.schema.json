{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/user-fact-save.schema.json",
  "title": "用户事实保存命令",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "ResourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact_id": {"$ref": "#/$defs/ResourceId"},
        "fact_version_id": {"$ref": "#/$defs/ResourceId"},
        "entity_id": {"$ref": "#/$defs/ResourceId"},
        "field_id": {"$ref": "#/$defs/ResourceId"}
      },
      "required": ["fact_id", "fact_version_id", "entity_id", "field_id"]
    },
    "Edits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_value": {"type": ["string", "null"], "minLength": 1},
        "normalized_value": {"type": ["string", "number", "boolean", "null"]},
        "numerator": {"type": ["integer", "null"], "minimum": 0},
        "denominator": {"type": ["integer", "null"], "minimum": 1},
        "timepoint": {"type": "string", "minLength": 1},
        "time_window": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "normalized_unit": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "arm_id": {"type": "string", "minLength": 1},
        "cohort_id": {"type": "string", "minLength": 1},
        "endpoint_definition": {"type": "string", "minLength": 1},
        "event_definition": {"type": "string", "minLength": 1},
        "scale": {"type": "string", "minLength": 1},
        "direction": {"enum": ["higher_is_better", "lower_is_better", "neutral"]},
        "estimand": {"type": "string", "minLength": 1},
        "analysis_set": {"type": "string", "minLength": 1},
        "statistical_form": {"enum": ["crude_rate", "count", "threshold", "adjusted_rate", "ls_mean"]},
        "group": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "measure_object": {"enum": ["participants", "events", "person_time", "estimate"]},
        "threshold_operator": {"enum": ["<", "<=", ">", ">=", "="]},
        "threshold_value": {"type": ["number", "null"]},
        "threshold_unit": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"$ref": "#/$defs/ResourceId"},
    "project_id": {"$ref": "#/$defs/ResourceId"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "operation": {"enum": ["save", "undo"]},
    "target": {"$ref": "#/$defs/Target"},
    "edits": {"$ref": "#/$defs/Edits"},
    "user_basis": {"type": "string", "minLength": 1},
    "saved_by": {"$ref": "#/$defs/ResourceId"},
    "saved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "schema_version", "request_id", "project_id", "expected_revision", "operation",
    "target", "edits", "user_basis", "saved_by", "saved_at"
  ]
}
