{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/guideline-basis.schema.json",
  "title": "监管指南使用依据",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_role": {"type": "string", "minLength": 1},
        "field_path": {"type": ["string", "null"], "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "table": {"type": ["string", "null"], "minLength": 1},
        "paragraph": {"type": ["string", "null"], "minLength": 1},
        "url": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["document_role", "field_path", "page", "table", "paragraph", "url"],
      "anyOf": [
        {"properties": {"field_path": {"type": "string"}}},
        {"properties": {"page": {"type": "integer"}}},
        {"properties": {"table": {"type": "string"}}},
        {"properties": {"paragraph": {"type": "string"}}},
        {"properties": {"url": {"type": "string"}}}
      ]
    }
  },
  "properties": {
    "guideline_series_id": {"type": "string", "minLength": 1},
    "guideline_version_id": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "agency": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "guidance_status": {"enum": ["draft", "final"]},
    "version_date": {"type": "string", "format": "date"},
    "population_context": {"type": "string", "minLength": 1},
    "development_context": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "locator": {"$ref": "#/$defs/locator"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "lifecycle_status": {"enum": ["active", "superseded", "withdrawn"]},
    "supersedes_version_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "superseded_by_version_id": {"type": ["string", "null"], "minLength": 1},
    "withdrawn_at": {"type": ["string", "null"], "format": "date"},
    "can_drive_current_default": {"type": "boolean"}
  },
  "required": [
    "guideline_series_id", "guideline_version_id", "jurisdiction", "agency",
    "document_id", "title", "guidance_status", "version_date", "population_context",
    "development_context", "source_url", "locator", "content_sha256", "captured_at",
    "lifecycle_status", "supersedes_version_ids", "superseded_by_version_id",
    "withdrawn_at", "can_drive_current_default"
  ],
  "allOf": [
    {
      "if": {"properties": {"guidance_status": {"const": "draft"}}},
      "then": {"properties": {"can_drive_current_default": {"const": false}}}
    },
    {
      "if": {"properties": {"lifecycle_status": {"const": "active"}}},
      "then": {
        "properties": {
          "superseded_by_version_id": {"type": "null"},
          "withdrawn_at": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"lifecycle_status": {"const": "superseded"}}},
      "then": {
        "properties": {
          "superseded_by_version_id": {"type": "string", "minLength": 1},
          "withdrawn_at": {"type": "null"},
          "can_drive_current_default": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"lifecycle_status": {"const": "withdrawn"}}},
      "then": {
        "properties": {
          "superseded_by_version_id": {"type": "null"},
          "withdrawn_at": {"type": "string", "format": "date"},
          "can_drive_current_default": {"const": false}
        }
      }
    }
  ]
}
