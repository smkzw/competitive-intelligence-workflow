{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.example/schemas/report-snapshot-manifest.schema.json",
  "title": "报告快照清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "contract_version", "report", "report_version",
    "data_cutoff", "evidence_snapshot_id", "claim_snapshot_id", "coverage_set_id",
    "claim_ids", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "integer", "minimum": 1},
    "report": {"enum": ["A", "B", "C"]},
    "report_version": {"type": "string", "minLength": 1},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "evidence_snapshot_id": {"type": "string", "minLength": 1},
    "claim_snapshot_id": {"type": "string", "minLength": 1},
    "coverage_set_id": {"type": "string", "minLength": 1},
    "claim_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
