{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.example/schemas/package-manifest.schema.json",
  "title": "竞品调研工作流 HTML-only 安装包清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "public_trigger",
    "package",
    "public_skill",
    "internal_skills",
    "components",
    "cli"
  ],
  "properties": {
    "$schema": {"type": "string", "const": "schemas/package-manifest.schema.json"},
    "schema_version": {"type": "string", "const": "1.0"},
    "public_trigger": {"type": "string", "const": "竞品调研"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "cli_version",
        "build_stage",
        "release_scope",
        "formats",
        "python",
        "hosts"
      ],
      "properties": {
        "name": {"type": "string", "const": "competitive-intelligence-workflow"},
        "version": {"type": "string", "minLength": 1},
        "cli_version": {"type": "string", "minLength": 1},
        "build_stage": {"type": "string", "const": "development-candidate"},
        "release_scope": {"type": "string", "const": "site_html_v1"},
        "formats": {
          "type": "array",
          "prefixItems": [{"const": "html"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "python": {"type": "string", "minLength": 1},
        "hosts": {
          "type": "array",
          "prefixItems": [
            {"const": "codex"},
            {"const": "hermes"},
            {"const": "omp"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "public_skill": {"type": "string", "minLength": 1},
    "internal_skills": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "contract_version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "pattern": "^skills/_internal/.+/SKILL\\.md$"},
          "contract_version": {"type": "string", "const": "1.0"}
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemas", "policies", "contracts", "assets", "migrations"],
      "properties": {
        "schemas": {"$ref": "#/$defs/path_list"},
        "policies": {"$ref": "#/$defs/path_list"},
        "contracts": {"$ref": "#/$defs/path_list"},
        "assets": {"$ref": "#/$defs/path_list"},
        "migrations": {"$ref": "#/$defs/path_list"}
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "catalog"],
      "properties": {
        "executable": {"type": "string", "const": "ci-workflow"},
        "catalog": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 16,
          "maxItems": 16,
          "prefixItems": [
            {"const": "package verify"},
            {"const": "project create"},
            {"const": "project verify"},
            {"const": "project run"},
            {"const": "project share"},
            {"const": "project accept-visual"},
            {"const": "capability preflight"},
            {"const": "fixture run"},
            {"const": "review issue"},
            {"const": "research submit"},
            {"const": "research capture"},
            {"const": "research fetch-ctgov"},
            {"const": "publication unavailable"},
            {"const": "yaozh answer"},
            {"const": "yaozh observe"},
            {"const": "yaozh check"}
          ],
          "items": false
        }
      }
    }
  },
  "$defs": {
    "path_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
