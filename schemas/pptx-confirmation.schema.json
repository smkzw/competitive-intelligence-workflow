{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.local/schemas/pptx-confirmation.schema.json",
  "title": "PPT Master 八项中文确认合同",
  "oneOf": [
    {"$ref": "#/$defs/recommendations"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/session"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "report": {
      "enum": ["A", "B", "C"]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)"
    },
    "identity": {
      "type": "object",
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "report": {"$ref": "#/$defs/report"},
        "report_version": {"type": "string", "minLength": 1},
        "source_pack_id": {"type": "string", "minLength": 1},
        "source_pack_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "claim_snapshot_id": {"type": "string", "minLength": 1},
        "evidence_snapshot_id": {"type": "string", "minLength": 1},
        "coverage_set_id": {"type": "string", "minLength": 1}
      },
      "required": [
        "session_id",
        "project_id",
        "report",
        "report_version",
        "source_pack_id",
        "source_pack_sha256",
        "snapshot_id",
        "snapshot_sha256",
        "claim_snapshot_id",
        "evidence_snapshot_id",
        "coverage_set_id"
      ],
      "additionalProperties": false
    },
    "recommendationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "label_zh", "recommended_value_zh", "options_zh", "rationale_zh"],
      "properties": {
        "item_id": {
          "enum": [
            "canvas_format",
            "page_range",
            "target_audience",
            "style_goal",
            "color_scheme",
            "icon_strategy",
            "font_formula_strategy",
            "image_strategy"
          ]
        },
        "label_zh": {"type": "string", "minLength": 1},
        "recommended_value_zh": {"type": "string", "minLength": 1},
        "options_zh": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale_zh": {"type": "string", "minLength": 1}
      }
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_version",
        "session_id",
        "project_id",
        "report",
        "report_version",
        "source_pack_id",
        "source_pack_sha256",
        "snapshot_id",
        "snapshot_sha256",
        "claim_snapshot_id",
        "evidence_snapshot_id",
        "coverage_set_id",
        "data_cutoff",
        "generated_at",
        "recommendations_path",
        "items",
        "recommendations_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "contract_version": {"const": "8.7"},
        "session_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "report": {"$ref": "#/$defs/report"},
        "report_version": {"type": "string", "minLength": 1},
        "source_pack_id": {"type": "string", "minLength": 1},
        "source_pack_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "claim_snapshot_id": {"type": "string", "minLength": 1},
        "evidence_snapshot_id": {"type": "string", "minLength": 1},
        "coverage_set_id": {"type": "string", "minLength": 1},
        "data_cutoff": {"type": "string", "minLength": 1},
        "generated_at": {"$ref": "#/$defs/datetime"},
        "recommendations_path": {"$ref": "#/$defs/path"},
        "items": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/recommendationItem"}, {"properties": {"item_id": {"const": "canvas_format"}}}]},
            {"allOf": [{"$ref": "#/$defs/recommendationItem"}, {"properties": {"item_id": {"const": "page_range"}}}]},
            {"allOf": [{"$ref": "#/$defs/recommendationItem"}, {"properties": {"item_id": {"const": "target_audience"}}}]},
            {"allOf": [{"$ref": "#/$defs/recommendationItem"}, {"properties": {"item_id": {"const": "style_goal"}}}]},
            {"allOf": [{"$ref": "#/$defs/recommendationItem"}, {"properties": {"item_id": {"const": "color_scheme"}}}]},
            {"allOf": [{"$ref": "#/$defs/recommendationItem"}, {"properties": {"item_id": {"const": "icon_strategy"}}}]},
            {"allOf": [{"$ref": "#/$defs/recommendationItem"}, {"properties": {"item_id": {"const": "font_formula_strategy"}}}]},
            {"allOf": [{"$ref": "#/$defs/recommendationItem"}, {"properties": {"item_id": {"const": "image_strategy"}}}]}
          ],
          "items": false
        },
        "recommendations_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_version",
        "session_id",
        "project_id",
        "report",
        "report_version",
        "source_pack_id",
        "source_pack_sha256",
        "snapshot_id",
        "snapshot_sha256",
        "claim_snapshot_id",
        "evidence_snapshot_id",
        "coverage_set_id",
        "recommendations_sha256",
        "confirmed_values",
        "confirmed_by",
        "confirmed_at",
        "result_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "contract_version": {"const": "8.7"},
        "session_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "report": {"$ref": "#/$defs/report"},
        "report_version": {"type": "string", "minLength": 1},
        "source_pack_id": {"type": "string", "minLength": 1},
        "source_pack_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "claim_snapshot_id": {"type": "string", "minLength": 1},
        "evidence_snapshot_id": {"type": "string", "minLength": 1},
        "coverage_set_id": {"type": "string", "minLength": 1},
        "recommendations_sha256": {"$ref": "#/$defs/sha256"},
        "confirmed_values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canvas_format",
            "page_range",
            "target_audience",
            "style_goal",
            "color_scheme",
            "icon_strategy",
            "font_formula_strategy",
            "image_strategy"
          ],
          "properties": {
            "canvas_format": {"type": "string", "minLength": 1},
            "page_range": {"type": "string", "minLength": 1},
            "target_audience": {"type": "string", "minLength": 1},
            "style_goal": {"type": "string", "minLength": 1},
            "color_scheme": {"type": "string", "minLength": 1},
            "icon_strategy": {"type": "string", "minLength": 1},
            "font_formula_strategy": {"type": "string", "minLength": 1},
            "image_strategy": {"type": "string", "minLength": 1}
          }
        },
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"$ref": "#/$defs/datetime"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_version",
        "session_id",
        "project_id",
        "report",
        "report_version",
        "source_pack_id",
        "source_pack_sha256",
        "snapshot_id",
        "snapshot_sha256",
        "claim_snapshot_id",
        "evidence_snapshot_id",
        "coverage_set_id",
        "recommendations_sha256",
        "recommendations_path",
        "result_path",
        "state",
        "opened_at",
        "closed_at",
        "result_sha256",
        "session_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "contract_version": {"const": "8.7"},
        "session_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "report": {"$ref": "#/$defs/report"},
        "report_version": {"type": "string", "minLength": 1},
        "source_pack_id": {"type": "string", "minLength": 1},
        "source_pack_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "claim_snapshot_id": {"type": "string", "minLength": 1},
        "evidence_snapshot_id": {"type": "string", "minLength": 1},
        "coverage_set_id": {"type": "string", "minLength": 1},
        "recommendations_sha256": {"$ref": "#/$defs/sha256"},
        "recommendations_path": {"$ref": "#/$defs/path"},
        "result_path": {"$ref": "#/$defs/path"},
        "state": {"enum": ["open", "closed"]},
        "opened_at": {"$ref": "#/$defs/datetime"},
        "closed_at": {"anyOf": [{"$ref": "#/$defs/datetime"}, {"type": "null"}]},
        "result_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "session_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "open"}}},
          "then": {
            "properties": {
              "closed_at": {"type": "null"},
              "result_sha256": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "closed"}}},
          "then": {
            "properties": {
              "closed_at": {"$ref": "#/$defs/datetime"},
              "result_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    }
  }
}
