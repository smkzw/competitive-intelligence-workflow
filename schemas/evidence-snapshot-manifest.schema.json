{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.example/schemas/evidence-snapshot-manifest.schema.json",
  "title": "证据快照清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "contract_version", "data_cutoff",
    "source_version_ids", "fragment_ids", "fact_version_ids", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "integer", "minimum": 1},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "source_version_ids": {"$ref": "#/$defs/nonempty_ids"},
    "fragment_ids": {"$ref": "#/$defs/nonempty_ids"},
    "fact_version_ids": {"$ref": "#/$defs/nonempty_ids"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "nonempty_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
