{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.example/schemas/evidence-snapshot-manifest.schema.json",
  "title": "证据快照清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "contract_version", "data_cutoff",
    "source_version_ids", "fragment_ids", "fact_version_ids",
    "scientific_content_digest", "created_at"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "2.0"]},
    "project_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "integer", "minimum": 1},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "source_version_ids": {"$ref": "#/$defs/nonempty_ids"},
    "fragment_ids": {"$ref": "#/$defs/nonempty_ids"},
    "fact_version_ids": {"$ref": "#/$defs/nonempty_ids"},
    "claim_version_ids": {"$ref": "#/$defs/ids"},
    "derivation_ids": {"$ref": "#/$defs/ids"},
    "receipt_ids": {"$ref": "#/$defs/ids"},
    "scientific_content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "closure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "sources", "fragments", "facts", "claims", "derivations",
        "acquisition_attempts", "receipts"
      ],
      "properties": {
        "sources": {"type": "array", "items": {"type": "object"}},
        "fragments": {"type": "array", "items": {"type": "object"}},
        "facts": {"type": "array", "items": {"type": "object"}},
        "claims": {"type": "array", "items": {"type": "object"}},
        "derivations": {"type": "array", "items": {"type": "object"}},
        "acquisition_attempts": {"type": "array", "items": {"type": "object"}},
        "receipts": {"type": "array", "items": {"type": "object"}}
      }
    }
  },
  "$defs": {
    "nonempty_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.0"}}},
      "then": {
        "required": ["claim_version_ids", "derivation_ids", "receipt_ids", "closure"],
        "properties": {"closure": {"type": "object"}}
      },
      "else": {"properties": {"closure": {"type": "null"}}}
    }
  ]
}
