{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/evidence-gap.schema.json",
  "title": "证据缺口",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "gap_id": {"type": "string", "minLength": 1},
    "gate_spec_id": {"type": "string", "minLength": 1},
    "object_type": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "minLength": 1},
    "field_id": {"type": "string", "minLength": 1},
    "current_state": {
      "enum": [
        "not_reported", "not_publicly_disclosed", "conflicting",
        "unresolved_due_to_route"
      ]
    },
    "required_context": {"type": "string", "minLength": 1},
    "candidate_sources": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    },
    "completed_strategies": {
      "type": "array", "items": {"type": "string", "minLength": 1}
    },
    "information_gain_diff": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "round": {"type": "integer", "minimum": 1},
          "new_fields": {"type": "array", "items": {"type": "string"}},
          "new_source_versions": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["round", "new_fields", "new_source_versions"]
      }
    },
    "next_legal_action": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version", "gap_id", "gate_spec_id", "object_type", "object_id",
    "field_id", "current_state", "required_context", "candidate_sources",
    "completed_strategies", "information_gain_diff", "next_legal_action"
  ]
}
