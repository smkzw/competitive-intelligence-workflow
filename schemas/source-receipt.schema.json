{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/source-receipt.schema.json",
  "title": "来源路线回执",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "minLength": 1},
    "strategy_unit_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "gap_id": {"type": "string", "minLength": 1},
    "claim_domain": {"type": "string", "minLength": 1},
    "query_or_identifier": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "access_method": {"type": "string", "minLength": 1},
    "attempt_index": {"type": "integer", "minimum": 1},
    "started_at": {
      "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ended_at": {
      "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "scheduled_backoff_ms": {"type": "integer", "minimum": 0},
    "actual_backoff_ms": {"type": "integer", "minimum": 0},
    "result_class": {
      "enum": [
        "content_acquired", "not_found", "network_error", "rate_limited",
        "captcha_required", "permission_denied", "proxy_error", "dns_error",
        "tls_error", "http_error", "parser_error", "tool_unavailable",
        "content_truncated"
      ]
    },
    "error_class": {"type": ["string", "null"], "minLength": 1},
    "completeness_checks": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    },
    "alternative_paths": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    },
    "source_version_id": {"type": ["string", "null"], "minLength": 1},
    "content_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic_confidence": {"enum": ["low", "medium", "high"]},
    "parent_attempt_id": {"type": ["string", "null"], "minLength": 1},
    "recovery_round": {"type": "integer", "minimum": 0}
  },
  "required": [
    "schema_version", "receipt_id", "route_id", "strategy_unit_id", "entity_id",
    "gap_id", "claim_domain", "query_or_identifier", "language", "access_method",
    "attempt_index", "started_at", "ended_at", "scheduled_backoff_ms",
    "actual_backoff_ms", "result_class", "error_class",
    "completeness_checks", "alternative_paths", "source_version_id", "content_sha256",
    "diagnostic_confidence", "parent_attempt_id", "recovery_round"
  ],
  "allOf": [
    {
      "if": {"properties": {"result_class": {"const": "content_acquired"}}},
      "then": {
        "properties": {
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_version_id": {"type": "string", "minLength": 1},
          "error_class": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "error_class": {"type": "string", "minLength": 1},
          "source_version_id": {"type": "null"}
        }
      }
    }
  ]
}
