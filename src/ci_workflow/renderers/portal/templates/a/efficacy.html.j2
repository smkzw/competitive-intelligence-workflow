{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}疗效{% endblock %}{% block heading %}公开疗效观察{% endblock %}
{% block lead %}按试验、终点、时间点、单位和分析人群分别呈现全部公开观察；保留各剂量和组别，不默认判定跨试验可比。{% endblock %}
{% block content %}
<section class="kz-a-panel" data-module="efficacy">
  <div class="kz-a-filter-grid">{{ ui.filter_group('product', '产品', products|map(attribute='name')|list) }}{{ ui.filter_group('endpoint', '疗效指标', efficacy|map(attribute='endpoint')|unique|list) }}{{ ui.filter_group('timepoint', '时间点', efficacy|map(attribute='timepoint')|unique|list) }}</div>
  <div data-efficacy-heading>{{ ui.section_head('公开疗效观察', '图只绘制组别—产品关系已确认且数值可绘的观察；折叠表保留全部原值') }}</div>
  {{ ui.chart('efficacy', 'efficacy-full', '按完整观察条件分组的疗效图') }}
  {% if unassigned_efficacy_count %}<p class="kz-a-comparability">本页有 {{ unassigned_efficacy_count }} 条疗效观察的组别—产品关系待核，未绘图；完整表保留原始值。</p>{% endif %}
  <p class="kz-a-comparability">不同量表、时间点和分析人群分组展示；每组独立刻度，不能按图形长度判断跨试验优劣。</p>
  <details class="kz-complete-table"><summary class="kz-complete-table__summary">展开当前筛选的完整疗效表</summary><div class="kz-a-table-wrap"><table class="kz-a-efficacy-table">
    <thead><tr><th>产品</th><th>试验</th><th>疗效指标</th><th>时间点</th><th>组别</th><th>观察值</th><th>人数</th><th>分析人群</th><th>来源</th></tr></thead>
    <tbody>{% for row in efficacy %}
      <tr data-row-id="{{ row.row_id }}" data-product="{{ product_names[row.product_id] }}" data-endpoint="{{ row.endpoint }}" data-endpoint-source="{{ row.endpoint_source }}" data-timepoint="{{ row.timepoint }}">
        <td>{% if row.group_assignment_state == 'unknown' %}产品归属待核{% else %}{{ product_names[row.product_id] }}{% endif %}</td><td>{{ trial_names[row.trial_id] }}</td>
        <td{% if row.endpoint_source and row.endpoint_source != row.endpoint %} title="{{ row.endpoint_source }}"{% endif %}>{{ row.endpoint }}</td><td>{{ row.timepoint }}</td><td>{{ row.arm_detail or row.arm }}</td>
        <td><strong>{{ row.value }}{{ row.unit }}</strong></td>
        <td>{% if row.numerator is not none %}{{ row.numerator }}/{{ row.denominator }}{% elif row.denominator is not none %}分母 {{ row.denominator }}{% else %}—{% endif %}</td>
        <td>{{ row.population }}{% if row.unrendered_reason == 'group_product_relationship_unresolved' %}<br><small>未绘图：组别与产品关系待核</small>{% endif %}{% if row.numeric_unrendered_reason_zh %}<br><small>未绘图：{{ row.numeric_unrendered_reason_zh }}</small>{% endif %}</td>
        <td><button type="button" class="kz-a-row-source" data-open-evidence="{{ row.endpoint }}来源" data-evidence-collection="efficacy" data-evidence-row-id="{{ row.row_id }}">查看来源</button></td>
      </tr>
    {% endfor %}</tbody>
  </table></div></details>{{ ui.empty_state() }}
</section>
{% if additional_observations %}
<section class="kz-a-panel" data-module="additional-observations">
  <div class="kz-a-section-head"><div><h2>其他登记观察（{{ additional_observations|length }}）</h2><p>免疫原性、药代/药效学及生物标志物等按各自统计对象保留，不计作临床疗效，也不与疗效共轴。</p></div></div>
  <label for="additional-observation-search">在这些观察中搜索</label>
  <input id="additional-observation-search" type="search" data-additional-search placeholder="输入终点、试验号、组别或领域">
  <span data-additional-search-count>共 {{ additional_observations|length }} 条</span>
  <details class="kz-complete-table" data-additional-details><summary class="kz-complete-table__summary">展开完整其他观察表</summary><div class="kz-a-table-wrap"><table>
    <thead><tr><th>领域</th><th>产品/试验</th><th>观察与条件</th><th>组别</th><th>来源原值</th><th>登记来源</th></tr></thead>
    <tbody>{% for row in additional_observations %}
      <tr id="{{ row.row_id }}" data-additional-row data-additional-text="{{ row.domain_label }} {{ row.endpoint }} {{ row.trial_id }} {{ row.group_title }} {{ row.class_title }} {{ row.category_title }}">
        <td>{{ row.domain_label }}</td>
        <td>{% if row.group_assignment_state == 'declared' %}{{ product_names[row.product_id] }}{% else %}产品归属待核{% endif %}<br><small>{{ row.trial_id|upper }}</small></td>
        <td>{{ row.endpoint }}<br><small>{{ row.time_window }}{% if row.class_title %}｜{{ row.class_title }}{% endif %}{% if row.category_title %}｜{{ row.category_title }}{% endif %}</small></td>
        <td>{{ row.group_title }}</td>
        <td><strong>{{ row.raw_value }} {{ row.raw_unit }}</strong></td>
        <td><a href="{{ row.source_url }}" target="_blank" rel="noopener noreferrer">登记原文</a><br><small>逐事实来源核验待完成</small></td>
      </tr>
    {% endfor %}</tbody>
  </table></div></details>
</section>
{% endif %}
{% endblock %}
