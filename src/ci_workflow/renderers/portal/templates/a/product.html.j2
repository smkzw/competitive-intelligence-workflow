{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}{{ product.name }}{% endblock %}{% block heading %}{{ product.name }}{% endblock %}
{% block lead %}{{ product.target }}｜{{ product.modality }}｜{{ product.phase }}｜{{ product.status }}{% endblock %}
{% block content %}
<nav class="kz-a-breadcrumb" aria-label="当前位置"><a href="{{ root_prefix }}product-overview.html">产品总览</a><span>›</span><span>{{ product.name }}</span></nav>
<section class="kz-a-dossier-grid">
  <article class="kz-a-panel"><h2>基本信息</h2><dl class="kz-a-facts"><div><dt>研发企业</dt><dd>{{ product.developer }}</dd></div><div><dt>最高阶段</dt><dd>{{ product.phase }}</dd></div><div><dt>开发地域</dt><dd>{{ product.regions|join('、') }}</dd></div><div><dt>当前状态</dt><dd>{{ product.status }}</dd></div></dl></article>
  <article class="kz-a-panel"><h2>作用机制与给药</h2><p>{{ product.mechanism }}</p><dl class="kz-a-facts"><div><dt>靶点</dt><dd>{{ product.target }}</dd></div><div><dt>技术类型</dt><dd>{{ product.modality }}</dd></div><div><dt>给药方式</dt><dd>{{ product.route }}</dd></div></dl></article>
</section>
<section class="kz-a-panel">{{ ui.section_head('临床开发组合', '', product.id) }}<div class="kz-a-table-wrap"><table><thead><tr><th>试验</th><th>角色</th><th>阶段</th><th>地域</th><th>样本量</th><th>状态</th></tr></thead><tbody>{% for row in product_trials %}<tr><td title="{{ row.original_name }}">{{ row.name }}（{{ row.display_id }}）</td><td>{{ row.role }}</td><td>{{ row.phase }}</td><td>{{ row.region }}</td><td>{{ row.sample_size }}</td><td>{{ row.status }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="kz-a-panel">{{ ui.section_head('关键疗效', '', product.id) }}{{ ui.chart('efficacy', 'product-efficacy', product.name ~ '关键疗效', product.id) }}{% if product_efficacy %}<div class="kz-a-table-wrap"><table><thead><tr><th>终点</th><th>时间点</th><th>组别</th><th>结果</th><th>人数</th><th>分析人群</th></tr></thead><tbody>{% for row in product_efficacy %}<tr><td>{{ row.endpoint }}</td><td>{{ row.timepoint }}</td><td>{{ row.arm_detail or row.arm }}</td><td>{{ row.value }}{{ row.unit }}</td><td>{% if row.numerator is not none %}{{ row.numerator }}/{{ row.denominator }}{% else %}—{% endif %}</td><td>{{ row.population }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="kz-empty">暂无公开关键疗效数值。</div>{% endif %}</section>
<section class="kz-a-panel">{{ ui.section_head('关键安全性', '', product.id) }}{{ ui.chart('safety', 'product-safety', product.name ~ '关键安全性', product.id) }}{% if product_safety %}<div class="kz-a-table-wrap"><table><thead><tr><th>维度</th><th>事件</th><th>试验</th><th>组别</th><th>发生率</th><th>观察窗</th></tr></thead><tbody>{% for row in product_safety %}<tr data-event-key="{{ row.term_key }}" data-normalized-term="{{ row.term_label }}" data-disclosure-state="{{ row.disclosure_state }}"><td>{{ row.category }}</td><td>{{ row.term_label }}</td><td>{{ trial_names[row.trial_id] }}</td><td>{{ row.arm }}</td><td>{% if row.value is none %}未公开{% else %}{{ row.value }}{{ row.unit }}{% endif %}</td><td>{{ row.time_window }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="kz-empty">暂无公开关键安全性数值。</div>{% endif %}</section>
<section class="kz-a-dossier-grid"><article class="kz-a-panel"><h2>中国与全球监管</h2>{% for row in product_regulatory %}<p><strong>{{ row.track }}</strong>｜{{ row.event }}｜{{ row.date }}｜{{ row.status }}</p>{% endfor %}</article><article class="kz-a-panel"><h2>企业与交易</h2>{% for row in product_companies %}<p>{{ row.relationship }}｜许可方：{{ row.licensor }}｜被许可方：{{ row.licensee }}｜{{ row.territory }}</p>{% endfor %}</article><article class="kz-a-panel"><h2>专利与保护</h2>{% for row in product_patents %}<p>{{ row.display_family }}｜{{ row.jurisdiction }}｜{{ row.expiry }}</p>{% endfor %}</article></section>
{% endblock %}
