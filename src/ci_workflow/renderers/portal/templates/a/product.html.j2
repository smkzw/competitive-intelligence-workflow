{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}{{ product.name }}{% endblock %}{% block heading %}{{ product.name }}{% endblock %}
{% block lead %}{{ product.target }}｜{{ product.modality }}｜{{ product.phase }}｜{{ product.status }}{% endblock %}
{% block content %}
<nav class="kz-a-breadcrumb" aria-label="当前位置"><a href="{{ root_prefix }}product-overview.html" data-a-return>返回上一步</a><span>›</span><span>{{ product.name }}</span></nav>
<nav class="kz-a-reading-rail" aria-label="产品阅读路径"><a href="#mechanism">机制</a><a href="#regions">地域</a><a href="#trials">试验</a><a href="#results">结果</a><a href="#evidence">证据</a></nav>
<section class="kz-a-dossier-grid">
  <article class="kz-a-panel"><h2>基本信息</h2><dl class="kz-a-facts"><div><dt>{% if product.developer_basis == 'registration_sponsor' %}登记申办方（不等于研发归属）{% elif product.developer_basis == 'unverified' %}研发企业（待核）{% else %}研发企业{% endif %}</dt><dd>{{ product.developer }}</dd></div><div><dt>最高阶段</dt><dd>{{ product.phase }}</dd></div><div><dt>开发地域</dt><dd>{{ product.regions|join('、') }}</dd></div><div><dt>当前状态（登记记录口径）</dt><dd>{{ product.status }}</dd></div><div><dt>监管批准事实</dt><dd>{{ product.regulatory_approval_status or "未列示（以监管原始文件为准）" }}</dd></div></dl><p class="kz-a-status-note">当前状态汇总自该产品全部登记试验的状态记录（独立复核 A r37/r42 来源决策：状态口径以登记来源为准，不另行引入登记外批准库）。</p></article>
  <article class="kz-a-panel" id="mechanism"><h2>作用机制与给药</h2><p>{{ product.mechanism }}</p><dl class="kz-a-facts"><div><dt>靶点</dt><dd>{{ product.target }}</dd></div><div><dt>技术类型</dt><dd>{{ product.modality }}</dd></div><div><dt>给药方式</dt><dd>{{ product.route }}</dd></div></dl></article>
</section>
<section class="kz-a-dossier-grid" id="regions"><article class="kz-a-panel"><h2>中国与全球监管</h2>{% for row in product_regulatory %}<p><strong>{{ row.track }}</strong>｜{{ row.event }}｜{{ row.date }}｜{{ row.status }}</p>{% endfor %}</article><article class="kz-a-panel"><h2>企业与交易</h2>{% for row in product_companies %}<p>{{ row.relationship }}｜{% if row.sponsor %}登记申办方：{{ row.sponsor }}；不代表研发或许可关系{% else %}许可方：{{ row.licensor }}｜被许可方：{{ row.licensee }}｜{{ row.territory }}{% endif %}</p>{% endfor %}</article><article class="kz-a-panel"><h2>专利与保护</h2>{% for row in product_patents %}<p>{{ row.display_family }}｜{{ row.jurisdiction }}｜{{ row.expiry }}</p>{% endfor %}</article></section>
<section class="kz-a-panel" id="trials">{{ ui.section_head('临床开发组合', '', product.id) }}<div class="kz-a-table-wrap"><table><thead><tr><th>试验</th><th>角色</th><th>阶段</th><th>地域</th><th>样本量</th><th>状态</th></tr></thead><tbody>{% for row in product_trials %}<tr><td title="{{ row.original_name }}">{{ row.name }}{% if row.display_id not in row.name %}（{{ row.display_id }}）{% endif %}</td><td>{{ row.role }}</td><td>{{ row.phase }}</td><td>{{ row.region }}</td><td>{{ row.sample_size if row.sample_size is not none else "未公开" }}</td><td>{{ row.status }}</td></tr>{% endfor %}</tbody></table></div></section>
<div id="results">
<section class="kz-a-panel">{{ ui.section_head('关键疗效', '', product.id) }}{{ ui.chart('efficacy', 'product-efficacy', product.name ~ '关键疗效', product.id) }}{% if product_efficacy %}<details class="kz-complete-table"><summary class="kz-complete-table__summary">展开完整疗效表</summary><div class="kz-a-table-wrap"><table><thead><tr><th>终点</th><th>时间点</th><th>组别</th><th>结果</th><th>人数</th><th>分析人群</th></tr></thead><tbody>{% for row in product_efficacy %}<tr><td>{{ row.endpoint }}</td><td>{{ row.timepoint }}</td><td>{{ row.arm_detail or row.arm }}</td><td>{{ row.value }}{{ row.unit }}</td><td>{% if row.numerator is not none %}{{ row.numerator }}/{{ row.denominator }}{% elif row.denominator is not none %}分母 {{ row.denominator }}{% else %}—{% endif %}</td><td>{{ row.population }}</td></tr>{% endfor %}</tbody></table></div></details>{% else %}<div class="kz-empty">暂无公开关键疗效数值。</div>{% endif %}</section>
<section class="kz-a-panel">{{ ui.section_head('关键安全性', '', product.id) }}{{ ui.chart('safety', 'product-safety', product.name ~ '关键安全性', product.id) }}{% if product_safety %}<details class="kz-complete-table"><summary class="kz-complete-table__summary">展开完整安全性表</summary><div class="kz-a-table-wrap"><table><thead><tr><th>维度</th><th>事件</th><th>试验</th><th>组别</th><th>发生率</th><th>观察窗</th></tr></thead><tbody>{% for row in product_safety %}<tr data-event-key="{{ row.term_key }}" data-normalized-term="{{ row.term_label }}" data-disclosure-state="{{ row.disclosure_state }}"><td>{{ row.category }}</td><td>{{ row.term_label }}</td><td>{{ trial_names[row.trial_id] }}</td><td>{{ row.arm }}</td><td>{% if row.value is none %}未公开{% else %}{{ row.value }}{{ row.unit }}{% endif %}</td><td>{{ row.time_window }}</td></tr>{% endfor %}</tbody></table></div></details>{% else %}<div class="kz-empty">暂无公开关键安全性数值。</div>{% endif %}</section>
</div>
<section class="kz-a-panel kz-a-evidence-entry"><h2>证据链</h2><p>核对当前产品采用的试验、来源范围、用户修订状态与原来源分层。</p><button type="button" class="kz-a-evidence-button" id="evidence" data-open-evidence="{{ product.name }}数据依据" data-evidence-product="{{ product.id }}">查看本产品数据依据</button></section>
{% endblock %}
