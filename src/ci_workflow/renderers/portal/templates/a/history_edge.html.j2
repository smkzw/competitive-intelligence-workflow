{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}历史与边缘观察{% endblock %}{% block heading %}历史与边缘观察{% endblock %}
{% block lead %}暂停、终止、撤回及相邻机制观察继续保留，帮助理解竞争格局演变，不因当前未活跃而从范围中消失。{% endblock %}
{% block content %}<section class="kz-a-panel" data-module="history"><div class="kz-a-filter" data-filter-dimension="status" aria-label="历史事件"><span class="kz-a-filter__label">历史事件</span>{% for value in history|map(attribute='status')|unique|list %}<button type="button" data-filter-value="{{ value }}" aria-pressed="false">{% if value == '撤回' %}早期方案撤回{% elif value == '暂停' %}曾暂停（已恢复）{% else %}{{ value }}{% endif %}</button>{% endfor %}</div>{{ ui.section_head('项目状态时间线', '这里记录历史事件；产品当前开发状态以竞争格局和产品总览为准') }}{{ ui.chart('timeline', 'history-timeline', '历史项目状态时间线') }}<div class="kz-a-history-list">{% for row in history %}<article data-status="{{ row.status }}"><time>{{ row.date }}</time><span class="kz-a-status{% if row.status in ['终止','撤回'] %} kz-a-status--risk{% endif %}">{% if row.status == '撤回' %}早期方案撤回{% elif row.status == '暂停' %}曾暂停（已恢复）{% else %}{{ row.status }}{% endif %}</span><h2>{{ product_names[row.product_id] }}</h2><p>{{ row.observation }}</p></article>{% endfor %}</div><div class="kz-a-table-wrap"><table><thead><tr><th>产品</th><th>历史事件</th><th>日期</th><th>观察说明</th></tr></thead><tbody>{% for row in history %}<tr data-status="{{ row.status }}"><td>{{ product_names[row.product_id] }}</td><td>{% if row.status == '撤回' %}早期方案撤回{% elif row.status == '暂停' %}曾暂停（已恢复）{% else %}{{ row.status }}{% endif %}</td><td>{{ row.date }}</td><td>{{ row.observation }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
