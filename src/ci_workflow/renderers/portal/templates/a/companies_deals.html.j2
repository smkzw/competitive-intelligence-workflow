{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}企业与交易{% endblock %}{% block heading %}企业关系、地域权益与公开交易{% endblock %}
{% block lead %}登记申办、研发、许可和合作分别列示；登记申办记录不能证明研发归属或交易事实。{% endblock %}
{% block content %}<section class="kz-a-panel" data-module="companies">{{ ui.filter_group('product', '产品', products|map(attribute='name')|list) }}{{ ui.section_head('企业关系与地域权益', '只呈现来源支持的关系，未公开金额不作估算') }}{{ ui.chart('network', 'company-network', '企业关系和地域权益图') }}<div class="kz-a-callout-grid"><article><h2>企业关系</h2><p>登记申办、研发和合作采用各自来源口径，不相互推定。</p></article><article><h2>地域权益</h2><p>仅在原始来源明确披露时列出。</p></article><article><h2>公开交易</h2><p>仅列有证据的许可或合作安排。</p></article></div><div class="kz-a-table-wrap"><table><thead><tr><th>产品</th><th>企业关系</th><th>登记申办方</th><th>许可方</th><th>被许可方</th><th>地域权益</th><th>交易信息</th></tr></thead><tbody>{% for row in companies %}<tr data-product="{{ product_names[row.product_id] }}"><td>{{ product_names[row.product_id] }}</td><td>{{ row.relationship }}</td><td>{{ row.sponsor or '—' }}</td><td>{{ row.licensor }}</td><td>{{ row.licensee }}</td><td>{{ row.territory }}</td><td>{{ row.transaction }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
