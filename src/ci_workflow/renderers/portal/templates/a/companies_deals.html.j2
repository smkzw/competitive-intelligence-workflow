{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}企业与交易{% endblock %}{% block heading %}企业关系、地域权益与公开交易{% endblock %}
{% block lead %}原研、开发、许可方、被许可方、合作关系、地域权益和交易条款分字段呈现，不以企业关系替代交易事实。{% endblock %}
{% block content %}<section class="kz-a-panel" data-module="companies">{{ ui.filter_group('product', '产品', products|map(attribute='name')|list) }}{{ ui.section_head('企业关系与地域权益', '连线表示公开关系，未公开金额不作估算') }}{{ ui.chart('network', 'company-network', '企业关系和地域权益图') }}<div class="kz-a-callout-grid"><article><h2>企业关系</h2><p>区分原研、自主研发、共同开发与历史合作。</p></article><article><h2>地域权益</h2><p>按大中华区、北美、全球等公开范围记录。</p></article><article><h2>公开交易</h2><p>只列公开的许可或合作安排，金额未公开时明确说明。</p></article></div><div class="kz-a-table-wrap"><table><thead><tr><th>产品</th><th>企业关系</th><th>许可方</th><th>被许可方</th><th>地域权益</th><th>交易信息</th></tr></thead><tbody>{% for row in companies %}<tr data-product="{{ product_names[row.product_id] }}"><td>{{ product_names[row.product_id] }}</td><td>{{ row.relationship }}</td><td>{{ row.licensor }}</td><td>{{ row.licensee }}</td><td>{{ row.territory }}</td><td>{{ row.transaction }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
