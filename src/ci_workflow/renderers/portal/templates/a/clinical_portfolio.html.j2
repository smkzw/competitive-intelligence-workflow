{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}临床开发组合{% endblock %}{% block heading %}产品与临床试验组合{% endblock %}
{% block lead %}按产品、靶点、阶段和地域多选查看全部核心与支持研究，筛选同时作用于图形和完整表格。{% endblock %}
{% block content %}
<section class="kz-a-panel" data-module="clinical-portfolio">
  <details class="kz-comparison-disclosure" data-comparison-disclosure open>
  <summary>研究筛选：产品、靶点、阶段与地域</summary>
  <div class="kz-a-filter-grid">
    {{ ui.filter_group('product', '产品', products|map(attribute='name')|list) }}
    {{ ui.filter_group('target', '靶点', products|map(attribute='target')|unique|list) }}
    {{ ui.filter_group('phase', '阶段', trials|map(attribute='phase')|unique|list) }}
    {{ ui.filter_group('region', '地域', trials|map(attribute='region')|unique|list) }}
  </div>
  </details>
  <section id="full-study-comparison" hidden aria-labelledby="a-comparison-title">
    <div class="kz-comparison-heading">
    <h1 id="a-comparison-title" class="portal-page-title">全研究横比</h1>
    <p class="kz-comparison-scope">{{ report.indication }}｜观察截止：{{ report.data_cutoff.strftime('%Y-%m-%d') }}</p>
    </div>
    <p>同一临床问题按明确语义匹配的条件列对照；差异与未知保留，不能解释为头对头研究。</p>
    <div class="kz-comparison-controls">
    <label>比较问题<select data-a-comparison-question aria-label="比较问题"></select></label>
    <button type="button" data-a-comparison-prev>上一组条件</button>
    <button type="button" data-a-comparison-next>下一组条件</button>
    </div>
    <p data-a-comparison-status aria-live="polite"></p>
    <div class="kz-a-table-wrap" tabindex="0" aria-label="全研究横比矩阵，可横向滚动">
      <table data-a-comparison-table data-primary-comparison-table><thead></thead><tbody></tbody></table>
    </div>
    <div id="kz-chart-module" aria-label="当前比较问题联动图"></div>
  </section>
  <div data-a-portfolio-summary>
  {{ ui.section_head('临床试验一览', '按产品、阶段和地域并列查看核心与支持研究') }}
  {{ ui.chart('portfolio', 'clinical-portfolio', '产品试验阶段地域组合') }}
  <details class="kz-complete-table"><summary class="kz-complete-table__summary">展开当前筛选的完整试验表</summary><div class="kz-a-table-wrap"><table><thead><tr><th>产品</th><th>靶点</th><th>试验</th><th>研究角色</th><th>阶段</th><th>地域</th><th>样本量</th><th>状态</th></tr></thead><tbody>
  {% for row in trials %}
    {% set focus = products|selectattr('id','equalto',row.product_id)|first %}
    {% set names = namespace(ids=[], products=[], targets=[]) %}
    {% for link in row.product_links %}
      {% set item = products|selectattr('id','equalto',link.product_id)|first %}
      {% if item and item.id not in names.ids %}
        {% set names.ids = names.ids + [item.id] %}
        {% set names.products = names.products + [item.name] %}
        {% if item.target not in names.targets %}{% set names.targets = names.targets + [item.target] %}{% endif %}
      {% endif %}
    {% endfor %}
    {% if not names.products %}{% set names.ids = [focus.id] %}{% set names.products = [focus.name] %}{% set names.targets = [focus.target] %}{% endif %}
    <tr data-product="{{ names.products|join('｜') }}" data-target="{{ names.targets|join('｜') }}" data-phase="{{ row.phase }}" data-region="{{ row.region }}">
      <td>{% for product_id in names.ids %}{% set item = products|selectattr('id','equalto',product_id)|first %}<a href="products/{{ item.id }}.html">{{ item.name }}</a>{% if not loop.last %}、{% endif %}{% endfor %}</td>
      <td>{{ names.targets|join('、') }}</td>
      <td title="{{ row.name }}">{{ row.name }}<br><small>{{ row.display_id }}</small></td>
      <td>{{ row.role }}</td><td>{{ row.phase }}</td><td>{{ row.region }}</td>
      <td>{% if row.enrollment_type == 'ACTUAL' and row.sample_size is not none %}实际 n={{ row.sample_size }}{% elif row.enrollment_type == 'ESTIMATED' and row.planned_sample_size is not none %}计划 n={{ row.planned_sample_size }}{% elif row.reported_sample_size is not none %}登记 n={{ row.reported_sample_size }}（类型未标）{% else %}未知{% endif %}</td>
      <td>{{ row.status }}</td>
    </tr>
  {% endfor %}
  </tbody></table></div></details>{{ ui.empty_state() }}</div>
</section>
<script>
window.__A_COMPARISON_WORKSPACE__ = {{ comparison_workspace|tojson }};
window.__A_COMPARISON_ROWS__ = {{ comparison_rows|tojson }};
window.__A_COMPARISON_GROUPS__ = {{ comparison_groups|tojson }};
</script>
{% endblock %}
