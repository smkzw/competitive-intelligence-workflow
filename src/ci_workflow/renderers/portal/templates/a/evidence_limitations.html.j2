{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}研究依据与局限{% endblock %}{% block heading %}研究依据与局限{% endblock %}
{% block lead %}本页只保留影响医学解读的资料范围、披露成熟度和比较局限；检索尝试与技术诊断不进入报告正文。{% endblock %}
{% block content %}<section class="kz-a-panel" data-module="evidence">{{ ui.section_head('资料构成与成熟度', '关键疗效和安全性优先核对登记结果、主要报告和监管公开材料') }}{{ ui.chart('evidence', 'evidence-composition', '研究资料构成与成熟度') }}<div class="kz-a-source-grid">{% for row in sources %}<article><span>{{ row.maturity }}</span><h2>{{ row.source }}</h2><p><strong>覆盖：</strong>{{ row.scope }}</p><p><strong>解读局限：</strong>{{ row.limitation }}</p></article>{% endfor %}</div><div class="kz-a-table-wrap"><table><thead><tr><th>资料来源</th><th>覆盖范围</th><th>资料成熟度</th><th>影响解读的局限</th></tr></thead><tbody>{% for row in sources %}<tr><td>{{ row.source }}</td><td>{{ row.scope }}</td><td>{{ row.maturity }}</td><td>{{ row.limitation }}</td></tr>{% endfor %}</tbody></table></div><aside class="kz-a-medical-note"><h2>横向比较提示</h2><p>各试验的人群、背景治疗、对照组反应和观察时间可能不同。本报告用于快速识别潜在疗效信号和安全性关注点，不替代基于原始方案与完整结果的医学判断。</p></aside></section>{% endblock %}
