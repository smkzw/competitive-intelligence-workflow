{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}安全性{% endblock %}{% block heading %}多维安全性谱比较{% endblock %}
{% block lead %}先以热图观察{% if safety_public_categories %}{{ safety_public_categories|join('、') }}{% else %}可公开量化的安全性事件{% endif %}，再核对发生率与观察窗。{% endblock %}
{% block content %}
<section class="kz-a-panel" data-module="safety">
  <div class="kz-a-filter-grid">{{ ui.filter_group('product', '产品', products|map(attribute='name')|list) }}{{ ui.filter_group('arm', '组别', safety|map(attribute='arm')|unique|list) }}{{ ui.filter_group('category', '安全性维度', safety|map(attribute='category')|unique|list) }}{{ ui.filter_group_choices('event', '不良事件', safety_event_filters) }}{{ ui.filter_group_choices('semantic', '安全语义', safety_semantic_filters) }}</div>
  {{ ui.section_head('安全性热图', '图只绘制组别—产品关系已确认且数值可绘的观察；百分比使用固定0至100%色阶，不形成排名') }}
  {{ ui.chart('safety', 'safety-full', '多维安全性发生率热图') }}
  {% if unassigned_safety_count %}<p class="kz-a-comparability">本页有 {{ unassigned_safety_count }} 条安全性观察的组别—产品关系待核，未绘图；完整表保留原始值。</p>{% endif %}
  <div class="kz-a-safety-legend" aria-label="颜色说明"><span>较低发生率</span><i></i><i></i><i></i><i></i><span>较高发生率</span></div>
  {{ ui.section_head('发生率与观察窗明细', '按当前筛选逐页核对全部公开数据') }}
  <div class="kz-a-table-wrap kz-a-safety-table" data-paged-table data-page-size="50">
    <details class="kz-complete-table"><summary class="kz-complete-table__summary">展开当前筛选的完整安全性表</summary>
      <table><colgroup><col class="kz-a-safety-col-product"><col class="kz-a-safety-col-trial"><col class="kz-a-safety-col-arm"><col class="kz-a-safety-col-category"><col class="kz-a-safety-col-event"><col class="kz-a-safety-col-semantic"><col class="kz-a-safety-col-rate"><col class="kz-a-safety-col-count"><col class="kz-a-safety-col-window"><col class="kz-a-safety-col-evidence"></colgroup>
        <thead><tr><th>产品</th><th>试验</th><th>组别</th><th>维度</th><th>事件</th><th>安全语义</th><th>当前值</th><th>人数/口径</th><th>观察窗</th><th>依据与说明</th></tr></thead>
        <tbody>{% for row in safety %}
          {% set product_display = '产品归属待核' if row.group_assignment_state == 'unknown' else product_names[row.product_id] %}
          <tr data-row-id="{{ row.row_id }}" data-product="{{ product_display }}" data-arm="{{ row.arm }}" data-category="{{ row.category }}" data-event="{{ row.term }}" data-event-key="{{ row.term_key }}" data-semantic="{{ row.semantic_filter_key }}" data-normalized-term="{{ row.term_label }}" data-disclosure-state="{{ row.disclosure_state }}"{% if row.source_field_path %} data-source-binding="{{ row.source_field_path }}"{% endif %}>
            <td>{{ product_display }}</td>
            <td{% if row.trial_id %} title="{{ trial_original_names[row.trial_id] }}"{% endif %}>{% if row.trial_id %}<div class="kz-a-cell-detail"><button type="button" data-a-cell-detail-toggle aria-expanded="false">查看试验</button><span hidden>{{ trial_names[row.trial_id] }}</span></div>{% else %}未公开{% endif %}</td>
            <td>{{ row.arm }}{% if row.arm_detail and row.arm_detail != row.arm %}<div class="kz-a-cell-detail"><button type="button" data-a-cell-detail-toggle aria-expanded="false">查看登记组名</button><span hidden>{{ row.arm_detail }}</span></div>{% endif %}</td>
            <td>{{ row.category }}</td><td>{{ row.measure_label or row.term_label }}</td>
            <td><div class="kz-a-cell-detail"><button type="button" data-a-cell-detail-toggle aria-expanded="false">查看安全语义</button><span hidden>{{ row.polarity }}；Grade {{ row.grade_set|join('/') if row.grade_set else '未指定' }}；{{ row.seriousness }}；TEAE={% if row.teae is none %}原文未说明{% else %}{{ row.teae }}{% endif %}；{{ row.relatedness }}；父={{ row.parent or '无' }}；子={{ row.children|join('/') if row.children else '无' }}；{{ row.count_basis }}</span></div></td>
            <td><strong>{% if row.value is none %}未公开{% else %}{{ row.value }}{{ row.unit }}{% endif %}</strong></td>
            <td>{% if row.numerator is not none %}{{ row.numerator }}/{{ row.denominator }}人{% else %}{{ row.count_basis }}；分母未归属{% endif %}</td>
            <td>{% if row.time_window|length > 60 %}{{ row.time_window[:45] }}…<div class="kz-a-cell-detail"><button type="button" data-a-cell-detail-toggle aria-expanded="false">查看完整观察窗</button><span hidden>{{ row.time_window }}</span></div>{% else %}{{ row.time_window }}{% endif %}</td>
            <td class="clinical-narrative"><div class="kz-a-cell-detail"><button type="button" data-a-cell-detail-toggle aria-expanded="false">查看依据</button><span hidden>{% if row.row_id in user_edits %}<strong>{{ user_edits[row.row_id].status_label_zh }}</strong>；当前用户修订值：{{ user_edits[row.row_id].current_value }}；原来源值：{{ user_edits[row.row_id].original_value }}；原来源原文：{{ row.source_text or '原文未提供' }}；来源版本：{{ user_edits[row.row_id].source_version_id }}；原定位：{{ row.source_field_path or '定位见证据链' }}。{% else %}{{ row.clinical_narrative or row.source_text or '来源说明见报告证据链' }}{% endif %}</span></div>{% if row.unrendered_reason == 'group_product_relationship_unresolved' %}<small>未绘图：组别与产品关系待核</small>{% endif %}</td>
          </tr>{% endfor %}</tbody>
      </table>
    </details>
  </div>
  <nav class="kz-a-pagination" data-table-pagination aria-label="安全性明细翻页"><button type="button" data-page-action="prev">上一页</button><span data-page-status aria-live="polite"></span><button type="button" data-page-action="next">下一页</button></nav>{{ ui.empty_state() }}
</section>
{% endblock %}
