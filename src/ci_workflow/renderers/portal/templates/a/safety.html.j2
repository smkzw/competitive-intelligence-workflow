{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}安全性{% endblock %}{% block heading %}多维安全性谱比较{% endblock %}
{% block lead %}先以热图观察{% if safety_public_categories %}{{ safety_public_categories|join('、') }}{% else %}可公开量化的安全性事件{% endif %}，再核对发生率与观察窗。{% endblock %}
{% block content %}
<section class="kz-a-panel" data-module="safety">
  <div class="kz-a-filter-grid">{{ ui.filter_group('product', '产品', products|map(attribute='name')|list) }}{{ ui.filter_group('arm', '组别', safety|map(attribute='arm')|unique|list) }}{{ ui.filter_group('category', '安全性维度', safety|map(attribute='category')|unique|list) }}{{ ui.filter_group_choices('event', '不良事件', safety_event_filters) }}</div>
  {{ ui.section_head('安全性热图', '按试验、组别和观察窗保留全部记录；百分比使用固定0至100%色阶，不形成排名') }}
  {{ ui.chart('safety', 'safety-full', '多维安全性发生率热图') }}
  <div class="kz-a-safety-legend" aria-label="颜色说明"><span>较低发生率</span><i></i><i></i><i></i><i></i><span>较高发生率</span></div>
  {{ ui.section_head('发生率与观察窗明细', '按当前筛选逐页核对全部公开数据') }}
  <div class="kz-a-table-wrap kz-a-safety-table" data-paged-table data-page-size="50"><table><colgroup><col class="kz-a-safety-col-product"><col class="kz-a-safety-col-trial"><col class="kz-a-safety-col-arm"><col class="kz-a-safety-col-category"><col class="kz-a-safety-col-event"><col class="kz-a-safety-col-rate"><col class="kz-a-safety-col-count"><col class="kz-a-safety-col-window"></colgroup><thead><tr><th>产品</th><th>试验</th><th>组别</th><th>维度</th><th>事件</th><th>发生率</th><th>人数</th><th>观察窗</th></tr></thead><tbody>{% for row in safety %}<tr data-row-id="{{ row.row_id }}" data-product="{{ product_names[row.product_id] }}" data-arm="{{ row.arm }}" data-category="{{ row.category }}" data-event="{{ row.term }}" data-event-key="{{ row.term_key }}" data-normalized-term="{{ row.term_label }}" data-disclosure-state="{{ row.disclosure_state }}"><td>{{ product_names[row.product_id] }}</td><td{% if row.trial_id %} title="{{ trial_original_names[row.trial_id] }}"{% endif %}>{% if row.trial_id %}{{ trial_names[row.trial_id] }}{% else %}未公开{% endif %}</td><td>{{ row.arm_detail or row.arm }}</td><td>{{ row.category }}</td><td>{{ row.measure_label or row.term_label }}</td><td><strong>{% if row.value is none %}未公开{% else %}{{ row.value }}{{ row.unit }}{% endif %}</strong></td><td>{% if row.numerator is not none %}{{ row.numerator }}/{{ row.denominator }}人{% elif row.term_key in ["any_teae", "any_sae", "death", "generic_ae", "serious_teae_subset"] %}分母无法归属（登记组名不一致）{% else %}未公开{% endif %}</td><td>{{ row.time_window }}</td></tr>{% endfor %}</tbody></table></div>
  <nav class="kz-a-pagination" data-table-pagination aria-label="安全性明细翻页"><button type="button" data-page-action="prev">上一页</button><span data-page-status aria-live="polite"></span><button type="button" data-page-action="next">下一页</button></nav>{{ ui.empty_state() }}
</section>
{% endblock %}
