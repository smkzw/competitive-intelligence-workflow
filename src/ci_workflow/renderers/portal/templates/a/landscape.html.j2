{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}竞争格局{% endblock %}{% block heading %}全部创新治疗项目{% endblock %}
{% block lead %}完整保留开展中、暂停、终止与撤回项目；默认按靶点分组，组内不做疗效或安全性排名。{% endblock %}
{% block content %}
<section class="kz-a-panel" data-module="landscape">
  {{ ui.filter_group('target', '靶点', products|map(attribute='target')|unique|list) }}
  {{ ui.filter_group('phase', '阶段', products|map(attribute='phase')|unique|list) }}
  {{ ui.section_head('靶点—阶段全景', '每个产品标签代表一个范围内创新治疗项目') }}
  {{ ui.chart('landscape', 'landscape-full', '创新治疗靶点阶段全景') }}
  <div class="kz-a-table-wrap"><table><thead><tr><th>产品</th><th>靶点</th><th>技术类型</th><th>最高阶段</th><th>地域</th><th>开发状态</th></tr></thead><tbody>
  {% for p in products %}<tr data-product-id="{{ p.id }}" data-target="{{ p.target }}" data-phase="{{ p.phase }}"><td><a href="products/{{ p.id }}.html">{{ p.name }}</a></td><td>{{ p.target }}</td><td>{{ p.modality }}</td><td>{{ p.phase }}</td><td>{{ p.regions|join('、') }}</td><td><span class="kz-a-status{% if p.status in ['终止','撤回'] %} kz-a-status--risk{% endif %}">{{ p.status }}</span></td></tr>{% endfor %}
  </tbody></table></div>{{ ui.empty_state() }}
</section>
{% endblock %}
