{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}竞争格局{% endblock %}{% block heading %}全部创新治疗项目{% endblock %}
{% block lead %}完整呈现全部项目及状态；按靶点与最高阶段分组，不做疗效或安全性排名。{% endblock %}
{% block content %}
<section class="kz-a-panel" data-module="landscape">
  <div class="kz-a-core-filters">
    {{ ui.filter_group('target', '靶点', products|map(attribute='target')|unique|list, compact=true) }}
    {{ ui.filter_group('phase', '阶段', products|map(attribute='phase')|unique|list, compact=true) }}
  </div>
  {{ ui.section_head('靶点—阶段全景', '完整阶段分布；展开靶点进入全部产品。') }}
  {{ ui.chart('landscape', 'landscape-full', '创新治疗靶点阶段全景') }}
  <details class="kz-complete-table"><summary class="kz-complete-table__summary">展开当前筛选的完整产品表</summary><div class="kz-a-table-wrap kz-a-landscape-table"><table><thead><tr><th>产品</th><th>靶点</th><th>技术类型</th><th>最高阶段</th><th>地域</th><th>开发状态</th></tr></thead><tbody>
  {% for p in products %}<tr data-product-id="{{ p.id }}" data-target="{{ p.target }}" data-phase="{{ p.phase }}"><td><a href="products/{{ p.id }}.html">{{ p.name }}</a></td><td>{{ p.target }}</td><td>{{ p.modality }}</td><td>{{ p.phase }}</td><td>{{ p.regions|join('、') }}</td><td><span class="kz-a-status{% if p.status in ['终止','撤回'] %} kz-a-status--risk{% endif %}">{{ p.status }}</span></td></tr>{% endfor %}
  </tbody></table></div><div class="kz-a-landscape-records" aria-label="完整产品卡片视图">{% for p in products %}<article data-landscape-record data-product-id="{{ p.id }}" data-target="{{ p.target }}" data-phase="{{ p.phase }}"><h3><a href="products/{{ p.id }}.html">{{ p.name }}</a></h3><dl><div><dt>产品</dt><dd>{{ p.name }}</dd></div><div><dt>靶点</dt><dd>{{ p.target }}</dd></div><div><dt>技术类型</dt><dd>{{ p.modality }}</dd></div><div><dt>最高阶段</dt><dd>{{ p.phase }}</dd></div><div><dt>地域</dt><dd>{{ p.regions|join('、') }}</dd></div><div><dt>开发状态</dt><dd><span class="kz-a-status{% if p.status in ['终止','撤回'] %} kz-a-status--risk{% endif %}">{{ p.status }}</span></dd></div></dl></article>{% endfor %}</div></details>{{ ui.empty_state() }}
</section>
{% endblock %}
