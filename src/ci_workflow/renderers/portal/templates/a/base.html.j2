<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="only light">
  <link rel="icon" href="data:,">
  <title>{% block title %}{% endblock %}｜{{ report.indication }}竞品全景</title>
  <link rel="stylesheet" href="{{ asset_prefix }}/portal.css">
  <link rel="stylesheet" href="{{ asset_prefix }}/report-a.css">
</head>
<body class="kz-a-site" data-page-id="{{ current }}" data-report-version="{{ report.report_version }}">
  <header class="site-header" role="banner">
    <div class="site-header__inner">
      <a class="site-header__logo" href="{{ root_prefix }}overview.html" aria-label="返回首页">
        <img src="{{ asset_prefix }}/logo.svg" alt="康哲药业" width="121" height="25">
      </a>
      <span class="site-header__title">{{ report.indication }}竞品全景</span>
      <nav class="site-header__nav kz-a-nav" id="site-primary-nav" aria-label="主导航">
        {% for item in navigation[:7] %}
        <a href="{{ root_prefix }}{{ item.id }}.html"
           class="site-header__nav-item{% if item.id == current %} site-header__nav-item--active{% endif %}"
           {% if item.id == current %}aria-current="page"{% endif %}>{{ item.title }}</a>
        {% endfor %}
        <details class="kz-a-more-nav">
          <summary{% if current in ['regulatory','companies-transactions','patents-protection','historical-edge'] %} class="kz-a-more-nav__current"{% endif %}>更多</summary>
          <div class="kz-a-more-nav__panel">
            {% for item in navigation[7:] %}
            <a href="{{ root_prefix }}{{ item.id }}.html"
               class="site-header__nav-item{% if item.id == current %} site-header__nav-item--active{% endif %}"
               {% if item.id == current %}aria-current="page"{% endif %}>{{ item.title }}</a>
            {% endfor %}
          </div>
        </details>
      </nav>
      <div class="site-header__search">
        <label class="visually-hidden" for="global-search-input">全局搜索</label>
        <input id="global-search-input" class="site-header__search-input" type="search"
               placeholder="搜索产品、靶点或页面" autocomplete="off">
        <div id="global-search-results" class="site-header__search-results" role="listbox" hidden></div>
      </div>
      <button class="site-header__menu-toggle" id="menu-toggle" type="button"
              aria-label="打开导航菜单" aria-expanded="false">菜单</button>
    </div>
    <div class="site-header__brand-line" aria-hidden="true"></div>
  </header>

  {% if publication_limitation_zh %}
  <aside class="publication-limitation" role="note" aria-label="证据限制">
    <strong>证据限制</strong>
    <p>{{ publication_limitation_zh }}</p>
  </aside>
  {% endif %}

  <main class="portal-main kz-a-main" id="main">
    <header class="portal-page-head kz-a-page-head">
      <span class="kz-a-page-ambient" aria-hidden="true"></span>
      {% block kicker %}{% endblock %}
      <h1 class="portal-page-title">{% block heading %}{% endblock %}</h1>
      <p class="portal-lead">{% block lead %}{% endblock %}</p>
    </header>
    <details class="kz-a-workspace-bar" data-responsive-workspace open>
      <summary>视图与修订配置{% if user_edits %}<span class="kz-a-review-state">{{ user_edits|length }} 项用户修订</span>{% endif %}</summary>
      <div class="kz-a-workspace-bar__content" aria-label="当前视图与事实状态">
        <div>
          <strong>当前视图</strong>
          <span data-a-view-status>筛选与比较维度可保存到本机</span>
        </div>
        <div class="kz-a-workspace-bar__actions">
          <button type="button" data-a-save-view>保存当前视图</button>
          <button type="button" data-a-clear-view>清除本机视图</button>
        </div>
        {% if user_edits %}<span class="kz-a-review-state">用户修订，未独立复核｜{{ user_edits|length }} 项</span>{% endif %}
      </div>
    </details>
    {% block content %}{% endblock %}
  </main>

  <section class="portal-source-section" id="external-sources" aria-labelledby="external-sources-title">
    <div class="portal-source-section__inner">
      <h2 id="external-sources-title">外部来源</h2>
      {% if external_sources %}
      <ul class="portal-source-section__list">
        {% for source in external_sources %}
        <li>
          <span>[{{ loop.index }}]</span>
          {% if source.url %}<a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.label }}</a>{% else %}<span>{{ source.label }}（未提供可安全公开的链接）</span>{% endif %}
          <span>｜来源类型：{{ source.source_type }}｜发布日期：{{ source.published_at }}｜数据截止：{{ source.data_cutoff }}</span>
          {% if source.limitation %}<span>｜限制：{{ source.limitation }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p>此报告未绑定可核验的公共来源谱系；来源类别说明不代表具体出处。</p>
      {% endif %}
    </div>
  </section>

  <aside class="kz-evidence-panel" id="data-basis-panel" hidden aria-labelledby="data-basis-title">
    <div class="kz-evidence-panel__head">
      <h2 id="data-basis-title">数据依据</h2>
      <button type="button" data-close-evidence aria-label="关闭数据依据">×</button>
    </div>
    <div data-evidence-content>
      <p>选择图形或表格中的“查看数据依据”，可核对定义、时间点与来源范围（分母仅在登记按组披露风险人数时显示为“分子/分母人”；登记组名无法与安全性组对应时显示“分母无法归属”，登记未按人单位披露时显示“分母未列示”）。</p>
    </div>
  </aside>

  <aside class="kz-a-insight-drawer" id="a-product-insight-drawer"
         role="dialog" aria-modal="true" aria-labelledby="a-product-insight-title" hidden>
    <div class="kz-a-insight-drawer__panel">
      <header class="kz-a-insight-drawer__header">
        <div>
          <span class="kz-a-insight-drawer__eyebrow">产品洞察</span>
          <h2 id="a-product-insight-title"></h2>
          <p id="a-product-insight-subtitle"></p>
        </div>
        <button type="button" class="kz-a-insight-drawer__close"
                id="a-product-insight-close" aria-label="关闭产品洞察">×</button>
      </header>
      <div class="kz-a-insight-drawer__summary" id="a-product-insight-summary"></div>
      <div class="kz-a-insight-drawer__tabs" role="tablist" aria-label="产品洞察内容">
        <button type="button" role="tab" id="a-product-tab-efficacy"
                aria-controls="a-product-panel-efficacy" aria-selected="true"
                data-product-tab="efficacy">疗效</button>
        <button type="button" role="tab" id="a-product-tab-safety"
                aria-controls="a-product-panel-safety" aria-selected="false"
                data-product-tab="safety" tabindex="-1">安全性</button>
        <button type="button" role="tab" id="a-product-tab-profile"
                aria-controls="a-product-panel-profile" aria-selected="false"
                data-product-tab="profile" tabindex="-1">产品档案</button>
        <button type="button" role="tab" id="a-product-tab-evidence"
                aria-controls="a-product-panel-evidence" aria-selected="false"
                data-product-tab="evidence" tabindex="-1">数据依据</button>
      </div>
      <section class="kz-a-insight-drawer__body" role="tabpanel"
               id="a-product-panel-efficacy" aria-labelledby="a-product-tab-efficacy"
               data-product-panel="efficacy"></section>
      <section class="kz-a-insight-drawer__body" role="tabpanel"
               id="a-product-panel-safety" aria-labelledby="a-product-tab-safety"
               data-product-panel="safety" hidden></section>
      <section class="kz-a-insight-drawer__body" role="tabpanel"
               id="a-product-panel-profile" aria-labelledby="a-product-tab-profile"
               data-product-panel="profile" hidden></section>
      <section class="kz-a-insight-drawer__body" role="tabpanel"
               id="a-product-panel-evidence" aria-labelledby="a-product-tab-evidence"
               data-product-panel="evidence" hidden></section>
    </div>
  </aside>

  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__inner">
      <span>数据截至 {{ report.data_cutoff.strftime('%Y年%m月%d日') }}｜仅供产品中心医学部内部研判使用</span>
    </div>
  </footer>
  <script src="{{ data_prefix }}/report.js"></script>
  <script src="{{ data_prefix }}/search-index.js"></script>
  {% if root_prefix %}<script>window.__SEARCH_INDEX__=(window.__SEARCH_INDEX__||[]).map(function(x){return Object.assign({},x,{slug:"../"+x.slug});});</script>{% endif %}
  <script src="{{ asset_prefix }}/echarts.min.js"></script>
  <script src="{{ asset_prefix }}/portal.js"></script>
  <script src="{{ asset_prefix }}/report-a.js"></script>
</body>
</html>
