{% extends "base.html.j2" %}{% import "_macros.html.j2" as ui %}
{% block title %}中国与全球监管{% endblock %}{% block heading %}中国与全球开发监管状态{% endblock %}
{% block lead %}中国和境外事件分轨呈现，避免把不同法域的许可、审评、批准、暂停或终止状态混写。{% endblock %}
{% block content %}<section class="kz-a-panel" data-module="regulatory">{{ ui.filter_group('product', '产品', products|map(attribute='name')|list) }}{{ ui.section_head('监管与开发时间线', '同一产品可在不同法域处于不同状态') }}{{ ui.chart('timeline', 'regulatory-timeline', '中国与全球监管时间线') }}<div class="kz-a-track-grid"><article data-region-track="中国"><h2>中国开发与监管</h2>{% for row in regulatory if row.track == '中国' %}<div class="kz-a-event"><time>{{ row.date }}</time><strong>{{ product_names[row.product_id] }}</strong><span>{{ row.event }}｜{{ row.status }}</span></div>{% endfor %}</article><article data-region-track="境外"><h2>全球开发与监管</h2>{% for row in regulatory if row.track == '境外' %}<div class="kz-a-event"><time>{{ row.date }}</time><strong>{{ product_names[row.product_id] }}</strong><span>{{ row.event }}｜{{ row.status }}</span></div>{% endfor %}</article></div><div class="kz-a-table-wrap"><table><thead><tr><th>产品</th><th>法域轨道</th><th>事件</th><th>日期</th><th>状态</th></tr></thead><tbody>{% for row in regulatory %}<tr data-product="{{ product_names[row.product_id] }}"><td>{{ product_names[row.product_id] }}</td><td>{{ row.track }}</td><td>{{ row.event }}</td><td>{{ row.date }}</td><td>{{ row.status }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
