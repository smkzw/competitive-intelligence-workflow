{% macro filter_group(dimension, label, values, default_values=(), compact=false, collapsed=false) -%}
{% if values|length > 12 or compact or collapsed %}
<details class="kz-a-filter kz-a-filter-disclosure" data-filter-dimension="{{ dimension }}" data-filter-total="{{ values|length }}"{% if compact and not collapsed %} data-responsive-filter{% endif %} aria-label="{{ label }}">
  <summary><span class="kz-a-filter__label">{{ label }}</span><span data-filter-selection-count="{{ dimension }}">默认显示全部 {{ values|length }} 项</span></summary>
  <div class="kz-a-filter-options">
    {% for value in values %}<button type="button" data-filter-value="{{ value }}"{% if value in default_values %} data-filter-default{% endif %} aria-pressed="{{ 'true' if value in default_values else 'false' }}">{{ value }}</button>{% endfor %}
  </div>
</details>
{% else %}
<div class="kz-a-filter" data-filter-dimension="{{ dimension }}" aria-label="{{ label }}">
  <span class="kz-a-filter__label">{{ label }}</span>
  {% for value in values %}<button type="button" data-filter-value="{{ value }}"{% if value in default_values %} data-filter-default{% endif %} aria-pressed="{{ 'true' if value in default_values else 'false' }}">{{ value }}</button>{% endfor %}
</div>
{% endif %}
{%- endmacro %}

{% macro filter_group_choices(dimension, label, choices, default_values=(), collapsed=false) -%}
{% if choices|length > 12 or collapsed %}
<details class="kz-a-filter kz-a-filter-disclosure" data-filter-dimension="{{ dimension }}" data-filter-total="{{ choices|length }}" aria-label="{{ label }}">
  <summary><span class="kz-a-filter__label">{{ label }}</span><span data-filter-selection-count="{{ dimension }}">默认显示全部 {{ choices|length }} 项</span></summary>
  <div class="kz-a-filter-options">
    {% for choice in choices %}<button type="button" data-filter-value="{{ choice.key }}"{% if choice.key in default_values %} data-filter-default{% endif %} aria-pressed="{{ 'true' if choice.key in default_values else 'false' }}">{{ choice.label }}</button>{% endfor %}
  </div>
</details>
{% else %}
<div class="kz-a-filter" data-filter-dimension="{{ dimension }}" aria-label="{{ label }}">
  <span class="kz-a-filter__label">{{ label }}</span>
  {% for choice in choices %}<button type="button" data-filter-value="{{ choice.key }}"{% if choice.key in default_values %} data-filter-default{% endif %} aria-pressed="{{ 'true' if choice.key in default_values else 'false' }}">{{ choice.label }}</button>{% endfor %}
</div>
{% endif %}
{%- endmacro %}

{% macro section_head(title, note='', product_scope='') -%}
<div class="kz-a-section-head">
  <div><h2>{{ title }}</h2>{% if note %}<p>{{ note }}</p>{% endif %}</div>
  <button type="button" class="kz-a-evidence-button" data-open-evidence="{{ title }}"
          {% if product_scope %}data-evidence-product="{{ product_scope }}"{% endif %}>查看数据依据</button>
</div>
{%- endmacro %}

{% macro chart(chart_type, chart_id, aria_label, product_scope='') -%}
<div class="kz-chart" data-a-chart="{{ chart_type }}" data-chart-id="{{ chart_id }}"
     {% if product_scope %}data-product-scope="{{ product_scope }}"{% endif %}
     data-view-digest="initial" role="img" aria-label="{{ aria_label }}"></div>
{%- endmacro %}

{% macro complete_table_summary(label='展开完整数据表') -%}
<summary class="kz-complete-table__summary">{{ label }}</summary>
{%- endmacro %}

{% macro precise_number(value) -%}
{{ value|int if value is not none and value == value|int else value }}
{%- endmacro %}

{% macro current_value(row) -%}
{%- if row.value is not none -%}
{{ precise_number(row.value) }}{{ row.unit }}
{%- else -%}
{%- set state = row.disclosure_state.value|default(row.disclosure_state) -%}
{%- set labels = {
  'user_cleared': '用户清除，待重新核实',
  'not_reported': '来源未列示',
  'not_publicly_disclosed': '尚未公开',
  'not_applicable': '不适用',
  'below_reporting_threshold': '低于报告阈值',
  'conflicting': '来源冲突，待核',
  'unresolved_due_to_route': '来源获取未完成'
} -%}
{{ labels.get(state, state if state in ['未公开', '不适用', '用户清除，待重新核实'] else '数值待核') }}
{%- endif -%}
{%- endmacro %}

{% macro empty_state() -%}
<div class="kz-a-empty" data-filter-empty hidden><strong>当前选择下暂无可比较数据</strong><span>请清除部分条件后继续查看。</span></div>
{%- endmacro %}
