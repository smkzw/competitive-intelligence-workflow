{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.local/schemas/visual-verification-reference-v1.json",
"title": "站点式 HTML 独立视觉审阅结论",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "verdict_id", "format", "visual_plan_digest",
    "candidate_artifact_digest", "render_evidence_digest", "producer_identity",
    "verifier_identity", "verdict", "domains", "created_at"
  ],
  "properties": {
    "$schema": {"type": "string", "const": "schemas/visual-verification-reference.schema.json"},
    "schema_version": {"type": "string", "const": "1.0"},
    "verdict_id": {"$ref": "#/$defs/id"},
    "format": {"type": "string", "const": "html"},
    "visual_plan_digest": {"$ref": "#/$defs/sha256"},
    "candidate_artifact_digest": {"$ref": "#/$defs/sha256"},
    "render_evidence_digest": {"$ref": "#/$defs/sha256"},
    "producer_identity": {"type": "string", "minLength": 1},
    "verifier_identity": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["accepted", "rejected"]},
    "domains": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/domain"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "domain": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "status", "criteria", "evidence_refs"],
      "properties": {
        "domain": {"enum": ["copy_zh", "hierarchy_density", "typography_spacing", "color_legibility", "charts_tables", "interaction_consistency", "format_rendering"]},
        "status": {"enum": ["accepted", "rejected"]},
        "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
