{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cms/ci-workflow/coverage-projection.schema.json",
  "title": "格式覆盖投影",
  "description": "绑定恰好一个规范覆盖集合、快照与输出格式的不可变投影，记录已覆盖项与版本化\n结构化例外。Draft 2020-12 无法表达的跨数组语义（集合闭合、覆盖/例外重叠、\n等价行集绑定、HTML/PDF 完整表不可省略、演示稿只允许图表等价例外、确定性\n身份/摘要重算）由生产验证器语义层强制执行。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coverage_projection_id",
    "coverage_set_id",
    "coverage_set_digest",
    "report",
    "report_version",
    "evidence_snapshot_id",
    "claim_snapshot_id",
    "format",
    "covered_item_ids",
    "exceptions",
    "created_at",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "coverage_projection_id": {"type": "string", "minLength": 1},
    "coverage_set_id": {"type": "string", "minLength": 1},
    "coverage_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report": {"enum": ["A", "B", "C"]},
    "report_version": {"type": "string", "minLength": 1},
    "evidence_snapshot_id": {"type": "string", "minLength": 1},
    "claim_snapshot_id": {"type": "string", "minLength": 1},
    "format": {"enum": ["html", "pdf", "html-ppt", "pptx"]},
    "covered_item_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "exceptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/CoverageException"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "CoverageException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_id",
        "version",
        "omitted_item_id",
        "exception_kind",
        "replacement_expression",
        "rationale_zh",
        "equivalence_evidence"
      ],
      "properties": {
        "exception_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "omitted_item_id": {"type": "string", "minLength": 1},
        "exception_kind": {"enum": ["chart_equivalence"]},
        "replacement_expression": {"type": "string", "minLength": 1},
        "rationale_zh": {"type": "string", "minLength": 1},
        "equivalence_evidence": {"$ref": "#/$defs/EquivalenceEvidence"}
      }
    },
    "EquivalenceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equivalent_item_id", "row_set_digest", "basis_zh"],
      "properties": {
        "equivalent_item_id": {"type": "string", "minLength": 1},
        "row_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "basis_zh": {"type": "string", "minLength": 1}
      }
    }
  }
}
