{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.example/schemas/scientific-review-receipt.schema.json",
  "title": "独立科学复核宿主回执（scientific-review-v1）",
  "description": "证明一次真实独立干净上下文科学复核的唯一不可变回执合同。绑定：生产上下文（项目/报告类型/版本/对象/候选快照/候选内容摘要/生产者身份/生产者会话/标准版本/门槛结果键/生产完成时间/生产上下文摘要）、复核上下文（复核者、宿主可执行文件证据、独立宿主会话、真实外部复核进程与独立上下文来源声明）、内容摘要（被复核内容摘要与审阅输入摘要）、review artifact（类别/项目相对路径/SHA-256）与时间顺序（produced_at < started_at <= finished_at <= issued_at）。receipt_digest 是除自身外全部字段的规范 JSON SHA-256，构造即校验，篡改由验证器失败关闭。无独立上下文能力（status=host_context_unavailable）必须携带中文原因、不得绑定 review artifact，且永远不得通过 verified 授权门；同进程伪造、生产者自审、同会话复核、进程失败退出与时间倒挂在结构层失败关闭。宿主只接受 codex/hermes/omp，三宿主共用本合同。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "host",
    "status",
    "unavailable_reason_zh",
    "issued_at",
    "production",
    "review",
    "content",
    "artifact",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_kind": {"const": "scientific-review-v1"},
    "host": {"enum": ["codex", "hermes", "omp"]},
    "status": {"enum": ["verified", "host_context_unavailable"]},
    "unavailable_reason_zh": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "production": {"$ref": "#/$defs/production"},
    "review": {"$ref": "#/$defs/review"},
    "content": {"$ref": "#/$defs/content"},
    "artifact": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/artifact"}
      ]
    },
    "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "verified"}}},
      "then": {
        "properties": {
          "artifact": {"type": "object"},
          "unavailable_reason_zh": {"type": "null"},
          "review": {
            "properties": {
              "process": {
                "properties": {"returncode": {"const": 0}}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "host_context_unavailable"}}},
      "then": {
        "properties": {
          "artifact": {"type": "null"},
          "unavailable_reason_zh": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "independent_context": {"const": "external_subprocess_session"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "host_executable": {
                "properties": {
                  "provenance": {"enum": ["path_resolved", "explicit"]}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {"independent_context": {"const": "unavailable"}}
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "host_executable": {
                "properties": {"provenance": {"const": "unavailable"}}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "report_kind",
        "report_version",
        "report_object_id",
        "candidate_snapshot_id",
        "candidate_content_digest",
        "producer_id",
        "producer_session_id",
        "criteria_version",
        "gate_result_key",
        "produced_at",
        "production_context_digest"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "report_kind": {"enum": ["A", "B", "C"]},
        "report_version": {"type": "string", "minLength": 1},
        "report_object_id": {"type": "string", "minLength": 1},
        "candidate_snapshot_id": {"type": "string", "minLength": 1},
        "candidate_content_digest": {"$ref": "#/$defs/sha256"},
        "producer_id": {"type": "string", "minLength": 1},
        "producer_session_id": {"type": "string", "minLength": 1},
        "criteria_version": {"type": "string", "minLength": 1},
        "gate_result_key": {"type": "string", "minLength": 1},
        "produced_at": {"type": "string", "format": "date-time"},
        "production_context_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "launcher_pid", "launcher_parent_pid"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "launcher_pid": {"type": "integer", "minimum": 1},
        "launcher_parent_pid": {"type": "integer", "minimum": 1}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pid",
        "argv",
        "cwd",
        "started_at",
        "finished_at",
        "returncode"
      ],
      "properties": {
        "kind": {"const": "external_subprocess"},
        "pid": {"type": "integer", "minimum": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "returncode": {"type": "integer"},
        "stdout_tail": {"type": "string"},
        "stderr_tail": {"type": "string"}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "path", "resolved_realpath", "version"],
      "properties": {
        "provenance": {"enum": ["path_resolved", "explicit", "unavailable"]},
        "path": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "resolved_realpath": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "version": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"provenance": {"const": "unavailable"}}},
          "then": {
            "properties": {
              "path": {"type": "null"},
              "resolved_realpath": {"type": "null"},
              "version": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {"enum": ["path_resolved", "explicit"]}
            }
          },
          "then": {
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "host_executable",
        "session",
        "process",
        "independent_context"
      ],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "host_executable": {"$ref": "#/$defs/executable"},
        "session": {"$ref": "#/$defs/session"},
        "process": {"$ref": "#/$defs/process"},
        "independent_context": {
          "enum": ["external_subprocess_session", "unavailable"]
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_content_digest", "review_input_digest"],
      "properties": {
        "reviewed_content_digest": {"$ref": "#/$defs/sha256"},
        "review_input_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "path", "artifact_sha256"],
      "properties": {
        "artifact_kind": {"const": "scientific_qc_verdict"},
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "项目内 POSIX 相对路径，不得包含 .. 或绝对路径。"
        },
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
