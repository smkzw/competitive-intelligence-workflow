ription":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Rate of RBCs Transfused Per Protocol Algorithm From Week 4 Through Week 36","description":"Per protocol algorithm","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Week 4 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Number of Units of RBCs Transfused Per Protocol Algorithm After Day 1 Through Week 36","description":"Per protocol algorithm","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Day 1 through week 36","groups":[{"id":"OG000","title":"Pozelimab and Cemdisiran","description":"Randomized 1:1"},{"id":"OG001","title":"Anti-C5 Standard-of-care","description":"Randomized 1:1"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"type":"SECONDARY","title":"Number of Units of RBCs Transfused Per Protocol Algorithm From Week 4 Through Week 36","description":"Per protocol algorithm","populationDescription":"Due to Early Termination, this endpoint was removed from the Statistical Analysis Plan and data was not collected for primary and secondary endpoints.","reportingStatus":"POSTED","timeFrame":"Week 4 through week 36","groups":[{"id":"OG000","title":"