{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.local/schemas/design-run-manifest-v1.json",
  "title": "设计产物当前运行清单",
  "$comment": "verdict.manifest_sha256 使用 UTF-8 JSON 规范化摘要：sort_keys=true、separators=(',', ':')、ensure_ascii=false。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_nonce",
    "run_started_at",
    "runner_identity",
    "producer_identity",
    "report_snapshot_sha256",
    "design_contract_sha256",
    "source_pack_sha256",
    "artifact",
    "render",
    "receipts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_nonce": {"type": "string", "minLength": 16},
    "run_started_at": {"type": "string", "format": "date-time"},
    "runner_identity": {"type": "string", "minLength": 1},
    "producer_identity": {"type": "string", "minLength": 1},
    "report_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "design_contract_sha256": {"$ref": "#/$defs/sha256"},
    "source_pack_sha256": {"$ref": "#/$defs/sha256"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "render": {"$ref": "#/$defs/artifact"},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/receipt"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preRunState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exists"],
          "properties": {"exists": {"const": false}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exists", "sha256", "mtime_ns", "inode"],
          "properties": {
            "exists": {"const": true},
            "sha256": {"$ref": "#/$defs/sha256"},
            "mtime_ns": {"type": "integer", "minimum": 0},
            "inode": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "mtime_ns",
        "inode",
        "observed_at",
        "created_by_run_id",
        "pre_run_state"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mtime_ns": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "created_by_run_id": {"type": "string", "minLength": 1},
        "pre_run_state": {"$ref": "#/$defs/preRunState"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "run_id",
        "run_nonce",
        "design_contract_sha256",
        "source_pack_sha256",
        "issued_at"
      ],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "run_nonce": {"type": "string", "minLength": 16},
        "design_contract_sha256": {"$ref": "#/$defs/sha256"},
        "source_pack_sha256": {"$ref": "#/$defs/sha256"},
        "issued_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
