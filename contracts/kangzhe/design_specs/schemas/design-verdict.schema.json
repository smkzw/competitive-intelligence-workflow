{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.local/schemas/design-verdict-v1.json",
  "title": "设计产物独立验收结论",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_nonce",
    "manifest_sha256",
    "producer_identity",
    "verifier_identity",
    "artifact_sha256",
    "render_sha256",
    "issued_at",
    "verdict",
    "checks"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_nonce": {"type": "string", "minLength": 16},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "producer_identity": {"type": "string", "minLength": 1},
    "verifier_identity": {"type": "string", "minLength": 1},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "render_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at": {"type": "string", "format": "date-time"},
    "verdict": {"enum": ["accepted", "rejected"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_run",
        "real_artifact",
        "real_render",
        "independent_verifier",
        "receipts_current"
      ],
      "properties": {
        "current_run": {"type": "boolean"},
        "real_artifact": {"type": "boolean"},
        "real_render": {"type": "boolean"},
        "independent_verifier": {"type": "boolean"},
        "receipts_current": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
