{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms.local/schemas/design-source-pack-v1.json",
  "title": "竞品调研设计来源包",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_pack_id",
    "track",
    "files",
    "tokens",
    "claims",
    "occurrences",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_pack_id": {"type": "string", "minLength": 1},
    "track": {
      "enum": ["portal", "pdf", "htmlppt", "pptx"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "tokens": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/audienceFact"},
          {"$ref": "#/$defs/pageNumber"},
          {"$ref": "#/$defs/dateToken"},
          {"$ref": "#/$defs/sectionNumber"},
          {"$ref": "#/$defs/brandConstant"}
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "occurrences": {
      "type": "array",
      "items": {"$ref": "#/$defs/occurrence"}
    },
    "notes": {
      "type": "array",
      "items": {"$ref": "#/$defs/note"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "audienceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_id",
        "category",
        "source_locator",
        "semantic_role",
        "original_value",
        "unit",
        "denominator",
        "population",
        "arm",
        "timepoint"
      ],
      "properties": {
        "token_id": {"type": "string", "minLength": 1},
        "category": {"const": "audience_fact"},
        "source_locator": {"type": "string", "minLength": 1},
        "semantic_role": {"type": "string", "minLength": 1},
        "original_value": {"type": ["number", "string"]},
        "unit": {"type": "string", "minLength": 1},
        "denominator": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "arm": {"type": "string", "minLength": 1},
        "timepoint": {"type": "string", "minLength": 1}
      }
    },
    "pageNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "category", "value"],
      "properties": {
        "token_id": {"type": "string", "minLength": 1},
        "category": {"const": "page_number"},
        "value": {"type": "integer", "minimum": 1}
      }
    },
    "dateToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "category", "value"],
      "properties": {
        "token_id": {"type": "string", "minLength": 1},
        "category": {"const": "date"},
        "value": {"type": "string", "format": "date"}
      }
    },
    "sectionNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "category", "value"],
      "properties": {
        "token_id": {"type": "string", "minLength": 1},
        "category": {"const": "section_number"},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "brandConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "category", "value", "contract_locator"],
      "properties": {
        "token_id": {"type": "string", "minLength": 1},
        "category": {"const": "brand_constant"},
        "value": {"type": ["number", "string"]},
        "contract_locator": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "value",
        "unit",
        "denominator",
        "normalized_value",
        "source_token_ids"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string"]},
        "unit": {"type": "string", "minLength": 1},
        "denominator": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1},
        "source_token_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "surface", "location_id", "normalized_value"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "surface": {
          "enum": ["page", "chart", "table", "speaker_notes", "pdf", "pptx"]
        },
        "location_id": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1}
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slide_id", "text", "claim_ids", "claim_spans"],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "claim_spans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claimSpan"}
        }
      }
    },
    "claimSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text_span", "normalized_value"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "text_span": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1}
      }
    }
  }
}
